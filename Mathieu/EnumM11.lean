/-- Each key is mapped by `m11b` to a key (kernel `decide`). -/
lemma tt_closB : tt.all (fun k => tt.mem (stepImg tblB k)) = true := by decide
/-- Each key is mapped by `m11a⁻¹` to a key (kernel `decide`). -/
lemma tt_closAi : tt.all (fun k => tt.mem (stepImg tblAi k)) = true := by decide
/-- Each key is mapped by `m11b⁻¹` to a key (kernel `decide`). -/
lemma tt_closBi : tt.all (fun k => tt.mem (stepImg tblBi k)) = true := by decide

/-- The (finite) key set of the tree. -/
noncomputable def keys : Finset ℕ := tt.toList.toFinset

lemma keys_card_le : keys.card ≤ 7920 := by
  have h1 : keys.card ≤ tt.toList.length := List.toFinset_card_le _
  rw [Btree.toList_length, tt_size] at h1
  exact h1

lemma idCode_mem_keys : idCode ∈ keys := by
  simp only [keys, List.mem_toFinset]
  exact Btree.mem_toList tt_idCode

lemma applyGenF_mem_keys {g : Equiv.Perm (Fin 11)}
    (hg : g = m11a ∨ g = m11b ∨ g = m11a⁻¹ ∨ g = m11b⁻¹)
    {c : ℕ} (hc : c ∈ keys) : applyGenF g c ∈ keys := by
  simp only [keys, List.mem_toFinset] at hc ⊢
  rcases hg with rfl | rfl | rfl | rfl
  · rw [← stepImg_tblA]; exact Btree.mem_toList (Btree.all_toList tt_closA c hc)
  · rw [← stepImg_tblB]; exact Btree.mem_toList (Btree.all_toList tt_closB c hc)
  · rw [← stepImg_tblAi]; exact Btree.mem_toList (Btree.all_toList tt_closAi c hc)
  · rw [← stepImg_tblBi]; exact Btree.mem_toList (Btree.all_toList tt_closBi c hc)

lemma forward_keys (p : Equiv.Perm (Fin 11)) (hp : p ∈ M11) : φ p ∈ keys := by
  refine Subgroup.closure_induction_left (p := fun x _ => φ x ∈ keys) ?_ ?_ ?_ hp
  · show φ 1 ∈ keys
    rw [φ_one]; exact idCode_mem_keys
  · intro x hx y _ h
    show φ (x * y) ∈ keys
    rw [← applyGenF_φ]
    apply applyGenF_mem_keys _ h
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
    rcases hx with rfl | rfl
    · exact Or.inl rfl
    · exact Or.inr (Or.inl rfl)
  · intro x hx y _ h
    show φ (x⁻¹ * y) ∈ keys
    rw [← applyGenF_φ]
    apply applyGenF_mem_keys _ h
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
    rcases hx with rfl | rfl
    · exact Or.inr (Or.inr (Or.inl rfl))
    · exact Or.inr (Or.inr (Or.inr rfl))

/-- **`native_decide`-free upper bound.** -/
theorem M11_card_le : Nat.card M11 ≤ 7920 := by
  have hsub : φ '' (M11 : Set (Equiv.Perm (Fin 11))) ⊆ (keys : Set ℕ) := by
    rintro c ⟨p, hp, rfl⟩; exact forward_keys p hp
  have h1 : Nat.card M11 = (M11 : Set (Equiv.Perm (Fin 11))).ncard := Nat.card_coe_set_eq _
  rw [h1, ← Set.ncard_image_of_injective _ φ_injective]
  calc (φ '' (M11 : Set (Equiv.Perm (Fin 11)))).ncard
      ≤ (keys : Set ℕ).ncard := Set.ncard_le_ncard hsub (keys.finite_toSet)
    _ = keys.card := by rw [Set.ncard_coe_finset]
    _ ≤ 7920 := keys_card_le

/-! ### `native_decide`-free sharp 4-transitivity base fact

Using the clean over-approximation `φ '' M₁₁ ⊆ keys` (= `tt.toList.toFinset`), the only key of
the tree whose first four base-`11` digits are `0,1,2,3` is `idCode`.  This is a kernel `decide`
over the tree literal (`tt_stab4`), just like the closure checks `tt_closA…`. -/

/-- `c` fixes the first four points `0,1,2,3` (as a Boolean test on the base-`11` digits). -/
def fixes4 (c : ℕ) : Bool :=
  (c % 11 == 0) && ((c / 11) % 11 == 1) && ((c / 121) % 11 == 2) && ((c / 1331) % 11 == 3)

/-- Kernel certificate: the only key of `tt` fixing the first four points is `idCode`. -/
lemma tt_stab4 : tt.all (fun k => (! fixes4 k) || (k == idCode)) = true := by decide

/-- **Sharp 4-transitivity base fact.**  The pointwise stabiliser of the four points
`0, 1, 2, 3` inside `M₁₁` is trivial.  `native_decide`-free: via `φ '' M₁₁ ⊆ keys` and the
kernel certificate `tt_stab4`. -/
lemma M11_stab4_trivial (g : Perm (Fin 11)) (hg : g ∈ M11)
    (h0 : g 0 = 0) (h1 : g 1 = 1) (h2 : g 2 = 2) (h3 : g 3 = 3) : g = 1 := by
  have hmem : φ g ∈ tt.toList := by
    have hk : φ g ∈ keys := forward_keys g hg
    rwa [keys, List.mem_toFinset] at hk
  have hall := Btree.all_toList tt_stab4 (φ g) hmem
  -- The decoded digits of `φ g` are the values of `g`.
  have hd : dec (φ g) = (fun i => g i) := by rw [φ]; exact dec_enc _
  have d0 : φ g % 11 = (g 0).val := by
    have h := congrArg Fin.val (congrFun hd 0); simpa [dec] using h
  have d1 : φ g / 11 % 11 = (g 1).val := by
    have h := congrArg Fin.val (congrFun hd 1); simpa [dec] using h
  have d2 : φ g / 121 % 11 = (g 2).val := by
    have h := congrArg Fin.val (congrFun hd 2); norm_num [dec] at h ⊢; omega
  have d3 : φ g / 1331 % 11 = (g 3).val := by
    have h := congrArg Fin.val (congrFun hd 3); norm_num [dec] at h ⊢; omega
  have hfix : fixes4 (φ g) = true := by
    simp only [fixes4, Bool.and_eq_true, beq_iff_eq]
    refine ⟨⟨⟨?_, ?_⟩, ?_⟩, ?_⟩
    · rw [d0, h0]; rfl
    · rw [d1, h1]; rfl
    · rw [d2, h2]; rfl
    · rw [d3, h3]; rfl
  rw [hfix, Bool.not_true, Bool.false_or, beq_iff_eq] at hall
  have : φ g = φ 1 := by rw [hall, ← φ_one]
  exact φ_injective this

/-! ### A `native_decide`-free lower bound `7920 ∣ Nat.card M₁₁`, hence `Nat.card M₁₁ = 7920`

We exhibit four subgroups whose orders are the prime-power parts of `7920 = 2⁴·3²·5·11`:
* an order-`16` Sylow `2`-subgroup `⟨a8, t16⟩` (semidihedral);
* an order-`9` Sylow `3`-subgroup `⟨x3, y3⟩` (elementary abelian `C₃×C₃`);
* an order-`5` element `w5`;
* the order-`11` generator `m11a`.

Each subgroup's order is computed by the Lean **kernel** (`decide`) on the encoded BFS closure
(the sets have `≤ 16` elements, so no `native_decide` is needed).  Coprimality then gives
`7920 ∣ |M₁₁|`, and combined with the upper bound `M11_card_le` we get equality. -/

/-- Generic bridge: a permutation `g` whose value table on `0..10` is `t` acts on encoded
codes as `stepImg t`. -/
lemma stepImg_bridge (g : Equiv.Perm (Fin 11)) (t : ℕ → ℕ)
    (h : ∀ x : Fin 11, (g x).val = t x.val) (n : ℕ) : stepImg t n = applyGenF g n := by
  simp only [applyGenF, enc, stepImg, Fin.sum_univ_succ, Fin.sum_univ_zero, h, dec,
    Fin.val_succ, Fin.val_zero]
  ring

/-- Generic order-by-enumeration: if the encoded finset `SS` contains `idCode`, is closed under
`applyGenF` of the generators and their inverses, and every element of `SS` is reachable inside
`Subgroup.closure gs`, then `|closure gs| = SS.card`. -/
lemma card_closure_of_enc (gs : Set (Equiv.Perm (Fin 11)))
    (SS : Finset ℕ) (hid : idCode ∈ SS)
    (hcl : ∀ x ∈ gs, ∀ c ∈ SS, applyGenF x c ∈ SS ∧ applyGenF x⁻¹ c ∈ SS)
    (hre : ∀ c ∈ SS, ∃ p ∈ Subgroup.closure gs, φ p = c) :
    Nat.card ↥(Subgroup.closure gs) = SS.card := by
  have himg : φ '' (Subgroup.closure gs : Set (Equiv.Perm (Fin 11))) = (SS : Set ℕ) := by
    ext c; constructor
    · rintro ⟨p, hp, rfl⟩
      refine Subgroup.closure_induction_left (p := fun x _ => φ x ∈ SS) ?_ ?_ ?_ hp
      · show φ 1 ∈ SS; rw [φ_one]; exact hid
      · intro x hx y _ h; show φ (x * y) ∈ SS
        rw [← applyGenF_φ]; exact (hcl x hx _ h).1
      · intro x hx y _ h; show φ (x⁻¹ * y) ∈ SS
        rw [← applyGenF_φ]; exact (hcl x hx _ h).2
    · intro hc; obtain ⟨p, hp, rfl⟩ := hre c hc; exact ⟨p, hp, rfl⟩
  have h1 : Nat.card ↥(Subgroup.closure gs)
      = (Subgroup.closure gs : Set (Equiv.Perm (Fin 11))).ncard := Nat.card_coe_set_eq _
  rw [h1, ← Set.ncard_image_of_injective _ φ_injective, himg, Set.ncard_coe_finset]

/-! #### The order-`16` Sylow `2`-subgroup `⟨a8, t16⟩` -/

/-- An order-`8` element of `M₁₁`. -/
def a8 : Equiv.Perm (Fin 11) := m11a ^ 2 * m11b
/-- An order-`2` element inverting `a8` to `a8³` (so `⟨a8, t16⟩` is semidihedral of order `16`). -/
def t16 : Equiv.Perm (Fin 11) :=
  m11b⁻¹ * m11a * m11b⁻¹ * m11a * m11b⁻¹ * m11a * m11b * m11a * m11a
def eA8 : ℕ → ℕ := fun x => [2,3,8,0,7,5,1,4,10,6,9].getD x 0
def eA8i : ℕ → ℕ := fun x => [3,6,0,1,7,5,9,4,2,10,8].getD x 0
def eT16 : ℕ → ℕ := fun x => [1,0,2,10,7,5,6,4,9,8,3].getD x 0

lemma a8_mem : a8 ∈ M11 := mul_mem (pow_mem m11a_mem 2) m11b_mem
lemma t16_mem : t16 ∈ M11 := by
  unfold t16
  exact mul_mem (mul_mem (mul_mem (mul_mem (mul_mem (mul_mem (mul_mem (mul_mem
    (inv_mem m11b_mem) m11a_mem) (inv_mem m11b_mem)) m11a_mem) (inv_mem m11b_mem))
    m11a_mem) m11b_mem) m11a_mem) m11a_mem
lemma t16_inv : t16⁻¹ = t16 := by decide

lemma br_a8 (n : ℕ) : stepImg eA8 n = applyGenF a8 n := stepImg_bridge a8 eA8 (by decide) n
lemma br_a8i (n : ℕ) : stepImg eA8i n = applyGenF a8⁻¹ n := stepImg_bridge a8⁻¹ eA8i (by decide) n
lemma br_t16 (n : ℕ) : stepImg eT16 n = applyGenF t16 n := stepImg_bridge t16 eT16 (by decide) n

/-- BFS closure step for `⟨a8, t16⟩` in encoded space. -/
def step16 (T : Finset ℕ) : Finset ℕ :=
  T ∪ T.image (stepImg eA8) ∪ T.image (stepImg eT16) ∪ T.image (stepImg eA8i)
def S16 : Finset ℕ := step16^[6] {idCode}

lemma S16_card : S16.card = 16 := by decide
lemma step16_S16 : step16 S16 = S16 := by decide

lemma mem_step16_A8 {c} (hc : c ∈ S16) : stepImg eA8 c ∈ S16 := by
  have : stepImg eA8 c ∈ step16 S16 := by
    simp only [step16, Finset.mem_union, Finset.mem_image]
    exact Or.inl (Or.inl (Or.inr ⟨c, hc, rfl⟩))
  rwa [step16_S16] at this
lemma mem_step16_T16 {c} (hc : c ∈ S16) : stepImg eT16 c ∈ S16 := by
  have : stepImg eT16 c ∈ step16 S16 := by
    simp only [step16, Finset.mem_union, Finset.mem_image]
    exact Or.inl (Or.inr ⟨c, hc, rfl⟩)
  rwa [step16_S16] at this
lemma mem_step16_A8i {c} (hc : c ∈ S16) : stepImg eA8i c ∈ S16 := by
  have : stepImg eA8i c ∈ step16 S16 := by
    simp only [step16, Finset.mem_union, Finset.mem_image]; exact Or.inr ⟨c, hc, rfl⟩
  rwa [step16_S16] at this

lemma backward16 : ∀ n, ∀ c ∈ step16^[n] {idCode},
    ∃ p ∈ Subgroup.closure ({a8, t16} : Set (Equiv.Perm (Fin 11))), φ p = c := by
  have ha8 : a8 ∈ Subgroup.closure ({a8, t16} : Set (Equiv.Perm (Fin 11))) :=
    Subgroup.subset_closure (by left; rfl)
  have ht16 : t16 ∈ Subgroup.closure ({a8, t16} : Set (Equiv.Perm (Fin 11))) :=
    Subgroup.subset_closure (by right; rfl)
  intro n
  induction n with
  | zero =>
    intro c hc
    rw [Function.iterate_zero, id_eq, Finset.mem_singleton] at hc
    exact ⟨1, one_mem _, by rw [φ_one, hc]⟩
  | succ k ih =>
    intro c hc
    rw [Function.iterate_succ', Function.comp_apply] at hc
    simp only [step16, Finset.mem_union, Finset.mem_image] at hc
    rcases hc with (((h | ⟨c', hc', rfl⟩) | ⟨c', hc', rfl⟩) | ⟨c', hc', rfl⟩)
    · exact ih c h
    · obtain ⟨p, hp, rfl⟩ := ih c' hc'
      exact ⟨a8 * p, mul_mem ha8 hp, by rw [br_a8, applyGenF_φ]⟩
    · obtain ⟨p, hp, rfl⟩ := ih c' hc'
      exact ⟨t16 * p, mul_mem ht16 hp, by rw [br_t16, applyGenF_φ]⟩
    · obtain ⟨p, hp, rfl⟩ := ih c' hc'
      exact ⟨a8⁻¹ * p, mul_mem (inv_mem ha8) hp, by rw [br_a8i, applyGenF_φ]⟩

lemma P16_card : Nat.card ↥(Subgroup.closure ({a8, t16} : Set (Equiv.Perm (Fin 11)))) = 16 := by
  rw [card_closure_of_enc _ S16 (by decide)]
  · exact S16_card
  · intro x hx c hc
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
    rcases hx with rfl | rfl
    · exact ⟨by rw [← br_a8]; exact mem_step16_A8 hc, by rw [← br_a8i]; exact mem_step16_A8i hc⟩
    · refine ⟨by rw [← br_t16]; exact mem_step16_T16 hc, ?_⟩
      rw [t16_inv, ← br_t16]; exact mem_step16_T16 hc
  · exact backward16 6

lemma dvd16 : (16 : ℕ) ∣ Nat.card ↥M11 := by
  have hle : Subgroup.closure ({a8, t16} : Set (Equiv.Perm (Fin 11))) ≤ M11 := by
    rw [Subgroup.closure_le]; intro x hx
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
    rcases hx with rfl | rfl
    · exact a8_mem
    · exact t16_mem
  have := Subgroup.card_dvd_of_le hle; rwa [P16_card] at this

/-! #### The order-`9` Sylow `3`-subgroup `⟨x3, y3⟩` (`C₃×C₃`) -/

def x3 : Equiv.Perm (Fin 11) := m11a * m11b ^ 2
def y3 : Equiv.Perm (Fin 11) := m11a * m11a * m11b⁻¹ * m11a⁻¹ * m11b⁻¹ * m11a⁻¹ * m11a⁻¹
def eX3 : ℕ → ℕ := fun x => [1,2,0,5,4,10,8,7,9,6,3].getD x 0
def eX3i : ℕ → ℕ := fun x => [2,0,1,10,4,3,9,7,6,8,5].getD x 0
def eY3 : ℕ → ℕ := fun x => [9,6,8,2,4,0,10,7,3,5,1].getD x 0
def eY3i : ℕ → ℕ := fun x => [5,10,3,8,4,9,1,7,2,0,6].getD x 0

lemma x3_mem : x3 ∈ M11 := mul_mem m11a_mem (pow_mem m11b_mem 2)
lemma y3_mem : y3 ∈ M11 := by
  unfold y3
  exact mul_mem (mul_mem (mul_mem (mul_mem (mul_mem (mul_mem
    m11a_mem m11a_mem) (inv_mem m11b_mem)) (inv_mem m11a_mem)) (inv_mem m11b_mem))
    (inv_mem m11a_mem)) (inv_mem m11a_mem)

lemma br_x3 (n : ℕ) : stepImg eX3 n = applyGenF x3 n := stepImg_bridge x3 eX3 (by decide) n
lemma br_x3i (n : ℕ) : stepImg eX3i n = applyGenF x3⁻¹ n := stepImg_bridge x3⁻¹ eX3i (by decide) n
lemma br_y3 (n : ℕ) : stepImg eY3 n = applyGenF y3 n := stepImg_bridge y3 eY3 (by decide) n
lemma br_y3i (n : ℕ) : stepImg eY3i n = applyGenF y3⁻¹ n := stepImg_bridge y3⁻¹ eY3i (by decide) n

def step9 (T : Finset ℕ) : Finset ℕ :=
  T ∪ T.image (stepImg eX3) ∪ T.image (stepImg eY3) ∪ T.image (stepImg eX3i)
    ∪ T.image (stepImg eY3i)
def S9 : Finset ℕ := step9^[6] {idCode}

lemma S9_card : S9.card = 9 := by decide
lemma step9_S9 : step9 S9 = S9 := by decide

lemma mem_step9_X3 {c} (hc : c ∈ S9) : stepImg eX3 c ∈ S9 := by
  have : stepImg eX3 c ∈ step9 S9 := by
    simp only [step9, Finset.mem_union, Finset.mem_image]
    exact Or.inl (Or.inl (Or.inl (Or.inr ⟨c, hc, rfl⟩)))
  rwa [step9_S9] at this
lemma mem_step9_Y3 {c} (hc : c ∈ S9) : stepImg eY3 c ∈ S9 := by
  have : stepImg eY3 c ∈ step9 S9 := by
    simp only [step9, Finset.mem_union, Finset.mem_image]
    exact Or.inl (Or.inl (Or.inr ⟨c, hc, rfl⟩))
  rwa [step9_S9] at this
lemma mem_step9_X3i {c} (hc : c ∈ S9) : stepImg eX3i c ∈ S9 := by
  have : stepImg eX3i c ∈ step9 S9 := by
    simp only [step9, Finset.mem_union, Finset.mem_image]; exact Or.inl (Or.inr ⟨c, hc, rfl⟩)
  rwa [step9_S9] at this
lemma mem_step9_Y3i {c} (hc : c ∈ S9) : stepImg eY3i c ∈ S9 := by
  have : stepImg eY3i c ∈ step9 S9 := by
    simp only [step9, Finset.mem_union, Finset.mem_image]; exact Or.inr ⟨c, hc, rfl⟩
  rwa [step9_S9] at this

lemma backward9 : ∀ n, ∀ c ∈ step9^[n] {idCode},
    ∃ p ∈ Subgroup.closure ({x3, y3} : Set (Equiv.Perm (Fin 11))), φ p = c := by
  have hx : x3 ∈ Subgroup.closure ({x3, y3} : Set (Equiv.Perm (Fin 11))) :=
    Subgroup.subset_closure (by left; rfl)
  have hy : y3 ∈ Subgroup.closure ({x3, y3} : Set (Equiv.Perm (Fin 11))) :=
    Subgroup.subset_closure (by right; rfl)
  intro n
  induction n with
  | zero =>
    intro c hc
    rw [Function.iterate_zero, id_eq, Finset.mem_singleton] at hc
    exact ⟨1, one_mem _, by rw [φ_one, hc]⟩
  | succ k ih =>
    intro c hc
    rw [Function.iterate_succ', Function.comp_apply] at hc
    simp only [step9, Finset.mem_union, Finset.mem_image] at hc
    rcases hc with ((((h | ⟨c', hc', rfl⟩) | ⟨c', hc', rfl⟩) | ⟨c', hc', rfl⟩) | ⟨c', hc', rfl⟩)
    · exact ih c h
    · obtain ⟨p, hp, rfl⟩ := ih c' hc'
      exact ⟨x3 * p, mul_mem hx hp, by rw [br_x3, applyGenF_φ]⟩
    · obtain ⟨p, hp, rfl⟩ := ih c' hc'
      exact ⟨y3 * p, mul_mem hy hp, by rw [br_y3, applyGenF_φ]⟩
    · obtain ⟨p, hp, rfl⟩ := ih c' hc'
      exact ⟨x3⁻¹ * p, mul_mem (inv_mem hx) hp, by rw [br_x3i, applyGenF_φ]⟩
    · obtain ⟨p, hp, rfl⟩ := ih c' hc'
      exact ⟨y3⁻¹ * p, mul_mem (inv_mem hy) hp, by rw [br_y3i, applyGenF_φ]⟩

lemma P9_card : Nat.card ↥(Subgroup.closure ({x3, y3} : Set (Equiv.Perm (Fin 11)))) = 9 := by
  rw [card_closure_of_enc _ S9 (by decide)]
  · exact S9_card
  · intro x hx c hc
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
    rcases hx with rfl | rfl
    · exact ⟨by rw [← br_x3]; exact mem_step9_X3 hc, by rw [← br_x3i]; exact mem_step9_X3i hc⟩
    · exact ⟨by rw [← br_y3]; exact mem_step9_Y3 hc, by rw [← br_y3i]; exact mem_step9_Y3i hc⟩
  · exact backward9 6

lemma dvd9 : (9 : ℕ) ∣ Nat.card ↥M11 := by
  have hle : Subgroup.closure ({x3, y3} : Set (Equiv.Perm (Fin 11))) ≤ M11 := by
    rw [Subgroup.closure_le]; intro z hz
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hz
    rcases hz with rfl | rfl
    · exact x3_mem
    · exact y3_mem
  have := Subgroup.card_dvd_of_le hle; rwa [P9_card] at this

/-! #### The order-`5` and order-`11` elements -/

/-- An order-`5` element of `M₁₁`. -/
def w5 : Equiv.Perm (Fin 11) := m11a ^ 3 * m11b
lemma w5_mem : w5 ∈ M11 := mul_mem (pow_mem m11a_mem 3) m11b_mem

lemma dvd5 : (5 : ℕ) ∣ Nat.card ↥M11 := by
  have _f5 : Fact (Nat.Prime 5) := ⟨by norm_num⟩
  have ho : orderOf w5 = 5 := orderOf_eq_prime (by decide) (by decide)
  have := Subgroup.orderOf_dvd_natCard M11 w5_mem
  rwa [ho] at this

lemma dvd11 : (11 : ℕ) ∣ Nat.card ↥M11 := by
  have _f11 : Fact (Nat.Prime 11) := ⟨by norm_num⟩
  have ho : orderOf m11a = 11 := orderOf_eq_prime (by decide) (by decide)
  have := Subgroup.orderOf_dvd_natCard M11 m11a_mem
  rwa [ho] at this

/-! #### Assembling `Nat.card M₁₁ = 7920` -/

/-- **`7920 ∣ |M₁₁|`** from the coprime prime-power subgroups `16, 9, 5, 11`. -/
theorem M11_card_dvd : (7920 : ℕ) ∣ Nat.card ↥M11 := by
  have d144 : (144 : ℕ) ∣ Nat.card ↥M11 := by
    have := (show Nat.Coprime 16 9 by decide).mul_dvd_of_dvd_of_dvd dvd16 dvd9
    norm_num at this; exact this
  have d720 : (720 : ℕ) ∣ Nat.card ↥M11 := by
    have := (show Nat.Coprime 144 5 by decide).mul_dvd_of_dvd_of_dvd d144 dvd5
    norm_num at this; exact this
  have := (show Nat.Coprime 720 11 by decide).mul_dvd_of_dvd_of_dvd d720 dvd11
  norm_num at this; exact this

/-- **`native_decide`-free order of `M₁₁`.**  Combines the kernel-checked upper bound
`M11_card_le` with the coprime-subgroup divisibility `M11_card_dvd`. -/
theorem M11_card_clean : Nat.card M11 = 7920 := by
  have hpos : 0 < Nat.card ↥M11 := Nat.card_pos
  have hle := M11_card_le
  have hge := Nat.le_of_dvd hpos M11_card_dvd
  omega

end EnumM11

end Mathieu
