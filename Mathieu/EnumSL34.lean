import Mathieu.F4
import Mathieu.CardSL

/-!
# `SL(3, F4)` is generated by three explicit matrices

We show that the three matrices

* `g1 = t₀₁(1)` (an elementary transvection),
* `g2 = t₀₁(ω)` (a transvection with the field generator `ω = ⟨0,1⟩`),
* `g3` the cyclic coordinate permutation matrix,

generate the whole special linear group `SL(3, F4)`.

The proof is **structural** (no enumeration / `native_decide`), mirroring `EnumSL223.lean`
(`SL(2, 𝔽₂₃)`): it uses the classical fact that `SLₙ` over a field is generated by elementary
transvections, packaged by Mathlib's `Matrix.diagonal_transvection_induction`.  The two
obligations are

* every elementary transvection `t_{ij}(c)` lies in the closure `⟨g1, g2, g3⟩`
  (`incl_transvection`) — obtained from the base transvections `t₀₁(c)` by conjugation with the
  cyclic permutation `g3` (giving `t₁₂`, `t₂₀`) and by commutators (giving `t₀₂`, `t₁₀`, `t₂₁`;
  recall `[t_{ij}(a), t_{jk}(b)] = t_{ik}(ab)`, and in characteristic two every transvection is
  its own inverse, so a commutator is the plain product `a*b*a*b`); and
* every determinant-one diagonal matrix lies in the closure (`incl_diagonal`) — built from the
  `2×2` "torus" words `diag(x, x⁻¹, 1)` and `diag(1, x, x⁻¹)`.

Each concrete matrix identity over the computable four-element field `F4` is discharged by the
Lean **kernel** (`decide`); many are phrased as `∀ c : F4, …` (still a finite, kernel-decidable
statement).  The order `|SL(3, F4)| = 60480` (`slCard`) is derived pen-and-paper from
`CardSL`, independently of any enumeration.
-/

namespace Mathieu

open Matrix
open scoped MatrixGroups

namespace EnumSL34

set_option maxRecDepth 10000
set_option maxHeartbeats 1000000

/-- The transvection `t₀₁(1) ∈ SL(3, F4)`. -/
def g1 : SL(3, F4) := ⟨!![1,1,0;0,1,0;0,0,1], by decide⟩

/-- The transvection `t₀₁(ω) ∈ SL(3, F4)`, with `ω = ⟨0,1⟩`. -/
def g2 : SL(3, F4) := ⟨!![1,⟨0,1⟩,0;0,1,0;0,0,1], by decide⟩

/-- The cyclic coordinate permutation matrix in `SL(3, F4)`. -/
def g3 : SL(3, F4) := ⟨!![0,0,1;1,0,0;0,1,0], by decide⟩

/-- `|SL(3, F4)| = 60480`, obtained (pen-and-paper) from `|GL(3, F4)| = 181440` via the order
formula `CardSL.card_GL_eq_card_SL_mul` and `|F4ˣ| = 3`, rather than by enumeration. -/
theorem slCard : Fintype.card SL(3, F4) = 60480 := by
  have hGL : Nat.card (GL (Fin 3) F4) = 181440 := by
    rw [Matrix.card_GL_field, show Fintype.card F4 = 4 from F4.card]
    norm_num [Fin.prod_univ_three]
  have hmul := CardSL.card_GL_eq_card_SL_mul (𝔽 := F4) (n := 3)
  rw [hGL, show Fintype.card F4 = 4 from F4.card] at hmul
  rw [← Nat.card_eq_fintype_card]
  omega

/-! ### The closure and its membership predicate -/

/-- The subgroup generated by the three matrices. -/
abbrev cl : Subgroup (SL(3, F4)) := Subgroup.closure {g1, g2, g3}

lemma hg1 : g1 ∈ cl := Subgroup.subset_closure (by simp)
lemma hg2 : g2 ∈ cl := Subgroup.subset_closure (by simp)
lemma hg3 : g3 ∈ cl := Subgroup.subset_closure (by simp)

/-- `M` is the underlying matrix of some element of the closure `cl`. -/
def InCl (M : Matrix (Fin 3) (Fin 3) F4) : Prop :=
  ∃ s : SL(3, F4), s ∈ cl ∧ (s : Matrix (Fin 3) (Fin 3) F4) = M

lemma InCl.one : InCl 1 := ⟨1, one_mem _, by simp⟩

lemma InCl.mul {A B} (hA : InCl A) (hB : InCl B) : InCl (A * B) := by
  obtain ⟨s, hs, rfl⟩ := hA; obtain ⟨t, ht, rfl⟩ := hB
  exact ⟨s * t, mul_mem hs ht, by rw [Matrix.SpecialLinearGroup.coe_mul]⟩

lemma InCl.gen1 : InCl (!![1,1,0;0,1,0;0,0,1]) := ⟨g1, hg1, rfl⟩
lemma InCl.gen2 : InCl (!![1,⟨0,1⟩,0;0,1,0;0,0,1]) := ⟨g2, hg2, rfl⟩
lemma InCl.gen3 : InCl (!![0,0,1;1,0,0;0,1,0]) := ⟨g3, hg3, rfl⟩

/-- Conjugation by `g3` (using `g3⁻¹ = g3²`, so the conjugate is the plain product
`g3 * M * g3 * g3`). -/
lemma InCl.sh {M} (h : InCl M) :
    InCl (!![0,0,1;1,0,0;0,1,0] * M * !![0,0,1;1,0,0;0,1,0] * !![0,0,1;1,0,0;0,1,0]) :=
  ((InCl.gen3.mul h).mul InCl.gen3).mul InCl.gen3

/-- In characteristic two, a commutator of transvections is the plain product `A*B*A*B`. -/
lemma InCl.cm {A B} (hA : InCl A) (hB : InCl B) : InCl (A * B * A * B) :=
  ((hA.mul hB).mul hA).mul hB

/-! ### Every elementary transvection lies in the closure -/

/-- Base case: the transvections `t₀₁(c)` (`c ∈ F4`) come directly from `g1`, `g2`. -/
lemma incl01 (c : F4) : InCl (transvection 0 1 c) := by
  have h0 : InCl (transvection (0:Fin 3) 1 (0:F4)) := by
    rw [show transvection (0:Fin 3) 1 (0:F4) = 1 from by decide]; exact InCl.one
  have hom : InCl (transvection (0:Fin 3) 1 (⟨0,1⟩:F4)) := by
    rw [show transvection (0:Fin 3) 1 (⟨0,1⟩:F4) = !![1,⟨0,1⟩,0;0,1,0;0,0,1] from by decide]
    exact InCl.gen2
  have h1 : InCl (transvection (0:Fin 3) 1 (1:F4)) := by
    rw [show transvection (0:Fin 3) 1 (1:F4) = !![1,1,0;0,1,0;0,0,1] from by decide]
    exact InCl.gen1
  have homi : InCl (transvection (0:Fin 3) 1 (⟨1,1⟩:F4)) := by
    rw [show transvection (0:Fin 3) 1 (⟨1,1⟩:F4)
        = !![1,1,0;0,1,0;0,0,1] * !![1,⟨0,1⟩,0;0,1,0;0,0,1] from by decide]
    exact InCl.gen1.mul InCl.gen2
  rcases c with ⟨a, b⟩; fin_cases a <;> fin_cases b
  · exact h0
  · exact hom
  · exact h1
  · exact homi

/-- `t₁₂(c) = g3 · t₀₁(c) · g3⁻¹`. -/
lemma incl12 (c : F4) : InCl (transvection 1 2 c) := by
  rw [show transvection (1:Fin 3) 2 c
      = !![0,0,1;1,0,0;0,1,0] * transvection 0 1 c * !![0,0,1;1,0,0;0,1,0] * !![0,0,1;1,0,0;0,1,0]
      from by revert c; decide]
  exact (incl01 c).sh

/-- `t₂₀(c) = g3 · t₁₂(c) · g3⁻¹`. -/
lemma incl20 (c : F4) : InCl (transvection 2 0 c) := by
  rw [show transvection (2:Fin 3) 0 c
      = !![0,0,1;1,0,0;0,1,0] * transvection 1 2 c * !![0,0,1;1,0,0;0,1,0] * !![0,0,1;1,0,0;0,1,0]
      from by revert c; decide]
  exact (incl12 c).sh

/-- `t₀₂(c) = [t₀₁(1), t₁₂(c)]`. -/
lemma incl02 (c : F4) : InCl (transvection 0 2 c) := by
  rw [show transvection (0:Fin 3) 2 c
      = transvection 0 1 1 * transvection 1 2 c * transvection 0 1 1 * transvection 1 2 c
      from by revert c; decide]
  exact (incl01 1).cm (incl12 c)

/-- `t₁₀(c) = [t₁₂(1), t₂₀(c)]`. -/
lemma incl10 (c : F4) : InCl (transvection 1 0 c) := by
  rw [show transvection (1:Fin 3) 0 c
      = transvection 1 2 1 * transvection 2 0 c * transvection 1 2 1 * transvection 2 0 c
      from by revert c; decide]
  exact (incl12 1).cm (incl20 c)

/-- `t₂₁(c) = [t₂₀(1), t₀₁(c)]`. -/
lemma incl21 (c : F4) : InCl (transvection 2 1 c) := by
  rw [show transvection (2:Fin 3) 1 c
      = transvection 2 0 1 * transvection 0 1 c * transvection 2 0 1 * transvection 0 1 c
      from by revert c; decide]
  exact (incl20 1).cm (incl01 c)

/-- **Every elementary transvection lies in the closure.** -/
lemma incl_transvection (i j : Fin 3) (hij : i ≠ j) (c : F4) : InCl (transvection i j c) := by
  fin_cases i <;> fin_cases j <;>
    first
      | exact absurd rfl hij
      | exact incl01 c | exact incl02 c | exact incl10 c
      | exact incl12 c | exact incl20 c | exact incl21 c

/-! ### Every determinant-one diagonal matrix lies in the closure -/

/-- The "top" torus word `diag(x, x⁻¹, 1)` (a product of `t₀₁`/`t₁₀` transvections). -/
lemma Htop (x : F4) (hx : x ≠ 0) : InCl (diagonal ![x, x⁻¹, 1]) := by
  rw [show (diagonal ![x, x⁻¹, 1] : Matrix (Fin 3) (Fin 3) F4)
      = transvection 0 1 x * transvection 1 0 x⁻¹ * transvection 0 1 x
        * transvection 0 1 1 * transvection 1 0 1 * transvection 0 1 1
      from by revert x hx; decide]
  exact (((((incl01 x).mul (incl10 x⁻¹)).mul (incl01 x)).mul (incl01 1)).mul (incl10 1)).mul
    (incl01 1)

/-- The "bottom" torus word `diag(1, x, x⁻¹)` (a product of `t₁₂`/`t₂₁` transvections). -/
lemma Hbot (x : F4) (hx : x ≠ 0) : InCl (diagonal ![1, x, x⁻¹]) := by
  rw [show (diagonal ![1, x, x⁻¹] : Matrix (Fin 3) (Fin 3) F4)
      = transvection 1 2 x * transvection 2 1 x⁻¹ * transvection 1 2 x
        * transvection 1 2 1 * transvection 2 1 1 * transvection 1 2 1
      from by revert x hx; decide]
  exact (((((incl12 x).mul (incl21 x⁻¹)).mul (incl12 x)).mul (incl12 1)).mul (incl21 1)).mul
    (incl12 1)

/-- **Every determinant-one diagonal matrix lies in the closure.** -/
lemma incl_diagonal (D : Fin 3 → F4) (hdet : (diagonal D).det = 1) : InCl (diagonal D) := by
  have hD : D = ![D 0, D 1, D 2] := by funext i; fin_cases i <;> rfl
  rw [hD]
  have hprod : D 0 * D 1 * D 2 = 1 := by
    have h2 := hdet; rw [hD] at h2
    simpa [Matrix.det_diagonal, Fin.prod_univ_three] using h2
  have ha : D 0 ≠ 0 := by rintro h; rw [h] at hprod; simp at hprod
  have hb : D 1 ≠ 0 := by rintro h; rw [h] at hprod; simp at hprod
  have hab : D 0 * D 1 ≠ 0 := mul_ne_zero ha hb
  rw [show (diagonal ![D 0, D 1, D 2] : Matrix (Fin 3) (Fin 3) F4)
      = diagonal ![D 0, (D 0)⁻¹, 1] * diagonal ![1, D 0 * D 1, (D 0 * D 1)⁻¹]
      from by
        revert hprod; generalize D 0 = a; generalize D 1 = b; generalize D 2 = c
        revert a b c; decide]
  exact (Htop (D 0) ha).mul (Hbot (D 0 * D 1) hab)

/-! ### The closure is everything -/

/-- **`g1, g2, g3` generate `SL(3, F4)`.**  Proved structurally by the transvection–diagonal
induction (`Matrix.diagonal_transvection_induction`), without any enumeration / `native_decide`. -/
theorem closure_eq_top : Subgroup.closure ({g1, g2, g3} : Set (SL(3, F4))) = ⊤ := by
  show cl = ⊤
  rw [eq_top_iff]
  rintro g -
  have hgdet : ((g : Matrix (Fin 3) (Fin 3) F4)).det = 1 := g.2
  have hP : InCl (g : Matrix (Fin 3) (Fin 3) F4) := by
    refine Matrix.diagonal_transvection_induction InCl _ ?_ ?_ ?_
    · intro D hD; exact incl_diagonal D (hD.trans hgdet)
    · intro t; rw [Matrix.TransvectionStruct.toMatrix]
      exact incl_transvection t.i t.j t.hij t.c
    · intro A B hA hB; exact hA.mul hB
  obtain ⟨s, hs, hse⟩ := hP
  have hsg : s = g := Subtype.ext hse
  rwa [hsg] at hs

end EnumSL34

end Mathieu
