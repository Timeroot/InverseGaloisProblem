/-! ### Order four without fixed points, in codes

The class `4C` is cut out among the relevant codes by two conjugation-invariant tests: the
fourth power is the identity, and no one of the `22` moving points is fixed.  Only the easy
implication is needed below, namely that a conjugate of `y` passes them. -/

/-- The fixed-point test on a code, over the `22` moving points: some base-`23` digit with index
below `22` equals its index. -/
def hasFix (n : ℕ) : Bool := (List.range 22).any (fun i => dg23 n i == i)

/-- The membership test for `4C` on a code: the fourth power is the identity and no moving point
is fixed. -/
def testY (q : ℕ) : Bool := (mulC23 (mulC23 q q) (mulC23 q q) == idCode23) && !hasFix q

/-- The keys of the involution tree whose product with `z⁻¹` passes the `4C` test: an
over-approximation of the structure-constant fibre. -/
noncomputable def fibreList : List ℕ := TX.toList.filter (fun k => testY (mulC23 k cZi))

lemma fibreList_length : fibreList.length = 11 := by decide +kernel

/-! ### The structure constant -/

/-- Every element of the class of `x` squares to one. -/
lemma sq_eq_one_of_conj {w : ↥AutM22} (hw : ConjClasses.mk w = ConjClasses.mk xEl) :
    w⁻¹ = w := by
  obtain ⟨c, hc⟩ := isConj_iff.mp (ConjClasses.mk_eq_mk_iff_isConj.mp hw)
  have h1 : c * (w * w) * c⁻¹ = 1 := by
    rw [show c * (w * w) * c⁻¹ = (c * w * c⁻¹) * (c * w * c⁻¹) by group, hc, xEl_sq]
  have h2 : w * w = c⁻¹ * (c * (w * w) * c⁻¹) * c := by group
  rw [h1] at h2
  simp only [mul_one, inv_mul_cancel] at h2
  exact inv_eq_of_mul_eq_one_right h2

/-- The fourth power of `y` is the identity. -/
lemma y0_pow_four : (y0 * y0) * (y0 * y0) = 1 := by decide

/-- `y` moves every one of the `22` points it is allowed to move. -/
lemma y0_nofix : ∀ a : Fin 23, y0 a = a → a = 22 := by decide

/-- Every element of the class of `y` passes the `4C` test on codes. -/
lemma testY_of_conj {u : ↥AutM22} (hu : ConjClasses.mk u = ConjClasses.mk yEl) :
    testY (φ23 ((u : Perm (Fin 23)))) = true := by
  obtain ⟨c, hc⟩ := isConj_iff.mp (ConjClasses.mk_eq_mk_iff_isConj.mp hu)
  set p : Perm (Fin 23) := (u : Perm (Fin 23)) with hp
  set d : Perm (Fin 23) := (c : Perm (Fin 23)) with hd
  have hd22 : d (22 : Fin 23) = 22 := fix22 c.2
  have hcp : d * p * d⁻¹ = y0 := congrArg Subtype.val hc
  have hpd : p = d⁻¹ * y0 * d := by rw [← hcp]; group
  have hp4 : (p * p) * (p * p) = 1 := by
    rw [hpd]
    calc d⁻¹ * y0 * d * (d⁻¹ * y0 * d) * (d⁻¹ * y0 * d * (d⁻¹ * y0 * d))
        = d⁻¹ * ((y0 * y0) * (y0 * y0)) * d := by group
      _ = 1 := by rw [y0_pow_four]; group
  have hmul : mulC23 (φ23 p) (φ23 p) = φ23 (p * p) := mulC23_φ23 p p
  have hfour : mulC23 (mulC23 (φ23 p) (φ23 p)) (mulC23 (φ23 p) (φ23 p)) = idCode23 := by
    rw [hmul, mulC23_φ23, hp4, φ23_one]
  have hnf : hasFix (φ23 p) = false := by
    rw [Bool.eq_false_iff, ne_eq, hasFix, List.any_eq_true]
    rintro ⟨i, hi, hii⟩
    rw [List.mem_range] at hi
    simp only [beq_iff_eq] at hii
    have hlt : i < 23 := by omega
    have hval : (p ⟨i, hlt⟩).val = i := by rw [dg23_φ23 p ⟨i, hlt⟩]; exact hii
    have hfix : p ⟨i, hlt⟩ = ⟨i, hlt⟩ := Fin.ext hval
    have hy : y0 (d ⟨i, hlt⟩) = d ⟨i, hlt⟩ := by
      have h := congrArg (fun v : Fin 23 => d v) hfix
      simp only at h
      rw [hpd] at h
      simp only [Equiv.Perm.coe_mul, Function.comp_apply] at h
      calc y0 (d ⟨i, hlt⟩) = d (d⁻¹ (y0 (d ⟨i, hlt⟩))) := (d.apply_symm_apply _).symm
        _ = d ⟨i, hlt⟩ := h
    have h22 : d ⟨i, hlt⟩ = (22 : Fin 23) := y0_nofix _ hy
    have : (⟨i, hlt⟩ : Fin 23) = (22 : Fin 23) := d.injective (by rw [h22, hd22])
    omega
  unfold testY
  rw [hfour, hnf, beq_self_eq_true, Bool.not_false, Bool.and_true]

theorem card_prodOneFibre_le :
    Nat.card (prodOneFibre (classTriple 0) (classTriple 1) zEl) ≤ 11 := by
  classical
  have hmap : ∀ w ∈ prodOneFibre (classTriple 0) (classTriple 1) zEl,
      φ23 ((w : Perm (Fin 23))) ∈ fibreList := by
    rintro w ⟨hw0, hw1⟩
    rw [classTriple_zero] at hw0
    rw [classTriple_one] at hw1
    have hinv : w⁻¹ = w := sq_eq_one_of_conj hw0
    have hX : TX.mem (φ23 ((w : Perm (Fin 23)))) = true :=
      key_of_conjClass TX_closed TX_mem_x0 (u := xEl) rfl hw0
    have hY : testY (φ23 (((w⁻¹ * zEl⁻¹ : ↥AutM22) : Perm (Fin 23)))) = true := testY_of_conj hw1
    have hcoe : (((w⁻¹ * zEl⁻¹ : ↥AutM22) : Perm (Fin 23)))
        = ((w : Perm (Fin 23)))⁻¹ * zPerm⁻¹ := rfl
    rw [hcoe, show ((w : Perm (Fin 23)))⁻¹ = (w : Perm (Fin 23)) from congrArg Subtype.val hinv]
      at hY
    have hmul : mulC23 (φ23 ((w : Perm (Fin 23)))) cZi
        = φ23 ((w : Perm (Fin 23)) * zPerm⁻¹) := by
      rw [← cZi_eq, mulC23_φ23]
    refine List.mem_filter.mpr ⟨Btree.mem_toList hX, ?_⟩
    rw [hmul]
    exact hY
  have hinj : Set.InjOn (fun w : ↥AutM22 => φ23 ((w : Perm (Fin 23))))
      (prodOneFibre (classTriple 0) (classTriple 1) zEl) := by
    intro u _ v _ huv
    exact Subtype.ext (φ23_injective huv)
  have hcard : (prodOneFibre (classTriple 0) (classTriple 1) zEl).ncard
      ≤ ((fibreList.toFinset : Finset ℕ) : Set ℕ).ncard :=
    Set.ncard_le_ncard_of_injOn _
      (fun w hw => Finset.mem_coe.mpr (List.mem_toFinset.mpr (hmap w hw))) hinj
      (Finset.finite_toSet _)
  rw [Set.ncard_coe_finset] at hcard
  calc Nat.card ↥(prodOneFibre (classTriple 0) (classTriple 1) zEl)
      = (prodOneFibre (classTriple 0) (classTriple 1) zEl).ncard := Nat.card_coe_set_eq _
    _ ≤ fibreList.toFinset.card := hcard
    _ ≤ fibreList.length := List.toFinset_card_le _
    _ = 11 := fibreList_length

/-! ### The centralizer of the order-eleven element -/

lemma zPerm_pow_eleven : zPerm ^ 11 = 1 := by decide

lemma zPerm_ne_one : zPerm ≠ 1 := by decide

lemma zEl_pow_eleven : zEl ^ 11 = 1 := Subtype.ext zPerm_pow_eleven

lemma zEl_ne_one : zEl ≠ 1 := by
  intro h
  apply zPerm_ne_one
  have h' := Subtype.ext_iff.mp h
  rw [OneMemClass.coe_one] at h'
  exact h'

lemma orderOf_zEl : orderOf zEl = 11 := by
  haveI : Fact (Nat.Prime 11) := ⟨by norm_num⟩
  exact orderOf_eq_prime zEl_pow_eleven zEl_ne_one

theorem eleven_le_centralizer :
    11 ≤ Nat.card ↥(Subgroup.centralizer ({zEl} : Set ↥AutM22)) := by
  have hle : Subgroup.zpowers zEl ≤ Subgroup.centralizer ({zEl} : Set ↥AutM22) := by
    rw [Subgroup.zpowers_le]
    exact Subgroup.mem_centralizer_iff.mpr (by rintro m rfl; rfl)
  have hcard : Nat.card ↥(Subgroup.zpowers zEl)
      ≤ Nat.card ↥(Subgroup.centralizer ({zEl} : Set ↥AutM22)) :=
    Nat.card_le_card_of_injective _ (Subgroup.inclusion_injective hle)
  rwa [Nat.card_zpowers, orderOf_zEl] at hcard

/-! ### Rigidity -/

theorem xEl_mem_prodOneFibre :
    xEl ∈ prodOneFibre (classTriple 0) (classTriple 1) zEl := ⟨rfl, rfl⟩

/-- **The class triple `(2B, 4C, 11A)` is rigid in `Aut(M₂₂)`.**  The product-one triples with
entries in these three classes form a single orbit under simultaneous conjugation, of full size
`|Aut(M₂₂)| = 887040`, and every one of them generates. -/
theorem rigid_triple : Nat.card ↥(rigidTuples classTriple) = Nat.card ↥AutM22 :=
  rigid_of_card_prodOneFibre center_eq_bot gen_top xEl_mem_prodOneFibre classTriple_two
    (le_trans card_prodOneFibre_le eleven_le_centralizer)

/-! ### All three classes are rational -/

/-- An exponent may be reduced modulo any exponent of the element. -/
lemma pow_mod_of_pow_eq_one {g : ↥AutM22} {m : ℕ} (hm : g ^ m = 1) (u : ℕ) :
    g ^ u = g ^ (u % m) := by
  conv_lhs => rw [← Nat.div_add_mod u m]
  rw [pow_add, pow_mul, hm, one_pow, one_mul]

lemma xEl_pow_two : xEl ^ 2 = 1 := by rw [pow_two]; exact xEl_sq

lemma xEl_ne_one : xEl ≠ 1 := by
  intro h
  have h' : sigma22 = (1 : Perm (Fin 23)) := congrArg Subtype.val h
  exact absurd h' (by decide)

lemma orderOf_xEl : orderOf xEl = 2 := by
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  exact orderOf_eq_prime xEl_pow_two xEl_ne_one

/-- The class `2B` is rational: an involution is its own odd power. -/
theorem rational_x : IsRationalClass (ConjClasses.mk xEl) := by
  refine isRationalClass_mk_of_rep ?_
  intro k hk
  rw [orderOf_xEl] at hk
  have h2 : ¬ (2 ∣ k) := by
    intro h
    have : (2 : ℕ) ∣ Nat.gcd k 2 := Nat.dvd_gcd h dvd_rfl
    rw [hk] at this
    omega
  rw [pow_mod_of_pow_eq_one xEl_pow_two k, show k % 2 = 1 by omega, pow_one]

/-- A word in the two generators conjugating `y` to its inverse. -/
def gy0 : Perm (Fin 23) :=
  zPerm⁻¹ * zPerm⁻¹ * zPerm⁻¹ * sigma22 * zPerm⁻¹ * zPerm⁻¹ * zPerm⁻¹ * sigma22 * zPerm *
    zPerm * zPerm * sigma22 * zPerm * sigma22 * zPerm⁻¹ * zPerm⁻¹ * sigma22 * zPerm⁻¹ *
    sigma22 * zPerm

lemma gy0_mem : gy0 ∈ AutM22 := by
  have hs := sigma22_mem
  have hz := zPerm_mem
  have hzi := zPerm_inv_mem
  exact (mul_mem (mul_mem (mul_mem (mul_mem (mul_mem (mul_mem (mul_mem (mul_mem (mul_mem
    (mul_mem (mul_mem (mul_mem (mul_mem (mul_mem (mul_mem (mul_mem (mul_mem (mul_mem (mul_mem
    hzi hzi) hzi) hs) hzi) hzi) hzi) hs) hz) hz) hz) hs) hz) hs) hzi) hzi) hs) hzi) hs) hz)

/-- The conjugator inverting the order-four entry. -/
def gyEl : ↥AutM22 := ⟨gy0, gy0_mem⟩

lemma conj_yEl_inv : gyEl * yEl * gyEl⁻¹ = yEl⁻¹ := by
  apply Subtype.ext
  show gy0 * y0 * gy0⁻¹ = y0⁻¹
  decide

lemma yEl_pow_four : yEl ^ 4 = 1 := by
  have h : (yEl * yEl) * (yEl * yEl) = 1 := Subtype.ext y0_pow_four
  rw [show (4 : ℕ) = 2 + 2 from rfl, pow_add, pow_two]
  exact h

lemma yEl_sq_ne_one : yEl ^ 2 ≠ 1 := by
  intro h
  have h2 : y0 * y0 = 1 := by
    have h3 : ((yEl * yEl : ↥AutM22) : Perm (Fin 23)) = ((1 : ↥AutM22) : Perm (Fin 23)) :=
      congrArg Subtype.val (by rw [← pow_two]; exact h)
    exact h3
  exact absurd h2 (by decide)

lemma orderOf_yEl : orderOf yEl = 4 := by
  refine orderOf_eq_of_pow_and_pow_div_prime (by norm_num) yEl_pow_four ?_
  intro p hp hpd
  have hple : p ≤ 4 := Nat.le_of_dvd (by norm_num) hpd
  have hpge : 2 ≤ p := hp.two_le
  interval_cases p
  · exact yEl_sq_ne_one
  · exact absurd hpd (by norm_num)
  · exact absurd hp (by norm_num)

/-- The class `4C` is rational: `y` is conjugate to `y⁻¹ = y³`. -/
theorem rational_y : IsRationalClass (ConjClasses.mk yEl) := by
  refine isRationalClass_mk_of_rep ?_
  intro k hk
  rw [orderOf_yEl] at hk
  have h2 : ¬ (2 ∣ k) := by
    intro h
    have : (2 : ℕ) ∣ Nat.gcd k 4 := Nat.dvd_gcd h (by norm_num)
    rw [hk] at this
    omega
  have hinv : ConjClasses.mk yEl⁻¹ = ConjClasses.mk yEl :=
    (ConjClasses.mk_eq_mk_iff_isConj.mpr (isConj_iff.mpr ⟨gyEl, conj_yEl_inv⟩)).symm
  have hcube : yEl ^ 3 = yEl⁻¹ := by
    refine eq_inv_of_mul_eq_one_left ?_
    calc yEl ^ 3 * yEl = yEl ^ 4 := by group
      _ = 1 := yEl_pow_four
  rw [pow_mod_of_pow_eq_one yEl_pow_four k]
  rcases (by omega : k % 4 = 1 ∨ k % 4 = 3) with h | h
  · rw [h, pow_one]
  · rw [h, hcube]; exact hinv

/-- A word in the two generators conjugating `z` to its square. -/
def gz0 : Perm (Fin 23) :=
  sigma22 * zPerm * sigma22 * zPerm⁻¹ * zPerm⁻¹ * sigma22 * zPerm⁻¹ * zPerm⁻¹ * zPerm⁻¹ *
    zPerm⁻¹ * sigma22 * zPerm * zPerm * zPerm * zPerm * zPerm * sigma22 * zPerm * zPerm *
    zPerm * sigma22 * zPerm * zPerm * sigma22

lemma gz0_mem : gz0 ∈ AutM22 := by
  have hs := sigma22_mem
  have hz := zPerm_mem
  have hzi := zPerm_inv_mem
  exact (mul_mem (mul_mem (mul_mem (mul_mem (mul_mem (mul_mem (mul_mem (mul_mem (mul_mem
    (mul_mem (mul_mem (mul_mem (mul_mem (mul_mem (mul_mem (mul_mem (mul_mem (mul_mem (mul_mem
    (mul_mem (mul_mem (mul_mem (mul_mem hs hz) hs) hzi) hzi) hs) hzi) hzi) hzi) hzi) hs) hz)
    hz) hz) hz) hz) hs) hz) hz) hz) hs) hz) hz) hs)

/-- The conjugator squaring the order-eleven entry. -/
def gzEl : ↥AutM22 := ⟨gz0, gz0_mem⟩

lemma conj_zEl_sq : gzEl * zEl * gzEl⁻¹ = zEl ^ 2 := by
  apply Subtype.ext
  show gz0 * zPerm * gz0⁻¹ = zPerm ^ 2
  decide

/-- Conjugating by `gz` doubles the exponent of the order-eleven element. -/
lemma mk_zEl_conj (k : ℕ) : ConjClasses.mk (zEl ^ (2 * k)) = ConjClasses.mk (zEl ^ k) := by
  refine (ConjClasses.mk_eq_mk_iff_isConj.mpr (isConj_iff.mpr ⟨gzEl, ?_⟩)).symm
  have h : ∀ n : ℕ, gzEl * zEl ^ n * gzEl⁻¹ = (gzEl * zEl * gzEl⁻¹) ^ n := by
    intro n
    induction n with
    | zero => simp
    | succ m ih => rw [pow_succ, pow_succ, ← ih]; group
  rw [h k, conj_zEl_sq, ← pow_mul]

lemma zEl_pow_mod (u : ℕ) : zEl ^ u = zEl ^ (u % 11) := pow_mod_of_pow_eq_one zEl_pow_eleven u

/-- Doubling the exponent modulo eleven does not change the class of the power. -/
lemma mk_zEl_step {j k : ℕ} (h : j % 11 = (2 * k) % 11) :
    ConjClasses.mk (zEl ^ j) = ConjClasses.mk (zEl ^ k) := by
  rw [zEl_pow_mod j, h, ← zEl_pow_mod (2 * k)]
  exact mk_zEl_conj k

/-- The class `11A` is rational: `2` is a primitive root modulo `11`, so conjugation by `gz`
already reaches every power of `z` with exponent prime to eleven. -/
theorem rational_z : IsRationalClass (ConjClasses.mk zEl) := by
  refine isRationalClass_mk_of_rep ?_
  intro k hk
  rw [orderOf_zEl] at hk
  have h11 : ¬ (11 ∣ k) := by
    intro h
    have : (11 : ℕ) ∣ Nat.gcd k 11 := Nat.dvd_gcd h dvd_rfl
    rw [hk] at this
    omega
  have e1 : ConjClasses.mk (zEl ^ 1) = ConjClasses.mk zEl := by rw [pow_one]
  have e2 : ConjClasses.mk (zEl ^ 2) = ConjClasses.mk zEl :=
    (mk_zEl_step (j := 2) (k := 1) (by norm_num)).trans e1
  have e4 : ConjClasses.mk (zEl ^ 4) = ConjClasses.mk zEl :=
    (mk_zEl_step (j := 4) (k := 2) (by norm_num)).trans e2
  have e8 : ConjClasses.mk (zEl ^ 8) = ConjClasses.mk zEl :=
    (mk_zEl_step (j := 8) (k := 4) (by norm_num)).trans e4
  have e5 : ConjClasses.mk (zEl ^ 5) = ConjClasses.mk zEl :=
    (mk_zEl_step (j := 5) (k := 8) (by norm_num)).trans e8
  have e10 : ConjClasses.mk (zEl ^ 10) = ConjClasses.mk zEl :=
    (mk_zEl_step (j := 10) (k := 5) (by norm_num)).trans e5
  have e9 : ConjClasses.mk (zEl ^ 9) = ConjClasses.mk zEl :=
    (mk_zEl_step (j := 9) (k := 10) (by norm_num)).trans e10
  have e7 : ConjClasses.mk (zEl ^ 7) = ConjClasses.mk zEl :=
    (mk_zEl_step (j := 7) (k := 9) (by norm_num)).trans e9
  have e3 : ConjClasses.mk (zEl ^ 3) = ConjClasses.mk zEl :=
    (mk_zEl_step (j := 3) (k := 7) (by norm_num)).trans e7
  have e6 : ConjClasses.mk (zEl ^ 6) = ConjClasses.mk zEl :=
    (mk_zEl_step (j := 6) (k := 3) (by norm_num)).trans e3
  obtain ⟨j, hj1, hj2, hjk⟩ : ∃ j, 1 ≤ j ∧ j < 11 ∧ k % 11 = j :=
    ⟨k % 11, by omega, Nat.mod_lt _ (by norm_num), rfl⟩
  rw [zEl_pow_mod k, hjk]
  interval_cases j
  exacts [e1, e2, e3, e4, e5, e6, e7, e8, e9, e10]

theorem rational : ∀ i, IsRationalClass (classTriple i) := by
  intro i
  fin_cases i
  exacts [rational_x, rational_y, rational_z]

/-! ### The certificate -/

/-- **A rigidity certificate for `Aut(M₂₂) = M₂₂ : 2`.**  The triple `(2B, 4C, 11A)` is rigid,
generating, and rational, and the group is centerless. -/
noncomputable def cert : RigidityCertificate ↥AutM22 :=
  RigidityCertificate.ofStructureConstant classTriple center_eq_bot rational gen_top
    xEl_mem_prodOneFibre classTriple_two (le_trans card_prodOneFibre_le eleven_le_centralizer)

/-- **`Aut(M₂₂)` is a regular Galois group over `ℚ(T)`.** -/
theorem isRegularInverseGalois : IsRegularInverseGalois ↥AutM22 :=
  cert.isRegularInverseGalois

/-- **`Aut(M₂₂)` is a Galois group over `ℚ`.** -/
theorem isInverseGalois : IsInverseGalois ↥AutM22 :=
  Rigidity.rigidity_realizable cert

end MathieuM22

end Rigidity
