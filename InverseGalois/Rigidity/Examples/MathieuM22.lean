import InverseGalois.Rigidity.StructureCount
import InverseGalois.Rigidity.Rigidity
import InverseGalois.Rigidity.RET.Descent
import Mathieu.EnumM11

/-!
# A rationally rigid class triple in `Aut(M₂₂)`

The Mathieu group `M₂₂` has no rigid class triple at all, but its automorphism group
`Aut(M₂₂) = M₂₂ : 2` has one, and — unlike every triple available inside a Mathieu group
itself — all three of its classes are **rational**.  This file certifies that triple in the
Lean kernel, and therefore realises `Aut(M₂₂)` as a regular Galois group over `ℚ(T)`.

The triple is Matzat's `(2B, 4C, 11A)`: an outer involution of cycle type `2⁷1⁹`, an outer
element of cycle type `4⁴2³1¹` acting without fixed points on the `22` moving points, and the
inner class of order `11` (the fusion of the two `M₂₂`-classes `11A`, `11B`).

## The concrete model

`Aut(M₂₂)` is realised inside `Perm (Fin 23)` exactly where `M₂₂` itself sits, as a group of
permutations of `{0, …, 21}` fixing `22`.  It is generated by two elements:

* `sigma22 = (0 17)(2 6)(3 13)(4 19)(5 21)(8 15)(9 20)`, an outer involution of class `2B`;
* `zPerm = (0 7 19 8 14 12 20 10 9 15 5)(1 11 3 4 18 17 21 13 2 16 6)`, an element of order
  eleven — it is the Schreier generator `EnumM22.schB 7` of the vendored `M₂₂`.

Their product-one partner `y = x⁻¹ z⁻¹` has cycle type `4⁴2³1¹`, and the structure constant
`#{w ∈ 2B : w⁻¹ z⁻¹ ∈ 4C}` equals `11 = |C(z)|`, which by `Rigidity.rigid_of_card_prodOneFibre`
is rigidity.

## How the count is certified

Permutations are handled in a base-`23` integer encoding (`enc23`, `dec23`, `φ23`) with a
multiplication `mulC23` of encoded permutations, the exact analogue of the base-`11` encoding of
`Mathieu.EnumM11`.  The class `2B` is stored as a binary search-tree literal `TX` with `330`
keys, checked by `decide` to be closed under conjugation by the two generators and their
inverses; since `Btree.mem` is one-sidedly sound, that gives the containment *class ⊆ tree*,
which is all an upper bound on the fibre needs.  The second class is cut out by the pair of
conjugation-invariant tests `q⁴ = 1` and "`q` moves every one of the points `0, …, 21`";
filtering `TX` by that test applied to `w z⁻¹` leaves exactly `11` keys.

Nothing here uses `native_decide`.

## Main results

* `Rigidity.MathieuM22.center_eq_bot` — `Aut(M₂₂)` is centerless.
* `Rigidity.MathieuM22.gen_top` — the pair `x, z` generates.
* `Rigidity.MathieuM22.rigid_triple` — `Nat.card (rigidTuples classTriple) = Nat.card (Aut M₂₂)`.
* `Rigidity.MathieuM22.cert` — the resulting `RigidityCertificate`.
* `Rigidity.MathieuM22.isRegularInverseGalois` — `Aut(M₂₂)` is a regular Galois group over `ℚ(T)`.
-/

namespace Rigidity

namespace MathieuM22

open Equiv Mathieu Mathieu.EnumM11

set_option maxHeartbeats 4000000
set_option maxRecDepth 1000000

/-! ### The base-`23` encoding of permutations -/

/-- Encode an image vector `f : Fin 23 → Fin 23` as the base-`23` numeral
`∑ i, (f i) * 23 ^ i`. -/
def enc23 (f : Fin 23 → Fin 23) : ℕ := ∑ i : Fin 23, (f i).val * 23 ^ (i : ℕ)

/-- Decode a natural number back to an image vector (`i`-th base-`23` digit). -/
def dec23 (n : ℕ) : Fin 23 → Fin 23 :=
  fun i => ⟨(n / 23 ^ (i : ℕ)) % 23, Nat.mod_lt _ (by norm_num)⟩

/-- Apply a permutation `g` to an encoded permutation: decode, left-multiply, re-encode. -/
def applyGenF23 (g : Perm (Fin 23)) (n : ℕ) : ℕ := enc23 (fun i => g (dec23 n i))

/-- Encoding of the identity permutation. -/
def idCode23 : ℕ := enc23 id

/-- The encoding of a permutation by its image vector. -/
def φ23 (p : Perm (Fin 23)) : ℕ := enc23 (fun i => p i)

lemma enc23_eq (f : Fin 23 → Fin 23) : enc23 f = (finFunctionFinEquiv f).val := by
  rw [finFunctionFinEquiv_apply_val]; rfl

lemma dec23_enc23 (f : Fin 23 → Fin 23) : dec23 (enc23 f) = f := by
  funext j
  apply Fin.ext
  show (enc23 f / 23 ^ (j : ℕ)) % 23 = (f j).val
  have h := finFunctionFinEquiv_symm_apply_val (finFunctionFinEquiv f) j
  rw [Equiv.symm_apply_apply] at h
  rw [enc23_eq]; omega

lemma φ23_injective : Function.Injective φ23 := by
  intro p q h
  have h2 : dec23 (φ23 p) = dec23 (φ23 q) := by rw [h]
  rw [φ23, φ23, dec23_enc23, dec23_enc23] at h2
  exact Equiv.ext (fun i => congrFun h2 i)

lemma applyGenF23_φ23 (g p : Perm (Fin 23)) : applyGenF23 g (φ23 p) = φ23 (g * p) := by
  unfold applyGenF23 φ23
  rw [dec23_enc23]
  congr 1

lemma φ23_one : φ23 1 = idCode23 := by
  unfold φ23 idCode23
  congr 1

/-- Kernel-friendly digit-permutation apply (no `Finset.sum`): permutes the base-`23` digits of
`n` by the table `t`. -/
def stepImg23 (t : ℕ → ℕ) (n : ℕ) : ℕ :=
  t (n / 23^0 % 23) + 23*(t (n / 23^1 % 23) + 23*(t (n / 23^2 % 23) + 23*(t (n / 23^3 % 23)
  + 23*(t (n / 23^4 % 23) + 23*(t (n / 23^5 % 23) + 23*(t (n / 23^6 % 23) + 23*(t (n / 23^7 % 23)
  + 23*(t (n / 23^8 % 23) + 23*(t (n / 23^9 % 23) + 23*(t (n / 23^10 % 23)
  + 23*(t (n / 23^11 % 23) + 23*(t (n / 23^12 % 23) + 23*(t (n / 23^13 % 23)
  + 23*(t (n / 23^14 % 23) + 23*(t (n / 23^15 % 23) + 23*(t (n / 23^16 % 23)
  + 23*(t (n / 23^17 % 23) + 23*(t (n / 23^18 % 23) + 23*(t (n / 23^19 % 23)
  + 23*(t (n / 23^20 % 23) + 23*(t (n / 23^21 % 23)
  + 23*(t (n / 23^22 % 23)))))))))))))))))))))))

/-- Generic bridge: a permutation `g` whose value table on `0..22` is `t` acts on encoded codes
as `stepImg23 t`. -/
lemma stepImg23_bridge (g : Perm (Fin 23)) (t : ℕ → ℕ)
    (h : ∀ x : Fin 23, (g x).val = t x.val) (n : ℕ) : stepImg23 t n = applyGenF23 g n := by
  simp only [applyGenF23, enc23, stepImg23, Fin.sum_univ_succ, Fin.sum_univ_zero, h, dec23,
    Fin.val_succ, Fin.val_zero]
  ring

/-! ### Multiplication of encoded permutations -/

/-- The `j`-th base-`23` digit of a code. -/
def dg23 (a j : ℕ) : ℕ := a / 23 ^ j % 23

/-- Product of two encoded permutations: permute the digits of the right factor by the digit
table of the left factor. -/
def mulC23 (a b : ℕ) : ℕ := stepImg23 (dg23 a) b

lemma dg23_φ23 (g : Perm (Fin 23)) (i : Fin 23) : (g i).val = dg23 (φ23 g) i.val := by
  have h : dec23 (φ23 g) = fun i => g i := dec23_enc23 _
  exact (congrArg Fin.val (congrFun h i)).symm

lemma mulC23_φ23 (g p : Perm (Fin 23)) : mulC23 (φ23 g) (φ23 p) = φ23 (g * p) := by
  rw [mulC23, stepImg23_bridge g (dg23 (φ23 g)) (dg23_φ23 g), applyGenF23_φ23]

lemma mulC23_conj (g q : Perm (Fin 23)) :
    mulC23 (φ23 g) (mulC23 (φ23 q) (φ23 g⁻¹)) = φ23 (g * q * g⁻¹) := by
  rw [mulC23_φ23, mulC23_φ23, mul_assoc]

lemma mulC23_conj' (g q : Perm (Fin 23)) :
    mulC23 (φ23 g⁻¹) (mulC23 (φ23 q) (φ23 g)) = φ23 (g⁻¹ * q * g) := by
  rw [mulC23_φ23, mulC23_φ23, mul_assoc]

/-! ### The group `Aut(M₂₂)` and its two generators -/

/-- The outer involution of class `2B`, of cycle type `2⁷1⁹`. -/
def sigma22 : Perm (Fin 23) :=
  c[0, 17] * c[2, 6] * c[3, 13] * c[4, 19] * c[5, 21] * c[8, 15] * c[9, 20]

/-- The element of order eleven, of cycle type `11²1¹`.  It is the Schreier generator
`EnumM22.schB 7` of `M₂₂`. -/
def zPerm : Perm (Fin 23) :=
  c[0, 7, 19, 8, 14, 12, 20, 10, 9, 15, 5] * c[1, 11, 3, 4, 18, 17, 21, 13, 2, 16, 6]

/-- **`Aut(M₂₂) = M₂₂ : 2`**, as the subgroup of `Perm (Fin 23)` generated by `sigma22` and
`zPerm`. -/
def AutM22 : Subgroup (Perm (Fin 23)) := Subgroup.closure {sigma22, zPerm}

lemma sigma22_mem : sigma22 ∈ AutM22 := Subgroup.subset_closure (Set.mem_insert _ _)

lemma zPerm_mem : zPerm ∈ AutM22 := Subgroup.subset_closure (Set.mem_insert_of_mem _ rfl)

lemma zPerm_inv_mem : zPerm⁻¹ ∈ AutM22 := inv_mem zPerm_mem

lemma sigma22_sq : sigma22 * sigma22 = 1 := by decide

lemma sigma22_inv : sigma22⁻¹ = sigma22 := by decide

/-- Every element of `Aut(M₂₂)` fixes the point `22`. -/
theorem fix22 {g : Perm (Fin 23)} (hg : g ∈ AutM22) : g (22 : Fin 23) = 22 := by
  induction hg using Subgroup.closure_induction with
  | mem u hu =>
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hu
    rcases hu with rfl | rfl
    · decide
    · decide
  | one => rfl
  | mul a b _ _ ha hb => rw [Equiv.Perm.mul_apply, hb, ha]
  | inv a _ ha =>
    have h : a⁻¹ (22 : Fin 23) = a⁻¹ (a (22 : Fin 23)) := by rw [ha]
    rw [h]
    simp

/-! ### The three elements of the triple -/

/-- The involution of the triple, as an element of `Aut(M₂₂)`. -/
def xEl : ↥AutM22 := ⟨sigma22, sigma22_mem⟩

/-- The order-eleven element of the triple. -/
def zEl : ↥AutM22 := ⟨zPerm, zPerm_mem⟩

/-- The remaining entry of the triple, forced by the product-one relation. -/
def yEl : ↥AutM22 := xEl⁻¹ * zEl⁻¹

/-- The underlying permutation of the third entry. -/
def y0 : Perm (Fin 23) := sigma22⁻¹ * zPerm⁻¹

lemma yEl_coe : ((yEl : ↥AutM22) : Perm (Fin 23)) = y0 := rfl

/-- The triple of conjugacy classes `(2B, 4C, 11A)` of `Aut(M₂₂)`. -/
def classTriple : Fin 3 → ConjClasses ↥AutM22 :=
  ![ConjClasses.mk xEl, ConjClasses.mk yEl, ConjClasses.mk zEl]

lemma classTriple_zero : classTriple 0 = ConjClasses.mk xEl := rfl
lemma classTriple_one : classTriple 1 = ConjClasses.mk yEl := rfl
lemma classTriple_two : classTriple 2 = ConjClasses.mk zEl := rfl

lemma xEl_sq : xEl * xEl = 1 := Subtype.ext sigma22_sq

lemma xEl_inv : xEl⁻¹ = xEl := inv_eq_of_mul_eq_one_right xEl_sq

/-! ### Codes of the generators -/

/-- Code of `sigma22`. -/
def cX : ℕ := 20185781845176427302910320575947
/-- Code of `zPerm`. -/
def cZ : ℕ := 20503568791607425089700758443787
/-- Code of `zPerm⁻¹`. -/
def cZi : ℕ := 20664770203669172973369563573999

lemma cX_eq : φ23 sigma22 = cX := by decide
lemma cZ_eq : φ23 zPerm = cZ := by decide
lemma cZi_eq : φ23 zPerm⁻¹ = cZi := by decide

lemma idCode23_eq : idCode23 = 20837326537038308910317109288851 := by decide

/-- Conjugation by `sigma22` in codes, using that it is its own inverse. -/
lemma mulC23_conj_x (q : Perm (Fin 23)) :
    mulC23 cX (mulC23 (φ23 q) cX) = φ23 (sigma22 * q * sigma22) := by
  rw [← cX_eq, mulC23_φ23, mulC23_φ23, mul_assoc]

/-! ### Conjugation-closed sets of codes

A tree of codes closed under conjugation by the two generators and their inverses contains the
whole `Aut(M₂₂)`-conjugacy class of each of its keys.  Only the one-sided soundness of
`Btree.mem` is used, so no search-tree invariant is needed. -/

/-- The conjugation-closure test for a tree of codes. -/
abbrev ConjClosed (T : Btree) : Prop :=
  T.all (fun k => T.mem (mulC23 cX (mulC23 k cX)) && T.mem (mulC23 cZ (mulC23 k cZi)) &&
    T.mem (mulC23 cZi (mulC23 k cZ))) = true

lemma conj_gen_key {T : Btree} (hcl : ConjClosed T) {q : Perm (Fin 23)}
    (hq : T.mem (φ23 q) = true) :
    T.mem (φ23 (sigma22 * q * sigma22⁻¹)) = true ∧
      T.mem (φ23 (sigma22⁻¹ * q * sigma22)) = true ∧
      T.mem (φ23 (zPerm * q * zPerm⁻¹)) = true ∧ T.mem (φ23 (zPerm⁻¹ * q * zPerm)) = true := by
  have h := Btree.all_toList hcl _ (Btree.mem_toList hq)
  simp only [Bool.and_eq_true] at h
  obtain ⟨⟨h1, h2⟩, h3⟩ := h
  rw [mulC23_conj_x] at h1
  rw [← cZ_eq, ← cZi_eq, mulC23_conj] at h2
  rw [← cZi_eq, ← cZ_eq, mulC23_conj'] at h3
  exact ⟨by rw [sigma22_inv]; exact h1, by rw [sigma22_inv]; exact h1, h2, h3⟩

/-- Closure under conjugation by the generators propagates to all of `Aut(M₂₂)`. -/
theorem conj_key {T : Btree} (hcl : ConjClosed T) {c : Perm (Fin 23)} (hc : c ∈ AutM22)
    {p : Perm (Fin 23)} (hp : T.mem (φ23 p) = true) : T.mem (φ23 (c * p * c⁻¹)) = true := by
  have hc' : c ∈ Subgroup.closure ({sigma22, zPerm} : Set (Perm (Fin 23))) := hc
  refine Subgroup.closure_induction_left
    (p := fun c _ => ∀ q : Perm (Fin 23), T.mem (φ23 q) = true →
      T.mem (φ23 (c * q * c⁻¹)) = true) ?_ ?_ ?_ hc' p hp
  · intro q hq; simpa using hq
  · intro g hg u _ ih q hq
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hg
    have hstep : g * u * q * (g * u)⁻¹ = g * (u * q * u⁻¹) * g⁻¹ := by group
    rw [hstep]
    rcases hg with rfl | rfl
    · exact (conj_gen_key hcl (ih q hq)).1
    · exact (conj_gen_key hcl (ih q hq)).2.2.1
  · intro g hg u _ ih q hq
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hg
    have hstep : g⁻¹ * u * q * (g⁻¹ * u)⁻¹ = g⁻¹ * (u * q * u⁻¹) * g := by group
    rw [hstep]
    rcases hg with rfl | rfl
    · exact (conj_gen_key hcl (ih q hq)).2.1
    · exact (conj_gen_key hcl (ih q hq)).2.2.2

/-- Every member of the conjugacy class of a key is again a key. -/
theorem key_of_conjClass {T : Btree} (hcl : ConjClosed T) {p : Perm (Fin 23)}
    (hp : T.mem (φ23 p) = true) {u w : ↥AutM22} (hu : (u : Perm (Fin 23)) = p)
    (hw : ConjClasses.mk w = ConjClasses.mk u) : T.mem (φ23 (w : Perm (Fin 23))) = true := by
  obtain ⟨c, hc⟩ := isConj_iff.mp (ConjClasses.mk_eq_mk_iff_isConj.mp hw)
  have hval : (c : Perm (Fin 23)) * (w : Perm (Fin 23)) * ((c : Perm (Fin 23)))⁻¹ = p := by
    rw [← hu, ← hc]; rfl
  have hw' : (w : Perm (Fin 23)) = ((c : Perm (Fin 23)))⁻¹ * p * (((c : Perm (Fin 23)))⁻¹)⁻¹ := by
    rw [← hval]; group
  rw [hw']
  exact conj_key hcl (inv_mem c.2) hp

/-! ### `Aut(M₂₂)` is centerless

The element `q0` below has exactly two fixed points, `0` and `22`.  A central element commutes
with it, hence permutes its fixed points; since everything in `Aut(M₂₂)` fixes `22`, a central
element must fix `0` as well.  Commuting with `zPerm` then propagates the fixed point along the
`zPerm`-orbit of `0`, and commuting with `sigma22` jumps to `17`, whose `zPerm`-orbit is the
remaining half of the `22` moving points. -/

/-- A word in the two generators with exactly two fixed points, `0` and `22`. -/
def q0 : Perm (Fin 23) :=
  zPerm⁻¹ * zPerm⁻¹ * zPerm⁻¹ * sigma22 * zPerm⁻¹ * sigma22 * zPerm * sigma22

lemma q0_mem : q0 ∈ AutM22 := by
  have hs := sigma22_mem
  have hz := zPerm_mem
  have hzi := zPerm_inv_mem
  exact (mul_mem (mul_mem (mul_mem (mul_mem (mul_mem (mul_mem (mul_mem hzi hzi) hzi) hs) hzi)
    hs) hz) hs)

lemma q0_fix : ∀ a : Fin 23, q0 a = a → a = 0 ∨ a = 22 := by decide

theorem center_eq_bot : Subgroup.center (↥AutM22) = ⊥ := by
  rw [eq_bot_iff]
  intro w hw
  rw [Subgroup.mem_bot]
  have hcomm : ∀ (g : Perm (Fin 23)) (hg : g ∈ AutM22),
      g * (w : Perm (Fin 23)) = (w : Perm (Fin 23)) * g := by
    intro g hg
    exact congrArg Subtype.val (Subgroup.mem_center_iff.mp hw ⟨g, hg⟩)
  have hstep : ∀ (g : Perm (Fin 23)) (_ : g ∈ AutM22) (a b : Fin 23), g a = b →
      (w : Perm (Fin 23)) a = a → (w : Perm (Fin 23)) b = b := by
    intro g hg a b hab ha
    have h := congrFun (congrArg (fun p : Perm (Fin 23) => (p : Fin 23 → Fin 23))
      (hcomm g hg)) a
    simp only [Equiv.Perm.coe_mul, Function.comp_apply] at h
    rw [ha, hab] at h
    exact h.symm
  have keyZ : ∀ a b : Fin 23, zPerm a = b → (w : Perm (Fin 23)) a = a →
      (w : Perm (Fin 23)) b = b := hstep zPerm zPerm_mem
  have f22 : (w : Perm (Fin 23)) (22 : Fin 23) = 22 := fix22 w.2
  have f0 : (w : Perm (Fin 23)) (0 : Fin 23) = 0 := by
    -- `q0` fixes `0`, so `w 0` is a fixed point of `q0`
    have hq := congrFun (congrArg (fun p : Perm (Fin 23) => (p : Fin 23 → Fin 23))
      (hcomm q0 q0_mem)) (0 : Fin 23)
    simp only [Equiv.Perm.coe_mul, Function.comp_apply] at hq
    rw [show q0 (0 : Fin 23) = 0 from by decide] at hq
    rcases q0_fix _ hq with h0 | h0
    · exact h0
    · exfalso
      have : (w : Perm (Fin 23)) (0 : Fin 23) = (w : Perm (Fin 23)) (22 : Fin 23) := by
        rw [h0, f22]
      exact absurd ((w : Perm (Fin 23)).injective this) (by decide)
  have f17 : (w : Perm (Fin 23)) (17 : Fin 23) = 17 :=
    hstep sigma22 sigma22_mem 0 17 (by decide) f0
  have f7 : (w : Perm (Fin 23)) (7 : Fin 23) = 7 := keyZ 0 7 (by decide) f0
  have f19 : (w : Perm (Fin 23)) (19 : Fin 23) = 19 := keyZ 7 19 (by decide) f7
  have f8 : (w : Perm (Fin 23)) (8 : Fin 23) = 8 := keyZ 19 8 (by decide) f19
  have f14 : (w : Perm (Fin 23)) (14 : Fin 23) = 14 := keyZ 8 14 (by decide) f8
  have f12 : (w : Perm (Fin 23)) (12 : Fin 23) = 12 := keyZ 14 12 (by decide) f14
  have f20 : (w : Perm (Fin 23)) (20 : Fin 23) = 20 := keyZ 12 20 (by decide) f12
  have f10 : (w : Perm (Fin 23)) (10 : Fin 23) = 10 := keyZ 20 10 (by decide) f20
  have f9 : (w : Perm (Fin 23)) (9 : Fin 23) = 9 := keyZ 10 9 (by decide) f10
  have f15 : (w : Perm (Fin 23)) (15 : Fin 23) = 15 := keyZ 9 15 (by decide) f9
  have f5 : (w : Perm (Fin 23)) (5 : Fin 23) = 5 := keyZ 15 5 (by decide) f15
  have f21 : (w : Perm (Fin 23)) (21 : Fin 23) = 21 := keyZ 17 21 (by decide) f17
  have f13 : (w : Perm (Fin 23)) (13 : Fin 23) = 13 := keyZ 21 13 (by decide) f21
  have f2 : (w : Perm (Fin 23)) (2 : Fin 23) = 2 := keyZ 13 2 (by decide) f13
  have f16 : (w : Perm (Fin 23)) (16 : Fin 23) = 16 := keyZ 2 16 (by decide) f2
  have f6 : (w : Perm (Fin 23)) (6 : Fin 23) = 6 := keyZ 16 6 (by decide) f16
  have f1 : (w : Perm (Fin 23)) (1 : Fin 23) = 1 := keyZ 6 1 (by decide) f6
  have f11 : (w : Perm (Fin 23)) (11 : Fin 23) = 11 := keyZ 1 11 (by decide) f1
  have f3 : (w : Perm (Fin 23)) (3 : Fin 23) = 3 := keyZ 11 3 (by decide) f11
  have f4 : (w : Perm (Fin 23)) (4 : Fin 23) = 4 := keyZ 3 4 (by decide) f3
  have f18 : (w : Perm (Fin 23)) (18 : Fin 23) = 18 := keyZ 4 18 (by decide) f4
  apply Subtype.ext
  refine Equiv.ext fun a => ?_
  show (w : Perm (Fin 23)) a = a
  fin_cases a
  exacts [f0, f1, f2, f3, f4, f5, f6, f7, f8, f9, f10, f11, f12, f13, f14, f15, f16, f17, f18,
    f19, f20, f21, f22]

/-! ### The pair generates -/

theorem gen_top : Subgroup.closure ({xEl, zEl} : Set ↥AutM22) = ⊤ := by
  have h : ({xEl, zEl} : Set ↥AutM22)
      = ((↑) : ↥AutM22 → Perm (Fin 23)) ⁻¹' ({sigma22, zPerm} : Set (Perm (Fin 23))) := by
    ext g
    simp only [Set.mem_preimage, Set.mem_insert_iff, Set.mem_singleton_iff]
    constructor
    · rintro (rfl | rfl)
      exacts [Or.inl rfl, Or.inr rfl]
    · rintro (hg | hg)
      exacts [Or.inl (Subtype.ext hg), Or.inr (Subtype.ext hg)]
  rw [h]
  exact Subgroup.closure_closure_coe_preimage

