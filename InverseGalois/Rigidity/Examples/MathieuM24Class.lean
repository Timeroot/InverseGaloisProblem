import Mathieu.EnumM11
import Mathieu.DefM24

/-!
# The class of eight-fold-fixed involutions of `M₂₄`, in base-`24` codes

This module carries the machine-checked half of the rigidity certificate for `M₂₄`
(`InverseGalois.Rigidity.Examples.MathieuM24`): the conjugacy class `2A` of `M₂₄`, listed as a
binary search tree of base-`24` integer codes, and the two filtered sublists that bound the
structure constants of the triple `(2A, 3B, 23A)` and of its mirror `(2A, 3B, 23B)`.

Permutations are handled in a base-`24` integer encoding (`enc24`, `dec24`, `φ24`), the exact
analogue of the base-`11` encoding of `Mathieu.EnumM11`, together with a multiplication `mulC24`
of two encoded permutations; it is `stepImg24` applied to the digit function of the left factor,
so `stepImg24_bridge` gives `mulC24 (φ24 g) (φ24 p) = φ24 (g * p)` immediately.

The class `2A` is the tree `TX`, of `11385` keys.  The kernel checks by `decide` that it is closed
under conjugation by the three generators and their inverses; since `Btree.mem` is one-sidedly
sound, that alone gives the containment *class ⊆ tree*, which is what an upper bound on a fibre
needs.  The second class of the triple needs no tree: both `3A` and `3B` consist of elements of
order `3`, but `3A = 3⁶1⁶` has fixed points while `3B = 3⁸` does not, so the pair of tests
`q³ = 1` and "`q` fixes no point" cuts out `3B` among the relevant codes.  Filtering `TX` by that
test applied to `w z⁻¹`, respectively to `w z`, leaves exactly `23` keys either way.

Nothing here uses `native_decide`.

## Main results

* `Rigidity.MathieuM24.TX_closed` — the tree is closed under conjugation by the generators.
* `Rigidity.MathieuM24.key_of_conjClass` — hence it contains the whole class of each of its keys.
* `Rigidity.MathieuM24.fibreList_length`, `Rigidity.MathieuM24.fibreList'_length` — both filtered
  lists have `23` entries.
-/

namespace Rigidity

namespace MathieuM24

open Equiv Mathieu Mathieu.EnumM11

set_option maxHeartbeats 4000000
set_option maxRecDepth 8000000

/-! ### The base-`24` encoding of permutations -/

/-- Encode an image vector `f : Fin 24 → Fin 24` as the base-`24` numeral
`∑ i, (f i) * 24 ^ i`. -/
def enc24 (f : Fin 24 → Fin 24) : ℕ := ∑ i : Fin 24, (f i).val * 24 ^ (i : ℕ)

/-- Decode a natural number back to an image vector (`i`-th base-`24` digit). -/
def dec24 (n : ℕ) : Fin 24 → Fin 24 :=
  fun i => ⟨(n / 24 ^ (i : ℕ)) % 24, Nat.mod_lt _ (by norm_num)⟩

/-- Apply a permutation `g` to an encoded permutation: decode, left-multiply, re-encode. -/
def applyGenF24 (g : Perm (Fin 24)) (n : ℕ) : ℕ := enc24 (fun i => g (dec24 n i))

/-- Encoding of the identity permutation. -/
def idCode24 : ℕ := enc24 id

/-- The encoding of a permutation by its image vector. -/
def φ24 (p : Perm (Fin 24)) : ℕ := enc24 (fun i => p i)

lemma enc24_eq (f : Fin 24 → Fin 24) : enc24 f = (finFunctionFinEquiv f).val := by
  rw [finFunctionFinEquiv_apply_val]; rfl

lemma dec24_enc24 (f : Fin 24 → Fin 24) : dec24 (enc24 f) = f := by
  funext j
  apply Fin.ext
  show (enc24 f / 24 ^ (j : ℕ)) % 24 = (f j).val
  have h := finFunctionFinEquiv_symm_apply_val (finFunctionFinEquiv f) j
  rw [Equiv.symm_apply_apply] at h
  rw [enc24_eq]; omega

lemma φ24_injective : Function.Injective φ24 := by
  intro p q h
  have h2 : dec24 (φ24 p) = dec24 (φ24 q) := by rw [h]
  rw [φ24, φ24, dec24_enc24, dec24_enc24] at h2
  exact Equiv.ext (fun i => congrFun h2 i)

lemma applyGenF24_φ24 (g p : Perm (Fin 24)) : applyGenF24 g (φ24 p) = φ24 (g * p) := by
  unfold applyGenF24 φ24
  rw [dec24_enc24]
  congr 1

lemma φ24_one : φ24 1 = idCode24 := by
  unfold φ24 idCode24
  congr 1

/-- Kernel-friendly digit-permutation apply (no `Finset.sum`): permutes the base-`24` digits of
`n` by the table `t`. -/
def stepImg24 (t : ℕ → ℕ) (n : ℕ) : ℕ :=
  t (n / 24^0 % 24) + 24*(t (n / 24^1 % 24) + 24*(t (n / 24^2 % 24) + 24*(t (n / 24^3 % 24) + 24*(
  t (n / 24^4 % 24) + 24*(t (n / 24^5 % 24) + 24*(t (n / 24^6 % 24) + 24*(t (n / 24^7 % 24) + 24*(
  t (n / 24^8 % 24) + 24*(t (n / 24^9 % 24) + 24*(t (n / 24^10 % 24) + 24*(
  t (n / 24^11 % 24) + 24*(t (n / 24^12 % 24) + 24*(t (n / 24^13 % 24) + 24*(
  t (n / 24^14 % 24) + 24*(t (n / 24^15 % 24) + 24*(t (n / 24^16 % 24) + 24*(
  t (n / 24^17 % 24) + 24*(t (n / 24^18 % 24) + 24*(t (n / 24^19 % 24) + 24*(
  t (n / 24^20 % 24) + 24*(t (n / 24^21 % 24) + 24*(t (n / 24^22 % 24) + 24*(
  t (n / 24^23 % 24))))))))))))))))))))))))

/-- Generic bridge: a permutation `g` whose value table on `0..23` is `t` acts on encoded codes
as `stepImg24 t`. -/
lemma stepImg24_bridge (g : Perm (Fin 24)) (t : ℕ → ℕ)
    (h : ∀ x : Fin 24, (g x).val = t x.val) (n : ℕ) : stepImg24 t n = applyGenF24 g n := by
  simp only [applyGenF24, enc24, stepImg24, Fin.sum_univ_succ, Fin.sum_univ_zero, h, dec24,
    Fin.val_succ, Fin.val_zero]
  ring

/-! ### Multiplication of encoded permutations -/

/-- The `j`-th base-`24` digit of a code. -/
def dg24 (a j : ℕ) : ℕ := a / 24 ^ j % 24

/-- Product of two encoded permutations: permute the digits of the right factor by the digit
table of the left factor. -/
def mulC24 (a b : ℕ) : ℕ := stepImg24 (dg24 a) b

lemma dg24_φ24 (g : Perm (Fin 24)) (i : Fin 24) : (g i).val = dg24 (φ24 g) i.val := by
  have h : dec24 (φ24 g) = fun i => g i := dec24_enc24 _
  exact (congrArg Fin.val (congrFun h i)).symm

lemma mulC24_φ24 (g p : Perm (Fin 24)) : mulC24 (φ24 g) (φ24 p) = φ24 (g * p) := by
  rw [mulC24, stepImg24_bridge g (dg24 (φ24 g)) (dg24_φ24 g), applyGenF24_φ24]

lemma mulC24_conj (g q : Perm (Fin 24)) :
    mulC24 (φ24 g) (mulC24 (φ24 q) (φ24 g⁻¹)) = φ24 (g * q * g⁻¹) := by
  rw [mulC24_φ24, mulC24_φ24, mul_assoc]

lemma mulC24_conj' (g q : Perm (Fin 24)) :
    mulC24 (φ24 g⁻¹) (mulC24 (φ24 q) (φ24 g)) = φ24 (g⁻¹ * q * g) := by
  rw [mulC24_φ24, mulC24_φ24, mul_assoc]

/-- `m24c` is an involution, so it is its own inverse. -/
lemma m24c_inv : m24c⁻¹ = m24c := by decide

/-! ### The involution of the triple -/

/-- `m24b` is a member of `M₂₄`. -/
theorem m24b_mem : m24b ∈ M24 :=
  Subgroup.subset_closure (by right; left; rfl)

/-- The involution of the triple, as an explicit word in the three standard generators. -/
def x0 : Perm (Fin 24) :=
  m24a⁻¹ * m24a⁻¹ * m24a⁻¹ * m24c * m24b⁻¹ * m24b⁻¹ * m24a⁻¹ * m24b * m24a⁻¹ * m24b⁻¹ * m24a *
    m24c * m24b⁻¹ * m24b⁻¹

lemma x0_mem : x0 ∈ M24 := by
  unfold x0
  exact mul_mem (mul_mem (mul_mem (mul_mem (mul_mem (mul_mem (mul_mem (mul_mem (mul_mem (mul_mem
    (mul_mem (mul_mem (mul_mem (inv_mem m24a_mem) (inv_mem m24a_mem)) (inv_mem m24a_mem))
    m24c_mem) (inv_mem m24b_mem)) (inv_mem m24b_mem)) (inv_mem m24a_mem)) m24b_mem) (inv_mem
    m24a_mem)) (inv_mem m24b_mem)) m24a_mem) m24c_mem) (inv_mem m24b_mem)) (inv_mem m24b_mem)

lemma x0_sq : x0 * x0 = 1 := by decide

/-! ### Codes of the generators -/

/-- Code of `m24a`. -/
def cA : ℕ := 1280373914664090921336687962304241
/-- Code of `m24a⁻¹`. -/
def cAi : ℕ := 1328798349194962499224671672180310
/-- Code of `m24b`. -/
def cB : ℕ := 1296365490171747550294570278411288
/-- Code of `m24b⁻¹`. -/
def cBi : ℕ := 1305554073742075466722237222980120
/-- Code of `m24c`, which is an involution and so equals the code of `m24c⁻¹`. -/
def cC : ℕ := 3506534153452629805955696743655

lemma cA_eq : φ24 m24a = cA := by decide
lemma cAi_eq : φ24 m24a⁻¹ = cAi := by decide
lemma cB_eq : φ24 m24b = cB := by decide
lemma cBi_eq : φ24 m24b⁻¹ = cBi := by decide
lemma cC_eq : φ24 m24c = cC := by decide
lemma cCi_eq : φ24 m24c⁻¹ = cC := by decide

lemma x0_code : φ24 x0 = 775408998679239258782271031733756 := by decide

/-- Conjugation by `m24c` in codes, using that `m24c` is its own inverse. -/
lemma mulC24_conj_c (q : Perm (Fin 24)) :
    mulC24 cC (mulC24 (φ24 q) cC) = φ24 (m24c * q * m24c) := by
  rw [← cC_eq, mulC24_φ24, mulC24_φ24, mul_assoc]

/-! ### Conjugation-closed sets of codes

A tree of codes closed under conjugation by the three generators and their inverses contains the
whole `M₂₄`-conjugacy class of each of its keys.  Only the one-sided soundness of `Btree.mem` is
used, so no search-tree invariant is needed. -/

/-- The conjugation-closure test for a tree of codes. -/
abbrev ConjClosed (T : Btree) : Prop :=
  T.all (fun k => T.mem (mulC24 cA (mulC24 k cAi)) && T.mem (mulC24 cAi (mulC24 k cA)) &&
    T.mem (mulC24 cB (mulC24 k cBi)) && T.mem (mulC24 cBi (mulC24 k cB)) &&
    T.mem (mulC24 cC (mulC24 k cC))) = true

lemma conj_gen_key {T : Btree} (hcl : ConjClosed T) {q : Perm (Fin 24)}
    (hq : T.mem (φ24 q) = true) :
    T.mem (φ24 (m24a * q * m24a⁻¹)) = true ∧ T.mem (φ24 (m24a⁻¹ * q * m24a)) = true ∧
      T.mem (φ24 (m24b * q * m24b⁻¹)) = true ∧ T.mem (φ24 (m24b⁻¹ * q * m24b)) = true ∧
      T.mem (φ24 (m24c * q * m24c⁻¹)) = true ∧ T.mem (φ24 (m24c⁻¹ * q * m24c)) = true := by
  have h := Btree.all_toList hcl _ (Btree.mem_toList hq)
  simp only [Bool.and_eq_true] at h
  obtain ⟨⟨⟨⟨h1, h2⟩, h3⟩, h4⟩, h5⟩ := h
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩
  · rw [← cA_eq, ← cAi_eq, mulC24_conj] at h1; exact h1
  · rw [← cAi_eq, ← cA_eq, mulC24_conj'] at h2; exact h2
  · rw [← cB_eq, ← cBi_eq, mulC24_conj] at h3; exact h3
  · rw [← cBi_eq, ← cB_eq, mulC24_conj'] at h4; exact h4
  · rw [mulC24_conj_c] at h5; rw [m24c_inv]; exact h5
  · rw [mulC24_conj_c] at h5; rw [m24c_inv]; exact h5

/-- Closure under conjugation by the generators propagates to all of `M₂₄`. -/
theorem conj_key {T : Btree} (hcl : ConjClosed T) {c : Perm (Fin 24)} (hc : c ∈ M24)
    {p : Perm (Fin 24)} (hp : T.mem (φ24 p) = true) : T.mem (φ24 (c * p * c⁻¹)) = true := by
  have hc' : c ∈ Subgroup.closure ({m24a, m24b, m24c} : Set (Perm (Fin 24))) := hc
  refine Subgroup.closure_induction_left
    (p := fun c _ => ∀ q : Perm (Fin 24), T.mem (φ24 q) = true →
      T.mem (φ24 (c * q * c⁻¹)) = true) ?_ ?_ ?_ hc' p hp
  · intro q hq; simpa using hq
  · intro g hg y _ ih q hq
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hg
    have hstep : g * y * q * (g * y)⁻¹ = g * (y * q * y⁻¹) * g⁻¹ := by group
    rw [hstep]
    rcases hg with rfl | rfl | rfl
    · exact (conj_gen_key hcl (ih q hq)).1
    · exact (conj_gen_key hcl (ih q hq)).2.2.1
    · exact (conj_gen_key hcl (ih q hq)).2.2.2.2.1
  · intro g hg y _ ih q hq
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hg
    have hstep : g⁻¹ * y * q * (g⁻¹ * y)⁻¹ = g⁻¹ * (y * q * y⁻¹) * g := by group
    rw [hstep]
    rcases hg with rfl | rfl | rfl
    · exact (conj_gen_key hcl (ih q hq)).2.1
    · exact (conj_gen_key hcl (ih q hq)).2.2.2.1
    · exact (conj_gen_key hcl (ih q hq)).2.2.2.2.2

