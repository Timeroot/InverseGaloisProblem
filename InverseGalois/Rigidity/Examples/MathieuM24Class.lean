lemma TX_closed : ConjClosed TX := by decide +kernel

lemma TX_mem_x0 : TX.mem (φ24 x0) = true := by rw [x0_code]; decide +kernel

/-- Every member of the conjugacy class of a key is again a key. -/
theorem key_of_conjClass {T : Btree} (hcl : ConjClosed T) {p : Perm (Fin 24)}
    (hp : T.mem (φ24 p) = true) {u w : ↥M24} (hu : (u : Perm (Fin 24)) = p)
    (hw : ConjClasses.mk w = ConjClasses.mk u) : T.mem (φ24 (w : Perm (Fin 24))) = true := by
  obtain ⟨c, hc⟩ := isConj_iff.mp (ConjClasses.mk_eq_mk_iff_isConj.mp hw)
  have hval : (c : Perm (Fin 24)) * (w : Perm (Fin 24)) * ((c : Perm (Fin 24)))⁻¹ = p := by
    rw [← hu, ← hc]; rfl
  have hw' : (w : Perm (Fin 24)) = ((c : Perm (Fin 24)))⁻¹ * p * (((c : Perm (Fin 24)))⁻¹)⁻¹ := by
    rw [← hval]; group
  rw [hw']
  exact conj_key hcl (inv_mem c.2) hp

/-! ### Order three without a fixed point, in codes

`3A` and `3B` are the two classes of elements of order `3` in `M₂₄`.  They are told apart by
their cycle types, `3⁶1⁶` against `3⁸`: an element of `3A` fixes a point and an element of `3B`
does not.  Both tests are conjugation-invariant. -/

/-- The fixed-point test on a code: some base-`24` digit equals its index. -/
def hasFix (n : ℕ) : Bool := (List.range 24).any (fun i => dg24 n i == i)

/-- A permutation moving every point has no fixed digit in its code. -/
lemma hasFix_eq_false_of_noFix {p : Perm (Fin 24)} (h : ∀ i : Fin 24, p i ≠ i) :
    hasFix (φ24 p) = false := by
  by_contra hcon
  rw [Bool.not_eq_false] at hcon
  unfold hasFix at hcon
  rw [List.any_eq_true] at hcon
  obtain ⟨j, hj, hjj⟩ := hcon
  have hjlt : j < 24 := List.mem_range.mp hj
  rw [beq_iff_eq] at hjj
  have hd : (p ⟨j, hjlt⟩).val = dg24 (φ24 p) j := dg24_φ24 p ⟨j, hjlt⟩
  exact h ⟨j, hjlt⟩ (Fin.ext (hd.trans hjj))

/-- The membership test for `3B` on a code: the cube is the identity and there is no fixed
point. -/
def testY (q : ℕ) : Bool := (mulC24 (mulC24 q q) q == idCode24) && !hasFix q

/-- The keys of the involution tree whose product with `z⁻¹` passes the `3B` test: an
over-approximation of the structure-constant fibre. -/
noncomputable def fibreList : List ℕ := TX.toList.filter (fun k => testY (mulC24 k cAi))

lemma fibreList_length : fibreList.length = 23 := by decide +kernel

/-- The keys of the involution tree whose product with `z` passes the `3B` test: an
over-approximation of the mirror structure-constant fibre. -/
noncomputable def fibreList' : List ℕ := TX.toList.filter (fun k => testY (mulC24 k cA))

lemma fibreList'_length : fibreList'.length = 23 := by decide +kernel

end MathieuM24

end Rigidity
