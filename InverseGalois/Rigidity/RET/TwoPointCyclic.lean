import Mathlib
import InverseGalois.Rigidity.RET.CyclicCycles
import InverseGalois.Rigidity.RET.KummerPullback

/-!
# The sphere with two punctures has cyclic fundamental group

A cover of the line unramified over every point of the affine line except the origin need not
contain a root of the coordinate; but it can always be enlarged until it does, by adjoining one.
The enlarged cover is again unramified away from the origin — the Kummer line `uᵐ = T` is — and its
deck group is killed by `m` as soon as `m` is the order of the original deck group, because the
enlarged cover is generated by the original one and the Kummer line, on each of which the `m`-th
power of a symmetry is the identity.  So the enlarged cover is cyclic, and the original cover, a
quotient of it, is cyclic too.

Any two points of the sphere are carried to the origin and the point at infinity by a change of
coordinate, so a cover branched over any two points is cyclic; and a cyclic cover carries a system
of distinguished branch cycles.

## Main results

* `Rigidity.RET.LineCover.isCyclic_deck_of_unramifiedOutside_zero` — a cover of the line unramified
  away from the origin has cyclic deck group.
* `Rigidity.RET.LineCover.isCyclic_deck_of_unramifiedOutside_pair` — a cover of the line unramified
  away from two points of the affine line and at the point at infinity has cyclic deck group.
* `Rigidity.RET.LineCover.exists_branchCycleGenSystem_pair` — such a cover carries the two-term
  system of distinguished branch cycles.
* `Rigidity.RET.LineCover.exists_multiKummer_model_pair` — such a cover is the Kummer cover
  `uⁿ = (T - t₀)^{e₀} (T - t₁)^{e₁}`.
-/

open Polynomial

noncomputable section


namespace Rigidity.RET

open GeomAKLB

attribute [local instance] GeomAKLB.instMSA GeomAKLB.instIntegral GeomAKLB.instIsFrac
  GeomAKLB.instIGG GeomAKLB.instFinite GeomAKLB.instDedekindB GeomAKLB.instTorsionFree
  GeomAKLB.instFaithful

namespace LineCover

attribute [local instance] sub_isGalois

/-- A symmetry raised to the number of symmetries of a subcover is the identity on that
subcover. -/
private theorem pow_natCard_fix (N : LineCover) (F : IntermediateField (RatFunc k) N.M)
    [Normal (RatFunc k) F] {m : ℕ} (hcard : Nat.card (N.sub F).deck = m) (τ : N.deck)
    {x : N.M} (hx : x ∈ F) : (τ ^ m) x = x := by
  have h1 : N.subHom F (τ ^ m) = 1 := by
    rw [map_pow, ← hcard]
    exact pow_card_eq_one'
  have h2 := N.subHom_commutes F (τ ^ m) ⟨x, hx⟩
  rw [h1] at h2
  exact h2.symm

/-- **A cover of the line unramified away from the origin has cyclic deck group.**  Adjoining a
root of the coordinate of order the degree of the cover produces a cover which is still unramified
away from the origin and which contains the Kummer line of that root; such a cover is cyclic, and
the original cover is one of its quotients. -/
theorem isCyclic_deck_of_unramifiedOutside_zero (L : LineCover)
    (hS : L.IsUnramifiedOutside ({0} : Set k)) : IsCyclic L.deck := by
  classical
  haveI : Nonempty L.deck := ⟨1⟩
  set m : ℕ := Nat.card L.deck with hm
  haveI : NeZero m := ⟨by rw [hm]; exact Nat.card_pos.ne'⟩
  -- a separable polynomial cutting out the cover
  obtain ⟨p, hpsep, hpsf⟩ := IsGalois.is_separable_splitting_field (RatFunc k) L.M
  haveI := hpsf
  have hpne : p ≠ 0 := hpsep.ne_zero
  have hgne : ((X : (RatFunc k)[X]) ^ m - C (RatFunc.X : RatFunc k)) ≠ 0 :=
    X_pow_sub_C_ne_zero (NeZero.pos m) _
  -- the cover with a root of the coordinate adjoined
  let M : Type := (p * ((X : (RatFunc k)[X]) ^ m - C (RatFunc.X : RatFunc k))).SplittingField
  haveI : FiniteDimensional (RatFunc k) M :=
    IsSplittingField.finiteDimensional M (p * ((X : (RatFunc k)[X]) ^ m - C (RatFunc.X : RatFunc k)))
  haveI : Normal (RatFunc k) M :=
    Normal.of_isSplittingField (p * ((X : (RatFunc k)[X]) ^ m - C (RatFunc.X : RatFunc k)))
  haveI : PerfectField (RatFunc k) := PerfectField.ofCharZero
  haveI : Algebra.IsAlgebraic (RatFunc k) M := Algebra.IsAlgebraic.of_finite _ _
  haveI : Algebra.IsSeparable (RatFunc k) M := Algebra.IsAlgebraic.isSeparable_of_perfectField
  haveI : IsGalois (RatFunc k) M := ⟨⟩
  have hinj : Function.Injective (algebraMap (RatFunc k) M) := (algebraMap (RatFunc k) M).injective
  have hqsplits : ((p * ((X : (RatFunc k)[X]) ^ m - C (RatFunc.X : RatFunc k))).map
      (algebraMap (RatFunc k) M)).Splits :=
    IsSplittingField.splits M (p * ((X : (RatFunc k)[X]) ^ m - C (RatFunc.X : RatFunc k)))
  have hqmapne : (p * ((X : (RatFunc k)[X]) ^ m - C (RatFunc.X : RatFunc k))).map
      (algebraMap (RatFunc k) M) ≠ 0 :=
    (Polynomial.map_ne_zero_iff hinj).mpr (mul_ne_zero hpne hgne)
  have hpsplits : (p.map (algebraMap (RatFunc k) M)).Splits :=
    Polynomial.Splits.of_dvd hqsplits hqmapne (Polynomial.map_dvd _ ⟨_, rfl⟩)
  have hgsplits : (((X : (RatFunc k)[X]) ^ m - C (RatFunc.X : RatFunc k)).map
      (algebraMap (RatFunc k) M)).Splits :=
    Polynomial.Splits.of_dvd hqsplits hqmapne
      (Polynomial.map_dvd _ ⟨p, mul_comm _ _⟩)
  have hpm : p.map (algebraMap (RatFunc k) M) ≠ 0 := (Polynomial.map_ne_zero_iff hinj).mpr hpne
  have hgm : ((X : (RatFunc k)[X]) ^ m - C (RatFunc.X : RatFunc k)).map
      (algebraMap (RatFunc k) M) ≠ 0 := (Polynomial.map_ne_zero_iff hinj).mpr hgne
  -- the root of the coordinate
  obtain ⟨u, hu0⟩ := hgsplits.exists_eval_eq_zero (by
    rw [Polynomial.map_sub, Polynomial.map_pow, map_X, map_C,
      degree_X_pow_sub_C (NeZero.pos m)]
    exact_mod_cast (NeZero.pos m).ne')
  have hpow : u ^ m = algebraMap (RatFunc k) M (RatFunc.X : RatFunc k) := by
    rw [Polynomial.map_sub, Polynomial.map_pow, map_X, map_C, eval_sub, eval_pow, eval_X, eval_C,
      sub_eq_zero] at hu0
    exact hu0
  have hu : Transcendental k u := transcendental_of_pow hpow
  -- the two lines inside the enlarged cover: the original cover, and the Kummer line
  set K : IntermediateField (RatFunc k) M := kummerBase hu hpow with hKdef
  set E : IntermediateField (RatFunc k) M :=
    IntermediateField.adjoin (RatFunc k) (p.rootSet M) with hEdef
  haveI : Normal (RatFunc k) K := normal_kummerBase hu hpow hgsplits
  haveI hEsf : IsSplittingField (RatFunc k) (E : Type) p :=
    IntermediateField.adjoin_rootSet_isSplittingField hpsplits
  haveI : Normal (RatFunc k) E := Normal.of_isSplittingField p
  let e : L.M ≃ₐ[RatFunc k] (E : Type) :=
    (IsSplittingField.algEquiv L.M p).trans (IsSplittingField.algEquiv (E : Type) p).symm
  let N : LineCover := { M := M }
  -- the two lines generate the enlarged cover
  have hsup : E ⊔ K = ⊤ := by
    refine top_le_iff.mp (SetLike.le_def.mpr fun x _ => ?_)
    have hx : x ∈ Algebra.adjoin (RatFunc k)
        ((p * ((X : (RatFunc k)[X]) ^ m - C (RatFunc.X : RatFunc k))).rootSet M) := by
      rw [IsSplittingField.adjoin_rootSet M
        (p * ((X : (RatFunc k)[X]) ^ m - C (RatFunc.X : RatFunc k)))]
      trivial
    rw [← IntermediateField.mem_toSubalgebra]
    refine Algebra.adjoin_le (S := (E ⊔ K).toSubalgebra) ?_ hx
    intro y hy
    simp only [SetLike.mem_coe, IntermediateField.mem_toSubalgebra]
    rw [mem_rootSet'] at hy
    obtain ⟨-, hy0⟩ := hy
    rw [map_mul, mul_eq_zero] at hy0
    rcases hy0 with h | h
    · exact SetLike.le_def.mp le_sup_left
        (IntermediateField.subset_adjoin _ _ (mem_rootSet'.mpr ⟨hpm, h⟩))
    · exact SetLike.le_def.mp le_sup_right
        (rootSet_subset_kummerBase hu hpow (mem_rootSet'.mpr ⟨hgm, h⟩))
  -- both lines have exactly `m` symmetries
  haveI : Algebra.IsAlgebraic (RatFunc k) (K : Type) := Algebra.IsAlgebraic.of_finite _ _
  haveI : Algebra.IsSeparable (RatFunc k) (K : Type) :=
    Algebra.IsAlgebraic.isSeparable_of_perfectField
  haveI : IsGalois (RatFunc k) (K : Type) := ⟨⟩
  have hcardK : Nat.card (N.sub K).deck = m := by
    show Nat.card ((K : Type) ≃ₐ[RatFunc k] (K : Type)) = m
    rw [show Nat.card ((K : Type) ≃ₐ[RatFunc k] (K : Type))
      = Module.finrank (RatFunc k) (K : Type) by
        simpa using IsGalois.card_aut_eq_finrank (RatFunc k) (K : Type)]
    exact finrank_kummerBase hu hpow hgsplits
  have hcardE : Nat.card (N.sub E).deck = m := by
    show Nat.card ((E : Type) ≃ₐ[RatFunc k] (E : Type)) = m
    have hEcard : Nat.card ((E : Type) ≃ₐ[RatFunc k] (E : Type)) = Nat.card L.deck :=
      (Nat.card_congr (AlgEquiv.autCongr e).toEquiv).symm
    exact hEcard.trans hm.symm
  -- the enlarged deck group is killed by `m`
  have hexp : ∀ τ : N.deck, τ ^ m = 1 := by
    intro τ
    refine eq_one_of_iSup (fun b : Bool => cond b E K) ?_ ?_
    · rw [iSup_bool_eq]
      exact hsup
    · intro b x hx
      cases b
      · exact pow_natCard_fix N K hcardK τ hx
      · exact pow_natCard_fix N E hcardE τ hx
  -- the enlarged cover is still unramified away from the origin
  have hEun : (N.sub E).IsUnramifiedOutside ({0} : Set k) :=
    IsUnramifiedOutside.transport (L := L) (L' := N.sub E) e hS
  have hKun : (N.sub K).IsUnramifiedOutside ({0} : Set k) := by
    obtain ⟨ζ₀, hζ₀⟩ := exists_primitiveRoot_k m
    haveI hsfK : IsSplittingField (RatFunc k) (N.sub K).M
        ((X : (RatFunc k)[X]) ^ m -
          C (algebraMap (Polynomial k) (RatFunc k) (X : Polynomial k))) := by
      rw [RatFunc.algebraMap_X]
      exact isSplittingField_kummerBase hu hpow hgsplits
    have H : Irreducible ((X : (RatFunc k)[X]) ^ m -
        C (algebraMap (Polynomial k) (RatFunc k) (X : Polynomial k))) := by
      rw [RatFunc.algebraMap_X]
      exact irreducible_X_pow_sub_C_X k (NeZero.ne m)
    rintro t ht σ ⟨Q, hQmax, hQover, hσ⟩
    haveI := hQmax
    haveI := hQover
    have ht0 : t ≠ 0 := fun h => ht (by simp [h])
    exact kummer_inertia_eq_one (Ω := (N.sub K).M) (a := (X : Polynomial k)) H hζ₀ Q
      (notMem_of_eval_ne_zero (by simpa using ht0) Q) hσ
  have hMun : N.IsUnramifiedOutside ({0} : Set k) := by
    haveI hnorm : ∀ b : Bool, Normal (RatFunc k)
        ((cond b E K : IntermediateField (RatFunc k) M) : Type) := by
      intro b
      cases b
      · show Normal (RatFunc k) (K : Type)
        infer_instance
      · show Normal (RatFunc k) (E : Type)
        infer_instance
    refine IsUnramifiedOutside.of_iSup (fun b : Bool => cond b E K) ?_ ?_
    · rw [iSup_bool_eq]
      exact hsup
    · intro b
      cases b
      · exact hKun
      · exact hEun
  -- so the enlarged cover is cyclic, and the original cover is a quotient of it
  haveI : IsCyclic N.deck := isCyclic_deck_of_kummer_param N hpow hgsplits hexp hMun
  refine isCyclic_of_surjective ((AlgEquiv.autCongr e).symm.toMonoidHom.comp (N.subHom E)) ?_
  exact (AlgEquiv.autCongr e).symm.surjective.comp (N.subHom_surjective E)

/-! ## Two branch points -/

/-- Cyclicity of the deck group does not depend on the coordinate the cover is read in. -/
private theorem isCyclic_of_twist {L : LineCover} {φ : RatFunc k ≃+* RatFunc k}
    (h : IsCyclic (L.twist φ).deck) : IsCyclic L.deck := by
  haveI : IsCyclic (Twist φ L.M ≃ₐ[RatFunc k] Twist φ L.M) := h
  exact isCyclic_of_surjective (Twist.autEquiv (φ := φ) (M := L.M)).symm.toMonoidHom
    (Twist.autEquiv (φ := φ) (M := L.M)).symm.surjective

/-- **A cover of the line unramified away from two points of the affine line and unramified at the
point at infinity has cyclic deck group.**  Three coordinate changes — a translation carrying the
first point to the origin, the inversion carrying the origin to the point at infinity, and a
second translation carrying the image of the second point to the origin — leave a cover branched
over the origin and the point at infinity only, and such a cover is cyclic. -/
theorem isCyclic_deck_of_unramifiedOutside_pair (L : LineCover) (t₀ t₁ : k)
    (h₁ : L.IsUnramifiedOutside ({t₀, t₁} : Set k)) (h₂ : L.IsUnramifiedAtInfinity) :
    IsCyclic L.deck := by
  rcases eq_or_ne t₀ t₁ with rfl | hne
  · rw [Set.pair_eq_singleton] at h₁
    haveI := subsingleton_deck_of_unramifiedOutside_singleton L t₀ h₁ h₂
    infer_instance
  have ha0 : t₁ - t₀ ≠ 0 := sub_ne_zero.mpr (Ne.symm hne)
  -- move the first point to the origin
  have h₁' : (L.twist (translateSubst (-t₀))).IsUnramifiedOutside ({0, t₁ - t₀} : Set k) := by
    have h := IsUnramifiedOutside.twist_translate (-t₀) h₁
    have hset : ((· - (-t₀)) ⁻¹' ({t₀, t₁} : Set k)) = ({0, t₁ - t₀} : Set k) := by
      ext t
      simp only [Set.mem_preimage, Set.mem_insert_iff, Set.mem_singleton_iff, sub_neg_eq_add]
      constructor
      · rintro (hh | hh)
        · exact Or.inl (by simpa using congrArg (· - t₀) hh)
        · exact Or.inr (by simpa using congrArg (· - t₀) hh)
      · rintro (rfl | rfl) <;> simp
    rwa [hset] at h
  have h₂' : (L.twist (translateSubst (-t₀))).IsUnramifiedAtInfinity :=
    IsUnramifiedAtInfinity.twist_translate (-t₀) h₂
  -- send the origin to the point at infinity
  have hinv : ((L.twist (translateSubst (-t₀))).twist invSubst.toRingEquiv).IsUnramifiedOutside
      ({(t₁ - t₀)⁻¹} : Set k) := by
    have h := isUnramifiedOutside_twist_inv (L.twist (translateSubst (-t₀))) h₁' h₂'
    have hset : {t : k | t ≠ 0 ∧ t⁻¹ ∈ ({0, t₁ - t₀} : Set k)} = ({(t₁ - t₀)⁻¹} : Set k) := by
      ext t
      simp only [Set.mem_setOf_eq, Set.mem_insert_iff, Set.mem_singleton_iff]
      constructor
      · rintro ⟨ht0, hh | hh⟩
        · exact absurd (inv_eq_zero.mp hh) ht0
        · rw [← hh, inv_inv]
      · rintro rfl
        exact ⟨inv_ne_zero ha0, Or.inr (inv_inv _)⟩
    rwa [hset] at h
  -- move the remaining point of the affine line to the origin
  have hfin : (((L.twist (translateSubst (-t₀))).twist invSubst.toRingEquiv).twist
      (translateSubst (-(t₁ - t₀)⁻¹))).IsUnramifiedOutside ({0} : Set k) :=
    IsUnramifiedOutside.twist_translate_singleton _ hinv
  exact isCyclic_of_twist (isCyclic_of_twist (isCyclic_of_twist
    (isCyclic_deck_of_unramifiedOutside_zero _ hfin)))

/-- The two-point form of `isCyclic_deck_of_unramifiedOutside_pair`, phrased for a branch locus
presented as the range of a two-term tuple. -/
theorem isCyclic_deck_of_unramifiedOutside_range_two (L : LineCover) (t : Fin 2 → k)
    (h₁ : L.IsUnramifiedOutside (Set.range t)) (h₂ : L.IsUnramifiedAtInfinity) :
    IsCyclic L.deck := by
  have hrange : Set.range t = {t 0, t 1} := by
    ext x
    constructor
    · rintro ⟨i, rfl⟩
      fin_cases i
      · exact Or.inl rfl
      · exact Or.inr rfl
    · rintro (rfl | rfl)
      · exact ⟨0, rfl⟩
      · exact ⟨1, rfl⟩
  refine isCyclic_deck_of_unramifiedOutside_pair L (t 0) (t 1) ?_ h₂
  rwa [hrange] at h₁

/-- **A cover of the line unramified away from two points of the affine line and unramified at the
point at infinity carries the two-term system of distinguished branch cycles.**

This is the completeness half of the correspondence between covers and generating product-one
tuples, in rank two: the sphere group of the twice-punctured sphere is cyclic, so the deck group,
generated by the two branch cycles, is cyclic too, and a cyclic cover has branch cycles. -/
theorem exists_branchCycleGenSystem_pair (L : LineCover) (t : Fin 2 → k)
    (ht : Function.Injective t) (h₁ : L.IsUnramifiedOutside (Set.range t))
    (h₂ : L.IsUnramifiedAtInfinity) : ∃ g : Fin 2 → L.deck, L.IsBranchCycleGenSystem t g := by
  haveI := isCyclic_deck_of_unramifiedOutside_range_two L t h₁ h₂
  exact exists_branchCycleGenSystem_of_isCyclic L t ht h₁ h₂

/-- **A cover of the line unramified away from two points of the affine line and at the point at
infinity is a Kummer cover branched over those two points.**

The cover is the splitting field of `uⁿ = (T - t₀)^{e₀} (T - t₁)^{e₁}` for exponents below its
degree `n`, and that binomial is irreducible, so the model is a faithful one. -/
theorem exists_multiKummer_model_pair (L : LineCover) (t : Fin 2 → k)
    (ht : Function.Injective t) (h₁ : L.IsUnramifiedOutside (Set.range t))
    (h₂ : L.IsUnramifiedAtInfinity) :
    ∃ e : Fin 2 → ℕ, (∀ i, e i < Module.finrank (RatFunc k) L.M) ∧
      Irreducible (X ^ Module.finrank (RatFunc k) L.M -
        C (algebraMap (Polynomial k) (RatFunc k) (multiA t e))) ∧
      IsSplittingField (RatFunc k) L.M
        (X ^ Module.finrank (RatFunc k) L.M -
          C (algebraMap (Polynomial k) (RatFunc k) (multiA t e))) := by
  haveI := isCyclic_deck_of_unramifiedOutside_range_two L t h₁ h₂
  exact exists_multiKummer_model_on L t ht h₁

end LineCover

end Rigidity.RET
