import Mathlib
import InverseGalois.Rigidity.RET.Analytic.DeckClear

/-!
# Branch cycles of a Galois extension of the field of rational functions

Every finite Galois extension of `ℂ(T)` is generated by a single element, and after rescaling
that element by a rational function its minimal polynomial has coefficients in `ℂ[T]`.  The
extension is therefore presented by a family of equations depending polynomially on a parameter,
and the analytic theory of the root cover of such a family applies to it: outside a finite set of
parameters the roots form a covering space of the plane, the Galois group acts on that covering
space by deck transformations, and the loops around the exceptional parameters produce a tuple of
group elements whose product is the identity and which generate the group.

## Main results

* `Rigidity.RET.Analytic.exists_branchCycles_of_isGalois` — a finite Galois extension of `ℂ(T)`
  has a finite exceptional set together with a tuple of automorphisms, indexed by that set with
  one extra index, whose product is the identity and which generate the Galois group.
* `Rigidity.RET.Analytic.exists_branchCycles_eq_degenLocus_of_isGalois` — the same, with the
  exceptional set pinned to the degeneration locus of the presenting family.
-/

open Polynomial

noncomputable section

namespace Rigidity.RET.Analytic

/-- **A finite Galois extension of the field of rational functions has branch cycles, over the
parameters at which the equation presenting it degenerates.**

The extension is presented by a monic family of equations depending polynomially on the parameter,
and the exceptional set is exactly the set of parameters at which that family acquires a repeated
root; over it sits a tuple of automorphisms with one extra index — the loop around infinity —
whose product is the identity and which generate the Galois group. -/
theorem exists_branchCycles_eq_degenLocus_of_isGalois (M : Type) [Field M] [Algebra (RatFunc ℂ) M]
    [FiniteDimensional (RatFunc ℂ) M] [IsGalois (RatFunc ℂ) M] :
    ∃ (P : Polynomial (Polynomial ℂ)) (S : Finset ℂ), P.Monic ∧ 0 < P.natDegree ∧
      (S : Set ℂ) = degenLocus P ∧
      ∃ g : Fin (S.card + 1) → (M ≃ₐ[RatFunc ℂ] M),
        (List.ofFn g).prod = 1 ∧ Subgroup.closure (Set.range g) = ⊤ := by
  classical
  letI : Algebra (Polynomial ℂ) M :=
    ((algebraMap (RatFunc ℂ) M).comp (algebraMap (Polynomial ℂ) (RatFunc ℂ))).toAlgebra
  haveI : IsScalarTower (Polynomial ℂ) (RatFunc ℂ) M :=
    IsScalarTower.of_algebraMap_eq fun _ => rfl
  set φ := algebraMap (Polynomial ℂ) (RatFunc ℂ) with hφdef
  -- a primitive element, and the fact that every element is a polynomial in it
  set pb := Field.powerBasisOfFiniteOfSeparable (RatFunc ℂ) M with hpbdef
  -- rescale the primitive element so that it becomes integral over `ℂ[T]`
  have halg : IsAlgebraic (Polynomial ℂ) pb.gen :=
    (IsFractionRing.isAlgebraic_iff (Polynomial ℂ) (RatFunc ℂ) M).mpr
      ((Algebra.IsAlgebraic.of_finite (RatFunc ℂ) M).isAlgebraic pb.gen)
  obtain ⟨c, hc0, hcint⟩ := halg.exists_integral_multiple
  set β : M := c • pb.gen with hβdef
  have hu : φ c ≠ 0 := fun h =>
    hc0 (IsFractionRing.injective (Polynomial ℂ) (RatFunc ℂ) (by rw [map_zero, h]))
  have hβgen : algebraMap (RatFunc ℂ) M (φ c) * pb.gen = β := by
    rw [← Algebra.smul_def, hφdef, algebraMap_smul, hβdef]
  have hgenβ : ∀ y : M, ∃ q : Polynomial (RatFunc ℂ), aeval β q = y := by
    intro y
    obtain ⟨q, hq⟩ := pb.exists_eq_aeval' y
    refine ⟨q.comp (C (φ c)⁻¹ * X), ?_⟩
    rw [aeval_comp, map_mul, aeval_C, aeval_X, ← hβgen, ← mul_assoc, ← map_mul,
      inv_mul_cancel₀ hu, map_one, one_mul]
    exact hq.symm
  -- the minimal polynomial over `ℂ[T]` presents the extension
  have hβint : IsIntegral (RatFunc ℂ) β := IsIntegral.of_finite _ _
  have hPmap : (minpoly (Polynomial ℂ) β).map φ = minpoly (RatFunc ℂ) β :=
    (minpoly.isIntegrallyClosed_eq_field_fractions' (RatFunc ℂ) hcint).symm
  have hirr : Irreducible ((minpoly (Polynomial ℂ) β).map φ) := by
    rw [hPmap]; exact minpoly.irreducible hβint
  have haev : aeval β ((minpoly (Polynomial ℂ) β).map φ) = 0 := by
    rw [hPmap]; exact minpoly.aeval _ _
  -- the degree of that minimal polynomial is the order of the Galois group
  have htop : IntermediateField.adjoin (RatFunc ℂ) {β} = ⊤ := by
    refine eq_top_iff.mpr fun x _ => ?_
    obtain ⟨q, hq⟩ := hgenβ x
    have hle : Algebra.adjoin (RatFunc ℂ) {β}
        ≤ (IntermediateField.adjoin (RatFunc ℂ) {β}).toSubalgebra := by
      refine Algebra.adjoin_le ?_
      rintro y hy
      rw [Set.mem_singleton_iff] at hy
      subst hy
      exact IntermediateField.subset_adjoin _ _ rfl
    have hx : x ∈ (IntermediateField.adjoin (RatFunc ℂ) {β}).toSubalgebra := by
      refine hle ?_
      rw [Algebra.adjoin_singleton_eq_range_aeval]
      exact ⟨q, hq⟩
    exact hx
  have hfinrank : Module.finrank (RatFunc ℂ) M = (minpoly (RatFunc ℂ) β).natDegree := by
    rw [← IntermediateField.adjoin.finrank hβint, htop, IntermediateField.finrank_top']
  have hcard : Nat.card (M ≃ₐ[RatFunc ℂ] M) = (minpoly (Polynomial ℂ) β).natDegree := by
    rw [IsGalois.card_aut_eq_finrank, hfinrank, ← hPmap, (minpoly.monic hcint).natDegree_map]
  have hdeg : 0 < (minpoly (Polynomial ℂ) β).natDegree := by
    rw [← hcard]; exact Nat.card_pos
  obtain ⟨S, hSeq, g, hprod, hclosure⟩ :=
    exists_branchCycles_of_galois (minpoly.monic hcint) hdeg hirr haev hgenβ hcard
  exact ⟨minpoly (Polynomial ℂ) β, S, minpoly.monic hcint, hdeg, hSeq, g, hprod, hclosure⟩

/-- **A finite Galois extension of the field of rational functions has branch cycles.**

There is a finite set `S` of parameters and a tuple of automorphisms indexed by `S` together with
one extra index — the loop around infinity — whose product is the identity and which generate the
Galois group. -/
theorem exists_branchCycles_of_isGalois (M : Type) [Field M] [Algebra (RatFunc ℂ) M]
    [FiniteDimensional (RatFunc ℂ) M] [IsGalois (RatFunc ℂ) M] :
    ∃ (S : Finset ℂ) (g : Fin (S.card + 1) → (M ≃ₐ[RatFunc ℂ] M)),
      (List.ofFn g).prod = 1 ∧ Subgroup.closure (Set.range g) = ⊤ := by
  obtain ⟨-, S, -, -, -, g, hprod, hclosure⟩ :=
    exists_branchCycles_eq_degenLocus_of_isGalois M
  exact ⟨S, g, hprod, hclosure⟩

end Rigidity.RET.Analytic

end
