import Mathlib

/-!
# Automorphisms of a simple extension as polynomials

Let `L = K(α)` be generated by one element with minimal polynomial `P`.  Every element of `L` is
`g(α)` for a unique polynomial `g` of degree less than `deg P`; in particular every conjugate of
`α` is `q(α)` for such a `q`, and the automorphism of `L` sending `α` to that conjugate is
described by the single polynomial `q`.

Two facts about those polynomials are what make an automorphism visible on the roots of `P` in
any other ring:

* `P` divides `P ∘ q`, so `q` carries roots of `P` to roots of `P` wherever it is evaluated;
* for two different conjugates the difference of the two polynomials is coprime to `P`, so the
  two images of a root of `P` stay distinct wherever a Bézout identity can be evaluated.

Both statements are identities in `K[X]`, so they survive specialization, which is how the
algebraic Galois action becomes an action on the analytic root variety of a family of equations.

## Main definitions

* `Rigidity.RET.deckPoly` — the polynomial of degree less than `deg P` representing an element of
  a simple extension.

## Main results

* `Rigidity.RET.aeval_deckPoly`, `Rigidity.RET.degree_deckPoly_lt` — the defining properties.
* `Rigidity.RET.dvd_comp_deckPoly` — `P` divides `P ∘ q` for the polynomial `q` of a conjugate of
  the generator.
* `Rigidity.RET.isCoprime_deckPoly_sub` — the polynomials of two distinct elements differ by a
  polynomial coprime to `P`.
* `Rigidity.RET.exists_bezout_deckPoly_sub` — the Bézout identity that separates them.
-/

open Polynomial

noncomputable section

namespace Rigidity.RET

variable {K L : Type*} [Field K] [Field L] [Algebra K L] {P : Polynomial K} {α : L}

/-- **The generator generates polynomially** as soon as it generates as an algebra. -/
theorem exists_aeval_eq (h : Algebra.adjoin K ({α} : Set L) = ⊤) (β : L) :
    ∃ g : Polynomial K, aeval α g = β := by
  have hmem : β ∈ (aeval α : Polynomial K →ₐ[K] L).range := by
    rw [← Algebra.adjoin_singleton_eq_range_aeval, h]
    trivial
  exact hmem

/-- **The polynomial of degree less than `deg P` representing an element of `K(α)`.** -/
def deckPoly (P : Polynomial K) {α : L} (hgen : ∀ β : L, ∃ g : Polynomial K, aeval α g = β)
    (β : L) : Polynomial K :=
  (hgen β).choose %ₘ P

variable (hgen : ∀ β : L, ∃ g : Polynomial K, aeval α g = β)

/-- The representing polynomial does represent the element. -/
theorem aeval_deckPoly (hP : P.Monic) (hPα : aeval α P = 0) (β : L) :
    aeval α (deckPoly P hgen β) = β := by
  have h := congrArg (aeval α) (Polynomial.modByMonic_add_div (hgen β).choose hP)
  rw [map_add, map_mul, hPα, zero_mul, add_zero, (hgen β).choose_spec] at h
  exact h

/-- The representing polynomial has degree less than that of the minimal polynomial. -/
theorem degree_deckPoly_lt (hP : P.Monic) (β : L) : (deckPoly P hgen β).degree < P.degree :=
  Polynomial.degree_modByMonic_lt _ hP

/-- Distinct elements have distinct representing polynomials. -/
theorem deckPoly_ne_of_ne (hP : P.Monic) (hPα : aeval α P = 0) {β γ : L} (h : β ≠ γ) :
    deckPoly P hgen β ≠ deckPoly P hgen γ := by
  intro hEq
  exact h (by rw [← aeval_deckPoly hgen hP hPα β, ← aeval_deckPoly hgen hP hPα γ, hEq])

/-! ### The two identities in `K[X]` -/

/-- **A conjugate of the generator is carried into the roots of `P` by its polynomial.**  This is
the divisibility `P ∣ P ∘ q`, an identity between polynomials over `K`, so it can be evaluated in
any `K`-algebra. -/
theorem dvd_comp_deckPoly (hP : P.Monic) (hPirr : Irreducible P) (hPα : aeval α P = 0) {β : L}
    (hβ : aeval β P = 0) : P ∣ P.comp (deckPoly P hgen β) := by
  have hmin : minpoly K α = P := (minpoly.eq_of_irreducible_of_monic hPirr hPα hP).symm
  have hdvd : minpoly K α ∣ P.comp (deckPoly P hgen β) := by
    refine minpoly.dvd K α ?_
    rw [aeval_comp, aeval_deckPoly hgen hP hPα]
    exact hβ
  rwa [hmin] at hdvd

/-- **Two distinct elements are separated from each other along the roots of `P`**: their
representing polynomials differ by a polynomial coprime to `P`. -/
theorem isCoprime_deckPoly_sub (hP : P.Monic) (hPirr : Irreducible P) (hPα : aeval α P = 0)
    {β γ : L} (h : β ≠ γ) :
    IsCoprime P (deckPoly P hgen β - deckPoly P hgen γ) := by
  have hne : deckPoly P hgen β - deckPoly P hgen γ ≠ 0 :=
    sub_ne_zero.2 (deckPoly_ne_of_ne hgen hP hPα h)
  refine hPirr.coprime_iff_not_dvd.2 fun hdvd => ?_
  have hle := Polynomial.degree_le_of_dvd hdvd hne
  have hlt : (deckPoly P hgen β - deckPoly P hgen γ).degree < P.degree :=
    lt_of_le_of_lt (Polynomial.degree_sub_le _ _)
      (max_lt (degree_deckPoly_lt hgen hP β) (degree_deckPoly_lt hgen hP γ))
  exact absurd hle (not_le.2 hlt)

/-- The Bézout identity behind `Rigidity.RET.isCoprime_deckPoly_sub`. -/
theorem exists_bezout_deckPoly_sub (hP : P.Monic) (hPirr : Irreducible P) (hPα : aeval α P = 0)
    {β γ : L} (h : β ≠ γ) :
    ∃ A B : Polynomial K, A * P + B * (deckPoly P hgen β - deckPoly P hgen γ) = 1 :=
  isCoprime_deckPoly_sub hgen hP hPirr hPα h

end Rigidity.RET

end
