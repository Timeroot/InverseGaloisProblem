import InverseGalois.Rigidity.RET.Analytic.GermInertia
import InverseGalois.Rigidity.RET.Analytic.GermInvariant
import InverseGalois.Rigidity.RET.Descent.AKLBGen

/-!
# Inertia at the place cut out by an analytic branch

An analytic branch of a finite Galois extension `Ω` of `ℂ(T)` at a point `s`, read in the Kummer
coordinate `T = s + u ^ d`, cuts out a place of the integral model of the cover.  The rotation
`u ↦ c u` of the Kummer coordinate, `c` a primitive `d`-th root of unity, is realized by an
automorphism `σ` of the extension; the claim of this file is that `σ` generates the inertia group
at that place.

One inclusion is the stability of the place under the rotation, together with the fact that over an
algebraically closed constant field every residue at a place is a constant, so that the stabilizer
of a place is its inertia group.  The other is a comparison of two bounds on the ramification index,
which by the AKLB counting theorem is the order of the inertia group.  From above, the uniformizer
`X - s` becomes `u ^ d`, which vanishes to order exactly `d`.  From below, `σ` has some order `k`,
and then the rotation by `c ^ k` fixes every germ in the branch, which forces every element of the
place to vanish to order a multiple of the order of `c ^ k`; that divides the upper bound down by
exactly the factor `d / k`.

The point of running the argument this way is that it needs nothing about the branch.  The Kummer
exponent used to read a branch is only defined up to a multiple — a branch read in `u` is also a
branch read in `u ^ m` — and the naive comparison of the two bounds meets only when the exponent is
the exact one.  Here an exponent read too large is corrected by the very rotations it introduces, so
the conclusion holds for every branch and every exponent.

## Main definitions

* `Rigidity.RET.Analytic.germInModel` — a branch, restricted to the integral model.
* `Rigidity.RET.Analytic.branchPlace` — the place of the cover cut out by a branch.

## Main results

* `Rigidity.RET.Analytic.mem_inertia_branchPlace` — a rotation of the Kummer coordinate lies in the
  inertia group of the branch place.
* `Rigidity.RET.Analytic.ramificationIdxIn_branchPlace_mul_le` — a rotation fixing the branch
  divides down the ramification index.
* `Rigidity.RET.Analytic.inertia_branchPlace_eq_zpowers` — the inertia group is generated by the
  rotation.
* `Rigidity.RET.Analytic.exists_inertia_generator_of_branch` — a branch at `s` produces a place
  whose inertia group is generated by the algebraic avatar of the rotation.
* `Rigidity.RET.Analytic.exists_inertia_generator_of_primitive_branch` — for a primitive branch the
  inertia group is cyclic of order the Kummer exponent.
-/

open Filter Topology Polynomial
open scoped Pointwise

noncomputable section

namespace Rigidity.RET.Analytic

open MeroGerm Rigidity.RET.AKLBGen

attribute [local instance] Ideal.Quotient.field Rigidity.RET.AKLBGen.instMSA
  Rigidity.RET.AKLBGen.instIsFrac Rigidity.RET.AKLBGen.instIGG Rigidity.RET.AKLBGen.instFinite
  Rigidity.RET.AKLBGen.instIntegral Rigidity.RET.AKLBGen.instFaithful
  Rigidity.RET.AKLBGen.instDedekindB

variable {Ω : Type*} [Field Ω] [Algebra (RatFunc ℂ) Ω] [FiniteDimensional (RatFunc ℂ) Ω]
  [IsGalois (RatFunc ℂ) Ω] [Algebra (Polynomial ℂ) Ω]
  [IsScalarTower (Polynomial ℂ) (RatFunc ℂ) Ω]

variable {s : ℂ} {d : ℕ}

/-- A branch, restricted to the integral model. -/
def germInModel (Ψ : Ω →+* MeroGerm (0 : ℂ)) : Bring ℂ Ω →+* MeroGerm (0 : ℂ) :=
  Ψ.comp (Subalgebra.val (integralClosure (Polynomial ℂ) Ω)).toRingHom

omit [Algebra (RatFunc ℂ) Ω] [FiniteDimensional (RatFunc ℂ) Ω] [IsGalois (RatFunc ℂ) Ω]
  [IsScalarTower (Polynomial ℂ) (RatFunc ℂ) Ω] in
@[simp] theorem germInModel_apply (Ψ : Ω →+* MeroGerm (0 : ℂ)) (b : Bring ℂ Ω) :
    germInModel Ψ b = Ψ (b : Ω) := rfl

omit [FiniteDimensional (RatFunc ℂ) Ω] [IsGalois (RatFunc ℂ) Ω] in
/-- A branch restricted to the integral model extends the Kummer substitution. -/
theorem germInModel_algebraMap (hd : d ≠ 0) {Ψ : Ω →+* MeroGerm (0 : ℂ)}
    (hΨ : ∀ x : RatFunc ℂ, Ψ (algebraMap (RatFunc ℂ) Ω x) = kummerRatHom s hd x)
    (p : Polynomial ℂ) :
    germInModel Ψ (algebraMap (Polynomial ℂ) (Bring ℂ Ω) p) = kummerHom s d p := by
  have hcoe : ((algebraMap (Polynomial ℂ) (Bring ℂ Ω) p : Bring ℂ Ω) : Ω)
      = algebraMap (Polynomial ℂ) Ω p := rfl
  rw [germInModel_apply, hcoe, IsScalarTower.algebraMap_apply (Polynomial ℂ) (RatFunc ℂ) Ω, hΨ,
    kummerRatHom_algebraMap]

omit [Algebra (RatFunc ℂ) Ω] [FiniteDimensional (RatFunc ℂ) Ω] [IsGalois (RatFunc ℂ) Ω]
  [IsScalarTower (Polynomial ℂ) (RatFunc ℂ) Ω] in
/-- Every element of the integral model is integral over `ℂ[X]`. -/
theorem isIntegral_model (b : Bring ℂ Ω) : IsIntegral (Polynomial ℂ) b :=
  Algebra.IsIntegral.isIntegral b

variable (hd : d ≠ 0) {Ψ : Ω →+* MeroGerm (0 : ℂ)}
  (hΨ : ∀ x : RatFunc ℂ, Ψ (algebraMap (RatFunc ℂ) Ω x) = kummerRatHom s hd x)

include hd hΨ

/-- **The place of the cover cut out by an analytic branch** at the point `s`. -/
def branchPlace : Ideal (Bring ℂ Ω) :=
  germPlace (germInModel_algebraMap hd hΨ) isIntegral_model

instance branchPlace_isPrime : (branchPlace hd hΨ).IsPrime := germPlace_isPrime _ _

instance branchPlace_liesOver : (branchPlace hd hΨ).LiesOver (placeP ℂ s) :=
  ⟨(comap_germPlace hd (germInModel_algebraMap hd hΨ) isIntegral_model).symm⟩

set_option synthInstance.maxHeartbeats 400000 in
instance branchPlace_isMaximal : (branchPlace hd hΨ).IsMaximal :=
  Ideal.IsPrime.isMaximal inferInstance (ne_bot_of_liesOver ℂ Ω s _)

set_option synthInstance.maxHeartbeats 400000 in
/-- **The ramification index at the branch place is at most the Kummer exponent.** -/
theorem ramificationIdxIn_branchPlace_le :
    Ideal.ramificationIdxIn (placeP ℂ s) (Bring ℂ Ω) ≤ d := by
  rw [Ideal.ramificationIdxIn_eq_ramificationIdx (placeP ℂ s) (branchPlace hd hΨ)
    (Ω ≃ₐ[RatFunc ℂ] Ω)]
  exact ramificationIdx_germPlace_le (germInModel_algebraMap hd hΨ) isIntegral_model

omit [FiniteDimensional (RatFunc ℂ) Ω] in
/-- An automorphism which rotates the Kummer coordinate of the branch stabilizes the branch
place. -/
theorem smul_branchPlace {c : ℂ} (hc : c ≠ 0) {σ : Ω ≃ₐ[RatFunc ℂ] Ω}
    (h : ∀ x : Ω, Ψ (σ x) = scaleGerm hc (Ψ x)) : σ • branchPlace hd hΨ = branchPlace hd hΨ := by
  set σB : Bring ℂ Ω →+* Bring ℂ Ω :=
    MulSemiringAction.toRingHom (Ω ≃ₐ[RatFunc ℂ] Ω) (Bring ℂ Ω) σ with hσB
  have hcomp : (germInModel Ψ).comp σB = (scaleGerm hc).comp (germInModel Ψ) := by
    refine RingHom.ext fun b => ?_
    show Ψ ((σ • b : Bring ℂ Ω) : Ω) = scaleGerm hc (Ψ (b : Ω))
    rw [coe_smul ℂ Ω σ b, h]
  have hQ := germPlace_comap_eq_self_of_scale hc (germInModel_algebraMap hd hΨ)
    isIntegral_model σB hcomp
  have hmem : ∀ b : Bring ℂ Ω, σ • b ∈ branchPlace hd hΨ ↔ b ∈ branchPlace hd hΨ :=
    fun b => Ideal.ext_iff.1 hQ b
  ext x
  rw [Ideal.mem_pointwise_smul_iff_inv_smul_mem, ← hmem (σ⁻¹ • x), smul_inv_smul]

set_option synthInstance.maxHeartbeats 400000 in
/-- An automorphism which rotates the Kummer coordinate of the branch lies in the inertia group of
the branch place. -/
theorem mem_inertia_branchPlace {c : ℂ} (hc : c ≠ 0) {σ : Ω ≃ₐ[RatFunc ℂ] Ω}
    (h : ∀ x : Ω, Ψ (σ x) = scaleGerm hc (Ψ x)) :
    σ ∈ (branchPlace hd hΨ).inertia (Ω ≃ₐ[RatFunc ℂ] Ω) := by
  rw [inertia_eq_stabilizer ℂ Ω s (branchPlace hd hΨ)]
  exact smul_branchPlace hd hΨ hc h

/-! ### Rotations fixing the branch, and the refined ramification bound -/

omit [FiniteDimensional (RatFunc ℂ) Ω] [IsGalois (RatFunc ℂ) Ω] in
/-- **A rotation of the coordinate fixing the branch bounds below the vanishing at the branch
place**: every element of the place vanishes to order at least the order of the rotation. -/
theorem le_ord_of_mem_branchPlace {a : ℂ} (ha : a ≠ 0)
    (hinv : ∀ x : Ω, scaleGerm ha (Ψ x) = Ψ x) {b : Bring ℂ Ω} (hb : b ∈ branchPlace hd hΨ) :
    ((orderOf a : ℤ) : WithTop ℤ) ≤ ord (germInModel Ψ b) :=
  le_ord_of_scaleGerm_eq_self ha (hinv (b : Ω)) (mem_germPlace.1 hb)

set_option synthInstance.maxHeartbeats 400000 in
/-- **A rotation of the coordinate fixing the branch divides down the ramification index.**

The Kummer exponent used to read a branch is only determined up to a multiple: a branch read in the
coordinate `u` is also a branch read in `u ^ m`, and then every germ in the image is invariant under
the rotations of order `m`.  What the ramification index sees is the exponent stripped of that
ambiguity. -/
theorem ramificationIdxIn_branchPlace_mul_le {a : ℂ} (ha : a ≠ 0) (hm : orderOf a ≠ 0)
    (hinv : ∀ x : Ω, scaleGerm ha (Ψ x) = Ψ x) :
    Ideal.ramificationIdxIn (placeP ℂ s) (Bring ℂ Ω) * orderOf a ≤ d := by
  rw [Ideal.ramificationIdxIn_eq_ramificationIdx (placeP ℂ s) (branchPlace hd hΨ)
    (Ω ≃ₐ[RatFunc ℂ] Ω)]
  have hkey : Ideal.ramificationIdx (algebraMap (Polynomial ℂ) (Bring ℂ Ω)) (placeP ℂ s)
      (branchPlace hd hΨ) ≤ d / orderOf a := by
    refine Nat.lt_succ_iff.1 (Ideal.ramificationIdx_lt ?_)
    intro hle
    have hmem : algebraMap (Polynomial ℂ) (Bring ℂ Ω) (X - C s)
        ∈ branchPlace hd hΨ ^ (d / orderOf a + 1) :=
      hle (Ideal.mem_map_of_mem _ (Ideal.mem_span_singleton_self _))
    have hord := le_ord_of_mem_germPlace_pow_of_le (germInModel_algebraMap hd hΨ) isIntegral_model
      (fun b hb => le_ord_of_mem_branchPlace hd hΨ ha hinv hb) (d / orderOf a + 1) hmem
    rw [germInModel_algebraMap hd hΨ, ord_kummerHom_X_sub_C, WithTop.coe_le_coe] at hord
    have hnat : (d / orderOf a + 1) * orderOf a ≤ d := by exact_mod_cast hord
    rw [show (d / orderOf a + 1) * orderOf a = orderOf a * (d / orderOf a) + orderOf a from by
      ring] at hnat
    have h1 := Nat.div_add_mod d (orderOf a)
    have h2 := Nat.mod_lt d (Nat.pos_of_ne_zero hm)
    omega
  exact le_trans (Nat.mul_le_mul_right _ hkey) (Nat.div_mul_le_self d (orderOf a))

set_option synthInstance.maxHeartbeats 400000 in
/-- **The inertia group at the branch place is generated by the rotation of the Kummer
coordinate.**

This is the comparison of the analytic and the algebraic normalizations at a branch point.  One
inequality is the stability of the place under the rotation; the other is the interplay of two
bounds on the ramification index, the one coming from the vanishing of the uniformizer and the one
coming from the rotations that fix the branch.  Neither needs the Kummer exponent to be the exact
one: an exponent read too large is corrected by the rotations it introduces. -/
theorem inertia_branchPlace_eq_zpowers {c : ℂ} (hc : c ≠ 0) (hcd : orderOf c = d)
    {σ : Ω ≃ₐ[RatFunc ℂ] Ω} (h : ∀ x : Ω, Ψ (σ x) = scaleGerm hc (Ψ x)) :
    (branchPlace hd hΨ).inertia (Ω ≃ₐ[RatFunc ℂ] Ω) = Subgroup.zpowers σ := by
  have hkpos : 0 < orderOf σ := orderOf_pos σ
  have hck : (c ^ orderOf σ) ≠ 0 := pow_ne_zero _ hc
  have hfix : ∀ x : Ω, scaleGerm hck (Ψ x) = Ψ x := by
    intro x
    rw [← apply_pow_eq_scaleGerm hc h (orderOf σ) x, pow_orderOf_eq_one σ]
    rfl
  have hcd1 : c ^ d = 1 := by rw [← hcd]; exact pow_orderOf_eq_one c
  have hmdvd : orderOf (c ^ orderOf σ) ∣ d :=
    orderOf_dvd_of_pow_eq_one (by rw [← pow_mul, mul_comm, pow_mul, hcd1, one_pow])
  have hmne : orderOf (c ^ orderOf σ) ≠ 0 := by
    intro h0
    rw [h0] at hmdvd
    exact hd (zero_dvd_iff.1 hmdvd)
  have hdle : d ≤ orderOf σ * orderOf (c ^ orderOf σ) := by
    have hpow : c ^ (orderOf σ * orderOf (c ^ orderOf σ)) = 1 := by
      rw [pow_mul]; exact pow_orderOf_eq_one _
    have hdvd : d ∣ orderOf σ * orderOf (c ^ orderOf σ) := by
      rw [← hcd]; exact orderOf_dvd_of_pow_eq_one hpow
    exact Nat.le_of_dvd (Nat.mul_pos hkpos (Nat.pos_of_ne_zero hmne)) hdvd
  have hemul := ramificationIdxIn_branchPlace_mul_le hd hΨ hck hmne hfix
  have hcardI : Nat.card ((branchPlace hd hΨ).inertia (Ω ≃ₐ[RatFunc ℂ] Ω))
      = Ideal.ramificationIdxIn (placeP ℂ s) (Bring ℂ Ω) :=
    card_inertia ℂ Ω s (branchPlace hd hΨ)
  have hcard : Nat.card ((branchPlace hd hΨ).inertia (Ω ≃ₐ[RatFunc ℂ] Ω)) ≤ orderOf σ := by
    rw [hcardI]
    have hmpos := Nat.pos_of_ne_zero hmne
    exact Nat.le_of_mul_le_mul_right (le_trans hemul hdle) hmpos
  have hle : Subgroup.zpowers σ ≤ (branchPlace hd hΨ).inertia (Ω ≃ₐ[RatFunc ℂ] Ω) :=
    Subgroup.zpowers_le.2 (mem_inertia_branchPlace hd hΨ hc h)
  refine (Subgroup.eq_of_le_of_card_ge hle ?_).symm
  rwa [Nat.card_zpowers]

set_option synthInstance.maxHeartbeats 400000 in
/-- **The inertia group at the branch place has the order of the rotation.** -/
theorem card_inertia_branchPlace {c : ℂ} (hc : c ≠ 0) (hcd : orderOf c = d)
    {σ : Ω ≃ₐ[RatFunc ℂ] Ω} (h : ∀ x : Ω, Ψ (σ x) = scaleGerm hc (Ψ x)) :
    Nat.card ((branchPlace hd hΨ).inertia (Ω ≃ₐ[RatFunc ℂ] Ω)) = orderOf σ := by
  rw [inertia_branchPlace_eq_zpowers hd hΨ hc hcd h, Nat.card_zpowers]

set_option synthInstance.maxHeartbeats 400000 in
/-- **An analytic branch at a point `s` produces a place of the cover whose inertia group is
generated by the algebraic avatar of the rotation of the Kummer coordinate.** -/
theorem exists_inertia_generator_of_branch {c : ℂ} (hc : c ≠ 0) (hcd : orderOf c = d) :
    ∃ (Q : Ideal (Bring ℂ Ω)) (σ : Ω ≃ₐ[RatFunc ℂ] Ω), Q.IsMaximal ∧ Q.LiesOver (placeP ℂ s) ∧
      (∀ x : Ω, Ψ (σ x) = scaleGerm hc (Ψ x)) ∧
      Q.inertia (Ω ≃ₐ[RatFunc ℂ] Ω) = Subgroup.zpowers σ ∧
      Nat.card (Q.inertia (Ω ≃ₐ[RatFunc ℂ] Ω)) = orderOf σ := by
  have hcd' : c ^ d = 1 := by rw [← hcd]; exact pow_orderOf_eq_one c
  obtain ⟨σ, hσ⟩ := exists_algEquiv_of_scaleGerm hd hc hcd' hΨ
  exact ⟨branchPlace hd hΨ, σ, inferInstance, inferInstance, hσ,
    inertia_branchPlace_eq_zpowers hd hΨ hc hcd hσ,
    card_inertia_branchPlace hd hΨ hc hcd hσ⟩

set_option synthInstance.maxHeartbeats 400000 in
/-- **A primitive branch of Kummer exponent `d` produces a place whose inertia group is cyclic of
order exactly `d`.** -/
theorem exists_inertia_generator_of_primitive_branch {c : ℂ} (hc : c ≠ 0) (hcd : orderOf c = d)
    (hprim : ∀ (a : ℂ) (ha : a ≠ 0), a ^ d = 1 → (∀ x : Ω, scaleGerm ha (Ψ x) = Ψ x) → a = 1) :
    ∃ (Q : Ideal (Bring ℂ Ω)) (σ : Ω ≃ₐ[RatFunc ℂ] Ω), Q.IsMaximal ∧ Q.LiesOver (placeP ℂ s) ∧
      orderOf σ = d ∧ Q.inertia (Ω ≃ₐ[RatFunc ℂ] Ω) = Subgroup.zpowers σ ∧
      Nat.card (Q.inertia (Ω ≃ₐ[RatFunc ℂ] Ω)) = d := by
  obtain ⟨Q, σ, hmax, hover, hσ, hzp, hcard⟩ := exists_inertia_generator_of_branch hd hΨ hc hcd
  have horder : orderOf σ = d := orderOf_eq_of_scaleGerm hc hcd hprim hσ
  exact ⟨Q, σ, hmax, hover, horder, hzp, by rw [hcard, horder]⟩

end Rigidity.RET.Analytic

end
