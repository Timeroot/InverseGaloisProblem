import InverseGalois.Rigidity.RET.Analytic.GermPlace

/-!
# Carrying a function field into the germs at a branch point

The Kummer substitution `T ↦ s + u ^ d` sends rational functions of `T` to meromorphic germs at the
origin.  A finite extension `M` of `ℂ(T)`, generated by a root `α` of an irreducible polynomial `p`,
extends the substitution as soon as the germ field contains a germ `γ` satisfying the same equation:
presenting `M` as `ℂ(T)[Y] / (p)` turns the choice of `γ` into a ring map `M → MeroGerm 0`.

Together with the place construction of the previous file this is the bridge between an analytic
branch of an algebraic equation and a place of the algebraic model.

## Main results

* `Rigidity.RET.Analytic.exists_ringHom_of_root` — a germ satisfying the equation of a generator
  extends the Kummer substitution to the whole extension.
-/

open Filter Topology Polynomial

noncomputable section

namespace Rigidity.RET.Analytic

open MeroGerm

variable {M : Type*} [Field M] [Algebra (RatFunc ℂ) M]

/-- **A germ satisfying the equation of a generator carries the whole extension into the germ
field.**

The extension is presented as `ℂ(T)[Y] / (p)` — this is where irreducibility of `p` and generation
by `α` are used — and the germ `γ` names the image of `Y`. -/
theorem exists_ringHom_of_root {α : M} {p : Polynomial (RatFunc ℂ)} (hirr : Irreducible p)
    (hα : aeval α p = 0) (hgen : ∀ β : M, ∃ q : Polynomial (RatFunc ℂ), aeval α q = β)
    (s : ℂ) {d : ℕ} (hd : d ≠ 0) {γ : MeroGerm (0 : ℂ)}
    (hγ : Polynomial.eval₂ (kummerRatHom s hd : RatFunc ℂ →+* MeroGerm (0 : ℂ)) γ p = 0) :
    ∃ Ψ : M →+* MeroGerm (0 : ℂ),
      (∀ c : RatFunc ℂ, Ψ (algebraMap (RatFunc ℂ) M c) = kummerRatHom s hd c) ∧ Ψ α = γ := by
  classical
  haveI : Fact (Irreducible p) := ⟨hirr⟩
  have hα' : Polynomial.eval₂ (Algebra.ofId (RatFunc ℂ) M : RatFunc ℂ →+* M) α p = 0 := by
    rw [Algebra.toRingHom_ofId, ← Polynomial.aeval_def]
    exact hα
  set e : AdjoinRoot p →ₐ[RatFunc ℂ] M :=
    AdjoinRoot.liftAlgHom p (Algebra.ofId (RatFunc ℂ) M) α hα' with he
  have hinj : Function.Injective e := (e : AdjoinRoot p →+* M).injective
  have hsurj : Function.Surjective e := by
    intro β
    obtain ⟨q, hq⟩ := hgen β
    refine ⟨AdjoinRoot.mk p q, ?_⟩
    rw [he, AdjoinRoot.liftAlgHom_mk, Algebra.toRingHom_ofId, ← Polynomial.aeval_def]
    exact hq
  set E : AdjoinRoot p ≃ₐ[RatFunc ℂ] M := AlgEquiv.ofBijective e ⟨hinj, hsurj⟩ with hE
  refine ⟨(AdjoinRoot.lift (kummerRatHom s hd : RatFunc ℂ →+* MeroGerm (0 : ℂ)) γ hγ).comp
    (E.symm : M →+* AdjoinRoot p), fun c => ?_, ?_⟩
  · show AdjoinRoot.lift _ _ hγ (E.symm (algebraMap (RatFunc ℂ) M c)) = _
    rw [AlgEquiv.commutes]
    exact AdjoinRoot.lift_of hγ
  · show AdjoinRoot.lift _ _ hγ (E.symm α) = γ
    have hroot : E (AdjoinRoot.root p) = α := by
      rw [hE]
      show e (AdjoinRoot.root p) = α
      rw [he, AdjoinRoot.liftAlgHom_root]
    rw [← hroot, AlgEquiv.symm_apply_apply]
    exact AdjoinRoot.lift_root hγ

end Rigidity.RET.Analytic

end
