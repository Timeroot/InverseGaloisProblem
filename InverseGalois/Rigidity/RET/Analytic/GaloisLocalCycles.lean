import Mathlib
import InverseGalois.Rigidity.RET.Analytic.LocalCycles
import InverseGalois.Rigidity.RET.Analytic.Presentation

/-!
# The Galois group of an extension of `ℂ(T)` as a quotient of a punctured plane

The branch cycles of `RET/Analytic/GaloisCycles.lean` are produced from the sphere presentation of
the fundamental group of the punctured plane, and so carry no record of which puncture each of them
belongs to.  Combining the presentation of the extension by a family of equations with the spider
of `RET/Pi1/Topological/Spider.lean` replaces that abstract tuple by a genuinely local one: the
whole Galois group is a quotient of the fundamental group of a punctured plane, and it is generated
by the images of loops winding around the individual punctures.

## Main results

* `Rigidity.RET.Analytic.exists_localizedBranchCycles_of_galois` — for an extension presented by a
  family of equations.
* `Rigidity.RET.Analytic.exists_localizedBranchCycles_of_isGalois` — for an arbitrary finite Galois
  extension of `ℂ(T)`.
-/

open Polynomial Rigidity.RET

noncomputable section

namespace Rigidity.RET.Analytic

/-- **A Galois extension of the complex rational function field is a quotient of the fundamental
group of a punctured plane, generated by loops around the punctures.**

The extension is presented by a monic family of equations depending polynomially on the parameter.
Away from the parameters at which the family acquires a repeated root, its roots form a covering
space of the plane, and the monodromy of that covering is a surjection of the fundamental group of
the punctured plane onto the Galois group.  Loops winding around the individual degenerate
parameters already generate. -/
theorem exists_localizedBranchCycles_of_galois {P : Polynomial (Polynomial ℂ)} (hP : P.Monic)
    (hdeg : 0 < P.natDegree)
    {L : Type} [Field L] [Algebra (RatFunc ℂ) L] [Finite (L ≃ₐ[RatFunc ℂ] L)] {α : L}
    (hirr : Irreducible (P.map (algebraMap (Polynomial ℂ) (RatFunc ℂ))))
    (hα : aeval α (P.map (algebraMap (Polynomial ℂ) (RatFunc ℂ))) = 0)
    (hgen : ∀ β : L, ∃ q : Polynomial (RatFunc ℂ), aeval α q = β)
    (hcard : Nat.card (L ≃ₐ[RatFunc ℂ] L) = P.natDegree) :
    ∃ (S : Finset ℂ) (z₀ : ℂ) (hz₀ : z₀ ∉ (S : Set ℂ)),
      (∀ z ∉ (S : Set ℂ), (spec P z).Separable) ∧
        ∃ (Φ : FundamentalGroup ↥((S : Set ℂ)ᶜ) ⟨z₀, hz₀⟩ →* (L ≃ₐ[RatFunc ℂ] L))
          (γ : ℂ → FundamentalGroup ↥((S : Set ℂ)ᶜ) ⟨z₀, hz₀⟩),
          Function.Surjective Φ ∧
            (∀ s ∈ degenLocus P, IsPunctureLoop ((S : Set ℂ)ᶜ) s hz₀ (γ s)) ∧
              Subgroup.closure ((fun s => Φ (γ s)) '' degenLocus P) = ⊤ := by
  classical
  have hirrP : Irreducible P :=
    (hP.isPrimitive.irreducible_iff_irreducible_map_fraction_map (K := RatFunc ℂ)).mpr hirr
  obtain ⟨S, hS, ⟨D⟩⟩ := exists_integralDeck hP hirr hα hgen
  obtain ⟨z₀, hz₀⟩ := Infinite.exists_notMem_finset S
  have hz₀' : z₀ ∉ (S : Set ℂ) := fun h => hz₀ h
  have hpos : 0 < Nat.card (puncturedProj P S ⁻¹' {(⟨z₀, hz₀'⟩ : ↥((S : Set ℂ)ᶜ))}) := by
    rw [card_puncturedFiber hP hS hz₀']; exact hdeg
  obtain ⟨e₀⟩ := (Nat.card_pos_iff.mp hpos).1
  obtain ⟨γ, g, hγ, hg, htop⟩ :=
    D.toRationalDeck.exists_localizedBranchCycles_degen hP hdeg hirrP hS hz₀' hcard e₀
  refine ⟨S, z₀, hz₀', hS,
    D.toRationalDeck.deckMonodromy hP hdeg hirrP hS hz₀' hcard e₀, γ,
    D.toRationalDeck.surjective_deckMonodromy hP hdeg hirrP hS hz₀' hcard e₀, hγ, ?_⟩
  rwa [show (fun s => D.toRationalDeck.deckMonodromy hP hdeg hirrP hS hz₀' hcard e₀ (γ s)) = g from
    (funext hg).symm]

/-- **The Galois group of any finite Galois extension of `ℂ(T)` is a quotient of the fundamental
group of a punctured plane, generated by loops around the punctures.**

The punctures are the parameters at which the family of equations presenting the extension
degenerates, and the generator attached to a puncture is the monodromy of a loop winding around
that puncture alone. -/
theorem exists_localizedBranchCycles_of_isGalois (M : Type) [Field M] [Algebra (RatFunc ℂ) M]
    [FiniteDimensional (RatFunc ℂ) M] [IsGalois (RatFunc ℂ) M] :
    ∃ (P : Polynomial (Polynomial ℂ)) (S : Finset ℂ) (z₀ : ℂ) (hz₀ : z₀ ∉ (S : Set ℂ)),
      P.Monic ∧ (∀ z ∉ (S : Set ℂ), (spec P z).Separable) ∧
        ∃ (Φ : FundamentalGroup ↥((S : Set ℂ)ᶜ) ⟨z₀, hz₀⟩ →* (M ≃ₐ[RatFunc ℂ] M))
          (γ : ℂ → FundamentalGroup ↥((S : Set ℂ)ᶜ) ⟨z₀, hz₀⟩),
          Function.Surjective Φ ∧
            (∀ s ∈ degenLocus P, IsPunctureLoop ((S : Set ℂ)ᶜ) s hz₀ (γ s)) ∧
              Subgroup.closure ((fun s => Φ (γ s)) '' degenLocus P) = ⊤ := by
  obtain ⟨P, β, hP, hdeg, hirr, haev, hgenβ, hcard⟩ := exists_presentation_of_isGalois M
  obtain ⟨S, z₀, hz₀, hS, Φ, γ, hsurj, hγ, htop⟩ :=
    exists_localizedBranchCycles_of_galois hP hdeg hirr haev hgenβ hcard
  exact ⟨P, S, z₀, hz₀, hP, hS, Φ, γ, hsurj, hγ, htop⟩

end Rigidity.RET.Analytic

end
