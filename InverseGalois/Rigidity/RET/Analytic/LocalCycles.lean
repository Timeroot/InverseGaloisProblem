import Mathlib
import InverseGalois.Rigidity.RET.Analytic.Shrink
import InverseGalois.Rigidity.RET.Pi1.Topological.Spider

/-!
# Branch cycles attached to the individual branch points

The branch cycles of `RET/Analytic/RootMonodromy.lean` are produced from the sphere presentation
of the fundamental group of the punctured plane.  That presentation is obtained by an induction
which does not remember which puncture each generator winds around, so the resulting tuple is
indexed by an abstract `Fin (S.card + 1)` and carries no information about *where* each of its
entries is local.

The spider of `RET/Pi1/Topological/Spider.lean` supplies the missing bookkeeping: the fundamental
group of the punctured plane is generated by a system of loops with one loop *for each* puncture,
each of them winding around its own puncture and no other.  Pushing that system through the
monodromy representation produces branch cycles indexed by the punctures themselves, each of them
the monodromy of a small loop around its own branch point.

What this presentation does not record is the product-one relation, which belongs to the sphere
presentation and to a specific ordering of the loops; what it supplies is locality, which is what
makes a branch cycle comparable with the inertia group at the corresponding place.  The two are
carried together in `RET/Analytic/GaloisProdOne.lean`, on top of the ordered spider of
`RET/Pi1/Topological/PlaneSpider.lean`.

## Main definitions

* `Rigidity.RET.Analytic.IsLocalMonodromy` — a permutation of the fibre is the monodromy of a loop
  winding around a prescribed branch point.
* `Rigidity.RET.Analytic.RationalDeck.deckMonodromy` — the monodromy representation of the
  punctured plane on the group of formulas itself.

## Main results

* `Rigidity.RET.Analytic.exists_localMonodromy` — the monodromy group is generated by local
  monodromy elements, one for each branch point.
* `Rigidity.RET.Analytic.monodromyHom_eq_one_of_isPunctureLoop` — a loop around a parameter at
  which the family stays separable has trivial monodromy.
* `Rigidity.RET.Analytic.exists_localMonodromy_degen` — only the parameters at which the family
  degenerates are needed.
* `Rigidity.RET.Analytic.RationalDeck.exists_localizedBranchCycles`,
  `Rigidity.RET.Analytic.RationalDeck.exists_localizedBranchCycles_degen` — the same inside the
  group of formulas: one element for each branch point, each the monodromy of a loop around that
  point, and together they generate the group.
-/

open Polynomial Rigidity.RET

noncomputable section

namespace Rigidity.RET

/-- The image of a generating set under a surjective homomorphism generates. -/
theorem closure_image_eq_top {A B : Type*} [Group A] [Group B] {f : A →* B}
    (hf : Function.Surjective f) {s : Set A} (hs : Subgroup.closure s = ⊤) :
    Subgroup.closure (f '' s) = ⊤ := by
  rw [← MonoidHom.map_closure, hs, ← MonoidHom.range_eq_map, MonoidHom.range_eq_top]
  exact hf

namespace Analytic

variable {P : Polynomial (Polynomial ℂ)} {S : Finset ℂ} {G : Type} [Group G]

/-! ### Local monodromy -/

/-- **A permutation of the fibre is a local monodromy element at `s`** when it is the monodromy of
a loop winding once around the puncture `s`. -/
def IsLocalMonodromy (hP : P.Monic) (hS : ∀ z ∉ (S : Set ℂ), (spec P z).Separable) {z₀ : ℂ}
    (hz₀ : z₀ ∉ (S : Set ℂ)) (s : ℂ)
    (x : Equiv.Perm (puncturedProj P S ⁻¹' {(⟨z₀, hz₀⟩ : ↥((S : Set ℂ)ᶜ))})) : Prop :=
  ∃ γ : FundamentalGroup ↥((S : Set ℂ)ᶜ) ⟨z₀, hz₀⟩,
    IsPunctureLoop ((S : Set ℂ)ᶜ) s hz₀ γ ∧ monodromyHom hP hS hz₀ γ = x

/-- **The monodromy group is generated by local monodromy elements, one at each branch point.**

This is the branch-cycle system of the family read off the spider rather than off the sphere
presentation: the entry attached to a parameter `s` is the monodromy of a loop that winds around
`s` alone. -/
theorem exists_localMonodromy (hP : P.Monic) (hS : ∀ z ∉ (S : Set ℂ), (spec P z).Separable)
    {z₀ : ℂ} (hz₀ : z₀ ∉ (S : Set ℂ)) :
    ∃ x : ℂ → Equiv.Perm (puncturedProj P S ⁻¹' {(⟨z₀, hz₀⟩ : ↥((S : Set ℂ)ᶜ))}),
      (∀ s ∈ (S : Set ℂ), IsLocalMonodromy hP hS hz₀ s (x s)) ∧
        Subgroup.closure (x '' (S : Set ℂ)) = (monodromyHom hP hS hz₀).range := by
  obtain ⟨γ, hγ, htop⟩ := exists_punctureLoops_compl S.finite_toSet (z₀ := z₀) hz₀
  refine ⟨fun s => monodromyHom hP hS hz₀ (γ s), fun s hs => ⟨γ s, hγ s hs, rfl⟩, ?_⟩
  rw [show (fun s => monodromyHom hP hS hz₀ (γ s)) '' (S : Set ℂ)
      = (monodromyHom hP hS hz₀) '' (γ '' (S : Set ℂ)) from (Set.image_image _ _ _).symm,
    ← MonoidHom.map_closure, htop, ← MonoidHom.range_eq_map]

/-! ### Only the genuine branch points contribute -/

/-- Filling parameters back in is the inclusion of the punctured planes. -/
theorem baseIncl_eq_subsetIncl {S' : Finset ℂ} (hsub : (S' : Set ℂ) ⊆ (S : Set ℂ)) :
    baseIncl hsub = subsetIncl (Set.compl_subset_compl.2 hsub) := rfl

/-- **A loop around a parameter at which the family stays separable has trivial monodromy.**  The
covering extends across such a parameter, so a loop encircling it bounds. -/
theorem monodromyHom_eq_one_of_isPunctureLoop (hP : P.Monic)
    (hS : ∀ z ∉ (S : Set ℂ), (spec P z).Separable) {z₀ : ℂ} (hz₀ : z₀ ∉ (S : Set ℂ)) {s : ℂ}
    (hsep : (spec P s).Separable) {γ : FundamentalGroup ↥((S : Set ℂ)ᶜ) ⟨z₀, hz₀⟩}
    (hγ : IsPunctureLoop ((S : Set ℂ)ᶜ) s hz₀ γ) : monodromyHom hP hS hz₀ γ = 1 := by
  classical
  have hsub : ((S.erase s : Finset ℂ) : Set ℂ) ⊆ (S : Set ℂ) := fun _ hz =>
    Finset.mem_of_mem_erase hz
  have hS'sep : ∀ z ∉ ((S.erase s : Finset ℂ) : Set ℂ), (spec P z).Separable := by
    intro z hz
    by_cases hzs : z = s
    · exact hzs ▸ hsep
    · exact hS z fun hzS => hz (Finset.mem_erase.2 ⟨hzs, hzS⟩)
  have hz₀' : z₀ ∉ ((S.erase s : Finset ℂ) : Set ℂ) := fun h => hz₀ (hsub h)
  have hs' : s ∈ (((S.erase s : Finset ℂ) : Set ℂ))ᶜ := fun h => (Finset.mem_erase.1 h).1 rfl
  have hone : FundamentalGroup.map (baseIncl hsub) (⟨z₀, hz₀⟩ : ↥((S : Set ℂ)ᶜ)) γ = 1 :=
    map_eq_one_of_isPunctureLoop (Set.compl_subset_compl.2 hsub) hs' hγ
  have key : monodromyHom hP hS'sep hz₀'
        (FundamentalGroup.map (baseIncl hsub) (⟨z₀, hz₀⟩ : ↥((S : Set ℂ)ᶜ)) γ)
      = Equiv.permCongrHom (fibreIncl P hz₀ hz₀') (monodromyHom hP hS hz₀ γ) :=
    congrFun (congrArg DFunLike.coe (monodromyHom_comp_map hP hS hS'sep hsub hz₀ hz₀')) γ
  rw [hone, map_one] at key
  exact (Equiv.permCongrHom (fibreIncl P hz₀ hz₀')).injective (key.symm.trans (map_one _).symm)

/-- **The monodromy group is generated by local monodromy elements at the genuine branch points.**

Only the parameters at which the family acquires a repeated root contribute: the entry attached to
such a parameter is the monodromy of a loop winding around it alone, and those entries already
generate the whole monodromy group. -/
theorem exists_localMonodromy_degen (hP : P.Monic)
    (hS : ∀ z ∉ (S : Set ℂ), (spec P z).Separable) {z₀ : ℂ} (hz₀ : z₀ ∉ (S : Set ℂ)) :
    ∃ x : ℂ → Equiv.Perm (puncturedProj P S ⁻¹' {(⟨z₀, hz₀⟩ : ↥((S : Set ℂ)ᶜ))}),
      (∀ s ∈ degenLocus P, IsLocalMonodromy hP hS hz₀ s (x s)) ∧
        Subgroup.closure (x '' degenLocus P) = (monodromyHom hP hS hz₀).range := by
  classical
  obtain ⟨γ, hγ, htop⟩ := exists_punctureLoops_compl S.finite_toSet (z₀ := z₀) hz₀
  have hdsub : degenLocus P ⊆ (S : Set ℂ) := degenLocus_subset hS
  have hfull : Subgroup.closure ((fun s => monodromyHom hP hS hz₀ (γ s)) '' (S : Set ℂ))
      = (monodromyHom hP hS hz₀).range := by
    rw [show (fun s => monodromyHom hP hS hz₀ (γ s)) '' (S : Set ℂ)
        = (monodromyHom hP hS hz₀) '' (γ '' (S : Set ℂ)) from (Set.image_image _ _ _).symm,
      ← MonoidHom.map_closure, htop, ← MonoidHom.range_eq_map]
  refine ⟨fun s => monodromyHom hP hS hz₀ (γ s), fun s hs => ⟨γ s, hγ s (hdsub hs), rfl⟩, ?_⟩
  rw [← hfull]
  refine le_antisymm (Subgroup.closure_mono (Set.image_mono hdsub)) ((Subgroup.closure_le _).2 ?_)
  rintro y ⟨s, hs, rfl⟩
  by_cases hsd : s ∈ degenLocus P
  · exact Subgroup.subset_closure ⟨s, hsd, rfl⟩
  · show monodromyHom hP hS hz₀ (γ s) ∈ Subgroup.closure _
    rw [show monodromyHom hP hS hz₀ (γ s) = 1 from monodromyHom_eq_one_of_isPunctureLoop hP hS hz₀
      (separable_of_notMem_degenLocus hsd) (hγ s hs)]
    exact one_mem _

namespace RationalDeck

/-! ### The monodromy representation on the group of formulas -/

/-- **The monodromy representation of the punctured plane on the group of formulas itself.**  For
an irreducible family carrying a group of root formulas of the right size, the monodromy group is
a copy of that group, so the monodromy representation may be read as a surjection of the
fundamental group of the punctured plane onto the group. -/
def deckMonodromy (D : RationalDeck P S G) [Finite G] (hP : P.Monic) (hdeg : 0 < P.natDegree)
    (hirr : Irreducible P) (hS : ∀ z ∉ (S : Set ℂ), (spec P z).Separable) {z₀ : ℂ}
    (hz₀ : z₀ ∉ (S : Set ℂ)) (hcard : Nat.card G = P.natDegree)
    (e₀ : puncturedProj P S ⁻¹' {(⟨z₀, hz₀⟩ : ↥((S : Set ℂ)ᶜ))}) :
    FundamentalGroup ↥((S : Set ℂ)ᶜ) ⟨z₀, hz₀⟩ →* G :=
  (D.monodromyEquiv hP hdeg hirr hS hz₀ hcard e₀ : _ →* G).comp
    (monodromyHom hP hS hz₀).rangeRestrict

theorem surjective_deckMonodromy (D : RationalDeck P S G) [Finite G] (hP : P.Monic)
    (hdeg : 0 < P.natDegree) (hirr : Irreducible P)
    (hS : ∀ z ∉ (S : Set ℂ), (spec P z).Separable) {z₀ : ℂ} (hz₀ : z₀ ∉ (S : Set ℂ))
    (hcard : Nat.card G = P.natDegree)
    (e₀ : puncturedProj P S ⁻¹' {(⟨z₀, hz₀⟩ : ↥((S : Set ℂ)ᶜ))}) :
    Function.Surjective (D.deckMonodromy hP hdeg hirr hS hz₀ hcard e₀) :=
  (D.monodromyEquiv hP hdeg hirr hS hz₀ hcard e₀).surjective.comp
    (monodromyHom hP hS hz₀).rangeRestrict_surjective

/-- **A branch-cycle system indexed by the branch points themselves.**  Each entry is the image
under the monodromy representation of a loop winding around its own branch point, and together
the entries generate the group. -/
theorem exists_localizedBranchCycles (D : RationalDeck P S G) [Finite G] (hP : P.Monic)
    (hdeg : 0 < P.natDegree) (hirr : Irreducible P)
    (hS : ∀ z ∉ (S : Set ℂ), (spec P z).Separable) {z₀ : ℂ} (hz₀ : z₀ ∉ (S : Set ℂ))
    (hcard : Nat.card G = P.natDegree)
    (e₀ : puncturedProj P S ⁻¹' {(⟨z₀, hz₀⟩ : ↥((S : Set ℂ)ᶜ))}) :
    ∃ (γ : ℂ → FundamentalGroup ↥((S : Set ℂ)ᶜ) ⟨z₀, hz₀⟩) (g : ℂ → G),
      (∀ s ∈ (S : Set ℂ), IsPunctureLoop ((S : Set ℂ)ᶜ) s hz₀ (γ s)) ∧
        (∀ s, g s = D.deckMonodromy hP hdeg hirr hS hz₀ hcard e₀ (γ s)) ∧
          Subgroup.closure (g '' (S : Set ℂ)) = ⊤ := by
  obtain ⟨γ, hγ, htop⟩ := exists_punctureLoops_compl S.finite_toSet (z₀ := z₀) hz₀
  refine ⟨γ, fun s => D.deckMonodromy hP hdeg hirr hS hz₀ hcard e₀ (γ s), hγ, fun _ => rfl, ?_⟩
  rw [show (fun s => D.deckMonodromy hP hdeg hirr hS hz₀ hcard e₀ (γ s)) '' (S : Set ℂ)
      = (D.deckMonodromy hP hdeg hirr hS hz₀ hcard e₀) '' (γ '' (S : Set ℂ)) from
    (Set.image_image _ _ _).symm]
  exact closure_image_eq_top (D.surjective_deckMonodromy hP hdeg hirr hS hz₀ hcard e₀) htop

/-- **A loop around a parameter at which the family stays separable acts trivially on the group of
formulas.** -/
theorem deckMonodromy_eq_one_of_isPunctureLoop (D : RationalDeck P S G) [Finite G] (hP : P.Monic)
    (hdeg : 0 < P.natDegree) (hirr : Irreducible P)
    (hS : ∀ z ∉ (S : Set ℂ), (spec P z).Separable) {z₀ : ℂ} (hz₀ : z₀ ∉ (S : Set ℂ))
    (hcard : Nat.card G = P.natDegree)
    (e₀ : puncturedProj P S ⁻¹' {(⟨z₀, hz₀⟩ : ↥((S : Set ℂ)ᶜ))}) {s : ℂ}
    (hsep : (spec P s).Separable) {γ : FundamentalGroup ↥((S : Set ℂ)ᶜ) ⟨z₀, hz₀⟩}
    (hγ : IsPunctureLoop ((S : Set ℂ)ᶜ) s hz₀ γ) :
    D.deckMonodromy hP hdeg hirr hS hz₀ hcard e₀ γ = 1 := by
  have h : (monodromyHom hP hS hz₀).rangeRestrict γ = 1 :=
    Subtype.ext (monodromyHom_eq_one_of_isPunctureLoop hP hS hz₀ hsep hγ)
  show (D.monodromyEquiv hP hdeg hirr hS hz₀ hcard e₀ : _ →* G)
    ((monodromyHom hP hS hz₀).rangeRestrict γ) = 1
  rw [h, map_one]

/-- **A branch-cycle system indexed by the genuine branch points.**  Only the parameters at which
the family acquires a repeated root are needed: one element of the group for each of them, each the
monodromy of a loop winding around that parameter alone, and together they generate the group. -/
theorem exists_localizedBranchCycles_degen (D : RationalDeck P S G) [Finite G] (hP : P.Monic)
    (hdeg : 0 < P.natDegree) (hirr : Irreducible P)
    (hS : ∀ z ∉ (S : Set ℂ), (spec P z).Separable) {z₀ : ℂ} (hz₀ : z₀ ∉ (S : Set ℂ))
    (hcard : Nat.card G = P.natDegree)
    (e₀ : puncturedProj P S ⁻¹' {(⟨z₀, hz₀⟩ : ↥((S : Set ℂ)ᶜ))}) :
    ∃ (γ : ℂ → FundamentalGroup ↥((S : Set ℂ)ᶜ) ⟨z₀, hz₀⟩) (g : ℂ → G),
      (∀ s ∈ degenLocus P, IsPunctureLoop ((S : Set ℂ)ᶜ) s hz₀ (γ s)) ∧
        (∀ s, g s = D.deckMonodromy hP hdeg hirr hS hz₀ hcard e₀ (γ s)) ∧
          Subgroup.closure (g '' degenLocus P) = ⊤ := by
  classical
  obtain ⟨γ, hγ, htop⟩ := exists_punctureLoops_compl S.finite_toSet (z₀ := z₀) hz₀
  have hdsub : degenLocus P ⊆ (S : Set ℂ) := degenLocus_subset hS
  set f := D.deckMonodromy hP hdeg hirr hS hz₀ hcard e₀ with hfdef
  have hfull : Subgroup.closure ((fun s => f (γ s)) '' (S : Set ℂ)) = ⊤ := by
    rw [show (fun s => f (γ s)) '' (S : Set ℂ) = f '' (γ '' (S : Set ℂ)) from
      (Set.image_image _ _ _).symm]
    exact closure_image_eq_top (D.surjective_deckMonodromy hP hdeg hirr hS hz₀ hcard e₀) htop
  refine ⟨γ, fun s => f (γ s), fun s hs => hγ s (hdsub hs), fun _ => rfl, ?_⟩
  rw [← hfull]
  refine le_antisymm (Subgroup.closure_mono (Set.image_mono hdsub)) ((Subgroup.closure_le _).2 ?_)
  rintro y ⟨s, hs, rfl⟩
  by_cases hsd : s ∈ degenLocus P
  · exact Subgroup.subset_closure ⟨s, hsd, rfl⟩
  · show f (γ s) ∈ Subgroup.closure _
    rw [show f (γ s) = 1 from D.deckMonodromy_eq_one_of_isPunctureLoop hP hdeg hirr hS hz₀ hcard e₀
      (separable_of_notMem_degenLocus hsd) (hγ s hs)]
    exact one_mem _

/-- **An irreducible complex family carrying a group of root formulas of the right size has a
branch-cycle system indexed by its branch points**: one element of the group for each parameter in
the exceptional set, each of them the monodromy of a loop winding around that parameter alone, and
together they generate the group. -/
theorem exists_localizedBranchCycles' (D : RationalDeck P S G) [Finite G] (hP : P.Monic)
    (hdeg : 0 < P.natDegree) (hirr : Irreducible P)
    (hS : ∀ z ∉ (S : Set ℂ), (spec P z).Separable) {z₀ : ℂ} (hz₀ : z₀ ∉ (S : Set ℂ))
    (hcard : Nat.card G = P.natDegree) :
    ∃ (x : ℂ → Equiv.Perm (puncturedProj P S ⁻¹' {(⟨z₀, hz₀⟩ : ↥((S : Set ℂ)ᶜ))}))
      (g : ℂ → G) (f : ↥(monodromyHom hP hS hz₀).range ≃* G),
      (∀ s ∈ (S : Set ℂ), IsLocalMonodromy hP hS hz₀ s (x s)) ∧
        (∀ s ∈ (S : Set ℂ), ∃ h : x s ∈ (monodromyHom hP hS hz₀).range, g s = f ⟨x s, h⟩) ∧
          Subgroup.closure (g '' (S : Set ℂ)) = ⊤ := by
  have hpos : 0 < Nat.card (puncturedProj P S ⁻¹' {(⟨z₀, hz₀⟩ : ↥((S : Set ℂ)ᶜ))}) := by
    rw [card_puncturedFiber hP hS hz₀]; exact hdeg
  obtain ⟨e₀⟩ := (Nat.card_pos_iff.mp hpos).1
  obtain ⟨γ, g, hγ, hg, htop⟩ :=
    D.exists_localizedBranchCycles hP hdeg hirr hS hz₀ hcard e₀
  refine ⟨fun s => monodromyHom hP hS hz₀ (γ s), g,
    D.monodromyEquiv hP hdeg hirr hS hz₀ hcard e₀, fun s hs => ⟨γ s, hγ s hs, rfl⟩,
    fun s _ => ⟨⟨γ s, rfl⟩, ?_⟩, htop⟩
  rw [hg s]
  rfl

end RationalDeck

end Analytic

end Rigidity.RET

