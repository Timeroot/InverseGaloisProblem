/-!
# The arithmetic fundamental-group tower and its geometric presentation

This module produces a `GeomTower G cert` from a rigidity certificate and a geometric Galois cover:
the geometric side of the branch-cycle descent datum — the arithmetic fundamental-group tower
`N ⊴ E`, the geometric monodromy `φ : N ↠ G`, and its geometric presentation
`pres : SphereGroup r ↠ N` realizing `φ` as the sphere hom of the certificate's rigid tuple.

## The field tower and the fundamental exact sequence

From the geometric cover `L/ℚ̄(T)` with `Gal(L/ℚ̄(T)) ≃* G`, one builds a finite extension `Ω` Galois
over `ℚ(T)` and containing `L`, giving

  `1 → N → E → Γ₀ → 1`,   `N = Gal(Ω/geomBase)`,  `E = Gal(Ω/ℚ(T))`,  `Γ₀ = Gal(k₀/ℚ)`.

The tower is finite: `geomBase` is realized as `k₀(T)` where `k₀ = algebraicClosure ℚ Ω` is a number
field (the field of constants of `Ω`), `N = Gal(Ω/k₀(T))`, and `E/N ≃ Gal(k₀/ℚ)` is finite.  This is
Mathlib-expressible field theory (`IsGalois`, `IntermediateField`, `RatFunc`), with the descent of
the cover to a `ℚ(T)`-model as its arithmetic-geometry input.

## The geometric presentation and the tame inertia data

The geometric fundamental group of `ℙ¹ ∖ {r points}` over `ℚ̄` is (pro-)generated by the `r` branch
cycles with the single product-one relation, giving `pres : SphereGroup r ↠ N` with `φ ∘ pres` the
sphere hom of the certificate's rigid tuple.  On the geometric group `N` of the cover branched over
the `r` points with monodromy `base`, this refines to the **tame inertia data**: inertia generators
`gᵢ ∈ N` (one per branch point) generating `N`, satisfying the product-one relation, realizing
`φ (gᵢ) = baseᵢ`, together with the action of `E` on them through the cyclotomic character (Fried's
branch-cycle formula).  The intermediate carrier `CycloBranchData` records these generators together
with the cyclotomic character `E →* (ZMod M)ˣ` and the conjugation formula
`e · gᵢ · e⁻¹ ∼_N gᵢ ^ χ(e)`.

## Main results

* `ArithmeticModel` — the arithmetic field tower without the presentation.
* `arithmeticModel_exists` — the descent of the cover to a `ℚ(T)`-model.
* `CycloBranchData` / `CycloBranchData.toTameInertiaData` — the tame inertia generators of `N` with
  their cyclotomic character action, and their repackaging as `TameInertiaData`.
* `InertiaPlaceData` / `InertiaPlaceData.toInertiaRootData` — the branch cycles as inertia elements
  at places of the integral model `ℚ[X] ⊆ B = integralClosure ℚ[X] Ω`, and Fried's branch-cycle
  formula derived for them from tame ramification in residue characteristic zero.
* `tameInertiaModel_exists` — an arithmetic model whose geometric group `N` carries the tame inertia
  data for `base`.
* `geomTower_nonempty` — a `GeomTower G cert` exists.
-/

open Polynomial

open Rigidity.RET.Descent


/-- The arithmetic field tower, without the geometric presentation.

`GeomTower` stripped of the presentation data (`pres`/`surjPres`/`base`/`base_mem`/`φ_pres`): the
finite Galois field tower `ℚ(T) ⊂ k₀(T) ⊂ Ω` (`k₀ = algebraicClosure ℚ Ω`, a number field), the
arithmetic fundamental-group tower `N ⊴ E` with its field realization (`galE`, `geomBase`,
`galN_iff`, `const_le_geomBase`), and the geometric monodromy `φ : N ↠ G` (surjective — the cover is
connected with deck group `G`). -/
structure ArithmeticModel (G : Type) [Group G] [Finite G] where
  /-- the arithmetic fundamental group `E = Gal(Ω/ℚ(T))`. -/
  E : Type
  [groupE : Group E]
  /-- the geometric fundamental group `N = Gal(Ω/k₀(T)) ⊴ E`. -/
  N : Subgroup E
  [normalN : N.Normal]
  /-- the geometric monodromy `φ : N →* G`. -/
  φ : N →* G
  /-- the geometric monodromy is surjective (the cover is connected with deck group `G`). -/
  surjφ : Function.Surjective φ
  /-- the top field `Ω` of the tower — a finite Galois extension of `ℚ(T)`. -/
  Ω : Type
  [fieldΩ : Field Ω]
  [algΩ : Algebra (RatFunc ℚ) Ω]
  [findimΩ : FiniteDimensional (RatFunc ℚ) Ω]
  [galΩ : IsGalois (RatFunc ℚ) Ω]
  [charZeroΩ : CharZero Ω]
  [towerΩ : IsScalarTower ℚ (RatFunc ℚ) Ω]
  /-- `E` is the Galois group `Gal(Ω/ℚ(T))`. -/
  galE : E ≃* (Ω ≃ₐ[RatFunc ℚ] Ω)
  /-- the geometric base `k₀(T)` realized as an intermediate field of `Ω/ℚ(T)`. -/
  geomBase : IntermediateField (RatFunc ℚ) Ω
  /-- `N = Gal(Ω/k₀(T))`: under `galE`, `N` is exactly the fixing subgroup of `geomBase`. -/
  galN_iff : ∀ n : E, n ∈ N ↔ galE n ∈ geomBase.fixingSubgroup
  /-- the geometric base contains all constants: `algebraicClosure ℚ Ω ⊆ geomBase = k₀(T)`. -/
  const_le_geomBase : algebraicClosure ℚ Ω ≤ geomBase.restrictScalars ℚ
  /-- the geometric base is generated by the constants: `geomBase ⊆ k₀(T) = constFieldBase Ω`.
  Together with `const_le_geomBase` this pins `geomBase` to the constant-field base. -/
  geomBase_le_constFieldBase : geomBase ≤ constFieldBase Ω

attribute [instance] ArithmeticModel.groupE ArithmeticModel.normalN ArithmeticModel.fieldΩ
  ArithmeticModel.algΩ ArithmeticModel.findimΩ ArithmeticModel.galΩ ArithmeticModel.charZeroΩ
  ArithmeticModel.towerΩ

namespace ArithmeticModel

/-- **The model with the monodromy conjugated.**  Nothing in the arithmetic tower other than `φ`
mentions the identification of the deck group with `G` — the only property of `φ` the tower records
is surjectivity — so composing `φ` with an inner automorphism of `G` again gives an arithmetic
model, on the very same field tower. -/
def conj {G : Type} [Group G] [Finite G] (m : ArithmeticModel G) (c : G) : ArithmeticModel G :=
  { m with
    φ := (MulAut.conj c).toMonoidHom.comp m.φ
    surjφ := (MulAut.conj c).surjective.comp m.surjφ }

@[simp] theorem conj_φ {G : Type} [Group G] [Finite G] (m : ArithmeticModel G) (c : G) (n : m.N) :
    (m.conj c).φ n = c * m.φ n * c⁻¹ := rfl

@[simp] theorem conj_N {G : Type} [Group G] [Finite G] (m : ArithmeticModel G) (c : G) :
    (m.conj c).N = m.N := rfl

@[simp] theorem conj_galE {G : Type} [Group G] [Finite G] (m : ArithmeticModel G) (c : G) :
    (m.conj c).galE = m.galE := rfl

end ArithmeticModel

/-- The field-theoretic form of the geometric model, before the group-theoretic packaging into an
`ArithmeticModel`: the descended finite Galois extension `Ω/ℚ(T)` together with

* the geometric base `geomBase = k₀(T)` as an intermediate field, **normal** over `ℚ(T)` (because the
  constant field `k₀` is normal over `ℚ`);
* the geometric monodromy `galGeom : Gal(Ω/geomBase) ↠ G` — a **surjection** of the geometric Galois
  group onto the deck group `G` (equivalently, `G` is a quotient of the geometric fundamental group;
  the cover realized by the arithmetic Galois closure need not be *minimal*, so this is a surjection,
  not an isomorphism — which is all the descent needs, since Module D carves out `G` as a quotient via
  `quotientKerEquivOfSurjective`).  Only surjectivity is used downstream, and only surjectivity is
  achievable while keeping `Ω/ℚ(T)` Galois with `geomBase` normal (an *isomorphism* would require the
  cover to be defined over its field of moduli — the very descent obstruction Module C handles);
* `const_le_geomBase` — all constants of `Ω` lie in `geomBase`.

An inhabitant is produced by `geomModel_exists`; `toArithmeticModel` gives its group-tower form. -/
structure GeomModel (G : Type) [Group G] [Finite G] where
  /-- the descended top field `Ω`, finite Galois over `ℚ(T)`. -/
  Ω : Type
  [fieldΩ : Field Ω]
  [algΩ : Algebra (RatFunc ℚ) Ω]
  [findimΩ : FiniteDimensional (RatFunc ℚ) Ω]
  [galΩ : IsGalois (RatFunc ℚ) Ω]
  [charZeroΩ : CharZero Ω]
  [towerΩ : IsScalarTower ℚ (RatFunc ℚ) Ω]
  /-- the geometric base `k₀(T)` as an intermediate field of `Ω/ℚ(T)`. -/
  geomBase : IntermediateField (RatFunc ℚ) Ω
  /-- `geomBase = k₀(T)` is normal over `ℚ(T)` (the constant field `k₀/ℚ` is Galois). -/
  [normalGeomBase : Normal (RatFunc ℚ) geomBase]
  /-- the geometric monodromy: `Gal(Ω/geomBase)` surjects onto the deck group `G` (`G` is a quotient
  of the geometric Galois group; see the structure docstring for why a surjection, not an iso). -/
  galGeom : (Ω ≃ₐ[geomBase] Ω) →* G
  /-- the geometric monodromy is surjective. -/
  surjGalGeom : Function.Surjective galGeom
  /-- the geometric base contains all constants: `algebraicClosure ℚ Ω ⊆ geomBase = k₀(T)`. -/
  const_le_geomBase : algebraicClosure ℚ Ω ≤ geomBase.restrictScalars ℚ
  /-- the geometric base is generated by the constants: `geomBase ⊆ k₀(T) = constFieldBase Ω`. -/
  geomBase_le_constFieldBase : geomBase ≤ constFieldBase Ω

attribute [instance] GeomModel.fieldΩ GeomModel.algΩ GeomModel.findimΩ GeomModel.galΩ
  GeomModel.charZeroΩ GeomModel.towerΩ GeomModel.normalGeomBase

/-- The Galois-correspondence packaging of a geometric model as an `ArithmeticModel`: take
`E = Gal(Ω/ℚ(T))`, `N = geomBase.fixingSubgroup`; then

* `N` is **normal** because it is the kernel of the restriction map `Gal(Ω/ℚ(T)) → Gal(geomBase/ℚ(T))`
  (`IntermediateField.restrictNormalHom_ker`, valid since `geomBase/ℚ(T)` is normal);
* the monodromy `φ : N ↠ G` is `galGeom ∘ fixingSubgroupEquiv` — `N = fixingSubgroup geomBase ≃*
  Gal(Ω/geomBase) ≃* G` — a composite of isomorphisms, hence surjective;
* `galE` is the identity `E = Gal(Ω/ℚ(T))`, so `galN_iff` is definitional. -/
noncomputable def GeomModel.toArithmeticModel {G : Type} [Group G] [Finite G]
    (m : GeomModel G) : ArithmeticModel G where
  E := m.Ω ≃ₐ[RatFunc ℚ] m.Ω
  groupE := inferInstance
  N := m.geomBase.fixingSubgroup
  normalN := by
    haveI := m.normalGeomBase
    haveI : Normal (RatFunc ℚ) m.Ω := m.galΩ.to_normal
    rw [← IntermediateField.restrictNormalHom_ker m.geomBase]
    exact MonoidHom.normal_ker _
  φ := m.galGeom.comp (IntermediateField.fixingSubgroupEquiv m.geomBase).toMonoidHom
  surjφ := by
    have h := m.surjGalGeom.comp
      (IntermediateField.fixingSubgroupEquiv m.geomBase).surjective
    simpa [MonoidHom.coe_comp] using h
  Ω := m.Ω
  fieldΩ := m.fieldΩ
  algΩ := m.algΩ
  findimΩ := m.findimΩ
  galΩ := m.galΩ
  charZeroΩ := m.charZeroΩ
  towerΩ := m.towerΩ
  galE := MulEquiv.refl _
  geomBase := m.geomBase
  galN_iff := fun _ => Iff.rfl
  const_le_geomBase := m.const_le_geomBase
  geomBase_le_constFieldBase := m.geomBase_le_constFieldBase

/-- From a geometric Galois cover `L/ℚ̄(T)` with deck group `G`, a geometric model exists: a finite
Galois extension `Ω/ℚ(T)` whose constant field is a number field `k₀ = geomBase`, with
`Gal(Ω/k₀(T)) ↠ G`.  The descent of the cover to a finite `ℚ(T)`-model is `geomModel_descent`; the
constant-field base and its normality are read off via `constFieldBase`, `constFieldBase_normal`,
`const_le_constFieldBase`. -/
noncomputable def geomModel_exists {G : Type} [Group G] [Finite G]
    (cover : IsGeometricGaloisCover G) : Nonempty (GeomModel G) := by
  obtain ⟨Ω, _fΩ, _algΩ, _findimΩ, _galΩ, _charΩ, _towerΩ, f, hf⟩ := geomModel_descent cover
  exact ⟨{ Ω := Ω
           geomBase := constFieldBase Ω
           galGeom := f
           surjGalGeom := hf
           normalGeomBase := constFieldBase_normal Ω
           const_le_geomBase := const_le_constFieldBase Ω
           geomBase_le_constFieldBase := le_rfl }⟩

/-- The arithmetic model exists — the group-tower form of the geometric model, via
`GeomModel.toArithmeticModel`. -/
noncomputable def arithmeticModel_exists {G : Type} [Group G] [Finite G]
    (cover : IsGeometricGaloisCover G) : Nonempty (ArithmeticModel G) :=
  (geomModel_exists cover).map GeomModel.toArithmeticModel

/-- The geometric group `N` of an arithmetic model fixes every element of `Ω` algebraic over `ℚ`:
such an element is a constant, and the geometric base `k₀(T)` contains all constants. -/
theorem galE_fix_of_isAlgebraic {G : Type} [Group G] [Finite G] (m : ArithmeticModel G) {x : m.Ω}
    (hx : IsAlgebraic ℚ x) (n : m.N) : m.galE (n : m.E) x = x := by
  have hmem : x ∈ m.geomBase := by
    have := m.const_le_geomBase (mem_algebraicClosure_iff.mpr hx)
    simpa using this
  have hfix := (m.galN_iff (n : m.E)).mp n.2
  simp only [IntermediateField.mem_fixingSubgroup_iff] at hfix
  exact hfix x hmem

/-- The geometric group `N` fixes every root of unity of `Ω`. -/
theorem galE_fix_of_pow_eq_one {G : Type} [Group G] [Finite G] (m : ArithmeticModel G) {x : m.Ω}
    {M : ℕ} (hM : M ≠ 0) (hx : x ^ M = 1) (n : m.N) : m.galE (n : m.E) x = x := by
  refine galE_fix_of_isAlgebraic m ⟨X ^ M - 1, ?_, ?_⟩ n
  · intro h
    have h0 : (X ^ M - 1 : ℚ[X]).coeff 0 = 0 := by rw [h]; simp
    rcases Nat.eq_zero_or_pos M with hM0 | hM0
    · exact hM hM0
    · rw [coeff_sub, coeff_one_zero, coeff_X_pow, if_neg (by omega)] at h0
      simp at h0
  · simp [hx]

/-- **The tame inertia generators of `N` with the cyclotomic character action.**

For an arithmetic model `m` and the certificate's rigid generating product-one tuple `base`, this
bundles the geometric inertia generators `gᵢ ∈ N` (one per branch point) with:

* `gen_top`, `gen_prod`, `φ_gen` — the presentation content: the `gᵢ` generate `N`, satisfy the
  product-one sphere relation, and realize the monodromy `φ (gᵢ) = baseᵢ`;
* `rootOrder` `M` with `rootOrder_pos` and `order_dvd` — a modulus `M > 0` divisible by every inertia
  generator's order `orderOf gᵢ` (the number of roots of unity through which the tame inertia is read);
* `cycloChar : E →* (ZMod M)ˣ` — the cyclotomic character of the arithmetic Galois group `E`;
* `conj_pow` — for each `e : E` and branch point `i`, conjugation by `e` carries `gᵢ` to an
  `N`-conjugate of `gᵢ ^ χ(e)`, where the exponent is `(cycloChar e).val`.

`orderOf gᵢ` is the ramification index at branch point `i`; that `E` acts on the tame inertia through
`χ` is Fried's branch-cycle formula, here recorded through the explicit cyclotomic character
`cycloChar` valued in the units of `ZMod M`. -/
structure CycloBranchData {G : Type} [Group G] [Finite G] {cert : RigidData G}
    (m : ArithmeticModel G) (base : Fin cert.r → G) (hbase : base ∈ rigidTuples cert.C) where
  /-- the tame inertia generators: one element of `N` per branch point. -/
  gen : Fin cert.r → m.N
  /-- the inertia generators generate `N` (the cover is connected). -/
  gen_top : Subgroup.closure (Set.range gen) = ⊤
  /-- the product-one sphere relation `g₀ ⋯ g_{r-1} = 1`. -/
  gen_prod : (List.ofFn gen).prod = 1
  /-- `φ` realizes the certificate's monodromy: `φ (gᵢ) = baseᵢ`. -/
  φ_gen : ∀ i, m.φ (gen i) = base i
  /-- the modulus through which the tame inertia is read (the number of relevant roots of unity). -/
  rootOrder : ℕ
  /-- the modulus is positive. -/
  rootOrder_pos : 0 < rootOrder
  /-- each inertia generator's order (the ramification index at that branch point) divides the
  modulus. -/
  order_dvd : ∀ i, orderOf (gen i) ∣ rootOrder
  /-- the cyclotomic character of the arithmetic Galois group `E`, valued in the units of `ZMod M`. -/
  cycloChar : m.E →* (ZMod rootOrder)ˣ
  /-- the geometric group is trivial on the cyclotomic character: roots of unity are constants, and
  the geometric base contains all constants. -/
  cycloChar_N : ∀ n : m.N, cycloChar (n : m.E) = 1
  /-- **Fried's branch cycle, at its geometric source.**  For each `e : E` and branch point `i`,
  conjugation by `e` carries `gᵢ` to an `N`-conjugate of `gᵢ ^ χ(e)`, the exponent being
  `(cycloChar e).val`. -/
  conj_pow : ∀ (e : m.E) (i : Fin cert.r),
    IsConj (Rigidity.RET.conjN m.N e (gen i)) ((gen i) ^ ((cycloChar e : ZMod rootOrder).val))

/-- **The tame inertia data from the cyclotomic branch data.**

The `TameInertiaData` fields `gen`, `gen_top`, `gen_prod`, `φ_gen` are carried over directly; the
`cyclo_conj` field is assembled from the cyclotomic character with exponent `k = (cycloChar e).val`:

* **Coprimality** — `(cycloChar e).val` is coprime to the modulus `rootOrder`
  (`ZMod.val_coe_unit_coprime`, a unit's value is coprime to the modulus), and `orderOf gᵢ` divides
  `rootOrder` (`order_dvd`), so coprimality is inherited by the divisor.
* **The conjugation formula** is the `conj_pow` field verbatim. -/
def CycloBranchData.toTameInertiaData {G : Type} [Group G] [Finite G]
    {cert : RigidData G} {m : ArithmeticModel G} {base : Fin cert.r → G}
    {hbase : base ∈ rigidTuples cert.C} (d : CycloBranchData m base hbase) :
    Rigidity.RET.TameInertiaData m.N m.φ base hbase where
  gen := d.gen
  gen_top := d.gen_top
  gen_prod := d.gen_prod
  φ_gen := d.φ_gen
  cyclo_conj := by
    intro e
    refine ⟨(d.cycloChar e : ZMod d.rootOrder).val, fun i => ?_, fun i => d.conj_pow e i⟩
    exact (ZMod.val_coe_unit_coprime (d.cycloChar e)).coprime_dvd_right (d.order_dvd i)

/-- **The tame inertia generators of `N` with a primitive root of unity witnessing the cyclotomic
action.**

For an arithmetic model `m` and the certificate's rigid generating product-one tuple `base`, this
bundles the geometric inertia generators `gᵢ ∈ N` (one per branch point) with:

* `gen_top`, `gen_prod`, `φ_gen` — the `gᵢ` generate `N`, satisfy the product-one sphere relation and
  realize the monodromy `φ (gᵢ) = baseᵢ`;
* `rootOrder` `M` (nonzero) with `order_dvd` — a modulus divisible by every inertia generator's order;
* `root` with `isRoot : IsPrimitiveRoot root M` — a primitive `M`-th root of unity in `Ω`, through
  which the tame inertia is read;
* `conj_pow_root` — for each `e : E` and branch point `i`, conjugation by `e` carries `gᵢ` to an
  `N`-conjugate of `gᵢ ^ χ(e)`, the exponent `χ(e)` being the power to which `e` raises the root of
  unity (`IsPrimitiveRoot.autToPow`, the cyclotomic action of `E` on `root`).

`orderOf gᵢ` is the ramification index at branch point `i`; that `E` acts on the tame inertia by
raising the inertia generators to the cyclotomic power is Fried's branch-cycle formula, recorded here
directly through the action of `E` on the primitive root of unity `root`. -/
structure InertiaRootData {G : Type} [Group G] [Finite G] {cert : RigidData G}
    (m : ArithmeticModel G) (base : Fin cert.r → G) (hbase : base ∈ rigidTuples cert.C) where
  /-- the tame inertia generators: one element of `N` per branch point. -/
  gen : Fin cert.r → m.N
  /-- the inertia generators generate `N` (the cover is connected). -/
  gen_top : Subgroup.closure (Set.range gen) = ⊤
  /-- the product-one sphere relation `g₀ ⋯ g_{r-1} = 1`. -/
  gen_prod : (List.ofFn gen).prod = 1
  /-- `φ` realizes the certificate's monodromy: `φ (gᵢ) = baseᵢ`. -/
  φ_gen : ∀ i, m.φ (gen i) = base i
  /-- the modulus through which the tame inertia is read (the number of relevant roots of unity). -/
  rootOrder : ℕ
  /-- the modulus is nonzero. -/
  [rootOrder_neZero : NeZero rootOrder]
  /-- each inertia generator's order (the ramification index at that branch point) divides the
  modulus. -/
  order_dvd : ∀ i, orderOf (gen i) ∣ rootOrder
  /-- a primitive `rootOrder`-th root of unity in `Ω`. -/
  root : m.Ω
  /-- `root` is a primitive `rootOrder`-th root of unity. -/
  isRoot : IsPrimitiveRoot root rootOrder
  /-- **Fried's branch cycle, at its geometric source.**  For each `e : E` and branch point `i`,
  conjugation by `e` carries `gᵢ` to an `N`-conjugate of `gᵢ ^ χ(e)`, where `χ(e)` is the power to
  which `e` raises the primitive root of unity `root`. -/
  conj_pow_root : ∀ (e : m.E) (i : Fin cert.r),
    IsConj (Rigidity.RET.conjN m.N e (gen i))
      ((gen i) ^ ((isRoot.autToPow (RatFunc ℚ) (m.galE e) : ZMod rootOrder).val))

attribute [instance] InertiaRootData.rootOrder_neZero

/-- **The cyclotomic branch data from a primitive-root inertia realization.**

The presentation content (`gen`, `gen_top`, `gen_prod`, `φ_gen`, `rootOrder`, `order_dvd`) is carried
over directly.  The cyclotomic character is realized concretely as the action of `E` on the primitive
root of unity `root`: `cycloChar = (autToPow ∘ galE)`, `e ↦ (the power to which e raises root)`
(`IsPrimitiveRoot.autToPow`).  The conjugation formula is `conj_pow_root`, whose exponent is exactly
`(cycloChar e).val` by construction. -/
noncomputable def InertiaRootData.toCycloBranchData {G : Type} [Group G] [Finite G]
    {cert : RigidData G} {m : ArithmeticModel G} {base : Fin cert.r → G}
    {hbase : base ∈ rigidTuples cert.C} (d : InertiaRootData m base hbase) :
    CycloBranchData m base hbase where
  gen := d.gen
  gen_top := d.gen_top
  gen_prod := d.gen_prod
  φ_gen := d.φ_gen
  rootOrder := d.rootOrder
  rootOrder_pos := Nat.pos_of_ne_zero d.rootOrder_neZero.out
  order_dvd := d.order_dvd
  cycloChar := (d.isRoot.autToPow (RatFunc ℚ)).comp m.galE.toMonoidHom
  cycloChar_N := by
    intro n
    -- `n` fixes the root of unity, so it raises it to the first power.
    have hfix : m.galE (n : m.E) d.root = d.root :=
      galE_fix_of_pow_eq_one m d.rootOrder_neZero.out d.isRoot.pow_eq_one n
    have hspec := d.isRoot.autToPow_spec (RatFunc ℚ) (m.galE (n : m.E))
    rw [hfix] at hspec
    have hmod : (d.isRoot.autToPow (RatFunc ℚ) (m.galE (n : m.E)) : ZMod d.rootOrder).val
        ≡ 1 [MOD d.rootOrder] := by
      have hfin : IsOfFinOrder d.root :=
        isOfFinOrder_iff_pow_eq_one.mpr
          ⟨d.rootOrder, Nat.pos_of_ne_zero d.rootOrder_neZero.out, d.isRoot.pow_eq_one⟩
      have := hspec.trans (pow_one d.root).symm
      rwa [hfin.pow_eq_pow_iff_modEq, ← d.isRoot.eq_orderOf] at this
    refine Units.ext ?_
    show ((d.isRoot.autToPow (RatFunc ℚ)) (m.galE (n : m.E)) : ZMod d.rootOrder) = 1
    have hcast : (((d.isRoot.autToPow (RatFunc ℚ) (m.galE (n : m.E)) : ZMod d.rootOrder).val : ℕ) :
        ZMod d.rootOrder) = ((1 : ℕ) : ZMod d.rootOrder) :=
      (ZMod.natCast_eq_natCast_iff _ _ _).mpr hmod
    simpa using hcast
  conj_pow := d.conj_pow_root

/-! ## The branch cycles as inertia at the places of the arithmetic integral model

`InertiaRootData` asks for the branch cycles together with Fried's formula
`e gᵢ e⁻¹ ∼_N gᵢ ^ χ(e)`.  That formula need not be assumed: it is a theorem once the branch cycles
are known to be honest **inertia elements at places of the integral model**
`ℚ[X] ⊆ B = integralClosure ℚ[X] Ω`, with the geometric group `N` acting transitively on the places
above each branch point.  `InertiaPlaceData` records exactly that, and
`InertiaPlaceData.toInertiaRootData` derives Fried's formula from tame ramification in residue
characteristic zero (`ArithAKLB.conj_eq_pow_of_apply_root`). -/

section InertiaPlaces

open scoped Pointwise

/-- `ℚ[X]` acts on a `ℚ(T)`-algebra through `ℚ(T)`. -/
noncomputable def polyAlgebra (Ω : Type) [Field Ω] [Algebra (RatFunc ℚ) Ω] :
    Algebra (Polynomial ℚ) Ω :=
  ((algebraMap (RatFunc ℚ) Ω).comp (algebraMap (Polynomial ℚ) (RatFunc ℚ))).toAlgebra

-- low priority: for `Ω = ℚ(T)` itself the canonical `ℚ[X]`-algebra structure must win
attribute [local instance 100] polyAlgebra

/-- `ℚ[X] ⊆ ℚ(T) ⊆ Ω` is a tower. -/
theorem polyAlgebra_tower (Ω : Type) [Field Ω] [Algebra (RatFunc ℚ) Ω] :
    IsScalarTower (Polynomial ℚ) (RatFunc ℚ) Ω :=
  IsScalarTower.of_algebraMap_eq (R := Polynomial ℚ) (S := RatFunc ℚ) (A := Ω) fun _ => rfl

attribute [local instance] polyAlgebra_tower ArithAKLB.instMSA ArithAKLB.instIsFrac
  ArithAKLB.instIGG ArithAKLB.instFinite ArithAKLB.instIntegral ArithAKLB.instFaithfulBase
  ArithAKLB.instDedekind ArithAKLB.instFiniteGal ArithAKLB.instFaithfulGal ArithAKLB.instAlgRat

/-! ### Rational places of the line

The branch points of the rigidity method may be taken `ℚ`-rational, i.e. the places `X - t` of
`ℚ[X]` with residue field `ℚ`. -/

/-- The rational place `X - t` is a maximal ideal of `ℚ[X]` (the ring is a PID and `X - t` is
irreducible). -/
theorem isMaximal_span_X_sub_C (t : ℚ) :
    (Ideal.span {X - C t} : Ideal (Polynomial ℚ)).IsMaximal :=
  PrincipalIdealRing.isMaximal_of_irreducible (irreducible_X_sub_C t)

/-- The rational place `X - t` is a nonzero ideal of `ℚ[X]`. -/
theorem span_X_sub_C_ne_bot (t : ℚ) :
    (Ideal.span {X - C t} : Ideal (Polynomial ℚ)) ≠ ⊥ := fun h =>
  X_sub_C_ne_zero t (Ideal.span_singleton_eq_bot.1 h)

/-- The residue field of `ℚ[X]` at a rational place is `ℚ` itself: the structure map `ℚ → ℚ[X]/(X-t)`
is onto, its inverse being evaluation at `t`. -/
theorem surjective_algebraMap_quotient_X_sub_C (t : ℚ) :
    Function.Surjective
      (algebraMap ℚ (Polynomial ℚ ⧸ (Ideal.span {X - C t} : Ideal (Polynomial ℚ)))) := fun y =>
  ⟨Polynomial.quotientSpanXSubCAlgEquiv t y, by
    rw [← Polynomial.quotientSpanXSubCAlgEquiv_symm_apply t, AlgEquiv.symm_apply_apply]⟩

/-- **The geometric group acts transitively on the places above a rational place.**

For a place `Q` of the integral model above a place `P` of `ℚ[X]` with residue field `ℚ`, every
arithmetic automorphism `e` lies in the decomposition group of `Q` up to an element of the geometric
group `N`.

By `ArithAKLB.exists_stabilizer_eqOn_const` there is `d` stabilizing `Q` and agreeing with `e` on all
constants; then `e d⁻¹` fixes the constant-field base pointwise
(`mul_inv_mem_fixingSubgroup_constFieldBase`), hence fixes `geomBase` pointwise, so it is the image
of an element `n` of `N`, and `n⁻¹ e = d` stabilizes `Q`. -/
theorem exists_geom_stabilizer {G : Type} [Group G] [Finite G] (m : ArithmeticModel G)
    (P : Ideal (Polynomial ℚ)) [P.IsMaximal]
    (hP : Function.Surjective (algebraMap ℚ (Polynomial ℚ ⧸ P)))
    (Q : Ideal (ArithAKLB.Aring m.Ω)) [Q.IsMaximal] [Q.LiesOver P] (e : m.E) :
    ∃ n : m.N, (m.galE ((n : m.E)⁻¹ * e)) • Q = Q := by
  obtain ⟨d, hdQ, hd⟩ := ArithAKLB.exists_stabilizer_eqOn_const m.Ω P Q hP (m.galE e)
  have hfix : (m.galE e) * d⁻¹ ∈ m.geomBase.fixingSubgroup :=
    IntermediateField.fixingSubgroup_le m.geomBase_le_constFieldBase
      (mul_inv_mem_fixingSubgroup_constFieldBase m.Ω hd)
  refine ⟨⟨m.galE.symm ((m.galE e) * d⁻¹), (m.galN_iff _).2 ?_⟩, ?_⟩
  · rwa [MulEquiv.apply_symm_apply]
  · have hgal : m.galE ((m.galE.symm ((m.galE e) * d⁻¹) : m.E)⁻¹ * e) = d := by
      rw [map_mul, map_inv, MulEquiv.apply_symm_apply]
      group
    rw [hgal]
    exact hdQ

/-- **The branch cycles as inertia elements at places of the arithmetic integral model.**

Like `InertiaRootData`, but instead of postulating Fried's branch-cycle formula it records the
geometric source of that formula:

* `branch i` — the `i`-th branch point, a `ℚ`-rational point of the line;
* `place i` — a nonzero maximal ideal of `B = integralClosure ℚ[X] Ω`, a place of the cover above
  the `i`-th branch point (`place_liesOver`);
* `gen_inertia` — the branch cycle `gᵢ` is an inertia element at `place i`.

The remaining fields are those of `InertiaRootData` other than `conj_pow_root`.  Three properties
one might expect to see recorded are *not* assumed, because they follow from the ones that are: the
places are maximal (`InertiaPlaceData.place_max`) and nonzero (`InertiaPlaceData.place_ne_bot`),
the model being integral and torsion-free over `ℚ[X]`; and the geometric group `N` acts transitively
on the places above a branch point (`InertiaPlaceData.place_trans`), the branch points being
rational. -/
structure InertiaPlaceData {G : Type} [Group G] [Finite G] {cert : RigidData G}
    (m : ArithmeticModel G) (base : Fin cert.r → G) (hbase : base ∈ rigidTuples cert.C) where
  /-- the tame inertia generators: one element of `N` per branch point. -/
  gen : Fin cert.r → m.N
  /-- the inertia generators generate `N` (the cover is connected). -/
  gen_top : Subgroup.closure (Set.range gen) = ⊤
  /-- the product-one sphere relation `g₀ ⋯ g_{r-1} = 1`. -/
  gen_prod : (List.ofFn gen).prod = 1
  /-- `φ` realizes the certificate's monodromy: `φ (gᵢ) = baseᵢ`. -/
  φ_gen : ∀ i, m.φ (gen i) = base i
  /-- the modulus through which the tame inertia is read. -/
  rootOrder : ℕ
  /-- the modulus is nonzero. -/
  [rootOrder_neZero : NeZero rootOrder]
  /-- each inertia generator's order (the ramification index at that branch point) divides the
  modulus. -/
  order_dvd : ∀ i, orderOf (gen i) ∣ rootOrder
  /-- a primitive `rootOrder`-th root of unity in `Ω`. -/
  root : m.Ω
  /-- `root` is a primitive `rootOrder`-th root of unity. -/
  isRoot : IsPrimitiveRoot root rootOrder
  /-- the `i`-th branch point, a `ℚ`-rational point of the line. -/
  branch : Fin cert.r → ℚ
  /-- the place of the integral model above the `i`-th branch point. -/
  place : Fin cert.r → Ideal (ArithAKLB.Aring m.Ω)
  /-- the places are prime ideals. -/
  place_prime : ∀ i, (place i).IsPrime
  /-- `place i` lies over the rational place `X - branchᵢ` of the line. -/
  place_liesOver : ∀ i, (place i).LiesOver (Ideal.span {X - C (branch i)})
  /-- the branch cycle `gᵢ` is an inertia element at `place i`. -/
  gen_inertia : ∀ i, m.galE (gen i : m.E) ∈ (place i).inertia (m.Ω ≃ₐ[RatFunc ℚ] m.Ω)

attribute [instance] InertiaPlaceData.rootOrder_neZero

section PlaceProperties

variable {G : Type} [Group G] [Finite G] {cert : RigidData G} {m : ArithmeticModel G}
  {base : Fin cert.r → G} {hbase : base ∈ rigidTuples cert.C}

/-- **The places are maximal ideals.**  A prime of the integral model above the maximal ideal
`X - branchᵢ` of the line is maximal, the model being integral over `ℚ[X]`. -/
theorem InertiaPlaceData.place_max (d : InertiaPlaceData m base hbase) (i : Fin cert.r) :
    (d.place i).IsMaximal := by
  haveI := d.place_prime i
  haveI := d.place_liesOver i
  exact ArithAKLB.isMaximal_of_liesOver m.Ω (isMaximal_span_X_sub_C (d.branch i)) (d.place i)

/-- **The places are nonzero.**  They lie over the nonzero place `X - branchᵢ` of the line, and the
integral model is a torsion-free `ℚ[X]`-module. -/
theorem InertiaPlaceData.place_ne_bot (d : InertiaPlaceData m base hbase) (i : Fin cert.r) :
    d.place i ≠ ⊥ := by
  haveI := d.place_prime i
  haveI := d.place_liesOver i
  exact ArithAKLB.ne_bot_of_liesOver m.Ω (span_X_sub_C_ne_bot (d.branch i)) (d.place i)

end PlaceProperties

/-- **`N` acts transitively on the places above a branch point.**  The branch points are
`ℚ`-rational, so this is `exists_geom_stabilizer` at the place `X - branchᵢ`, whose residue field is
`ℚ` (`surjective_algebraMap_quotient_X_sub_C`). -/
theorem InertiaPlaceData.place_trans {G : Type} [Group G] [Finite G]
    {cert : RigidData G} {m : ArithmeticModel G} {base : Fin cert.r → G}
    {hbase : base ∈ rigidTuples cert.C} (d : InertiaPlaceData m base hbase)
    (i : Fin cert.r) (e : m.E) :
    ∃ n : m.N, (m.galE ((n : m.E)⁻¹ * e)) • d.place i = d.place i := by
  haveI := d.place_max i
  haveI := d.place_liesOver i
  haveI := isMaximal_span_X_sub_C (d.branch i)
  exact exists_geom_stabilizer m _ (surjective_algebraMap_quotient_X_sub_C (d.branch i))
    (d.place i) e

/-- **Fried's branch-cycle formula for inertia at the places of the integral model.**

The branch cycles of an `InertiaPlaceData` satisfy the cyclotomic conjugation relation, so they are
an `InertiaRootData`.

Fix `e : E` and a branch point `i`, and pick `n ∈ N` with `σ := n⁻¹ e` in the decomposition group of
`place i`.  Since `N` fixes the root of unity `root` (it is a constant, and the geometric base
contains all constants), `σ` raises `root` to the same power `χ(e)` as `e` does.  Tame inertia in
residue characteristic zero (`ArithAKLB.conj_eq_pow_of_apply_root`) then gives
`σ gᵢ σ⁻¹ = gᵢ ^ χ(e)` on the nose, and conjugating back by `n` turns this into the required
`N`-conjugacy. -/
def InertiaPlaceData.toInertiaRootData {G : Type} [Group G] [Finite G]
    {cert : RigidData G} {m : ArithmeticModel G} {base : Fin cert.r → G}
    {hbase : base ∈ rigidTuples cert.C} (d : InertiaPlaceData m base hbase) :
    InertiaRootData m base hbase where
  gen := d.gen
  gen_top := d.gen_top
  gen_prod := d.gen_prod
  φ_gen := d.φ_gen
  rootOrder := d.rootOrder
  order_dvd := d.order_dvd
  root := d.root
  isRoot := d.isRoot
  conj_pow_root := by
    intro e i
    haveI := d.place_max i
    set M := d.rootOrder with hM
    set c := ((d.isRoot.autToPow (RatFunc ℚ) (m.galE e) : ZMod M).val) with hc
    obtain ⟨n, hn⟩ := d.place_trans i e
    have hgpow : (m.galE (d.gen i : m.E)) ^ M = 1 := by
      have h1 : (d.gen i) ^ M = 1 := orderOf_dvd_iff_pow_eq_one.mp (d.order_dvd i)
      have h2 : ((d.gen i : m.E)) ^ M = 1 := by
        have := congrArg (fun x : m.N => (x : m.E)) h1
        simpa using this
      have := congrArg m.galE h2
      simpa using this
    have hgI : (⟨m.galE (d.gen i : m.E), d.gen_inertia i⟩ :
        (d.place i).inertia (m.Ω ≃ₐ[RatFunc ℚ] m.Ω)) ^ M = 1 := by
      apply Subtype.ext
      simpa using hgpow
    have hfix : ∀ x : m.N, m.galE (x : m.E) d.root = d.root := fun x =>
      galE_fix_of_pow_eq_one m (NeZero.ne M) d.isRoot.pow_eq_one x
    have hσroot : (m.galE ((n : m.E)⁻¹ * e)) d.root = d.root ^ c := by
      have he : (m.galE e) d.root = d.root ^ c :=
        (d.isRoot.autToPow_spec (RatFunc ℚ) (m.galE e)).symm
      have hninv : (m.galE (n : m.E))⁻¹ d.root = d.root := by
        have := hfix n⁻¹
        simpa using this
      rw [map_mul, map_inv]
      show (m.galE (n : m.E))⁻¹ ((m.galE e) d.root) = _
      rw [he, map_pow, hninv]
    have hmain := ArithAKLB.conj_eq_pow_of_apply_root m.Ω (d.place i) (d.place_ne_bot i) hn
      d.isRoot hσroot ⟨m.galE (d.gen i : m.E), d.gen_inertia i⟩ hgI
    refine ArithAKLB.isConj_conjN_of_conj_eq_pow m.N e n (d.gen i) ?_
    apply m.galE.injective
    simpa [map_mul, map_inv, map_pow] using hmain

/-- **The branch-cycle data of a descended cover, before matching against a tuple.**

`InertiaPlaceData` with the requirement `φ (gᵢ) = baseᵢ` — which names the certificate's chosen
tuple — replaced by the requirement that `φ (gᵢ)` merely lie in the prescribed class `Cᵢ`, which
names only the certificate's classes.  This is the form in which the geometry produces the data: a
branch cycle is a generator of the tame inertia group at a place over the `i`-th branch point, and
its class is the `i`-th prescribed class, but which of the conjugate tuples one lands on is not
under the geometry's control.  Rigidity supplies the missing conjugation
(`inertiaPlaceData_exists`). -/
structure ClassInertiaPlaceData {G : Type} [Group G] [Finite G] (cert : RigidData G)
    (m : ArithmeticModel G) where
  /-- the tame inertia generators: one element of `N` per branch point. -/
  gen : Fin cert.r → m.N
  /-- the inertia generators generate `N` (the cover is connected). -/
  gen_top : Subgroup.closure (Set.range gen) = ⊤
  /-- the product-one sphere relation `g₀ ⋯ g_{r-1} = 1`. -/
  gen_prod : (List.ofFn gen).prod = 1
  /-- the image of the `i`-th branch cycle lies in the `i`-th prescribed class. -/
  φ_class : ∀ i, ConjClasses.mk (m.φ (gen i)) = cert.C i
  /-- the modulus through which the tame inertia is read. -/
  rootOrder : ℕ
  /-- the modulus is nonzero. -/
  [rootOrder_neZero : NeZero rootOrder]
  /-- each inertia generator's order (the ramification index at that branch point) divides the
  modulus. -/
  order_dvd : ∀ i, orderOf (gen i) ∣ rootOrder
  /-- a primitive `rootOrder`-th root of unity in `Ω`. -/
  root : m.Ω
  /-- `root` is a primitive `rootOrder`-th root of unity. -/
  isRoot : IsPrimitiveRoot root rootOrder
  /-- the `i`-th branch point, a `ℚ`-rational point of the line. -/
  branch : Fin cert.r → ℚ
  /-- the place of the integral model above the `i`-th branch point. -/
  place : Fin cert.r → Ideal (ArithAKLB.Aring m.Ω)
  /-- the places are prime ideals. -/
  place_prime : ∀ i, (place i).IsPrime
  /-- `place i` lies over the rational place `X - branchᵢ` of the line. -/
  place_liesOver : ∀ i, (place i).LiesOver (Ideal.span {X - C (branch i)})
  /-- the branch cycle `gᵢ` is an inertia element at `place i`. -/
  gen_inertia : ∀ i, m.galE (gen i : m.E) ∈ (place i).inertia (m.Ω ≃ₐ[RatFunc ℚ] m.Ω)

attribute [instance] ClassInertiaPlaceData.rootOrder_neZero

/-- **The branch cycles of a compositum, packaged as the branch-cycle data of an arithmetic model.**

Given branch cycles `g` of an arithmetic compositum `Ωbar = Ω · ℚ̄(T)` over rational branch points,
whose images in the deck group lie in the certificate's prescribed classes, the arithmetic model is
the enlarged `ℚ(T)`-form `Ω(ζ_N)` of the compositum, where `N = |Gal(Ωbar/ℚ̄(T))|`.  Adjoining the
`N`-th roots of unity keeps `Ω(ζ_N)/ℚ(T)` Galois, keeps `Ωbar` its compositum with `ℚ̄(T)`, and
supplies the primitive root of unity through which the tame inertia is read; `N` is divisible by
every ramification index because each branch cycle lies in `Gal(Ωbar/ℚ̄(T))`.

The geometric Galois group `N = Gal(Ω(ζ_N)/k₀(T))` is identified with `Gal(Ωbar/ℚ̄(T))` by the
regularity comparison `compareOfEmbedding`; the branch cycles transport along that isomorphism, and
the places of the integral model transport along the base-change `bridge` of integral models. -/
theorem classInertiaPlaceData_of_branchCycles {G : Type} [Group G] [Finite G]
    (cert : RigidData G) (branch : Fin cert.r → ℚ) (c : GeomCompositum G)
    (g : Fin cert.r → c.cover.deck)
    (hgcyc : c.cover.IsBranchCycleGenSystem (fun i => algebraMap ℚ GeomAKLB.k (branch i)) g)
    (hclass : ∀ i, ConjClasses.mk (c.toG (g i)) = cert.C i) :
    ∃ m : ArithmeticModel G, Nonempty (ClassInertiaPlaceData cert m) := by
  classical
  -- The modulus through which tame inertia will be read.
  obtain ⟨N, hN⟩ : ∃ N : ℕ, N = Nat.card (c.Ωbar ≃ₐ[RatFunc GeomAKLB.k] c.Ωbar) := ⟨_, rfl⟩
  haveI : NeZero N := ⟨by rw [hN]; exact Nat.card_pos.ne'⟩
  -- The enlarged model `Ω(ζ_N)`, still a `ℚ(T)`-form of the compositum.
  haveI : FiniteDimensional (RatFunc ℚ) ↥(c.enlarged N) := c.enlarged_finiteDimensional N
  haveI : Normal (RatFunc ℚ) ↥(c.enlarged N) := c.enlarged_normal N
  haveI : IsGalois (RatFunc ℚ) ↥(c.enlarged N) := ⟨⟩
  haveI : CharZero ↥(c.enlarged N) := charZero_of_injective_algebraMap
    (algebraMap (RatFunc ℚ) ↥(c.enlarged N)).injective
  haveI : IsScalarTower ℚ (RatFunc ℚ) ↥(c.enlarged N) := c.enlarged_isScalarTower N
  -- Pin the scalar tower `ℚ(T) → ℚ̄(T) → Ωbar`.
  letI smulRS : SMul (RatFunc ℚ) (RatFunc (AlgebraicClosure ℚ)) :=
    (instAlgRatFuncClosure).toSMul
  haveI towerQbar : IsScalarTower (RatFunc ℚ) (RatFunc (AlgebraicClosure ℚ)) c.Ωbar :=
    IsScalarTower.of_algebraMap_eq c.algebraMap_Q_eq
  -- The regularity comparison for the enlarged model.
  obtain ⟨cmp, hcmp⟩ := compareOfEmbedding (Ω := ↥(c.enlarged N)) (Ombar := c.Ωbar)
    (IntermediateField.val (c.enlarged N))
    (sup_eq_top_of_adjoin_eq_top _ (c.enlarged_adjoin_eq_top N))
  -- The restriction homomorphism `Gal(Ωbar/ℚ̄(T)) → Gal(Ω(ζ_N)/ℚ(T))`.
  let ρ0 : (↥(c.enlarged N) ≃ₐ[↥(constFieldBase ↥(c.enlarged N))] ↥(c.enlarged N)) →*
      (↥(c.enlarged N) ≃ₐ[RatFunc ℚ] ↥(c.enlarged N)) :=
    { toFun := fun σ => σ.restrictScalars (RatFunc ℚ)
      map_one' := rfl
      map_mul' := fun _ _ => rfl }
  let ρ : (c.Ωbar ≃ₐ[RatFunc GeomAKLB.k] c.Ωbar) →*
      (↥(c.enlarged N) ≃ₐ[RatFunc ℚ] ↥(c.enlarged N)) := ρ0.comp cmp.symm.toMonoidHom
  have hres : ∀ (τ : c.Ωbar ≃ₐ[RatFunc GeomAKLB.k] c.Ωbar) (x : ↥(c.enlarged N)),
      algebraMap ↥(c.enlarged N) c.Ωbar (ρ τ x) = τ (algebraMap ↥(c.enlarged N) c.Ωbar x) := by
    intro τ x
    have h := hcmp (cmp.symm τ) x
    rw [cmp.apply_symm_apply] at h
    exact h.symm
  -- The tame inertia generators.
  let Φ : (c.Ωbar ≃ₐ[RatFunc GeomAKLB.k] c.Ωbar) ≃*
      ↥((constFieldBase ↥(c.enlarged N)).fixingSubgroup) :=
    cmp.symm.trans (IntermediateField.fixingSubgroupEquiv (constFieldBase ↥(c.enlarged N))).symm
  -- The compositum's integral model, and the bridge to the arithmetic one.
  letI algPolyBar : Algebra (Polynomial GeomAKLB.k) c.Ωbar := c.cover.algPoly
  haveI towerPolyBar : IsScalarTower (Polynomial GeomAKLB.k) (RatFunc GeomAKLB.k) c.Ωbar :=
    c.cover.tower
  have hc : IsCompositumOver ↥(c.enlarged N) c.Ωbar := fun q =>
    (c.algebraMap_Q_eq q).symm.trans
      (IsScalarTower.algebraMap_apply (RatFunc ℚ) ↥(c.enlarged N) c.Ωbar q)
  -- The places over the branch points.
  choose Q hQmax hQover hQin using fun i => hgcyc.inertia i
  refine ⟨GeomModel.toArithmeticModel
    { Ω := ↥(c.enlarged N)
      geomBase := constFieldBase ↥(c.enlarged N)
      normalGeomBase := constFieldBase_normal _
      galGeom := c.toG.comp cmp.toMonoidHom
      surjGalGeom := c.surjective_toG.comp cmp.surjective
      const_le_geomBase := const_le_constFieldBase _
      geomBase_le_constFieldBase := le_rfl }, ⟨{
    gen := fun i => Φ (g i)
    gen_top := ?_
    gen_prod := ?_
    φ_class := ?_
    rootOrder := N
    order_dvd := ?_
    root := (c.exists_primitiveRoot_enlarged N).choose
    isRoot := (c.exists_primitiveRoot_enlarged N).choose_spec
    branch := branch
    place := fun i => (Q i).comap (bridge hc)
    place_prime := ?_
    place_liesOver := ?_
    gen_inertia := ?_ }⟩⟩
  · exact closure_range_mulEquiv Φ g hgcyc.top
  · exact prod_ofFn_mulEquiv Φ g hgcyc.prod
  · -- the classes
    intro i
    show ConjClasses.mk (c.toG (cmp (cmp.symm (g i)))) = cert.C i
    rw [cmp.apply_symm_apply]
    exact hclass i
  · intro i
    refine orderOf_dvd_mulEquiv Φ (g i) N ?_
    rw [hN]
    exact orderOf_dvd_natCard _
  · -- the places are prime
    intro i
    haveI := (hQmax i).isPrime
    exact Ideal.IsPrime.comap _
  · -- the places lie over the rational branch points
    intro i
    haveI := hQover i
    exact liesOver_comap_bridge hc (branch i) (Q i)
  · -- the inertia statement
    intro i
    show ρ (g i) ∈ _
    refine mem_inertia_bridge hc ρ hres (Q i) ?_
    rw [hQin i]
    exact Subgroup.mem_zpowers _

/-- **The Riemann Existence Theorem, at the branch-cycle interface.**

For a certificate's classes, there is an arithmetic model `m` whose geometric fundamental group
`N = Gal(Ω/k₀(T))` carries the branch cycles of a cover branched over `r` **rational** points:
inertia generators at `r` places of the integral model lying over the rational places
`X - branchᵢ`, generating `N` with the product-one relation and with `φ (gᵢ)` in the `i`-th
prescribed class, together with a primitive `M`-th root of unity in `Ω` for `M` divisible by every
ramification index.

An inertia generator is only pinned up to a coprime power, so the classes that are realized are a
coordinatewise cyclotomic twist `(C₁^{u₁}, …, C_r^{u_r})` of the prescribed ones; the exponents are
produced by the geometry, and rigidity of the twisted tuple is the caller's to supply.

This is the Riemann Existence Theorem, stated at the interface the branch-cycle descent consumes.
Its content is genuinely geometric, in two layers, both supplied by `Rigidity.RET.geomRET` through
`geomCompositum_branchCycles_exists`:

* **Existence** — a generating product-one tuple `base` (equivalently a finite quotient of the tame
  fundamental group of `ℙ¹_{ℚ̄} ∖ {r points}`, which is the profinite completion of the sphere group
  `SphereGroup r`) is realized by an actual regular Galois cover of `ℙ¹` branched over the `r` points
  with the prescribed monodromy.  The analytic passage — a topological cover of the punctured line is
  algebraic (Grauert–Remmert / GAGA).
* **Tame inertia** — the branch cycles `gᵢ` are the canonical generators of tame inertia at the `r`
  points, so they are inertia elements at the corresponding places of the integral model; they
  generate the geometric group and satisfy the single product-one relation.

The third classical layer, the cyclotomic action of the arithmetic Galois group `E` on tame inertia
(Fried's branch-cycle formula), is *not* assumed here: it is derived from this data in
`InertiaPlaceData.toInertiaRootData`.  Neither is transitivity of the geometric group on the places
above a branch point: because the branch points are rational, that is
`InertiaPlaceData.place_trans`.

That this cannot be a statement about an abstract tower `N ⊴ E` — the inertia generators need not
exist for an arbitrary surjection `N ↠ G` — is shown by the `ℤ/2` example in
`Descent.GeometricPi1`; the data exists precisely because `N` is the geometric fundamental group of
the right cover.  See Grothendieck, *SGA 1*, Exp. XIII (tame fundamental group of the punctured
line); Völklein, *Groups as Galois Groups*, Thm 2.13 and §4; Fried–Völklein; Serre, *Topics in
Galois Theory*, §6–8. -/
theorem classInertiaPlaceData_exists {G : Type} [Group G] [Finite G]
    (cert : RigidData G) :
    ∃ u : Fin cert.r → ℕ,
      (∀ (i : Fin cert.r) (x : G), ConjClasses.mk x = cert.C i → Nat.Coprime (u i) (orderOf x)) ∧
      ∀ hrig : Nat.card (rigidTuples fun i => ConjClasses.powClass (u i) (cert.C i)) = Nat.card G,
        ∃ m : ArithmeticModel G, Nonempty (ClassInertiaPlaceData (cert.twistBy u hrig) m) := by
  obtain ⟨branch, c, g, u, _, hgcyc, hcop, hclass⟩ := geomCompositum_branchCycles_exists cert
  exact ⟨u, hcop, fun hrig =>
    classInertiaPlaceData_of_branchCycles (cert.twistBy u hrig) branch c g hgcyc hclass⟩

/-- **The branch cycles can be matched with the certificate's tuple on the nose.**

Geometry produces branch cycles whose images lie in the prescribed classes
(`classInertiaPlaceData_exists`); the certificate's tuple `base` is one particular rigid tuple.
Both are rigid tuples, so rigidity relates them by a single simultaneous conjugation
(`Rigidity.exists_conj_comp_eq`), and that conjugation is absorbed into the geometric monodromy
(`ArithmeticModel.conj`) — the field tower, the places, the root of unity and the inertia statements
are untouched.  Whichever tuple the certificate names is therefore reached, from the one model the
geometry has to supply. -/
theorem inertiaPlaceData_exists {G : Type} [Group G] [Finite G] {cert : RigidData G}
    (hcls : ∃ m : ArithmeticModel G, Nonempty (ClassInertiaPlaceData cert m))
    (base : Fin cert.r → G) (hbase : base ∈ rigidTuples cert.C) :
    ∃ m : ArithmeticModel G, Nonempty (InertiaPlaceData m base hbase) := by
  obtain ⟨m, ⟨d⟩⟩ := hcls
  obtain ⟨c, hc⟩ :=
    Rigidity.exists_conj_comp_eq hbase m.surjφ d.gen_top d.gen_prod d.φ_class
  haveI := d.rootOrder_neZero
  exact ⟨m.conj c, ⟨{ gen := d.gen
                      gen_top := d.gen_top
                      gen_prod := d.gen_prod
                      φ_gen := hc
                      rootOrder := d.rootOrder
                      order_dvd := d.order_dvd
                      root := d.root
                      isRoot := d.isRoot
                      branch := d.branch
                      place := d.place
                      place_prime := d.place_prime
                      place_liesOver := d.place_liesOver
                      gen_inertia := d.gen_inertia }⟩⟩

end InertiaPlaces

/-- **The primitive-root inertia data exists.**

For the certificate's rigid generating product-one tuple `base`, there is an arithmetic model `m`
whose geometric fundamental group `N = Gal(Ω/k₀(T))` carries the primitive-root inertia data for
`base`: inertia generators over the `r` branch points, generating `N` with the product-one relation
and realizing `φ (gᵢ) = baseᵢ`, a primitive `M`-th root of unity in `Ω` (`M` divisible by every
ramification index), and the conjugation formula `e · gᵢ · e⁻¹ ∼_N gᵢ ^ χ(e)` with `χ(e)` the power
to which `e` raises the root of unity.

The branch cycles come from the Riemann Existence Theorem in the form `inertiaPlaceData_exists`,
which realizes them as tame inertia at places of the integral model; the conjugation formula is then
Fried's branch-cycle formula for those places (`InertiaPlaceData.toInertiaRootData`). -/
theorem inertiaRootData_exists {G : Type} [Group G] [Finite G] {cert : RigidData G}
    (hcls : ∃ m : ArithmeticModel G, Nonempty (ClassInertiaPlaceData cert m))
    (base : Fin cert.r → G) (hbase : base ∈ rigidTuples cert.C) :
    ∃ m : ArithmeticModel G, Nonempty (InertiaRootData m base hbase) := by
  obtain ⟨m, ⟨d⟩⟩ := inertiaPlaceData_exists hcls base hbase
  exact ⟨m, ⟨d.toInertiaRootData⟩⟩

/-- **The cyclotomic branch data exists.**

For the certificate's rigid generating product-one tuple `base`, there is an arithmetic model `m`
whose geometric fundamental group `N = Gal(Ω/k₀(T))` carries the cyclotomic branch data for `base`:
the inertia generators over the `r` branch points, generating `N` with the product-one relation and
realizing `φ (gᵢ) = baseᵢ`, together with the cyclotomic character `E →* (ZMod M)ˣ` and the
conjugation formula `e · gᵢ · e⁻¹ ∼_N gᵢ ^ χ(e)`.

The generators are the tame inertia of the cover branched over the `r` points with monodromy `base`;
their generation of `N` and the product-one relation are the geometric fundamental group of the
punctured line, and the conjugation formula is the action of the arithmetic Galois group on tame
inertia through the cyclotomic character. -/
theorem cycloBranchData_exists {G : Type} [Group G] [Finite G] {cert : RigidData G}
    (hcls : ∃ m : ArithmeticModel G, Nonempty (ClassInertiaPlaceData cert m))
    (base : Fin cert.r → G) (hbase : base ∈ rigidTuples cert.C) :
    ∃ m : ArithmeticModel G, Nonempty (CycloBranchData m base hbase) := by
  obtain ⟨m, ⟨d⟩⟩ := inertiaRootData_exists hcls base hbase
  exact ⟨m, ⟨d.toCycloBranchData⟩⟩

/-- For a rigidity certificate and its rigid generating product-one tuple `base`, there is an
arithmetic model `m` whose geometric fundamental group `N = Gal(Ω/k₀(T))` carries the tame inertia
data for `base` (`TameInertiaData`): inertia generators `gᵢ ∈ N` generating `N`, satisfying the
product-one sphere relation, realizing `φ (gᵢ) = baseᵢ`, and transforming under the arithmetic
Galois action through the cyclotomic conjugacy `e · gᵢ · e⁻¹ ∼_N gᵢ ^ χ(σ)`. -/
theorem tameInertiaModel_exists {G : Type} [Group G] [Finite G] {cert : RigidData G}
    (hcls : ∃ m : ArithmeticModel G, Nonempty (ClassInertiaPlaceData cert m))
    (base : Fin cert.r → G) (hbase : base ∈ rigidTuples cert.C) :
    ∃ m : ArithmeticModel G, Nonempty (Rigidity.RET.TameInertiaData m.N m.φ base hbase) := by
  obtain ⟨m, ⟨d⟩⟩ := cycloBranchData_exists hcls base hbase
  exact ⟨m, ⟨d.toTameInertiaData⟩⟩

/-- The class-level geometric inertia data exists, obtained from `tameInertiaModel_exists` by pushing
the tame inertia data through `φ` (`TameInertiaData.toGeometricInertiaData`): the branch cycle in
`ConjClasses G` from the `N`-conjugacy on tame inertia. -/
theorem geomInertiaModel_exists {G : Type} [Group G] [Finite G] {cert : RigidData G}
    (hcls : ∃ m : ArithmeticModel G, Nonempty (ClassInertiaPlaceData cert m))
    (base : Fin cert.r → G) (hbase : base ∈ rigidTuples cert.C) :
    ∃ m : ArithmeticModel G, Nonempty (Rigidity.RET.GeometricInertiaData m.N m.φ base hbase) := by
  obtain ⟨m, ⟨t⟩⟩ := tameInertiaModel_exists hcls base hbase
  exact ⟨m, ⟨t.toGeometricInertiaData⟩⟩

/-- From a rigidity certificate, the geometric side of the descent datum exists — the arithmetic
fundamental-group tower `N ⊴ E`, the geometric monodromy `φ : N ↠ G`, and its geometric presentation
as the certificate's rigid tuple.

This packages the finite field tower `ℚ(T) ⊂ k₀(T) ⊂ Ω` (`k₀ = algebraicClosure ℚ Ω`, a number
field) with its fundamental exact sequence `1 → N → E → Gal(k₀/ℚ) → 1` and the geometric `π₁`
presentation `SphereGroup r ↠ N`: the rigid tuple is extracted from `cert.gen`, and the presentation
is the sphere hom of the tame inertia generators supplied by `cycloBranchData_exists`, whose
cyclotomic character and conjugation formula become the tower's branch-cycle formula.  See
`DESCENT_ROADMAP.md` §1–2. -/
theorem geomTower_nonempty {G : Type} [Group G] [Finite G]
    (cert : RigidData G)
    (hcls : ∃ m : ArithmeticModel G, Nonempty (ClassInertiaPlaceData cert m)) :
    Nonempty (GeomTower G cert) := by
  obtain ⟨base, hbase⟩ := cert.gen
  obtain ⟨m, ⟨d⟩⟩ := cycloBranchData_exists hcls base hbase
  letI : NeZero d.rootOrder := ⟨d.rootOrder_pos.ne'⟩
  -- the presentation: the sphere hom of the inertia generators.
  have hφ_pres : ∀ x : Rigidity.RET.SphereGroup cert.r,
      m.φ (Rigidity.RET.sphereHom d.gen d.gen_prod x)
        = Rigidity.RET.sphereHom base hbase.2.1 x := by
    have hhom : m.φ.comp (Rigidity.RET.sphereHom d.gen d.gen_prod)
        = Rigidity.RET.sphereHom base hbase.2.1 := by
      ext i
      rw [MonoidHom.comp_apply, Rigidity.RET.sphereHom_of, Rigidity.RET.sphereHom_of, d.φ_gen]
    exact fun x => DFunLike.congr_fun hhom x
  exact ⟨{
    E := m.E
    groupE := m.groupE
    N := m.N
    normalN := m.normalN
    φ := m.φ
    pres := Rigidity.RET.sphereHom d.gen d.gen_prod
    surjPres := (Rigidity.RET.sphereHom_surjective_iff d.gen d.gen_prod).2 d.gen_top
    base := base
    base_mem := hbase
    φ_pres := hφ_pres
    rootOrder := d.rootOrder
    order_dvd := fun i => dvd_trans
      (by rw [← d.φ_gen i]
          exact orderOf_dvd_of_pow_eq_one (by rw [← map_pow, pow_orderOf_eq_one, map_one]))
      (d.order_dvd i)
    cycloChar := d.cycloChar
    cycloChar_N := d.cycloChar_N
    branchCycleχ := by
      intro e i
      have hconj : IsConj (m.φ (Rigidity.RET.conjN m.N e (d.gen i)))
          (m.φ ((d.gen i) ^ ((d.cycloChar e : ZMod d.rootOrder).val))) :=
        m.φ.map_isConj (d.conj_pow e i)
      rw [map_pow, d.φ_gen i] at hconj
      rw [Rigidity.RET.sphereHom_of, ← hbase.1 i, ConjClasses.powClass_mk]
      exact ConjClasses.mk_eq_mk_iff_isConj.mpr hconj
    Ω := m.Ω
    fieldΩ := m.fieldΩ
    algΩ := m.algΩ
    findimΩ := m.findimΩ
    galΩ := m.galΩ
    charZeroΩ := m.charZeroΩ
    towerΩ := m.towerΩ
    galE := m.galE
    geomBase := m.geomBase
    galN_iff := m.galN_iff
    const_le_geomBase := m.const_le_geomBase
    geomBase_le_constFieldBase := m.geomBase_le_constFieldBase }⟩

/-- **The geometric tower exists over some cyclotomic twist of the prescribed classes.**

The branch cycles of the cover are inertia generators, and an inertia generator is only determined
up to a coprime power, so the class tuple the geometry realizes is a coordinatewise twist
`(C₁^{u₁}, …, C_r^{u_r})` of the prescribed one, with exponents coprime to the orders.  Rigidity of
that twisted tuple is the remaining input; given it, the whole tower is available over the twist.

For a rational class tuple the twist is the tuple itself and this specializes to
`geomTower_nonempty`. -/
theorem geomTower_nonempty_twist {G : Type} [Group G] [Finite G] (cert : RigidData G) :
    ∃ u : Fin cert.r → ℕ,
      (∀ (i : Fin cert.r) (x : G), ConjClasses.mk x = cert.C i → Nat.Coprime (u i) (orderOf x)) ∧
      ∀ hrig : Nat.card (rigidTuples fun i => ConjClasses.powClass (u i) (cert.C i)) = Nat.card G,
        Nonempty (GeomTower G (cert.twistBy u hrig)) := by
  obtain ⟨u, hcop, h⟩ := classInertiaPlaceData_exists cert
  exact ⟨u, hcop, fun hrig => geomTower_nonempty _ (h hrig)⟩
