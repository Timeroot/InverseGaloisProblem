import Mathlib

/-!
# Constant subfields of `Ω/ℚ(T)` generate rational function fields

Let `Ω` be an extension of `ℚ(T)` and let `K ⊆ Ω` be a field of *constants* — a subfield algebraic
over `ℚ`.  The subfield of `Ω` generated by `K` and `ℚ(T)` is then a **rational function field over
`K`**: it is `K(T)`, with the same coordinate `T`.

The reason is that the coordinate stays transcendental after the constants are adjoined: `T` is
transcendental over `ℚ`, and `K/ℚ` is algebraic, so `T` is transcendental over `K`
(`Transcendental.extendScalars`).  Hence `K[T] → Ω` is injective and extends to a field embedding
`K(T) → Ω` (`RatFunc.liftAlgHom`), whose image is exactly the subfield generated by `K` and `ℚ(T)`.

This is the last step of the arithmetic descent: the base field over which the descended cover is
regular is produced as an *intermediate field* of the tower `ℚ(T) ⊆ Ω`, and only this identification
turns it into the recognizable base `RatFunc K`.

## Main definitions and results

* `Rigidity.RET.Descent.coordT` — the image of the coordinate `T` in `Ω`.
* `Rigidity.RET.Descent.transcendental_coordT` — it is transcendental over any constant field.
* `Rigidity.RET.Descent.constRatFunc` — the embedding `K(T) → Ω`.
* `Rigidity.RET.Descent.exists_ratFunc_algEquiv` — the subfield generated by `K` over `ℚ(T)` is
  `K`-isomorphic to `RatFunc K`.
-/

open Polynomial

namespace Rigidity.RET.Descent

variable (Ω : Type) [Field Ω] [Algebra (RatFunc ℚ) Ω]

/-- The **coordinate** of `Ω` over `ℚ(T)`: the image of `T ∈ ℚ(T)` in `Ω`. -/
noncomputable def coordT : Ω := algebraMap (RatFunc ℚ) Ω RatFunc.X

variable [CharZero Ω]

/-- The image in `Ω` of a polynomial in the coordinate, computed by evaluation at `coordT`. -/
theorem algebraMap_polynomial_eq_aeval (p : ℚ[X]) :
    algebraMap (RatFunc ℚ) Ω (algebraMap ℚ[X] (RatFunc ℚ) p) = aeval (coordT Ω) p := by
  have hC : ∀ a : ℚ, algebraMap (RatFunc ℚ) Ω (algebraMap ℚ[X] (RatFunc ℚ) (Polynomial.C a))
      = algebraMap ℚ Ω a := by
    intro a
    rw [RatFunc.algebraMap_C]
    exact congrFun (congrArg DFunLike.coe
      (Subsingleton.elim ((algebraMap (RatFunc ℚ) Ω).comp (RatFunc.C : ℚ →+* RatFunc ℚ))
        (algebraMap ℚ Ω))) a
  have hX : algebraMap (RatFunc ℚ) Ω (algebraMap ℚ[X] (RatFunc ℚ) Polynomial.X) = coordT Ω := by
    rw [RatFunc.algebraMap_X]; rfl
  induction p using Polynomial.induction_on with
  | C a => simp
  | add p q hp hq => simp [hp, hq]
  | monomial n a _ => simp only [map_mul, map_pow, hC, hX, aeval_C, aeval_X]

variable {Ω}
variable {K : Type} [Field K] [Algebra ℚ K] [Algebra K Ω] [IsScalarTower ℚ K Ω]

/-- **The coordinate stays transcendental over the constants.**  `T` is transcendental over `ℚ`, and
a field of constants is algebraic over `ℚ`, so `T` is transcendental over it. -/
theorem transcendental_coordT [Algebra.IsAlgebraic ℚ K] : Transcendental K (coordT Ω) := by
  have hXQ : Transcendental ℚ (RatFunc.X : RatFunc ℚ) := by
    rw [← RatFunc.algebraMap_X, transcendental_algebraMap_iff (RatFunc.algebraMap_injective ℚ)]
    exact Polynomial.transcendental_X ℚ
  have h₀ : Transcendental ℚ (coordT Ω) :=
    (transcendental_algebraMap_iff (R := ℚ) (S := RatFunc ℚ) (A := Ω)
      (algebraMap (RatFunc ℚ) Ω).injective).2 hXQ
  exact h₀.extendScalars K

variable (K)

/-- The evaluation of `K`-polynomials at the coordinate is injective, because the coordinate is
transcendental over `K`. -/
theorem injective_aeval_coordT [Algebra.IsAlgebraic ℚ K] :
    Function.Injective (aeval (R := K) (coordT Ω)) :=
  transcendental_iff_injective.1 transcendental_coordT

/-- **The rational function field `K(T)` inside `Ω`.**  The embedding extending the evaluation
`K[T] → Ω` at the coordinate; injective because the coordinate is transcendental over `K`. -/
noncomputable def constRatFunc [Algebra.IsAlgebraic ℚ K] : RatFunc K →ₐ[K] Ω :=
  RatFunc.liftAlgHom (aeval (R := K) (coordT Ω))
    (nonZeroDivisors_le_comap_nonZeroDivisors_of_injective _ (injective_aeval_coordT K))

theorem injective_constRatFunc [Algebra.IsAlgebraic ℚ K] :
    Function.Injective (constRatFunc (Ω := Ω) K) :=
  RatFunc.liftAlgHom_injective _ (injective_aeval_coordT K)

variable {K}

/-- Every element of `K(T) ⊆ Ω` is a quotient of two polynomial values at the coordinate. -/
theorem constRatFunc_apply_div [Algebra.IsAlgebraic ℚ K] (p q : K[X]) :
    constRatFunc K (algebraMap K[X] (RatFunc K) p / algebraMap K[X] (RatFunc K) q)
      = aeval (coordT Ω) p / aeval (coordT Ω) q :=
  RatFunc.liftAlgHom_apply_div _ _ p q

variable (M : IntermediateField (RatFunc ℚ) Ω)

omit [CharZero Ω] [Algebra ℚ K] [IsScalarTower ℚ K Ω] in
/-- A polynomial in the coordinate with coefficients in `K` lies in any intermediate field
containing `K`. -/
theorem aeval_coordT_mem (hK : ∀ a : K, algebraMap K Ω a ∈ M) (p : K[X]) :
    aeval (coordT Ω) p ∈ M := by
  have hT : coordT Ω ∈ M := M.algebraMap_mem RatFunc.X
  rw [Polynomial.aeval_eq_sum_range]
  refine sum_mem fun i _ => ?_
  rw [Algebra.smul_def]
  exact mul_mem (hK _) (pow_mem hT i)

/-- The image of `K(T)` lies in any intermediate field of `Ω/ℚ(T)` containing `K`. -/
theorem constRatFunc_mem [Algebra.IsAlgebraic ℚ K] (hK : ∀ a : K, algebraMap K Ω a ∈ M)
    (x : RatFunc K) : constRatFunc K x ∈ M := by
  refine RatFunc.induction_on (P := fun x => constRatFunc K x ∈ M) x fun p q _ => ?_
  show constRatFunc K (algebraMap K[X] (RatFunc K) p / algebraMap K[X] (RatFunc K) q) ∈ M
  rw [constRatFunc_apply_div]
  exact div_mem (aeval_coordT_mem M hK p) (aeval_coordT_mem M hK q)

/-- The image of `K(T)` contains all of `ℚ(T)`: the coordinate and the rational constants are
already there. -/
theorem algebraMap_ratFunc_mem_range [Algebra.IsAlgebraic ℚ K] (y : RatFunc ℚ) :
    algebraMap (RatFunc ℚ) Ω y ∈ Set.range (constRatFunc (Ω := Ω) K) := by
  refine RatFunc.induction_on
    (P := fun y => algebraMap (RatFunc ℚ) Ω y ∈ Set.range (constRatFunc (Ω := Ω) K)) y
    fun p q _ => ?_
  show algebraMap (RatFunc ℚ) Ω
      (algebraMap ℚ[X] (RatFunc ℚ) p / algebraMap ℚ[X] (RatFunc ℚ) q) ∈ _
  refine ⟨algebraMap K[X] (RatFunc K) (p.map (algebraMap ℚ K))
    / algebraMap K[X] (RatFunc K) (q.map (algebraMap ℚ K)), ?_⟩
  rw [constRatFunc_apply_div, Polynomial.aeval_map_algebraMap, Polynomial.aeval_map_algebraMap,
    map_div₀, algebraMap_polynomial_eq_aeval, algebraMap_polynomial_eq_aeval]

/-- **The subfield generated by a field of constants is a rational function field.**

If the intermediate field `M` of `Ω / ℚ(T)` is generated by a field of constants `K` — a subfield of
`Ω` algebraic over `ℚ` — then `M` is `K`-isomorphic to `RatFunc K`: the coordinate `T` stays
transcendental over `K`, so `K(T) → Ω` is an embedding, and its image is exactly `M`. -/
theorem exists_ratFunc_algEquiv [Algebra.IsAlgebraic ℚ K] [Algebra K M] [IsScalarTower K M Ω]
    (hM : M = IntermediateField.adjoin (RatFunc ℚ) (Set.range (algebraMap K Ω))) :
    Nonempty (RatFunc K ≃ₐ[K] M) := by
  classical
  have hKM : ∀ a : K, algebraMap K Ω a ∈ M := by
    intro a
    rw [hM]
    exact IntermediateField.subset_adjoin _ _ ⟨a, rfl⟩
  have hmem : ∀ x : RatFunc K, constRatFunc K x ∈ M := constRatFunc_mem M hKM
  -- the image of `K(T)` is all of `M`
  have hsurj : ∀ y ∈ M, ∃ x : RatFunc K, constRatFunc K x = y := by
    have hsub : M.toSubfield ≤ (constRatFunc (Ω := Ω) K).fieldRange.toSubfield := by
      rw [hM]
      refine IntermediateField.adjoin_le_subfield (RatFunc ℚ) (Set.range (algebraMap K Ω)) ?_ ?_
      · rintro _ ⟨y, rfl⟩
        exact algebraMap_ratFunc_mem_range y
      · rintro _ ⟨a, rfl⟩
        exact ⟨algebraMap K (RatFunc K) a, (constRatFunc K).commutes a⟩
    intro y hy
    exact hsub (by exact hy)
  -- package the embedding as a `K`-algebra map into `M`
  let g : RatFunc K →ₐ[K] M :=
    { toFun := fun x => ⟨constRatFunc K x, hmem x⟩
      map_one' := Subtype.ext (map_one _)
      map_mul' := fun a b => Subtype.ext (map_mul _ a b)
      map_zero' := Subtype.ext (map_zero _)
      map_add' := fun a b => Subtype.ext (map_add _ a b)
      commutes' := fun a => Subtype.ext (by
        show constRatFunc K (algebraMap K (RatFunc K) a) = ((algebraMap K M a : M) : Ω)
        rw [AlgHom.commutes, IsScalarTower.algebraMap_apply K M Ω a]
        rfl) }
  have hginj : Function.Injective g := fun a b hab =>
    injective_constRatFunc K (congrArg Subtype.val hab)
  have hgsurj : Function.Surjective g := by
    rintro ⟨y, hy⟩
    obtain ⟨x, hx⟩ := hsurj y hy
    exact ⟨x, Subtype.ext hx⟩
  exact ⟨AlgEquiv.ofBijective g ⟨hginj, hgsurj⟩⟩

end Rigidity.RET.Descent
