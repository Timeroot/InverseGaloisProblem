import Mathlib
import InverseGalois.Core.InstanceShortcuts
import InverseGalois.Rigidity.RET.Descent.ConstField

/-!
# Constant descent: fields above `k_Ω(T)` are generated by their constants

Let `Ω / ℚ(T)` be finite Galois with constant field `k_Ω = algebraicClosure ℚ Ω`, and let
`E' ≤ Gal(Ω/ℚ(T))` be a subgroup containing `Gal(Ω / k_Ω(T))`.  Its fixed field `M` then sits
between `ℚ(T)` and `k_Ω(T)`, and the theorem of this file is that **`M` is generated over `ℚ(T)`
by its own constants**: `M = K(T)` for the number field `K = k_Ω ∩ M`.

This is the arithmetic half of the base-field descent.  Its companion,
`Descent.ConstantSubfield`, identifies the field so generated with the rational function field
`RatFunc K`; together they turn an intermediate field of the tower into a recognizable base `K(T)`
over which the descended cover is regular.

## The proof

Restriction to the constants is a group homomorphism
`ρ : Gal(Ω/ℚ(T)) →* Gal(k_Ω/ℚ)` (`constRestrict`), whose kernel is exactly `Gal(Ω / k_Ω(T))`
(`ker_constRestrict`): an automorphism fixing every constant fixes the field they generate.  Let
`Γ = ρ(E')` and `K = k_Ω^Γ`.  Then `K(T) ≤ M`, and the two sides have the same degree over `ℚ(T)`:

* `[M : ℚ(T)] · |E'| = |Gal(Ω/ℚ(T))|` and `[K : ℚ] · |Γ| = |Gal(k_Ω/ℚ)|` (Artin);
* `|E'| = |Γ| · |ker ρ|` and `|Gal(Ω/ℚ(T))| = |ρ(Gal)| · |ker ρ|` (first isomorphism theorem,
  using `ker ρ ≤ E'`), with `|ρ(Gal)| ≤ |Gal(k_Ω/ℚ)|`;
* `[K(T) : ℚ(T)] = [K : ℚ]` (`finrank_adjoin_const`), because the `ℚ(T)`-minimal polynomial of a
  constant is the base change of its `ℚ`-minimal polynomial (`minpoly_ratFunc_const`).

Combining, `[M : ℚ(T)] ≤ [K(T) : ℚ(T)]`, so the inclusion `K(T) ≤ M` is an equality.

## Main results

* `Rigidity.RET.Descent.constRestrict` — restriction of a `ℚ(T)`-automorphism to the constants.
* `Rigidity.RET.Descent.ker_constRestrict` — its kernel is `Gal(Ω / k_Ω(T))`.
* `Rigidity.RET.Descent.finrank_adjoin_const` — adjoining a field of constants to `ℚ(T)` multiplies
  the degree by the degree of that field over `ℚ`.
* `Rigidity.RET.Descent.exists_constant_base` — the fixed field of a subgroup containing
  `Gal(Ω / k_Ω(T))` is generated over `ℚ(T)` by a field of constants.
-/

open Polynomial

open scoped IntermediateField

set_option synthInstance.maxHeartbeats 800000

namespace Rigidity.RET.Descent

variable (Ω : Type) [Field Ω] [Algebra (RatFunc ℚ) Ω] [FiniteDimensional (RatFunc ℚ) Ω]
  [IsGalois (RatFunc ℚ) Ω] [CharZero Ω] [IsScalarTower ℚ (RatFunc ℚ) Ω]

/-- The constant field of `Ω` is a finite extension of `ℚ`: it is generated by a single constant
(`exists_primitive_const`), which is integral over `ℚ`. -/
instance finiteDimensional_algebraicClosure_rat :
    FiniteDimensional ℚ ↥(algebraicClosure ℚ Ω) := by
  obtain ⟨α, hα, hadj⟩ := exists_primitive_const Ω
  rw [hadj]
  exact IntermediateField.adjoin.finiteDimensional hα

/-- The constant field of `Ω` is Galois over `ℚ`: it is normal (`constFieldBase_constNormal`) and,
in characteristic zero, separable. -/
instance isGalois_algebraicClosure_rat : IsGalois ℚ ↥(algebraicClosure ℚ Ω) :=
  haveI := constFieldBase_constNormal Ω
  ⟨⟩

/-- **Restriction to the constants.**  A `ℚ(T)`-automorphism of `Ω` maps constants to constants, so
it restricts to a `ℚ`-automorphism of the constant field `k_Ω`. -/
noncomputable def constRestrict :
    (Ω ≃ₐ[RatFunc ℚ] Ω) →* (↥(algebraicClosure ℚ Ω) ≃ₐ[ℚ] ↥(algebraicClosure ℚ Ω)) :=
  (AlgEquiv.restrictNormalHom (F := ℚ) (K₁ := Ω) (algebraicClosure ℚ Ω)).comp
    (MonoidHom.mk' (fun σ : Ω ≃ₐ[RatFunc ℚ] Ω => σ.restrictScalars ℚ) (fun _ _ => rfl))

@[simp]
theorem constRestrict_apply (σ : Ω ≃ₐ[RatFunc ℚ] Ω) (y : ↥(algebraicClosure ℚ Ω)) :
    ((constRestrict Ω σ y : ↥(algebraicClosure ℚ Ω)) : Ω) = σ (y : Ω) :=
  AlgEquiv.restrictNormalHom_apply (algebraicClosure ℚ Ω) (σ.restrictScalars ℚ) y

/-- Restriction to the constants kills exactly the automorphisms fixing every constant. -/
theorem mem_ker_constRestrict_iff (σ : Ω ≃ₐ[RatFunc ℚ] Ω) :
    σ ∈ (constRestrict Ω).ker ↔ ∀ x ∈ (algebraicClosure ℚ Ω : Set Ω), σ x = x := by
  rw [MonoidHom.mem_ker]
  constructor
  · intro hσ x hx
    have := constRestrict_apply Ω σ ⟨x, hx⟩
    rw [hσ] at this
    exact this.symm
  · intro h
    ext y
    have := constRestrict_apply Ω σ y
    rw [h _ y.2] at this
    exact this

omit [FiniteDimensional (RatFunc ℚ) Ω] [IsGalois (RatFunc ℚ) Ω] in
/-- An automorphism fixes the constant-field base `k_Ω(T)` pointwise exactly when it fixes every
constant. -/
theorem mem_fixingSubgroup_constFieldBase_iff (σ : Ω ≃ₐ[RatFunc ℚ] Ω) :
    σ ∈ (constFieldBase Ω).fixingSubgroup ↔ ∀ x ∈ (algebraicClosure ℚ Ω : Set Ω), σ x = x := by
  constructor
  · intro hσ x hx
    exact (IntermediateField.mem_fixingSubgroup_iff _ σ).1 hσ x
      (const_le_constFieldBase Ω hx)
  · intro hfix
    have hle : constFieldBase Ω ≤ IntermediateField.fixedField (Subgroup.zpowers σ) := by
      rw [constFieldBase]
      refine IntermediateField.adjoin_le_iff.2 ?_
      intro y hy
      rw [SetLike.mem_coe, IntermediateField.mem_fixedField_iff]
      intro g hg
      exact (Subgroup.zpowers_le.2 (MulAction.mem_stabilizer_iff.2 (hfix y hy))) hg
    exact (IntermediateField.le_iff_le _ _).1 hle (Subgroup.mem_zpowers _)

/-- **The kernel of restriction to the constants** is the geometric Galois group
`Gal(Ω / k_Ω(T))`. -/
theorem ker_constRestrict : (constRestrict Ω).ker = (constFieldBase Ω).fixingSubgroup := by
  ext σ
  rw [mem_ker_constRestrict_iff, mem_fixingSubgroup_constFieldBase_iff]

set_option maxHeartbeats 1000000 in
omit [IsGalois (RatFunc ℚ) Ω] in
/-- **Adjoining constants multiplies degrees.**  For a field of constants `K` (a subfield of `Ω`
algebraic over `ℚ`), `[K(T) : ℚ(T)] = [K : ℚ]`: a primitive element of `K` keeps its minimal
polynomial after the base change to `ℚ(T)` (`minpoly_ratFunc_const`). -/
theorem finrank_adjoin_const (K : IntermediateField ℚ Ω) (hK : K ≤ algebraicClosure ℚ Ω) :
    Module.finrank (RatFunc ℚ) ↥(IntermediateField.adjoin (RatFunc ℚ) (K : Set Ω))
      = Module.finrank ℚ ↥K := by
  haveI : FiniteDimensional ℚ ↥K :=
    Module.Finite.of_injective (IntermediateField.inclusion hK).toLinearMap
      (IntermediateField.inclusion hK).toRingHom.injective
  obtain ⟨β, hβ⟩ := Field.exists_primitive_element ℚ ↥K
  set b : Ω := (β : Ω) with hb
  have hbmem : b ∈ K := β.2
  have hbint : IsIntegral ℚ b := mem_algebraicClosure_iff'.1 (hK hbmem)
  have hKb : K = IntermediateField.adjoin ℚ ({b} : Set Ω) := by
    have h := IntermediateField.lift_adjoin_simple (F := ℚ) K β
    rw [hβ, IntermediateField.lift_top] at h
    exact h
  have hadj : IntermediateField.adjoin (RatFunc ℚ) (K : Set Ω)
      = IntermediateField.adjoin (RatFunc ℚ) ({b} : Set Ω) := by
    refine le_antisymm ?_ ?_
    · refine IntermediateField.adjoin_le_iff.2 ?_
      have hsub : K ≤ (IntermediateField.adjoin (RatFunc ℚ) ({b} : Set Ω)).restrictScalars ℚ := by
        rw [hKb, IntermediateField.adjoin_simple_le_iff, IntermediateField.mem_restrictScalars]
        exact IntermediateField.mem_adjoin_simple_self (RatFunc ℚ) b
      intro x hx
      exact hsub hx
    · exact IntermediateField.adjoin_simple_le_iff.2 (IntermediateField.subset_adjoin _ _ hbmem)
  rw [hadj, IntermediateField.adjoin.finrank (IsIntegral.of_finite (RatFunc ℚ) b),
    minpoly_ratFunc_const Ω hbint, natDegree_map, hKb,
    IntermediateField.adjoin.finrank hbint]

set_option maxHeartbeats 1000000 in
/-- **Constant descent.**  If `E'` contains the geometric Galois group `Gal(Ω / k_Ω(T))`, then its
fixed field is generated over `ℚ(T)` by a field of constants: `Ω^{E'} = K(T)` with
`K = k_Ω ∩ Ω^{E'}` a number field. -/
theorem exists_constant_base (E' : Subgroup (Ω ≃ₐ[RatFunc ℚ] Ω))
    (hN : (constFieldBase Ω).fixingSubgroup ≤ E') :
    ∃ K : IntermediateField ℚ Ω, K ≤ algebraicClosure ℚ Ω ∧
      IntermediateField.fixedField E'
        = IntermediateField.adjoin (RatFunc ℚ) (K : Set Ω) := by
  classical
  set N := (constFieldBase Ω).fixingSubgroup with hNdef
  set ρ := constRestrict Ω with hρ
  have hker : ρ.ker = N := ker_constRestrict Ω
  set f : E' →* (↥(algebraicClosure ℚ Ω) ≃ₐ[ℚ] ↥(algebraicClosure ℚ Ω)) := ρ.comp E'.subtype
    with hf
  set Γ := f.range with hΓ
  set L : IntermediateField ℚ ↥(algebraicClosure ℚ Ω) := IntermediateField.fixedField Γ with hL
  refine ⟨IntermediateField.lift L, IntermediateField.lift_le L, ?_⟩
  set M := IntermediateField.fixedField E' with hM
  set A := IntermediateField.adjoin (RatFunc ℚ)
    ((IntermediateField.lift L : IntermediateField ℚ Ω) : Set Ω) with hA
  -- `K(T) ≤ M`: the constants in `L` are fixed by every element of `E'`.
  have hAM : A ≤ M := by
    rw [hA, hM]
    refine IntermediateField.adjoin_le_iff.2 ?_
    rintro x ⟨y, hy, rfl⟩
    rw [SetLike.mem_coe, IntermediateField.mem_fixedField_iff]
    intro σ hσ
    have hmem : f ⟨σ, hσ⟩ ∈ Γ := ⟨⟨σ, hσ⟩, rfl⟩
    have hfix : f ⟨σ, hσ⟩ y = y := (IntermediateField.mem_fixedField_iff _ _).1 hy _ hmem
    have := constRestrict_apply Ω σ y
    rw [show constRestrict Ω σ = f ⟨σ, hσ⟩ from rfl, hfix] at this
    exact this.symm
  -- degree bookkeeping
  have e1 : Module.finrank (RatFunc ℚ) ↥M * Nat.card E' = Nat.card (Ω ≃ₐ[RatFunc ℚ] Ω) := by
    rw [← IntermediateField.finrank_fixedField_eq_card E', IsGalois.card_aut_eq_finrank]
    exact Module.finrank_mul_finrank (RatFunc ℚ) ↥M Ω
  have e2 : Module.finrank ℚ ↥L * Nat.card Γ
      = Nat.card (↥(algebraicClosure ℚ Ω) ≃ₐ[ℚ] ↥(algebraicClosure ℚ Ω)) := by
    rw [← IntermediateField.finrank_fixedField_eq_card Γ, IsGalois.card_aut_eq_finrank]
    exact Module.finrank_mul_finrank ℚ ↥L ↥(algebraicClosure ℚ Ω)
  have hfker : f.ker = N.subgroupOf E' := by
    ext ⟨σ, hσ⟩
    simp only [hf, MonoidHom.mem_ker, MonoidHom.comp_apply, Subgroup.coe_subtype,
      Subgroup.mem_subgroupOf]
    rw [← MonoidHom.mem_ker, hker]
  have e3 : Nat.card E' = Nat.card Γ * Nat.card N := by
    have h1 : Nat.card ↥E' = Nat.card (↥E' ⧸ f.ker) * Nat.card f.ker :=
      Subgroup.card_eq_card_quotient_mul_card_subgroup f.ker
    have h2 : Nat.card (↥E' ⧸ f.ker) = Nat.card Γ :=
      Nat.card_congr (QuotientGroup.quotientKerEquivRange f).toEquiv
    have h3 : Nat.card f.ker = Nat.card N := by
      rw [hfker]
      exact Nat.card_congr (Subgroup.subgroupOfEquivOfLe (hker ▸ hN)).toEquiv
    rw [h1, h2, h3]
  have e4 : Nat.card (Ω ≃ₐ[RatFunc ℚ] Ω) = Nat.card ρ.range * Nat.card N := by
    have h1 : Nat.card (Ω ≃ₐ[RatFunc ℚ] Ω)
        = Nat.card ((Ω ≃ₐ[RatFunc ℚ] Ω) ⧸ ρ.ker) * Nat.card ρ.ker :=
      Subgroup.card_eq_card_quotient_mul_card_subgroup ρ.ker
    have h2 : Nat.card ((Ω ≃ₐ[RatFunc ℚ] Ω) ⧸ ρ.ker) = Nat.card ρ.range :=
      Nat.card_congr (QuotientGroup.quotientKerEquivRange ρ).toEquiv
    rw [h1, h2, hker]
  have e5 : Nat.card ρ.range
      ≤ Nat.card (↥(algebraicClosure ℚ Ω) ≃ₐ[ℚ] ↥(algebraicClosure ℚ Ω)) :=
    Subgroup.card_le_card_group _
  have hpos : 0 < Nat.card Γ * Nat.card N :=
    Nat.mul_pos Nat.card_pos Nat.card_pos
  have key : Module.finrank (RatFunc ℚ) ↥M ≤ Module.finrank ℚ ↥L := by
    refine Nat.le_of_mul_le_mul_right ?_ hpos
    calc Module.finrank (RatFunc ℚ) ↥M * (Nat.card Γ * Nat.card N)
        = Module.finrank (RatFunc ℚ) ↥M * Nat.card E' := by rw [e3]
      _ = Nat.card (Ω ≃ₐ[RatFunc ℚ] Ω) := e1
      _ = Nat.card ρ.range * Nat.card N := e4
      _ ≤ Nat.card (↥(algebraicClosure ℚ Ω) ≃ₐ[ℚ] ↥(algebraicClosure ℚ Ω)) * Nat.card N :=
          Nat.mul_le_mul_right _ e5
      _ = Module.finrank ℚ ↥L * Nat.card Γ * Nat.card N := by rw [e2]
      _ = Module.finrank ℚ ↥L * (Nat.card Γ * Nat.card N) := by ring
  have hAfin : Module.finrank (RatFunc ℚ) ↥A = Module.finrank ℚ ↥(IntermediateField.lift L) :=
    finrank_adjoin_const Ω _ (IntermediateField.lift_le L)
  have hLfin : Module.finrank ℚ ↥(IntermediateField.lift L) = Module.finrank ℚ ↥L :=
    (LinearEquiv.finrank_eq
      (IntermediateField.equivMap L (IntermediateField.val _)).toLinearEquiv).symm
  exact (IntermediateField.eq_of_le_of_finrank_le hAM (by rw [hAfin, hLfin]; exact key)).symm

end Rigidity.RET.Descent
