import Mathlib
import InverseGalois.Core.InstanceShortcuts
import InverseGalois.Rigidity.RET.RegularityConverse
import InverseGalois.Rigidity.RET.Statement

/-!
# A polynomial criterion for a regular realization

`IsRegularInverseGalois G` asks for a field: a finite Galois extension of `ℚ(T)` with group `G` and
no constants beyond `ℚ`.  A construction, on the other hand, usually hands over a polynomial.  This
file bridges the two.  Given a finite Galois extension of `ℚ(T)` generated by a single element whose
minimal polynomial comes from `ℚ[T][X]` and stays irreducible over `ℚ̄(T)`, the extension is regular
(`Rigidity.RET.algebraicClosure_eq_bot_iff_irreducible_map_toClosureFrac`), so any identification of
its Galois group with `G` yields `IsRegularInverseGalois G`.

The `ℚ`-algebra structure needed for the statement is the canonical one carried by every field of
characteristic zero; the compatibility with `ℚ(T)` is the observation that a ring homomorphism of
fields of characteristic zero preserves rational numbers.

## Main results

* `IsRegularInverseGalois.of_primitive_irreducible` — the criterion.
* `IsRegularInverseGalois.of_subsingleton` — the trivial group, realized by `ℚ(T)` itself.
-/

open Polynomial

noncomputable section

namespace Rigidity.RET

/-- **A rational scalar acts on `ℚ(T)` by multiplication.**  The scalar action inherited from the
localization is not syntactically the one coming from the rational structure of the field, so the
identification has to be made by hand: push the scalar through the tower `ℚ → ℚ[T] → ℚ(T)`. -/
theorem rat_smul_ratFunc (x : ℚ) (y : RatFunc ℚ) : x • y = (x : RatFunc ℚ) * y := by
  have h1 : (x • (1 : Polynomial ℚ)) • y = x • ((1 : Polynomial ℚ) • y) := smul_assoc x 1 y
  rw [one_smul, Polynomial.smul_eq_C_mul, mul_one, Algebra.smul_def] at h1
  rw [← h1]
  congr 1
  exact eq_ratCast ((algebraMap (Polynomial ℚ) (RatFunc ℚ)).comp Polynomial.C) x

/-- **The canonical rational structures on a tower over `ℚ(T)` are compatible.**  Both scalar
actions are multiplication by a rational number, read in the respective field, and the structure
map preserves rational numbers. -/
theorem isScalarTower_rat_ratFunc (L : Type*) [Field L] [Algebra (RatFunc ℚ) L] [CharZero L] :
    IsScalarTower ℚ (RatFunc ℚ) L := by
  refine ⟨fun x y z => ?_⟩
  rw [rat_smul_ratFunc]
  simp only [Algebra.smul_def, map_mul, eq_ratCast, map_ratCast, mul_assoc]

/-- An extension of `ℚ(T)` has characteristic zero. -/
theorem charZero_of_ratFunc (L : Type*) [Field L] [Algebra (RatFunc ℚ) L] : CharZero L :=
  charZero_of_injective_algebraMap (algebraMap (RatFunc ℚ) L).injective

end Rigidity.RET

namespace IsRegularInverseGalois

/-- **A polynomial criterion for a regular realization.**

A finite Galois extension of `ℚ(T)` generated by one element `β`, whose minimal polynomial is the
image of `F ∈ ℚ[T][X]` and stays irreducible after base change to `ℚ̄(T)`, is regular; so if its
Galois group is isomorphic to `G`, then `G` is a regular inverse Galois group. -/
theorem of_primitive_irreducible {G : Type*} [Group G] (L : Type) [Field L]
    [Algebra (RatFunc ℚ) L] [FiniteDimensional (RatFunc ℚ) L] [IsGalois (RatFunc ℚ) L]
    (β : L) (hβtop : IntermediateField.adjoin (RatFunc ℚ) {β} = ⊤)
    (F : (Polynomial ℚ)[X]) (hFmap : minpoly (RatFunc ℚ) β = F.map (algebraMap (Polynomial ℚ) (RatFunc ℚ)))
    (hirr : Irreducible (F.map Rigidity.RET.toClosureFrac))
    (e : (L ≃ₐ[RatFunc ℚ] L) ≃* G) :
    IsRegularInverseGalois G := by
  haveI : CharZero L := Rigidity.RET.charZero_of_ratFunc L
  haveI : IsScalarTower ℚ (RatFunc ℚ) L := Rigidity.RET.isScalarTower_rat_ratFunc L
  exact ⟨L, inferInstance, inferInstance, inferInstance, inferInstance, inferInstance, inferInstance,
    Rigidity.RET.algebraicClosure_eq_bot_of_irreducible_map_toClosureFrac β hβtop F hFmap hirr,
    ⟨e⟩⟩

/-- **The trivial group is a regular inverse Galois group**, realized by `ℚ(T)` over itself: the
identity extension is Galois with trivial group, and `ℚ` is relatively algebraically closed in
`ℚ(T)` (`Rigidity.RET.regular_ratFunc`). -/
theorem of_subsingleton {G : Type*} [Group G] [Subsingleton G] : IsRegularInverseGalois G := by
  refine ⟨RatFunc ℚ, inferInstance, Algebra.id (RatFunc ℚ), inferInstance, inferInstance,
    DivisionRing.toRatAlgebra, ?_, Rigidity.RET.regular_ratFunc, ⟨?_⟩⟩
  · exact @Rigidity.RET.isScalarTower_rat_ratFunc (RatFunc ℚ) _ (Algebra.id (RatFunc ℚ)) _
  · exact MulEquiv.ofBijective (1 : (RatFunc ℚ ≃ₐ[RatFunc ℚ] RatFunc ℚ) →* G)
      ⟨fun a b _ => Subsingleton.elim a b, fun _ => ⟨1, Subsingleton.elim _ _⟩⟩

end IsRegularInverseGalois
