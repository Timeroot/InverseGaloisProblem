import InverseGalois.Rigidity.RET.Pi1.Topological.QuotientPi1
import InverseGalois.Rigidity.RET.Pi1.Topological.Transport
import Mathlib.Analysis.Complex.CoveringMap

/-!
# The fundamental group of the once-punctured plane

The complex exponential `exp : ℂ → ℂ ∖ {0}` is a covering map whose total space `ℂ` is
contractible, hence simply connected, and whose deck group is the additive group
`2πiℤ ≅ ℤ`.  Feeding this into the general quotient-covering isomorphism
(`IsAddQuotientCoveringMap.fundamentalGroupMulEquiv`) computes the fundamental group of the
punctured plane:

* `Complex.fundamentalGroupUnitsExp : FundamentalGroup {z : ℂ // z ≠ 0} ⟨exp 0, _⟩ ≃* Multiplicative ℤ`.

This is the base case of link **C** of `GAGA_DREAM.md` — the once-punctured line `ℙ¹ ∖ {0, ∞}`
has fundamental group `ℤ`, and `exp` exhibits the universal cover explicitly.  It is the first
concrete `π₁` computation on which the general punctured-sphere computation is built.

The auxiliary `zmultiplesEquivInt` records that the infinite cyclic subgroup generated by a nonzero
complex number is `≃+ ℤ` (the deck group of `exp` is `2πiℤ`).
-/

open Topology

/-- The additive subgroup `ℤ·a ⊆ ℂ` generated by a nonzero complex number `a` is infinite cyclic:
it is isomorphic to `ℤ` via `n ↦ n • a`.  (Injectivity uses that `ℂ` is torsion-free over `ℤ`.) -/
noncomputable def zmultiplesEquivInt {a : ℂ} (ha : a ≠ 0) :
    AddSubgroup.zmultiples a ≃+ ℤ :=
  ((AddMonoidHom.ofInjective (f := zmultiplesHom ℂ a) (smul_left_injective ℤ ha)).trans
    (AddEquiv.addSubgroupCongr (AddSubgroup.range_zmultiplesHom a))).symm

namespace Complex

/-- **The fundamental group of the punctured plane is `ℤ`.**  The complex exponential is a covering
map `ℂ → ℂ ∖ {0}` with contractible (hence simply connected) total space and deck group `2πiℤ ≅ ℤ`,
so the fundamental group of `ℂ ∖ {0}` at `exp 0` is the multiplicative infinite cyclic group. -/
noncomputable def fundamentalGroupUnitsExp :
    FundamentalGroup {z : ℂ // z ≠ 0} (⟨Complex.exp 0, (0 : ℂ).exp_ne_zero⟩) ≃* Multiplicative ℤ :=
  (Complex.isAddQuotientCoveringMap_exp.fundamentalGroupMulEquiv 0).trans
    (AddEquiv.toMultiplicative (zmultiplesEquivInt (a := 2 * Real.pi * Complex.I)
      (by simp [Real.pi_ne_zero, Complex.I_ne_zero])))

/-- The basepoint of `ℂˣ` corresponding to `exp 0 = 1` under the homeomorphism
`ℂˣ ≃ₜ {z : ℂ // z ≠ 0}`. -/
noncomputable def expUnit : ℂˣ :=
  unitsHomeomorphNeZero.symm ⟨Complex.exp 0, (0 : ℂ).exp_ne_zero⟩

/-- **The fundamental group of the units `ℂˣ` is `ℤ`.**  Transporting the punctured-plane
computation `fundamentalGroupUnitsExp` across the homeomorphism `ℂˣ ≃ₜ {z : ℂ // z ≠ 0}` gives the
fundamental group of the multiplicative group of nonzero complex numbers as the infinite cyclic
group. -/
noncomputable def fundamentalGroupUnits :
    FundamentalGroup ℂˣ expUnit ≃* Multiplicative ℤ :=
  (unitsHomeomorphNeZero.symm.fundamentalGroupMulEquiv
      ⟨Complex.exp 0, (0 : ℂ).exp_ne_zero⟩).symm.trans fundamentalGroupUnitsExp

/-- **The fundamental group of the torus is `ℤ²`.**  Modelling the 2-torus as `ℂˣ × ℂˣ` — each
factor `ℂˣ` being homotopy-equivalent to a circle — the product formula for `π₁`
(`FundamentalGroup.prodMulEquiv`) together with `π₁(ℂˣ) ≅ ℤ` (`fundamentalGroupUnits`) gives
`π₁(ℂˣ × ℂˣ) ≅ ℤ × ℤ`.  A clean end-to-end exercise of the product pillar of the `π₁` toolkit on a
recognizable space. -/
noncomputable def fundamentalGroupTorus :
    FundamentalGroup (ℂˣ × ℂˣ) (expUnit, expUnit) ≃* Multiplicative ℤ × Multiplicative ℤ :=
  (FundamentalGroup.prodMulEquiv expUnit expUnit).trans
    (MulEquiv.prodCongr fundamentalGroupUnits fundamentalGroupUnits)

/-- **The fundamental group of the `r`-torus is `ℤ^r`.**  Modelling the `r`-dimensional torus as the
finite power `(ℂˣ)^r = (Fin r → ℂˣ)` — each factor `ℂˣ` homotopy-equivalent to a circle — the
Π-indexed product formula (`FundamentalGroup.piMulEquiv`) together with `π₁(ℂˣ) ≅ ℤ`
(`fundamentalGroupUnits`) gives `π₁((ℂˣ)^r) ≅ (Fin r → ℤ)`.  This exhibits every free abelian group
of finite rank as a topological fundamental group, and specializes the product pillar of the `π₁`
toolkit to arbitrary arity. -/
noncomputable def fundamentalGroupPowTorus (r : ℕ) :
    FundamentalGroup (Fin r → ℂˣ) (fun _ => expUnit) ≃* (Fin r → Multiplicative ℤ) :=
  (FundamentalGroup.piMulEquiv (fun _ : Fin r => ℂˣ) (fun _ => expUnit)).trans
    (MulEquiv.piCongrRight (fun _ => fundamentalGroupUnits))

end Complex
