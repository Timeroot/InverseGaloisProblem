import InverseGalois.Rigidity.RET.Pi1.Topological.VanKampen.Existence
import Mathlib.AlgebraicTopology.FundamentalGroupoid.FundamentalGroup
import Mathlib.AlgebraicTopology.FundamentalGroupoid.SimplyConnected
import Mathlib.CategoryTheory.SingleObj
import Mathlib.GroupTheory.Coprod.Basic

/-!
# Seifert–van Kampen: the fundamental-group form

Specialising the groupoid pushout `Rigidity.RET.VanKampen.isPushout` to a basepoint gives the
classical statement: if `X = U ∪ V` with `U`, `V` open, `U ∩ V` simply connected and path
connected, and `x ∈ U ∩ V`, then

`π₁(X, x) ≅ π₁(U, x) ∗ π₁(V, x)`

is the free product of the two fundamental groups.

## Main declarations

* `Rigidity.RET.VanKampen.vertexFunctor` — the retraction of a groupoid onto the vertex group at a
  chosen object, determined by a system of connecting morphisms.
* `Rigidity.RET.VanKampen.exists_hom_of_compatible` — the universal property of `π₁(X, x)`:
  compatible homomorphisms out of `π₁(U, x)` and `π₁(V, x)` extend.
* `Rigidity.RET.VanKampen.closure_range_pi1U_union_pi1V` — `π₁(X, x)` is generated by the images
  of `π₁(U, x)` and `π₁(V, x)`.
* `Rigidity.RET.VanKampen.pi1MulEquivCoprod` — the free-product isomorphism.
-/

universe u v w

open CategoryTheory Set unitInterval FundamentalGroupoid

namespace Rigidity.RET.VanKampen

/-! ### The vertex-group retraction of a groupoid -/

/-- Given a groupoid `C`, an object `c₀`, and a choice of morphism `c y : c₀ ⟶ y` for every
object `y`, the assignment `f ↦ c y ≫ f ≫ (c z)⁻¹` is a functor from `C` to the vertex group
`End c₀`, viewed as a one-object category. -/
def vertexFunctor {C : Type v} [Groupoid.{w} C] (c₀ : C) (c : ∀ y : C, c₀ ⟶ y) :
    C ⥤ SingleObj (End c₀) where
  obj _ := SingleObj.star _
  map {y z} f := (c y ≫ f ≫ Groupoid.inv (c z) : End c₀)
  map_id y := by
    show (c y ≫ 𝟙 y ≫ Groupoid.inv (c y) : End c₀) = 𝟙 _
    simp [Groupoid.inv_eq_inv]
  map_comp {y z w} f g := by
    show (c y ≫ (f ≫ g) ≫ Groupoid.inv (c w) : End c₀)
        = (c y ≫ f ≫ Groupoid.inv (c z)) ≫ c z ≫ g ≫ Groupoid.inv (c w)
    simp [Groupoid.inv_eq_inv]

@[simp]
theorem vertexFunctor_map {C : Type v} [Groupoid.{w} C] (c₀ : C) (c : ∀ y : C, c₀ ⟶ y)
    {y z : C} (f : y ⟶ z) :
    (vertexFunctor c₀ c).map f = c y ≫ f ≫ Groupoid.inv (c z) :=
  rfl

/-- If the connecting morphism at the basepoint is the identity, the retraction is the identity
on the vertex group itself. -/
theorem vertexFunctor_map_self {C : Type v} [Groupoid.{w} C] (c₀ : C) (c : ∀ y : C, c₀ ⟶ y)
    (hc : c c₀ = 𝟙 c₀) (f : End c₀) : (vertexFunctor c₀ c).map f = f := by
  rw [vertexFunctor_map, hc]
  simp [Groupoid.inv_eq_inv]


/-- Two functors into a one-object category agree as soon as they agree on morphisms. -/
theorem functor_singleObj_ext {C : Type v} [Category.{w} C] {G : Type*} [Group G]
    (F₁ F₂ : C ⥤ SingleObj G) (h : ∀ (y z : C) (γ : y ⟶ z), F₁.map γ = F₂.map γ) : F₁ = F₂ :=
  CategoryTheory.Functor.ext (fun _ => rfl) fun y z γ => by simpa using h y z γ

/-! ### Connecting morphisms adapted to the cover -/

variable {X : Type u} [TopologicalSpace X] (U V : Set X) {x : X} (hxU : x ∈ U) (hxV : x ∈ V)

/-- The inclusion-induced homomorphism `π₁(U, x) → π₁(X, x)`. -/
noncomputable def pi1U : FundamentalGroup U ⟨x, hxU⟩ →* FundamentalGroup X x :=
  FundamentalGroup.map (inclUX U) ⟨x, hxU⟩

/-- The inclusion-induced homomorphism `π₁(V, x) → π₁(X, x)`. -/
noncomputable def pi1V : FundamentalGroup V ⟨x, hxV⟩ →* FundamentalGroup X x :=
  FundamentalGroup.map (inclVX V) ⟨x, hxV⟩

theorem pi1U_apply (α : FundamentalGroup U ⟨x, hxU⟩) :
    pi1U U hxU α = (FundamentalGroupoid.map (inclUX U)).map α := rfl

theorem pi1V_apply (α : FundamentalGroup V ⟨x, hxV⟩) :
    pi1V V hxV α = (FundamentalGroupoid.map (inclVX V)).map α := rfl

/-- The two composites `π(U ∩ V) → π(U) → π(X)` and `π(U ∩ V) → π(V) → π(X)` agree. -/
theorem mapW_comp_eq :
    FundamentalGroupoid.map (inclUW U V) ⋙ FundamentalGroupoid.map (inclUX U)
      = FundamentalGroupoid.map (inclVW U V) ⋙ FundamentalGroupoid.map (inclVX V) := by
  rw [← FundamentalGroupoid.map_comp, ← FundamentalGroupoid.map_comp, inclUX_comp_inclUW]

variable [SimplyConnectedSpace (U ∩ V : Set X)]

/-- A choice of morphism from the basepoint to every object of `π(U ∩ V)`. -/
noncomputable def connW (y : FundamentalGroupoid (U ∩ V : Set X)) :
    mk (⟨x, ⟨hxU, hxV⟩⟩ : (U ∩ V : Set X)) ⟶ y :=
  ⟦PathConnectedSpace.somePath _ y.as⟧

theorem connW_self : connW U V hxU hxV (mk ⟨x, ⟨hxU, hxV⟩⟩) = 𝟙 _ :=
  Subsingleton.elim (α := Path.Homotopic.Quotient _ _) _ _

/-- The vertex-group retraction of `π(U ∩ V)` is trivial: the intersection is simply connected. -/
theorem connW_comp_eq_id (y z : FundamentalGroupoid (U ∩ V : Set X)) (γ : y ⟶ z) :
    connW U V hxU hxV y ≫ γ ≫ Groupoid.inv (connW U V hxU hxV z) = 𝟙 _ :=
  Subsingleton.elim (α := Path.Homotopic.Quotient _ _) _ _

variable [PathConnectedSpace U] [PathConnectedSpace V]

open Classical in
/-- A choice of morphism from the basepoint to every object of `π(U)`, chosen inside `U ∩ V`
whenever possible. -/
noncomputable def connU (y : FundamentalGroupoid (U : Set X)) :
    mk (⟨x, hxU⟩ : (U : Set X)) ⟶ y :=
  if h : (y.as : X) ∈ V then
    (FundamentalGroupoid.map (inclUW U V)).map
      (connW U V hxU hxV (mk ⟨(y.as : X), ⟨y.as.2, h⟩⟩))
  else ⟦PathConnectedSpace.somePath _ y.as⟧

open Classical in
/-- A choice of morphism from the basepoint to every object of `π(V)`, chosen inside `U ∩ V`
whenever possible. -/
noncomputable def connV (y : FundamentalGroupoid (V : Set X)) :
    mk (⟨x, hxV⟩ : (V : Set X)) ⟶ y :=
  if h : (y.as : X) ∈ U then
    (FundamentalGroupoid.map (inclVW U V)).map
      (connW U V hxU hxV (mk ⟨(y.as : X), ⟨h, y.as.2⟩⟩))
  else ⟦PathConnectedSpace.somePath _ y.as⟧

omit [PathConnectedSpace (V : Set X)] in
theorem connU_eq (y : FundamentalGroupoid (U : Set X)) (h : (y.as : X) ∈ V) :
    connU U V hxU hxV y = (FundamentalGroupoid.map (inclUW U V)).map
      (connW U V hxU hxV (mk ⟨(y.as : X), ⟨y.as.2, h⟩⟩)) := by
  rw [connU, dif_pos h]

omit [PathConnectedSpace (U : Set X)] in
theorem connV_eq (y : FundamentalGroupoid (V : Set X)) (h : (y.as : X) ∈ U) :
    connV U V hxU hxV y = (FundamentalGroupoid.map (inclVW U V)).map
      (connW U V hxU hxV (mk ⟨(y.as : X), ⟨h, y.as.2⟩⟩)) := by
  rw [connV, dif_pos h]

omit [PathConnectedSpace (V : Set X)] in
/-- On `U ∩ V`, the chosen morphisms of `π(U)` come from `π(U ∩ V)`. -/
theorem connU_map (y : FundamentalGroupoid (U ∩ V : Set X)) :
    connU U V hxU hxV ((FundamentalGroupoid.map (inclUW U V)).obj y)
      = (FundamentalGroupoid.map (inclUW U V)).map (connW U V hxU hxV y) := by
  rw [connU_eq U V hxU hxV ((FundamentalGroupoid.map (inclUW U V)).obj y) y.as.2.2]
  rfl

omit [PathConnectedSpace (U : Set X)] in
/-- On `U ∩ V`, the chosen morphisms of `π(V)` come from `π(U ∩ V)`. -/
theorem connV_map (y : FundamentalGroupoid (U ∩ V : Set X)) :
    connV U V hxU hxV ((FundamentalGroupoid.map (inclVW U V)).obj y)
      = (FundamentalGroupoid.map (inclVW U V)).map (connW U V hxU hxV y) := by
  rw [connV_eq U V hxU hxV ((FundamentalGroupoid.map (inclVW U V)).obj y) y.as.2.1]
  rfl

omit [PathConnectedSpace (V : Set X)] in
theorem connU_self : connU U V hxU hxV (mk ⟨x, hxU⟩) = 𝟙 _ := by
  rw [connU_eq U V hxU hxV _ hxV, connW_self]
  exact (FundamentalGroupoid.map (inclUW U V)).map_id _

omit [PathConnectedSpace (U : Set X)] in
theorem connV_self : connV U V hxU hxV (mk ⟨x, hxV⟩) = 𝟙 _ := by
  rw [connV_eq U V hxU hxV _ hxU, connW_self]
  exact (FundamentalGroupoid.map (inclVW U V)).map_id _

/-! ### Functors into a one-object category out of `π(U)` and `π(V)` -/

variable {G : Type*} [Group G]

/-- The functor `π(U) ⥤ SingleObj G` attached to a homomorphism `π₁(U, x) →* G`. -/
noncomputable def funU (f : FundamentalGroup U ⟨x, hxU⟩ →* G) :
    FundamentalGroupoid (U : Set X) ⥤ SingleObj G :=
  vertexFunctor (mk (⟨x, hxU⟩ : (U : Set X))) (connU U V hxU hxV) ⋙ SingleObj.mapHom _ G f

/-- The functor `π(V) ⥤ SingleObj G` attached to a homomorphism `π₁(V, x) →* G`. -/
noncomputable def funV (g : FundamentalGroup V ⟨x, hxV⟩ →* G) :
    FundamentalGroupoid (V : Set X) ⥤ SingleObj G :=
  vertexFunctor (mk (⟨x, hxV⟩ : (V : Set X))) (connV U V hxU hxV) ⋙ SingleObj.mapHom _ G g

omit [PathConnectedSpace (V : Set X)] in
theorem funU_map (f : FundamentalGroup U ⟨x, hxU⟩ →* G)
    {y z : FundamentalGroupoid (U : Set X)} (γ : y ⟶ z) :
    (funU U V hxU hxV f).map γ
      = f ((vertexFunctor (mk (⟨x, hxU⟩ : (U : Set X))) (connU U V hxU hxV)).map γ) := rfl

omit [PathConnectedSpace (U : Set X)] in
theorem funV_map (g : FundamentalGroup V ⟨x, hxV⟩ →* G)
    {y z : FundamentalGroupoid (V : Set X)} (γ : y ⟶ z) :
    (funV U V hxU hxV g).map γ
      = g ((vertexFunctor (mk (⟨x, hxV⟩ : (V : Set X))) (connV U V hxU hxV)).map γ) := rfl

omit [PathConnectedSpace (V : Set X)] in
/-- The retraction of `π(U)` onto its vertex group kills everything coming from `π(U ∩ V)`. -/
theorem vertexFunctorU_map_inclUW (y z : FundamentalGroupoid (U ∩ V : Set X)) (γ : y ⟶ z) :
    (vertexFunctor (mk (⟨x, hxU⟩ : (U : Set X))) (connU U V hxU hxV)).map
        ((FundamentalGroupoid.map (inclUW U V)).map γ)
      = (1 : End (mk (⟨x, hxU⟩ : (U : Set X)))) := by
  rw [vertexFunctor_map, connU_map, connU_map, Groupoid.inv_eq_inv,
    ← CategoryTheory.Functor.map_inv, ← Functor.map_comp, ← Functor.map_comp,
    ← Groupoid.inv_eq_inv, connW_comp_eq_id, CategoryTheory.Functor.map_id]
  rfl

omit [PathConnectedSpace (U : Set X)] in
/-- The retraction of `π(V)` onto its vertex group kills everything coming from `π(U ∩ V)`. -/
theorem vertexFunctorV_map_inclVW (y z : FundamentalGroupoid (U ∩ V : Set X)) (γ : y ⟶ z) :
    (vertexFunctor (mk (⟨x, hxV⟩ : (V : Set X))) (connV U V hxU hxV)).map
        ((FundamentalGroupoid.map (inclVW U V)).map γ)
      = (1 : End (mk (⟨x, hxV⟩ : (V : Set X)))) := by
  rw [vertexFunctor_map, connV_map, connV_map, Groupoid.inv_eq_inv,
    ← CategoryTheory.Functor.map_inv, ← Functor.map_comp, ← Functor.map_comp,
    ← Groupoid.inv_eq_inv, connW_comp_eq_id, CategoryTheory.Functor.map_id]
  rfl

/-- The two functors `π(U ∩ V) ⥤ SingleObj G` obtained from `f` and `g` agree: both are trivial,
because `U ∩ V` is simply connected. -/
theorem funU_comp_eq_funV (f : FundamentalGroup U ⟨x, hxU⟩ →* G)
    (g : FundamentalGroup V ⟨x, hxV⟩ →* G) :
    FundamentalGroupoid.map (inclUW U V) ⋙ funU U V hxU hxV f
      = FundamentalGroupoid.map (inclVW U V) ⋙ funV U V hxU hxV g :=
  functor_singleObj_ext _ _ fun y z γ => by
    rw [Functor.comp_map, Functor.comp_map, funU_map, funV_map,
      vertexFunctorU_map_inclUW, vertexFunctorV_map_inclVW, map_one, map_one]

variable (hUV : U ∪ V = univ)

open Classical in
/-- A choice of morphism from the basepoint to every object of `π(X)`, restricting to `connU`
on `U` and to `connV` on `V`. -/
noncomputable def connX (y : FundamentalGroupoid X) : mk x ⟶ y :=
  if h : y.as ∈ U then
    (FundamentalGroupoid.map (inclUX U)).map (connU U V hxU hxV (mk ⟨y.as, h⟩))
  else
    (FundamentalGroupoid.map (inclVX V)).map
      (connV U V hxU hxV (mk ⟨y.as, ((hUV ▸ Set.mem_univ y.as : y.as ∈ U ∪ V)).resolve_left h⟩))

theorem connX_eq_U (y : FundamentalGroupoid X) (h : y.as ∈ U) :
    connX U V hxU hxV hUV y
      = (FundamentalGroupoid.map (inclUX U)).map (connU U V hxU hxV (mk ⟨y.as, h⟩)) := by
  rw [connX, dif_pos h]

theorem connX_eq_V (y : FundamentalGroupoid X) (h : y.as ∉ U) (h' : y.as ∈ V) :
    connX U V hxU hxV hUV y
      = (FundamentalGroupoid.map (inclVX V)).map (connV U V hxU hxV (mk ⟨y.as, h'⟩)) := by
  rw [connX, dif_neg h]

theorem connX_of_memU (y : FundamentalGroupoid (U : Set X)) :
    connX U V hxU hxV hUV ((FundamentalGroupoid.map (inclUX U)).obj y)
      = (FundamentalGroupoid.map (inclUX U)).map (connU U V hxU hxV y) := by
  rw [connX_eq_U U V hxU hxV hUV ((FundamentalGroupoid.map (inclUX U)).obj y) y.as.2]
  rfl

theorem connX_of_memV (y : FundamentalGroupoid (V : Set X)) :
    connX U V hxU hxV hUV ((FundamentalGroupoid.map (inclVX V)).obj y)
      = (FundamentalGroupoid.map (inclVX V)).map (connV U V hxU hxV y) := by
  by_cases h : (y.as : X) ∈ U
  · rw [connX_eq_U U V hxU hxV hUV ((FundamentalGroupoid.map (inclVX V)).obj y) h,
      connU_eq U V hxU hxV _ y.as.2, connV_eq U V hxU hxV y h]
    simpa using
      CategoryTheory.Functor.congr_hom (mapW_comp_eq U V)
        (connW U V hxU hxV (mk ⟨(y.as : X), ⟨h, y.as.2⟩⟩))
  · rw [connX_eq_V U V hxU hxV hUV ((FundamentalGroupoid.map (inclVX V)).obj y) h y.as.2]
    rfl

theorem connX_self : connX U V hxU hxV hUV (mk x) = 𝟙 _ := by
  rw [connX_eq_U U V hxU hxV hUV (mk x) hxU, connU_self]
  exact (FundamentalGroupoid.map (inclUX U)).map_id _


/-! ### The universal property of `π₁(X, x)` -/

/-- The retraction of `π(X)` onto `π₁(X, x)`, evaluated on a morphism coming from `π(U)`, is the
image under `π₁(U, x) → π₁(X, x)` of the corresponding retraction in `U`. -/
theorem vertexFunctorX_map_inclU (y z : FundamentalGroupoid (U : Set X)) (γ : y ⟶ z) :
    (vertexFunctor (mk x) (connX U V hxU hxV hUV)).map
        ((FundamentalGroupoid.map (inclUX U)).map γ)
      = pi1U U hxU
          ((vertexFunctor (mk (⟨x, hxU⟩ : (U : Set X))) (connU U V hxU hxV)).map γ) := by
  rw [vertexFunctor_map, connX_of_memU, connX_of_memU, pi1U_apply, vertexFunctor_map]
  simp only [Groupoid.inv_eq_inv, CategoryTheory.Functor.map_comp,
    CategoryTheory.Functor.map_inv]

/-- The retraction of `π(X)` onto `π₁(X, x)`, evaluated on a morphism coming from `π(V)`, is the
image under `π₁(V, x) → π₁(X, x)` of the corresponding retraction in `V`. -/
theorem vertexFunctorX_map_inclV (y z : FundamentalGroupoid (V : Set X)) (γ : y ⟶ z) :
    (vertexFunctor (mk x) (connX U V hxU hxV hUV)).map
        ((FundamentalGroupoid.map (inclVX V)).map γ)
      = pi1V V hxV
          ((vertexFunctor (mk (⟨x, hxV⟩ : (V : Set X))) (connV U V hxU hxV)).map γ) := by
  rw [vertexFunctor_map, connX_of_memV, connX_of_memV, pi1V_apply, vertexFunctor_map]
  simp only [Groupoid.inv_eq_inv, CategoryTheory.Functor.map_comp,
    CategoryTheory.Functor.map_inv]

variable (hUopen : IsOpen U) (hVopen : IsOpen V)

include hUV hUopen hVopen in
/-- **Existence half of Seifert–van Kampen at a basepoint.**  Compatible homomorphisms out of
`π₁(U, x)` and `π₁(V, x)` — automatically compatible, since `U ∩ V` is simply connected — extend
to a homomorphism out of `π₁(X, x)`. -/
theorem exists_hom_of_compatible (f : FundamentalGroup U ⟨x, hxU⟩ →* G)
    (g : FundamentalGroup V ⟨x, hxV⟩ →* G) :
    ∃ h : FundamentalGroup X x →* G,
      h.comp (pi1U U hxU) = f ∧ h.comp (pi1V V hxV) = g := by
  obtain ⟨F, hFU, hFV⟩ := exists_descended_functor U V hUopen hVopen hUV
    (funU U V hxU hxV f) (funV U V hxU hxV g) (funU_comp_eq_funV U V hxU hxV f g)
  refine ⟨(SingleObj.toEnd G).symm.toMonoidHom.comp (F.mapEnd (mk x)), ?_, ?_⟩
  · refine MonoidHom.ext fun α => ?_
    have h1 : ((FundamentalGroupoid.map (inclUX U) ⋙ F).map α : G)
        = ((funU U V hxU hxV f).map α : G) :=
      congrArg (fun (K : FundamentalGroupoid (U : Set X) ⥤ SingleObj G) => (K.map α : G)) hFU
    calc (((SingleObj.toEnd G).symm.toMonoidHom.comp (F.mapEnd (mk x))).comp (pi1U U hxU)) α
        = ((FundamentalGroupoid.map (inclUX U) ⋙ F).map α : G) := rfl
      _ = ((funU U V hxU hxV f).map α : G) := h1
      _ = f ((vertexFunctor (mk (⟨x, hxU⟩ : (U : Set X))) (connU U V hxU hxV)).map α) := rfl
      _ = f α := by rw [vertexFunctor_map_self _ _ (connU_self U V hxU hxV)]
  · refine MonoidHom.ext fun α => ?_
    have h1 : ((FundamentalGroupoid.map (inclVX V) ⋙ F).map α : G)
        = ((funV U V hxU hxV g).map α : G) :=
      congrArg (fun (K : FundamentalGroupoid (V : Set X) ⥤ SingleObj G) => (K.map α : G)) hFV
    calc (((SingleObj.toEnd G).symm.toMonoidHom.comp (F.mapEnd (mk x))).comp (pi1V V hxV)) α
        = ((FundamentalGroupoid.map (inclVX V) ⋙ F).map α : G) := rfl
      _ = ((funV U V hxU hxV g).map α : G) := h1
      _ = g ((vertexFunctor (mk (⟨x, hxV⟩ : (V : Set X))) (connV U V hxU hxV)).map α) := rfl
      _ = g α := by rw [vertexFunctor_map_self _ _ (connV_self U V hxU hxV)]

include hUV hUopen hVopen in
/-- **Uniqueness half of Seifert–van Kampen at a basepoint.**  An endomorphism of `π₁(X, x)`
fixing the images of `π₁(U, x)` and `π₁(V, x)` is the identity. -/
theorem eq_id_of_comp_pi1 (θ : FundamentalGroup X x →* FundamentalGroup X x)
    (hU : θ.comp (pi1U U hxU) = pi1U U hxU) (hV : θ.comp (pi1V V hxV) = pi1V V hxV) :
    θ = MonoidHom.id _ := by
  have hAeq : (vertexFunctor (mk x) (connX U V hxU hxV hUV) ⋙ SingleObj.mapHom _ _ θ)
      = vertexFunctor (mk x) (connX U V hxU hxV hUV) := by
    refine functor_ext_of_restrictions _ _ U V hUopen hVopen hUV ?_ ?_
    · refine functor_singleObj_ext _ _ fun y z γ => ?_
      show θ ((vertexFunctor (mk x) (connX U V hxU hxV hUV)).map
          ((FundamentalGroupoid.map (inclUX U)).map γ)) = _
      rw [CategoryTheory.Functor.comp_map, vertexFunctorX_map_inclU]
      exact DFunLike.congr_fun hU _
    · refine functor_singleObj_ext _ _ fun y z γ => ?_
      show θ ((vertexFunctor (mk x) (connX U V hxU hxV hUV)).map
          ((FundamentalGroupoid.map (inclVX V)).map γ)) = _
      rw [CategoryTheory.Functor.comp_map, vertexFunctorX_map_inclV]
      exact DFunLike.congr_fun hV _
  refine MonoidHom.ext fun α => ?_
  have h2 := congrArg (fun (K : FundamentalGroupoid X ⥤ SingleObj (End (mk x))) =>
      (K.map (α : mk x ⟶ mk x) : End (mk x))) hAeq
  simp only [CategoryTheory.Functor.comp_map] at h2
  rw [vertexFunctor_map_self _ _ (connX_self U V hxU hxV hUV)] at h2
  exact h2


/-! ### The free-product decomposition -/

include hUV hUopen hVopen in
/-- The canonical map from the free product `π₁(U, x) ∗ π₁(V, x)` to `π₁(X, x)` is bijective. -/
theorem coprodLift_bijective :
    Function.Bijective (Monoid.Coprod.lift (pi1U U hxU) (pi1V V hxV)) := by
  obtain ⟨h, hfU, hfV⟩ := exists_hom_of_compatible
    (G := Monoid.Coprod (FundamentalGroup U ⟨x, hxU⟩) (FundamentalGroup V ⟨x, hxV⟩))
    U V hxU hxV hUV hUopen hVopen Monoid.Coprod.inl Monoid.Coprod.inr
  have hΨΦ : h.comp (Monoid.Coprod.lift (pi1U U hxU) (pi1V V hxV)) = MonoidHom.id _ := by
    refine Monoid.Coprod.hom_ext ?_ ?_
    · rw [MonoidHom.comp_assoc, Monoid.Coprod.lift_comp_inl, hfU, MonoidHom.id_comp]
    · rw [MonoidHom.comp_assoc, Monoid.Coprod.lift_comp_inr, hfV, MonoidHom.id_comp]
  have hΦΨ : (Monoid.Coprod.lift (pi1U U hxU) (pi1V V hxV)).comp h = MonoidHom.id _ := by
    refine eq_id_of_comp_pi1 U V hxU hxV hUV hUopen hVopen _ ?_ ?_
    · rw [MonoidHom.comp_assoc, hfU, Monoid.Coprod.lift_comp_inl]
    · rw [MonoidHom.comp_assoc, hfV, Monoid.Coprod.lift_comp_inr]
  exact ⟨Function.LeftInverse.injective (g := h) fun a => DFunLike.congr_fun hΨΦ a,
    Function.RightInverse.surjective (g := h) fun a => DFunLike.congr_fun hΦΨ a⟩

include hUV hUopen hVopen in
/-- **Seifert–van Kampen for fundamental groups.**  For an open cover `X = U ∪ V` with `U`, `V`
path connected and `U ∩ V` simply connected, `π₁(X, x)` is generated by the images of `π₁(U, x)`
and `π₁(V, x)`. -/
theorem closure_range_pi1_union :
    Subgroup.closure (Set.range (pi1U U hxU) ∪ Set.range (pi1V V hxV)) = ⊤ := by
  have key : ∀ w : Monoid.Coprod (FundamentalGroup U ⟨x, hxU⟩) (FundamentalGroup V ⟨x, hxV⟩),
      Monoid.Coprod.lift (pi1U U hxU) (pi1V V hxV) w
        ∈ Subgroup.closure (Set.range (pi1U U hxU) ∪ Set.range (pi1V V hxV)) := by
    intro w
    have hw : w ∈ Submonoid.closure
        (Set.range Monoid.Coprod.inl ∪ Set.range Monoid.Coprod.inr) := by
      rw [Monoid.Coprod.mclosure_range_inl_union_inr]; trivial
    induction hw using Submonoid.closure_induction with
    | mem y hy =>
      rcases hy with ⟨a, rfl⟩ | ⟨a, rfl⟩
      · exact Subgroup.subset_closure (Or.inl ⟨a, rfl⟩)
      · exact Subgroup.subset_closure (Or.inr ⟨a, rfl⟩)
    | one => simp
    | mul a b _ _ ha hb => rw [map_mul]; exact Subgroup.mul_mem _ ha hb
  refine eq_top_iff.2 fun α _ => ?_
  obtain ⟨w, rfl⟩ := (coprodLift_bijective U V hxU hxV hUV hUopen hVopen).2 α
  exact key w

include hUV hUopen hVopen in
/-- **Seifert–van Kampen for fundamental groups**, free-product form: for an open cover
`X = U ∪ V` with `U`, `V` path connected and `U ∩ V` simply connected and containing the
basepoint, `π₁(X, x)` is the free product of `π₁(U, x)` and `π₁(V, x)`. -/
noncomputable def coprodMulEquivPi1 :
    Monoid.Coprod (FundamentalGroup U ⟨x, hxU⟩) (FundamentalGroup V ⟨x, hxV⟩)
      ≃* FundamentalGroup X x :=
  MulEquiv.ofBijective _ (coprodLift_bijective U V hxU hxV hUV hUopen hVopen)

include hUV hUopen hVopen in
/-- The Seifert–van Kampen isomorphism, stated from `π₁(X, x)`. -/
noncomputable def pi1MulEquivCoprod :
    FundamentalGroup X x
      ≃* Monoid.Coprod (FundamentalGroup U ⟨x, hxU⟩) (FundamentalGroup V ⟨x, hxV⟩) :=
  (coprodMulEquivPi1 U V hxU hxV hUV hUopen hVopen).symm

end Rigidity.RET.VanKampen
