import Mathlib
import InverseGalois.Rigidity.RET.Pi1.Topological.RegionVanKampen

/-!
# Loops around the punctures generate

A convex region of the plane with finitely many points removed has its fundamental group generated
by loops around the removed points.  This is the first half of the classical picture of a "spider":
a system of loops, one for each puncture, from which every loop of the region can be built.

The proof is an induction on the number of punctures, cutting the region with a line.  A real
linear functional injective on the punctures singles out one puncture `p` as the strict maximizer;
a line just below `p` cuts the region into a piece `U` containing every other puncture and a piece
`V` containing only `p`.  Seifert–van Kampen expresses the fundamental group of the whole punctured
region in terms of those of the two pieces: `U` has one puncture fewer, so induction applies, and
`V` is a convex region with a single point removed, whose fundamental group is generated by a
single loop around `p`.

Both pieces have to contain the basepoint, and the basepoint is only guaranteed to lie in the strip
between the two cutting lines after it has been dragged there; the loops around the punctures move
with it, so the statement is insensitive to that move.

## Main results

* `Rigidity.RET.exists_linMap_injOn` — a real linear functional separating finitely many points of
  the plane.
* `Rigidity.RET.zpowers_eq_top_of_isPunctureLoop` — a loop around the single missing point of a
  convex region generates its fundamental group.
* `Rigidity.RET.exists_punctureLoops_closure_eq_top` — a punctured convex region carries one loop
  for each puncture, and those loops generate its fundamental group.
* `Rigidity.RET.eq_top_of_isPunctureLoop_mem` — a subgroup of the fundamental group of a punctured
  convex region containing every loop around a puncture is the whole group.
* `Rigidity.RET.exists_punctureLoops_univ`, `Rigidity.RET.exists_punctureLoops_compl` — the same
  generating system for the plane with finitely many points removed.
-/

open Set

noncomputable section

namespace Rigidity.RET

/-! ### A loop around the only missing point generates -/

/-- **A loop winding once around the only missing point of a convex region generates its
fundamental group.** -/
theorem zpowers_eq_top_of_isPunctureLoop {W : Set ℂ} (hconv : Convex ℝ W) {s : ℂ} (hs : s ∈ W)
    {z₀ : ℂ} {hz₀ : z₀ ∈ W \ {s}} {γ : FundamentalGroup ↥(W \ {s}) ⟨z₀, hz₀⟩}
    (hγ : IsPunctureLoop (W \ {s}) s hz₀ γ) : Subgroup.zpowers γ = ⊤ := by
  obtain ⟨ρ, h, b, g, δ, hρ, hgen, rfl⟩ := hγ
  have hball : Metric.ball s ρ ⊆ W := by
    intro z hz
    rcases eq_or_ne z s with rfl | hzs
    · exact hs
    · exact (h ⟨hz, hzs⟩).1
  refine zpowers_mulEquiv_eq_top _ ?_
  exact zpowers_map_eq_top _
    (fundamentalGroup_map_discInclLocal_bijective hconv hρ hball b).surjective hgen

/-! ### A real linear functional separating finitely many points -/

/-- A one-parameter family of real linear functionals on the plane. -/
def linMap (t : ℝ) : ℂ →ₗ[ℝ] ℝ := Complex.reLm + t • Complex.imLm

theorem linMap_apply (t : ℝ) (z : ℂ) : linMap t z = z.re + t * z.im := rfl

theorem isLinearMap_linMap (t : ℝ) : IsLinearMap ℝ (linMap t) := (linMap t).isLinear

theorem continuous_linMap (t : ℝ) : Continuous (linMap t) := by
  show Continuous fun z : ℂ => z.re + t * z.im
  fun_prop

@[simp] theorem linMap_ofReal (t : ℝ) (r : ℝ) : linMap t ((r : ℝ) : ℂ) = r := by
  simp [linMap_apply]

/-- **A real linear functional can be chosen injective on any finite set of points.**  Two points
are confused by at most one member of the family `z ↦ z.re + t * z.im`, so all but finitely many
parameters work. -/
theorem exists_linMap_injOn {S : Set ℂ} (hS : S.Finite) : ∃ t : ℝ, Set.InjOn (linMap t) S := by
  classical
  set bad : Finset ℝ :=
    (hS.toFinset ×ˢ hS.toFinset).image fun q => (q.2.re - q.1.re) / (q.1.im - q.2.im) with hbad
  obtain ⟨t, ht⟩ := Infinite.exists_notMem_finset bad
  refine ⟨t, fun q hq q' hq' hqq' => ?_⟩
  simp only [linMap_apply] at hqq'
  by_cases him : q.im = q'.im
  · exact Complex.ext (by rw [him] at hqq'; linarith) him
  · refine absurd ?_ ht
    have hne : q.im - q'.im ≠ 0 := sub_ne_zero.2 him
    refine Finset.mem_image.2 ⟨(q, q'), ?_, ?_⟩
    · simp [Finset.mem_product, hS.mem_toFinset, hq, hq']
    · rw [div_eq_iff hne]
      have hexp : t * (q.im - q'.im) = t * q.im - t * q'.im := by ring
      linarith

/-- A strict maximizer of a functional that is injective on a finite set. -/
theorem exists_strict_max {T : Set ℂ} (hT : T.Finite) (hne : T.Nonempty) {t : ℝ}
    (hinj : Set.InjOn (linMap t) T) :
    ∃ p ∈ T, ∀ q ∈ T, q ≠ p → linMap t q < linMap t p := by
  obtain ⟨p, hp, hmax⟩ := Set.exists_max_image T (linMap t) hT hne
  refine ⟨p, hp, fun q hq hqp => ?_⟩
  rcases (hmax q hq).lt_or_eq with h | h
  · exact h
  · exact absurd (hinj hq hp h) hqp

/-- A strict bound below the maximum, above every other value. -/
theorem exists_second_bound {T : Set ℂ} (hT : T.Finite) {t : ℝ} {p : ℂ}
    (hpmax : ∀ q ∈ T, q ≠ p → linMap t q < linMap t p) :
    ∃ μ : ℝ, μ < linMap t p ∧ ∀ q ∈ T, q ≠ p → linMap t q ≤ μ := by
  rcases (T \ {p}).eq_empty_or_nonempty with hemp | hne
  · refine ⟨linMap t p - 1, by linarith, fun q hq hqp => ?_⟩
    have : q ∈ T \ {p} := ⟨hq, hqp⟩
    rw [hemp] at this
    exact absurd this (by simp)
  · obtain ⟨m, hm, hmax⟩ := Set.exists_max_image (T \ {p}) (linMap t) hT.diff hne
    exact ⟨linMap t m, hpmax m hm.1 hm.2, fun q hq hqp => hmax q ⟨hq, hqp⟩⟩

/-! ### The inductive step: cutting the region with a line -/

/-- **A punctured convex region carries a system of generators winding around the punctures.**
Stated with an explicit count of the punctures inside the region, which the induction consumes. -/
theorem exists_punctureLoops_closure_eq_top_aux (n : ℕ) :
    ∀ (W : Set ℂ), Convex ℝ W → IsOpen W → ∀ S : Set ℂ, S.Finite → (S ∩ W).ncard = n →
      ∀ (z₀ : ℂ) (hz₀ : z₀ ∈ W \ S),
        ∃ γ : ℂ → FundamentalGroup ↥(W \ S) ⟨z₀, hz₀⟩,
          (∀ s ∈ S ∩ W, IsPunctureLoop (W \ S) s hz₀ (γ s)) ∧
            Subgroup.closure (γ '' (S ∩ W)) = ⊤ := by
  induction n using Nat.strong_induction_on with
  | _ n IH =>
  intro W hconv hW S hS hcard z₀ hz₀
  classical
  have hTfin : (S ∩ W).Finite := hS.inter_of_left W
  by_cases hTempty : S ∩ W = ∅
  · -- no punctures: the region is convex, hence simply connected
    have hWS : W \ S = W := by
      refine Set.Subset.antisymm Set.diff_subset fun z hz => ⟨hz, fun hzS => ?_⟩
      have : z ∈ S ∩ W := ⟨hzS, hz⟩
      rw [hTempty] at this
      exact absurd this (by simp)
    have hconv' : Convex ℝ (W \ S) := by rw [hWS]; exact hconv
    haveI := hconv'.contractibleSpace ⟨z₀, hz₀⟩
    haveI : Subsingleton (FundamentalGroup ↥(W \ S) ⟨z₀, hz₀⟩) :=
      inferInstanceAs (Subsingleton (Path.Homotopic.Quotient
        (⟨z₀, hz₀⟩ : ↥(W \ S)) (⟨z₀, hz₀⟩ : ↥(W \ S))))
    refine ⟨fun _ => 1, ?_, ?_⟩
    · intro s hs
      rw [hTempty] at hs
      exact absurd hs (by simp)
    · refine (Subgroup.eq_top_iff' _).2 fun x => ?_
      rw [Subsingleton.elim x 1]
      exact one_mem _
  -- choose a direction, the extreme puncture, and the two cutting lines
  obtain ⟨t, hinj⟩ := exists_linMap_injOn hTfin
  obtain ⟨p, hpT, hpmax⟩ := exists_strict_max hTfin (Set.nonempty_iff_ne_empty.2 hTempty) hinj
  obtain ⟨μ, hμlt, hμge⟩ := exists_second_bound hTfin hpmax
  obtain ⟨ε, hε, hball⟩ := Metric.isOpen_iff.mp hW p hpT.2
  set d : ℝ := min ε (linMap t p - μ) with hddef
  have hd : 0 < d := lt_min hε (by linarith)
  have hdε : d ≤ ε := min_le_left _ _
  have hdμ : d ≤ linMap t p - μ := min_le_right _ _
  set a : ℝ := linMap t p - d / 2 with hadef
  set c : ℝ := linMap t p - d / 4 with hcdef
  have hμa : μ < a := by simp only [hadef]; linarith
  have hac : a < c := by simp only [hadef, hcdef]; linarith
  have hcp : c < linMap t p := by simp only [hcdef]; linarith
  -- the two convex pieces of the region
  set WU : Set ℂ := W ∩ {z | linMap t z < c} with hWUdef
  set WV : Set ℂ := W ∩ {z | a < linMap t z} with hWVdef
  have hconvU : Convex ℝ WU := hconv.inter (convex_halfSpace_lt (isLinearMap_linMap t) c)
  have hconvV : Convex ℝ WV := hconv.inter (convex_halfSpace_gt (isLinearMap_linMap t) a)
  have hWUopen : IsOpen WU := hW.inter (isOpen_lt (continuous_linMap t) continuous_const)
  have hWVopen : IsOpen WV := hW.inter (isOpen_lt continuous_const (continuous_linMap t))
  -- the basepoint of the cut, on the segment from `p` towards smaller values of the functional
  set z₁ : ℂ := p - ((3 * d / 8 : ℝ) : ℂ) with hz₁def
  have hlinz₁ : linMap t z₁ = linMap t p - 3 * d / 8 := by
    rw [hz₁def, map_sub, linMap_ofReal]
  have hz₁W : z₁ ∈ W := by
    refine hball ?_
    have hsub : z₁ - p = -((3 * d / 8 : ℝ) : ℂ) := by rw [hz₁def]; ring
    rw [Metric.mem_ball, Complex.dist_eq, hsub, norm_neg, Complex.norm_real, Real.norm_eq_abs,
      abs_of_pos (by linarith : (0:ℝ) < 3 * d / 8)]
    linarith
  have hz₁a : a < linMap t z₁ := by rw [hlinz₁, hadef]; linarith
  have hz₁c : linMap t z₁ < c := by rw [hlinz₁, hcdef]; linarith
  have hz₁p : z₁ ≠ p := by
    intro hcon
    rw [hcon] at hlinz₁
    linarith
  have hz₁S : z₁ ∉ S := by
    intro hcon
    have hqT : z₁ ∈ S ∩ W := ⟨hcon, hz₁W⟩
    exact absurd (hμge z₁ hqT hz₁p) (by linarith)
  have hz₁U : z₁ ∈ WU \ S := ⟨⟨hz₁W, hz₁c⟩, hz₁S⟩
  have hz₁V : z₁ ∈ WV \ {p} := ⟨⟨hz₁W, hz₁a⟩, hz₁p⟩
  have hz₁Ω : z₁ ∈ W \ S := ⟨hz₁W, hz₁S⟩
  -- the two pieces sit inside the punctured region and cover it
  have hUsub : WU \ S ⊆ W \ S := fun z hz => ⟨hz.1.1, hz.2⟩
  have hVsub : WV \ {p} ⊆ W \ S := by
    refine fun z hz => ⟨hz.1.1, fun hzS => ?_⟩
    have hzT : z ∈ S ∩ W := ⟨hzS, hz.1.1⟩
    have hza : a < linMap t z := hz.1.2
    exact absurd (hμge z hzT hz.2) (by linarith)
  have hcover : W \ S ⊆ (WU \ S) ∪ (WV \ {p}) := by
    intro z hz
    rcases lt_or_ge (linMap t z) c with hlt | hge
    · exact Or.inl ⟨⟨hz.1, hlt⟩, hz.2⟩
    · exact Or.inr ⟨⟨hz.1, show a < linMap t z by linarith⟩, fun hcon => hz.2 (hcon ▸ hpT.1)⟩
  -- path connectivity of the two pieces and of their overlap
  haveI : PathConnectedSpace ↥(WU \ S) :=
    Convex.pathConnectedSpace_diff_countable_complex hconvU hWUopen hS.countable ⟨z₁, hz₁U⟩
  haveI : PathConnectedSpace ↥(WV \ {p}) :=
    Convex.pathConnectedSpace_diff_countable_complex hconvV hWVopen
      (Set.countable_singleton p) ⟨z₁, hz₁V⟩
  have hinter : (WU \ S) ∩ (WV \ {p}) = WU ∩ WV := by
    refine Set.Subset.antisymm (fun z hz => ⟨hz.1.1, hz.2.1⟩) fun z hz => ?_
    have hzS : z ∉ S := by
      intro hcon
      have hzT : z ∈ S ∩ W := ⟨hcon, hz.1.1⟩
      have hzc : linMap t z < c := hz.1.2
      have hza : a < linMap t z := hz.2.2
      rcases eq_or_ne z p with rfl | hzp
      · linarith
      · have := hμge z hzT hzp
        linarith
    exact ⟨⟨hz.1, hzS⟩, ⟨hz.2, fun hcon => hzS (hcon ▸ hpT.1)⟩⟩
  haveI : PathConnectedSpace ↥((WU \ S) ∩ (WV \ {p})) := by
    rw [hinter]
    exact isPathConnected_iff_pathConnectedSpace.mp
      ((hconvU.inter hconvV).isPathConnected ⟨z₁, ⟨hz₁W, hz₁c⟩, hz₁W, hz₁a⟩)
  -- move the basepoint into the overlap
  haveI : PathConnectedSpace ↥(W \ S) :=
    Convex.pathConnectedSpace_diff_countable_complex hconv hW hS.countable ⟨z₀, hz₀⟩
  set ω : Path (⟨z₀, hz₀⟩ : ↥(W \ S)) ⟨z₁, hz₁Ω⟩ := PathConnectedSpace.somePath _ _ with hωdef
  set e := FundamentalGroup.fundamentalGroupMulEquivOfPath ω with hedef
  -- the punctures split into those below the cut and the extreme one
  have hpWU : p ∉ WU := fun hcon =>
    absurd (show linMap t p < c from hcon.2) (not_lt.2 hcp.le)
  have hsplit : S ∩ W = (S ∩ WU) ∪ {p} := by
    refine Set.Subset.antisymm (fun q hq => ?_) (fun q hq => ?_)
    · rcases eq_or_ne q p with rfl | hqp
      · exact Or.inr rfl
      · have := hμge q hq hqp
        exact Or.inl ⟨hq.1, hq.2, show linMap t q < c by linarith⟩
    · rcases hq with hq | hq
      · exact ⟨hq.1, hq.2.1⟩
      · rw [show q = p from hq]
        exact hpT
  -- the first piece has one puncture fewer, so the induction hypothesis applies
  have hlt : (S ∩ WU).ncard < n := by
    rw [← hcard]
    exact Set.ncard_lt_ncard ⟨fun z hz => ⟨hz.1, hz.2.1⟩, fun hsub => hpWU (hsub hpT).2⟩ hTfin
  obtain ⟨γU, hγU, hγUtop⟩ := IH _ hlt WU hconvU hWUopen S hS rfl z₁ hz₁U
  -- the second piece has a single puncture, around which one loop generates
  have hpV : p ∈ WV := ⟨hpT.2, show a < linMap t p by linarith⟩
  obtain ⟨ρ, hρ, hρsub⟩ := exists_radius hWVopen hpV (Set.finite_singleton p)
  obtain ⟨γp, hγp⟩ := exists_isPunctureLoop hρ hρsub hz₁V
  have hgenp : Subgroup.zpowers γp = ⊤ := zpowers_eq_top_of_isPunctureLoop hconvV hpV hγp
  -- the two inclusions of the pieces into the punctured region
  set f : FundamentalGroup ↥(WU \ S) ⟨z₁, hz₁U⟩ →* FundamentalGroup ↥(W \ S) ⟨z₁, hz₁Ω⟩ :=
    FundamentalGroup.map (subsetIncl hUsub) (⟨z₁, hz₁U⟩ : ↥(WU \ S)) with hfdef
  set g : FundamentalGroup ↥(WV \ {p}) ⟨z₁, hz₁V⟩ →* FundamentalGroup ↥(W \ S) ⟨z₁, hz₁Ω⟩ :=
    FundamentalGroup.map (subsetIncl hVsub) (⟨z₁, hz₁V⟩ : ↥(WV \ {p})) with hgdef
  -- the system of loops: those of the first piece, together with one around the extreme puncture
  set Γ : ℂ → FundamentalGroup ↥(W \ S) ⟨z₀, hz₀⟩ :=
    fun s => if s = p then e.symm (g γp) else e.symm (f (γU s)) with hΓdef
  have hΓp : Γ p = e.symm (g γp) := if_pos rfl
  have hΓne : ∀ s, s ≠ p → Γ s = e.symm (f (γU s)) := fun s hs => if_neg hs
  refine ⟨Γ, fun s hs => ?_, ?_⟩
  · by_cases hsp : s = p
    · subst hsp
      rw [hΓp]
      exact (hγp.mono hVsub).transport_symm ω
    · have hsU : s ∈ S ∩ WU := by
        rw [hsplit] at hs
        rcases hs with h | h
        · exact h
        · exact absurd h hsp
      rw [hΓne s hsp]
      exact ((hγU s hsU).mono hUsub).transport_symm ω
  · set N := Subgroup.closure (Γ '' (S ∩ W)) with hNdef
    have hM : ∀ s ∈ S ∩ W, e (Γ s) ∈ N.map e.toMonoidHom := fun s hs =>
      Subgroup.mem_map.2 ⟨Γ s, Subgroup.subset_closure ⟨s, hs, rfl⟩, rfl⟩
    have hgp : g γp ∈ N.map e.toMonoidHom := by
      have h := hM p hpT
      rwa [hΓp, MulEquiv.apply_symm_apply] at h
    have hfU : ∀ s ∈ S ∩ WU, f (γU s) ∈ N.map e.toMonoidHom := by
      intro s hs
      have hsW : s ∈ S ∩ W := by rw [hsplit]; exact Or.inl hs
      have hsp : s ≠ p := fun hcon => hpWU (hcon ▸ hs.2)
      have h := hM s hsW
      rwa [hΓne s hsp, MulEquiv.apply_symm_apply] at h
    -- the whole of each piece lands in the subgroup generated by the system
    have hNU : ∀ x, f x ∈ N.map e.toMonoidHom := by
      have h1 : Subgroup.map f (Subgroup.closure (γU '' (S ∩ WU)))
          = Subgroup.closure (f '' (γU '' (S ∩ WU))) := MonoidHom.map_closure f _
      rw [hγUtop] at h1
      intro x
      have hx : f x ∈ Subgroup.map f ⊤ := ⟨x, Subgroup.mem_top x, rfl⟩
      rw [h1] at hx
      refine (Subgroup.closure_le _).2 ?_ hx
      rintro y ⟨_, ⟨s, hs, rfl⟩, rfl⟩
      exact hfU s hs
    have hNV : ∀ x, g x ∈ N.map e.toMonoidHom := by
      intro x
      obtain ⟨k, rfl⟩ := Subgroup.mem_zpowers_iff.mp (hgenp.ge (Subgroup.mem_top x))
      rw [map_zpow]
      exact zpow_mem hgp k
    -- Seifert–van Kampen, and back to the original basepoint
    have htop : N.map e.toMonoidHom = ⊤ :=
      eq_top_of_cover hUsub hVsub hcover (hWUopen.sdiff hS.isClosed)
        (hWVopen.sdiff isClosed_singleton) hz₁U hz₁V hNU hNV
    refine (Subgroup.eq_top_iff' N).2 fun x => ?_
    obtain ⟨y, hy, hyx⟩ := Subgroup.mem_map.1 (htop.ge (Subgroup.mem_top (e x)))
    rwa [e.injective hyx] at hy

/-- **A punctured convex region carries a system of generators winding around the punctures.**
There is one loop for each removed point lying in the region, and together they generate the
fundamental group. -/
theorem exists_punctureLoops_closure_eq_top {W : Set ℂ} (hconv : Convex ℝ W) (hW : IsOpen W)
    {S : Set ℂ} (hS : S.Finite) {z₀ : ℂ} (hz₀ : z₀ ∈ W \ S) :
    ∃ γ : ℂ → FundamentalGroup ↥(W \ S) ⟨z₀, hz₀⟩,
      (∀ s ∈ S ∩ W, IsPunctureLoop (W \ S) s hz₀ (γ s)) ∧
        Subgroup.closure (γ '' (S ∩ W)) = ⊤ :=
  exists_punctureLoops_closure_eq_top_aux (S ∩ W).ncard W hconv hW S hS rfl z₀ hz₀

/-- **Loops around the punctures generate the fundamental group of a punctured convex region.** -/
theorem eq_top_of_isPunctureLoop_mem {W : Set ℂ} (hconv : Convex ℝ W) (hW : IsOpen W) {S : Set ℂ}
    (hS : S.Finite) {z₀ : ℂ} (hz₀ : z₀ ∈ W \ S)
    {N : Subgroup (FundamentalGroup ↥(W \ S) ⟨z₀, hz₀⟩)}
    (hN : ∀ s ∈ S, ∀ γ : FundamentalGroup ↥(W \ S) ⟨z₀, hz₀⟩,
      IsPunctureLoop (W \ S) s hz₀ γ → γ ∈ N) : N = ⊤ := by
  obtain ⟨Γ, hΓ, hΓtop⟩ := exists_punctureLoops_closure_eq_top hconv hW hS hz₀
  refine eq_top_iff.2 ?_
  rw [← hΓtop]
  refine (Subgroup.closure_le N).2 ?_
  rintro x ⟨s, hs, rfl⟩
  exact hN s hs.1 _ (hΓ s hs)

/-! ### The punctured plane -/

/-- The generating system of `exists_punctureLoops_closure_eq_top`, for a region presented in any
way as a convex region with a finite set removed. -/
theorem exists_punctureLoops_of_eq {X W S : Set ℂ} (hX : X = W \ S) (hconv : Convex ℝ W)
    (hW : IsOpen W) (hS : S.Finite) {z₀ : ℂ} (hz₀ : z₀ ∈ X) :
    ∃ γ : ℂ → FundamentalGroup ↥X ⟨z₀, hz₀⟩,
      (∀ s ∈ S ∩ W, IsPunctureLoop X s hz₀ (γ s)) ∧
        Subgroup.closure (γ '' (S ∩ W)) = ⊤ := by
  subst hX
  exact exists_punctureLoops_closure_eq_top hconv hW hS hz₀

/-- **The fundamental group of the plane with finitely many points removed is generated by loops
winding around the removed points**, one for each. -/
theorem exists_punctureLoops_univ {S : Set ℂ} (hS : S.Finite) {z₀ : ℂ}
    (hz₀ : z₀ ∈ (Set.univ : Set ℂ) \ S) :
    ∃ γ : ℂ → FundamentalGroup ↥((Set.univ : Set ℂ) \ S) ⟨z₀, hz₀⟩,
      (∀ s ∈ S, IsPunctureLoop ((Set.univ : Set ℂ) \ S) s hz₀ (γ s)) ∧
        Subgroup.closure (γ '' S) = ⊤ := by
  obtain ⟨γ, hγ, htop⟩ := exists_punctureLoops_closure_eq_top convex_univ isOpen_univ hS hz₀
  rw [Set.inter_univ] at hγ htop
  exact ⟨γ, hγ, htop⟩

/-- **The fundamental group of the complement of a finite set in the plane is generated by loops
winding around the missing points**, one for each. -/
theorem exists_punctureLoops_compl {S : Set ℂ} (hS : S.Finite) {z₀ : ℂ} (hz₀ : z₀ ∈ Sᶜ) :
    ∃ γ : ℂ → FundamentalGroup ↥(Sᶜ) ⟨z₀, hz₀⟩,
      (∀ s ∈ S, IsPunctureLoop Sᶜ s hz₀ (γ s)) ∧ Subgroup.closure (γ '' S) = ⊤ := by
  obtain ⟨γ, hγ, htop⟩ :=
    exists_punctureLoops_of_eq (Set.compl_eq_univ_diff S) convex_univ isOpen_univ hS hz₀
  rw [Set.inter_univ] at hγ htop
  exact ⟨γ, hγ, htop⟩

end Rigidity.RET

end
