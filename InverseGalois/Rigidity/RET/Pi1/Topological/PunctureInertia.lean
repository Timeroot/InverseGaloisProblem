import Mathlib
import InverseGalois.Rigidity.RET.Pi1.Topological.PunctureLoop

/-!
# The local monodromy group at a puncture

A loop winding once around a puncture is the image of a generator of the fundamental group of a
small punctured disc about it, dragged back to the basepoint along a path.  That fundamental group
is infinite cyclic, so *everything* the punctured disc contributes to the monodromy of a covering is
already contributed by the one loop: the image of the local fundamental group is the cyclic group
generated by the value on the loop.

This is the topological form of the statement that a branch cycle *generates* the inertia group at
its branch point, rather than merely lying in it.

## Main definitions

* `Rigidity.RET.localHom` — the map on fundamental groups induced by a punctured disc inside a
  region, followed by transport to the basepoint.

## Main results

* `Rigidity.RET.range_localHom` — the local fundamental group has cyclic image, generated by the
  puncture loop.
* `Rigidity.RET.IsPunctureLoop.exists_range_eq_zpowers` — the image of the local monodromy of a
  covering at a puncture is generated by the value on a loop winding once around it.
-/

open Topology

noncomputable section

namespace Rigidity.RET

/-- **The local contribution of a punctured disc to the fundamental group of a region.**  A
punctured disc `puncturedDisc s ρ` inside a region `X` of the plane, together with a path `δ` from
its basepoint to the basepoint of `X`, induces a map of fundamental groups. -/
def localHom {X : Set ℂ} {s : ℂ} {ρ : ℝ} (hsub : puncturedDisc s ρ ⊆ X)
    (b : ↥(puncturedDisc s ρ)) {z₀ : ℂ} {hz₀ : z₀ ∈ X}
    (δ : Path (discIncl hsub b) (⟨z₀, hz₀⟩ : ↥X)) :
    FundamentalGroup ↥(puncturedDisc s ρ) b →* FundamentalGroup ↥X ⟨z₀, hz₀⟩ :=
  (FundamentalGroup.fundamentalGroupMulEquivOfPath δ).toMonoidHom.comp
    (FundamentalGroup.map (discIncl hsub) b)

@[simp]
theorem localHom_apply {X : Set ℂ} {s : ℂ} {ρ : ℝ} (hsub : puncturedDisc s ρ ⊆ X)
    (b : ↥(puncturedDisc s ρ)) {z₀ : ℂ} {hz₀ : z₀ ∈ X}
    (δ : Path (discIncl hsub b) (⟨z₀, hz₀⟩ : ↥X))
    (g : FundamentalGroup ↥(puncturedDisc s ρ) b) :
    localHom hsub b δ g
      = FundamentalGroup.fundamentalGroupMulEquivOfPath δ
          (FundamentalGroup.map (discIncl hsub) b g) := rfl

/-- **The local fundamental group at a puncture has cyclic image**, generated by the image of a
generator: the fundamental group of a punctured disc is infinite cyclic. -/
theorem range_localHom {X : Set ℂ} {s : ℂ} {ρ : ℝ} (hsub : puncturedDisc s ρ ⊆ X)
    {b : ↥(puncturedDisc s ρ)} {z₀ : ℂ} {hz₀ : z₀ ∈ X}
    (δ : Path (discIncl hsub b) (⟨z₀, hz₀⟩ : ↥X))
    {g : FundamentalGroup ↥(puncturedDisc s ρ) b} (hg : Subgroup.zpowers g = ⊤) :
    (localHom hsub b δ).range = Subgroup.zpowers (localHom hsub b δ g) := by
  rw [MonoidHom.range_eq_map, ← hg, MonoidHom.map_zpowers]

/-- **A loop winding once around a puncture names the whole local monodromy there.**

For any homomorphism out of the fundamental group of the region — the monodromy of a covering, say
— the image of the fundamental group of a small punctured disc about the puncture is the cyclic
group generated by the value on the loop. -/
theorem IsPunctureLoop.exists_range_eq_zpowers {X : Set ℂ} {s z₀ : ℂ} {hz₀ : z₀ ∈ X}
    {γ : FundamentalGroup ↥X ⟨z₀, hz₀⟩} (hγ : IsPunctureLoop X s hz₀ γ)
    {H : Type*} [Group H] (φ : FundamentalGroup ↥X ⟨z₀, hz₀⟩ →* H) :
    ∃ (ρ : ℝ) (hsub : puncturedDisc s ρ ⊆ X) (b : ↥(puncturedDisc s ρ))
      (δ : Path (discIncl hsub b) (⟨z₀, hz₀⟩ : ↥X)),
      0 < ρ ∧ (φ.comp (localHom hsub b δ)).range = Subgroup.zpowers (φ γ) := by
  obtain ⟨ρ, hsub, b, g, δ, hρ, hg, hγeq⟩ := hγ
  refine ⟨ρ, hsub, b, δ, hρ, ?_⟩
  rw [MonoidHom.range_eq_map, ← Subgroup.map_map, ← MonoidHom.range_eq_map,
    range_localHom hsub δ hg, MonoidHom.map_zpowers]
  exact congrArg Subgroup.zpowers (congrArg φ hγeq.symm)

end Rigidity.RET

end
