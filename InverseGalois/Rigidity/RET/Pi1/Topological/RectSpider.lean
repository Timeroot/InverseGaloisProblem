import Mathlib
import InverseGalois.Rigidity.RET.Pi1.Topological.RectFrame

/-!
# The boundary loop of a rectangle as a generating product of puncture loops

Fix a set `S` of punctures, a subset `X` of the plane containing the punctured frame, and a frame
`V` around a rectangle.  The predicate `RectSpider X S V x₀ x₁ y₀ y₁` says that the boundary loop
of the rectangle, based at its bottom-left corner, is an ordered product of loops winding once
around each puncture inside it, *and* that those loops already generate every loop of `X` that
lives in the punctured frame.

The generation clause is what the frame is for.  Cutting a rectangle in two, the boundary loops of
the halves are read inside two overlapping half-frames, and the Seifert–van Kampen theorem says
their loops generate the loops of the whole frame; at the leaf, a square around a single puncture
sits in a frame whose punctured fundamental group is generated by one loop around it.  Taking the
top frame to be the whole plane, the loops produced by the induction generate the whole fundamental
group of the punctured plane.

This file records the three ways the predicate is produced: a rectangle without punctures, a
rectangle cut in two by a vertical or a horizontal line, and a small square centred at a single
puncture.  Together they are the inductive step, the base case and the leaf of the induction on the
number of punctures.

## Main results

* `Rigidity.RET.rectSpider_of_empty` — a rectangle containing no puncture.
* `Rigidity.RET.rectSpider_of_cut_vert`, `Rigidity.RET.rectSpider_of_cut_horiz` — cutting a
  rectangle along a line missing every puncture.
* `Rigidity.RET.rectSpider_of_single` — a square of half-side `a` centred at a puncture, whose
  frame contains the disc of radius `2 * a` and no other puncture.
-/

open scoped unitInterval

noncomputable section

namespace Rigidity.RET

/-- The boundary loop of the rectangle is an ordered product of loops around the punctures of `S`
that it contains, and those loops generate every loop of `X` living in the punctured frame `V`. -/
def RectSpider (X S V : Set ℂ) (x₀ x₁ y₀ y₁ : ℝ) : Prop :=
  ∀ (hVX : V \ S ⊆ X)
    (hab : seg (cpt x₀ y₀) (cpt x₁ y₀) ⊆ V \ S) (hbc : seg (cpt x₁ y₀) (cpt x₁ y₁) ⊆ V \ S)
    (hcd : seg (cpt x₁ y₁) (cpt x₀ y₁) ⊆ V \ S) (hda : seg (cpt x₀ y₁) (cpt x₀ y₀) ⊆ V \ S),
    IsPunctureProd X (S ∩ rect x₀ x₁ y₀ y₁) (hVX (hab (left_mem_seg _ _)))
      (FundamentalGroup.fromPath (boxLoop (hab.trans hVX) (hbc.trans hVX) (hcd.trans hVX)
        (hda.trans hVX)))
      (pi1Image hVX (hab (left_mem_seg _ _)))

/-- The constant loop is the identity of the fundamental group. -/
theorem fromPath_refl {Y : Type*} [TopologicalSpace Y] (x : Y) :
    FundamentalGroup.fromPath (Path.Homotopic.Quotient.refl x) = 1 := rfl

/-- A segment of a punctured region that stays in a further region stays in the punctured
intersection. -/
theorem seg_subset_inter_diff {S V W : Set ℂ} {a b : ℂ} (hsub : seg a b ⊆ V \ S)
    (hW : seg a b ⊆ W) : seg a b ⊆ (V ∩ W) \ S :=
  fun _ hz => ⟨⟨(hsub hz).1, hW hz⟩, (hsub hz).2⟩

/-- A rectangle to the left of a line sits in the half-plane grown past that line. -/
theorem rect_subset_reLt {x₀ x₁ y₀ y₁ c m : ℝ} (h : x₁ ≤ c) (hm : 0 < m) :
    rect x₀ x₁ y₀ y₁ ⊆ {z : ℂ | z.re < c + m} := fun _ hz => by
  simp only [Set.mem_setOf_eq]; have := hz.2.1; linarith

/-- A rectangle to the right of a line sits in the half-plane grown past that line. -/
theorem rect_subset_reGt {x₀ x₁ y₀ y₁ c m : ℝ} (h : c ≤ x₀) (hm : 0 < m) :
    rect x₀ x₁ y₀ y₁ ⊆ {z : ℂ | c - m < z.re} := fun _ hz => by
  simp only [Set.mem_setOf_eq]; have := hz.1; linarith

/-- A rectangle below a line sits in the half-plane grown past that line. -/
theorem rect_subset_imLt {x₀ x₁ y₀ y₁ d m : ℝ} (h : y₁ ≤ d) (hm : 0 < m) :
    rect x₀ x₁ y₀ y₁ ⊆ {z : ℂ | z.im < d + m} := fun _ hz => by
  simp only [Set.mem_setOf_eq]; have := hz.2.2.2; linarith

/-- A rectangle above a line sits in the half-plane grown past that line. -/
theorem rect_subset_imGt {x₀ x₁ y₀ y₁ d m : ℝ} (h : d ≤ y₀) (hm : 0 < m) :
    rect x₀ x₁ y₀ y₁ ⊆ {z : ℂ | d - m < z.im} := fun _ hz => by
  simp only [Set.mem_setOf_eq]; have := hz.2.2.1; linarith

/-! ### Base case -/

/-- **A rectangle containing no puncture** has null-homotopic boundary loop, the empty product,
and its frame is convex, hence contributes no loops. -/
theorem rectSpider_of_empty {X S V : Set ℂ} {x₀ x₁ y₀ y₁ : ℝ} (hx : x₀ ≤ x₁) (hy : y₀ ≤ y₁)
    (hfr : RectFrame S V x₀ x₁ y₀ y₁) (hempty : S ∩ rect x₀ x₁ y₀ y₁ = ∅) :
    RectSpider X S V x₀ x₁ y₀ y₁ := by
  intro hVX hab hbc hcd hda
  have hSV : ∀ z, z ∈ S → z ∈ V → False := by
    intro z hzS hzV
    have : z ∈ S ∩ rect x₀ x₁ y₀ y₁ := ⟨hzS, hfr.inter_subset ⟨hzS, hzV⟩⟩
    rw [hempty] at this
    exact this
  have hVS : V \ S = V := by
    ext z
    exact ⟨fun h => h.1, fun h => ⟨h, fun hzS => hSV z hzS h⟩⟩
  have hconv : Convex ℝ (V \ S) := by rw [hVS]; exact hfr.isConvex
  have hbot : pi1Image hVX (hab (left_mem_seg _ _)) = ⊥ :=
    pi1Image_eq_bot_of_convex hVX hconv _
  have hRX : rect x₀ x₁ y₀ y₁ ⊆ X :=
    fun z hz => hVX ⟨hfr.rect_subset hz, fun hzS => hSV z hzS (hfr.rect_subset hz)⟩
  rw [hempty, boxLoop_eq_refl (isSegClosed_iff_convex.mpr (convex_rect x₀ x₁ y₀ y₁)) hRX
    (cpt_mem_rect le_rfl hx le_rfl hy) (cpt_mem_rect hx le_rfl le_rfl hy)
    (cpt_mem_rect hx le_rfl hy le_rfl) (cpt_mem_rect le_rfl hx hy le_rfl)
    (hab.trans hVX) (hbc.trans hVX) (hcd.trans hVX) (hda.trans hVX), fromPath_refl]
  exact (IsPunctureProd.one _).mono (le_of_eq hbot)

/-! ### Vertical cut -/

/-- **Cutting a rectangle by a vertical line missing every puncture**: if both halves have
boundary loop a generating product of puncture loops in their half-frames, so does the whole
rectangle in its frame. -/
theorem rectSpider_of_cut_vert {X S V : Set ℂ} {x₀ x₁ y₀ y₁ c m : ℝ} (hSfin : S.Finite)
    (h0 : x₀ ≤ c) (h1 : c ≤ x₁) (hy : y₀ ≤ y₁) (hm : 0 < m)
    (hfr : RectFrame S V x₀ x₁ y₀ y₁)
    (havoid : ∀ t ∈ S, t ∈ rect x₀ x₁ y₀ y₁ → t.re ≠ c)
    (hL : RectSpider X S (V ∩ {z : ℂ | z.re < c + m}) x₀ c y₀ y₁)
    (hR : RectSpider X S (V ∩ {z : ℂ | c - m < z.re}) c x₁ y₀ y₁) :
    RectSpider X S V x₀ x₁ y₀ y₁ := by
  intro hVX hab hbc hcd hda
  have hp : cpt c y₀ ∈ seg (cpt x₀ y₀) (cpt x₁ y₀) := cpt_mem_seg_horiz h0 h1
  have hq : cpt c y₁ ∈ seg (cpt x₁ y₁) (cpt x₀ y₁) := cpt_mem_seg_horiz' h0 h1
  have hpq : seg (cpt c y₀) (cpt c y₁) ⊆ V \ S :=
    (seg_vert_subset_diff ⟨le_rfl, hy⟩ ⟨hy, le_rfl⟩ ⟨h0, h1⟩ havoid).trans
      (Set.diff_subset_diff_left hfr.rect_subset)
  have hLV : V ∩ {z : ℂ | z.re < c + m} ⊆ V := Set.inter_subset_left
  have hRV : V ∩ {z : ℂ | c - m < z.re} ⊆ V := Set.inter_subset_left
  have hLVX : (V ∩ {z : ℂ | z.re < c + m}) \ S ⊆ X :=
    (Set.diff_subset_diff_left hLV).trans hVX
  have hRVX : (V ∩ {z : ℂ | c - m < z.re}) \ S ⊆ X :=
    (Set.diff_subset_diff_left hRV).trans hVX
  have hRcL : rect x₀ c y₀ y₁ ⊆ {z : ℂ | z.re < c + m} := rect_subset_reLt le_rfl hm
  have hRcR : rect c x₁ y₀ y₁ ⊆ {z : ℂ | c - m < z.re} := rect_subset_reGt le_rfl hm
  have habL : seg (cpt x₀ y₀) (cpt c y₀) ⊆ (V ∩ {z : ℂ | z.re < c + m}) \ S :=
    seg_subset_inter_diff ((seg_subset_left hp).trans hab)
      ((seg_subset_rect (cpt_mem_rect le_rfl h0 le_rfl hy)
        (cpt_mem_rect h0 le_rfl le_rfl hy)).trans hRcL)
  have hbcL : seg (cpt c y₀) (cpt c y₁) ⊆ (V ∩ {z : ℂ | z.re < c + m}) \ S :=
    seg_subset_inter_diff hpq
      ((seg_subset_rect (cpt_mem_rect h0 le_rfl le_rfl hy)
        (cpt_mem_rect h0 le_rfl hy le_rfl)).trans hRcL)
  have hcdL : seg (cpt c y₁) (cpt x₀ y₁) ⊆ (V ∩ {z : ℂ | z.re < c + m}) \ S :=
    seg_subset_inter_diff ((seg_subset_right hq).trans hcd)
      ((seg_subset_rect (cpt_mem_rect h0 le_rfl hy le_rfl)
        (cpt_mem_rect le_rfl h0 hy le_rfl)).trans hRcL)
  have hdaL : seg (cpt x₀ y₁) (cpt x₀ y₀) ⊆ (V ∩ {z : ℂ | z.re < c + m}) \ S :=
    seg_subset_inter_diff hda
      ((seg_subset_rect (cpt_mem_rect le_rfl h0 hy le_rfl)
        (cpt_mem_rect le_rfl h0 le_rfl hy)).trans hRcL)
  have habR : seg (cpt c y₀) (cpt x₁ y₀) ⊆ (V ∩ {z : ℂ | c - m < z.re}) \ S :=
    seg_subset_inter_diff ((seg_subset_right hp).trans hab)
      ((seg_subset_rect (cpt_mem_rect le_rfl h1 le_rfl hy)
        (cpt_mem_rect h1 le_rfl le_rfl hy)).trans hRcR)
  have hbcR : seg (cpt x₁ y₀) (cpt x₁ y₁) ⊆ (V ∩ {z : ℂ | c - m < z.re}) \ S :=
    seg_subset_inter_diff hbc
      ((seg_subset_rect (cpt_mem_rect h1 le_rfl le_rfl hy)
        (cpt_mem_rect h1 le_rfl hy le_rfl)).trans hRcR)
  have hcdR : seg (cpt x₁ y₁) (cpt c y₁) ⊆ (V ∩ {z : ℂ | c - m < z.re}) \ S :=
    seg_subset_inter_diff ((seg_subset_left hq).trans hcd)
      ((seg_subset_rect (cpt_mem_rect h1 le_rfl hy le_rfl)
        (cpt_mem_rect le_rfl h1 hy le_rfl)).trans hRcR)
  have hdaR : seg (cpt c y₁) (cpt c y₀) ⊆ (V ∩ {z : ℂ | c - m < z.re}) \ S :=
    seg_subset_inter_diff (seg_subset_symm hpq)
      ((seg_subset_rect (cpt_mem_rect le_rfl h1 hy le_rfl)
        (cpt_mem_rect le_rfl h1 le_rfl hy)).trans hRcR)
  have hdisj : Disjoint (S ∩ rect x₀ c y₀ y₁) (S ∩ rect c x₁ y₀ y₁) := by
    rw [Set.disjoint_left]
    rintro z ⟨hzS, hzL⟩ ⟨-, hzR⟩
    have hz : z ∈ rect x₀ x₁ y₀ y₁ := ⟨hzL.1, hzR.2.1, hzL.2.2.1, hzL.2.2.2⟩
    exact havoid z hzS hz (le_antisymm hzL.2.1 hzR.1)
  have key := isPunctureProd_boxLoop_cut (hab.trans hVX) (hbc.trans hVX) (hcd.trans hVX)
    (hda.trans hVX) hp hq (hpq.trans hVX) (hL hLVX habL hbcL hcdL hdaL)
    (hR hRVX habR hbcR hcdR hdaR) hdisj
  have hle := pi1Image_le_sup_of_cut hSfin hVX (hfr.isConvex.inter (convex_reLt _))
    (hfr.isOpen.inter (isOpen_reLt _)) (hfr.isConvex.inter (convex_reGt _))
    (hfr.isOpen.inter (isOpen_reGt _)) hLV hRV (frame_cover_re V hm)
    ((seg_subset_left hp).trans hab) habL (habR (left_mem_seg _ _))
  have hTeq : (S ∩ rect x₀ c y₀ y₁) ∪ (S ∩ rect c x₁ y₀ y₁) = S ∩ rect x₀ x₁ y₀ y₁ := by
    rw [← Set.inter_union_distrib_left, rect_union_vert h0 h1]
  rw [hTeq] at key
  exact key.mono hle

/-! ### Horizontal cut -/

/-- **Cutting a rectangle by a horizontal line missing every puncture**: if both halves have
boundary loop a generating product of puncture loops in their half-frames, so does the whole
rectangle in its frame. -/
theorem rectSpider_of_cut_horiz {X S V : Set ℂ} {x₀ x₁ y₀ y₁ d m : ℝ} (hSfin : S.Finite)
    (hx : x₀ ≤ x₁) (h0 : y₀ ≤ d) (h1 : d ≤ y₁) (hm : 0 < m)
    (hfr : RectFrame S V x₀ x₁ y₀ y₁)
    (havoid : ∀ t ∈ S, t ∈ rect x₀ x₁ y₀ y₁ → t.im ≠ d)
    (hB : RectSpider X S (V ∩ {z : ℂ | z.im < d + m}) x₀ x₁ y₀ d)
    (hT : RectSpider X S (V ∩ {z : ℂ | d - m < z.im}) x₀ x₁ d y₁) :
    RectSpider X S V x₀ x₁ y₀ y₁ := by
  intro hVX hab hbc hcd hda
  refine isPunctureProd_boxLoop_rotate_pi1 hVX hab hbc hcd hda ?_
  have hp : cpt x₁ d ∈ seg (cpt x₁ y₀) (cpt x₁ y₁) := cpt_mem_seg_vert h0 h1
  have hq : cpt x₀ d ∈ seg (cpt x₀ y₁) (cpt x₀ y₀) := cpt_mem_seg_vert' h0 h1
  have hpq : seg (cpt x₁ d) (cpt x₀ d) ⊆ V \ S :=
    (seg_horiz_subset_diff ⟨hx, le_rfl⟩ ⟨le_rfl, hx⟩ ⟨h0, h1⟩ havoid).trans
      (Set.diff_subset_diff_left hfr.rect_subset)
  have hBV : V ∩ {z : ℂ | z.im < d + m} ⊆ V := Set.inter_subset_left
  have hTV : V ∩ {z : ℂ | d - m < z.im} ⊆ V := Set.inter_subset_left
  have hBVX : (V ∩ {z : ℂ | z.im < d + m}) \ S ⊆ X :=
    (Set.diff_subset_diff_left hBV).trans hVX
  have hTVX : (V ∩ {z : ℂ | d - m < z.im}) \ S ⊆ X :=
    (Set.diff_subset_diff_left hTV).trans hVX
  have hRcB : rect x₀ x₁ y₀ d ⊆ {z : ℂ | z.im < d + m} := rect_subset_imLt le_rfl hm
  have hRcT : rect x₀ x₁ d y₁ ⊆ {z : ℂ | d - m < z.im} := rect_subset_imGt le_rfl hm
  have habB : seg (cpt x₀ y₀) (cpt x₁ y₀) ⊆ (V ∩ {z : ℂ | z.im < d + m}) \ S :=
    seg_subset_inter_diff hab
      ((seg_subset_rect (cpt_mem_rect le_rfl hx le_rfl h0)
        (cpt_mem_rect hx le_rfl le_rfl h0)).trans hRcB)
  have hbcB : seg (cpt x₁ y₀) (cpt x₁ d) ⊆ (V ∩ {z : ℂ | z.im < d + m}) \ S :=
    seg_subset_inter_diff ((seg_subset_left hp).trans hbc)
      ((seg_subset_rect (cpt_mem_rect hx le_rfl le_rfl h0)
        (cpt_mem_rect hx le_rfl h0 le_rfl)).trans hRcB)
  have hcdB : seg (cpt x₁ d) (cpt x₀ d) ⊆ (V ∩ {z : ℂ | z.im < d + m}) \ S :=
    seg_subset_inter_diff hpq
      ((seg_subset_rect (cpt_mem_rect hx le_rfl h0 le_rfl)
        (cpt_mem_rect le_rfl hx h0 le_rfl)).trans hRcB)
  have hdaB : seg (cpt x₀ d) (cpt x₀ y₀) ⊆ (V ∩ {z : ℂ | z.im < d + m}) \ S :=
    seg_subset_inter_diff ((seg_subset_right hq).trans hda)
      ((seg_subset_rect (cpt_mem_rect le_rfl hx h0 le_rfl)
        (cpt_mem_rect le_rfl hx le_rfl h0)).trans hRcB)
  have habT : seg (cpt x₀ d) (cpt x₁ d) ⊆ (V ∩ {z : ℂ | d - m < z.im}) \ S :=
    seg_subset_inter_diff (seg_subset_symm hpq)
      ((seg_subset_rect (cpt_mem_rect le_rfl hx le_rfl h1)
        (cpt_mem_rect hx le_rfl le_rfl h1)).trans hRcT)
  have hbcT : seg (cpt x₁ d) (cpt x₁ y₁) ⊆ (V ∩ {z : ℂ | d - m < z.im}) \ S :=
    seg_subset_inter_diff ((seg_subset_right hp).trans hbc)
      ((seg_subset_rect (cpt_mem_rect hx le_rfl le_rfl h1)
        (cpt_mem_rect hx le_rfl h1 le_rfl)).trans hRcT)
  have hcdT : seg (cpt x₁ y₁) (cpt x₀ y₁) ⊆ (V ∩ {z : ℂ | d - m < z.im}) \ S :=
    seg_subset_inter_diff hcd
      ((seg_subset_rect (cpt_mem_rect hx le_rfl h1 le_rfl)
        (cpt_mem_rect le_rfl hx h1 le_rfl)).trans hRcT)
  have hdaT : seg (cpt x₀ y₁) (cpt x₀ d) ⊆ (V ∩ {z : ℂ | d - m < z.im}) \ S :=
    seg_subset_inter_diff ((seg_subset_left hq).trans hda)
      ((seg_subset_rect (cpt_mem_rect le_rfl hx h1 le_rfl)
        (cpt_mem_rect le_rfl hx le_rfl h1)).trans hRcT)
  have hdisj : Disjoint (S ∩ rect x₀ x₁ y₀ d) (S ∩ rect x₀ x₁ d y₁) := by
    rw [Set.disjoint_left]
    rintro z ⟨hzS, hzB⟩ ⟨-, hzT⟩
    have hz : z ∈ rect x₀ x₁ y₀ y₁ := ⟨hzB.1, hzB.2.1, hzB.2.2.1, hzT.2.2.2⟩
    exact havoid z hzS hz (le_antisymm hzB.2.2.2 hzT.2.2.1)
  have key := isPunctureProd_boxLoop_cut (hbc.trans hVX) (hcd.trans hVX) (hda.trans hVX)
    (hab.trans hVX) hp hq (hpq.trans hVX)
    (isPunctureProd_boxLoop_rotate'_pi1 hBVX habB hbcB hcdB hdaB (hB hBVX habB hbcB hcdB hdaB))
    (isPunctureProd_boxLoop_rotate'_pi1 hTVX habT hbcT hcdT hdaT (hT hTVX habT hbcT hcdT hdaT))
    hdisj
  have hle := pi1Image_le_sup_of_cut hSfin hVX (hfr.isConvex.inter (convex_imLt _))
    (hfr.isOpen.inter (isOpen_imLt _)) (hfr.isConvex.inter (convex_imGt _))
    (hfr.isOpen.inter (isOpen_imGt _)) hBV hTV (frame_cover_im V hm)
    ((seg_subset_left hp).trans hbc) hbcB (hbcT (left_mem_seg _ _))
  have hTeq : (S ∩ rect x₀ x₁ y₀ d) ∪ (S ∩ rect x₀ x₁ d y₁) = S ∩ rect x₀ x₁ y₀ y₁ := by
    rw [← Set.inter_union_distrib_left, rect_union_horiz h0 h1]
  rw [hTeq] at key
  exact key.mono hle

/-! ### The one-puncture square -/

/-- **A square centred at the only puncture of its frame**, whose frame contains the disc of
twice the half-side: its boundary loop winds once around the puncture and generates every loop of
the punctured frame. -/
theorem rectSpider_of_single {X S V : Set ℂ} {s : ℂ} {a : ℝ} (ha : 0 < a)
    (hfr : RectFrame S V (s.re - a) (s.re + a) (s.im - a) (s.im + a))
    (hball : Metric.ball s (2 * a) ⊆ V) (hone : S ∩ V = {s}) :
    RectSpider X S V (s.re - a) (s.re + a) (s.im - a) (s.im + a) := by
  intro hVX hab hbc hcd hda
  have hsSV : s ∈ S ∩ V := by rw [hone]; rfl
  have hVSeq : V \ S = V \ {s} := by
    ext z
    constructor
    · rintro ⟨hzV, hzS⟩
      exact ⟨hzV, by rintro rfl; exact hzS hsSV.1⟩
    · rintro ⟨hzV, hzs⟩
      refine ⟨hzV, fun hzS => hzs ?_⟩
      have hz : z ∈ S ∩ V := ⟨hzS, hzV⟩
      rw [hone] at hz
      exact hz
  have hdisc : puncturedDisc s (2 * a) ⊆ V \ S := by
    rintro z ⟨hzb, hzs⟩
    rw [hVSeq]
    exact ⟨hball hzb, hzs⟩
  have hone' : S ∩ rect (s.re - a) (s.re + a) (s.im - a) (s.im + a) = {s} := by
    refine Set.Subset.antisymm (fun z hz => ?_) (fun z hz => ?_)
    · have : z ∈ S ∩ V := ⟨hz.1, hfr.rect_subset hz.2⟩
      rw [hone] at this
      exact this
    · obtain rfl : z = s := hz
      exact ⟨hsSV.1, hfr.inter_subset hsSV⟩
  set w : ℂ := -(a : ℂ) - (a : ℂ) * Complex.I with hwdef
  have hwre : w.re = -a := by simp [hwdef]
  have hwim : w.im = -a := by simp [hwdef]
  have hw : w ≠ 0 := fun h => by
    have hz : (-a) = 0 := by rw [← hwre, h, Complex.zero_re]
    linarith
  have hwρ : ‖w‖ < 2 * a := by
    have h2 : ‖w‖ ^ 2 = 2 * a ^ 2 := by
      rw [← Complex.normSq_eq_norm_sq, Complex.normSq_apply, hwre, hwim]; ring
    nlinarith [norm_nonneg w, ha, h2]
  have hcA : cpt (s.re - a) (s.im - a) = s + w := by
    apply Complex.ext <;> simp [cpt, hwdef, sub_eq_add_neg]
  have hcB : cpt (s.re + a) (s.im - a) = s + Complex.I * w := by
    apply Complex.ext <;> simp [cpt, hwdef, sub_eq_add_neg]
  have hcC : cpt (s.re + a) (s.im + a) = s - w := by
    apply Complex.ext <;> simp [cpt, hwdef, sub_eq_add_neg]
  have hcD : cpt (s.re - a) (s.im + a) = s - Complex.I * w := by
    apply Complex.ext <;> simp [cpt, hwdef, sub_eq_add_neg]
  have hloopU : IsPunctureLoop (V \ S) s (hab (left_mem_seg _ _))
      (FundamentalGroup.fromPath (boxLoop hab hbc hcd hda)) :=
    isPunctureLoop_boxLoop' hdisc hw hwρ hcA hcB hcC hcD hab hbc hcd hda
  have hgtop : Subgroup.zpowers (FundamentalGroup.fromPath (boxLoop hab hbc hcd hda)) = ⊤ :=
    zpowers_eq_top_of_isPunctureLoop' hfr.isConvex hsSV.2 hVSeq hloopU
  have hleafX : IsPunctureLoop X s (hVX (hab (left_mem_seg _ _)))
      (FundamentalGroup.fromPath (boxLoop (hab.trans hVX) (hbc.trans hVX) (hcd.trans hVX)
        (hda.trans hVX))) :=
    isPunctureLoop_boxLoop' (hdisc.trans hVX) hw hwρ hcA hcB hcC hcD (hab.trans hVX)
      (hbc.trans hVX) (hcd.trans hVX) (hda.trans hVX)
  have hmapeq : FundamentalGroup.map (subsetIncl hVX)
      (⟨cpt (s.re - a) (s.im - a), hab (left_mem_seg _ _)⟩ : ↥(V \ S))
      (FundamentalGroup.fromPath (boxLoop hab hbc hcd hda))
      = FundamentalGroup.fromPath (boxLoop (hab.trans hVX) (hbc.trans hVX) (hcd.trans hVX)
        (hda.trans hVX)) := by
    rw [fundamentalGroup_map_eq, map_boxLoop]
  have hle : pi1Image hVX (hab (left_mem_seg _ _))
      ≤ Subgroup.zpowers (FundamentalGroup.fromPath
          (boxLoop (hab.trans hVX) (hbc.trans hVX) (hcd.trans hVX) (hda.trans hVX))) :=
    le_trans (pi1Image_le_zpowers hVX Set.Subset.rfl (hab (left_mem_seg _ _)) hgtop)
      (le_of_eq (congrArg Subgroup.zpowers hmapeq))
  rw [hone']
  exact (IsPunctureProd.single hleafX).mono hle

end Rigidity.RET

