import Mathlib
import InverseGalois.Rigidity.RET.GeomPi1
import InverseGalois.Rigidity.RET.DeckGroups
import InverseGalois.Rigidity.RET.AbelianBranchPoints
import InverseGalois.Rigidity.RET.MoveInfinity

/-!
# The abelian quotients of the geometric fundamental group

The number of punctures is visible in the abelian quotients of the fundamental group, and there it
is visible exactly: over `r + 1` points the finite abelian groups that occur are precisely those
generated by `r` elements — the Kummer covers realize all of them, and the branch cycles, one per
puncture and multiplying to one, generate no more.  For a group that is not abelian the same count
bounds its abelianization, with no hypothesis on the group at all.

Through the dictionary between the covers over a set of points and the finite quotients of the
geometric fundamental group, these are statements about that group: the finite abelian quotients of
the fundamental group of the line with `r + 1` punctures are the finite abelian groups generated by
`r` elements.

## Main results

* `Rigidity.RET.isDeckGroupOver_iff_exists_generating_of_comm` — over `r + 1` points exactly the
  finite abelian groups generated by `r` elements occur.
* `Rigidity.RET.exists_surjective_geomPi1_iff_exists_generating_of_comm` — the same read as a
  description of the finite abelian quotients of the fundamental group.
* `Rigidity.RET.exists_generating_abelianization_of_isDeckGroupOver` — for a group that occurs over
  `r + 1` points, with no hypothesis on the group, the abelianization is generated by `r` elements.
-/

open Polynomial IntermediateField

noncomputable section


namespace Rigidity.RET

open GeomAKLB

attribute [local instance] GeomAKLB.instMSA GeomAKLB.instIntegral GeomAKLB.instIsFrac
  GeomAKLB.instIGG GeomAKLB.instFinite GeomAKLB.instDedekindB GeomAKLB.instTorsionFree
  GeomAKLB.instFaithful

/-! ### Abelian groups over a prescribed set of points -/

/-- **Over `r + 1` points exactly the finite abelian groups generated by `r` elements occur.**  One
puncture is spent on the product-one relation among the branch cycles. -/
theorem isDeckGroupOver_iff_exists_generating_of_comm {S : Set k} (hS : S.Finite) {r : ℕ}
    (hcard : hS.toFinset.card = r + 1) {H : Type} [CommGroup H] [Finite H] :
    IsDeckGroupOver S H ↔ ∃ s : Fin r → H, Subgroup.closure (Set.range s) = ⊤ := by
  have hex := exists_fin_card_range hS
  rw [hcard] at hex
  obtain ⟨t, ht, hrange⟩ := hex
  rw [← hrange]
  exact exists_cover_iff_exists_generating t ht

/-- **The abelianization of a group occurring over `r + 1` points is generated by `r` elements**,
being generated by the branch cycles, of which one is the inverse of the product of the others. -/
theorem exists_generating_abelianization_of_isDeckGroupOver {S : Set k} (hS : S.Finite) {r : ℕ}
    (hcard : hS.toFinset.card = r + 1) {G : Type} [Group G] [Finite G] (h : IsDeckGroupOver S G) :
    ∃ s : Fin r → Abelianization G, Subgroup.closure (Set.range s) = ⊤ := by
  obtain ⟨L, ⟨e⟩, hout, hinf⟩ := h
  have hex := exists_fin_card_range hS
  rw [hcard] at hex
  obtain ⟨t, ht, hrange⟩ := hex
  obtain ⟨s, hs⟩ :=
    exists_generating_abelianization L t ht (by rw [hrange]; exact hout) hinf
  exact ⟨fun i => Abelianization.map e.toMonoidHom (s i),
    closure_range_map_eq_top _
      (abelianization_map_surjective (f := e.toMonoidHom) e.surjective) hs⟩

/-- **A group whose abelianization needs more than `r` generators does not occur over `r + 1`
points**, and so is not a finite quotient of the fundamental group of the line with `r + 1`
punctures.  Read this way the count is an obstruction, valid for every finite group. -/
theorem not_isDeckGroupOver_of_abelianization {S : Set k} (hS : S.Finite) {r : ℕ}
    (hcard : hS.toFinset.card = r + 1) {G : Type} [Group G] [Finite G]
    (h : ¬ ∃ s : Fin r → Abelianization G, Subgroup.closure (Set.range s) = ⊤) :
    ¬ IsDeckGroupOver S G :=
  fun hd => h (exists_generating_abelianization_of_isDeckGroupOver hS hcard hd)

/-! ### Abelian quotients of the fundamental group -/

/-- **The finite abelian quotients of the fundamental group of the line with `r + 1` punctures are
exactly the finite abelian groups generated by `r` elements.** -/
theorem exists_surjective_geomPi1_iff_exists_generating_of_comm {S : Set k} (hS : S.Finite) {r : ℕ}
    (hcard : hS.toFinset.card = r + 1) (H : Type) [CommGroup H] [Finite H] :
    (∃ φ : geomPi1 S →* H, Function.Surjective φ ∧ IsOpen (φ.ker : Set (geomPi1 S))) ↔
      ∃ s : Fin r → H, Subgroup.closure (Set.range s) = ⊤ :=
  (isDeckGroupOver_iff_exists_surjective H).symm.trans
    (isDeckGroupOver_iff_exists_generating_of_comm hS hcard)

/-- **The abelianization of a finite quotient of the fundamental group of the line with `r + 1`
punctures is generated by `r` elements.** -/
theorem exists_generating_abelianization_of_surjective_geomPi1 {S : Set k} (hS : S.Finite) {r : ℕ}
    (hcard : hS.toFinset.card = r + 1) {G : Type} [Group G] [Finite G] (φ : geomPi1 S →* G)
    (hφ : Function.Surjective φ) (hopen : IsOpen (φ.ker : Set (geomPi1 S))) :
    ∃ s : Fin r → Abelianization G, Subgroup.closure (Set.range s) = ⊤ :=
  exists_generating_abelianization_of_isDeckGroupOver hS hcard
    (isDeckGroupOver_of_surjective φ hφ hopen)

end Rigidity.RET
