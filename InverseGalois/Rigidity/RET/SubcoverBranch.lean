import Mathlib
import InverseGalois.Rigidity.RET.SubcoverProduct
import InverseGalois.Rigidity.RET.TranslateInfinity

/-!
# Branching of a cover generated by two subcovers

A cover generated by two normal subcovers branches only where one of them does, because a deck
transformation is determined by its restrictions to the two.  In the other direction branching only
shrinks as one passes to a smaller subcover.  Combining the two: a subcover of two normal subcovers
branched inside disjoint loci is branched nowhere, not even at infinity, and a cover of the line
branched nowhere is trivial — so the two subcovers meet in the base field alone.

## Main results

* `Rigidity.RET.LineCover.IsUnramifiedOutside.of_sup`, `Rigidity.RET.LineCover.
  IsUnramifiedAtInfinity.of_sup` — a cover generated by two normal subcovers branches inside the
  union of their branch loci.
* `Rigidity.RET.LineCover.IsUnramifiedOutside.sub_of_le`, `Rigidity.RET.LineCover.
  IsUnramifiedAtInfinity.sub_of_le` — a subcover of an unramified subcover is unramified.
* `Rigidity.RET.LineCover.inf_eq_bot_of_disjoint` — two normal subcovers branched inside disjoint
  loci meet in the base field.
-/

open Polynomial IntermediateField

noncomputable section

namespace Rigidity.RET

open GeomAKLB

attribute [local instance] GeomAKLB.instMSA GeomAKLB.instIntegral GeomAKLB.instIsFrac
  GeomAKLB.instIGG GeomAKLB.instFinite GeomAKLB.instDedekindB GeomAKLB.instTorsionFree
  GeomAKLB.instFaithful

namespace LineCover

attribute [local instance] sub_isGalois

/-- **A cover generated by two normal subcovers branches inside the union of their branch loci.** -/
theorem IsUnramifiedOutside.of_sup {L : LineCover} {S₁ S₂ : Set k}
    {A B : IntermediateField (RatFunc k) L.M} [Normal (RatFunc k) A] [Normal (RatFunc k) B]
    (hsup : A ⊔ B = ⊤) (hA : (L.sub A).IsUnramifiedOutside S₁)
    (hB : (L.sub B).IsUnramifiedOutside S₂) : L.IsUnramifiedOutside (S₁ ∪ S₂) := by
  intro t ht σ hσ
  have h1 : L.subHom A σ = 1 :=
    hA t (fun h => ht (Set.mem_union_left _ h)) _ (IsInertiaAt.restrict L hσ)
  have h2 : L.subHom B σ = 1 :=
    hB t (fun h => ht (Set.mem_union_right _ h)) _ (IsInertiaAt.restrict L hσ)
  refine subHom_prod_injective L A B hsup (a₁ := σ) (a₂ := 1) ?_
  simp [h1, h2]

/-- **A cover generated by two normal subcovers unramified at infinity is unramified at
infinity.** -/
theorem IsUnramifiedAtInfinity.of_sup {L : LineCover}
    {A B : IntermediateField (RatFunc k) L.M} [Normal (RatFunc k) A] [Normal (RatFunc k) B]
    (hsup : A ⊔ B = ⊤) (hA : (L.sub A).IsUnramifiedAtInfinity)
    (hB : (L.sub B).IsUnramifiedAtInfinity) : L.IsUnramifiedAtInfinity := by
  haveI hfam : ∀ b : Bool,
      Normal (RatFunc k) ((cond b A B : IntermediateField (RatFunc k) L.M) : Type) := by
    intro b
    cases b with
    | false => exact inferInstanceAs (Normal (RatFunc k) (B : Type))
    | true => exact inferInstanceAs (Normal (RatFunc k) (A : Type))
  refine @IsUnramifiedAtInfinity.of_iSup L Bool (fun b => cond b A B) hfam ?_ ?_
  · rw [iSup_bool_eq]; simpa using hsup
  · intro b
    cases b with
    | false => exact hB
    | true => exact hA

/-- A subcover of a subcover is a subcover: an intermediate field below a normal one is the same
cover seen inside the smaller one. -/
def subLeEquiv {L : LineCover} {A D : IntermediateField (RatFunc k) L.M} (hDA : D ≤ A) :
    ((IntermediateField.restrict hDA : IntermediateField (RatFunc k) (A : Type)) : Type)
      ≃ₐ[RatFunc k] (D : Type) :=
  (IntermediateField.liftAlgEquiv _).trans
    (IntermediateField.equivOfEq (IntermediateField.lift_restrict hDA))

/-- **A subcover of an unramified subcover is unramified.** -/
theorem IsUnramifiedOutside.sub_of_le {L : LineCover} {S : Set k}
    {A D : IntermediateField (RatFunc k) L.M} [Normal (RatFunc k) A] [Normal (RatFunc k) D]
    (hDA : D ≤ A) (h : (L.sub A).IsUnramifiedOutside S) : (L.sub D).IsUnramifiedOutside S :=
  have hn : Normal (RatFunc k)
      ((IntermediateField.restrict hDA : IntermediateField (RatFunc k) (A : Type)) : Type) :=
    Normal.of_algEquiv (subLeEquiv hDA).symm
  IsUnramifiedOutside.transport
    (L := @LineCover.sub (L.sub A) (IntermediateField.restrict hDA) hn) (L' := L.sub D)
    (subLeEquiv hDA)
    (@IsUnramifiedOutside.sub (L.sub A) S h (IntermediateField.restrict hDA) hn)

/-- **A subcover of a subcover unramified at infinity is unramified at infinity.** -/
theorem IsUnramifiedAtInfinity.sub_of_le {L : LineCover}
    {A D : IntermediateField (RatFunc k) L.M} [Normal (RatFunc k) A] [Normal (RatFunc k) D]
    (hDA : D ≤ A) (h : (L.sub A).IsUnramifiedAtInfinity) : (L.sub D).IsUnramifiedAtInfinity :=
  have hn : Normal (RatFunc k)
      ((IntermediateField.restrict hDA : IntermediateField (RatFunc k) (A : Type)) : Type) :=
    Normal.of_algEquiv (subLeEquiv hDA).symm
  IsUnramifiedAtInfinity.transport
    (L := @LineCover.sub (L.sub A) (IntermediateField.restrict hDA) hn) (L' := L.sub D)
    (subLeEquiv hDA)
    (@IsUnramifiedAtInfinity.sub (L.sub A) h (IntermediateField.restrict hDA) hn)

/-- **Two normal subcovers branched inside disjoint loci meet in the base field.**  A subcover of
both branches inside each locus, hence nowhere, and a cover of the line branched nowhere is
trivial. -/
theorem inf_eq_bot_of_disjoint (L : LineCover) (A B : IntermediateField (RatFunc k) L.M)
    [Normal (RatFunc k) A] [Normal (RatFunc k) B] {S₁ S₂ : Set k} (hdisj : Disjoint S₁ S₂)
    (hA : (L.sub A).IsUnramifiedOutside S₁) (hAi : (L.sub A).IsUnramifiedAtInfinity)
    (hB : (L.sub B).IsUnramifiedOutside S₂) : A ⊓ B = ⊥ := by
  have hD₁ : (L.sub (A ⊓ B)).IsUnramifiedOutside S₁ :=
    IsUnramifiedOutside.sub_of_le (inf_le_left : (A ⊓ B : IntermediateField (RatFunc k) L.M) ≤ A) hA
  have hD₂ : (L.sub (A ⊓ B)).IsUnramifiedOutside S₂ :=
    IsUnramifiedOutside.sub_of_le
      (inf_le_right : (A ⊓ B : IntermediateField (RatFunc k) L.M) ≤ B) hB
  have hDi : (L.sub (A ⊓ B)).IsUnramifiedAtInfinity :=
    IsUnramifiedAtInfinity.sub_of_le
      (inf_le_left : (A ⊓ B : IntermediateField (RatFunc k) L.M) ≤ A) hAi
  have hout : (L.sub (A ⊓ B)).IsUnramifiedOutside ({0} : Set k) := by
    intro t _ σ hσ
    by_cases ht : t ∈ S₁
    · exact hD₂ t (fun h2 => Set.disjoint_left.mp hdisj ht h2) σ hσ
    · exact hD₁ t ht σ hσ
  haveI hsub : Subsingleton (L.sub (A ⊓ B)).deck :=
    subsingleton_deck_of_unramifiedOutside_singleton (L.sub (A ⊓ B)) 0 hout hDi
  have hcard : Nat.card ((A ⊓ B : IntermediateField (RatFunc k) L.M) ≃ₐ[RatFunc k]
      ((A ⊓ B : IntermediateField (RatFunc k) L.M) : Type)) = 1 :=
    Nat.card_eq_one_iff_unique.2 ⟨hsub, ⟨1⟩⟩
  rw [IsGalois.card_aut_eq_finrank (RatFunc k)
    ((A ⊓ B : IntermediateField (RatFunc k) L.M) : Type)] at hcard
  exact IntermediateField.finrank_eq_one_iff.mp hcard

end LineCover

end Rigidity.RET
