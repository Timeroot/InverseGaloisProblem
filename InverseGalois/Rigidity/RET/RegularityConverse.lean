import Mathlib
import InverseGalois.Core.InstanceShortcuts
import InverseGalois.Rigidity.RET.GeometricIrreducibility
import InverseGalois.Rigidity.RET.RegularBase

/-!
# Regularity from absolute irreducibility

`Rigidity.RET.isField_baseChange_of_regular` reads a base change off regularity: if the constants of
`L / ℚ(T)` are `ℚ`, then `ℚ̄(T) ⊗ L` is a field, so the primitive-element polynomial stays
irreducible over `ℚ̄(T)`.  This file is the converse.  It costs nothing but a trace argument, and it
turns the two conditions into the same condition.

Suppose the base change `K' ⊗ L` is a field, where `K'` is large enough that every polynomial over
the constants splits in it.  An element `x` of `L` algebraic over the constants then satisfies, in
the base change, an equation that splits into linear factors, so `1 ⊗ x` equals `r ⊗ 1` for one of
the roots `r`.  Applying the normalized trace of `L / K` in the second factor turns that equation
into `r = λ(x)`, exhibiting `r` as an element of `K` — algebraic over the constants, hence a
constant if the base already is regular.  Then `1 ⊗ x` and `1 ⊗ r` agree, and the right inclusion is
injective, so `x = r`.

Over the function field of the line this closes the loop: a finite extension of `ℚ(T)` generated by
a primitive element is regular exactly when the minimal polynomial of that element stays irreducible
over `ℚ̄(T)`.  Absolute irreducibility of the resolvent — the hypothesis every construction in this
development already verifies in order to run Hilbert irreducibility — is therefore not merely a
consequence of regularity but a criterion for it.

## Main results

* `Rigidity.RET.algebraicClosure_eq_bot_of_isField_tensor` — a field base change forces the
  constants down to those of the base.
* `Rigidity.RET.algebraicClosure_eq_bot_of_irreducible_map` — the same, from irreducibility of the
  minimal polynomial of a primitive element.
* `Rigidity.RET.splits_map_toClosureFrac_comp_C` — every polynomial over `ℚ` splits in `ℚ̄(T)`.
* `Rigidity.RET.algebraicClosure_eq_bot_of_irreducible_map_toClosureFrac` — regularity of a finite
  extension of `ℚ(T)` from absolute irreducibility of its defining polynomial.
* `Rigidity.RET.algebraicClosure_eq_bot_iff_irreducible_map_toClosureFrac` — over `ℚ(T)`, regularity
  and absolute irreducibility of the primitive-element polynomial are the same condition.
-/

open Polynomial TensorProduct

noncomputable section

namespace Rigidity.RET

section Tensor

variable {F K K' L : Type*} [Field F] [Field K] [Field K'] [Field L]
  [Algebra F K] [Algebra F L] [Algebra K K'] [Algebra K L]
  [IsScalarTower F K L]

/-- **A field base change forces the constants down to the base.**

If every polynomial over `F` splits in `K'`, if `F` is relatively algebraically closed in `K`, and
if `K' ⊗[K] L` is a field, then `F` is relatively algebraically closed in `L`.

An element `x` of `L` algebraic over `F` satisfies its `F`-minimal polynomial in the base change,
where that polynomial splits; the base change being a domain, one linear factor vanishes, so
`1 ⊗ x = r ⊗ 1` for a root `r` in `K'`.  The normalized trace of `L / K`, applied in the second
factor, sends the left side to the image of an element of `K` and the right side to `r`, so `r`
comes from `K` and is algebraic over `F`, hence lies in `F`.  Both sides of the equation are then
the image of an element of `F`, and the right inclusion `L → K' ⊗[K] L` is injective. -/
theorem algebraicClosure_eq_bot_of_isField_tensor [FiniteDimensional K L] [CharZero K]
    (hsplit : ∀ p : F[X], ((p.map (algebraMap F K)).map (algebraMap K K')).Splits)
    (hbase : algebraicClosure F K = ⊥)
    (hfield : IsField (K' ⊗[K] L)) :
    algebraicClosure F L = ⊥ := by
  classical
  letI : Field (K' ⊗[K] L) := hfield.toField
  haveI : IsDomain (K' ⊗[K] L) := Field.isDomain
  -- the right inclusion, injective because `L` is a field and the base change is not the zero ring
  set iR : L →+* K' ⊗[K] L :=
    (Algebra.TensorProduct.includeRight : L →ₐ[K] K' ⊗[K] L).toRingHom with hiRdef
  have hiRapply : ∀ z : L, iR z = (1 : K') ⊗ₜ[K] z := fun _ => rfl
  have hiRinj : Function.Injective iR := iR.injective
  have hiLapply : ∀ a : K', algebraMap K' (K' ⊗[K] L) a = a ⊗ₜ[K] (1 : L) := fun _ => rfl
  -- the two ways of putting an element of the base into the base change agree
  have hconstK : ∀ c : K,
      algebraMap K' (K' ⊗[K] L) (algebraMap K K' c) = iR (algebraMap K L c) := by
    intro c
    rw [hiLapply, hiRapply,
      Algebra.algebraMap_eq_smul_one (R := K) (A := K'),
      Algebra.algebraMap_eq_smul_one (R := K) (A := L), TensorProduct.smul_tmul]
  have hconst : ∀ a : F, algebraMap K' (K' ⊗[K] L) (algebraMap K K' (algebraMap F K a))
      = iR (algebraMap F L a) := by
    intro a
    rw [hconstK, ← IsScalarTower.algebraMap_apply F K L]
  -- the normalized trace: a `K`-linear retraction of `L` onto `K`
  have hdpos : 0 < Module.finrank K L := Module.finrank_pos
  have hdne : ((Module.finrank K L : ℕ) : K) ≠ 0 := Nat.cast_ne_zero.mpr hdpos.ne'
  set lam : L →ₗ[K] K := ((Module.finrank K L : K))⁻¹ • Algebra.trace K L with hlamdef
  have hlam1 : lam (1 : L) = 1 := by
    have htr : Algebra.trace K L 1 = ((Module.finrank K L : ℕ) : K) := by
      have h := Algebra.trace_algebraMap (R := K) (S := L) 1
      simpa [nsmul_eq_mul] using h
    rw [hlamdef]
    simp only [LinearMap.smul_apply, smul_eq_mul, htr]
    exact inv_mul_cancel₀ hdne
  -- the induced retraction of the base change onto `K'`
  set φ : K' ⊗[K] L →ₗ[K] K' :=
    (TensorProduct.rid K K').toLinearMap ∘ₗ TensorProduct.map LinearMap.id lam with hφdef
  have hφ : ∀ (a : K') (b : L), φ (a ⊗ₜ[K] b) = lam b • a := by
    intro a b
    simp [hφdef]
  refine le_antisymm (fun x hx => ?_) bot_le
  have hxint : IsIntegral F x := mem_algebraicClosure_iff'.mp hx
  have hqm : (minpoly F x).Monic := minpoly.monic hxint
  have hQm : (((minpoly F x).map (algebraMap F K)).map (algebraMap K K')).Monic :=
    (hqm.map _).map _
  -- `1 ⊗ x` is a root of the minimal polynomial of `x`, read over `K'`
  have hy0 : (aeval (iR x)) (((minpoly F x).map (algebraMap F K)).map (algebraMap K K')) = 0 := by
    rw [Polynomial.map_map, aeval_def, eval₂_map,
      show (algebraMap K' (K' ⊗[K] L)).comp ((algebraMap K K').comp (algebraMap F K))
          = iR.comp (algebraMap F L) from RingHom.ext hconst,
      ← hom_eval₂, ← aeval_def, minpoly.aeval, map_zero]
  -- that polynomial splits, so one linear factor vanishes
  have hfac : ((minpoly F x).map (algebraMap F K)).map (algebraMap K K')
      = ((((minpoly F x).map (algebraMap F K)).map (algebraMap K K')).roots.map
          fun a => X - C a).prod :=
    (hsplit (minpoly F x)).eq_prod_roots_of_monic hQm
  have hprod : (((((minpoly F x).map (algebraMap F K)).map (algebraMap K K')).roots.map
      fun a : K' => iR x - algebraMap K' (K' ⊗[K] L) a).prod) = 0 := by
    rw [hfac, map_multiset_prod, Multiset.map_map] at hy0
    simpa [Function.comp_def, Algebra.algebraMap_eq_smul_one] using hy0
  obtain ⟨r, hrmem, hr⟩ := Multiset.mem_map.mp (Multiset.prod_eq_zero_iff.mp hprod)
  have hyr : iR x = algebraMap K' (K' ⊗[K] L) r := sub_eq_zero.mp hr
  -- the retraction identifies `r` with the normalized trace of `x`
  have hrK : algebraMap K K' (lam x) = r := by
    have h1 : φ (iR x) = algebraMap K K' (lam x) := by
      rw [hiRapply, hφ, Algebra.algebraMap_eq_smul_one]
    have h2 : φ (algebraMap K' (K' ⊗[K] L) r) = r := by
      rw [hiLapply, hφ, hlam1, one_smul]
    rw [← h1, hyr, h2]
  -- so the trace is a root of the minimal polynomial of `x`, hence a constant
  have hqroot : Polynomial.eval (lam x) ((minpoly F x).map (algebraMap F K)) = 0 := by
    have h0 : Polynomial.eval r (((minpoly F x).map (algebraMap F K)).map (algebraMap K K')) = 0 :=
      isRoot_of_mem_roots hrmem
    rw [← hrK, eval_map, eval₂_hom] at h0
    exact FaithfulSMul.algebraMap_injective K K' (by rw [h0, map_zero])
  have hcint : IsIntegral F (lam x) :=
    ⟨minpoly F x, hqm, by rw [← eval_map]; exact hqroot⟩
  have hcmem : lam x ∈ (⊥ : IntermediateField F K) :=
    hbase ▸ mem_algebraicClosure_iff'.mpr hcint
  obtain ⟨c, hc⟩ := IntermediateField.mem_bot.mp hcmem
  -- both sides of `1 ⊗ x = r ⊗ 1` are the image of a constant
  refine IntermediateField.mem_bot.mpr ⟨c, ?_⟩
  refine hiRinj ?_
  rw [← hconst c, hc, hrK, hyr]

/-- **Regularity from absolute irreducibility of the primitive-element polynomial.**

If every polynomial over `F` splits in `K'`, if `F` is relatively algebraically closed in `K`, and
if the `K`-minimal polynomial of a primitive element of the finite extension `L / K` stays
irreducible over `K'`, then `F` is relatively algebraically closed in `L`. -/
theorem algebraicClosure_eq_bot_of_irreducible_map [FiniteDimensional K L] [CharZero K]
    (hsplit : ∀ p : F[X], ((p.map (algebraMap F K)).map (algebraMap K K')).Splits)
    (hbase : algebraicClosure F K = ⊥)
    (β : L) (hβtop : IntermediateField.adjoin K {β} = ⊤)
    (hirr : Irreducible ((minpoly K β).map (algebraMap K K'))) :
    algebraicClosure F L = ⊥ :=
  algebraicClosure_eq_bot_of_isField_tensor hsplit hbase
    (isField_tensor_of_primitive_irreducible L β hβtop hirr)

end Tensor

/-! ## Over the function field of the line

Specialising `F = ℚ`, `K = ℚ(T)` and `K' = ℚ̄(T)` turns the criterion into a statement about the
defining polynomial of a finite extension of `ℚ(T)`, and pairs it with
`irreducible_map_toClosureFrac_of_regular` into an equivalence. -/

section Geom

open scoped Polynomial

/-- **Every polynomial over `ℚ` splits in the geometric base field `ℚ̄(T)`.**  The constants of
`ℚ̄(T)` contain `ℚ̄`, which is algebraically closed. -/
theorem splits_map_toClosureFrac_comp_C (p : ℚ[X]) :
    (p.map (toClosureFrac.comp (Polynomial.C : ℚ →+* ℚ[X]))).Splits := by
  have hcomp : toClosureFrac.comp (Polynomial.C : ℚ →+* ℚ[X])
      = ((algebraMap (Polynomial (AlgebraicClosure ℚ))
            (FractionRing (Polynomial (AlgebraicClosure ℚ)))).comp
          (Polynomial.C : AlgebraicClosure ℚ →+* Polynomial (AlgebraicClosure ℚ))).comp
        (algebraMap ℚ (AlgebraicClosure ℚ)) := by
    ext a
    simp [toClosureFrac]
  rw [hcomp, ← Polynomial.map_map]
  exact (IsAlgClosed.splits (p.map (algebraMap ℚ (AlgebraicClosure ℚ)))).map _

/-- **Regularity from absolute irreducibility of the defining polynomial.**  A finite extension of
`ℚ(T)` generated by a root of `F ∈ ℚ[T][X]` has no constants beyond `ℚ` as soon as `F` stays
irreducible over the geometric base field `ℚ̄(T)`. -/
theorem algebraicClosure_eq_bot_of_irreducible_map_toClosureFrac
    {L : Type*} [Field L] [Algebra (RatFunc ℚ) L] [FiniteDimensional (RatFunc ℚ) L]
    [Algebra ℚ L] [IsScalarTower ℚ (RatFunc ℚ) L]
    (β : L) (hβtop : IntermediateField.adjoin (RatFunc ℚ) {β} = ⊤)
    (F : ℚ[X][X]) (hFmap : minpoly (RatFunc ℚ) β = F.map (algebraMap ℚ[X] (RatFunc ℚ)))
    (hirr : Irreducible (F.map toClosureFrac)) :
    algebraicClosure ℚ L = ⊥ := by
  -- the structure map `ℚ → ℚ(T) → ℚ̄(T)` is the constant inclusion followed by base change
  have hmapeq : (algebraMap (RatFunc ℚ) (FractionRing (Polynomial (AlgebraicClosure ℚ)))).comp
      (algebraMap ℚ (RatFunc ℚ)) = toClosureFrac.comp (Polynomial.C : ℚ →+* ℚ[X]) := by
    ext a
    show algebraMap (RatFunc ℚ) (FractionRing (Polynomial (AlgebraicClosure ℚ)))
      (algebraMap ℚ (RatFunc ℚ) a) = _
    rw [IsScalarTower.algebraMap_apply ℚ ℚ[X] (RatFunc ℚ), Polynomial.algebraMap_eq,
      algebraMap_ratFunc_geom_comp]
    rfl
  -- the composite `ℚ[T] → ℚ(T) → ℚ̄(T)` is the base change
  have hcomp : (algebraMap (RatFunc ℚ) (FractionRing (Polynomial (AlgebraicClosure ℚ)))).comp
      (algebraMap ℚ[X] (RatFunc ℚ)) = toClosureFrac :=
    RingHom.ext algebraMap_ratFunc_geom_comp
  have hirr' : Irreducible ((minpoly (RatFunc ℚ) β).map
      (algebraMap (RatFunc ℚ) (FractionRing (Polynomial (AlgebraicClosure ℚ))))) := by
    rw [hFmap, Polynomial.map_map, hcomp]
    exact hirr
  refine algebraicClosure_eq_bot_of_isField_tensor (F := ℚ) (K := RatFunc ℚ)
    (K' := FractionRing (Polynomial (AlgebraicClosure ℚ))) (L := L) ?_ regular_ratFunc
    (isField_tensor_of_primitive_irreducible L β hβtop hirr')
  intro p
  rw [Polynomial.map_map, hmapeq]
  exact splits_map_toClosureFrac_comp_C p

/-- **Regularity and absolute irreducibility are the same condition.**  For a finite extension of
`ℚ(T)` generated by a root of `F ∈ ℚ[T][X]`, the constants are exactly `ℚ` if and only if `F`
remains irreducible over `ℚ̄(T)`. -/
theorem algebraicClosure_eq_bot_iff_irreducible_map_toClosureFrac
    {L : Type*} [Field L] [Algebra (RatFunc ℚ) L] [FiniteDimensional (RatFunc ℚ) L]
    [Algebra ℚ L] [IsScalarTower ℚ (RatFunc ℚ) L]
    (β : L) (hβtop : IntermediateField.adjoin (RatFunc ℚ) {β} = ⊤)
    (F : ℚ[X][X]) (hFmap : minpoly (RatFunc ℚ) β = F.map (algebraMap ℚ[X] (RatFunc ℚ))) :
    algebraicClosure ℚ L = ⊥ ↔ Irreducible (F.map toClosureFrac) :=
  ⟨fun hreg => irreducible_map_toClosureFrac_of_regular hreg β hβtop F hFmap,
    fun hirr => algebraicClosure_eq_bot_of_irreducible_map_toClosureFrac β hβtop F hFmap hirr⟩

end Geom

end Rigidity.RET
