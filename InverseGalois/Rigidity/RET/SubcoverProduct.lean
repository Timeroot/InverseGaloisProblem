import Mathlib
import InverseGalois.Rigidity.RET.DeckGroups

/-!
# The deck group of a cover generated by two subcovers

Restriction to two Galois subcovers which generate a cover is injective on the deck group: a deck
transformation trivial on both is trivial on a generating set, hence trivial.  When in addition the
two subcovers are linearly disjoint — equivalently, meet in the base field alone — a dimension count
turns the injection into an isomorphism onto the product of the two deck groups.

## Main results

* `Rigidity.RET.LineCover.subHom_prod_injective` — restriction to two generating Galois subcovers is
  injective on the deck group.
* `Rigidity.RET.LineCover.nonempty_deck_mulEquiv_prod` — a cover generated by two linearly disjoint
  normal subcovers has for deck group the product of their deck groups.
-/

open Polynomial IntermediateField

noncomputable section

namespace Rigidity.RET

open GeomAKLB

attribute [local instance] GeomAKLB.instMSA GeomAKLB.instIntegral GeomAKLB.instIsFrac
  GeomAKLB.instIGG GeomAKLB.instFinite GeomAKLB.instDedekindB GeomAKLB.instTorsionFree
  GeomAKLB.instFaithful

namespace LineCover

attribute [local instance] sub_isGalois

/-- A deck transformation restricting to the identity on a Galois subcover fixes that subcover
pointwise. -/
theorem eq_of_subHom_eq_one (L : LineCover) (E : IntermediateField (RatFunc k) L.M)
    [Normal (RatFunc k) E] {σ : L.deck} (h : L.subHom E σ = 1) {x : L.M} (hx : x ∈ E) :
    σ x = x := by
  have h2 := AlgEquiv.restrictNormalHom_apply E σ ⟨x, hx⟩
  rw [show AlgEquiv.restrictNormalHom (E : Type) σ = (1 : (L.sub E).deck) from h] at h2
  simpa using h2.symm

/-- Restriction to two Galois subcovers which generate the cover is injective on the deck group. -/
theorem subHom_prod_injective (L : LineCover) (A B : IntermediateField (RatFunc k) L.M)
    [Normal (RatFunc k) A] [Normal (RatFunc k) B] (hsup : A ⊔ B = ⊤) :
    Function.Injective fun σ : L.deck => (L.subHom A σ, L.subHom B σ) := by
  have hone : ∀ σ : L.deck, L.subHom A σ = 1 → L.subHom B σ = 1 → σ = 1 := by
    intro σ hA hB
    refine eq_one_of_iSup (fun b : Bool => bif b then A else B) ?_ ?_
    · rw [iSup_bool_eq]; simpa using hsup
    · intro b x hx
      cases b with
      | true => exact eq_of_subHom_eq_one L A hA (by simpa using hx)
      | false => exact eq_of_subHom_eq_one L B hB (by simpa using hx)
  intro σ τ h
  have hA : L.subHom A σ = L.subHom A τ := congrArg Prod.fst h
  have hB : L.subHom B σ = L.subHom B τ := congrArg Prod.snd h
  have h1 : L.subHom A (σ * τ⁻¹) = 1 := by rw [map_mul, map_inv, hA, mul_inv_cancel]
  have h2 : L.subHom B (σ * τ⁻¹) = 1 := by rw [map_mul, map_inv, hB, mul_inv_cancel]
  have h3 := hone _ h1 h2
  rwa [mul_inv_eq_one] at h3

/-- **The deck group of a cover generated by two linearly disjoint Galois subcovers is the product
of their deck groups.** -/
theorem nonempty_deck_mulEquiv_prod (L : LineCover) (A B : IntermediateField (RatFunc k) L.M)
    [Normal (RatFunc k) A] [Normal (RatFunc k) B] (hsup : A ⊔ B = ⊤) (hinf : A ⊓ B = ⊥) :
    Nonempty (L.deck ≃* (L.sub A).deck × (L.sub B).deck) := by
  have hLD : A.LinearDisjoint (B : Type) := IntermediateField.LinearDisjoint.iff_inf_eq_bot.2 hinf
  have hrank : Module.finrank (RatFunc k) L.M
      = Module.finrank (RatFunc k) (A : Type) * Module.finrank (RatFunc k) (B : Type) := by
    have h := hLD.finrank_sup
    rw [hsup] at h
    rw [← h]
    exact (LinearEquiv.finrank_eq (IntermediateField.topEquiv (F := RatFunc k)
      (E := L.M)).toLinearEquiv).symm
  have hcard : Nat.card L.deck = Nat.card ((L.sub A).deck × (L.sub B).deck) := by
    rw [Nat.card_prod, IsGalois.card_aut_eq_finrank (RatFunc k) L.M,
      IsGalois.card_aut_eq_finrank (RatFunc k) (L.sub A).M,
      IsGalois.card_aut_eq_finrank (RatFunc k) (L.sub B).M]
    exact hrank
  have hbij : Function.Bijective fun σ : L.deck => (L.subHom A σ, L.subHom B σ) :=
    (Nat.bijective_iff_injective_and_card _).2 ⟨subHom_prod_injective L A B hsup, hcard⟩
  exact ⟨MulEquiv.ofBijective ((L.subHom A).prod (L.subHom B)) hbij⟩

end LineCover

end Rigidity.RET
