import Mathlib
import InverseGalois.Rigidity.RET.Wreath.GeomBase
import InverseGalois.Rigidity.RET.Wreath.CyclicNormalForm

/-!
# A radical generator of a cyclic geometric layer, and its action on a rational model

A cyclic cover of the line is a multi-point Kummer cover: it is the splitting field over `ℚ̄(T)` of
`Xⁿ - ∏ᵢ (T - tᵢ)^{eᵢ}`, with that polynomial irreducible and the exponents `eᵢ` having no factor in
common with `n` (`Rigidity.RET.exists_multiKummer_model_gcd`).  An irreducible polynomial that
splits in its splitting field has a root there, and the root generates a subextension of the full
degree `n`, so the splitting field is already generated by *one* radical: a single `y` with
`yⁿ = ∏ᵢ (T - tᵢ)^{eᵢ}`.  This is the shape in which a cyclic layer is fed to the local analysis at
the branch points, where the exponents `eᵢ` are read off as the orders of the radicand.

The layer lives inside the fixed algebraic closure `QTbar` of `QT = ℚ(T)`, over the geometric base
`ℚ̄(T)`, while the arithmetic input is a rational model: an intermediate field `Nf` of `QTbar / ℚ(T)`
which is normal over `ℚ(T)` and which generates the layer over `ℚ̄(T)`.  The second half of this file
compares the two Galois groups.  A `ℚ̄(T)`-automorphism `σ` of the layer fixes `ℚ̄(T)`, hence in
particular fixes `ℚ(T)`, so it restricts to a `ℚ(T)`-embedding of `Nf` into `QTbar`; normality of
`Nf` sends that embedding back into `Nf`, and an algebraic self-embedding of a field is an
automorphism.  Restriction is a group homomorphism, and it is injective because `ℚ̄(T)` and `Nf`
together generate the layer, so an automorphism trivial on both is trivial.

## Main results

* `Rigidity.RET.Wreath.adjoin_coe_eq_of_adjoin_eq_top` — a subset generating an intermediate field
  internally generates it inside the ambient field.
* `Rigidity.RET.Wreath.adjoin_eq_top_of_adjoin_coe_eq` — the converse reading of the same
  generation statement.
* `Rigidity.RET.Wreath.exists_kummer_generator` — a cyclic geometric layer is generated by a single
  radical of a multi-point Kummer radicand whose exponents are coprime to the degree.
* `Rigidity.RET.Wreath.restrictAut` — restriction of the geometric Galois group of a layer to the
  Galois group of a rational model generating it.
* `Rigidity.RET.Wreath.coe_restrictAut` — the restriction acts by the same formula as the
  automorphism it comes from.
* `Rigidity.RET.Wreath.restrictAut_injective` — restriction to a generating rational model is
  injective.
-/

open Polynomial

noncomputable section

namespace Rigidity.RET.Wreath

open GeomAKLB (k)

/-! ## Transporting generation across an intermediate field -/

/-- **A generating subset of an intermediate field generates it inside the ambient field.**  If `S`
generates `W` over `F` when read inside `W`, then the image of `S` in the ambient field generates
exactly `W`, because the image of an intermediate field of `W / F` under the inclusion of `W` is the
corresponding intermediate field of the ambient extension, and the image of `W` itself is `W`. -/
theorem adjoin_coe_eq_of_adjoin_eq_top {F Ω : Type*} [Field F] [Field Ω] [Algebra F Ω]
    (W : IntermediateField F Ω) {S : Set ↥W}
    (h : IntermediateField.adjoin F S = ⊤) :
    IntermediateField.adjoin F ((↑) '' S : Set Ω) = W := by
  rw [← IntermediateField.lift_adjoin, h, IntermediateField.lift_top]

/-- **A subset of an intermediate field that generates it in the ambient field generates it
internally.**  Converse reading of `adjoin_coe_eq_of_adjoin_eq_top`: the inclusion of `W` induces an
injection on intermediate fields, so the two generation statements are equivalent. -/
theorem adjoin_eq_top_of_adjoin_coe_eq {F Ω : Type*} [Field F] [Field Ω] [Algebra F Ω]
    (W : IntermediateField F Ω) {S : Set ↥W}
    (h : IntermediateField.adjoin F ((↑) '' S : Set Ω) = W) :
    IntermediateField.adjoin F S = ⊤ := by
  refine IntermediateField.lift_injective W ?_
  rw [IntermediateField.lift_adjoin, IntermediateField.lift_top, h]

/-! ## A single radical generator -/

/-- **A cyclic cover of the line is generated by a single radical.**  Realised inside `QTbar` over
the geometric base `ℚ̄(T)`, a finite Galois extension `W` with cyclic Galois group is the splitting
field of an irreducible `Xⁿ - ∏ᵢ (T - tᵢ)^{eᵢ}`, where `n = [W : ℚ̄(T)]`, the points `tᵢ` are
distinct and the exponents `eᵢ` have no factor in common with `n`.  That polynomial splits in `W`,
so it has a root `y` there; being irreducible and monic it is the minimal polynomial of `y`, whose
degree is already `n`, so `y` alone generates `W`. -/
theorem exists_kummer_generator (W : IntermediateField (RatFunc k) QTbar)
    [FiniteDimensional (RatFunc k) ↥W] [IsGalois (RatFunc k) ↥W]
    [IsCyclic (↥W ≃ₐ[RatFunc k] ↥W)] :
    ∃ (r : ℕ) (t : Fin r → k) (e : Fin r → ℕ) (y : ↥W),
      Function.Injective t ∧
      Nat.gcd (Module.finrank (RatFunc k) ↥W) (Finset.univ.gcd e) = 1 ∧
      y ^ (Module.finrank (RatFunc k) ↥W)
        = algebraMap (RatFunc k) ↥W (algebraMap (Polynomial k) (RatFunc k) (multiA t e)) ∧
      IntermediateField.adjoin (RatFunc k) ({(y : QTbar)} : Set QTbar) = W := by
  obtain ⟨r, t, e, hinj, -, hgcd, hirr, hsplit⟩ := exists_multiKummer_model_gcd (lineCoverOf W)
  have hn : 0 < Module.finrank (RatFunc k) ↥W := Module.finrank_pos
  have hgcd' : Nat.gcd (Module.finrank (RatFunc k) ↥W) (Finset.univ.gcd e) = 1 := hgcd
  have hirr' : Irreducible (X ^ Module.finrank (RatFunc k) ↥W -
      C (algebraMap (Polynomial k) (RatFunc k) (multiA t e))) := hirr
  have hsplit' : IsSplittingField (RatFunc k) ↥W
      (X ^ Module.finrank (RatFunc k) ↥W -
        C (algebraMap (Polynomial k) (RatFunc k) (multiA t e))) := hsplit
  have hsp := IsSplittingField.splits (K := RatFunc k) ↥W
    (X ^ Module.finrank (RatFunc k) ↥W -
      C (algebraMap (Polynomial k) (RatFunc k) (multiA t e)))
  rw [Polynomial.map_sub, Polynomial.map_pow, Polynomial.map_X, Polynomial.map_C] at hsp
  have hdeg : (X ^ Module.finrank (RatFunc k) ↥W -
      C (algebraMap (RatFunc k) ↥W
        (algebraMap (Polynomial k) (RatFunc k) (multiA t e))) : (↥W)[X]).degree ≠ 0 := by
    rw [degree_X_pow_sub_C hn]
    exact_mod_cast hn.ne'
  obtain ⟨y, hy⟩ := hsp.exists_eval_eq_zero hdeg
  rw [eval_sub, eval_pow, eval_X, eval_C, sub_eq_zero] at hy
  refine ⟨r, t, e, y, hinj, hgcd', hy, ?_⟩
  have hmin : X ^ Module.finrank (RatFunc k) ↥W -
      C (algebraMap (Polynomial k) (RatFunc k) (multiA t e)) = minpoly (RatFunc k) y :=
    minpoly.eq_of_irreducible_of_monic hirr' (by simp [hy])
      (monic_X_pow_sub_C _ hn.ne')
  have htop : IntermediateField.adjoin (RatFunc k) ({y} : Set ↥W) = ⊤ := by
    rw [Field.primitive_element_iff_minpoly_natDegree_eq, ← hmin, natDegree_X_pow_sub_C]
  simpa using adjoin_coe_eq_of_adjoin_eq_top W htop

/-! ## Restricting geometric automorphisms to a rational model -/

section Restrict

variable (Nf : IntermediateField QT QTbar) (W : IntermediateField (RatFunc k) QTbar)

/-- **A rational model generating a geometric layer is contained in it.**  A set is contained in the
field it generates. -/
theorem coe_subset_of_adjoin_eq
    (hgen : IntermediateField.adjoin (RatFunc k) (Nf : Set QTbar) = W) :
    (Nf : Set QTbar) ⊆ (W : Set QTbar) :=
  hgen ▸ IntermediateField.subset_adjoin (RatFunc k) (Nf : Set QTbar)

/-- **A `ℚ̄(T)`-automorphism of a layer fixes the rational base `ℚ(T)`.**  Every element of `QTbar`
of the form `algebraMap ℚ(T) QTbar q` comes from the geometric base `ℚ̄(T)`, and an automorphism over
`ℚ̄(T)` fixes it. -/
theorem apply_of_coe_eq_algebraMap (σ : ↥W ≃ₐ[RatFunc k] ↥W) (x : ↥W) (q : QT)
    (hx : (x : QTbar) = algebraMap QT QTbar q) :
    ((σ x : ↥W) : QTbar) = algebraMap QT QTbar q := by
  obtain ⟨u, hu⟩ := mem_geomBase_iff.1 (algebraMap_mem_geomBase q)
  have hval : ((algebraMap (RatFunc k) ↥W u : ↥W) : QTbar) = algebraMap (RatFunc k) QTbar u :=
    W.val.commutes u
  have h1 : x = algebraMap (RatFunc k) ↥W u := Subtype.ext (by rw [hval, hu, hx])
  rw [h1, AlgEquiv.commutes, hval, hu]

/-- **The inclusion of one intermediate field of `QTbar` into another containing it**, as a ring
homomorphism.  The two fields are taken over different base fields, so only the ring structure is
transported. -/
def inclOfCoeSubset (h : (Nf : Set QTbar) ⊆ (W : Set QTbar)) : ↥Nf →+* ↥W where
  toFun x := ⟨(x : QTbar), h x.2⟩
  map_one' := rfl
  map_mul' _ _ := rfl
  map_zero' := rfl
  map_add' _ _ := rfl

/-- **A `ℚ̄(T)`-automorphism of a layer, read as a `ℚ(T)`-embedding of a rational model into
`QTbar`.**  The model is contained in the layer, so the automorphism may be applied to its elements;
the result is a ring homomorphism into `QTbar`, and it fixes `ℚ(T)` because the automorphism fixes
the whole geometric base. -/
noncomputable def restrictAlgHom
    (hgen : IntermediateField.adjoin (RatFunc k) (Nf : Set QTbar) = W)
    (σ : ↥W ≃ₐ[RatFunc k] ↥W) : ↥Nf →ₐ[QT] QTbar :=
  { W.val.toRingHom.comp
      ((σ : ↥W →ₐ[RatFunc k] ↥W).toRingHom.comp
        (inclOfCoeSubset Nf W (coe_subset_of_adjoin_eq Nf W hgen))) with
    commutes' := fun q => apply_of_coe_eq_algebraMap W σ _ q (Nf.val.commutes q) }

/-- The embedding attached to a geometric automorphism is computed by that automorphism. -/
theorem restrictAlgHom_apply
    (hgen : IntermediateField.adjoin (RatFunc k) (Nf : Set QTbar) = W)
    (σ : ↥W ≃ₐ[RatFunc k] ↥W) (x : ↥Nf) (hx : (x : QTbar) ∈ W) :
    restrictAlgHom Nf W hgen σ x = (σ ⟨(x : QTbar), hx⟩ : ↥W) := rfl

variable [Normal QT ↥Nf]

/-- **A geometric automorphism maps a normal rational model into itself.**  The associated
`ℚ(T)`-embedding of the model into `QTbar` has field range the model itself, by normality. -/
theorem restrictAlgHom_apply_mem
    (hgen : IntermediateField.adjoin (RatFunc k) (Nf : Set QTbar) = W)
    (σ : ↥W ≃ₐ[RatFunc k] ↥W) (x : ↥Nf) : restrictAlgHom Nf W hgen σ x ∈ Nf := by
  have h : (restrictAlgHom Nf W hgen σ).fieldRange = Nf := AlgHom.fieldRange_of_normal _
  exact h.le (AlgHom.mem_fieldRange.2 ⟨x, rfl⟩)

/-- **A `ℚ̄(T)`-automorphism of a layer, read as a `ℚ(T)`-endomorphism of a normal rational
model.**  The corestriction of `restrictAlgHom` along `restrictAlgHom_apply_mem`. -/
noncomputable def restrictAlgHom'
    (hgen : IntermediateField.adjoin (RatFunc k) (Nf : Set QTbar) = W)
    (σ : ↥W ≃ₐ[RatFunc k] ↥W) : ↥Nf →ₐ[QT] ↥Nf where
  toFun x := ⟨restrictAlgHom Nf W hgen σ x, restrictAlgHom_apply_mem Nf W hgen σ x⟩
  map_one' := Subtype.ext (map_one _)
  map_mul' _ _ := Subtype.ext (map_mul _ _ _)
  map_zero' := Subtype.ext (map_zero _)
  map_add' _ _ := Subtype.ext (map_add _ _ _)
  commutes' q := Subtype.ext ((restrictAlgHom Nf W hgen σ).commutes q)

/-- **Restriction of the geometric Galois group of a layer to a normal rational model generating
it.**  A `ℚ̄(T)`-automorphism of the layer restricts to a `ℚ(T)`-endomorphism of the model, which is
an automorphism because the model is algebraic over `ℚ(T)`; restriction is compatible with
composition. -/
noncomputable def restrictAut
    (hgen : IntermediateField.adjoin (RatFunc k) (Nf : Set QTbar) = W) :
    (↥W ≃ₐ[RatFunc k] ↥W) →* (↥Nf ≃ₐ[QT] ↥Nf) where
  toFun σ := (Algebra.IsAlgebraic.algEquivEquivAlgHom QT ↥Nf).symm (restrictAlgHom' Nf W hgen σ)
  map_one' := AlgEquiv.ext fun _ => Subtype.ext rfl
  map_mul' _ _ := AlgEquiv.ext fun _ => Subtype.ext rfl

/-- **The restriction of a geometric automorphism acts by the same formula.**  Evaluating the
restricted automorphism at an element of the rational model and viewing the result in `QTbar` gives
the value of the original automorphism at that element, viewed in the layer. -/
theorem coe_restrictAut
    (hgen : IntermediateField.adjoin (RatFunc k) (Nf : Set QTbar) = W)
    (σ : ↥W ≃ₐ[RatFunc k] ↥W) (x : ↥Nf) (hx : (x : QTbar) ∈ W) :
    ((restrictAut Nf W hgen σ x : ↥Nf) : QTbar) = (σ ⟨(x : QTbar), hx⟩ : ↥W) := rfl

/-- **Restriction to a generating rational model is injective.**  A geometric automorphism whose
restriction to the model is trivial fixes the model pointwise; it also fixes `ℚ̄(T)`, and the two
generate the layer, so the fixed field of the subgroup it generates is everything. -/
theorem restrictAut_injective
    (hgen : IntermediateField.adjoin (RatFunc k) (Nf : Set QTbar) = W) :
    Function.Injective (restrictAut Nf W hgen) := by
  rw [injective_iff_map_eq_one]
  intro σ hσ
  have hsub := coe_subset_of_adjoin_eq Nf W hgen
  have himg : ((↑) '' {z : ↥W | (z : QTbar) ∈ Nf} : Set QTbar) = (Nf : Set QTbar) := by
    ext z
    exact ⟨fun ⟨_, hw, hzw⟩ => hzw ▸ hw, fun hz => ⟨⟨z, hsub hz⟩, hz, rfl⟩⟩
  have htop : IntermediateField.adjoin (RatFunc k) {z : ↥W | (z : QTbar) ∈ Nf} = ⊤ :=
    adjoin_eq_top_of_adjoin_coe_eq W (by rw [himg, hgen])
  have hfix : {z : ↥W | (z : QTbar) ∈ Nf} ⊆ (IntermediateField.fixedField
      (Subgroup.closure ({σ} : Set (↥W ≃ₐ[RatFunc k] ↥W))) : Set ↥W) := by
    intro z hz
    refine mem_fixedField_closure_singleton (Subtype.ext ?_)
    have h := coe_restrictAut Nf W hgen σ ⟨(z : QTbar), hz⟩ z.2
    rw [hσ] at h
    exact h.symm
  have hle := IntermediateField.adjoin_le_iff.2 hfix
  rw [htop] at hle
  refine AlgEquiv.ext fun z => ?_
  exact (IntermediateField.mem_fixedField_iff _ _).1 (hle IntermediateField.mem_top) σ
    (Subgroup.subset_closure rfl)

end Restrict

end Rigidity.RET.Wreath
