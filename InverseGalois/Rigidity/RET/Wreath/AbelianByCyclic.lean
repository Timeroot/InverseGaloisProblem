import Mathlib
import InverseGalois.Rigidity.RET.Wreath.Main
import InverseGalois.Solvable.SemiabelianCriterion

/-!
# Abelian-by-cyclic groups, regularly over `ℚ(T)`

A finite group with a normal abelian subgroup of cyclic quotient is semiabelian, whether or not the
extension splits, because the cyclic group generated by a lift of a generator of the quotient
covers the extension.  Every semiabelian group is realized regularly over `ℚ(T)`, so the whole
abelian-by-cyclic class enters the catalogue at once.  The class contains every metacyclic group,
in particular every dihedral, quaternion and dicyclic group, and every finite group with an abelian
subgroup of prime index.

## Main results

* `isRegularInverseGalois_of_normal_abelian_of_isCyclic_quotient`: **a finite group with a normal
  abelian subgroup of cyclic quotient is a regular inverse Galois group over `ℚ(T)`.**
* `isRegularInverseGalois_of_normal_abelian_of_prime_index`: the same when the subgroup has prime
  index.
* `isRegularInverseGalois_of_isCyclic_of_isCyclic_quotient`: the metacyclic case.
-/

namespace InverseGalois

/-- **A finite group with a normal abelian subgroup of cyclic quotient is a regular inverse Galois
group over `ℚ(T)`.** -/
theorem isRegularInverseGalois_of_normal_abelian_of_isCyclic_quotient {G : Type} [Group G]
    [Finite G] (N : Subgroup G) [N.Normal] (hcomm : ∀ x y : ↥N, x * y = y * x)
    [IsCyclic (G ⧸ N)] : IsRegularInverseGalois G :=
  isRegularInverseGalois_of_isSemiabelian
    (IsSemiabelian.of_normal_abelian_of_isCyclic_quotient N hcomm)

/-- **A finite group with a normal abelian subgroup of prime index is a regular inverse Galois
group over `ℚ(T)`.** -/
theorem isRegularInverseGalois_of_normal_abelian_of_prime_index {G : Type} [Group G] [Finite G]
    (N : Subgroup G) [N.Normal] (hcomm : ∀ x y : ↥N, x * y = y * x) {p : ℕ} [Fact p.Prime]
    (hp : N.index = p) : IsRegularInverseGalois G :=
  isRegularInverseGalois_of_isSemiabelian
    (IsSemiabelian.of_normal_abelian_of_prime_index N hcomm hp)

/-- **Every finite metacyclic group is a regular inverse Galois group over `ℚ(T)`.** -/
theorem isRegularInverseGalois_of_isCyclic_of_isCyclic_quotient {G : Type} [Group G] [Finite G]
    (N : Subgroup G) [N.Normal] [IsCyclic ↥N] [IsCyclic (G ⧸ N)] : IsRegularInverseGalois G :=
  isRegularInverseGalois_of_isSemiabelian
    (IsSemiabelian.of_isCyclic_of_isCyclic_quotient N)

/-- **Every generalized quaternion group is a regular inverse Galois group over `ℚ(T)`.** -/
theorem isRegularInverseGalois_quaternion (n : ℕ) [NeZero n] :
    IsRegularInverseGalois (QuaternionGroup n) :=
  isRegularInverseGalois_of_isSemiabelian (IsSemiabelian.quaternion n)

end InverseGalois
