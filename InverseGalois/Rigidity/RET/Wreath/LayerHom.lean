import Mathlib
import InverseGalois.Rigidity.RET.Wreath.KummerLayer
import InverseGalois.Rigidity.RET.Wreath.SubstHom

/-!
# Pulling a layer back along a substitution

A layer of the wreath construction is a copy of the cyclic extension `N` inside `ℚ̄(T)‾`, embedded
so that the variable goes to a translated conjugate `u = h(θ) + c`.  The radicals that generate the
layer geometrically, however, live not in `N` but in the compositum of `N` with the constants `ℚ̄`,
so the embedding has to be extended to that compositum before the radicals can be transported.

The extension exists because the compositum is finite over the geometric line and the target is
algebraically closed.  What has to be checked is that the extension does not leave the compositum
of all the layers: its restriction to the geometric line is the substitution, whose image is
generated by the constants and by `u`, and its restriction to the layer differs from the given
embedding of `N` only by an automorphism of `N`, because the two agree on the base and `N` is
normal.

## Main results

* `Rigidity.RET.Wreath.corestrict` — a ring homomorphism with values in an intermediate field,
  read as a homomorphism into that field.
* `Rigidity.RET.Wreath.exists_layerHom` — the extension of a substitution to the geometric
  closure of a layer, together with the subfields that contain its image.
-/

open Polynomial

noncomputable section

namespace Rigidity.RET.Wreath

open GeomAKLB

/-- **A ring homomorphism with values in an intermediate field, read as a homomorphism into that
field.** -/
def corestrict {N : Type*} [Field N] (ι : N →+* QTbar)
    (W : IntermediateField (RatFunc k) QTbar) (h : ∀ x, ι x ∈ W) : N →+* ↥W where
  toFun x := ⟨ι x, h x⟩
  map_one' := Subtype.ext (map_one ι)
  map_mul' _ _ := Subtype.ext (map_mul ι _ _)
  map_zero' := Subtype.ext (map_zero ι)
  map_add' _ _ := Subtype.ext (map_add ι _ _)

@[simp] theorem coe_corestrict {N : Type*} [Field N] (ι : N →+* QTbar)
    (W : IntermediateField (RatFunc k) QTbar) (h : ∀ x, ι x ∈ W) (x : N) :
    ((corestrict ι W h x : ↥W) : QTbar) = ι x := rfl

/-- **A substitution extends to the geometric closure of a layer without leaving the compositum of
the layers.**  The extension exists because the geometric closure is a finite extension of the
line; its image is generated by the image of the line, which the substitution confines to the
constants and the substituted element, and by the image of the layer, which differs from the given
embedding only by an automorphism of the layer. -/
theorem exists_layerHom {N : Type} [Field N] [Algebra QT N] [Normal QT N]
    (ι : N →ₐ[QT] QTbar) (W : IntermediateField (RatFunc k) QTbar)
    [FiniteDimensional (RatFunc k) ↥W]
    (hW : IntermediateField.adjoin (RatFunc k) (ι.fieldRange : Set QTbar) = W)
    {u : QTbar} (hu : Transcendental k u)
    (ε : N →+* QTbar) (hεX : ε (algebraMap QT N RatFunc.X) = u) :
    ∃ f : ↥W →+* QTbar,
      (∀ r : RatFunc k, f (algebraMap (RatFunc k) ↥W r) = paramHom u hu r) ∧
        ∀ Z : Subfield QTbar, (∀ a : k, algebraMap k QTbar a ∈ Z) → u ∈ Z →
          (∀ x : N, ε x ∈ Z) → ∀ y : ↥W, f y ∈ Z := by
  obtain ⟨f, hf⟩ := exists_substHom ↥W hu
  -- The layer sits inside its geometric closure.
  have hmem : ∀ x : N, ι x ∈ W := by
    intro x
    rw [← hW]
    exact IntermediateField.subset_adjoin _ _ ⟨x, rfl⟩
  set ιbar : N →+* ↥W := corestrict ι.toRingHom W hmem with hιbar
  -- The variable of the base and the variable of the line have the same image.
  have hvar : ιbar (algebraMap QT N RatFunc.X) = algebraMap (RatFunc k) ↥W RatFunc.X := by
    apply Subtype.ext
    rw [hιbar, coe_corestrict]
    show ι (algebraMap QT N RatFunc.X) = _
    rw [ι.commutes, algebraMap_QT_X]
    rfl
  -- The extension and the given embedding agree on the base.
  have hagree : ∀ q : QT, (f.comp ιbar) (algebraMap QT N q) = ε (algebraMap QT N q) := by
    have hext : (f.comp ιbar).comp (algebraMap QT N) = ε.comp (algebraMap QT N) := by
      refine ringHom_ratFunc_ext _ _ ?_
      show f (ιbar (algebraMap QT N RatFunc.X)) = ε (algebraMap QT N RatFunc.X)
      rw [hvar, hf, paramHom_X, hεX]
    intro q
    exact congrFun (congrArg (fun g : QT →+* QTbar => (g : QT → QTbar)) hext) q
  obtain ⟨β, hβ, -⟩ := existsUnique_algEquiv_comp (F := QT) ε (f.comp ιbar) hagree
  refine ⟨f, hf, fun Z hk hu' hε y => ?_⟩
  -- Everything in the geometric closure is generated by the line and by the layer.
  refine range_subset_of_adjoin_set_eq_top (F := RatFunc k)
    (S := {y : ↥W | (y : QTbar) ∈ ι.fieldRange}) ?_ f Z (fun r => ?_) (fun s hs => ?_) y
  · refine adjoin_eq_top_of_adjoin_coe_eq W ?_
    have himg : ((↑) '' {y : ↥W | (y : QTbar) ∈ ι.fieldRange} : Set QTbar)
        = (ι.fieldRange : Set QTbar) := by
      ext x
      constructor
      · rintro ⟨z, hz, rfl⟩
        exact hz
      · intro hx
        obtain ⟨n, rfl⟩ := hx
        exact ⟨⟨ι n, hmem n⟩, ⟨n, rfl⟩, rfl⟩
    rw [himg, hW]
  · rw [hf r]
    exact paramHom_mem_of_mem hu Z hk hu' r
  · obtain ⟨n, hn⟩ := hs
    have hsn : s = ιbar n := Subtype.ext hn.symm
    rw [hsn]
    show (f.comp ιbar) n ∈ Z
    rw [hβ n]
    exact hε _

end Rigidity.RET.Wreath
