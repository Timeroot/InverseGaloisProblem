import Mathlib
import InverseGalois.Rigidity.RET.Genus.Ord

/-!
# Orders and powers of a prime

The order of an element of a Dedekind domain at a height-one prime is the exponent of that prime in
the factorization of the ideal the element generates.  So the order is at least `j` exactly when the
element lies in the `j`-th power of the prime: the two ways of saying "vanishes to order `j`" — one
by counting factors of a fractional ideal, one by membership in an ideal — agree.

The membership form is the useful one for a group acting on the cover: a deck transformation fixing
the prime fixes each of its powers, so a statement about membership in a power of the prime is
automatically invariant under the decomposition group, while the counting form has to be transported
by hand.

## Main results

* `Rigidity.RET.mem_pow_iff_le_ord` — an element lies in the `j`-th power of a prime exactly when
  its order there is at least `j`.
* `Rigidity.RET.ord_eq_of_mem_pow_of_notMem_pow` — an element lying in one power but not the next
  has that order exactly.
-/

open IsDedekindDomain FractionalIdeal

noncomputable section

namespace Rigidity.RET

variable {R : Type*} [CommRing R] [IsDedekindDomain R]
variable {K : Type*} [Field K] [Algebra R K] [IsFractionRing R K]
variable (v : HeightOneSpectrum R)

/-- **A power of the prime divides the ideal generated by an element exactly when the order is at
least the exponent.**  Both sides count the multiplicity of the prime in the factorization. -/
theorem pow_dvd_span_iff_le_ord {r : R} (hr : r ≠ 0) (j : ℕ) :
    v.asIdeal ^ j ∣ Ideal.span {r} ↔ (j : ℤ) ≤ ord K v (algebraMap R K r) := by
  classical
  have hspan : (Ideal.span {r} : Ideal R) ≠ 0 := by
    simpa [Ideal.zero_eq_bot, Ideal.span_singleton_eq_bot] using hr
  rw [ord_algebraMap, FractionalIdeal.count_coe K v hspan, Int.ofNat_le]
  rw [← Associates.mk_le_mk_iff_dvd, Associates.mk_pow]
  exact Associates.prime_pow_dvd_iff_le (Associates.mk_ne_zero.mpr hspan)
    (Associates.irreducible_mk.mpr v.irreducible)

/-- **An element lies in the `j`-th power of a prime exactly when its order there is at least
`j`.** -/
theorem mem_pow_iff_le_ord {r : R} (hr : r ≠ 0) (j : ℕ) :
    r ∈ v.asIdeal ^ j ↔ (j : ℤ) ≤ ord K v (algebraMap R K r) := by
  rw [← pow_dvd_span_iff_le_ord (K := K) v hr j, Ideal.dvd_iff_le, Ideal.span_le,
    Set.singleton_subset_iff, SetLike.mem_coe]

/-- **An element of a power of a prime has order at least the exponent.** -/
theorem le_ord_of_mem_pow {r : R} (hr : r ≠ 0) {j : ℕ} (h : r ∈ v.asIdeal ^ j) :
    (j : ℤ) ≤ ord K v (algebraMap R K r) :=
  (mem_pow_iff_le_ord (K := K) v hr j).mp h

/-- **An element outside a power of a prime has order below the exponent.** -/
theorem ord_lt_of_notMem_pow {r : R} (hr : r ≠ 0) {j : ℕ} (h : r ∉ v.asIdeal ^ j) :
    ord K v (algebraMap R K r) < (j : ℤ) :=
  lt_of_not_ge fun hle => h ((mem_pow_iff_le_ord (K := K) v hr j).mpr hle)

/-- **An element lying in one power of a prime but not in the next vanishes to exactly that
order.** -/
theorem ord_eq_of_mem_pow_of_notMem_pow {r : R} (hr : r ≠ 0) {j : ℕ} (h : r ∈ v.asIdeal ^ j)
    (h' : r ∉ v.asIdeal ^ (j + 1)) : ord K v (algebraMap R K r) = (j : ℤ) := by
  have h1 : (j : ℤ) ≤ ord K v (algebraMap R K r) := le_ord_of_mem_pow (K := K) v hr h
  have h2 : ord K v (algebraMap R K r) < ((j + 1 : ℕ) : ℤ) := ord_lt_of_notMem_pow (K := K) v hr h'
  push_cast at h2
  omega

end Rigidity.RET
