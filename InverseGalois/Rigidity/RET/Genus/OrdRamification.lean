import Mathlib
import InverseGalois.Rigidity.RET.Genus.Ord
import InverseGalois.Rigidity.RET.Genus.UnramifiedAbstract

/-!
# The order of a function of the base at an unramified place

A place of a cover lying over a point of the base sees the functions of the base through the
ramification index: a function of the base vanishing to first order at the point below vanishes at
the place to the order of ramification there.  When the place carries no non-trivial inertia the
ramification index is one, and the function of the base is a coordinate at the place as well.

The order at a place is the multiplicity of the prime in the factorization of the ideal generated
by the function, so an upper bound for it is a failure of divisibility by a power of the prime;
and that failure is exactly what a ramification index of one provides.

## Main results

* `Rigidity.RET.ord_le_of_not_pow_dvd` — a failure of divisibility bounds the order from above.
* `Rigidity.RET.ramificationIdx_eq_one_of_inertia_trivial` — a place with trivial inertia has
  ramification index one.
* `Rigidity.RET.ord_eq_one_of_inertia_trivial` — a generator of the prime below is a coordinate at
  a place with trivial inertia.
-/

open IsDedekindDomain

noncomputable section


namespace Rigidity.RET

/-! ## Bounding the order from above -/

section Bound

variable {B : Type*} [CommRing B] [IsDedekindDomain B]
variable {K : Type*} [Field K] [Algebra B K] [IsFractionRing B K]

/-- **A failure of divisibility bounds the order from above.**  The order at a place is the
multiplicity of the prime in the factorization of the ideal generated by the function. -/
theorem ord_le_of_not_pow_dvd (v : HeightOneSpectrum B) {b : B} (hb : b ≠ 0) {n : ℕ}
    (h : ¬ v.asIdeal ^ (n + 1) ∣ Ideal.span {b}) : ord K v (algebraMap B K b) ≤ n := by
  classical
  have hspan : (Ideal.span {b} : Ideal B) ≠ 0 := by
    simpa [Ideal.zero_eq_bot, Ideal.span_singleton_eq_bot] using hb
  rw [ord_algebraMap, FractionalIdeal.count_coe K v hspan]
  by_contra hcon
  push_neg at hcon
  have hle : n + 1 ≤ (Associates.mk v.asIdeal).count (Associates.mk (Ideal.span {b})).factors := by
    exact_mod_cast hcon
  have hdvd := (Associates.prime_pow_dvd_iff_le (Associates.mk_ne_zero.mpr hspan)
    (Associates.irreducible_mk.mpr v.irreducible)).2 hle
  rw [← Associates.mk_pow, Associates.mk_le_mk_iff_dvd] at hdvd
  exact h hdvd

end Bound

/-! ## Trivial inertia makes a generator of the prime below a coordinate -/

section Inertia

variable {A B G : Type*} [CommRing A] [CommRing B] [Algebra A B]
  [Group G] [MulSemiringAction G B] [IsGaloisGroup G A B] [Finite G]
  [IsDedekindDomain A] [IsDedekindDomain B] [Module.Finite A B] [Module.IsTorsionFree A B]
  [Algebra.EssFiniteType A B] [Algebra.IsIntegral A B]

omit [Algebra.EssFiniteType A B] in
/-- **A place with trivial inertia has ramification index one.**  The order of the inertia group at
a place of a Galois extension of Dedekind domains is the ramification index there. -/
theorem ramificationIdx_eq_one_of_inertia_trivial (Q : Ideal B) [Q.IsMaximal] (hQ : Q ≠ ⊥)
    [Algebra.IsSeparable (A ⧸ Q.under A) (B ⧸ Q)]
    (h : ∀ σ : G, σ ∈ Ideal.inertia G Q → σ = 1) :
    Ideal.ramificationIdx (algebraMap A B) (Q.under A) Q = 1 := by
  have hp : Q.under A ≠ ⊥ := mt Ideal.eq_bot_of_comap_eq_bot hQ
  have hbot : Ideal.inertia G Q = ⊥ := by
    rw [eq_bot_iff]
    intro σ hσ
    simpa using h σ hσ
  have hcard : Nat.card (Ideal.inertia G Q) = 1 := Subgroup.card_eq_one.2 hbot
  rw [← Ideal.ramificationIdxIn_eq_ramificationIdx (Q.under A) Q G,
    ← Ideal.card_inertia_eq_ramificationIdxIn (G := G) (Q.under A) hp Q, hcard]

variable {K : Type*} [Field K] [Algebra B K] [IsFractionRing B K]

omit [Algebra.EssFiniteType A B] in
/-- **A generator of the prime below is a coordinate at a place with trivial inertia**: it vanishes
there to order exactly one. -/
theorem ord_eq_one_of_inertia_trivial (v : HeightOneSpectrum B) [v.asIdeal.IsMaximal]
    [Algebra.IsSeparable (A ⧸ v.asIdeal.under A) (B ⧸ v.asIdeal)]
    (h : ∀ σ : G, σ ∈ Ideal.inertia G v.asIdeal → σ = 1)
    {a : A} (ha : Ideal.span {a} = v.asIdeal.under A) (ha0 : algebraMap A B a ≠ 0) :
    ord K v (algebraMap B K (algebraMap A B a)) = 1 := by
  have hram := ramificationIdx_eq_one_of_inertia_trivial (A := A) (G := G) v.asIdeal v.ne_bot h
  have hle : Ideal.map (algebraMap A B) (v.asIdeal.under A) ≤ v.asIdeal :=
    Ideal.map_comap_le
  -- the ideal generated below, read above, is generated by the same element
  have hmap : Ideal.map (algebraMap A B) (v.asIdeal.under A)
      = Ideal.span {algebraMap A B a} := by
    rw [← ha, Ideal.map_span, Set.image_singleton]
  have hnot : ¬ Ideal.map (algebraMap A B) (v.asIdeal.under A) ≤ v.asIdeal ^ 2 := by
    intro hcon
    exact ((Ideal.ramificationIdx_ne_one_iff hle).2 hcon) hram
  rw [hmap] at hnot
  have hupper : ord K v (algebraMap B K (algebraMap A B a)) ≤ 1 :=
    ord_le_of_not_pow_dvd v ha0 (n := 1) (fun hdvd => hnot (Ideal.le_of_dvd hdvd))
  have hmem : algebraMap A B a ∈ v.asIdeal := by
    refine hle ?_
    exact Ideal.mem_map_of_mem _ (ha ▸ Ideal.mem_span_singleton_self a)
  have hlower : 0 < ord K v (algebraMap B K (algebraMap A B a)) :=
    (mem_iff_ord_pos (K := K) v ha0).1 hmem
  omega

end Inertia

end Rigidity.RET
