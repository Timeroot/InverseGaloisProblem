import Mathlib
import InverseGalois.Rigidity.RET.Descent.GeomAKLB
import InverseGalois.Rigidity.RET.Genus.UnramifiedAbstract

/-!
# From trivial inertia to an unramified integral model

Ramification of a cover of the line at a point is visible in two languages.  The Galois-theoretic
one records it as an inertia group: the deck transformations fixing a place of the cover and acting
trivially on its residue field.  The commutative-algebra one records it as a failure of the ring of
integral elements to be unramified over the ring of the chart, that is, as a non-vanishing module
of relative differentials.  This file identifies the two, in the direction needed to differentiate
along the cover: a cover with no non-trivial inertia anywhere over the chart has an unramified
integral model.

Both languages measure the same integer.  For a Galois extension of Dedekind domains with separable
residue extensions the order of the inertia group at a place is the ramification index there, and a
place of ramification index one is unramified in the sense of differentials.  Over the generic
point there is nothing to check: the extension of fraction fields is separable, and a separable
extension of fields is unramified.  Since every point of the spectrum is either the generic one or
a place, and unramifiedness may be checked point by point, the two conditions agree.

The chart being the polynomials in the coordinate, and the constant field algebraically closed,
the places of the chart are exactly the points of the line: every maximal ideal of the polynomial
ring is generated by a linear polynomial.

## Main results

* `Rigidity.RET.exists_eq_span_X_sub_C` — over an algebraically closed field every maximal ideal of
  the polynomial ring is generated by a linear polynomial.
* `Rigidity.RET.formallyUnramified_bring` — a cover of the line with no non-trivial inertia over
  any point has an unramified integral model over the chart.
-/

open Polynomial nonZeroDivisors

noncomputable section


namespace Rigidity.RET

/-! ## The places of the affine line over an algebraically closed field -/

/-- **Over an algebraically closed field every maximal ideal of the polynomial ring is generated by
a linear polynomial.**  A generator of the ideal is a non-unit, hence of positive degree, hence has
a root, and the corresponding linear polynomial generates a maximal ideal containing it. -/
theorem exists_eq_span_X_sub_C {k : Type*} [Field k] [IsAlgClosed k] (m : Ideal k[X])
    [hm : m.IsMaximal] : ∃ t : k, m = Ideal.span {X - C t} := by
  obtain ⟨g, hg⟩ := IsPrincipalIdealRing.principal m
  have hgm : Ideal.span {g} = m := hg.symm
  have hgu : ¬ IsUnit g := fun h =>
    hm.ne_top (by rw [← hgm, Ideal.span_singleton_eq_top.2 h])
  have hg0 : g ≠ 0 := by
    rintro rfl
    have hbot : m = ⊥ := by rw [← hgm]; simp
    have hXtop : Ideal.span {(X : k[X])} ≠ ⊤ := by
      rw [Ne, Ideal.span_singleton_eq_top]
      exact Polynomial.not_isUnit_X
    have hEq := hm.eq_of_le hXtop (by rw [hbot]; exact bot_le)
    rw [hbot] at hEq
    exact Polynomial.X_ne_zero (Ideal.span_singleton_eq_bot.1 hEq.symm)
  obtain ⟨t, ht⟩ := IsAlgClosed.exists_root g
    (Polynomial.degree_pos_of_ne_zero_of_nonunit hg0 hgu).ne'
  refine ⟨t, hm.eq_of_le ?_ ?_⟩
  · exact (PrincipalIdealRing.isMaximal_of_irreducible (irreducible_X_sub_C t)).ne_top
  · rw [← hgm, Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe,
      Ideal.mem_span_singleton]
    exact (Polynomial.dvd_iff_isRoot).2 ht

/-! ## The integral model of an unbranched cover of the line -/

section Geom

open GeomAKLB

attribute [local instance] GeomAKLB.instMSA GeomAKLB.instIntegral GeomAKLB.instIsFrac
  GeomAKLB.instIGG GeomAKLB.instFinite GeomAKLB.instDedekindB GeomAKLB.instTorsionFree
  GeomAKLB.instFaithful

variable (Ω : Type) [Field Ω] [Algebra (RatFunc k) Ω] [FiniteDimensional (RatFunc k) Ω]
  [IsGalois (RatFunc k) Ω]
  [Algebra (Polynomial k) Ω] [IsScalarTower (Polynomial k) (RatFunc k) Ω]

/-- The function field of a cover of the line is unramified over the chart: it is separable over
the rational functions, which are a localization of the chart. -/
theorem formallyUnramified_ratFunc : Algebra.FormallyUnramified (Polynomial k) Ω := by
  haveI : Algebra.FormallyUnramified (Polynomial k) (RatFunc k) :=
    Algebra.FormallyUnramified.of_isLocalization (Rₘ := RatFunc k) (Polynomial k)⁰
  haveI : Algebra.FormallyUnramified (RatFunc k) Ω :=
    (Algebra.FormallyUnramified.iff_isSeparable (RatFunc k) Ω).2 inferInstance
  exact Algebra.FormallyUnramified.comp (Polynomial k) (RatFunc k) Ω

/-- **A cover of the line with no non-trivial inertia over any point has an unramified integral
model over the chart.**  Unramifiedness is checked point by point on the model: the generic point
is unramified because the extension of function fields is separable, and every other point of the
model is a place over a point of the line, where the inertia group is trivial by hypothesis. -/
theorem formallyUnramified_bring
    (h : ∀ (t : k) (Q : Ideal (Bring Ω)), Q.IsMaximal → Q.LiesOver (placeP t) →
      ∀ σ : Ω ≃ₐ[RatFunc k] Ω, σ ∈ geomInertia Ω Q → σ = 1) :
    Algebra.FormallyUnramified (Polynomial k) (Bring Ω) := by
  rw [← Algebra.unramifiedLocus_eq_univ_iff]
  refine Set.eq_univ_of_forall fun P => ?_
  obtain ⟨Q, hQp⟩ := P
  show Algebra.IsUnramifiedAt (Polynomial k) Q
  rcases eq_or_ne Q ⊥ with rfl | hbot
  · haveI := formallyUnramified_ratFunc Ω
    exact isUnramifiedAt_bot (L := Ω)
  · haveI : Q.IsMaximal := hQp.isMaximal hbot
    haveI : (Q.under (Polynomial k)).IsMaximal :=
      Ideal.isMaximal_comap_of_isIntegral_of_isMaximal Q
    obtain ⟨t, ht⟩ := exists_eq_span_X_sub_C (Q.under (Polynomial k))
    haveI : Q.LiesOver (placeP t) := ⟨ht.symm⟩
    haveI := residue_isSeparable Ω t Q
    exact isUnramifiedAt_of_inertia_eq_bot (placeP t) Q hbot
      (h t Q inferInstance inferInstance)

end Geom

end Rigidity.RET
