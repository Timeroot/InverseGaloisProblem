import Mathlib

/-!
# The rational function field is generated by the constants and the variable

A subfield of `K(T)` which contains every constant and contains `T` is all of `K(T)`: the
polynomials are reached by the ring operations from `K` and `T`, and every rational function is a
quotient of two polynomials.  This is the field-theoretic counterpart of the extensionality
principle for ring homomorphisms out of `K(T)` (`Rigidity.RET.ratFunc_ringHom_ext`), and it is what
makes a map defined on the constants and on `T` control all of `K(T)`.

The packaging used downstream is `Rigidity.RET.ratFunc_mem_subfield`: a ring homomorphism out of
`K(T)` which sends the constants and `T` into a subfield of the target sends everything there.
Applied to an automorphism of a big field over `ℚ(T)`, it says that such an automorphism preserves
the intermediate field `ℚ̄(T)` as soon as it preserves the constants — the hypothesis needed to see
the automorphism as a semilinear map of covers of the line.

## Main results

* `Rigidity.RET.ratFunc_subfield_eq_top` — a subfield containing the constants and `T` is `⊤`.
* `Rigidity.RET.ratFunc_closure_const_union_X` — `K(T)` is the field generated by `K` and `T`.
* `Rigidity.RET.ratFunc_mem_subfield` — a ring homomorphism out of `K(T)` lands in any subfield
  which receives the constants and `T`.
* `Rigidity.RET.ratFunc_intermediateField_eq_top` — the intermediate-field form.
-/

open Polynomial

namespace Rigidity.RET

variable {K : Type*} [Field K] {S : Subfield (RatFunc K)}

/-- A subfield of `K(T)` containing the constants and `T` contains every polynomial. -/
theorem ratFunc_algebraMap_polynomial_mem (hC : ∀ c : K, algebraMap K (RatFunc K) c ∈ S)
    (hX : (RatFunc.X : RatFunc K) ∈ S) (p : K[X]) :
    algebraMap K[X] (RatFunc K) p ∈ S := by
  induction p using Polynomial.induction_on with
  | C a =>
      rw [RatFunc.algebraMap_C, ← RatFunc.algebraMap_eq_C]
      exact hC a
  | add p q hp hq =>
      rw [map_add]
      exact S.add_mem hp hq
  | monomial n a h =>
      rw [show Polynomial.C a * (X : K[X]) ^ (n + 1) = Polynomial.C a * X ^ n * X by ring, map_mul,
        RatFunc.algebraMap_X]
      exact S.mul_mem h hX

/-- **A subfield of `K(T)` containing the constants and `T` is all of `K(T)`.**

Every rational function is a quotient of two polynomials, and the polynomials are generated by the
constants and `T`. -/
theorem ratFunc_subfield_eq_top (hC : ∀ c : K, algebraMap K (RatFunc K) c ∈ S)
    (hX : (RatFunc.X : RatFunc K) ∈ S) : S = ⊤ := by
  refine eq_top_iff.2 fun f _ => ?_
  rw [← RatFunc.num_div_denom f]
  exact S.div_mem (ratFunc_algebraMap_polynomial_mem hC hX _)
    (ratFunc_algebraMap_polynomial_mem hC hX _)

/-- **`K(T)` is generated as a field by the constants together with `T`.** -/
theorem ratFunc_closure_const_union_X :
    Subfield.closure (Set.range (algebraMap K (RatFunc K)) ∪ {RatFunc.X}) = ⊤ :=
  ratFunc_subfield_eq_top (fun c => Subfield.subset_closure (Or.inl ⟨c, rfl⟩))
    (Subfield.subset_closure (Or.inr rfl))

/-- **A ring homomorphism out of `K(T)` is controlled by the constants and `T`**: if it sends every
constant and `T` into a subfield of the target, it sends all of `K(T)` there. -/
theorem ratFunc_mem_subfield {L : Type*} [Field L] (φ : RatFunc K →+* L) (E : Subfield L)
    (hC : ∀ c : K, φ (algebraMap K (RatFunc K) c) ∈ E) (hX : φ RatFunc.X ∈ E) (f : RatFunc K) :
    φ f ∈ E := by
  have h : E.comap φ = ⊤ := ratFunc_subfield_eq_top (S := E.comap φ) hC hX
  have hf : f ∈ E.comap φ := by rw [h]; trivial
  exact hf

/-- An intermediate field of `K(T)` over a base field, containing the constants and `T`, is
everything. -/
theorem ratFunc_intermediateField_eq_top {F : Type*} [Field F] [Algebra F (RatFunc K)]
    {E : IntermediateField F (RatFunc K)} (hC : ∀ c : K, algebraMap K (RatFunc K) c ∈ E)
    (hX : (RatFunc.X : RatFunc K) ∈ E) : E = ⊤ := by
  have h : E.toSubfield = ⊤ := ratFunc_subfield_eq_top (S := E.toSubfield) hC hX
  refine eq_top_iff.2 fun x _ => ?_
  have hx : x ∈ E.toSubfield := by rw [h]; trivial
  exact hx

end Rigidity.RET
