import Mathlib
import InverseGalois.Rigidity.RET.Infinity
import InverseGalois.Rigidity.RET.Semilinear

/-!
# The conjugates of a subcover

The arithmetic Galois closure of a cover is generated by the conjugates of the cover under the
arithmetic Galois group.  Each such conjugate is the image of an intermediate field under a
semilinear automorphism of the ambient cover (`RET/Semilinear.lean`), so this file builds that
image: `SemiIso.mapField` carries a normal intermediate field to a normal intermediate field, and
the semilinear isomorphism restricts to one of the two subcovers (`SemiIso.restrict`).

Everything a subcover knows about its branch points therefore travels to its conjugates: with the
coordinate change induced by an automorphism of the constants, a conjugate of a subcover unramified
outside a set of **rational** points, and at infinity, is unramified there too.  Together with the
compositum lemmas (`RET/Unramified.lean`, `RET/Infinity.lean`) this is what bounds the branch locus
of the arithmetic Galois closure.

## Main definitions

* `Rigidity.RET.LineCover.SemiIso.mapField` — the image of an intermediate field.
* `Rigidity.RET.LineCover.SemiIso.fieldEquiv` — a subfield is isomorphic to its image.
* `Rigidity.RET.LineCover.SemiIso.restrict` — the restriction to a subcover and its image.
* `Rigidity.RET.LineCover.SemiIso.baseEquiv`, `Rigidity.RET.LineCover.SemiIso.ofBasePreserving` —
  an isomorphism of function fields carrying the base onto the base is semilinear.

## Main results

* `Rigidity.RET.LineCover.SemiIso.mapField_le_iff`, `Rigidity.RET.LineCover.SemiIso.mapField_adjoin`
  — taking images is a Galois connection between the two lattices of intermediate fields, and
  carries a field generated by a set to the field generated by its image.
* `Rigidity.RET.LineCover.SemiIso.normal_mapField` — the image of a normal intermediate field is
  normal.
* `Rigidity.RET.LineCover.IsUnramifiedOutside.semiIso_mapField`,
  `Rigidity.RET.LineCover.IsUnramifiedAtInfinity.semiIso_mapField` — a conjugate of a subcover is
  branched over the same rational points.
* `Rigidity.RET.LineCover.IsUnramifiedOutside.of_conjugates`,
  `Rigidity.RET.LineCover.IsUnramifiedAtInfinity.of_conjugates` — a cover generated by the
  conjugates of one subcover is branched where that subcover is.
-/

open Polynomial

noncomputable section

set_option maxHeartbeats 1600000
set_option synthInstance.maxHeartbeats 1000000

namespace Rigidity.RET

open GeomAKLB

attribute [local instance] GeomAKLB.instMSA GeomAKLB.instIntegral

/-! ## Composing coordinate changes of the constants -/

/-- The trivial automorphism of the constants induces the trivial coordinate change. -/
theorem constSubst_refl (f : RatFunc k) : constSubst (RingEquiv.refl k) f = f := by
  have key : (constSubst (RingEquiv.refl k) : RatFunc k →+* RatFunc k) = RingHom.id (RatFunc k) := by
    refine ratFunc_ringHom_ext ?_ ?_
    · intro a
      simpa using constSubst_algebraMap (RingEquiv.refl k) a
    · simp
  exact congrArg (fun g => g f) key

/-- Composing two automorphisms of the constants composes the coordinate changes. -/
theorem constSubst_trans (c c' : k ≃+* k) (f : RatFunc k) :
    constSubst c' (constSubst c f) = constSubst (c.trans c') f := by
  have key : (constSubst c' : RatFunc k →+* RatFunc k).comp (constSubst c : RatFunc k →+* RatFunc k)
      = (constSubst (c.trans c') : RatFunc k →+* RatFunc k) := by
    refine ratFunc_ringHom_ext ?_ ?_
    · intro a
      show constSubst c' (constSubst c (algebraMap k (RatFunc k) a))
        = constSubst (c.trans c') (algebraMap k (RatFunc k) a)
      rw [constSubst_algebraMap, constSubst_algebraMap, constSubst_algebraMap]
      rfl
    · show constSubst c' (constSubst c (RatFunc.X : RatFunc k))
        = constSubst (c.trans c') RatFunc.X
      rw [constSubst_X, constSubst_X, constSubst_X]
  exact congrArg (fun g => g f) key

namespace LineCover

namespace SemiIso

variable {L L' : LineCover} {φ : RatFunc k ≃+* RatFunc k}

/-- **The image of an intermediate field under a semilinear isomorphism.**  It is again an
intermediate field: the base is carried onto itself by the coordinate change. -/
def mapField (e : SemiIso L L' φ) (E : IntermediateField (RatFunc k) L.M) :
    IntermediateField (RatFunc k) L'.M :=
  (E.toSubfield.map (e.toRingEquiv : L.M →+* L'.M)).toIntermediateField fun f =>
    ⟨algebraMap (RatFunc k) L.M (φ.symm f), E.algebraMap_mem _, by
      show e.toRingEquiv (algebraMap (RatFunc k) L.M (φ.symm f)) = _
      rw [e.map_algebraMap, φ.apply_symm_apply]⟩

@[simp] theorem mem_mapField (e : SemiIso L L' φ) (E : IntermediateField (RatFunc k) L.M)
    {y : L'.M} : y ∈ e.mapField E ↔ e.toRingEquiv.symm y ∈ E := by
  show y ∈ E.toSubfield.map (e.toRingEquiv : L.M →+* L'.M) ↔ _
  rw [Subfield.mem_map]
  constructor
  · rintro ⟨x, hx, rfl⟩
    simpa using hx
  · intro h
    exact ⟨e.toRingEquiv.symm y, h, by simp⟩

theorem mem_mapField_symm (e : SemiIso L L' φ) (E : IntermediateField (RatFunc k) L'.M)
    {x : L.M} : x ∈ e.symm.mapField E ↔ e.toRingEquiv x ∈ E := by
  rw [mem_mapField]
  simp

@[simp] theorem mapField_top (e : SemiIso L L' φ) :
    e.mapField (⊤ : IntermediateField (RatFunc k) L.M) = ⊤ := by
  ext y
  simp

@[simp] theorem mapField_symm_mapField (e : SemiIso L L' φ)
    (E : IntermediateField (RatFunc k) L.M) : e.symm.mapField (e.mapField E) = E := by
  ext x
  rw [mem_mapField_symm, mem_mapField]
  simp

/-- **Taking images is a Galois connection between the two lattices of intermediate fields.** -/
theorem mapField_le_iff (e : SemiIso L L' φ) {E : IntermediateField (RatFunc k) L.M}
    {F : IntermediateField (RatFunc k) L'.M} : e.mapField E ≤ F ↔ E ≤ e.symm.mapField F := by
  constructor
  · intro h x hx
    rw [mem_mapField_symm]
    exact h ((mem_mapField e E).mpr (by simpa using hx))
  · intro h y hy
    rw [mem_mapField] at hy
    simpa using h hy

theorem mapField_mono (e : SemiIso L L' φ) {E F : IntermediateField (RatFunc k) L.M}
    (h : E ≤ F) : e.mapField E ≤ e.mapField F := by
  intro y hy
  rw [mem_mapField] at hy ⊢
  exact h hy

/-- **The image of a field generated by a set is generated by the image of the set.** -/
theorem mapField_adjoin (e : SemiIso L L' φ) (S : Set L.M) :
    e.mapField (IntermediateField.adjoin (RatFunc k) S)
      = IntermediateField.adjoin (RatFunc k) (e.toRingEquiv '' S) := by
  refine le_antisymm ?_ ?_
  · rw [mapField_le_iff, IntermediateField.adjoin_le_iff]
    intro x hx
    rw [SetLike.mem_coe, mem_mapField_symm]
    exact IntermediateField.subset_adjoin _ _ ⟨x, hx, rfl⟩
  · rw [IntermediateField.adjoin_le_iff]
    rintro y ⟨x, hx, rfl⟩
    rw [SetLike.mem_coe, mem_mapField]
    simpa using IntermediateField.subset_adjoin (RatFunc k) S hx

/-- **The image of a normal intermediate field is normal**: conjugating a deck transformation of
the target by the semilinear isomorphism gives a deck transformation of the source, which preserves
the field being mapped. -/
instance normal_mapField (e : SemiIso L L' φ) (E : IntermediateField (RatFunc k) L.M)
    [Normal (RatFunc k) E] : Normal (RatFunc k) (e.mapField E) := by
  rw [IntermediateField.normal_iff_forall_map_le']
  intro τ y hy
  obtain ⟨z, hz, rfl⟩ := hy
  have hz' : e.toRingEquiv.symm z ∈ E := (mem_mapField e E).mp hz
  have hmain : e.symm.conj τ (e.toRingEquiv.symm z) ∈ E :=
    (IntermediateField.normal_iff_forall_map_le' (K := E)).mp inferInstance (e.symm.conj τ)
      ⟨e.toRingEquiv.symm z, hz', rfl⟩
  have heq : e.symm.conj τ (e.toRingEquiv.symm z) = e.toRingEquiv.symm (τ z) := by
    rw [conj_apply', symm_toRingEquiv]
    simp
  rw [heq] at hmain
  exact (mem_mapField e E).mpr hmain

/-- **A subfield is isomorphic to its image.** -/
def fieldEquiv (e : SemiIso L L' φ) (E : IntermediateField (RatFunc k) L.M) :
    (E : Type) ≃+* (e.mapField E : Type) where
  toFun x := ⟨e.toRingEquiv ((x : L.M)), by rw [mem_mapField]; simp⟩
  invFun y := ⟨e.toRingEquiv.symm ((y : L'.M)), (mem_mapField e E).mp y.2⟩
  left_inv _ := Subtype.ext (by simp)
  right_inv _ := Subtype.ext (by simp)
  map_mul' _ _ := Subtype.ext (by simp)
  map_add' _ _ := Subtype.ext (by simp)

@[simp] theorem coe_fieldEquiv (e : SemiIso L L' φ) (E : IntermediateField (RatFunc k) L.M)
    (x : (E : Type)) :
    ((e.fieldEquiv E x : (e.mapField E : Type)) : L'.M) = e.toRingEquiv ((x : L.M)) := rfl

/-- **A semilinear isomorphism restricts to a subcover and its image.** -/
def restrict (e : SemiIso L L' φ) (E : IntermediateField (RatFunc k) L.M)
    [Normal (RatFunc k) E] : SemiIso (L.sub E) (L'.sub (e.mapField E)) φ where
  toRingEquiv := e.fieldEquiv E
  map_smul f x := Subtype.ext (by
    show e.toRingEquiv (f • x.1) = φ f • e.toRingEquiv x.1
    exact e.map_smul f x.1)

/-! ## Composing semilinear isomorphisms -/

/-- The identity is semilinear over the trivial coordinate change. -/
def refl (L : LineCover) : SemiIso L L (RingEquiv.refl (RatFunc k)) where
  toRingEquiv := RingEquiv.refl L.M
  map_smul _ _ := rfl

/-- **Semilinear isomorphisms compose**, over the composite coordinate change. -/
def trans {L'' : LineCover} {φ' : RatFunc k ≃+* RatFunc k} (e : SemiIso L L' φ)
    (e' : SemiIso L' L'' φ') : SemiIso L L'' (φ.trans φ') where
  toRingEquiv := e.toRingEquiv.trans e'.toRingEquiv
  map_smul f x := by
    show e'.toRingEquiv (e.toRingEquiv (f • x)) = φ' (φ f) • e'.toRingEquiv (e.toRingEquiv x)
    rw [e.map_smul, e'.map_smul]

/-! ## Where the conjugating maps come from -/

section OfBase

variable (ρ : L.M ≃+* L'.M)

/-- The base map underlying an isomorphism of function fields which carries the base into the
base. -/
def baseHom (h : ∀ f : RatFunc k, ∃ g : RatFunc k,
    ρ (algebraMap (RatFunc k) L.M f) = algebraMap (RatFunc k) L'.M g) : RatFunc k →+* RatFunc k where
  toFun f := (h f).choose
  map_one' := (algebraMap (RatFunc k) L'.M).injective (by
    rw [← (h 1).choose_spec, map_one, map_one, map_one])
  map_zero' := (algebraMap (RatFunc k) L'.M).injective (by
    rw [← (h 0).choose_spec, map_zero, map_zero, map_zero])
  map_mul' f g := (algebraMap (RatFunc k) L'.M).injective (by
    rw [← (h (f * g)).choose_spec, map_mul, map_mul, map_mul, ← (h f).choose_spec,
      ← (h g).choose_spec])
  map_add' f g := (algebraMap (RatFunc k) L'.M).injective (by
    rw [← (h (f + g)).choose_spec, map_add, map_add, map_add, ← (h f).choose_spec,
      ← (h g).choose_spec])

@[simp] theorem baseHom_spec (h) (f : RatFunc k) :
    ρ (algebraMap (RatFunc k) L.M f) = algebraMap (RatFunc k) L'.M (baseHom ρ h f) :=
  (h f).choose_spec

/-- **The coordinate change underlying an isomorphism of function fields carrying the base onto
the base.** -/
def baseEquiv (h : ∀ f : RatFunc k, ∃ g : RatFunc k,
      ρ (algebraMap (RatFunc k) L.M f) = algebraMap (RatFunc k) L'.M g)
    (h' : ∀ f : RatFunc k, ∃ g : RatFunc k,
      ρ.symm (algebraMap (RatFunc k) L'.M f) = algebraMap (RatFunc k) L.M g) :
    RatFunc k ≃+* RatFunc k where
  toFun := baseHom ρ h
  invFun := baseHom ρ.symm h'
  left_inv f := (algebraMap (RatFunc k) L.M).injective (by
    rw [← baseHom_spec, ← baseHom_spec, ρ.symm_apply_apply])
  right_inv f := (algebraMap (RatFunc k) L'.M).injective (by
    rw [← baseHom_spec, ← baseHom_spec, ρ.apply_symm_apply])
  map_mul' := map_mul _
  map_add' := map_add _

/-- **An isomorphism of function fields carrying the base onto the base is a semilinear
isomorphism of covers.**  This is where the conjugating maps come from: an automorphism of the
arithmetic Galois closure over `ℚ(T)` need not fix the geometric base pointwise, but it does map
it onto itself, and that is all semilinearity asks for. -/
def ofBasePreserving (h : ∀ f : RatFunc k, ∃ g : RatFunc k,
      ρ (algebraMap (RatFunc k) L.M f) = algebraMap (RatFunc k) L'.M g)
    (h' : ∀ f : RatFunc k, ∃ g : RatFunc k,
      ρ.symm (algebraMap (RatFunc k) L'.M f) = algebraMap (RatFunc k) L.M g) :
    SemiIso L L' (baseEquiv ρ h h') where
  toRingEquiv := ρ
  map_smul f x := by
    rw [Algebra.smul_def, Algebra.smul_def, map_mul]
    congr 1
    exact baseHom_spec ρ h f

end OfBase

end SemiIso

/-- **A conjugate of a subcover is branched over the same rational points.**  The conjugating map
moves the constants, so it fixes every rational point of the line. -/
theorem IsUnramifiedOutside.semiIso_mapField {L L' : LineCover} {c : k ≃+* k}
    (e : SemiIso L L' (constSubst c)) (E : IntermediateField (RatFunc k) L.M)
    [Normal (RatFunc k) E] {S : Set k} (hS : S ⊆ Set.range (algebraMap ℚ k))
    (hE : (L.sub E).IsUnramifiedOutside S) :
    (L'.sub (e.mapField E)).IsUnramifiedOutside S :=
  IsUnramifiedOutside.semiIso_const (e.restrict E) hS hE

/-- **A conjugate of a subcover unramified at infinity is unramified at infinity.** -/
theorem IsUnramifiedAtInfinity.semiIso_mapField {L L' : LineCover} {c : k ≃+* k}
    (e : SemiIso L L' (constSubst c)) (E : IntermediateField (RatFunc k) L.M)
    [Normal (RatFunc k) E] (hE : (L.sub E).IsUnramifiedAtInfinity) :
    (L'.sub (e.mapField E)).IsUnramifiedAtInfinity :=
  IsUnramifiedAtInfinity.semiIso_const (e.restrict E) hE

/-! ## The branch locus of a compositum of conjugates -/

/-- **A cover generated by the conjugates of one subcover is branched where that subcover is.**
The conjugating maps move the constants, and so fix every rational point of the line. -/
theorem IsUnramifiedOutside.of_conjugates {L : LineCover} {S : Set k}
    (hS : S ⊆ Set.range (algebraMap ℚ k)) {ι : Sort*} {c : ι → (k ≃+* k)}
    (a : ∀ i, SemiIso L L (constSubst (c i))) (E : IntermediateField (RatFunc k) L.M)
    [Normal (RatFunc k) E] (hsup : ⨆ i, (a i).mapField E = ⊤)
    (hE : (L.sub E).IsUnramifiedOutside S) : L.IsUnramifiedOutside S :=
  IsUnramifiedOutside.of_iSup (fun i => (a i).mapField E) hsup fun i =>
    IsUnramifiedOutside.semiIso_mapField (a i) E hS hE

/-- **A cover generated by the conjugates of one subcover unramified at infinity is unramified at
infinity.** -/
theorem IsUnramifiedAtInfinity.of_conjugates {L : LineCover} {ι : Sort*} {c : ι → (k ≃+* k)}
    (a : ∀ i, SemiIso L L (constSubst (c i))) (E : IntermediateField (RatFunc k) L.M)
    [Normal (RatFunc k) E] (hsup : ⨆ i, (a i).mapField E = ⊤)
    (hE : (L.sub E).IsUnramifiedAtInfinity) : L.IsUnramifiedAtInfinity :=
  IsUnramifiedAtInfinity.of_iSup (fun i => (a i).mapField E) hsup fun i =>
    IsUnramifiedAtInfinity.semiIso_mapField (a i) E hE

end LineCover

end Rigidity.RET
