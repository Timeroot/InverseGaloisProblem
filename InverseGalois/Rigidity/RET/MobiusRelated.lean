import Mathlib
import InverseGalois.Rigidity.RET.ProjectiveTransport

/-!
# Tuples of points related by a coordinate change

Translating the parameter, scaling it and inverting it generate all coordinate changes of the
projective line, and each of them moves a tuple of points of the affine line to another such tuple
— provided, for the inversion, that no point of the tuple is the origin.  Calling two tuples
*related* when a finite chain of these moves carries one to the other gives an equivalence relation
on tuples of any length, and everything the Riemann existence correspondence says about a tuple is
invariant along it.

For a tuple of *three distinct* points the relation is total: any ordered triple of distinct points
of the line is carried to any other, which is the sharp three-transitivity of the group of
coordinate changes.  That is not a new argument — it is the transport theorem of
`RET/ProjectiveTransport.lean` applied to the relation itself, which is triple-invariant by
construction.

## Main results

* `Rigidity.RET.MobiusRelated` — the equivalence relation generated by the three basic coordinate
  changes.
* `Rigidity.RET.MobiusRelated.symm` — it is symmetric, so it is an equivalence relation.
* `Rigidity.RET.IsMonodromyOver.mobius`, `Rigidity.RET.GeomRET.mobius` — the branch-cycle
  correspondence is invariant along it, in every rank.
* `Rigidity.RET.mobiusRelated_of_injective` — any two triples of distinct points are related.
-/

open Polynomial

noncomputable section

namespace Rigidity.RET

open GeomAKLB

/-! ## The elementary coordinate changes -/

/-- **One elementary coordinate change of the line, read on a tuple of points**: a translation, a
scaling, or the inversion `T ↦ T⁻¹` at a tuple avoiding the origin. -/
inductive MobiusStep {r : ℕ} : (Fin r → k) → (Fin r → k) → Prop
  /-- translating the parameter. -/
  | translate (t : Fin r → k) (a : k) : MobiusStep t fun i => t i + a
  /-- scaling the parameter. -/
  | scale (c : k) (hc : c ≠ 0) (t : Fin r → k) : MobiusStep t fun i => c * t i
  /-- inverting the parameter, away from the origin. -/
  | inv (t : Fin r → k) (ht : ∀ i, t i ≠ 0) : MobiusStep t fun i => (t i)⁻¹

/-- **Two tuples of points of the line are related by a coordinate change** when a finite chain of
elementary coordinate changes carries the first to the second. -/
def MobiusRelated {r : ℕ} : (Fin r → k) → (Fin r → k) → Prop :=
  Relation.ReflTransGen MobiusStep

namespace MobiusRelated

variable {r : ℕ} {t s u : Fin r → k}

theorem refl : MobiusRelated t t := Relation.ReflTransGen.refl

theorem trans (h : MobiusRelated t s) (h' : MobiusRelated s u) : MobiusRelated t u :=
  Relation.ReflTransGen.trans h h'

/-- A single coordinate change relates the two tuples. -/
theorem of_step (h : MobiusStep t s) : MobiusRelated t s := Relation.ReflTransGen.single h

/-- Extend a chain of coordinate changes by one more. -/
theorem tail (h : MobiusRelated t s) (h' : MobiusStep s u) : MobiusRelated t u :=
  Relation.ReflTransGen.tail h h'

end MobiusRelated

/-- **Every elementary coordinate change can be undone.**  A translation is undone by the opposite
translation, a scaling by the reciprocal scaling, and the inversion by itself. -/
theorem MobiusStep.related_symm {r : ℕ} {t s : Fin r → k} (h : MobiusStep t s) :
    MobiusRelated s t := by
  cases h with
  | translate t a =>
    have hstep : MobiusStep (fun i => t i + a) (fun i => (t i + a) + -a) :=
      MobiusStep.translate _ (-a)
    have hfun : (fun i => (t i + a) + -a) = t := by
      funext i
      rw [add_neg_cancel_right]
    rw [hfun] at hstep
    exact MobiusRelated.of_step hstep
  | scale c hc t =>
    have hstep : MobiusStep (fun i => c * t i) (fun i => c⁻¹ * (c * t i)) :=
      MobiusStep.scale _ (inv_ne_zero hc) _
    have hfun : (fun i => c⁻¹ * (c * t i)) = t := by
      funext i
      rw [← mul_assoc, inv_mul_cancel₀ hc, one_mul]
    rw [hfun] at hstep
    exact MobiusRelated.of_step hstep
  | inv t ht =>
    have hne : ∀ i, (t i)⁻¹ ≠ 0 := fun i => inv_ne_zero (ht i)
    have hstep : MobiusStep (fun i => (t i)⁻¹) (fun i => ((t i)⁻¹)⁻¹) :=
      MobiusStep.inv _ hne
    have hfun : (fun i => ((t i)⁻¹)⁻¹) = t := by
      funext i
      rw [inv_inv]
    rw [hfun] at hstep
    exact MobiusRelated.of_step hstep

/-- **Being related by a coordinate change is symmetric**, hence an equivalence relation. -/
theorem MobiusRelated.symm {r : ℕ} {t s : Fin r → k} (h : MobiusRelated t s) :
    MobiusRelated s t := by
  induction h with
  | refl => exact MobiusRelated.refl
  | tail _ hstep ih => exact (hstep.related_symm).trans ih

/-! ## The correspondence is invariant along the relation -/

/-- A monodromy tuple survives one elementary coordinate change. -/
theorem IsMonodromyOver.mobiusStep {G : Type} [Group G] [Finite G] {r : ℕ} {h : Fin r → G}
    {t s : Fin r → k} (hstep : MobiusStep t s) (H : IsMonodromyOver h t) :
    IsMonodromyOver h s := by
  cases hstep with
  | translate t a => exact H.twist_translate a
  | scale c hc t => exact H.twist_scale hc
  | inv t ht => exact H.twist_inv ht

/-- **A monodromy tuple survives every coordinate change**, in every rank: a cover of the line with
prescribed branch cycles over one tuple of points has, over any tuple reached from it by coordinate
changes, a cover with the same deck group and the same branch cycles. -/
theorem IsMonodromyOver.mobius {G : Type} [Group G] [Finite G] {r : ℕ} {h : Fin r → G}
    {t s : Fin r → k} (hrel : MobiusRelated t s) (H : IsMonodromyOver h t) :
    IsMonodromyOver h s := by
  induction hrel with
  | refl => exact H
  | tail _ hstep ih => exact ih.mobiusStep hstep

/-- The existence half of the correspondence survives one elementary coordinate change. -/
theorem GeomRETExistence.mobiusStep {r : ℕ} {t s : Fin r → k} (hstep : MobiusStep t s)
    (H : GeomRETExistence t) : GeomRETExistence s := by
  cases hstep with
  | translate t a => exact H.twist_translate a
  | scale c hc t => exact H.twist_scale hc
  | inv t ht => exact H.twist_inv ht

/-- **The existence half of the correspondence survives every coordinate change**, in every
rank. -/
theorem GeomRETExistence.mobius {r : ℕ} {t s : Fin r → k} (hrel : MobiusRelated t s)
    (H : GeomRETExistence t) : GeomRETExistence s := by
  induction hrel with
  | refl => exact H
  | tail _ hstep ih => exact ih.mobiusStep hstep

/-- The completeness half of the correspondence survives one elementary coordinate change. -/
theorem GeomRETCompleteness.mobiusStep {r : ℕ} {t s : Fin r → k} (hstep : MobiusStep t s)
    (H : GeomRETCompleteness t) : GeomRETCompleteness s := by
  cases hstep with
  | translate t a => exact H.twist_translate a
  | scale c hc t => exact H.twist_scale hc
  | inv t ht => exact H.twist_inv ht

/-- **The completeness half of the correspondence survives every coordinate change**, in every
rank. -/
theorem GeomRETCompleteness.mobius {r : ℕ} {t s : Fin r → k} (hrel : MobiusRelated t s)
    (H : GeomRETCompleteness t) : GeomRETCompleteness s := by
  induction hrel with
  | refl => exact H
  | tail _ hstep ih => exact ih.mobiusStep hstep

/-- **The Riemann existence correspondence over a tuple of branch points depends only on the tuple
up to coordinate changes**, in every rank. -/
theorem GeomRET.mobius {r : ℕ} {t s : Fin r → k} (hrel : MobiusRelated t s) (H : GeomRET t) :
    GeomRET s :=
  ⟨H.exists_cover.mobius hrel, H.exists_cycles.mobius hrel⟩

/-! ## Three points are one orbit -/

/-- Being reachable from a fixed triple by coordinate changes is a triple-invariant property. -/
theorem isTripleInvariant_mobiusRelated (t : Fin 3 → k) :
    IsTripleInvariant fun s : Fin 3 → k => MobiusRelated t s where
  translate a H := H.tail (MobiusStep.translate _ a)
  scale hc H := H.tail (MobiusStep.scale _ hc _)
  inv ht H := H.tail (MobiusStep.inv _ ht)

/-- **Any ordered triple of distinct points of the line is carried to any other by a coordinate
change.**  This is the sharp three-transitivity of the group of coordinate changes of the
projective line, and it is exactly what makes the correspondence over three branch points a single
statement. -/
theorem mobiusRelated_of_injective {t s : Fin 3 → k} (ht : Function.Injective t)
    (hs : Function.Injective s) : MobiusRelated t s :=
  (isTripleInvariant_mobiusRelated t).transport ht hs MobiusRelated.refl

end Rigidity.RET
