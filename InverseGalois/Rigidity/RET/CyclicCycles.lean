import Mathlib
import InverseGalois.Rigidity.RET.CyclicBranchLocus
import InverseGalois.Rigidity.RET.CyclicAtInfinity

/-!
# Branch cycles of a cover of the line with cyclic deck group

A cover of the line with cyclic deck group is a multi-point Kummer cover
`wⁿ = ∏ᵢ (T - tᵢ)^{eᵢ}` (`RET/CyclicKummerModel.lean`), whose exponents can be read off any tuple
of points containing the branch locus (`RET/CyclicBranchLocus.lean`).  The deck transformation
`w ↦ ζ^{eᵢ} w` generates the inertia group at `tᵢ`, those transformations generate the deck group,
and unramifiedness at infinity says exactly that `n` divides `∑ᵢ eᵢ`
(`RET/CyclicAtInfinity.lean`), which is what makes their ordered product trivial.

This is the converse half of the Riemann existence correspondence — the assertion that a cover
branched inside a prescribed finite set carries a system of distinguished branch cycles over that
set — for covers with cyclic deck group.

## Main results

* `Rigidity.RET.exists_branchCycleGenSystem_of_isCyclic` — a cover of the line with cyclic deck
  group, unramified outside `r` given points and infinity, has a system of distinguished branch
  cycles over those points.
-/

open Polynomial IntermediateField

noncomputable section


namespace Rigidity.RET

open GeomAKLB Module

/-- **A cover of the line with cyclic deck group has distinguished branch cycles over any tuple of
points containing its branch locus.** -/
theorem exists_branchCycleGenSystem_of_isCyclic (L : LineCover) [IsCyclic L.deck] {r : ℕ}
    (t : Fin r → k) (ht : Function.Injective t) (hS : L.IsUnramifiedOutside (Set.range t))
    (hinf : L.IsUnramifiedAtInfinity) :
    ∃ g : Fin r → L.deck, L.IsBranchCycleGenSystem t g := by
  set n := finrank (RatFunc k) L.M with hndef
  have hnpos : 0 < n := finrank_pos
  haveI : NeZero n := ⟨hnpos.ne'⟩
  obtain ⟨e, hlt, hirr, hsf⟩ := exists_multiKummer_model_on L t ht hS
  haveI := hsf
  obtain ⟨ζ₀, hζ₀⟩ := exists_primitiveRoot_k n
  have hζ : IsPrimitiveRoot (algebraMap k (RatFunc k) ζ₀) n :=
    hζ₀.map_of_injective (algebraMap k (RatFunc k)).injective
  set E := autEquivZmod hirr L.M hζ with hE
  set h : Fin r → Multiplicative (ZMod n) :=
    fun i => Multiplicative.ofAdd ((e i : ℕ) : ZMod n) with hh
  -- the exponents generate `ZMod n`, since otherwise the radicand would be a proper power
  have htop : Subgroup.closure (Set.range h) = ⊤ := by
    refine closure_range_ofAdd_eq_top fun p hp hpn hpe => ?_
    refine pow_ne_of_irreducible_X_pow_sub_C hirr hpn hp.ne_one
      (algebraMap (Polynomial k) (RatFunc k) (multiA t fun i => e i / p)) ?_
    rw [← map_pow, ← multiA_pow_of_dvd t e hpe]
  -- unramifiedness at infinity is the product-one relation
  have hdvd : n ∣ ∑ i, e i :=
    dvd_sum_of_isUnramifiedAtInfinity (n := n) (t := t) (a := e) L hinf
  have hprod : (List.ofFn h).prod = 1 := by
    rw [List.prod_ofFn, hh]
    simp only
    rw [← ofAdd_sum, ← Nat.cast_sum, (ZMod.natCast_eq_zero_iff _ _).mpr hdvd, ofAdd_zero]
  exact ⟨fun i => E.symm (h i),
    ⟨fun i => isInertiaGenAt_multiCover ht hirr L hζ₀ hζ i,
      closure_range_symm_eq_top E htop, prod_ofFn_symm_eq_one E hprod⟩⟩

/-! ### Cyclic covers with at most one branch point -/

/-- A group generated by a family of trivial elements is trivial. -/
theorem subsingleton_of_closure_range_eq_top {G : Type*} [Group G] {r : ℕ} {g : Fin r → G}
    (hall : ∀ i, g i = 1) (htop : Subgroup.closure (Set.range g) = ⊤) : Subsingleton G := by
  have hle : Subgroup.closure (Set.range g) ≤ ⊥ :=
    (Subgroup.closure_le _).mpr (by rintro x ⟨i, rfl⟩; simp [hall i])
  rw [htop] at hle
  exact ⟨fun a b => by
    rw [Subgroup.mem_bot.mp (hle (Subgroup.mem_top a)),
      Subgroup.mem_bot.mp (hle (Subgroup.mem_top b))]⟩

/-- **A cyclic cover of the line unramified everywhere is trivial.**  There is no branch point to
carry a branch cycle, so the deck group has no generators. -/
theorem subsingleton_deck_of_unramified (L : LineCover) [IsCyclic L.deck]
    (hS : L.IsUnramifiedOutside ∅) (hinf : L.IsUnramifiedAtInfinity) : Subsingleton L.deck := by
  have hrange : Set.range (Fin.elim0 : Fin 0 → k) = ∅ := Set.range_eq_empty _
  obtain ⟨g, hg⟩ := exists_branchCycleGenSystem_of_isCyclic L (Fin.elim0 : Fin 0 → k)
    (fun i => i.elim0) (by rw [hrange]; exact hS) hinf
  exact subsingleton_of_closure_range_eq_top (fun i => i.elim0) hg.top

/-- **A cyclic cover of the line branched over at most one point is trivial.**  A single branch
cycle is its own inverse-of-the-product, hence trivial, and it generates the deck group. -/
theorem subsingleton_deck_of_unramified_outside_singleton (L : LineCover) [IsCyclic L.deck]
    (t₀ : k) (hS : L.IsUnramifiedOutside {t₀}) (hinf : L.IsUnramifiedAtInfinity) :
    Subsingleton L.deck := by
  have hrange : Set.range (fun _ : Fin 1 => t₀) = {t₀} := Set.range_const
  obtain ⟨g, hg⟩ := exists_branchCycleGenSystem_of_isCyclic L (fun _ : Fin 1 => t₀)
    (fun a b _ => Subsingleton.elim a b) (by rw [hrange]; exact hS) hinf
  have hprod : g 0 = 1 := by simpa using hg.prod
  exact subsingleton_of_closure_range_eq_top (fun i => by rw [Subsingleton.elim i 0]; exact hprod)
    hg.top

end Rigidity.RET
