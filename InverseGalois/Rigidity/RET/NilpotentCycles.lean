import Mathlib
import InverseGalois.Rigidity.RET.AbelianizedCycles

/-!
# Branch cycles of a cover of the line with nilpotent deck group

Generators modulo commutators of a finite nilpotent group are already generators: a subgroup
missing some element sits inside a maximal one, which is normal by the normalizer condition and
has cyclic — hence abelian — quotient, so it swallows the commutator subgroup as well.  Applied to
the distinguished inertia elements over the branch points of an arbitrary cover, this upgrades
generation modulo commutators to honest generation as soon as the deck group is nilpotent.

The product relation lets one of the branch points be dropped: a cover unramified outside `r + 1`
points and infinity is generated by distinguished inertia elements over `r` of them.

## Main results

* `Rigidity.RET.eq_top_of_sup_commutator_eq_top` — a subgroup of a finite nilpotent group
  generating it modulo commutators is the whole group.
* `Rigidity.RET.exists_branchCycles_of_isNilpotent` — a cover of the line with nilpotent deck
  group, unramified outside a tuple of points and infinity, has distinguished inertia elements
  over those points generating the deck group, with ordered product a commutator.
* `Rigidity.RET.exists_branchCycles_generating_of_isNilpotent` — over `r + 1` points, the last of
  those elements is redundant: the first `r` already generate.
-/

open Polynomial IntermediateField

noncomputable section


namespace Rigidity.RET

open GeomAKLB

attribute [local instance] GeomAKLB.instMSA GeomAKLB.instIntegral GeomAKLB.instIsFrac
  GeomAKLB.instIGG GeomAKLB.instFinite GeomAKLB.instDedekindB GeomAKLB.instTorsionFree
  GeomAKLB.instFaithful

/-! ### Generation modulo commutators in a nilpotent group -/

/-- **A subgroup of a finite nilpotent group which generates it modulo commutators is the whole
group.**  Otherwise it would lie in a maximal subgroup, which is normal because a nilpotent group
satisfies the normalizer condition, and has cyclic — hence abelian — quotient, so it would contain
the commutator subgroup too. -/
theorem eq_top_of_sup_commutator_eq_top {G : Type*} [Group G] [Finite G] [Group.IsNilpotent G]
    {H : Subgroup G} (h : H ⊔ commutator G = ⊤) : H = ⊤ := by
  by_contra hne
  obtain ⟨B, hBco, hHB⟩ := exists_isCoatom_ge hne
  haveI : B.Normal :=
    Subgroup.NormalizerCondition.normal_of_coatom B normalizerCondition_of_isNilpotent hBco
  refine hBco.1 (eq_top_iff.mpr ?_)
  rw [← h]
  exact sup_le hHB (commutator_le_of_isCyclic_quotient B (isCyclic_quotient_of_isCoatom B hBco))

/-! ### Branch cycles of a nilpotent cover -/

/-- **A cover of the line with nilpotent deck group, unramified outside a tuple of points of the
affine line and at infinity, has distinguished inertia elements over those points which generate
the deck group and whose ordered product is a commutator.** -/
theorem exists_branchCycles_of_isNilpotent (L : LineCover) [Group.IsNilpotent L.deck] {r : ℕ}
    (t : Fin r → k) (ht : Function.Injective t) (hout : L.IsUnramifiedOutside (Set.range t))
    (hinf : L.IsUnramifiedAtInfinity) :
    ∃ g : Fin r → L.deck, (∀ i, L.IsInertiaGenAt (t i) (g i)) ∧
      Subgroup.closure (Set.range g) = ⊤ ∧ (List.ofFn g).prod ∈ commutator L.deck := by
  obtain ⟨g, hgin, hgtop, hgprod⟩ := exists_inertiaGens_mod_commutator L t ht hout hinf
  exact ⟨g, hgin, eq_top_of_sup_commutator_eq_top hgtop, hgprod⟩

/-- **One of the branch points is redundant for a nilpotent cover**: a cover of the line with
nilpotent deck group, unramified outside `r + 1` points of the affine line and at infinity, has
distinguished inertia elements over those points of which the first `r` already generate the deck
group.  The ordered product relation expresses the last one through the others modulo
commutators. -/
theorem exists_branchCycles_generating_of_isNilpotent (L : LineCover) [Group.IsNilpotent L.deck]
    {r : ℕ} (t : Fin (r + 1) → k) (ht : Function.Injective t)
    (hout : L.IsUnramifiedOutside (Set.range t)) (hinf : L.IsUnramifiedAtInfinity) :
    ∃ g : Fin (r + 1) → L.deck, (∀ i, L.IsInertiaGenAt (t i) (g i)) ∧
      Subgroup.closure (Set.range fun i : Fin r => g i.castSucc) = ⊤ ∧
      (List.ofFn g).prod ∈ commutator L.deck := by
  obtain ⟨g, hgin, hgtop, hgprod⟩ := exists_inertiaGens_mod_commutator L t ht hout hinf
  -- the ordered product relation puts the last element back into the subgroup
  have hlast : g (Fin.last r) ∈
      Subgroup.closure (Set.range fun i : Fin r => g i.castSucc) ⊔ commutator L.deck := by
    have hsplit : (List.ofFn g).prod
        = (List.ofFn fun i : Fin r => g i.castSucc).prod * g (Fin.last r) := by
      rw [List.ofFn_succ', List.prod_concat]
    have hpre0 : (List.ofFn fun i : Fin r => g i.castSucc).prod ∈
        Subgroup.closure (Set.range fun i : Fin r => g i.castSucc) := by
      refine Subgroup.list_prod_mem _ ?_
      intro x hx
      rw [List.mem_ofFn] at hx
      obtain ⟨i, rfl⟩ := hx
      exact Subgroup.subset_closure ⟨i, rfl⟩
    have hpre : (List.ofFn fun i : Fin r => g i.castSucc).prod ∈
        Subgroup.closure (Set.range fun i : Fin r => g i.castSucc) ⊔ commutator L.deck :=
      Subgroup.mem_sup_left hpre0
    have hrw : g (Fin.last r)
        = ((List.ofFn fun i : Fin r => g i.castSucc).prod)⁻¹ * (List.ofFn g).prod := by
      rw [hsplit, inv_mul_cancel_left]
    rw [hrw]
    exact Subgroup.mul_mem _ (Subgroup.inv_mem _ hpre) (Subgroup.mem_sup_right hgprod)
  refine ⟨g, hgin, eq_top_of_sup_commutator_eq_top (eq_top_iff.mpr ?_), hgprod⟩
  rw [← hgtop]
  refine sup_le ((Subgroup.closure_le _).mpr ?_) le_sup_right
  rintro _ ⟨i, rfl⟩
  rw [SetLike.mem_coe]
  induction i using Fin.lastCases with
  | last => exact hlast
  | cast j => exact Subgroup.mem_sup_left (Subgroup.subset_closure ⟨j, rfl⟩)

end Rigidity.RET
