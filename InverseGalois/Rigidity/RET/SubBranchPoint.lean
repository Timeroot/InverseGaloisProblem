import Mathlib
import InverseGalois.Rigidity.RET.SubUnramified

/-!
# The branch locus of a quotient cover is where the branch cycles survive

A Galois subcover of a cover of the line is branched at most where the cover itself is
(`Rigidity.RET.LineCover.IsUnramifiedOutside.sub`), but usually at strictly fewer points: passing to
a quotient of the deck group kills some of the local monodromy, and a point whose branch cycle dies
becomes an ordinary point of the smaller cover.  This file makes that exact.

A distinguished branch cycle at `t` generates the inertia group at a place above `t`, and inertia at
the contracted place of the subcover is the image of that inertia group
(`Rigidity.RET.geomInertia_comap_eq_zpowers`), hence is generated by the image of the branch cycle.
So the subcover is unbranched at `t` precisely when the branch cycle at `t` lies in the kernel of
the restriction map of deck groups — the places of the subcover above `t` are all conjugate, so one
of them suffices to decide it.

## Main results

* `Rigidity.RET.LineCover.isUnramifiedAt_sub_iff` — a Galois subcover is unbranched at `t` exactly
  when the branch cycle at `t` dies in its deck group.
* `Rigidity.RET.LineCover.isUnramifiedOutside_sub_of_isInertiaGenAt` — the branch locus of a Galois
  subcover is contained in the set of points whose branch cycle survives.
-/

open Polynomial
open scoped Pointwise

noncomputable section

namespace Rigidity.RET

open GeomAKLB

attribute [local instance] Ideal.Quotient.field GeomAKLB.instMSA GeomAKLB.instIsFrac
  GeomAKLB.instIGG GeomAKLB.instFinite GeomAKLB.instIntegral GeomAKLB.instFaithful
  GeomAKLB.instDedekindB

namespace LineCover

attribute [local instance] sub_isGalois

variable {L : LineCover} {E : IntermediateField (RatFunc k) L.M} [Normal (RatFunc k) E]
  {t : k} {σ : L.deck}

/-- **A Galois subcover is unbranched at a point whose branch cycle dies in its deck group.**  The
inertia group of the subcover at the contracted place is generated by the image of the branch cycle,
hence trivial; and every place of the subcover above the point is a deck translate of that one. -/
theorem isUnramifiedAt_sub_of_isInertiaGenAt (h : L.IsInertiaGenAt t σ)
    (h1 : L.subHom E σ = 1) : ∀ τ : (L.sub E).deck, (L.sub E).IsInertiaAt t τ → τ = 1 := by
  haveI := isScalarTower_poly_sub (E : Type) L.M
  intro τ hτ
  obtain ⟨Q, hQmax, hQover, hQgen⟩ := h
  haveI := hQmax
  haveI : Q.IsPrime := hQmax.isPrime
  haveI := hQover
  obtain ⟨Q', hQ'max, hQ'over, hQ'in⟩ := hτ
  haveI := hQ'max
  haveI : Q'.IsPrime := hQ'max.isPrime
  haveI := hQ'over
  have hQ'in' : τ ∈ geomInertia (E : Type) Q' := hQ'in
  -- the inertia group at the contracted place is generated by the image of the branch cycle
  have hcomap : geomInertia (E : Type)
      (Q.comap (subInclusion (E := (E : Type)) (M := L.M))) = ⊥ := by
    rw [geomInertia_comap_eq_zpowers (E := (E : Type)) (M := L.M) (L.subHom E)
      (L.subHom_commutes E) t Q (L.subHom_surjective E) hQgen]
    exact Subgroup.zpowers_eq_bot.mpr h1
  haveI hcm : (Q.comap (subInclusion (E := (E : Type)) (M := L.M))).IsMaximal :=
    isMaximal_comap_subInclusion (E := (E : Type)) t Q
  haveI : (Q.comap (subInclusion (E := (E : Type)) (M := L.M))).IsPrime := hcm.isPrime
  haveI := liesOver_comap_subInclusion (E := (E : Type)) (M := L.M) t Q
  obtain ⟨g, hg⟩ := exists_smul_eq_of_liesOver (Ω := (E : Type)) t
    (Q.comap (subInclusion (E := (E : Type)) (M := L.M))) Q'
  rw [hg, geomInertia_smul, hcomap, Subgroup.map_bot] at hQ'in'
  exact Subgroup.mem_bot.mp hQ'in'

/-- **A Galois subcover is unbranched at a point exactly when the branch cycle there dies in its
deck group.** -/
theorem isUnramifiedAt_sub_iff (h : L.IsInertiaGenAt t σ) :
    (∀ τ : (L.sub E).deck, (L.sub E).IsInertiaAt t τ → τ = 1) ↔ L.subHom E σ = 1 :=
  ⟨fun hun => hun _ (IsInertiaGenAt.restrict L h).isInertiaAt,
    isUnramifiedAt_sub_of_isInertiaGenAt h⟩

/-- **The branch locus of a Galois subcover is contained in the set of points whose branch cycle
survives in its deck group.**  Outside the branch locus of the ambient cover the subcover is
unbranched because the ambient cover is, and at a branch point of the ambient cover it is
unbranched as soon as the branch cycle there dies. -/
theorem isUnramifiedOutside_sub_of_isInertiaGenAt {r : ℕ} {u : Fin r → k} {g : Fin r → L.deck}
    (hL : L.IsUnramifiedOutside (Set.range u)) (hg : ∀ i, L.IsInertiaGenAt (u i) (g i)) :
    (L.sub E).IsUnramifiedOutside (u '' {i | L.subHom E (g i) ≠ 1}) := by
  intro s hs τ hτ
  by_cases hmem : s ∈ Set.range u
  · obtain ⟨i, rfl⟩ := hmem
    have h1 : L.subHom E (g i) = 1 := by
      by_contra h1
      exact hs ⟨i, h1, rfl⟩
    exact isUnramifiedAt_sub_of_isInertiaGenAt (hg i) h1 τ hτ
  · exact (hL.sub E) s hmem τ hτ

end LineCover

end Rigidity.RET

end
