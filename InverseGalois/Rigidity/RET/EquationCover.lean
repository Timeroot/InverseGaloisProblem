import Mathlib
import InverseGalois.Rigidity.RET.Degeneracy
import InverseGalois.Rigidity.RET.MoveInfinity

/-!
# The cover defined by an equation

A monic family of equations over the line has a splitting field over the function field of the
line, and that splitting field is a cover of the line.  Its branch points are visible in the
family: the cover is generated by the roots of the equation, and at a point where the specialized
equation stays separable no inertia can move any root, so the cover is unramified there.  The
degeneracy polynomial of the previous file collects those points into the roots of one polynomial
in the parameter, and counting them bounds the number of branch points by its degree.

This turns the qualitative branch-point counting of `RET.MoveInfinity` into arithmetic one can do
on a polynomial: the Galois group of an equation over `ℚ̄(T)` whose degeneracy polynomial has
degree `d` occurs with at most `d` branch points on the affine line, so its abelianization is
generated by `d` elements, and if `d ≤ 1` the group is cyclic.

## Main definitions

* `Rigidity.RET.genericPoly` — the family read over the function field of the line.
* `Rigidity.RET.eqCover` — the splitting field of a separable family, as a cover of the line.

## Main results

* `Rigidity.RET.LineCover.isUnramifiedOutside_degeneracy_of_isSplittingField` — a cover which
  splits the equation is unramified outside the degeneracy locus.
* `Rigidity.RET.LineCover.ncard_branchLocus_le_of_isSplittingField` — its branch points are at most
  the degree of the degeneracy polynomial in number.
* `Rigidity.RET.isAffineDeckGroup_gal` — the Galois group of the equation occurs with that many
  branch points on the affine line, and the corollaries
  `Rigidity.RET.exists_generating_abelianization_gal` and
  `Rigidity.RET.isCyclic_gal_of_natDegree_degeneracy_le_one`.
-/

open Polynomial

noncomputable section


namespace Rigidity.RET

open GeomAKLB

/-- The **generic fibre** of a family of equations over the line: the same family read over the
function field of the line, whose splitting field is the cover the family defines. -/
abbrev genericPoly (f : Polynomial (Polynomial k)) : Polynomial (RatFunc k) :=
  f.map (algebraMap (Polynomial k) (RatFunc k))

namespace LineCover

variable (L : LineCover) (f : Polynomial (Polynomial k))

/-- A root of the generic fibre in a cover is a root of the family itself: the two equations differ
only by the ring the coefficients are read in. -/
theorem aeval_eq_zero_of_mem_rootSet {x : L.M} (hx : x ∈ (genericPoly f).rootSet L.M) :
    (Polynomial.aeval x) f = 0 := by
  have h := (Polynomial.mem_rootSet.mp hx).2
  rwa [Polynomial.aeval_map_algebraMap (RatFunc k)] at h

/-- **A cover splitting the equation is unramified outside the degeneracy locus.**  Such a cover is
generated by the roots of the equation, and wherever the specialized equation stays separable no
inertia element can move a root. -/
theorem isUnramifiedOutside_degeneracy_of_isSplittingField
    [Polynomial.IsSplittingField (RatFunc k) L.M (genericPoly f)] (hf : f.Monic)
    (hdeg : 0 < f.natDegree) :
    L.IsUnramifiedOutside {t : k | (degeneracy f).eval t = 0} := by
  refine L.isUnramifiedOutside_of_forall_separable
    (x := fun z : (genericPoly f).rootSet L.M => (z : L.M)) ?_ (f := fun _ => f) (fun _ => hf)
    (fun z => L.aeval_eq_zero_of_mem_rootSet f z.2) ?_
  · rw [Subtype.range_coe]
    exact Polynomial.IsSplittingField.adjoin_rootSet L.M (genericPoly f)
  · intro t ht _
    exact (separable_specialize_iff f hf hdeg t).mpr ht

/-- **The branch locus of a cover splitting the equation lies in the degeneracy locus.** -/
theorem branchLocus_subset_degeneracy_of_isSplittingField
    [Polynomial.IsSplittingField (RatFunc k) L.M (genericPoly f)] (hf : f.Monic)
    (hdeg : 0 < f.natDegree) :
    L.branchLocus ⊆ {t : k | (degeneracy f).eval t = 0} :=
  (L.isUnramifiedOutside_iff_branchLocus_subset _).mp
    (L.isUnramifiedOutside_degeneracy_of_isSplittingField f hf hdeg)

/-- **A cover splitting a separable equation has at most `deg (degeneracy f)` branch points.**  The
degeneracy polynomial is then nonzero, and a nonzero polynomial has at most as many roots as its
degree. -/
theorem ncard_branchLocus_le_of_isSplittingField
    [Polynomial.IsSplittingField (RatFunc k) L.M (genericPoly f)] (hf : f.Monic)
    (hdeg : 0 < f.natDegree) (hsep : (genericPoly f).Separable) :
    L.branchLocus.ncard ≤ (degeneracy f).natDegree := by
  have hne : degeneracy f ≠ 0 := (separable_generic_iff f hf hdeg).mp hsep
  refine le_trans (Set.ncard_le_ncard
    (L.branchLocus_subset_degeneracy_of_isSplittingField f hf hdeg) ?_) ?_
  · exact Polynomial.finite_setOf_isRoot hne
  · exact ncard_setOf_eval_eq_zero_le hne

/-- **The deck group of a cover splitting a separable equation occurs with at most
`deg (degeneracy f)` branch points on the affine line.** -/
theorem isAffineDeckGroup_of_isSplittingField
    [Polynomial.IsSplittingField (RatFunc k) L.M (genericPoly f)] (hf : f.Monic)
    (hdeg : 0 < f.natDegree) (hsep : (genericPoly f).Separable) :
    IsAffineDeckGroup (degeneracy f).natDegree L.deck :=
  (isAffineDeckGroup_deck L).mono (L.ncard_branchLocus_le_of_isSplittingField f hf hdeg hsep)

end LineCover

/-! ### The splitting cover of an equation -/

/-- The **splitting cover** of a separable family of monic equations over the line: the splitting
field of the generic fibre, packaged as a cover of the line. -/
def eqCover (f : Polynomial (Polynomial k)) (hsep : (genericPoly f).Separable) : LineCover :=
  letI : IsGalois (RatFunc k) (genericPoly f).SplittingField :=
    IsGalois.of_separable_splitting_field hsep
  LineCover.of (genericPoly f).SplittingField

@[simp] theorem eqCover_M (f : Polynomial (Polynomial k)) (hsep : (genericPoly f).Separable) :
    (eqCover f hsep).M = (genericPoly f).SplittingField := rfl

/-- The splitting cover does split the equation. -/
theorem eqCover_isSplittingField (f : Polynomial (Polynomial k))
    (hsep : (genericPoly f).Separable) :
    Polynomial.IsSplittingField (RatFunc k) (eqCover f hsep).M (genericPoly f) :=
  inferInstanceAs
    (Polynomial.IsSplittingField (RatFunc k) (genericPoly f).SplittingField (genericPoly f))

/-- **The Galois group of a monic separable equation over the function field of the line occurs as
a deck group with at most `deg (degeneracy f)` branch points on the affine line.** -/
theorem isAffineDeckGroup_gal (f : Polynomial (Polynomial k)) (hf : f.Monic)
    (hdeg : 0 < f.natDegree) (hsep : (genericPoly f).Separable) :
    IsAffineDeckGroup (degeneracy f).natDegree (genericPoly f).Gal := by
  haveI := eqCover_isSplittingField f hsep
  exact ((eqCover f hsep).isAffineDeckGroup_of_isSplittingField f hf hdeg hsep).congr
    (MulEquiv.refl _)

/-- **The Galois group of the equation has an abelianization generated by `deg (degeneracy f)`
elements.**  Read backwards this is an obstruction: an equation whose Galois group has an
abelianization needing more generators must have a degeneracy polynomial of larger degree. -/
theorem exists_generating_abelianization_gal (f : Polynomial (Polynomial k)) (hf : f.Monic)
    (hdeg : 0 < f.natDegree) (hsep : (genericPoly f).Separable) :
    ∃ s : Fin (degeneracy f).natDegree → Abelianization (genericPoly f).Gal,
      Subgroup.closure (Set.range s) = ⊤ :=
  (isAffineDeckGroup_gal f hf hdeg hsep).exists_generating_abelianization

/-- **An equation whose degeneracy polynomial is constant or linear has a cyclic Galois group over
the function field of the line.**  One branch point on the affine line is exactly the cyclic case,
the point at infinity being free. -/
theorem isCyclic_gal_of_natDegree_degeneracy_le_one (f : Polynomial (Polynomial k)) (hf : f.Monic)
    (hdeg : 0 < f.natDegree) (hsep : (genericPoly f).Separable)
    (hle : (degeneracy f).natDegree ≤ 1) : IsCyclic (genericPoly f).Gal :=
  isAffineDeckGroup_one_iff.mp ((isAffineDeckGroup_gal f hf hdeg hsep).mono hle)

/-- **A nilpotent Galois group of the equation is generated by `deg (degeneracy f)` elements.** -/
theorem exists_generating_gal_of_isNilpotent (f : Polynomial (Polynomial k)) (hf : f.Monic)
    (hdeg : 0 < f.natDegree) (hsep : (genericPoly f).Separable)
    [Group.IsNilpotent (genericPoly f).Gal] :
    ∃ s : Fin (degeneracy f).natDegree → (genericPoly f).Gal,
      Subgroup.closure (Set.range s) = ⊤ :=
  (isAffineDeckGroup_gal f hf hdeg hsep).exists_generating_of_isNilpotent

end Rigidity.RET
