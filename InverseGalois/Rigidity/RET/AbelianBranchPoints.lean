import Mathlib
import InverseGalois.Rigidity.RET.AbelianizedCycles

/-!
# How many branch points an abelian cover of the line needs

For a finite abelian group both directions of the covers correspondence are available
unconditionally, and together they pin down exactly which branch loci occur: a cover of the line
with deck group `H` unramified outside `r + 1` points of the affine line and at infinity exists
precisely when `H` is generated by `r` elements.

One direction is the multi-point Kummer construction, applied to a generating tuple completed by
the inverse of its product; the other is the bound coming from the branch cycles, whose images
generate the abelianization and satisfy one relation, so that `r` of the `r + 1` of them already
suffice.

## Main results

* `Rigidity.RET.exists_cover_iff_exists_generating` — a cover of the line with abelian deck group
  `H` unramified outside `r + 1` prescribed points and at infinity exists if and only if `H` is
  generated by `r` elements.
* `Rigidity.RET.exists_cover_pair_iff_isCyclic` — the case `r = 1`: two branch points suffice
  exactly for the cyclic groups.
-/

open Polynomial IntermediateField

noncomputable section


namespace Rigidity.RET

open GeomAKLB

attribute [local instance] GeomAKLB.instMSA GeomAKLB.instIntegral GeomAKLB.instIsFrac
  GeomAKLB.instIGG GeomAKLB.instFinite GeomAKLB.instDedekindB GeomAKLB.instTorsionFree
  GeomAKLB.instFaithful

variable {H : Type} [CommGroup H] [Finite H]

/-- **A cover of the line with abelian deck group `H`, unramified outside `r + 1` prescribed
points of the affine line and at infinity, exists exactly when `H` is generated by `r`
elements.** -/
theorem exists_cover_iff_exists_generating {r : ℕ} (t : Fin (r + 1) → k)
    (ht : Function.Injective t) :
    (∃ L : LineCover, Nonempty (L.deck ≃* H) ∧
        L.IsUnramifiedOutside (Set.range t) ∧ L.IsUnramifiedAtInfinity) ↔
      ∃ s : Fin r → H, Subgroup.closure (Set.range s) = ⊤ := by
  constructor
  · rintro ⟨L, ⟨e⟩, hout, hinf⟩
    obtain ⟨h, htop⟩ := exists_generating_abelianization L t ht hout hinf
    -- the abelianization of the deck group is `H` itself
    let φ : Abelianization L.deck →* H := Abelianization.lift e.toMonoidHom
    have hφ : Function.Surjective φ := fun y => by
      obtain ⟨x, hx⟩ := e.surjective y
      exact ⟨Abelianization.of x, by simpa [φ] using hx⟩
    refine ⟨fun i => φ (h i), ?_⟩
    have hrange : (Set.range fun i => φ (h i)) = φ '' Set.range h := by
      rw [← Set.range_comp]; rfl
    rw [hrange, ← MonoidHom.map_closure, htop]
    exact Subgroup.map_top_of_surjective _ hφ
  · rintro ⟨s, hs⟩
    -- complete the generating tuple by the inverse of its product
    set h : Fin (r + 1) → H := Fin.snoc s (∏ i, s i)⁻¹ with hh
    have hcast : ∀ i : Fin r, h i.castSucc = s i := by intro i; rw [hh]; simp
    have hlast : h (Fin.last r) = (∏ i, s i)⁻¹ := by rw [hh]; simp
    have hprod : (List.ofFn h).prod = 1 := by
      rw [List.ofFn_succ', List.prod_concat, hlast,
        show (List.ofFn fun i : Fin r => h i.castSucc) = List.ofFn s from
          congrArg List.ofFn (funext hcast),
        List.prod_ofFn, mul_inv_cancel]
    have htop : Subgroup.closure (Set.range h) = ⊤ := by
      refine eq_top_iff.mpr ?_
      rw [← hs, Subgroup.closure_le]
      rintro _ ⟨i, rfl⟩
      exact Subgroup.subset_closure ⟨i.castSucc, hcast i⟩
    obtain ⟨L, e, hout, hinf, -⟩ := exists_cover_of_commGroup t ht h hprod htop
    exact ⟨L, ⟨e⟩, hout, hinf⟩

/-- **Two branch points suffice exactly for the cyclic groups.** -/
theorem exists_cover_pair_iff_isCyclic (t : Fin 2 → k) (ht : Function.Injective t) :
    (∃ L : LineCover, Nonempty (L.deck ≃* H) ∧
        L.IsUnramifiedOutside (Set.range t) ∧ L.IsUnramifiedAtInfinity) ↔ IsCyclic H := by
  rw [exists_cover_iff_exists_generating t ht]
  have hsingle : ∀ s : Fin 1 → H, Subgroup.closure (Set.range s) = Subgroup.zpowers (s 0) := by
    intro s
    rw [Subgroup.zpowers_eq_closure]
    congr 1
    ext x
    constructor
    · rintro ⟨i, rfl⟩
      rw [Subsingleton.elim i 0]
      rfl
    · rintro rfl
      exact ⟨0, rfl⟩
  constructor
  · rintro ⟨s, hs⟩
    rw [hsingle s] at hs
    refine ⟨s 0, fun y => ?_⟩
    show y ∈ Subgroup.zpowers (s 0)
    rw [hs]
    exact Subgroup.mem_top y
  · rintro ⟨g, hg⟩
    refine ⟨fun _ => g, ?_⟩
    rw [hsingle _]
    exact eq_top_iff.mpr fun y _ => hg y

end Rigidity.RET
