/-!
# Equations with simple degenerations have full symmetric monodromy

An inertia element of a cover of the line at a place over a point `t` acts on the roots of the
defining equation preserving their residues, so if the fibre of the equation over `t` has a single
double point the inertia element is a transposition.  A family all of whose fibres degenerate that
mildly therefore has a deck group generated by transpositions, and being generated by transpositions
is enough: a transitive subgroup of a symmetric group generated by transpositions is the whole
symmetric group.

The generation statement is the geometric input.  Every maximal ideal of the integral model of a
cover lies over a point of the affine line — the coordinate ring of the base is a polynomial ring
over an algebraically closed field, whose maximal ideals are the points — and the inertia groups
at all the places of a cover generate its deck group, the affine line being simply connected.  So
the supremum of the inertia subgroups is everything, and `Mathlib.RingTheory.Polynomial.Morse`
converts that, together with the fibrewise condition, into surjectivity of the permutation
representation on the roots.

Applied to the equation `g₀(X) = T` this says that the deck group of the cover presented by a
**Morse polynomial** — one whose critical points are nondegenerate with pairwise distinct critical
values — is the full symmetric group on the `deg g₀` roots.

## Main definitions

* `Rigidity.RET.IsMorseFamily` — every fibre of a family over the line has at most one double point.
* `Rigidity.RET.IsMorse` — the corresponding condition on a single polynomial `g₀`, read through the
  fibres `g₀ - t` of the equation `g₀(X) = T`.

## Main results

* `Rigidity.RET.exists_liesOver_placeP` — every maximal ideal of the integral model of a cover lies
  over a point of the affine line.
* `Rigidity.RET.iSup_inertia_eq_top` — the inertia subgroups at the places of a cover generate its
  deck group.
* `Rigidity.RET.isPretransitive_rootSet_bring` — the deck group of a cover splitting an irreducible
  equation acts transitively on the roots inside the integral model.
* `Rigidity.RET.surjective_toPermHom_of_isMorseFamily` and
  `Rigidity.RET.deckMulEquivPerm` — the deck group of a cover splitting a family with simple
  degenerations is the full symmetric group on the roots.
* `Rigidity.RET.nonempty_deck_linearCover_mulEquiv_perm` — for a Morse polynomial `g₀` the cover
  presented by `g₀(X) = T` has deck group the symmetric group on `deg g₀` letters.
-/

open Polynomial SerreBaseCover

noncomputable section

namespace Rigidity.RET

open GeomAKLB

attribute [local instance] Ideal.Quotient.field GeomAKLB.instMSA GeomAKLB.instIsFrac
  GeomAKLB.instIGG GeomAKLB.instFinite GeomAKLB.instIntegral GeomAKLB.instFaithful
  GeomAKLB.instDedekindB

-- the deck group commutes with the coordinate ring of the base on the integral model, so it acts
-- on the roots of an equation living there
attribute [local instance] Rigidity.RET.instSMulCommDeck

/-! ### Every place of a cover lies over a point of the affine line -/

/-- **Every maximal ideal of the integral model of a cover lies over a point of the affine line.**
Its contraction to the coordinate ring of the base is maximal, because the model is integral over
it, and the maximal ideals of a polynomial ring over an algebraically closed field are the points
of the line. -/
theorem exists_liesOver_placeP (L : LineCover) (Q : Ideal (Bring L.M)) [Q.IsMaximal] :
    ∃ t : k, Q.LiesOver (placeP t) := by
  haveI hP : (Q.under (Polynomial k)).IsMaximal :=
    Ideal.isMaximal_comap_of_isIntegral_of_isMaximal (R := Polynomial k) Q
  obtain ⟨p, hp⟩ := (IsPrincipalIdealRing.principal (Q.under (Polynomial k))).principal
  have hspan : Q.under (Polynomial k) = Ideal.span {p} := hp
  have hp0 : p ≠ 0 := by
    rintro rfl
    rw [Set.singleton_zero, Ideal.span_zero] at hspan
    rw [hspan] at hP
    exact Polynomial.not_isField k (Ring.isField_iff_maximal_bot.mpr hP)
  have hpu : ¬ IsUnit p := by
    intro hu
    exact hP.ne_top (by rw [hspan, Ideal.span_singleton_eq_top.mpr hu])
  have hdeg : p.degree ≠ 0 := fun h => hpu (Polynomial.isUnit_iff_degree_eq_zero.mpr h)
  obtain ⟨t, ht⟩ := IsAlgClosed.exists_root p hdeg
  refine ⟨t, ⟨?_⟩⟩
  refine (hP.eq_of_le (placeP_max t).ne_top ?_).symm
  rw [hspan, Ideal.span_le, Set.singleton_subset_iff]
  exact Ideal.mem_span_singleton.mpr (Polynomial.dvd_iff_isRoot.mpr ht)

/-- **The inertia subgroups at the places of a cover of the line generate its deck group.**  Every
inertia element of the cover lies in the inertia group of some place of the integral model, and the
inertia elements generate the deck group because the affine line is simply connected. -/
theorem iSup_inertia_eq_top (L : LineCover) :
    ⨆ m : MaximalSpectrum (Bring L.M), m.asIdeal.inertia L.deck = ⊤ := by
  rw [eq_top_iff, ← closure_isInertiaAt_eq_top L]
  refine (Subgroup.closure_le _).mpr ?_
  rintro σ ⟨t, Q, hQmax, hQover, hσ⟩
  exact le_iSup (fun m : MaximalSpectrum (Bring L.M) => m.asIdeal.inertia L.deck)
    ⟨Q, hQmax⟩ hσ

/-! ### Transitivity on the roots in the integral model -/

variable (L : LineCover) (f : Polynomial (Polynomial k))

/-- A root of the equation in the integral model is a root of the generic fibre in the cover. -/
theorem coe_mem_rootSet_genericPoly (hf : f.Monic) {b : Bring L.M}
    (hb : b ∈ f.rootSet (Bring L.M)) : ((b : L.M)) ∈ (genericPoly f).rootSet L.M := by
  have haeval : (Polynomial.aeval b) f = 0 := (Polynomial.mem_rootSet'.mp hb).2
  have key := Polynomial.aeval_algHom_apply
    (Subalgebra.val (integralClosure (Polynomial k) L.M)) b f
  simp only [Subalgebra.coe_val] at key
  have hzero : (Polynomial.aeval ((b : L.M))) f = 0 := by
    rw [key, haeval, ZeroMemClass.coe_zero]
  rw [Polynomial.mem_rootSet']
  refine ⟨((hf.map (algebraMap (Polynomial k) (RatFunc k))).map
    (algebraMap (RatFunc k) L.M)).ne_zero, ?_⟩
  rw [Polynomial.aeval_map_algebraMap (RatFunc k)]
  exact hzero

/-- **The deck group of a cover splitting an irreducible equation permutes the roots of the equation
in the integral model transitively.**  Two roots of an irreducible polynomial have the same minimal
polynomial, and a normal extension moves one to the other. -/
theorem isPretransitive_rootSet_bring (hf : f.Monic)
    (hirr : Irreducible (genericPoly f)) :
    MulAction.IsPretransitive L.deck (f.rootSet (Bring L.M)) := by
  refine ⟨fun x y => ?_⟩
  have hx := coe_mem_rootSet_genericPoly L f hf x.2
  have hy := coe_mem_rootSet_genericPoly L f hf y.2
  have hmx := minpoly.eq_of_irreducible hirr (Polynomial.mem_rootSet.mp hx).2
  have hmy := minpoly.eq_of_irreducible hirr (Polynomial.mem_rootSet.mp hy).2
  obtain ⟨σ, hσ⟩ := (Normal.minpoly_eq_iff_mem_orbit (F := RatFunc k) (E := L.M)).mp
    (hmy.symm.trans hmx)
  refine ⟨σ, Subtype.ext (Subtype.ext ?_)⟩
  rw [Polynomial.rootSet.coe_smul, coe_smul_geom]
  exact hσ

/-! ### Families with simple degenerations -/

/-- A family of equations over the line has **simple degenerations** when every fibre has at most
one double point: outside a single value the fibre is separable there, and at that value it
degenerates to order exactly two. -/
def IsMorseFamily (f : Polynomial (Polynomial k)) : Prop :=
  ∀ t : k, ∃ a : k, (∀ x : k, (f.map (evalRingHom t)).IsRoot x →
      (derivative (f.map (evalRingHom t))).IsRoot x → x = a) ∧
    ¬ (derivative (derivative (f.map (evalRingHom t)))).IsRoot a

/-- The residues of the roots of a family with simple degenerations collide at most once at every
place of the integral model. -/
theorem ncard_rootSet_le_of_isMorseFamily (hf : f.Monic) (hmorse : IsMorseFamily f)
    (m : MaximalSpectrum (Bring L.M)) :
    (f.rootSet (Bring L.M)).ncard ≤ (f.rootSet (Bring L.M ⧸ m.asIdeal)).ncard + 1 := by
  haveI := m.isMaximal
  obtain ⟨t, ht⟩ := exists_liesOver_placeP L m.asIdeal
  haveI := ht
  obtain ⟨a, hone, htwo⟩ := hmorse t
  exact ncard_rootSet_le_of_fibre L f hf t m.asIdeal a hone htwo

/-- **The deck group of a cover splitting an irreducible family with simple degenerations is the
full symmetric group on the roots of the family in the integral model.**  The inertia subgroups
generate the deck group, and each of them is generated by a transposition. -/
theorem surjective_toPermHom_of_isMorseFamily (hf : f.Monic)
    [Polynomial.IsSplittingField (RatFunc k) L.M (genericPoly f)]
    (hirr : Irreducible (genericPoly f)) (hmorse : IsMorseFamily f) :
    Function.Surjective (MulAction.toPermHom L.deck (f.rootSet (Bring L.M))) := by
  haveI := isPretransitive_rootSet_bring L f hf hirr
  exact (splits_map_bring L f hf).surjective_toPermHom_of_iSup_inertia_eq_top
    (ncard_rootSet_le_of_isMorseFamily L f hf hmorse) (iSup_inertia_eq_top L)

/-- **The permutation representation on the roots identifies the deck group with the symmetric
group.** -/
def deckMulEquivPerm (hf : f.Monic)
    [Polynomial.IsSplittingField (RatFunc k) L.M (genericPoly f)]
    (hirr : Irreducible (genericPoly f)) (hmorse : IsMorseFamily f) :
    L.deck ≃* Equiv.Perm (f.rootSet (Bring L.M)) :=
  MulEquiv.ofBijective (MulAction.toPermHom L.deck (f.rootSet (Bring L.M)))
    ⟨toPermHom_injective L f hf, surjective_toPermHom_of_isMorseFamily L f hf hirr hmorse⟩

/-! ### Counting the roots in the integral model -/

/-- The roots of a monic equation in the integral model of a cover splitting it are exactly the
roots of the generic fibre in the cover. -/
def rootSetEquivGeneric (hf : f.Monic)
    [Polynomial.IsSplittingField (RatFunc k) L.M (genericPoly f)] :
    f.rootSet (Bring L.M) ≃ (genericPoly f).rootSet L.M :=
  Equiv.ofBijective (fun b => ⟨((b : Bring L.M) : L.M),
      coe_mem_rootSet_genericPoly L f hf b.2⟩)
    ⟨fun b b' h => Subtype.ext (Subtype.ext
        (congrArg (fun z : ((genericPoly f).rootSet L.M) => (z : L.M)) h)), fun x => by
      obtain ⟨b, hbx, hbmem⟩ := mem_rootSet_bring L f hf x.2
      exact ⟨⟨b, hbmem⟩, Subtype.ext hbx⟩⟩

/-- **A cover splitting a separable monic equation carries exactly `deg f` roots of the equation in
its integral model.** -/
theorem ncard_rootSet_bring (hf : f.Monic)
    [Polynomial.IsSplittingField (RatFunc k) L.M (genericPoly f)]
    (hsep : (genericPoly f).Separable) :
    (f.rootSet (Bring L.M)).ncard = f.natDegree := by
  classical
  have hcard : Fintype.card ((genericPoly f).rootSet L.M) = (genericPoly f).natDegree :=
    Polynomial.card_rootSet_eq_natDegree hsep
      (Polynomial.IsSplittingField.splits L.M (genericPoly f))
  rw [← Nat.card_coe_set_eq, Nat.card_eq_fintype_card,
    Fintype.card_congr (rootSetEquivGeneric L f hf), hcard,
    hf.natDegree_map (algebraMap (Polynomial k) (RatFunc k))]

/-! ### Morse polynomials -/

/-- A polynomial is **Morse** when the equation `g₀(X) = T` has simple degenerations: over every
value of the parameter at most one root of the fibre is a critical point of `g₀`, and it is a
nondegenerate one. -/
def IsMorse (g₀ : Polynomial k) : Prop :=
  ∀ t : k, ∃ a : k, (∀ x : k, (g₀ - C t).IsRoot x → (derivative g₀).IsRoot x → x = a) ∧
    ¬ (derivative (derivative g₀)).IsRoot a

/-- The equation presented by a Morse polynomial is a family with simple degenerations. -/
theorem isMorseFamily_linearCoverC (g₀ : Polynomial k) (h : IsMorse g₀) :
    IsMorseFamily (linearCoverC g₀) := by
  intro t
  obtain ⟨a, hone, htwo⟩ := h t
  have hfib : (linearCoverC g₀).map (evalRingHom t) = g₀ - C t := linearCoverC_map_evalRingHom g₀ t
  have hder : derivative (g₀ - C t) = derivative g₀ := by
    rw [derivative_sub, derivative_C, sub_zero]
  refine ⟨a, ?_, ?_⟩
  · intro x hx hx'
    rw [hfib] at hx hx'
    rw [hder] at hx'
    exact hone x hx hx'
  · rw [hfib, hder]
    exact htwo

/-- **The cover presented by a Morse equation has the full symmetric group on `deg g₀` letters as
its deck group.** -/
theorem nonempty_deck_linearCover_mulEquiv_perm (g₀ : Polynomial k) (hg : g₀.Monic)
    (hd : 1 ≤ g₀.natDegree) (h : IsMorse g₀) :
    Nonempty ((linearCover g₀ hg hd).deck ≃* Equiv.Perm (Fin g₀.natDegree)) := by
  classical
  haveI := eqCover_isSplittingField (linearCoverC g₀) (genericPoly_linearCoverC_separable g₀ hg hd)
  have hmonic : (linearCoverC g₀).Monic := linearCoverC_monic g₀ hg hd
  have hirr : Irreducible (genericPoly (linearCoverC g₀)) :=
    (Monic.irreducible_iff_irreducible_map_fraction_map (K := RatFunc k) hmonic).mp
      (linearCoverC_irreducible g₀)
  have hcard : ((linearCoverC g₀).rootSet
      (Bring (linearCover g₀ hg hd).M)).ncard = g₀.natDegree := by
    rw [ncard_rootSet_bring (linearCover g₀ hg hd) (linearCoverC g₀) hmonic
      (genericPoly_linearCoverC_separable g₀ hg hd), linearCoverC_natDegree g₀ hd]
  have he : Fintype.card ((linearCoverC g₀).rootSet
      (Bring (linearCover g₀ hg hd).M)) = g₀.natDegree := by
    rw [← Nat.card_eq_fintype_card, Nat.card_coe_set_eq, hcard]
  exact ⟨(deckMulEquivPerm (linearCover g₀ hg hd) (linearCoverC g₀) hmonic hirr
    (isMorseFamily_linearCoverC g₀ h)).trans
    (Equiv.permCongrHom (Fintype.equivFinOfCardEq he))⟩

section MorsePoly

variable {n : ℕ}

/-- The polynomial `Xⁿ - nX`.  Its critical points are the `(n-1)`-st roots of unity, at each of
which it takes the value `(1 - n)ζ`, so distinct critical points have distinct critical values. -/
def morsePoly (n : ℕ) : Polynomial k := X ^ n - C (n : k) * X

theorem natDegree_C_mul_X_le (a : k) : (C a * X).natDegree ≤ 1 :=
  natDegree_le_iff_degree_le.mpr (degree_C_mul_X_le a)

theorem morsePoly_monic (hn : 2 ≤ n) : (morsePoly n : Polynomial k).Monic :=
  monic_X_pow_sub <| lt_of_le_of_lt (degree_C_mul_X_le _) (by exact_mod_cast hn)

theorem morsePoly_natDegree (hn : 2 ≤ n) : (morsePoly n : Polynomial k).natDegree = n := by
  rw [morsePoly, natDegree_sub_eq_left_of_natDegree_lt, natDegree_X_pow]
  exact lt_of_le_of_lt (natDegree_C_mul_X_le _) (by rw [natDegree_X_pow]; omega)

theorem derivative_morsePoly (n : ℕ) :
    derivative (morsePoly n : Polynomial k) = C (n : k) * X ^ (n - 1) - C (n : k) := by
  rw [morsePoly, derivative_sub, derivative_X_pow, derivative_C_mul, derivative_X, mul_one]

theorem derivative_two_morsePoly (n : ℕ) :
    derivative (derivative (morsePoly n : Polynomial k))
      = C ((n : k) * ((n - 1 : ℕ) : k)) * X ^ (n - 2) := by
  rw [derivative_morsePoly, derivative_sub, derivative_C, sub_zero, derivative_C_mul,
    derivative_X_pow, C_mul, mul_assoc, show n - 1 - 1 = n - 2 by omega]

/-- The second derivative of `Xⁿ - nX` vanishes only at `0`. -/
theorem not_isRoot_derivative_two_morsePoly (hn : 2 ≤ n) {a : k} (ha : a ≠ 0) :
    ¬ (derivative (derivative (morsePoly n : Polynomial k))).IsRoot a := by
  rw [IsRoot, derivative_two_morsePoly, eval_mul, eval_C, eval_pow, eval_X]
  refine mul_ne_zero (mul_ne_zero (cast_ne_zero_of_two_le hn) ?_) (pow_ne_zero _ ha)
  exact Nat.cast_ne_zero.mpr (by omega)

/-- A point at which both `Xⁿ - nX - t` and its derivative vanish is the single point
`t / (1 - n)`; in particular there is no such point when `t = 0`. -/
theorem eq_of_isRoot_morsePoly (hn : 2 ≤ n) {t x : k}
    (hx : ((morsePoly n : Polynomial k) - C t).IsRoot x)
    (hx' : (derivative (morsePoly n : Polynomial k)).IsRoot x) :
    t ≠ 0 ∧ x = t / (1 - (n : k)) := by
  have hn0 : (n : k) ≠ 0 := cast_ne_zero_of_two_le hn
  have hpow : x ^ (n - 1) = 1 := by
    rw [IsRoot, derivative_morsePoly, eval_sub, eval_mul, eval_C, eval_pow, eval_X,
      sub_eq_zero] at hx'
    exact mul_left_cancel₀ hn0 (by rw [hx', mul_one])
  have hxn : x ^ n = x := by
    conv_lhs => rw [show n = (n - 1) + 1 by omega]
    rw [pow_succ, hpow, one_mul]
  have hx0 : x ≠ 0 := by
    intro h
    rw [h, zero_pow (by omega : n - 1 ≠ 0)] at hpow
    exact zero_ne_one hpow
  have ht : t = (1 - (n : k)) * x := by
    rw [IsRoot, morsePoly, eval_sub, eval_sub, eval_pow, eval_X, eval_mul, eval_C, eval_X, eval_C,
      hxn, sub_eq_zero] at hx
    linear_combination -hx
  have h1n : (1 : k) - (n : k) ≠ 0 := fun h => cast_sub_one_ne_zero hn (by linear_combination -h)
  exact ⟨by rw [ht]; exact mul_ne_zero h1n hx0, by rw [ht, mul_div_cancel_left₀ _ h1n]⟩

/-- **`Xⁿ - nX` is a Morse polynomial**: every one of its fibres has at most one double point, and
that point is a nondegenerate critical point. -/
theorem isMorse_morsePoly (hn : 2 ≤ n) : IsMorse (morsePoly n : Polynomial k) := by
  intro t
  by_cases ht : t = 0
  · refine ⟨1, ?_, not_isRoot_derivative_two_morsePoly hn one_ne_zero⟩
    intro x hx hx'
    exact absurd (eq_of_isRoot_morsePoly hn hx hx').1 (by simp [ht])
  · have h1n : (1 : k) - (n : k) ≠ 0 := fun h => cast_sub_one_ne_zero hn (by linear_combination -h)
    refine ⟨t / (1 - (n : k)), fun x hx hx' => (eq_of_isRoot_morsePoly hn hx hx').2,
      not_isRoot_derivative_two_morsePoly hn (div_ne_zero ht h1n)⟩

/-- **The symmetric group on `n` letters is the deck group of an explicit cover of the affine
line**, namely the one presented by the equation `Xⁿ - nX = T`. -/
theorem nonempty_deck_morseCover (hn : 2 ≤ n)
    (hd : 1 ≤ (morsePoly n : Polynomial k).natDegree) :
    Nonempty ((linearCover (morsePoly n) (morsePoly_monic hn) hd).deck ≃* Equiv.Perm (Fin n)) := by
  have h := nonempty_deck_linearCover_mulEquiv_perm (morsePoly n) (morsePoly_monic hn) hd
    (isMorse_morsePoly hn)
  rwa [morsePoly_natDegree hn] at h

end MorsePoly

end Rigidity.RET

