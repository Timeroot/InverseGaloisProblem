import Mathlib
import InverseGalois.Rigidity.RET.FreeAbelianUniversal
import InverseGalois.Rigidity.RET.ExistenceAbelian

/-!
# An abelian cover of the line embeds in the free abelian cover

A cover of the line with abelian deck group, unramified outside a finite set of points of the
affine line and at infinity, is generated by its cyclic subcovers: a finite abelian group is a
product of cyclic groups, and the kernels of the projections onto the factors intersect trivially,
so the fixed fields of those kernels generate the whole cover.  Each of those fixed fields is a
cyclic cover with the same branch locus, hence carries a multi-point Kummer model whose degree
divides the degree of the cover and whose exponents sum to a multiple of that degree.  Such an
equation splits in the free abelian cover, so every cyclic subcover — and therefore the cover
itself — embeds in it.

## Main results

* `Rigidity.RET.mem_range_of_aeval_eq_zero` — a root of a polynomial that splits in a cover lies in
  the image of that cover.
* `Rigidity.RET.image_mem_range_of_isSplittingField` — a subfield that is a splitting field of such
  a polynomial is carried into the image of that cover.
* `Rigidity.RET.exists_algHom_of_comm` — a cover with abelian deck group embeds in any cover
  splitting all the admissible multi-point Kummer equations over its branch locus.
-/

open Polynomial IntermediateField

noncomputable section


namespace Rigidity.RET

open GeomAKLB

attribute [local instance] GeomAKLB.instMSA GeomAKLB.instIntegral GeomAKLB.instIsFrac
  GeomAKLB.instIGG GeomAKLB.instFinite GeomAKLB.instDedekindB GeomAKLB.instTorsionFree
  GeomAKLB.instFaithful

/-! ### Roots of a polynomial split by a cover -/

section Roots

variable {Ω : Type} [Field Ω] [Algebra (RatFunc k) Ω]

/-- **A root of a polynomial that splits in a cover lies in the image of that cover.** -/
theorem mem_range_of_aeval_eq_zero {U : LineCover} (κ : U.M →ₐ[RatFunc k] Ω)
    {p : (RatFunc k)[X]} (hp : p ≠ 0)
    (hsp : (p.map (algebraMap (RatFunc k) U.M)).Splits) {z : Ω} (hz : aeval z p = 0) :
    z ∈ κ.range := by
  set q := p.map (algebraMap (RatFunc k) U.M) with hq
  have hqne : q ≠ 0 :=
    (Polynomial.map_ne_zero_iff (algebraMap (RatFunc k) U.M).injective).mpr hp
  have hmap : q.map (κ : U.M →+* Ω) = p.map (algebraMap (RatFunc k) Ω) := by
    rw [hq, Polynomial.map_map, κ.comp_algebraMap]
  have hzr : z ∈ (q.map (κ : U.M →+* Ω)).roots := by
    rw [Polynomial.mem_roots
      ((Polynomial.map_ne_zero_iff (κ : U.M →+* Ω).injective).mpr hqne), hmap]
    show Polynomial.eval z (p.map (algebraMap (RatFunc k) Ω)) = 0
    rw [Polynomial.eval_map, ← Polynomial.aeval_def]
    exact hz
  rw [hsp.roots_map] at hzr
  obtain ⟨w, -, hw⟩ := Multiset.mem_map.mp hzr
  exact ⟨w, hw⟩

/-- **A subfield that is a splitting field of a polynomial split by a cover is carried into the
image of that cover.** -/
theorem image_mem_range_of_isSplittingField {L U : LineCover} (ρ : L.M →ₐ[RatFunc k] Ω)
    (κ : U.M →ₐ[RatFunc k] Ω) (E : IntermediateField (RatFunc k) L.M) {p : (RatFunc k)[X]}
    (hp : p ≠ 0) (hE : IsSplittingField (RatFunc k) (E : Type) p)
    (hsp : (p.map (algebraMap (RatFunc k) U.M)).Splits) {y : L.M} (hy : y ∈ E) :
    ρ y ∈ κ.range := by
  haveI := hE
  set φ : (E : Type) →ₐ[RatFunc k] Ω := ρ.comp E.val with hφ
  have hadj : Algebra.adjoin (RatFunc k) (p.rootSet (E : Type)) = ⊤ :=
    IsSplittingField.adjoin_rootSet (E : Type) p
  have hmem : φ ⟨y, hy⟩ ∈ Subalgebra.map φ (Algebra.adjoin (RatFunc k) (p.rootSet (E : Type))) :=
    Subalgebra.mem_map.mpr ⟨⟨y, hy⟩, by rw [hadj]; trivial, rfl⟩
  rw [← Algebra.adjoin_image] at hmem
  refine Algebra.adjoin_le ?_ hmem
  rintro _ ⟨x, hx, rfl⟩
  refine mem_range_of_aeval_eq_zero κ hp hsp ?_
  rw [Polynomial.aeval_algHom_apply, (Polynomial.mem_rootSet.mp hx).2, map_zero]

end Roots

/-! ### Embedding a cover with abelian deck group -/

section Embed

/-- **A cover of the line with abelian deck group embeds in any cover of the line in which every
admissible multi-point Kummer equation over its branch locus splits.**

The cover is generated by the fixed fields of the coordinate kernels of its deck group, each of
which is a cyclic cover with the same branch locus and hence has a multi-point Kummer model of
degree dividing the degree of the cover and with exponent sum divisible by that degree. -/
theorem exists_algHom_of_comm (L U : LineCover) (hab : ∀ a b : L.deck, a * b = b * a)
    {r : ℕ} (t : Fin r → k) (ht : Function.Injective t)
    (hout : L.IsUnramifiedOutside (Set.range t)) (hinf : L.IsUnramifiedAtInfinity)
    (hU : ∀ (m : ℕ) (a : Fin r → ℕ), 0 < m → m ∣ Module.finrank (RatFunc k) L.M →
        m ∣ ∑ i, a i →
      (((X : (RatFunc k)[X]) ^ m -
          C (algebraMap (Polynomial k) (RatFunc k) (multiA t a))).map
        (algebraMap (RatFunc k) U.M)).Splits) :
    Nonempty (L.M →ₐ[RatFunc k] U.M) := by
  classical
  letI : CommGroup L.deck := { (inferInstance : Group L.deck) with mul_comm := hab }
  obtain ⟨ι, -, m, -, ⟨e⟩⟩ := CommGroup.equiv_prod_multiplicative_zmod_of_finite L.deck
  let Ω := AlgebraicClosure (RatFunc k)
  let ρ : L.M →ₐ[RatFunc k] Ω := IsAlgClosed.lift
  let κ : U.M →ₐ[RatFunc k] Ω := IsAlgClosed.lift
  -- the coordinate characters of the deck group
  let f : (i : ι) → L.deck →* Multiplicative (ZMod (m i)) := fun i =>
    (Pi.evalMonoidHom (fun i : ι => Multiplicative (ZMod (m i))) i).comp e.toMonoidHom
  have hfsurj : ∀ i, Function.Surjective (f i) := fun i v =>
    ⟨e.symm (Pi.mulSingle i v), by simp [f]⟩
  -- the fixed field of each coordinate kernel is carried into the image of `U`
  have hkey : ∀ (i : ι) {y : L.M}, y ∈ fixedField (f i).ker → ρ y ∈ κ.range := by
    intro i y hy
    haveI : IsCyclic (L.sub (fixedField (f i).ker)).deck :=
      isCyclic_of_surjective (descentEquiv (f i) (hfsurj i)).symm.toMonoidHom
        (descentEquiv (f i) (hfsurj i)).symm.surjective
    obtain ⟨a, -, -, hsf⟩ :=
      exists_multiKummer_model_on (L.sub (fixedField (f i).ker)) t ht
        (hout.sub (fixedField (f i).ker))
    set d := Module.finrank (RatFunc k) (L.sub (fixedField (f i).ker)).M with hd
    have hdpos : 0 < d := Module.finrank_pos
    haveI : NeZero d := ⟨hdpos.ne'⟩
    haveI := hsf
    have hdsum : d ∣ ∑ j, a j :=
      dvd_sum_of_isUnramifiedAtInfinity (n := d) (t := t) (a := a) _
        (hinf.sub (fixedField (f i).ker))
    have hdvd : d ∣ Module.finrank (RatFunc k) L.M :=
      ⟨Module.finrank (fixedField (f i).ker) L.M,
        (Module.finrank_mul_finrank (RatFunc k) (fixedField (f i).ker) L.M).symm⟩
    exact image_mem_range_of_isSplittingField ρ κ (fixedField (f i).ker)
      (X_pow_sub_C_ne_zero hdpos _) hsf (hU d a hdpos hdvd hdsum) hy
  -- hence the preimage of that image is the whole cover
  set S : IntermediateField (RatFunc k) L.M := IntermediateField.comap ρ κ.fieldRange with hS
  have hSle : ∀ i, fixedField (f i).ker ≤ S := by
    intro i y hy
    obtain ⟨w, hw⟩ := hkey i hy
    exact ⟨w, hw⟩
  have hfix : S.fixingSubgroup = ⊥ := by
    rw [eq_bot_iff]
    intro σ hσ
    rw [Subgroup.mem_bot]
    refine e.injective ?_
    rw [map_one]
    funext i
    have hσi : σ ∈ (fixedField (f i).ker).fixingSubgroup := by
      simp only [IntermediateField.mem_fixingSubgroup_iff] at hσ ⊢
      exact fun y hy => hσ y (hSle i hy)
    rw [IntermediateField.fixingSubgroup_fixedField] at hσi
    exact hσi
  have hStop : S = ⊤ := by
    have hgal := IsGalois.fixedField_fixingSubgroup S
    rwa [hfix, IntermediateField.fixedField_bot, eq_comm] at hgal
  refine ⟨(AlgEquiv.ofInjectiveField κ).symm.toAlgHom.comp (ρ.codRestrict κ.range ?_)⟩
  intro y
  have hy : y ∈ S := hStop ▸ IntermediateField.mem_top
  obtain ⟨w, hw⟩ := hy
  exact ⟨w, hw⟩

end Embed

end Rigidity.RET
