/-- **The regularity core.**  For a finite extension `L / ℚ(T)` in which `ℚ` is relatively
algebraically closed (`algebraicClosure ℚ L = ⊥`, "regular"), the base change of `L` to the
geometric base field `ℚ̄(T) = FractionRing ℚ̄[T]` is a **field**.

The reduction: both `ℚ̄(T)` and `L` are algebraic over `ℚ(T)`, so they embed into an algebraic
closure `Ω = AlgebraicClosure ℚ(T)`; if their images are **linearly disjoint** over `ℚ(T)` then
`ℚ̄(T) ⊗ L` injects into the domain `Ω` (`Subalgebra.LinearDisjoint.isDomain_of_injective`), hence is
a domain, hence — being algebraic — a field (`Algebra.TensorProduct.isField_of_isAlgebraic`).

The linear disjointness is the geometric-integrality content of regularity.  It is proved by the
**colimit** route: `Subalgebra.LinearDisjoint.of_linearDisjoint_finite_left` reduces to every finite
subalgebra `A'` of the `ℚ̄(T)`-image; via `extract`, `A'` sits inside a single **constant**-adjoin
`C = ℚ(T)⟮c⟯` (`c = fa γ`, `γ ∈ ℚ̄`); the minimal polynomial of `c` over `ℚ(T)` equals
`(minpoly ℚ γ).map`, irreducible over `L` by the crux + `regular_ratFunc`, so the finite building
block gives `IsField (C ⊗ L)`, hence `C.LinearDisjoint fb.range`, transferred back to `A'`. -/
theorem isField_baseChange_of_regular
    {L : Type*} [Field L] [Algebra (RatFunc ℚ) L] [FiniteDimensional (RatFunc ℚ) L]
    [Algebra ℚ L] [IsScalarTower ℚ (RatFunc ℚ) L]
    (hreg : algebraicClosure ℚ L = ⊥) :
    IsField (FractionRing (Polynomial (AlgebraicClosure ℚ)) ⊗[RatFunc ℚ] L) := by
  classical
  haveI algL : Algebra.IsAlgebraic (RatFunc ℚ) L := Algebra.IsAlgebraic.of_finite _ _
  haveI algK : Algebra.IsAlgebraic (RatFunc ℚ)
      (FractionRing (Polynomial (AlgebraicClosure ℚ))) := isAlgebraic_ratFunc_geom
  let S := AlgebraicClosure (RatFunc ℚ)
  let fa : FractionRing (Polynomial (AlgebraicClosure ℚ)) →ₐ[RatFunc ℚ] S := IsAlgClosed.lift
  let fb : L →ₐ[RatFunc ℚ] S := IsAlgClosed.lift
  have hfa : Function.Injective fa := fa.toRingHom.injective
  have hfb : Function.Injective fb := fb.toRingHom.injective
  have hFreg : algebraicClosure ℚ (RatFunc ℚ) = ⊥ := regular_ratFunc
  haveI hSint : Algebra.IsIntegral (RatFunc ℚ) S := Algebra.IsAlgebraic.isIntegral
  haveI : Algebra.IsIntegral (RatFunc ℚ) ↥fa.range := ⟨fun y =>
    (isIntegral_algHom_iff fa.range.val Subtype.val_injective).mp
      (Algebra.IsIntegral.isIntegral (y : S))⟩
  have hLD : fa.range.LinearDisjoint fb.range := by
    refine Subalgebra.LinearDisjoint.of_linearDisjoint_finite_left fa.range fb.range ?_
    intro A' hA' hFin
    haveI := hFin
    obtain ⟨g, hgspan⟩ := Module.finite_def.mp hFin
    have hmemrange : ∀ a : ↥A', (a : S) ∈ fa.range := fun a => hA' a.2
    choose φ hφ using fun a : ↥A' => (fa.mem_range).mp (hmemrange a)
    obtain ⟨γ, hγ⟩ := extract (g.image φ)
    set c : S := fa (algebraMap (AlgebraicClosure ℚ)
      (FractionRing (Polynomial (AlgebraicClosure ℚ))) γ) with hcdef
    set C : IntermediateField (RatFunc ℚ) S := IntermediateField.adjoin (RatFunc ℚ) {c} with hCdef
    have hgen : ∀ i ∈ g, (fa (φ i)) ∈ C := by
      intro i hi
      have hmem : φ i ∈ IntermediateField.adjoin (RatFunc ℚ)
          {algebraMap (AlgebraicClosure ℚ) (FractionRing (Polynomial (AlgebraicClosure ℚ))) γ} :=
        hγ (φ i) (Finset.mem_image_of_mem φ hi)
      have h2 : fa (φ i) ∈ (IntermediateField.adjoin (RatFunc ℚ)
          {algebraMap (AlgebraicClosure ℚ)
            (FractionRing (Polynomial (AlgebraicClosure ℚ))) γ}).map fa := by
        have himg : fa (φ i) ∈ (fa '' (IntermediateField.adjoin (RatFunc ℚ)
            {algebraMap (AlgebraicClosure ℚ)
              (FractionRing (Polynomial (AlgebraicClosure ℚ))) γ} : Set _)) :=
          Set.mem_image_of_mem fa hmem
        rwa [← IntermediateField.coe_map] at himg
      rw [IntermediateField.adjoin_map, Set.image_singleton] at h2
      exact h2
    have hAC : A' ≤ C.toSubalgebra := by
      intro x hx
      rw [IntermediateField.mem_toSubalgebra]
      have h1 : (⟨x, hx⟩ : ↥A') ∈ Submodule.span (RatFunc ℚ) (g : Set ↥A') := by
        rw [hgspan]; exact Submodule.mem_top
      have h2 : x ∈ (Submodule.span (RatFunc ℚ) (g : Set ↥A')).map A'.val.toLinearMap :=
        Submodule.mem_map_of_mem h1
      rw [Submodule.map_span] at h2
      have hsub : (A'.val.toLinearMap '' (g : Set ↥A')) ⊆ (C.toSubmodule : Set S) := by
        rintro _ ⟨i, hi, rfl⟩
        show (i : S) ∈ C
        rw [← hφ i]
        exact hgen i hi
      exact (Submodule.span_le.mpr hsub) h2
    have hγint : IsIntegral ℚ γ := Algebra.IsIntegral.isIntegral γ
    have hcF : IsIntegral (RatFunc ℚ) c := Algebra.IsIntegral.isIntegral c
    haveI hCfin : FiniteDimensional (RatFunc ℚ) ↥C :=
      IntermediateField.adjoin.finiteDimensional hcF
    have hminF : minpoly (RatFunc ℚ) c
        = (minpoly ℚ γ).map (algebraMap ℚ (RatFunc ℚ)) := by
      have hcomp1 : (algebraMap (RatFunc ℚ) (FractionRing (Polynomial (AlgebraicClosure ℚ)))).comp
          (algebraMap ℚ (RatFunc ℚ))
          = algebraMap ℚ (FractionRing (Polynomial (AlgebraicClosure ℚ))) :=
        Subsingleton.elim _ _
      rw [hcdef, minpoly.algHom_eq fa hfa]
      set cK : FractionRing (Polynomial (AlgebraicClosure ℚ)) :=
        algebraMap (AlgebraicClosure ℚ) (FractionRing (Polynomial (AlgebraicClosure ℚ))) γ
        with hcKdef
      have hqmonic : ((minpoly ℚ γ).map (algebraMap ℚ (RatFunc ℚ))).Monic :=
        (minpoly.monic hγint).map _
      have hqirr : Irreducible ((minpoly ℚ γ).map (algebraMap ℚ (RatFunc ℚ))) :=
        irreducible_map_of_algClosure_eq_bot hFreg (minpoly.monic hγint) (minpoly.irreducible hγint)
      have hqeval : (Polynomial.aeval cK)
          ((minpoly ℚ γ).map (algebraMap ℚ (RatFunc ℚ))) = 0 := by
        rw [Polynomial.aeval_def, Polynomial.eval₂_map, hcomp1, ← Polynomial.aeval_def, hcKdef,
          Polynomial.aeval_algebraMap_apply, minpoly.aeval, map_zero]
      exact (minpoly.eq_of_irreducible_of_monic hqirr hqeval hqmonic).symm
    let γ' := IntermediateField.AdjoinSimple.gen (RatFunc ℚ) c
    have hγ'top : IntermediateField.adjoin (RatFunc ℚ) {γ'} = ⊤ := by
      apply IntermediateField.adjoin_eq_top_of_algebra
      exact (IntermediateField.adjoin.powerBasis hcF).adjoin_gen_eq_top
    have hirr : Irreducible ((minpoly (RatFunc ℚ) γ').map (algebraMap (RatFunc ℚ) L)) := by
      rw [IntermediateField.minpoly_gen, hminF, Polynomial.map_map,
        ← IsScalarTower.algebraMap_eq ℚ (RatFunc ℚ) L]
      exact irreducible_map_of_algClosure_eq_bot hreg (minpoly.monic hγint)
        (minpoly.irreducible hγint)
    have hfieldLC : IsField (L ⊗[RatFunc ℚ] ↥C) :=
      isField_tensor_of_primitive_irreducible (K := L) (↥C) γ' hγ'top hirr
    have hfieldCL : IsField (↥C ⊗[RatFunc ℚ] L) :=
      (Algebra.TensorProduct.comm (RatFunc ℚ) (↥C) L).toMulEquiv.isField hfieldLC
    have hLDC : C.toSubalgebra.LinearDisjoint fb.range := by
      have h := Subalgebra.LinearDisjoint.of_isField' hfieldCL C.val fb C.val.injective hfb
      rwa [IntermediateField.range_val] at h
    exact hLDC.of_le_left_of_flat hAC
  haveI : IsDomain (FractionRing (Polynomial (AlgebraicClosure ℚ)) ⊗[RatFunc ℚ] L) :=
    Subalgebra.LinearDisjoint.isDomain_of_injective hfa hfb hLD
  exact Algebra.TensorProduct.isField_of_isAlgebraic (RatFunc ℚ)
    (FractionRing (Polynomial (AlgebraicClosure ℚ))) L (Or.inr algL)

/-- **Absolute irreducibility from regularity** (the form consumed by the model translation).
If `L / ℚ(T)` is a finite extension, regular (`algebraicClosure ℚ L = ⊥`), generated by `β` whose
`ℚ(T)`-minimal polynomial is the base change of `F ∈ ℚ[T][X]`, then `F` stays irreducible after base
change to the geometric field `ℚ̄(T)` (along `toClosureFrac`). -/
theorem irreducible_map_toClosureFrac_of_regular
    {L : Type*} [Field L] [Algebra (RatFunc ℚ) L] [FiniteDimensional (RatFunc ℚ) L]
    [Algebra ℚ L] [IsScalarTower ℚ (RatFunc ℚ) L]
    (hreg : algebraicClosure ℚ L = ⊥)
    (β : L) (hβtop : IntermediateField.adjoin (RatFunc ℚ) {β} = ⊤)
    (F : ℚ[X][X]) (hFmap : minpoly (RatFunc ℚ) β = F.map (algebraMap ℚ[X] (RatFunc ℚ))) :
    Irreducible (F.map toClosureFrac) := by
  have hfield : IsField (FractionRing (Polynomial (AlgebraicClosure ℚ)) ⊗[RatFunc ℚ] L) :=
    isField_baseChange_of_regular hreg
  have htrans := irreducible_map_minpoly_of_isField_baseChange
    (K := RatFunc ℚ) (K' := FractionRing (Polynomial (AlgebraicClosure ℚ))) β hβtop hfield
  rw [hFmap, Polynomial.map_map] at htrans
  have hcomp : (algebraMap (RatFunc ℚ) (FractionRing (Polynomial (AlgebraicClosure ℚ)))).comp
      (algebraMap ℚ[X] (RatFunc ℚ)) = toClosureFrac :=
    RingHom.ext algebraMap_ratFunc_geom_comp
  rwa [hcomp] at htrans

