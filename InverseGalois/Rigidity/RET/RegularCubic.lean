import Mathlib
import InverseGalois.Core.InstanceShortcuts
import InverseGalois.Rigidity.RET.GeometricIrreducibility
import InverseGalois.Rigidity.RET.RegularCriterion
import InverseGalois.Rigidity.RET.Specialization

/-!
# A regular cyclic cubic: Shanks' simplest cubic

`ℚ(T)(√T)` realizes the two-element group regularly (`RegularQuadratic`).  The next group,
cyclic of order three, needs a genuinely non-abelian-looking input: a cyclic cubic extension of
`ℚ(T)` cannot be generated by a radical, because `ℚ(T)` has no cube root of unity.  Shanks'
*simplest cubic*

`X³ - T X² - (T + 3) X - 1`

supplies one.  Its distinguishing feature is that its three roots are **rational functions of one
another**: if `β` is a root, so are `-(β+1)⁻¹` and `-(β+1)/β`, the orbit of `β` under the
order-three Möbius transformation `z ↦ -1/(z+1)`.  A single root therefore generates a splitting
field, which is consequently Galois of degree three, hence cyclic of order three.

Regularity — no new constants — is the same polynomial read over `ℚ̄(T)`, and here the
irreducibility argument is uniform in the coefficient field: the cubic is of **degree one in `T`**,
with coefficients `-(T² + T)` and `T³ - 3T - 1` that are coprime in `k[T]` (an explicit Bézout
identity), so after exchanging the two variables it is a primitive linear polynomial, hence
irreducible over `k[T][X]` for every field `k`, and over every fraction field of `k[T]` by Gauss's
lemma.

## Main results

* `Rigidity.RET.shanksBase` — the polynomial `X³ - T X² - (T+3) X - 1` over `k[T]`, with its
  irreducibility over `k[T][X]` and over every fraction field of `k[T]`.
* `Rigidity.RET.isRegularInverseGalois_of_card_eq_three` — every group of order three is a regular
  inverse Galois group.
* `Rigidity.RET.isInverseGalois_of_card_eq_three` — every group of order three is a Galois group
  over `ℚ`.
-/

open Polynomial

noncomputable section

namespace Rigidity.RET

/-! ### The polynomial and its irreducibility over any coefficient field -/

/-- **Shanks' simplest cubic** `X³ - T X² - (T + 3) X - 1`, over the coefficient ring `k[T]`. -/
def shanksBase (k : Type*) [Field k] : k[X][X] :=
  X ^ 3 - C Polynomial.X * X ^ 2 - C (Polynomial.X + 3) * X - 1

theorem shanksBase_def (k : Type*) [Field k] :
    shanksBase k = X ^ 3 - C Polynomial.X * X ^ 2 - C (Polynomial.X + 3) * X - 1 := rfl

variable (k : Type*) [Field k]

theorem shanksBase_monic : (shanksBase k).Monic := by
  unfold shanksBase
  monicity!

theorem shanksBase_natDegree : (shanksBase k).natDegree = 3 := by
  unfold shanksBase
  compute_degree!

/-- **Exchanging the two variables** turns the cubic into a polynomial of degree one in the
unknown: the cubic is linear in `T`. -/
theorem swap_shanksBase :
    Polynomial.Bivariate.swap (shanksBase k) =
      C (-(Polynomial.X ^ 2 + Polynomial.X)) * X
        + C (Polynomial.X ^ 3 - 3 * Polynomial.X - 1) := by
  have h3 : (3 : k[X]) = C (3 : k) := (map_ofNat Polynomial.C 3).symm
  simp only [shanksBase, map_sub, map_mul, map_pow, map_add, map_one, map_neg, h3,
    Polynomial.Bivariate.swap_X, Polynomial.Bivariate.swap_Y, Polynomial.Bivariate.swap_C_C]
  ring

/-- A linear polynomial whose two coefficients admit a Bézout identity is primitive. -/
theorem isPrimitive_linear {A : Type*} [CommRing A] {a b u v : A} (h : u * a + v * b = 1) :
    (C a * X + C b : A[X]).IsPrimitive := by
  intro r hr
  rw [Polynomial.C_dvd_iff_dvd_coeff] at hr
  have ha : r ∣ a := by simpa using hr 1
  have hb : r ∣ b := by simpa using hr 0
  refine isUnit_of_dvd_one ?_
  rw [← h]
  exact dvd_add (ha.mul_left u) (hb.mul_left v)

/-- **The two coefficients of the exchanged cubic are coprime**: an explicit Bézout identity.  It
is the Euclidean algorithm run once, `(T³ - 3T - 1) - (T² + T)(T - 1) = -2T - 1`, followed by
`(-2T - 1)² - 4(T² + T) = 1`. -/
theorem shanks_bezout :
    (4 - (Polynomial.X ^ 2 + Polynomial.X : k[X]) * (Polynomial.X - 1) ^ 2)
        * (-(Polynomial.X ^ 2 + Polynomial.X))
      + ((Polynomial.X ^ 3 - 3 * Polynomial.X - 1)
        - 2 * (Polynomial.X ^ 2 + Polynomial.X) * (Polynomial.X - 1))
        * (Polynomial.X ^ 3 - 3 * Polynomial.X - 1) = 1 := by
  ring

theorem shanks_leadingCoeff_ne_zero : (-(Polynomial.X ^ 2 + Polynomial.X) : k[X]) ≠ 0 := by
  intro h
  have := congrArg (fun p => Polynomial.coeff p 2) h
  simp [Polynomial.coeff_X] at this

theorem irreducible_swap_shanksBase :
    Irreducible (Polynomial.Bivariate.swap (shanksBase k)) := by
  rw [swap_shanksBase]
  have hprim := isPrimitive_linear (shanks_bezout k)
  rw [hprim.irreducible_iff_irreducible_map_fraction_map (K := RatFunc k)]
  refine irreducible_of_degree_eq_one ?_
  rw [Polynomial.map_add, Polynomial.map_mul, Polynomial.map_C, Polynomial.map_C,
    Polynomial.map_X]
  exact Polynomial.degree_linear
    (fun h => shanks_leadingCoeff_ne_zero k ((injective_iff_map_eq_zero _).mp
      (IsFractionRing.injective (k[X]) (RatFunc k)) _ h))

/-- **The cubic is irreducible over `k[T]`**, for every field `k`. -/
theorem irreducible_shanksBase : Irreducible (shanksBase k) :=
  (MulEquiv.irreducible_iff (Polynomial.Bivariate.swap (R := k)).toRingEquiv).mp
    (irreducible_swap_shanksBase k)

/-- **The cubic stays irreducible over every fraction field of `k[T]`** (Gauss's lemma, the cubic
being monic). -/
theorem irreducible_shanksBase_map (K : Type*) [Field K] [Algebra (k[X]) K]
    [IsFractionRing (k[X]) K] :
    Irreducible ((shanksBase k).map (algebraMap (k[X]) K)) :=
  ((shanksBase_monic k).irreducible_iff_irreducible_map_fraction_map).mp (irreducible_shanksBase k)

/-! ### The cubic over `ℚ(T)` -/

/-- Shanks' simplest cubic, over the function field `ℚ(T)`. -/
def shanksFib : (RatFunc ℚ)[X] :=
  X ^ 3 - C (RatFunc.X : RatFunc ℚ) * X ^ 2 - C (RatFunc.X + 3 : RatFunc ℚ) * X - 1

theorem shanksFib_def :
    shanksFib = X ^ 3 - C (RatFunc.X : RatFunc ℚ) * X ^ 2
      - C (RatFunc.X + 3 : RatFunc ℚ) * X - 1 := rfl

/-- The two presentations of the cubic agree. -/
theorem shanksBase_map_ratFunc :
    (shanksBase ℚ).map (algebraMap (Polynomial ℚ) (RatFunc ℚ)) = shanksFib := by
  simp [shanksBase, shanksFib, Polynomial.map_sub, Polynomial.map_mul, Polynomial.map_pow,
    RatFunc.algebraMap_X, map_ofNat]

theorem shanksFib_irreducible : Irreducible shanksFib := by
  rw [← shanksBase_map_ratFunc]
  exact irreducible_shanksBase_map ℚ (RatFunc ℚ)

theorem shanksFib_ne_zero : shanksFib ≠ 0 := shanksFib_irreducible.ne_zero

theorem shanksFib_monic : shanksFib.Monic := by
  rw [← shanksBase_map_ratFunc]
  exact (shanksBase_monic ℚ).map _

theorem shanksFib_natDegree : shanksFib.natDegree = 3 := by
  rw [← shanksBase_map_ratFunc, (shanksBase_monic ℚ).natDegree_map, shanksBase_natDegree]

theorem shanksFib_separable : shanksFib.Separable := shanksFib_irreducible.separable

instance : Fact (Irreducible shanksFib) := ⟨shanksFib_irreducible⟩

/-! ### The three roots -/

section Roots

variable {A : Type*} [Field A] {t β : A}

/-- A root of the cubic is nonzero. -/
theorem shanks_root_ne_zero (hβ : β ^ 3 - t * β ^ 2 - (t + 3) * β - 1 = 0) : β ≠ 0 := by
  rintro rfl
  exact one_ne_zero (α := A) (by linear_combination -hβ)

/-- A root of the cubic is not `-1`; equivalently the Möbius transformation `z ↦ -1/(z+1)` is
defined at it. -/
theorem shanks_root_add_one_ne_zero (hβ : β ^ 3 - t * β ^ 2 - (t + 3) * β - 1 = 0) :
    β + 1 ≠ 0 := by
  intro h
  have hb : β = -1 := by linear_combination h
  rw [hb] at hβ
  exact one_ne_zero (α := A) (by linear_combination hβ)

/-- The first elementary symmetric function of `β`, `-(β+1)⁻¹` and `-(β+1)/β`. -/
theorem shanks_esymm_one (hβ : β ^ 3 - t * β ^ 2 - (t + 3) * β - 1 = 0) :
    β + -(β + 1)⁻¹ + -((β + 1) / β) = t := by
  have h0 : β ≠ 0 := shanks_root_ne_zero hβ
  have h1 : β + 1 ≠ 0 := shanks_root_add_one_ne_zero hβ
  field_simp
  linear_combination hβ

/-- The second elementary symmetric function of `β`, `-(β+1)⁻¹` and `-(β+1)/β`. -/
theorem shanks_esymm_two (hβ : β ^ 3 - t * β ^ 2 - (t + 3) * β - 1 = 0) :
    β * -(β + 1)⁻¹ + β * -((β + 1) / β) + -(β + 1)⁻¹ * -((β + 1) / β) = -(t + 3) := by
  have h0 : β ≠ 0 := shanks_root_ne_zero hβ
  have h1 : β + 1 ≠ 0 := shanks_root_add_one_ne_zero hβ
  field_simp
  linear_combination -hβ

/-- The third elementary symmetric function of `β`, `-(β+1)⁻¹` and `-(β+1)/β`. -/
theorem shanks_esymm_three (hβ : β ^ 3 - t * β ^ 2 - (t + 3) * β - 1 = 0) :
    β * -(β + 1)⁻¹ * -((β + 1) / β) = 1 := by
  have h0 : β ≠ 0 := shanks_root_ne_zero hβ
  have h1 : β + 1 ≠ 0 := shanks_root_add_one_ne_zero hβ
  field_simp

end Roots

/-- A monic cubic whose elementary symmetric functions match factors into linear factors. -/
theorem cubic_factor_of_esymm {A : Type*} [CommRing A] {a b c t : A}
    (h1 : a + b + c = t) (h2 : a * b + a * c + b * c = -(t + 3)) (h3 : a * b * c = 1) :
    (X - C a) * (X - C b) * (X - C c)
      = X ^ 3 - C t * X ^ 2 - C (t + 3) * X - 1 := by
  have key : (X - C a) * (X - C b) * (X - C c)
      = X ^ 3 - C (a + b + c) * X ^ 2 + C (a * b + a * c + b * c) * X - C (a * b * c) := by
    simp only [map_add, map_mul]
    ring
  rw [key, h1, h2, h3, map_neg, map_one]
  ring

/-! ### The splitting field `ℚ(T)(β)` -/

/-- The distinguished root of Shanks' cubic. -/
def shanksRoot : AdjoinRoot shanksFib := AdjoinRoot.root shanksFib

theorem shanksRoot_def : shanksRoot = AdjoinRoot.root shanksFib := rfl

/-- The parameter `T`, read inside the cubic extension. -/
def shanksT : AdjoinRoot shanksFib :=
  algebraMap (RatFunc ℚ) (AdjoinRoot shanksFib) RatFunc.X

theorem shanksT_def :
    shanksT = algebraMap (RatFunc ℚ) (AdjoinRoot shanksFib) RatFunc.X := rfl

/-- The defining equation of the distinguished root. -/
theorem shanksRoot_eq :
    shanksRoot ^ 3 - shanksT * shanksRoot ^ 2 - (shanksT + 3) * shanksRoot - 1 = 0 := by
  have h : (aeval shanksRoot) (X ^ 3 - C (RatFunc.X : RatFunc ℚ) * X ^ 2
      - C (RatFunc.X + 3 : RatFunc ℚ) * X - 1) = 0 := by
    rw [shanksRoot_def, AdjoinRoot.aeval_eq]
    exact AdjoinRoot.mk_self
  simpa [shanksT_def, map_add, map_ofNat] using h

/-- **The cubic splits in `ℚ(T)(β)`**: the other two roots are the images of `β` under the
order-three Möbius transformation `z ↦ -1/(z+1)`. -/
theorem shanksFib_map_eq :
    shanksFib.map (algebraMap (RatFunc ℚ) (AdjoinRoot shanksFib))
      = (X - C shanksRoot) * (X - C (-(shanksRoot + 1)⁻¹))
        * (X - C (-((shanksRoot + 1) / shanksRoot))) := by
  rw [cubic_factor_of_esymm (shanks_esymm_one shanksRoot_eq) (shanks_esymm_two shanksRoot_eq)
    (shanks_esymm_three shanksRoot_eq)]
  simp [shanksFib_def, Polynomial.map_sub, Polynomial.map_mul, Polynomial.map_pow, shanksT_def,
    map_add, map_ofNat]

instance : IsSplittingField (RatFunc ℚ) (AdjoinRoot shanksFib) shanksFib := by
  refine ⟨?_, ?_⟩
  · rw [shanksFib_map_eq]
    exact ((Polynomial.Splits.X_sub_C shanksRoot).mul
      (Polynomial.Splits.X_sub_C _)).mul (Polynomial.Splits.X_sub_C _)
  · refine top_le_iff.mp ?_
    rw [← AdjoinRoot.adjoinRoot_eq_top (f := shanksFib)]
    refine Algebra.adjoin_mono ?_
    rw [Set.singleton_subset_iff, Polynomial.mem_rootSet]
    refine ⟨shanksFib_ne_zero, ?_⟩
    rw [AdjoinRoot.aeval_eq]
    exact AdjoinRoot.mk_self

instance : FiniteDimensional (RatFunc ℚ) (AdjoinRoot shanksFib) :=
  (AdjoinRoot.powerBasis shanksFib_ne_zero).finite

instance : IsGalois (RatFunc ℚ) (AdjoinRoot shanksFib) :=
  IsGalois.of_separable_splitting_field shanksFib_separable

theorem finrank_adjoinRoot_shanksFib :
    Module.finrank (RatFunc ℚ) (AdjoinRoot shanksFib) = 3 := by
  rw [(AdjoinRoot.powerBasis shanksFib_ne_zero).finrank, AdjoinRoot.powerBasis_dim,
    shanksFib_natDegree]

theorem card_aut_shanksFib :
    Nat.card (AdjoinRoot shanksFib ≃ₐ[RatFunc ℚ] AdjoinRoot shanksFib) = 3 := by
  rw [IsGalois.card_aut_eq_finrank, finrank_adjoinRoot_shanksFib]

theorem minpoly_shanksRoot : minpoly (RatFunc ℚ) shanksRoot = shanksFib := by
  rw [shanksRoot_def, AdjoinRoot.minpoly_root shanksFib_ne_zero, shanksFib_monic.leadingCoeff,
    inv_one, map_one, mul_one]

theorem adjoin_shanksRoot_eq_top :
    IntermediateField.adjoin (RatFunc ℚ) {shanksRoot} = ⊤ := by
  refine IntermediateField.toSubalgebra_injective ?_
  rw [IntermediateField.adjoin_simple_toSubalgebra_of_isAlgebraic
      (show IsAlgebraic (RatFunc ℚ) shanksRoot from
        (AdjoinRoot.isIntegral_root shanksFib_ne_zero).isAlgebraic),
    IntermediateField.top_toSubalgebra, shanksRoot_def]
  exact AdjoinRoot.adjoinRoot_eq_top

/-! ### Regularity and the realization -/

/-- Base change of the cubic to `ℚ̄` is the cubic over `ℚ̄`. -/
theorem shanksBase_map_closure :
    (shanksBase ℚ).map (mapRingHom (algebraMap ℚ (AlgebraicClosure ℚ)))
      = shanksBase (AlgebraicClosure ℚ) := by
  simp [shanksBase, Polynomial.map_sub, Polynomial.map_mul, Polynomial.map_pow]

/-- **The cubic stays irreducible over `ℚ̄(T)`**: being of degree one in `T` with coprime
coefficients is a statement about the coefficient field only. -/
theorem shanksBase_irreducible_map_toClosureFrac :
    Irreducible ((shanksBase ℚ).map toClosureFrac) := by
  rw [toClosureFrac, ← Polynomial.map_map, shanksBase_map_closure]
  exact irreducible_shanksBase_map (AlgebraicClosure ℚ)
    (FractionRing (Polynomial (AlgebraicClosure ℚ)))

/-- **Every group of order three is a regular inverse Galois group**, realized by the splitting
field of Shanks' simplest cubic. -/
theorem isRegularInverseGalois_of_card_eq_three {G : Type*} [Group G] (hG : Nat.card G = 3) :
    IsRegularInverseGalois G := by
  haveI : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  haveI : IsCyclic G := isCyclic_of_prime_card hG
  haveI : IsCyclic (AdjoinRoot shanksFib ≃ₐ[RatFunc ℚ] AdjoinRoot shanksFib) :=
    isCyclic_of_prime_card card_aut_shanksFib
  exact IsRegularInverseGalois.of_primitive_irreducible (AdjoinRoot shanksFib) shanksRoot
    adjoin_shanksRoot_eq_top (shanksBase ℚ)
    (by rw [minpoly_shanksRoot, shanksBase_map_ratFunc])
    shanksBase_irreducible_map_toClosureFrac
    (mulEquivOfCyclicCardEq (by rw [card_aut_shanksFib, hG]))

/-- **Every group of order three occurs as a Galois group over `ℚ`.**  Specializing `T` in the
regular extension gives, concretely, the cyclic cubic fields of Shanks. -/
theorem isInverseGalois_of_card_eq_three {G : Type} [Group G] (hG : Nat.card G = 3) :
    IsInverseGalois G :=
  haveI : Finite G := Nat.finite_of_card_ne_zero (by rw [hG]; norm_num)
  (isRegularInverseGalois_of_card_eq_three hG).isInverseGalois

/-- The alternating group on three letters is a regular inverse Galois group. -/
theorem isRegularInverseGalois_alternating_fin_three :
    IsRegularInverseGalois (alternatingGroup (Fin 3)) := by
  refine isRegularInverseGalois_of_card_eq_three ?_
  rw [nat_card_alternatingGroup, Nat.card_eq_fintype_card, Fintype.card_fin]
  decide

end Rigidity.RET
