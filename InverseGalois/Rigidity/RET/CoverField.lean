import Mathlib
import InverseGalois.Rigidity.RET.Compositum
import InverseGalois.Rigidity.RET.SubcoverBranch

/-!
# The maximal cover of the line unramified outside a set of points

Fix a set `S` of points of the affine line over `ℚ̄`.  Inside one fixed algebraic closure of the line
one can collect all the finite Galois covers which are unramified outside `S` and at infinity: each
of them is a finite subextension of the closure, and the compositum of two of them is again one of
them, so the subfields they cut out form a directed family.  Their union is therefore a field, the
**cover field** `coverField S`.  It is the function field of the universal cover of the line
punctured at `S`, and its automorphism group is the geometric fundamental group of that punctured
line.

Two properties make the cover field usable.  It is *directed*: a point of it, and more generally any
finite subextension of it, already lies in a single finite cover.  And it is *Galois* over the line,
being generated by Galois subextensions.

## Main definitions

* `Rigidity.RET.IsCoverFieldOver` — an intermediate field of the closure of the line which is the
  function field of a cover unramified outside `S` and at infinity.
* `Rigidity.RET.coverField` — the compositum of all of them.

## Main results

* `Rigidity.RET.IsCoverFieldOver.sup` — the compositum of two cover fields is a cover field.
* `Rigidity.RET.mem_coverField_iff` — an element of the cover field lies in a single cover field.
* `Rigidity.RET.exists_isCoverFieldOver_of_le` — a finite subextension of the cover field is
  contained in a single cover field.
* `Rigidity.RET.instIsGaloisCoverField` — the cover field is Galois over the line.
-/

open Polynomial IntermediateField

noncomputable section


namespace Rigidity.RET

open GeomAKLB

attribute [local instance] GeomAKLB.instMSA GeomAKLB.instIntegral GeomAKLB.instIsFrac
  GeomAKLB.instIGG GeomAKLB.instFinite GeomAKLB.instDedekindB GeomAKLB.instTorsionFree
  GeomAKLB.instFaithful

/-! ### Cover fields -/

/-- A **cover field over `S`** is an intermediate field of the algebraic closure of the line which
is the function field of a finite Galois cover of the line unramified outside `S` and at
infinity. -/
def IsCoverFieldOver (S : Set k) (E : IntermediateField (RatFunc k) LineCover.closure) : Prop :=
  ∃ L : LineCover, Nonempty (L.M ≃ₐ[RatFunc k] (E : Type)) ∧
    L.IsUnramifiedOutside S ∧ L.IsUnramifiedAtInfinity

namespace IsCoverFieldOver

variable {S S' : Set k} {E E₁ E₂ : IntermediateField (RatFunc k) LineCover.closure}

/-- A cover field is a finite extension of the line. -/
theorem finiteDimensional (h : IsCoverFieldOver S E) :
    FiniteDimensional (RatFunc k) (E : Type) := by
  obtain ⟨L, ⟨e⟩, -, -⟩ := h
  exact LinearEquiv.finiteDimensional e.toLinearEquiv

/-- A cover field is a Galois extension of the line. -/
theorem isGalois (h : IsCoverFieldOver S E) : IsGalois (RatFunc k) (E : Type) := by
  obtain ⟨L, ⟨e⟩, -, -⟩ := h
  exact IsGalois.of_algEquiv e

/-- A cover field is a normal extension of the line. -/
theorem normal (h : IsCoverFieldOver S E) : Normal (RatFunc k) (E : Type) :=
  haveI := h.isGalois
  inferInstance

/-- Allowing more branch points allows more cover fields. -/
theorem mono (h : IsCoverFieldOver S E) (hS : S ⊆ S') : IsCoverFieldOver S' E := by
  obtain ⟨L, he, hout, hinf⟩ := h
  exact ⟨L, he, hout.mono hS, hinf⟩

/-- **The compositum of two cover fields is a cover field.**  Inside the compositum the two cover
fields are normal subcovers which generate it, so the compositum lemma applies. -/
theorem sup (h₁ : IsCoverFieldOver S E₁) (h₂ : IsCoverFieldOver S E₂) :
    IsCoverFieldOver S (E₁ ⊔ E₂) := by
  obtain ⟨L₁, ⟨e₁⟩, hout₁, hinf₁⟩ := h₁
  obtain ⟨L₂, ⟨e₂⟩, hout₂, hinf₂⟩ := h₂
  haveI : FiniteDimensional (RatFunc k) (E₁ : Type) :=
    LinearEquiv.finiteDimensional e₁.toLinearEquiv
  haveI : FiniteDimensional (RatFunc k) (E₂ : Type) :=
    LinearEquiv.finiteDimensional e₂.toLinearEquiv
  haveI : IsGalois (RatFunc k) (E₁ : Type) := IsGalois.of_algEquiv e₁
  haveI : IsGalois (RatFunc k) (E₂ : Type) := IsGalois.of_algEquiv e₂
  have hle₁ : E₁ ≤ E₁ ⊔ E₂ := le_sup_left
  have hle₂ : E₂ ≤ E₁ ⊔ E₂ := le_sup_right
  haveI := Normal.of_algEquiv (IntermediateField.restrict_algEquiv hle₁)
  haveI := Normal.of_algEquiv (IntermediateField.restrict_algEquiv hle₂)
  have htop : IntermediateField.restrict hle₁ ⊔ IntermediateField.restrict hle₂ = ⊤ := by
    refine IntermediateField.lift_injective (E₁ ⊔ E₂) ?_
    rw [IntermediateField.lift_sup, IntermediateField.lift_restrict,
      IntermediateField.lift_restrict, IntermediateField.lift_top]
  refine ⟨LineCover.of ((E₁ ⊔ E₂ : IntermediateField (RatFunc k) LineCover.closure) : Type),
    ⟨AlgEquiv.refl⟩, ?_, ?_⟩
  · rw [← Set.union_self S]
    refine LineCover.IsUnramifiedOutside.of_sup (A := IntermediateField.restrict hle₁)
      (B := IntermediateField.restrict hle₂) htop ?_ ?_
    · exact LineCover.IsUnramifiedOutside.transport
        (e₁.trans (IntermediateField.restrict_algEquiv hle₁)) hout₁
    · exact LineCover.IsUnramifiedOutside.transport
        (e₂.trans (IntermediateField.restrict_algEquiv hle₂)) hout₂
  · refine LineCover.IsUnramifiedAtInfinity.of_sup (A := IntermediateField.restrict hle₁)
      (B := IntermediateField.restrict hle₂) htop ?_ ?_
    · exact LineCover.IsUnramifiedAtInfinity.transport
        (e₁.trans (IntermediateField.restrict_algEquiv hle₁)) hinf₁
    · exact LineCover.IsUnramifiedAtInfinity.transport
        (e₂.trans (IntermediateField.restrict_algEquiv hle₂)) hinf₂

end IsCoverFieldOver

/-- The line itself is a cover field over every set of points. -/
theorem isCoverFieldOver_bot (S : Set k) :
    IsCoverFieldOver S (⊥ : IntermediateField (RatFunc k) LineCover.closure) :=
  ⟨trivialCover, ⟨(IntermediateField.botEquiv (RatFunc k) LineCover.closure).symm⟩,
    trivialCover_isUnramifiedOutside S, trivialCover_isUnramifiedAtInfinity⟩

instance instNonemptyCoverFieldSubtype (S : Set k) :
    Nonempty {E : IntermediateField (RatFunc k) LineCover.closure // IsCoverFieldOver S E} :=
  ⟨⟨⊥, isCoverFieldOver_bot S⟩⟩

/-- **The cover field over `S`**: the compositum, inside a fixed algebraic closure of the line, of
every cover of the line unramified outside `S` and at infinity. -/
def coverField (S : Set k) : IntermediateField (RatFunc k) LineCover.closure :=
  ⨆ E : {E : IntermediateField (RatFunc k) LineCover.closure // IsCoverFieldOver S E},
    (E : IntermediateField (RatFunc k) LineCover.closure)

/-- Every cover field over `S` sits inside the cover field over `S`. -/
theorem IsCoverFieldOver.le_coverField {S : Set k}
    {E : IntermediateField (RatFunc k) LineCover.closure} (h : IsCoverFieldOver S E) :
    E ≤ coverField S :=
  le_iSup (fun E : {E : IntermediateField (RatFunc k) LineCover.closure // IsCoverFieldOver S E} =>
    (E : IntermediateField (RatFunc k) LineCover.closure)) ⟨E, h⟩

/-- **The cover fields over `S` form a directed family**, because the compositum of two of them is
again one of them. -/
theorem directed_coverField (S : Set k) :
    Directed (· ≤ ·)
      (fun E : {E : IntermediateField (RatFunc k) LineCover.closure // IsCoverFieldOver S E} =>
        (E : IntermediateField (RatFunc k) LineCover.closure)) :=
  fun E₁ E₂ => ⟨⟨(E₁ : IntermediateField (RatFunc k) LineCover.closure) ⊔ (E₂ : _),
    E₁.2.sup E₂.2⟩, le_sup_left, le_sup_right⟩

/-- **An element of the cover field already lies in a single finite cover.** -/
theorem mem_coverField_iff {S : Set k} {x : LineCover.closure} :
    x ∈ coverField S ↔ ∃ E, IsCoverFieldOver S E ∧ x ∈ E := by
  rw [coverField, ← SetLike.mem_coe,
    IntermediateField.coe_iSup_of_directed (directed_coverField S), Set.mem_iUnion]
  exact ⟨fun ⟨E, hx⟩ => ⟨E.1, E.2, hx⟩, fun ⟨E, hE, hx⟩ => ⟨⟨E, hE⟩, hx⟩⟩

instance instIsGaloisCoverField (S : Set k) : IsGalois (RatFunc k) (coverField S : Type) := by
  haveI : ∀ E : {E : IntermediateField (RatFunc k) LineCover.closure // IsCoverFieldOver S E},
      IsGalois (RatFunc k) ((E : IntermediateField (RatFunc k) LineCover.closure) : Type) :=
    fun E => E.2.isGalois
  haveI : ∀ E : {E : IntermediateField (RatFunc k) LineCover.closure // IsCoverFieldOver S E},
      Normal (RatFunc k) ((E : IntermediateField (RatFunc k) LineCover.closure) : Type) :=
    fun E => E.2.normal
  rw [coverField]
  exact ⟨⟩

/-- **A finite subextension of the cover field lies in a single finite cover.**  A finite
subextension is generated by a primitive element, and that single element already lies in a finite
cover. -/
theorem exists_isCoverFieldOver_of_le {S : Set k}
    (F : IntermediateField (RatFunc k) LineCover.closure) [FiniteDimensional (RatFunc k) (F : Type)]
    (hF : F ≤ coverField S) : ∃ E, IsCoverFieldOver S E ∧ F ≤ E := by
  obtain ⟨α, hα⟩ := Field.exists_primitive_element (RatFunc k) (F : Type)
  obtain ⟨E, hE, hxE⟩ := mem_coverField_iff.mp (hF α.2)
  refine ⟨E, hE, ?_⟩
  have hFeq : F = IntermediateField.adjoin (RatFunc k) {(α : LineCover.closure)} := by
    rw [← IntermediateField.lift_adjoin_simple (RatFunc k) F α, hα, IntermediateField.lift_top]
  rw [hFeq]
  exact IntermediateField.adjoin_simple_le_iff.mpr hxE

end Rigidity.RET
