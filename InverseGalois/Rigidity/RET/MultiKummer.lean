import Mathlib
import InverseGalois.Rigidity.RET.KummerInertia
import InverseGalois.Rigidity.RET.KummerAbelian

/-!
# The multi-point Kummer cover of the line

For distinct points `t₁, …, t_r` of `ℚ̄` and exponents `a₁, …, a_r`, the equation

`wⁿ = ∏ᵢ (T - tᵢ)^{aᵢ}`

cuts out a cyclic cover of the line branched inside `{t₁, …, t_r}` (and possibly at infinity).
This module builds that cover: irreducibility of the equation, and — in `MultiKummerInertia` —
the exact inertia group at each branch point.

Irreducibility is Kummer duality rather than Eisenstein: the degree of the splitting field is
bounded above by `n` because the field is generated by one `n`-th root, and below by `n` because
the Kummer monodromy homomorphism onto `μₙ` is surjective, surjectivity coming from the
independence of the linear polynomials `T - tᵢ` modulo `n`-th powers.  This route works for every
`n`, whereas Mathlib's irreducibility criteria for `Xⁿ - a` are restricted to odd `n`.

## Main definitions

* `Rigidity.RET.multiA` — the datum `∏ᵢ (X - tᵢ)^{aᵢ}`.

## Main results

* `Rigidity.RET.irreducible_X_pow_sub_C_of_forall_isPow` — irreducibility of `Xⁿ - b` over a field
  with the `n`-th roots of unity, from the independence of `b` modulo `n`-th powers.
* `Rigidity.RET.irreducible_multiA` — irreducibility of the multi-point Kummer polynomial.
* `Rigidity.RET.isUnramifiedOutside_multiCover` — the multi-point Kummer cover is unramified
  outside the `tᵢ`.
-/

open Polynomial IntermediateField

noncomputable section


namespace Rigidity.RET

open GeomAKLB

/-! ### Irreducibility of `Xⁿ - b` by Kummer duality -/

section GeneralKummer

variable {K : Type} [Field K] [CharZero K]

/-- **Irreducibility of `Xⁿ - b` from independence modulo `n`-th powers.**

If no power `b^e` with `0 < e < n` is an `n`-th power in `K`, and `K` contains a primitive `n`-th
root of unity, then `Xⁿ - b` is irreducible: the splitting field is generated by a single `n`-th
root `w` of `b`, so has degree at most `n`, while Kummer duality makes the monodromy map from its
Galois group onto the `n`-th roots of unity surjective, forcing the degree to be exactly `n`. -/
theorem irreducible_X_pow_sub_C_of_forall_isPow {n : ℕ} [NeZero n] {ζ : K}
    (hζ : IsPrimitiveRoot ζ n) {b : K} (hb : b ≠ 0)
    (hind : ∀ e : ℕ, e < n → (∃ c : K, b ^ e = c ^ n) → e = 0)
    (L : Type) [Field L] [Algebra K L] [IsSplittingField K L (X ^ n - C b)] :
    Irreducible ((X : K[X]) ^ n - C b) := by
  have hsep : ((X : K[X]) ^ n - C b).Separable :=
    separable_X_pow_sub_C b (Nat.cast_ne_zero.mpr (NeZero.ne n)) hb
  haveI : FiniteDimensional K L := IsSplittingField.finiteDimensional L ((X : K[X]) ^ n - C b)
  haveI : IsGalois K L := IsGalois.of_separable_splitting_field hsep
  have hζL : IsPrimitiveRoot (algebraMap K L ζ) n :=
    hζ.map_of_injective (algebraMap K L).injective
  set w : L := kummerRoot n b L with hwdef
  have hwpow : w ^ n = algebraMap K L b := kummerRoot_pow L
  have hw0 : w ≠ 0 := by
    intro h
    rw [h, zero_pow (NeZero.ne n)] at hwpow
    exact hb ((map_eq_zero_iff _ (algebraMap K L).injective).mp hwpow.symm)
  -- every root of the equation is a root of unity times `w`, so the splitting field is `K⟮w⟯`
  have hgen : IntermediateField.adjoin K {w} = ⊤ := by
    have hsub : ((X : K[X]) ^ n - C b).rootSet L ⊆ ((K⟮w⟯).toSubalgebra : Set L) := by
      intro z hz
      have hz2 : (aeval z) ((X : K[X]) ^ n - C b) = 0 := (mem_rootSet.mp hz).2
      simp only [map_sub, map_pow, aeval_X, aeval_C, sub_eq_zero] at hz2
      have hratio : (z / w) ^ n = 1 := by
        rw [div_pow, hz2, hwpow, div_self ((map_ne_zero_iff _ (algebraMap K L).injective).mpr hb)]
      obtain ⟨i, -, hi⟩ := hζL.eq_pow_of_pow_eq_one hratio
      have hzeq : z = algebraMap K L (ζ ^ i) * w := by
        rw [map_pow, hi, div_mul_cancel₀ _ hw0]
      rw [hzeq]
      exact mul_mem (IntermediateField.algebraMap_mem _ _)
        (IntermediateField.mem_adjoin_simple_self K w)
    have h1 : Algebra.adjoin K (((X : K[X]) ^ n - C b).rootSet L) ≤ (K⟮w⟯).toSubalgebra :=
      Algebra.adjoin_le hsub
    rw [IsSplittingField.adjoin_rootSet L ((X : K[X]) ^ n - C b)] at h1
    exact eq_top_iff.mpr fun x _ => h1 (Algebra.mem_top)
  -- hence the degree is at most `n`
  have hint : IsIntegral K w := IsIntegral.of_finite K w
  have hfr_le : Module.finrank K L ≤ n := by
    have h1 : Module.finrank K K⟮w⟯ = (minpoly K w).natDegree :=
      IntermediateField.adjoin.finrank hint
    have haeval : (aeval w) ((X : K[X]) ^ n - C b) = 0 := by
      simp only [map_sub, map_pow, aeval_X, aeval_C, hwpow, sub_self]
    have h2 : (minpoly K w).natDegree ≤ n := by
      have := natDegree_le_of_dvd (minpoly.dvd K w haeval) (X_pow_sub_C_ne_zero (NeZero.pos n) b)
      rwa [natDegree_X_pow_sub_C] at this
    have h3 : Module.finrank K L = Module.finrank K K⟮w⟯ := by
      rw [hgen]; exact (IntermediateField.finrank_top' (F := K) (E := L)).symm
    omega
  -- and at least `n`, by Kummer duality
  have hsurj : Function.Surjective
      (kummerHom (ι := Unit) (y := fun _ => w) (b := fun _ => b) hζ (fun _ => hb)
        (fun _ => hwpow)) := by
    refine kummerHom_surjective hζ (fun _ => hb) (fun _ => hwpow) ?_
    intro e he hex i
    refine hind (e i) (he i) ?_
    obtain ⟨c, hc⟩ := hex
    exact ⟨c, by simpa using hc⟩
  have hge : n ≤ Module.finrank K L := by
    have h1 := Nat.card_le_card_of_surjective _ hsurj
    have h2 : Nat.card (Unit → rootsOfUnity n L) = n := by
      rw [Nat.card_congr (Equiv.funUnique Unit (rootsOfUnity n L)), Nat.card_eq_fintype_card,
        hζL.card_rootsOfUnity]
    rw [h2] at h1
    have h3 : Nat.card (L ≃ₐ[K] L) = Module.finrank K L := by
      simpa using IsGalois.card_aut_eq_finrank K L
    omega
  have hfr : Module.finrank K L = n := le_antisymm hfr_le hge
  have hres := irreducible_X_pow_sub_C_of_root_adjoin_eq_top (K := K) (L := L) (a := b) (α := w)
    (by rw [hfr]; exact hwpow) hgen
  rwa [hfr] at hres

end GeneralKummer

/-! ### The multi-point datum -/

section MultiPoint

variable {r : ℕ}

/-- The datum of the multi-point Kummer cover: `wⁿ = ∏ᵢ (X - tᵢ)^{aᵢ}`. -/
def multiA (t : Fin r → k) (a : Fin r → ℕ) : Polynomial k := ∏ i, (X - C (t i)) ^ a i

theorem multiA_ne_zero (t : Fin r → k) (a : Fin r → ℕ) : multiA t a ≠ 0 :=
  Finset.prod_ne_zero_iff.mpr fun i _ => pow_ne_zero _ (X_sub_C_ne_zero (t i))

theorem multiA_eval {t : Fin r → k} {a : Fin r → ℕ} {s : k} (hs : ∀ i, s ≠ t i) :
    (multiA t a).eval s ≠ 0 := by
  simp only [multiA, eval_prod, eval_pow, eval_sub, eval_X, eval_C]
  exact Finset.prod_ne_zero_iff.mpr fun i _ => pow_ne_zero _ (sub_ne_zero.mpr (hs i))

/-- The powers of the datum, read in the rational function field. -/
theorem multiA_map_pow (t : Fin r → k) (a : Fin r → ℕ) (e : ℕ) :
    (algebraMap (Polynomial k) (RatFunc k) (multiA t a)) ^ e
      = ∏ i, (RatFunc.X - RatFunc.C (t i)) ^ (a i * e) := by
  rw [multiA, map_prod, ← Finset.prod_pow]
  refine Finset.prod_congr rfl fun i _ => ?_
  rw [map_pow, map_sub, RatFunc.algebraMap_X, RatFunc.algebraMap_C, ← pow_mul]

/-- **The multi-point Kummer polynomial is irreducible over `ℚ̄(T)`** as soon as the exponents
`aᵢ` are jointly coprime to `n`. -/
theorem irreducible_multiA {n : ℕ} [NeZero n] {t : Fin r → k} (ht : Function.Injective t)
    {a : Fin r → ℕ} (hgen : ∀ e : ℕ, (∀ i, n ∣ a i * e) → n ∣ e)
    (L : Type) [Field L] [Algebra (RatFunc k) L]
    [IsSplittingField (RatFunc k) L
      (X ^ n - C (algebraMap (Polynomial k) (RatFunc k) (multiA t a)))] :
    Irreducible ((X : (RatFunc k)[X]) ^ n -
      C (algebraMap (Polynomial k) (RatFunc k) (multiA t a))) := by
  obtain ⟨ζ₀, hζ₀⟩ := exists_primitiveRoot_k n
  have hζ : IsPrimitiveRoot (algebraMap k (RatFunc k) ζ₀) n :=
    hζ₀.map_of_injective (algebraMap k (RatFunc k)).injective
  refine irreducible_X_pow_sub_C_of_forall_isPow hζ ?_ ?_ L
  · exact (map_ne_zero_iff _ (IsFractionRing.injective (Polynomial k) (RatFunc k))).mpr
      (multiA_ne_zero t a)
  · intro e he hex
    obtain ⟨c, hc⟩ := hex
    rw [multiA_map_pow] at hc
    have hdvd := dvd_of_prod_linear_isPow ht (fun i => a i * e) ⟨c, hc⟩
    exact Nat.eq_zero_of_dvd_of_lt (hgen e hdvd) he

/-- **The multi-point Kummer cover is unramified away from the points `tᵢ`.** -/
theorem isUnramifiedOutside_multiCover {n : ℕ} [NeZero n] {t : Fin r → k}
    (ht : Function.Injective t) {a : Fin r → ℕ} (hgen : ∀ e : ℕ, (∀ i, n ∣ a i * e) → n ∣ e)
    (L : LineCover) [IsSplittingField (RatFunc k) L.M
      ((X : (RatFunc k)[X]) ^ n -
        C (algebraMap (Polynomial k) (RatFunc k) (multiA t a)))] :
    L.IsUnramifiedOutside (Set.range t) := by
  obtain ⟨ζ₀, hζ₀⟩ := exists_primitiveRoot_k n
  rintro s hs σ ⟨Q, hQmax, hQover, hσ⟩
  haveI := hQmax
  haveI := hQover
  exact kummer_inertia_eq_one (Ω := L.M) (irreducible_multiA ht hgen L.M) hζ₀ Q
    (notMem_of_eval_ne_zero (multiA_eval fun i h => hs ⟨i, h.symm⟩) Q) hσ

end MultiPoint

end Rigidity.RET
