import InverseGalois.Rigidity.RET.ThreePoint

/-!
# Covers of coprime degree over a common branch locus

Two covers of the line whose degrees are coprime can be composed without moving their branch points
apart.  Coprimality replaces the disjointness of the two branch loci used elsewhere: a subcover of
both has degree dividing two coprime numbers, so it is the line itself, and the deck group of the
compositum is the product of the two deck groups.

The branch cycles survive the construction as well.  The inertia group of the compositum above a
point is cyclic and restricts onto the inertia groups of the two covers, so it is generated by a
pair whose coordinates generate them; coprimality of the orders then forces that pair to generate
the product of the two cyclic groups, and the prescribed pair of branch cycles is itself a
generator.  Hence a branch-cycle datum in `G₁` and one in `G₂` over the *same* points combine into
one in `G₁ × G₂` over those points, and in particular the finite groups occurring as monodromy over
three points are closed under direct products of coprime order.

## Main results

* `Rigidity.RET.zpowers_mk_eq_of_zpowers_eq` — in a product of groups, coprime-order pairs with the
  same coordinatewise cyclic groups generate the same cyclic group.
* `Rigidity.RET.LineCover.inf_eq_bot_of_coprime` — two subcovers of coprime degree meet in the base
  field.
* `Rigidity.RET.LineCover.deckProdEquiv` — the deck group of a cover generated by two linearly
  disjoint normal subcovers, as the product of their deck groups.
* `Rigidity.RET.LineCover.isInertiaGenAt_deckProdEquiv_symm` — a pair of distinguished inertia
  elements of coprime order is a distinguished inertia element of the whole cover.
* `Rigidity.RET.IsMonodromyOver.prod_coprime` — branch-cycle data of coprime order over the same
  points multiply.
* `Rigidity.RET.IsThreePointMonodromy.prod_coprime` — three-point branch data of coprime order
  multiply.
-/

open Polynomial IntermediateField

noncomputable section

namespace Rigidity.RET

open GeomAKLB

attribute [local instance] GeomAKLB.instMSA GeomAKLB.instIntegral GeomAKLB.instIsFrac
  GeomAKLB.instIGG GeomAKLB.instFinite GeomAKLB.instDedekindB GeomAKLB.instTorsionFree
  GeomAKLB.instFaithful

/-! ## Cyclic subgroups of a product of groups of coprime order -/

section GroupTheory

variable {G₁ G₂ : Type*} [Group G₁] [Group G₂]

/-- **A pair of elements of coprime orders recovers its first coordinate.**  Raising the pair to
the order of the second coordinate kills that coordinate and leaves a generator of the cyclic group
generated by the first. -/
theorem mk_left_mem_zpowers_mk {a : G₁} {b : G₂} (hcop : Nat.Coprime (orderOf a) (orderOf b)) :
    ((a, 1) : G₁ × G₂) ∈ Subgroup.zpowers ((a, b) : G₁ × G₂) := by
  have hz : Subgroup.zpowers (a ^ orderOf b) = Subgroup.zpowers a :=
    zpowers_pow_eq_of_coprime hcop.symm
  obtain ⟨n, hn⟩ : ∃ n : ℤ, (a ^ orderOf b) ^ n = a := by
    rw [← Subgroup.mem_zpowers_iff, hz]
    exact Subgroup.mem_zpowers a
  refine Subgroup.mem_zpowers_iff.mpr ⟨(orderOf b : ℤ) * n, ?_⟩
  rw [zpow_mul, zpow_natCast]
  show ((a ^ orderOf b, b ^ orderOf b) : G₁ × G₂) ^ n = (a, 1)
  rw [pow_orderOf_eq_one]
  show (((a ^ orderOf b) ^ n, (1 : G₂) ^ n) : G₁ × G₂) = (a, 1)
  rw [hn, one_zpow]

/-- **A pair of elements of coprime orders recovers its second coordinate.** -/
theorem mk_right_mem_zpowers_mk {a : G₁} {b : G₂} (hcop : Nat.Coprime (orderOf a) (orderOf b)) :
    ((1, b) : G₁ × G₂) ∈ Subgroup.zpowers ((a, b) : G₁ × G₂) := by
  have hz : Subgroup.zpowers (b ^ orderOf a) = Subgroup.zpowers b :=
    zpowers_pow_eq_of_coprime hcop
  obtain ⟨n, hn⟩ : ∃ n : ℤ, (b ^ orderOf a) ^ n = b := by
    rw [← Subgroup.mem_zpowers_iff, hz]
    exact Subgroup.mem_zpowers b
  refine Subgroup.mem_zpowers_iff.mpr ⟨(orderOf a : ℤ) * n, ?_⟩
  rw [zpow_mul, zpow_natCast]
  show ((a ^ orderOf a, b ^ orderOf a) : G₁ × G₂) ^ n = (1, b)
  rw [pow_orderOf_eq_one]
  show ((((1 : G₁)) ^ n, (b ^ orderOf a) ^ n) : G₁ × G₂) = (1, b)
  rw [hn, one_zpow]

/-- **A pair of elements of coprime orders generates the product of the cyclic groups generated by
its coordinates.** -/
theorem mk_mem_zpowers_mk {a x : G₁} {b y : G₂} (hcop : Nat.Coprime (orderOf a) (orderOf b))
    (hx : x ∈ Subgroup.zpowers a) (hy : y ∈ Subgroup.zpowers b) :
    ((x, y) : G₁ × G₂) ∈ Subgroup.zpowers ((a, b) : G₁ × G₂) := by
  obtain ⟨m, hm⟩ := Subgroup.mem_zpowers_iff.mp hx
  obtain ⟨n, hn⟩ := Subgroup.mem_zpowers_iff.mp hy
  have h1 : ((x, 1) : G₁ × G₂) ∈ Subgroup.zpowers ((a, b) : G₁ × G₂) := by
    have hmem := (Subgroup.zpowers ((a, b) : G₁ × G₂)).zpow_mem
      (mk_left_mem_zpowers_mk hcop) m
    have he : ((a, 1) : G₁ × G₂) ^ m = (x, 1) := by
      show ((a ^ m, (1 : G₂) ^ m) : G₁ × G₂) = (x, 1)
      rw [hm, one_zpow]
    rwa [he] at hmem
  have h2 : ((1, y) : G₁ × G₂) ∈ Subgroup.zpowers ((a, b) : G₁ × G₂) := by
    have hmem := (Subgroup.zpowers ((a, b) : G₁ × G₂)).zpow_mem
      (mk_right_mem_zpowers_mk hcop) n
    have he : ((1, b) : G₁ × G₂) ^ n = (1, y) := by
      show (((1 : G₁) ^ n, b ^ n) : G₁ × G₂) = (1, y)
      rw [hn, one_zpow]
    rwa [he] at hmem
  have he2 : ((x, 1) : G₁ × G₂) * (1, y) = (x, y) := by
    show ((x * 1, 1 * y) : G₁ × G₂) = (x, y)
    rw [mul_one, one_mul]
  exact he2 ▸ Subgroup.mul_mem _ h1 h2

/-- Elements of two finite groups of coprime order have coprime orders. -/
theorem coprime_orderOf_of_coprime_card [Finite G₁] [Finite G₂]
    (hcop : Nat.Coprime (Nat.card G₁) (Nat.card G₂)) (a : G₁) (b : G₂) :
    Nat.Coprime (orderOf a) (orderOf b) :=
  Nat.Coprime.coprime_dvd_right (orderOf_dvd_natCard b)
    (Nat.Coprime.coprime_dvd_left (orderOf_dvd_natCard a) hcop)

/-- **Coprime-order pairs with the same coordinatewise cyclic groups generate the same cyclic group
of the product.**  This is what makes a prescribed pair of branch cycles a generator of the inertia
group of a compositum. -/
theorem zpowers_mk_eq_of_zpowers_eq {a x : G₁} {b y : G₂}
    (hcop : Nat.Coprime (orderOf a) (orderOf b))
    (hx : Subgroup.zpowers x = Subgroup.zpowers a)
    (hy : Subgroup.zpowers y = Subgroup.zpowers b) :
    Subgroup.zpowers ((x, y) : G₁ × G₂) = Subgroup.zpowers ((a, b) : G₁ × G₂) := by
  have hoa : orderOf x = orderOf a := by
    rw [← Nat.card_zpowers, ← Nat.card_zpowers, hx]
  have hob : orderOf y = orderOf b := by
    rw [← Nat.card_zpowers, ← Nat.card_zpowers, hy]
  have hcop' : Nat.Coprime (orderOf x) (orderOf y) := by rw [hoa, hob]; exact hcop
  refine le_antisymm (Subgroup.zpowers_le.mpr (mk_mem_zpowers_mk hcop ?_ ?_))
    (Subgroup.zpowers_le.mpr (mk_mem_zpowers_mk hcop' ?_ ?_))
  · rw [← hx]; exact Subgroup.mem_zpowers x
  · rw [← hy]; exact Subgroup.mem_zpowers y
  · rw [hx]; exact Subgroup.mem_zpowers a
  · rw [hy]; exact Subgroup.mem_zpowers b

end GroupTheory

namespace LineCover

attribute [local instance] sub_isGalois

/-! ## Subcovers of coprime degree -/

/-- **Two subcovers of coprime degree meet in the base field.**  A subcover of both has degree
dividing each of the two degrees, hence degree one. -/
theorem inf_eq_bot_of_coprime (L : LineCover) (A B : IntermediateField (RatFunc k) L.M)
    (hcop : Nat.Coprime (Module.finrank (RatFunc k) (A : Type))
      (Module.finrank (RatFunc k) (B : Type))) : A ⊓ B = ⊥ := by
  have h1 : Module.finrank (RatFunc k) ((A ⊓ B : IntermediateField (RatFunc k) L.M) : Type)
      ∣ Module.finrank (RatFunc k) (A : Type) :=
    IntermediateField.finrank_dvd_of_le_right
      (inf_le_left : (A ⊓ B : IntermediateField (RatFunc k) L.M) ≤ A)
  have h2 : Module.finrank (RatFunc k) ((A ⊓ B : IntermediateField (RatFunc k) L.M) : Type)
      ∣ Module.finrank (RatFunc k) (B : Type) :=
    IntermediateField.finrank_dvd_of_le_right
      (inf_le_right : (A ⊓ B : IntermediateField (RatFunc k) L.M) ≤ B)
  exact IntermediateField.finrank_eq_one_iff.mp (Nat.dvd_one.mp (hcop ▸ Nat.dvd_gcd h1 h2))

/-- **Two subcovers whose deck groups have coprime order meet in the base field.** -/
theorem inf_eq_bot_of_coprime_card (L : LineCover) (A B : IntermediateField (RatFunc k) L.M)
    [Normal (RatFunc k) A] [Normal (RatFunc k) B]
    (hcop : Nat.Coprime (Nat.card (L.sub A).deck) (Nat.card (L.sub B).deck)) : A ⊓ B = ⊥ := by
  refine inf_eq_bot_of_coprime L A B ?_
  rwa [IsGalois.card_aut_eq_finrank (RatFunc k) (L.sub A).M,
    IsGalois.card_aut_eq_finrank (RatFunc k) (L.sub B).M] at hcop

/-! ## The deck group of a compositum of two disjoint subcovers -/

/-- Restriction to two generating, linearly disjoint Galois subcovers is a bijection onto the
product of their deck groups. -/
theorem subHom_prod_bijective (L : LineCover) (A B : IntermediateField (RatFunc k) L.M)
    [Normal (RatFunc k) A] [Normal (RatFunc k) B] (hsup : A ⊔ B = ⊤) (hinf : A ⊓ B = ⊥) :
    Function.Bijective fun σ : L.deck => (L.subHom A σ, L.subHom B σ) := by
  obtain ⟨e⟩ := nonempty_deck_mulEquiv_prod L A B hsup hinf
  exact (Nat.bijective_iff_injective_and_card _).2
    ⟨subHom_prod_injective L A B hsup, Nat.card_congr e.toEquiv⟩

/-- **The deck group of a cover generated by two linearly disjoint Galois subcovers**, identified
with the product of their deck groups by restriction. -/
def deckProdEquiv (L : LineCover) (A B : IntermediateField (RatFunc k) L.M)
    [Normal (RatFunc k) A] [Normal (RatFunc k) B] (hsup : A ⊔ B = ⊤) (hinf : A ⊓ B = ⊥) :
    L.deck ≃* (L.sub A).deck × (L.sub B).deck :=
  MulEquiv.ofBijective ((L.subHom A).prod (L.subHom B)) (subHom_prod_bijective L A B hsup hinf)

@[simp]
theorem deckProdEquiv_apply (L : LineCover) (A B : IntermediateField (RatFunc k) L.M)
    [Normal (RatFunc k) A] [Normal (RatFunc k) B] (hsup : A ⊔ B = ⊤) (hinf : A ⊓ B = ⊥)
    (σ : L.deck) :
    deckProdEquiv L A B hsup hinf σ = (L.subHom A σ, L.subHom B σ) := rfl

/-! ## Inertia of the compositum -/

/-- **A pair of distinguished inertia elements of coprime order is a distinguished inertia element
of the whole cover.**

The inertia group of the cover above the point is cyclic and restricts onto the inertia groups of
the two subcovers, so it is generated by a pair whose coordinates generate cyclic groups conjugate
to the prescribed ones; coprimality of the orders makes the prescribed pair a generator of that
same cyclic group.  Only the two orders need be coprime, not the two degrees: at a point where one
of the subcovers is unramified the hypothesis is automatic. -/
theorem isInertiaGenAt_deckProdEquiv_symm (L : LineCover) (A B : IntermediateField (RatFunc k) L.M)
    [Normal (RatFunc k) A] [Normal (RatFunc k) B] (hsup : A ⊔ B = ⊤) (hinf : A ⊓ B = ⊥)
    {t : k} {a : (L.sub A).deck} {b : (L.sub B).deck}
    (hcopab : Nat.Coprime (orderOf a) (orderOf b))
    (ha : (L.sub A).IsInertiaGenAt t a) (hb : (L.sub B).IsInertiaGenAt t b) :
    L.IsInertiaGenAt t ((deckProdEquiv L A B hsup hinf).symm (a, b)) := by
  have hbij := subHom_prod_bijective L A B hsup hinf
  -- a distinguished inertia element upstairs, and its restrictions
  obtain ⟨σ₀, hσ₀⟩ := L.exists_isInertiaGenAt t
  have hA₀ : (L.sub A).IsInertiaGenAt t (L.subHom A σ₀) := IsInertiaGenAt.restrict L hσ₀
  have hB₀ : (L.sub B).IsInertiaGenAt t (L.subHom B σ₀) := IsInertiaGenAt.restrict L hσ₀
  -- conjugate it so that its two restrictions generate the prescribed cyclic groups
  obtain ⟨c, hc⟩ := hA₀.exists_conj ha
  obtain ⟨c', hc'⟩ := hB₀.exists_conj hb
  obtain ⟨γ, hγ⟩ := hbij.surjective (c, c')
  have hγA : L.subHom A γ = c := congrArg Prod.fst hγ
  have hγB : L.subHom B γ = c' := congrArg Prod.snd hγ
  have hσ₁ : L.IsInertiaGenAt t (γ * σ₀ * γ⁻¹) := hσ₀.conj γ
  have hzA : Subgroup.zpowers (L.subHom A (γ * σ₀ * γ⁻¹)) = Subgroup.zpowers a := by
    rw [map_mul, map_mul, map_inv, hγA, hc]
  have hzB : Subgroup.zpowers (L.subHom B (γ * σ₀ * γ⁻¹)) = Subgroup.zpowers b := by
    rw [map_mul, map_mul, map_inv, hγB, hc']
  -- the prescribed pair generates the same cyclic group as the pair of restrictions
  have hpair : Subgroup.zpowers ((a, b) : (L.sub A).deck × (L.sub B).deck)
      = Subgroup.zpowers (((L.subHom A).prod (L.subHom B)) (γ * σ₀ * γ⁻¹)) :=
    (zpowers_mk_eq_of_zpowers_eq hcopab hzA hzB).symm
  obtain ⟨i, hzp, hmap⟩ :=
    exists_pow_map_eq ((L.subHom A).prod (L.subHom B)) (γ * σ₀ * γ⁻¹) hpair
  have hkey : (deckProdEquiv L A B hsup hinf) ((γ * σ₀ * γ⁻¹) ^ i) = (a, b) := hmap
  rw [← hkey, MulEquiv.symm_apply_apply]
  exact hσ₁.of_zpowers_eq hzp

end LineCover

/-! ## Branch-cycle data of coprime order multiply -/

/-- **Two branch-cycle data of coprime order over the same points combine into one.**  The two
covers are placed inside their compositum, where coprimality of the degrees makes them linearly
disjoint, so the deck group of the compositum is the product; the branch cycles pair up because the
inertia groups do. -/
theorem IsMonodromyOver.prod_coprime {G₁ G₂ : Type} [Group G₁] [Finite G₁] [Group G₂] [Finite G₂]
    {r : ℕ} {h₁ : Fin r → G₁} {h₂ : Fin r → G₂} {t : Fin r → k}
    (hcop : Nat.Coprime (Nat.card G₁) (Nat.card G₂))
    (H₁ : IsMonodromyOver h₁ t) (H₂ : IsMonodromyOver h₂ t) :
    IsMonodromyOver (fun i => (h₁ i, h₂ i)) t := by
  obtain ⟨L₁, e₁, hout₁, hinf₁, hin₁⟩ := H₁
  obtain ⟨L₂, e₂, hout₂, hinf₂, hin₂⟩ := H₂
  -- the compositum, with the two covers sitting inside it
  set M := L₁.compositum L₂ with hM
  set A := L₁.compositumLeft L₂ with hA
  set B := L₁.compositumRight L₂ with hB
  set φ := L₁.compositumLeftEquiv L₂ with hφ
  set ψ := L₁.compositumRightEquiv L₂ with hψ
  -- the two subcovers are copies of the two covers
  set dA : (M.sub A).deck ≃* G₁ := (AlgEquiv.autCongr φ).trans e₁ with hdA
  set dB : (M.sub B).deck ≃* G₂ := (AlgEquiv.autCongr ψ).trans e₂ with hdB
  have houtA : (M.sub A).IsUnramifiedOutside (Set.range t) :=
    LineCover.IsUnramifiedOutside.transport (L := L₁) (L' := M.sub A) φ.symm hout₁
  have houtB : (M.sub B).IsUnramifiedOutside (Set.range t) :=
    LineCover.IsUnramifiedOutside.transport (L := L₂) (L' := M.sub B) ψ.symm hout₂
  have hinfA : (M.sub A).IsUnramifiedAtInfinity :=
    LineCover.IsUnramifiedAtInfinity.transport (L := L₁) (L' := M.sub A) φ.symm hinf₁
  have hinfB : (M.sub B).IsUnramifiedAtInfinity :=
    LineCover.IsUnramifiedAtInfinity.transport (L := L₂) (L' := M.sub B) ψ.symm hinf₂
  have hcardA : Nat.card (M.sub A).deck = Nat.card G₁ := Nat.card_congr dA.toEquiv
  have hcardB : Nat.card (M.sub B).deck = Nat.card G₂ := Nat.card_congr dB.toEquiv
  have hcop' : Nat.Coprime (Nat.card (M.sub A).deck) (Nat.card (M.sub B).deck) := by
    rw [hcardA, hcardB]; exact hcop
  have hsup : A ⊔ B = ⊤ := L₁.compositumLeft_sup_compositumRight L₂
  have hbot : A ⊓ B = ⊥ := LineCover.inf_eq_bot_of_coprime_card M A B hcop'
  refine ⟨M, (LineCover.deckProdEquiv M A B hsup hbot).trans (MulEquiv.prodCongr dA dB), ?_, ?_,
    fun i => ?_⟩
  · have := LineCover.IsUnramifiedOutside.of_sup hsup houtA houtB
    rwa [Set.union_self] at this
  · exact LineCover.IsUnramifiedAtInfinity.of_sup hsup hinfA hinfB
  · have hinA : (M.sub A).IsInertiaGenAt (t i) (dA.symm (h₁ i)) := by
      have := LineCover.IsInertiaGenAt.transport (L := L₁) (L' := M.sub A) φ.symm (hin₁ i)
      rwa [hdA, MulEquiv.symm_trans_apply, AlgEquiv.autCongr_symm]
    have hinB : (M.sub B).IsInertiaGenAt (t i) (dB.symm (h₂ i)) := by
      have := LineCover.IsInertiaGenAt.transport (L := L₂) (L' := M.sub B) ψ.symm (hin₂ i)
      rwa [hdB, MulEquiv.symm_trans_apply, AlgEquiv.autCongr_symm]
    have hsymm : ((LineCover.deckProdEquiv M A B hsup hbot).trans
          (MulEquiv.prodCongr dA dB)).symm (h₁ i, h₂ i)
        = (LineCover.deckProdEquiv M A B hsup hbot).symm (dA.symm (h₁ i), dB.symm (h₂ i)) := rfl
    rw [hsymm]
    exact LineCover.isInertiaGenAt_deckProdEquiv_symm M A B hsup hbot
      (coprime_orderOf_of_coprime_card hcop' _ _) hinA hinB

/-- **Three-point branch data of coprime order multiply.** -/
theorem IsThreePointMonodromy.prod_coprime {G₁ G₂ : Type} [Group G₁] [Finite G₁] [Group G₂]
    [Finite G₂] {h₁ : Fin 3 → G₁} {h₂ : Fin 3 → G₂}
    (hcop : Nat.Coprime (Nat.card G₁) (Nat.card G₂))
    (H₁ : IsThreePointMonodromy h₁) (H₂ : IsThreePointMonodromy h₂) :
    IsThreePointMonodromy fun i => (h₁ i, h₂ i) :=
  fun t ht => IsMonodromyOver.prod_coprime hcop (H₁ t ht) (H₂ t ht)

end Rigidity.RET
