import Mathlib
import InverseGalois.Solvable.SemiabelianHall
import InverseGalois.Solvable.Shafarevich.Frattini

/-!
# Supplementing an abelian normal subgroup outside the Frattini subgroup

Dentzer's class of semiabelian groups is closed under the covering criterion: a finite group
generated by a normal abelian subgroup and a semiabelian subgroup is semiabelian.  The supplement
is easy to come by whenever the abelian normal subgroup escapes the Frattini subgroup, since the
Frattini subgroup is the intersection of the maximal subgroups: a maximal subgroup missing the
normal subgroup supplements it, and it is a *proper* subgroup, hence smaller.

That turns the criterion into an induction on the order.  Call a finite group *Frattini-supplemented*
when, unless it is trivial, it has an abelian normal subgroup not contained in its Frattini
subgroup.  If every finite group of order at most that of `G` is Frattini-supplemented, then `G` is
semiabelian: pick the abelian normal subgroup, pick a maximal subgroup supplementing it, and the
supplement is semiabelian by the inductive hypothesis.

The condition is not vacuous — a nontrivial abelian group is its own abelian normal subgroup and is
not contained in its Frattini subgroup — and it is not automatic either, which is what keeps the
semiabelian class smaller than the solvable one.

## Main results

* `IsSemiabelian.of_normal_abelian_not_le_frattini`: **a finite group with an abelian normal
  subgroup outside the Frattini subgroup, all of whose proper subgroups are semiabelian, is
  semiabelian.**
* `IsFrattiniSupplemented`: the property of having an abelian normal subgroup outside the Frattini
  subgroup, unless the group is trivial.
* `IsSemiabelian.of_isFrattiniSupplemented`: **a finite group all of whose orders' worth of groups
  are Frattini-supplemented is semiabelian** — the induction on the order.
* `IsFrattiniSupplemented.of_mul_comm`: an abelian group is Frattini-supplemented.
-/

open Subgroup

/-- **A finite group with an abelian normal subgroup outside the Frattini subgroup, all of whose
proper subgroups are semiabelian, is semiabelian.**  A normal subgroup escaping the intersection of
the maximal subgroups is supplemented by one of them, and a group generated by a normal abelian
subgroup and a semiabelian subgroup is semiabelian. -/
theorem IsSemiabelian.of_normal_abelian_not_le_frattini {G : Type} [Group G] [Finite G]
    (N : Subgroup G) [N.Normal] (hcomm : ∀ x y : ↥N, x * y = y * x) (h : ¬ N ≤ frattini G)
    (hproper : ∀ U : Subgroup G, U ≠ ⊤ → IsSemiabelian ↥U) : IsSemiabelian G := by
  obtain ⟨U, hU, hsup⟩ := Shafarevich.exists_proper_supplement_of_not_le_frattini h
  exact IsSemiabelian.of_normal_abelian_of_sup_eq_top N U hcomm hsup (hproper U hU)

/-- **A finite group is Frattini-supplemented** when, unless it is trivial, it has an abelian normal
subgroup that is not contained in its Frattini subgroup.  Such a subgroup is supplemented by a
maximal subgroup, which is where the induction on the order gets its smaller group. -/
def IsFrattiniSupplemented (G : Type) [Group G] [Finite G] : Prop :=
  Nontrivial G → ∃ N : Subgroup G, ∃ _ : N.Normal,
    (∀ x y : ↥N, x * y = y * x) ∧ ¬ N ≤ frattini G

/-- **An abelian finite group is Frattini-supplemented.**  The group is a normal abelian subgroup of
itself, and the Frattini subgroup of a nontrivial finite group is proper. -/
theorem IsFrattiniSupplemented.of_mul_comm (G : Type) [Group G] [Finite G]
    (hcomm : ∀ x y : G, x * y = y * x) : IsFrattiniSupplemented G := by
  intro hnt
  refine ⟨⊤, inferInstance, fun x y => Subtype.ext (hcomm (x : G) (y : G)), fun hle => ?_⟩
  have htop : frattini G = ⊤ := top_le_iff.mp hle
  exact bot_ne_top (frattini_nongenerating (K := (⊥ : Subgroup G)) (by rw [htop, bot_sup_eq]))

/-- The order of a proper subgroup of a finite group is smaller than the order of the group. -/
theorem Subgroup.card_lt_card_of_ne_top {G : Type} [Group G] [Finite G] {U : Subgroup G}
    (hU : U ≠ ⊤) : Nat.card ↥U < Nat.card G := by
  have hmul := U.card_mul_index
  have hpos : 0 < Nat.card ↥U := Nat.card_pos
  have hidx : U.index ≠ 1 := fun h => hU (Subgroup.index_eq_one.mp h)
  have hidx0 : U.index ≠ 0 := Subgroup.index_ne_zero_of_finite
  have htwo : 2 ≤ U.index := by omega
  have hle : Nat.card ↥U * 2 ≤ Nat.card ↥U * U.index := Nat.mul_le_mul_left _ htwo
  rw [hmul] at hle
  omega

/-- The induction on the order, carried out over all groups of order at most a given bound. -/
private theorem isSemiabelian_of_isFrattiniSupplemented_aux :
    ∀ (n : ℕ) (G : Type) [Group G] [Finite G], Nat.card G ≤ n →
      (∀ (H : Type) [Group H] [Finite H], Nat.card H ≤ Nat.card G →
        IsFrattiniSupplemented H) → IsSemiabelian G := by
  intro n
  induction n with
  | zero =>
    intro G _ _ hcard _
    exact absurd hcard (by simpa using Nat.card_pos.ne')
  | succ n ih =>
    intro G _ _ hcard h
    rcases subsingleton_or_nontrivial G with hs | hnt
    · exact .of_subsingleton G
    · obtain ⟨N, hnorm, hcomm, hfr⟩ := h G le_rfl hnt
      haveI := hnorm
      refine IsSemiabelian.of_normal_abelian_not_le_frattini N hcomm hfr fun U hU => ?_
      have hlt : Nat.card ↥U < Nat.card G := Subgroup.card_lt_card_of_ne_top hU
      exact ih ↥U (by omega) fun H _ _ hH => h H (hH.trans hlt.le)

/-- **A finite group is semiabelian as soon as every group of order at most its own is
Frattini-supplemented.**  The abelian normal subgroup outside the Frattini subgroup is supplemented
by a maximal subgroup, which is smaller and semiabelian by the inductive hypothesis, and a group
generated by a normal abelian subgroup and a semiabelian subgroup is semiabelian. -/
theorem IsSemiabelian.of_isFrattiniSupplemented (G : Type) [Group G] [Finite G]
    (h : ∀ (H : Type) [Group H] [Finite H], Nat.card H ≤ Nat.card G →
      IsFrattiniSupplemented H) : IsSemiabelian G :=
  isSemiabelian_of_isFrattiniSupplemented_aux (Nat.card G) G le_rfl h
