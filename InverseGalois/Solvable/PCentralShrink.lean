import Mathlib
import InverseGalois.Solvable.PCentralWord
import InverseGalois.Solvable.CentralDual

/-!
# The shrinking process

Let `Γ` be a group of `2`-class `n + 1` generated by a family `x` of generators indexed by
`Fin d × Fin r`, and let `Δ` be another group of `2`-class `n + 1` with `d` distinguished
elements `y`.  Every vector `a` of `r` bits determines a homomorphism `π a : Γ →* Δ` collapsing
the generators, `x (i, j) ↦ y i` when `a j = 1` and `x (i, j) ↦ 1` when `a j = 0`; the vector `a`
selects which of the `r` copies of the generating system survive.

Shafarevich's shrinking process rests on the observation that this collapse is *polynomial* in
`a`.  The last nonzero term of the lower `2`-central series of `Γ` is generated by the basic
elements of weight `n` in the generators, a basic element involves at most `n + 1` of them, and a
basic element is killed by `π a` unless every generator it involves survives.  Reading off the
value of a character of the corresponding term for `Δ` therefore produces a polynomial function
of `a` of degree at most `n + 1`.

Given a rectangular array of elements of the last term of the series for `Γ`, one can then ask
for a nonzero `a` collapsing every row of the array selected by `a` to the identity.  Each
character turns that demand into one polynomial equation of degree at most `n + 2` in the `r`
unknown bits, all of them satisfied by `a = 0`; when `r` exceeds the number of equations times
their degree, the Chevalley–Warning theorem produces the second solution that is asked for.

## Main definitions

* `InverseGalois.charCount`: the number of characters of the last nonzero term of the lower
  `2`-central series, the number of equations one row of the array contributes.

## Main results

* `InverseGalois.exists_mvPolynomial_charValue`: **the character of the collapse of an element of
  the last term of the series is a polynomial of degree at most `n + 1` in the collapsing
  vector.**
* `InverseGalois.exists_ne_zero_forall_prod_eq_one`: **for a rectangular array of elements of the
  last term of the series and enough columns there is a nonzero collapsing vector annihilating
  the selected part of every row.**

## Tags

`p`-group, lower central series, Chevalley–Warning, Shafarevich
-/

namespace InverseGalois

open MvPolynomial

/-! ## The last term of the lower `p`-central series -/

section LastTerm

variable {G : Type*} [Group G] {p n : ℕ}

/-- The last nonzero term of the lower `p`-central series is central. -/
theorem lowerPCentralSeries_le_center (h : lowerPCentralSeries p G (n + 1) = ⊥) :
    lowerPCentralSeries p G n ≤ Subgroup.center G := fun z hz => by
  rw [Subgroup.mem_center_iff]
  intro g
  have hc : ⁅z, g⁆ ∈ lowerPCentralSeries p G (n + 1) := commutator_mem_lowerPCentralSeries_succ hz
  rw [h, Subgroup.mem_bot, commutatorElement_eq_one_iff_mul_comm] at hc
  exact hc.symm

/-- The last nonzero term of the lower `p`-central series has exponent `p`. -/
theorem pow_eq_one_of_mem_lowerPCentralSeries (h : lowerPCentralSeries p G (n + 1) = ⊥) {z : G}
    (hz : z ∈ lowerPCentralSeries p G n) : z ^ p = 1 := by
  have hmem := pow_mem_lowerPCentralSeries_succ hz
  rwa [h, Subgroup.mem_bot] at hmem

/-- The last nonzero term of the lower `p`-central series is generated, as a subgroup, by the
basic elements of weight `n` in a system of generators. -/
theorem closure_basicSet_eq (p : ℕ) {X : Set G} (hX : Subgroup.closure X = ⊤)
    (h : lowerPCentralSeries p G (n + 1) = ⊥) :
    lowerPCentralSeries p G n = Subgroup.closure (basicSet p X n) := by
  haveI : (Subgroup.closure (basicSet p X n)).Normal :=
    normal_of_le_center ((Subgroup.closure_le _).mpr fun z hz =>
      lowerPCentralSeries_le_center h (basicSet_subset_lowerPCentralSeries p X n hz))
  rw [lowerPCentralSeries_eq_basicSubgroup p hX h, basicSubgroup]
  exact le_antisymm (Subgroup.normalClosure_le_normal Subgroup.subset_closure)
    ((Subgroup.closure_le _).mpr Subgroup.subset_normalClosure)

end LastTerm

/-! ## Products over the field with two elements -/

section Bits

private theorem zmod_two_eq_zero_or_one (v : ZMod 2) : v = 0 ∨ v = 1 := by
  revert v
  decide

private theorem list_prod_zmod_two (l : List (ZMod 2)) :
    l.prod = if ∀ v ∈ l, v = 1 then 1 else 0 := by
  induction l with
  | nil => simp
  | cons v l ih =>
    rw [List.prod_cons, ih]
    rcases zmod_two_eq_zero_or_one v with rfl | rfl
    · simp
    · simp

private theorem sum_map_filter {α β : Type*} [AddCommMonoid β] (l : List α) (q : α → Bool)
    (f : α → β) : (((l.filter q).map f).sum) = (l.map fun z => if q z then f z else 0).sum := by
  induction l with
  | nil => simp
  | cons z l ih =>
    by_cases h : q z
    · simp [h, ih]
    · simp [h, ih]

private theorem ite_eq_mul (v : ZMod 2) (w : ZMod 2) :
    (if v = 1 then w else 0) = v * w := by
  rcases zmod_two_eq_zero_or_one v with rfl | rfl
  · simp
  · simp

end Bits

/-! ## The monomial of a basic word -/

section Monomial

variable {d r : ℕ}

/-- The monomial attached to a list of generator indices: the product of the variables recording
which of the `r` copies of the generating system the listed generators belong to. -/
noncomputable def wordMonomial (l : List (Fin d × Fin r)) : MvPolynomial (Fin r) (ZMod 2) :=
  (l.map fun q => X q.2).prod

theorem totalDegree_wordMonomial_le (l : List (Fin d × Fin r)) :
    (wordMonomial l).totalDegree ≤ l.length := by
  induction l with
  | nil => simp [wordMonomial]
  | cons q l ih =>
    have hX : (X q.2 : MvPolynomial (Fin r) (ZMod 2)).totalDegree ≤ 1 := (totalDegree_X _).le
    have hmul := totalDegree_mul (X q.2 : MvPolynomial (Fin r) (ZMod 2)) (wordMonomial l)
    simp only [wordMonomial, List.map_cons, List.prod_cons, List.length_cons] at hmul ih ⊢
    omega

theorem eval_wordMonomial (a : Fin r → ZMod 2) (l : List (Fin d × Fin r)) :
    eval a (wordMonomial l) = if ∀ q ∈ l, a q.2 = 1 then 1 else 0 := by
  have hcomp : ((eval a) ∘ fun q : Fin d × Fin r => (X q.2 : MvPolynomial (Fin r) (ZMod 2)))
      = fun q : Fin d × Fin r => a q.2 := funext fun q => by simp
  rw [wordMonomial, map_list_prod, List.map_map, hcomp, list_prod_zmod_two]
  refine if_congr ⟨fun h q hq => h _ (List.mem_map.mpr ⟨q, hq, rfl⟩), fun h v hv => ?_⟩ rfl rfl
  obtain ⟨q, hq, rfl⟩ := List.mem_map.mp hv
  exact h q hq

end Monomial

/-! ## Polynomiality of the collapse -/

section Collapse

variable {Γ Δ : Type*} [Group Γ] [Group Δ] {n d r : ℕ}

/-- **The character of the collapse of an element of the last term of the lower `2`-central
series is a polynomial function of degree at most `n + 1` of the collapsing vector.** -/
theorem exists_mvPolynomial_charValue (hΓ : lowerPCentralSeries 2 Γ (n + 1) = ⊥)
    {x : Fin d × Fin r → Γ} (hx : Subgroup.closure (Set.range x) = ⊤) {y : Fin d → Δ}
    {π : (Fin r → ZMod 2) → Γ →* Δ} (hπ : ∀ a q, π a (x q) = if a q.2 = 1 then y q.1 else 1)
    (φ : Additive ↥(lowerPCentralSeries 2 Δ n) →+ ZMod 2) {θ : Γ}
    (hθ : θ ∈ lowerPCentralSeries 2 Γ n) :
    ∃ P : MvPolynomial (Fin r) (ZMod 2), P.totalDegree ≤ n + 1 ∧
      ∀ a, eval a P = charValue (lowerPCentralSeries 2 Δ n) φ (π a θ) := by
  have hmem : ∀ (a : Fin r → ZMod 2) {z : Γ}, z ∈ lowerPCentralSeries 2 Γ n →
      π a z ∈ lowerPCentralSeries 2 Δ n :=
    fun a z hz => map_lowerPCentralSeries_le 2 (π a) n ⟨z, hz, rfl⟩
  have hcl : lowerPCentralSeries 2 Γ n =
      Subgroup.closure (Set.range fun w : BasicWord (Fin d × Fin r) n => BasicWord.eval 2 x w) := by
    rw [closure_basicSet_eq 2 hx hΓ, BasicWord.basicSet_eq_range_eval]
  rw [hcl] at hθ
  induction hθ using Subgroup.closure_induction with
  | mem z hz =>
    obtain ⟨w, rfl⟩ := hz
    refine ⟨C (charValue (lowerPCentralSeries 2 Δ n) φ
      (BasicWord.eval 2 (fun q : Fin d × Fin r => y q.1) w)) * wordMonomial w.indices, ?_, ?_⟩
    · have hmul := totalDegree_mul (C (charValue (lowerPCentralSeries 2 Δ n) φ
        (BasicWord.eval 2 (fun q : Fin d × Fin r => y q.1) w)) : MvPolynomial (Fin r) (ZMod 2))
        (wordMonomial w.indices)
      have hC := totalDegree_C (R := ZMod 2) (σ := Fin r) (charValue
        (lowerPCentralSeries 2 Δ n) φ (BasicWord.eval 2 (fun q : Fin d × Fin r => y q.1) w))
      have hlen := BasicWord.length_indices_le w
      have hmono := totalDegree_wordMonomial_le w.indices
      omega
    · intro a
      have hfun : (fun q : Fin d × Fin r => π a (x q))
          = fun q : Fin d × Fin r => if a q.2 = 1 then y q.1 else 1 := funext (hπ a)
      rw [BasicWord.map_eval, hfun,
        BasicWord.eval_ite 2 (fun q : Fin d × Fin r => y q.1) (fun q => a q.2 = 1),
        map_mul, eval_C, eval_wordMonomial,
        apply_ite (charValue (lowerPCentralSeries 2 Δ n) φ), charValue_one]
      split_ifs with h
      · rw [mul_one]
      · rw [mul_zero]
  | one => exact ⟨0, by simp, fun a => by simp⟩
  | mul u v hu hv ihu ihv =>
    obtain ⟨P, hPdeg, hP⟩ := ihu
    obtain ⟨Q, hQdeg, hQ⟩ := ihv
    refine ⟨P + Q, (totalDegree_add P Q).trans (max_le hPdeg hQdeg), fun a => ?_⟩
    rw [map_add, hP, hQ, map_mul,
      charValue_mul φ (hmem a (hcl.ge hu)) (hmem a (hcl.ge hv))]
  | inv u hu ihu =>
    obtain ⟨P, hPdeg, hP⟩ := ihu
    refine ⟨P, hPdeg, fun a => ?_⟩
    rw [hP, map_inv, charValue_inv φ (hmem a (hcl.ge hu)), CharTwo.neg_eq]

/-- The `𝔽₂`-characters of the last nonzero term of the lower `2`-central series, one equation
each. -/
noncomputable def charCount (Δ : Type*) [Group Δ] (n : ℕ) : ℕ :=
  Nat.card (Additive ↥(lowerPCentralSeries 2 Δ n) →+ ZMod 2)

/-- The character of the collapsed product of a row of elements of the last term of the lower
`2`-central series is a polynomial function of degree at most `n + 2` of the collapsing vector. -/
theorem exists_mvPolynomial_charValue_prod (hΓ : lowerPCentralSeries 2 Γ (n + 1) = ⊥)
    {x : Fin d × Fin r → Γ} (hx : Subgroup.closure (Set.range x) = ⊤) {y : Fin d → Δ}
    {π : (Fin r → ZMod 2) → Γ →* Δ} (hπ : ∀ a q, π a (x q) = if a q.2 = 1 then y q.1 else 1)
    (φ : Additive ↥(lowerPCentralSeries 2 Δ n) →+ ZMod 2) {θ : Fin r → Γ}
    (hθ : ∀ j, θ j ∈ lowerPCentralSeries 2 Γ n) :
    ∃ Q : MvPolynomial (Fin r) (ZMod 2), Q.totalDegree ≤ n + 2 ∧
      ∀ a : Fin r → ZMod 2, eval a Q = charValue (lowerPCentralSeries 2 Δ n) φ
        ((((List.finRange r).filter fun j => decide (a j = 1)).map fun j => π a (θ j)).prod) := by
  have hmem : ∀ (a : Fin r → ZMod 2) {z : Γ}, z ∈ lowerPCentralSeries 2 Γ n →
      π a z ∈ lowerPCentralSeries 2 Δ n :=
    fun a z hz => map_lowerPCentralSeries_le 2 (π a) n ⟨z, hz, rfl⟩
  choose P hPdeg hP using fun j => exists_mvPolynomial_charValue hΓ hx hπ φ (hθ j)
  refine ⟨∑ j, X j * P j, ?_, fun a => ?_⟩
  · refine totalDegree_finsetSum_le fun j _ => (totalDegree_mul _ _).trans ?_
    have hX : (X j : MvPolynomial (Fin r) (ZMod 2)).totalDegree ≤ 1 := (totalDegree_X _).le
    have := hPdeg j
    omega
  · rw [charValue_list_prod φ (fun z hz => by
      obtain ⟨j, -, rfl⟩ := List.mem_map.mp hz
      exact hmem a (hθ j)), List.map_map, sum_map_filter, ← Fin.sum_univ_def, map_sum]
    refine Finset.sum_congr rfl fun j _ => ?_
    rw [map_mul, eval_X, hP j a, Function.comp_apply]
    simp only [decide_eq_true_eq]
    rw [ite_eq_mul]

end Collapse

/-! ## Chevalley–Warning -/

/-- A family of polynomials over the field with two elements of small enough total degree,
vanishing at the origin, has a further common zero. -/
theorem exists_ne_zero_of_sum_totalDegree_lt {σ ι : Type*} [Fintype σ] [DecidableEq σ]
    [Fintype ι] {F : ι → MvPolynomial σ (ZMod 2)}
    (hdeg : ∑ i, (F i).totalDegree < Fintype.card σ) (hzero : ∀ i, eval 0 (F i) = 0) :
    ∃ a : σ → ZMod 2, a ≠ 0 ∧ ∀ i, eval a (F i) = 0 := by
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hdvd := char_dvd_card_solutions_of_fintype_sum_lt (K := ZMod 2) 2 hdeg
  have hpos : 0 < Fintype.card {v : σ → ZMod 2 // ∀ i, eval v (F i) = 0} :=
    Fintype.card_pos_iff.mpr ⟨⟨0, hzero⟩⟩
  obtain ⟨⟨a, ha⟩, hne⟩ := Fintype.exists_ne_of_one_lt_card
    (by have := Nat.le_of_dvd hpos hdvd; omega)
    (⟨0, hzero⟩ : {v : σ → ZMod 2 // ∀ i, eval v (F i) = 0})
  exact ⟨a, fun h => hne (Subtype.ext h), ha⟩

/-! ## The shrinking lemma -/

section Shrink

variable {Γ Δ : Type*} [Group Γ] [Group Δ] {n d r : ℕ}

/-- **A rectangular array of elements of the last term of the lower `2`-central series of `Γ`
with enough columns admits a nonzero collapsing vector under which the selected part of every
row collapses to the identity.** -/
theorem exists_ne_zero_forall_prod_eq_one [Finite Δ]
    (hΓ : lowerPCentralSeries 2 Γ (n + 1) = ⊥) (hΔ : lowerPCentralSeries 2 Δ (n + 1) = ⊥)
    {x : Fin d × Fin r → Γ} (hx : Subgroup.closure (Set.range x) = ⊤) {y : Fin d → Δ}
    {π : (Fin r → ZMod 2) → Γ →* Δ} (hπ : ∀ a q, π a (x q) = if a q.2 = 1 then y q.1 else 1)
    {θ : Fin d → Fin r → Γ} (hθ : ∀ i j, θ i j ∈ lowerPCentralSeries 2 Γ n)
    (hr : d * charCount Δ n * (n + 2) < r) :
    ∃ a : Fin r → ZMod 2, a ≠ 0 ∧ ∀ i : Fin d,
      (((List.finRange r).filter fun j => decide (a j = 1)).map fun j => π a (θ i j)).prod = 1 := by
  haveI : Finite (Additive ↥(lowerPCentralSeries 2 Δ n) →+ ZMod 2) := finite_char two_ne_zero
  letI : Fintype (Additive ↥(lowerPCentralSeries 2 Δ n) →+ ZMod 2) := Fintype.ofFinite _
  have hmem : ∀ (a : Fin r → ZMod 2) {z : Γ}, z ∈ lowerPCentralSeries 2 Γ n →
      π a z ∈ lowerPCentralSeries 2 Δ n :=
    fun a z hz => map_lowerPCentralSeries_le 2 (π a) n ⟨z, hz, rfl⟩
  choose Q hQdeg hQ using fun (i : Fin d) (φ : Additive ↥(lowerPCentralSeries 2 Δ n) →+ ZMod 2) =>
    exists_mvPolynomial_charValue_prod hΓ hx hπ φ (hθ i)
  have hzero : ∀ iφ : Fin d × (Additive ↥(lowerPCentralSeries 2 Δ n) →+ ZMod 2),
      eval 0 (Q iφ.1 iφ.2) = 0 := by
    rintro ⟨i, φ⟩
    have hfil : ((List.finRange r).filter fun j => decide ((0 : Fin r → ZMod 2) j = 1)) = [] := by
      refine List.filter_eq_nil_iff.mpr fun j _ => ?_
      simp
    rw [hQ i φ 0, hfil]
    simp
  have hdeg : ∑ iφ : Fin d × (Additive ↥(lowerPCentralSeries 2 Δ n) →+ ZMod 2),
      (Q iφ.1 iφ.2).totalDegree < Fintype.card (Fin r) := by
    have hle : ∑ iφ : Fin d × (Additive ↥(lowerPCentralSeries 2 Δ n) →+ ZMod 2),
        (Q iφ.1 iφ.2).totalDegree
        ≤ (Finset.univ : Finset (Fin d × (Additive ↥(lowerPCentralSeries 2 Δ n) →+ ZMod 2))).card
          • (n + 2) :=
      Finset.sum_le_card_nsmul _ _ _ fun iφ _ => hQdeg iφ.1 iφ.2
    have hcard : (Finset.univ :
        Finset (Fin d × (Additive ↥(lowerPCentralSeries 2 Δ n) →+ ZMod 2))).card
        = d * charCount Δ n := by
      rw [Finset.card_univ, Fintype.card_prod, Fintype.card_fin, charCount,
        Nat.card_eq_fintype_card]
    rw [hcard, smul_eq_mul] at hle
    rw [Fintype.card_fin]
    omega
  obtain ⟨a, ha0, ha⟩ := exists_ne_zero_of_sum_totalDegree_lt hdeg hzero
  refine ⟨a, ha0, fun i => ?_⟩
  refine eq_one_of_forall_charValue_eq_zero Nat.prime_two (lowerPCentralSeries_le_center hΔ)
    (fun z hz => pow_eq_one_of_mem_lowerPCentralSeries hΔ hz)
    (Subgroup.list_prod_mem _ fun z hz => ?_) fun φ => ?_
  · obtain ⟨j, -, rfl⟩ := List.mem_map.mp hz
    exact hmem a (hθ i j)
  · rw [← hQ i φ a]
    exact ha (i, φ)

end Shrink

end InverseGalois
