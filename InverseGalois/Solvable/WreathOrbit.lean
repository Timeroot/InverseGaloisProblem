import Mathlib
import InverseGalois.Solvable.Wreath
import InverseGalois.Solvable.WreathFunctor

/-!
# Split extensions whose kernel is generated by a single orbit

`RegularWreathProduct.toSemidirectProduct` presents a semidirect product `A ⋊[φ] H` with abelian
kernel as a quotient of the wreath product `A ≀ᵣ H`.  That is more than is needed when the kernel
is generated, as an `H`-group, by the orbit of a single element `a₀`: the wreath product may then
be taken over the *cyclic* subgroup `⟨a₀⟩`, because the twisted total product of a family
supported at one index `x` is `φ x` of its value there, so the image of `⟨a₀⟩ ≀ᵣ H` already
contains every `φ x a₀`.

The gain is real.  A minimal normal elementary abelian subgroup is an irreducible module over the
complement, hence generated by the orbit of any one of its nontrivial elements, and `⟨a₀⟩` then
has *prime* order.  Split embedding problems with such a kernel — the ones left over by the
Frattini dichotomy — therefore only ever need a wreath product by a group of prime order.

## Main results

* `RegularWreathProduct.twistedProd_mulSingle` — the twisted total product of a family supported
  at a single index.
* `RegularWreathProduct.toSemidirectProduct_comp_mapLeft_surjective` — if the values `φ x (f c)`
  generate `A`, then `C ≀ᵣ H →* A ≀ᵣ H →* A ⋊[φ] H` is surjective.
* `RegularWreathProduct.exists_surjective_wreath_zpowers` — a semidirect product whose kernel is
  generated by the orbit of `a₀` is a quotient of `⟨a₀⟩ ≀ᵣ H`.
-/

namespace RegularWreathProduct

variable {A H : Type*} [CommGroup A] [Group H] [Fintype H] (φ : H →* MulAut A)

/-- The twisted total product of a family supported at a single index `x` is the value of `φ x`
on the entry sitting there. -/
theorem twistedProd_mulSingle [DecidableEq H] (x : H) (a : A) :
    twistedProd φ (Pi.mulSingle x a) = φ x a := by
  rw [twistedProd, Finset.prod_eq_single x]
  · rw [Pi.mulSingle_eq_same]
  · intro y _ hy
    rw [Pi.mulSingle_eq_of_ne hy, map_one]
  · intro h
    exact absurd (Finset.mem_univ x) h

variable {C : Type*} [CommGroup C]

/-- **A semidirect product is a quotient of a wreath product over any group whose translates
generate the kernel.**

The family supported at `x` with value `c` is sent to `φ x (f c)`, so the image of the composite
contains every generator; and the `H`-component is untouched, so the image also contains a copy of
`H`.  Together these generate `A ⋊[φ] H`. -/
theorem toSemidirectProduct_comp_mapLeft_surjective (f : C →* A)
    (hgen : Subgroup.closure {a : A | ∃ (x : H) (c : C), φ x (f c) = a} = ⊤) :
    Function.Surjective ((toSemidirectProduct φ).comp (mapLeft f)) := by
  classical
  set F := (toSemidirectProduct φ).comp (mapLeft (Q := H) f) with hF
  have hinl : ∀ a : A, (SemidirectProduct.inl a : A ⋊[φ] H) ∈ F.range := by
    have hle : Subgroup.closure {a : A | ∃ (x : H) (c : C), φ x (f c) = a}
        ≤ (F.range).comap (SemidirectProduct.inl : A →* A ⋊[φ] H) := by
      rw [Subgroup.closure_le]
      rintro a ⟨x, c, rfl⟩
      refine Subgroup.mem_comap.mpr ⟨⟨Pi.mulSingle x c, 1⟩, ?_⟩
      ext
      · show twistedProd φ (fun y ↦ f ((Pi.mulSingle x c : H → C) y)) = φ x (f c)
        have hfun : (fun y ↦ f ((Pi.mulSingle x c : H → C) y)) = Pi.mulSingle x (f c) := by
          funext y
          by_cases hy : y = x
          · subst hy; rw [Pi.mulSingle_eq_same, Pi.mulSingle_eq_same]
          · rw [Pi.mulSingle_eq_of_ne hy, Pi.mulSingle_eq_of_ne hy, map_one]
        rw [hfun, twistedProd_mulSingle]
      · rfl
    intro a
    exact hle (by rw [hgen]; exact Subgroup.mem_top a)
  intro y
  have hinr : (SemidirectProduct.inr y.right : A ⋊[φ] H) ∈ F.range := by
    refine ⟨⟨1, y.right⟩, ?_⟩
    ext
    · show twistedProd φ (fun z ↦ f ((1 : H → C) z)) = 1
      simp only [Pi.one_apply, map_one]
      exact twistedProd_one φ
    · rfl
  have hmem := mul_mem (hinl y.left) hinr
  rw [SemidirectProduct.inl_left_mul_inr_right] at hmem
  exact hmem

/-- **A semidirect product whose abelian kernel is generated by one orbit is a quotient of the
wreath product by the cyclic group that orbit starts from.** -/
theorem exists_surjective_wreath_zpowers {a₀ : A}
    (hgen : Subgroup.closure (Set.range fun x ↦ φ x a₀) = ⊤) :
    ∃ F : ↥(Subgroup.zpowers a₀) ≀ᵣ H →* A ⋊[φ] H, Function.Surjective F := by
  refine ⟨_, toSemidirectProduct_comp_mapLeft_surjective φ (Subgroup.zpowers a₀).subtype ?_⟩
  refine eq_top_iff.mpr ?_
  rw [← hgen]
  refine Subgroup.closure_mono ?_
  rintro _ ⟨x, rfl⟩
  exact ⟨x, ⟨a₀, Subgroup.mem_zpowers a₀⟩, rfl⟩

end RegularWreathProduct
