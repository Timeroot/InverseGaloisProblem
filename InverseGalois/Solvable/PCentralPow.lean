import Mathlib
import InverseGalois.Solvable.PCentralCharacter
import InverseGalois.Solvable.PCentralTower

/-!
# Powers along the lower `p`-central series

Passing from one term of the lower `p`-central series to the next multiplies by `p`-th powers and
by commutators with the whole group, so modulo the next term the previous one is central of
exponent `p`.  Raising to the `p`-th power therefore improves a congruence by one step: two
elements congruent modulo one term have `p`-th powers congruent modulo the next.  Iterating, the
`p ^ c`-th power map of the free object of `p`-class `c + 1` depends only on the coordinates of its
argument, and it sends a distinguished generator to an element of the kernel of the projection onto
the class below.

Those elements are the ones the residue correction has to keep track of: the inertia group of a
prime ramifying in a single block is cyclic, generated by an element with the coordinates of a
single generator, and its `p ^ c`-th power is exactly the part of the kernel of the projection that
the inertia group already covers.  Reading the coordinates modulo `p ^ (c + 1)` shows that these
elements are nontrivial and independent, which is what pins down the order of a generator.

## Main definitions

* `InverseGalois.FreePClass.padicCoord`: the coordinates of the free object modulo `p ^ c`.
* `InverseGalois.FreePClass.zGen`: the `p ^ c`-th power of a distinguished generator.

## Main results

* `InverseGalois.pow_congr_lowerPCentralSeries`: **raising to the `p`-th power improves a
  congruence along the lower `p`-central series by one step.**
* `InverseGalois.FreePClass.pow_eq_zGen`: **the `p ^ c`-th power of an element with the coordinates
  of a distinguished generator is the distinguished element attached to it.**
* `InverseGalois.FreePClass.zpowers_inf_ker_proj`: **the part of the kernel of the projection inside
  the cyclic group generated by such an element is generated by that distinguished element.**

## Tags

`p`-group, lower central series, free object, power map, Frattini quotient, Shafarevich
-/

namespace InverseGalois

/-! ### Raising a congruence to the `p`-th power -/

section Group

variable {G : Type*} [Group G]

/-- **Raising to the `p`-th power improves a congruence along the lower `p`-central series by one
step.**  Modulo the next term the difference of the two elements is central of exponent `p`, so it
disappears from the `p`-th powers. -/
theorem pow_congr_lowerPCentralSeries {p n : ℕ} {a b : G}
    (h : a⁻¹ * b ∈ lowerPCentralSeries p G (n + 1)) :
    (a ^ p)⁻¹ * b ^ p ∈ lowerPCentralSeries p G (n + 2) := by
  haveI := lowerPCentralSeries_normal p G (n + 2)
  obtain ⟨v, hv, rfl⟩ : ∃ v, v ∈ lowerPCentralSeries p G (n + 1) ∧ b = a * v :=
    ⟨a⁻¹ * b, h, (mul_inv_cancel_left a b).symm⟩
  have hcomm : Commute (QuotientGroup.mk (s := lowerPCentralSeries p G (n + 2)) a)
      (QuotientGroup.mk (s := lowerPCentralSeries p G (n + 2)) v) := by
    show _ * _ = _ * _
    rw [← QuotientGroup.mk_mul, ← QuotientGroup.mk_mul, QuotientGroup.eq]
    have hc : ⁅v⁻¹, a⁻¹⁆ ∈ lowerPCentralSeries p G (n + 2) :=
      commutator_mem_lowerPCentralSeries_succ (inv_mem hv)
    rw [commutatorElement_def] at hc
    simpa [mul_assoc] using hc
  have hvp : (QuotientGroup.mk (s := lowerPCentralSeries p G (n + 2)) v) ^ p = 1 := by
    rw [← QuotientGroup.mk_pow, QuotientGroup.eq_one_iff]
    exact pow_mem_lowerPCentralSeries_succ hv
  refine (QuotientGroup.eq_one_iff _).mp ?_
  rw [QuotientGroup.mk_mul, QuotientGroup.mk_inv, QuotientGroup.mk_pow, QuotientGroup.mk_pow,
    QuotientGroup.mk_mul, hcomm.mul_pow, hvp, mul_one, inv_mul_cancel]

/-- **Raising to the `p ^ k`-th power carries a congruence modulo the Frattini term of the lower
`p`-central series to a congruence `k` steps further along.** -/
theorem pow_pow_congr_lowerPCentralSeries {p : ℕ} {a b : G}
    (h : a⁻¹ * b ∈ lowerPCentralSeries p G 1) (k : ℕ) :
    (a ^ p ^ k)⁻¹ * b ^ p ^ k ∈ lowerPCentralSeries p G (k + 1) := by
  induction k with
  | zero => simpa using h
  | succ k ih =>
    have hstep := pow_congr_lowerPCentralSeries (n := k) ih
    rwa [← pow_mul, ← pow_mul, ← pow_succ] at hstep

/-- The `p ^ k`-th power of any element lies `k` steps along the lower `p`-central series. -/
theorem pow_pow_mem_lowerPCentralSeries {p : ℕ} (x : G) (k : ℕ) :
    x ^ p ^ k ∈ lowerPCentralSeries p G k := by
  induction k with
  | zero => simp
  | succ k ih =>
    rw [pow_succ, pow_mul]
    exact pow_mem_lowerPCentralSeries_succ ih

end Group

/-! ### The lower `p`-central series of a commutative group -/

/-- In a commutative group the `k`-th term of the lower `p`-central series consists of `p ^ k`-th
powers. -/
theorem lowerPCentralSeries_le_range_powMonoidHom {A : Type*} [CommGroup A] (p k : ℕ) :
    lowerPCentralSeries p A k ≤ (powMonoidHom (p ^ k) : A →* A).range := by
  induction k with
  | zero =>
    intro x _
    exact ⟨x, by simp⟩
  | succ k ih =>
    refine lowerPCentralSeries_succ_le_of (fun x _ y => ?_) (fun x hx => ?_)
    · rw [commutatorElement_eq_one_iff_commute.mpr (Commute.all x y)]
      exact one_mem _
    · obtain ⟨y, hy⟩ := ih hx
      refine ⟨y, ?_⟩
      show y ^ p ^ (k + 1) = x ^ p
      rw [pow_succ, pow_mul]
      exact congrArg (· ^ p) hy

/-- **A commutative group whose elements are killed by `p ^ n` has trivial `n`-th term of its lower
`p`-central series.** -/
theorem lowerPCentralSeries_eq_bot_of_pow_eq_one {A : Type*} [CommGroup A] {p n : ℕ}
    (h : ∀ x : A, x ^ p ^ n = 1) : lowerPCentralSeries p A n = ⊥ := by
  refine le_bot_iff.mp ((lowerPCentralSeries_le_range_powMonoidHom p n).trans ?_)
  rintro x ⟨y, rfl⟩
  exact h y

/-- The group of vectors of residues modulo `p ^ c` has trivial `c`-th term of its lower
`p`-central series. -/
theorem lowerPCentralSeries_pi_zmod_eq_bot (p d c : ℕ) :
    lowerPCentralSeries p (Multiplicative (Fin d → ZMod (p ^ c))) c = ⊥ := by
  refine lowerPCentralSeries_eq_bot_of_pow_eq_one fun x => ?_
  refine Multiplicative.toAdd.injective (funext fun j => ?_)
  show (p ^ c) • (Multiplicative.toAdd x) j = 0
  rw [nsmul_eq_mul, ZMod.natCast_self, zero_mul]

namespace FreePClass

/-! ### The coordinates modulo a power of `p` -/

/-- The coordinates of the free object of rank `d` and `p`-class `c`, read modulo `p ^ c`. -/
noncomputable def padicCoord (p d c : ℕ) :
    FreePClass p d c →* Multiplicative (Fin d → ZMod (p ^ c)) :=
  lift (lowerPCentralSeries_pi_zmod_eq_bot p d c) fun i => Multiplicative.ofAdd (Pi.single i 1)

@[simp] theorem padicCoord_gen (p d c : ℕ) (i : Fin d) :
    padicCoord p d c (gen p d c i) = Multiplicative.ofAdd (Pi.single i 1) :=
  lift_gen _ _ i

/-! ### The distinguished elements of the kernel of the projection -/

/-- The distinguished element of the kernel of the projection onto the class below attached to a
distinguished generator: its `p ^ c`-th power. -/
def zGen (p d c : ℕ) (i : Fin d) : FreePClass p d (c + 1) := gen p d (c + 1) i ^ p ^ c

theorem zGen_mem_ker_proj (p d c : ℕ) (i : Fin d) : zGen p d c i ∈ (proj p d c).ker := by
  rw [MonoidHom.mem_ker, zGen, map_pow, proj_gen, ← Subgroup.mem_bot,
    ← lowerPCentralSeries_eq_bot p d c]
  exact pow_pow_mem_lowerPCentralSeries _ c

theorem nsmul_pi_single {d m : ℕ} (n : ℕ) (i : Fin d) (x : ZMod m) :
    n • (Pi.single i x : Fin d → ZMod m) = Pi.single i (n • x) := by
  funext j
  rw [Pi.smul_apply, Pi.single_apply, Pi.single_apply]
  split
  · rfl
  · rw [smul_zero]

theorem padicCoord_zGen (p d c : ℕ) (i : Fin d) :
    padicCoord p d (c + 1) (zGen p d c i)
      = Multiplicative.ofAdd (Pi.single i ((p ^ c : ℕ) : ZMod (p ^ (c + 1)))) := by
  rw [zGen, map_pow, padicCoord_gen, ← ofAdd_nsmul]
  refine congrArg Multiplicative.ofAdd ?_
  rw [nsmul_pi_single]
  simp

/-- **The distinguished elements of the kernel of the projection are nontrivial**: their
coordinates modulo `p ^ (c + 1)` are not. -/
theorem zGen_ne_one {p : ℕ} (hp : 1 < p) (d c : ℕ) (i : Fin d) : zGen p d c i ≠ 1 := by
  haveI : NeZero (p ^ (c + 1)) := ⟨pow_ne_zero _ (by omega)⟩
  intro h
  have hcast : ((p ^ c : ℕ) : ZMod (p ^ (c + 1))) ≠ 0 := by
    rw [Ne, ZMod.natCast_eq_zero_iff, Nat.pow_dvd_pow_iff_le_right hp]
    omega
  have h0 : (Pi.single i ((p ^ c : ℕ) : ZMod (p ^ (c + 1))) : Fin d → ZMod (p ^ (c + 1))) = 0 := by
    have := padicCoord_zGen p d c i
    rw [h, map_one] at this
    exact Multiplicative.ofAdd.injective this.symm
  exact hcast (by simpa using congrFun h0 i)

/-! ### The power map on the Frattini quotient -/

variable {p d c : ℕ} [NeZero p]

/-- **Elements with the same coordinates have the same `p ^ c`-th power** in the free object of
`p`-class `c + 1`. -/
theorem pow_eq_pow_of_coordClass_eq {a b : FreePClass p d (c + 1)}
    (h : coordClass p d (Nat.succ_pos c) a = coordClass p d (Nat.succ_pos c) b) :
    a ^ p ^ c = b ^ p ^ c := by
  have hmem : a⁻¹ * b ∈ lowerPCentralSeries p (FreePClass p d (c + 1)) 1 := by
    rw [← ker_coordClass p d (Nat.succ_pos c), MonoidHom.mem_ker, map_mul, map_inv, h,
      inv_mul_cancel]
  have hcong := pow_pow_congr_lowerPCentralSeries hmem c
  rwa [lowerPCentralSeries_eq_bot, Subgroup.mem_bot, inv_mul_eq_one] at hcong

/-- **The `p ^ c`-th power of an element with the coordinates of a distinguished generator is the
distinguished element attached to that generator.** -/
theorem pow_eq_zGen {x : FreePClass p d (c + 1)} {i : Fin d}
    (h : coordClass p d (Nat.succ_pos c) x = Multiplicative.ofAdd (Pi.single i 1)) :
    x ^ p ^ c = zGen p d c i :=
  pow_eq_pow_of_coordClass_eq (by rw [h, coordClass_gen])

/-- **An element with the coordinates of a distinguished generator has the largest possible
order.** -/
theorem orderOf_eq_of_coordClass_eq [Fact p.Prime] {x : FreePClass p d (c + 1)} {i : Fin d}
    (h : coordClass p d (Nat.succ_pos c) x = Multiplicative.ofAdd (Pi.single i 1)) :
    orderOf x = p ^ (c + 1) := by
  have hp : 1 < p := (Fact.out : p.Prime).one_lt
  have hzx : x ^ p ^ c = zGen p d c i := pow_eq_zGen h
  have htop : x ^ p ^ (c + 1) = 1 := by
    rw [pow_succ, pow_mul, hzx]
    exact pow_eq_one_of_mem_ker_proj p d c (zGen_mem_ker_proj p d c i)
  obtain ⟨k, hk, hord⟩ := (Nat.dvd_prime_pow (Fact.out : p.Prime)).mp
    (orderOf_dvd_of_pow_eq_one htop)
  rcases Nat.lt_or_ge k (c + 1) with hlt | hge
  · exfalso
    refine zGen_ne_one hp d c i ?_
    rw [← hzx]
    exact orderOf_dvd_iff_pow_eq_one.mp (hord ▸ pow_dvd_pow p (by omega))
  · rw [hord, Nat.le_antisymm hk hge]

/-- **The part of the kernel of the projection covered by the cyclic group generated by an element
with the coordinates of a distinguished generator** is generated by the distinguished element
attached to that generator. -/
theorem zpowers_inf_ker_proj [Fact p.Prime] {x : FreePClass p d (c + 1)} {i : Fin d}
    (h : coordClass p d (Nat.succ_pos c) x = Multiplicative.ofAdd (Pi.single i 1)) :
    Subgroup.zpowers x ⊓ (proj p d c).ker = Subgroup.zpowers (zGen p d c i) := by
  have hzx : x ^ p ^ c = zGen p d c i := pow_eq_zGen h
  refine le_antisymm ?_ ?_
  · intro y hy
    rw [Subgroup.mem_inf] at hy
    obtain ⟨hy₁, hker⟩ := hy
    obtain ⟨n, rfl⟩ := (Submonoid.mem_powers_iff _ _).mp (mem_powers_iff_mem_zpowers.mpr hy₁)
    have hdvd : p ^ (c + 1) ∣ n * p := by
      rw [← orderOf_eq_of_coordClass_eq h]
      exact orderOf_dvd_of_pow_eq_one (by rw [pow_mul]; exact pow_eq_one_of_mem_ker_proj p d c hker)
    obtain ⟨m, rfl⟩ : p ^ c ∣ n := by
      rw [Nat.pow_succ] at hdvd
      exact (mul_dvd_mul_iff_right (Nat.Prime.pos (Fact.out : p.Prime)).ne').mp hdvd
    refine ⟨(m : ℤ), ?_⟩
    show zGen p d c i ^ (m : ℤ) = x ^ (p ^ c * m)
    rw [zpow_natCast, ← hzx, ← pow_mul]
  · rw [Subgroup.zpowers_le]
    exact ⟨hzx ▸ pow_mem (Subgroup.mem_zpowers x) (p ^ c), zGen_mem_ker_proj p d c i⟩

end FreePClass

end InverseGalois
