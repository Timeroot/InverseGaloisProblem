import Mathlib

/-!
# Nilpotent normal supplements in a finite solvable group

Every nontrivial finite solvable group `G` is generated by a nilpotent normal subgroup together
with a proper subgroup.  The mechanism behind this is the Frattini subgroup `Φ = frattini G`, the
intersection of the maximal subgroups of `G`: it is nilpotent, it is non-generating, and a normal
subgroup `N` containing `Φ` with abelian quotient `N / Φ` is forced to be nilpotent, because the
Frattini argument makes every Sylow subgroup of `N` normal in the whole of `G`.

Solvability enters only to produce a nontrivial abelian normal subgroup of `G / Φ`: the last
nonvanishing term of the derived series.  Its preimage `N` in `G` is a normal subgroup which is not
contained in `Φ`, and a normal subgroup not contained in `Φ` misses some maximal subgroup `U`,
which is then the required proper supplement.

## Main results

* `Shafarevich.exists_sylow_map_eq_map` — a maximal `p`-subgroup of a subgroup `N` is a maximal
  `p`-subgroup of every subgroup of `N` that contains it.
* `Shafarevich.normal_sup_frattini` — if `N` is normal with `⁅N, N⁆` inside the Frattini subgroup
  and `P` is a subgroup of `N` whose normalizer supplements `N`, then `P ⊔ frattini G` is normal.
* `Shafarevich.isNilpotent_of_commutator_le_frattini` — a normal subgroup containing the Frattini
  subgroup with abelian Frattini quotient is nilpotent.
* `Shafarevich.exists_proper_supplement_of_not_le_frattini` — a subgroup not contained in the
  Frattini subgroup has a proper supplement.
* `exists_nilpotent_normal_supplement` — a nontrivial finite solvable group is the join of a
  nilpotent normal subgroup and a proper subgroup.
-/

namespace Shafarevich

open Subgroup

variable {G : Type*} [Group G]

/-- **A maximal `p`-subgroup of a subgroup `N` is a maximal `p`-subgroup of every intermediate
subgroup.**  If `K` is contained in `N` and contains the Sylow `p`-subgroup `P` of `N`, then `P` is
already a Sylow `p`-subgroup of `K`: any `p`-subgroup of `K` containing `P` is a `p`-subgroup of `N`
containing `P`, hence equal to `P`. -/
theorem exists_sylow_map_eq_map [Finite G] {p : ℕ} [Fact p.Prime] {N K : Subgroup G}
    (P : Sylow p N) (hKN : K ≤ N) (hPK : map N.subtype (P : Subgroup N) ≤ K) :
    ∃ Q : Sylow p K, map K.subtype (Q : Subgroup K) = map N.subtype (P : Subgroup N) := by
  have hP : IsPGroup p (map N.subtype (P : Subgroup N)) := P.2.map _
  have hPsub : IsPGroup p ((map N.subtype (P : Subgroup N)).subgroupOf K) := hP.comap_subtype
  obtain ⟨Q, hQ⟩ := hPsub.exists_le_sylow
  have hQ' : (map N.subtype (P : Subgroup N)).subgroupOf K ≤ (Q : Subgroup K) := hQ
  refine ⟨Q, ?_⟩
  have hQK : map K.subtype (Q : Subgroup K) ≤ K := map_subtype_le _
  have hQp : IsPGroup p (map K.subtype (Q : Subgroup K)) := Q.2.map _
  have hPQ : map N.subtype (P : Subgroup N) ≤ map K.subtype (Q : Subgroup K) := by
    have h := map_mono (f := K.subtype) hQ'
    rwa [subgroupOf_map_subtype, inf_eq_left.mpr hPK] at h
  have key : (map K.subtype (Q : Subgroup K)).subgroupOf N = (P : Subgroup N) :=
    P.3 (hQp.comap_subtype (K := N)) (map_le_iff_le_comap.mp hPQ)
  have h2 := congrArg (map N.subtype) key
  rwa [subgroupOf_map_subtype, inf_eq_left.mpr (hQK.trans hKN)] at h2

/-- **A subgroup of `N` whose normalizer supplements `N` generates a normal subgroup together with
the Frattini subgroup**, provided the commutators of `N` already lie in the Frattini subgroup.
Elements of `N` move `P` inside `P ⊔ frattini G` because they change each element of `P` by a
commutator, and elements normalizing `P` preserve both `P` and the Frattini subgroup. -/
theorem normal_sup_frattini {N P : Subgroup G} [N.Normal] (hcomm : ⁅N, N⁆ ≤ frattini G)
    (hPN : P ≤ N) (hfr : P.normalizer ⊔ N = ⊤) : (P ⊔ frattini G).Normal := by
  have hΦ : (frattini G).Normal := inferInstance
  have hA : ∀ n ∈ N, ∀ x ∈ P ⊔ frattini G, n * x * n⁻¹ ∈ P ⊔ frattini G := by
    intro n hn x hx
    refine (sup_le (fun y hy => ?_) (fun z hz => ?_) :
      P ⊔ frattini G ≤ (P ⊔ frattini G).comap (MulAut.conj n).toMonoidHom) hx
    · show n * y * n⁻¹ ∈ P ⊔ frattini G
      have e : n * y * n⁻¹ = ⁅n, y⁆ * y := by group
      rw [e]
      exact mul_mem (mem_sup_right (hcomm (commutator_mem_commutator hn (hPN hy))))
        (mem_sup_left hy)
    · show n * z * n⁻¹ ∈ P ⊔ frattini G
      exact mem_sup_right (hΦ.conj_mem z hz n)
  have hB : ∀ h ∈ P.normalizer, ∀ x ∈ P ⊔ frattini G, h * x * h⁻¹ ∈ P ⊔ frattini G := by
    intro h hh x hx
    refine (sup_le (fun y hy => ?_) (fun z hz => ?_) :
      P ⊔ frattini G ≤ (P ⊔ frattini G).comap (MulAut.conj h).toMonoidHom) hx
    · show h * y * h⁻¹ ∈ P ⊔ frattini G
      exact mem_sup_left ((mem_normalizer_iff.mp hh y).mp hy)
    · show h * z * h⁻¹ ∈ P ⊔ frattini G
      exact mem_sup_right (hΦ.conj_mem z hz h)
  refine ⟨fun x hx g => ?_⟩
  have hg : g ∈ P.normalizer ⊔ N := hfr ▸ mem_top g
  rw [← SetLike.mem_coe, Subgroup.mul_normal] at hg
  obtain ⟨h, hh, n, hn, rfl⟩ := hg
  have e : h * n * x * (h * n)⁻¹ = h * (n * x * n⁻¹) * h⁻¹ := by group
  rw [e]
  exact hB h hh _ (hA n hn x hx)

/-- **A normal subgroup with abelian Frattini quotient is nilpotent.**  Let `N` be a normal subgroup
of a finite group `G` containing the Frattini subgroup `Φ` and with `⁅N, N⁆ ≤ Φ`.  For a Sylow
`p`-subgroup `P` of `N` the subgroup `P ⊔ Φ` is normal in `G`, so Frattini's argument applied to it
shows that the normalizer of `P` supplements `Φ`; as `Φ` is non-generating, `P` is normal in `G` and
hence in `N`.  All Sylow subgroups of `N` being normal, `N` is nilpotent. -/
theorem isNilpotent_of_commutator_le_frattini [Finite G] {N : Subgroup G} [N.Normal]
    (hΦN : frattini G ≤ N) (hcomm : ⁅N, N⁆ ≤ frattini G) : Group.IsNilpotent N := by
  have tfae := (isNilpotent_of_finite_tfae (G := N)).out 0 3
  rw [tfae]
  intro p _ P
  have hPN : map N.subtype (P : Subgroup N) ≤ N := map_subtype_le _
  have hfr : (map N.subtype (P : Subgroup N)).normalizer ⊔ N = ⊤ := Sylow.normalizer_sup_eq_top P
  haveI hKn : (map N.subtype (P : Subgroup N) ⊔ frattini G).Normal :=
    normal_sup_frattini hcomm hPN hfr
  obtain ⟨Q, hQ⟩ := exists_sylow_map_eq_map P (sup_le hPN hΦN) le_sup_left
  have hfr2 := Sylow.normalizer_sup_eq_top Q
  rw [hQ] at hfr2
  have hle : (map N.subtype (P : Subgroup N)).normalizer ⊔ map N.subtype (P : Subgroup N)
      = (map N.subtype (P : Subgroup N)).normalizer := sup_eq_left.mpr le_normalizer
  have hfr3 : (map N.subtype (P : Subgroup N)).normalizer ⊔ frattini G = ⊤ := by
    rw [← hfr2, ← sup_assoc, hle]
  exact (normalizer_eq_top_iff.mp (frattini_nongenerating hfr3)).of_map_subtype

/-- **A subgroup not contained in the Frattini subgroup has a proper supplement.**  Indeed, the
Frattini subgroup is the intersection of the maximal subgroups, so some maximal subgroup `U` fails
to contain the given subgroup `N`; then `N ⊔ U` is strictly larger than `U`, hence everything. -/
theorem exists_proper_supplement_of_not_le_frattini [IsCoatomic (Subgroup G)] {N : Subgroup G}
    (h : ¬ N ≤ frattini G) : ∃ U : Subgroup G, U ≠ ⊤ ∧ N ⊔ U = ⊤ := by
  by_contra hcon
  push_neg at hcon
  refine h (le_iInf₂ fun M hM => ?_)
  by_contra hNM
  refine hcon M hM.1 (hM.2 (N ⊔ M) (lt_of_le_of_ne le_sup_right fun e => ?_))
  exact hNM (le_sup_left.trans e.ge)

/-- **A nontrivial solvable group has a nontrivial abelian normal subgroup**, namely the last
nonvanishing term of its derived series. -/
theorem exists_normal_commutator_eq_bot (Q : Type*) [Group Q] [IsSolvable Q] [Nontrivial Q] :
    ∃ A : Subgroup Q, A ≠ ⊥ ∧ ⁅A, A⁆ = ⊥ ∧ A.Normal := by
  suffices H : ∀ n : ℕ, derivedSeries Q n = ⊥ → ∃ A : Subgroup Q, A ≠ ⊥ ∧ ⁅A, A⁆ = ⊥ ∧ A.Normal by
    obtain ⟨n, hn⟩ := (isSolvable_def Q).mp inferInstance
    exact H n hn
  intro n
  induction n with
  | zero =>
    intro hn
    rw [derivedSeries_zero] at hn
    exact absurd hn.symm bot_ne_top
  | succ m ih =>
    intro hn
    by_cases hm : derivedSeries Q m = ⊥
    · exact ih hm
    · exact ⟨derivedSeries Q m, hm, by rw [← derivedSeries_succ]; exact hn, inferInstance⟩

end Shafarevich

/-- **A nontrivial finite solvable group is the join of a nilpotent normal subgroup and a proper
subgroup.**  Passing to the quotient by the Frattini subgroup `Φ`, solvability provides a nontrivial
abelian normal subgroup `A` of `G / Φ`; its preimage `N` in `G` is normal, contains `Φ`, has abelian
Frattini quotient — hence is nilpotent — and is not contained in `Φ`, so it is supplemented by a
maximal subgroup. -/
theorem exists_nilpotent_normal_supplement (G : Type*) [Group G] [Finite G] [IsSolvable G]
    [Nontrivial G] :
    ∃ N : Subgroup G, ∃ _ : N.Normal, ∃ U : Subgroup G,
      Group.IsNilpotent N ∧ U ≠ ⊤ ∧ N ⊔ U = ⊤ := by
  have hΦtop : frattini G ≠ ⊤ := by
    obtain ⟨M, hM⟩ := IsCoatomic.exists_coatom (α := Subgroup G)
    exact fun h => hM.1 (top_le_iff.mp (h ▸ frattini_le_coatom hM))
  haveI : Nontrivial (G ⧸ frattini G) := QuotientGroup.nontrivial_iff.mpr hΦtop
  obtain ⟨A, hA0, hAcomm, hAnormal⟩ :=
    Shafarevich.exists_normal_commutator_eq_bot (G ⧸ frattini G)
  haveI : (A.comap (QuotientGroup.mk' (frattini G))).Normal :=
    hAnormal.comap (QuotientGroup.mk' (frattini G))
  have hΦle : frattini G ≤ A.comap (QuotientGroup.mk' (frattini G)) := by
    have h := A.ker_le_comap (QuotientGroup.mk' (frattini G))
    rwa [QuotientGroup.ker_mk'] at h
  have hcomm : ⁅A.comap (QuotientGroup.mk' (frattini G)),
      A.comap (QuotientGroup.mk' (frattini G))⁆ ≤ frattini G := by
    have h1 : ⁅Subgroup.map (QuotientGroup.mk' (frattini G))
          (A.comap (QuotientGroup.mk' (frattini G))),
        Subgroup.map (QuotientGroup.mk' (frattini G))
          (A.comap (QuotientGroup.mk' (frattini G)))⁆ ≤ ⁅A, A⁆ :=
      Subgroup.commutator_mono (Subgroup.map_comap_le _ _) (Subgroup.map_comap_le _ _)
    rw [hAcomm, le_bot_iff] at h1
    have h2 : Subgroup.map (QuotientGroup.mk' (frattini G))
        ⁅A.comap (QuotientGroup.mk' (frattini G)),
          A.comap (QuotientGroup.mk' (frattini G))⁆ = ⊥ := by
      rw [Subgroup.map_commutator]
      exact h1
    have h3 := (Subgroup.map_eq_bot_iff _).mp h2
    rwa [QuotientGroup.ker_mk'] at h3
  have hmap : Subgroup.map (QuotientGroup.mk' (frattini G))
      (A.comap (QuotientGroup.mk' (frattini G))) = A :=
    Subgroup.map_comap_eq_self_of_surjective (QuotientGroup.mk'_surjective _) A
  have hnotle : ¬ A.comap (QuotientGroup.mk' (frattini G)) ≤ frattini G := by
    intro hle
    refine hA0 ?_
    rw [← hmap, Subgroup.map_eq_bot_iff, QuotientGroup.ker_mk']
    exact hle
  obtain ⟨U, hU, hUsup⟩ := Shafarevich.exists_proper_supplement_of_not_le_frattini hnotle
  exact ⟨A.comap (QuotientGroup.mk' (frattini G)), inferInstance, U,
    Shafarevich.isNilpotent_of_commutator_le_frattini hΦle hcomm, hU, hUsup⟩
