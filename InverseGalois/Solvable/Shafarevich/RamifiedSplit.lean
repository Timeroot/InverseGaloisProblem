import Mathlib
import InverseGalois.Solvable.Shafarevich.LocalLift
import InverseGalois.Solvable.Shafarevich.RamifiedTransport

/-!
# The restriction at a prime where the base realization splits completely

The ramification a repaired solution is allowed to acquire is ramification at primes lying over
primes of the base field which split completely in the field the base realization cuts out.  At
such a prime the first clause of the restriction — that the base realization kill the whole
decomposition subgroup — is given, and the other two follow from a single statement: that the image
of the decomposition subgroup be cyclic, generated by an element killed by the prime.

Cyclicity gives the second clause because the image of the decomposition subgroup then has prime
order as soon as the prime ramifies at all, and the image of inertia is a subgroup of it which is
not trivial, hence the whole of it: an extension which is cyclic of prime degree and ramified is
totally ramified.  It gives the third because the element bounding the image is killed by the prime,
so the roots of unity the restriction asks the decomposition subgroup to fix are those of order the
square of the prime, and those the base realization is asked to fix outright.

## Main results

* `InverseGalois.Shafarevich.isSplitTotallyRamifiedAt_of_zpowers` — **at a prime where the base
  realization splits completely, a ramified local image which is cyclic and killed by the prime
  carries the whole restriction.**
* `InverseGalois.Shafarevich.isSplitTotallyRamifiedAt_of_zpowers_of_rightHom` — for a lift across
  one layer over a solution which splits completely at the prime, being killed by the prime is
  automatic, so **cyclicity of the local image is the whole of what is left**.

## Tags

Shafarevich's theorem, embedding problem, ramification, inertia subgroup, cyclic extension
-/

namespace InverseGalois.Shafarevich

open MulAction NumberField

open InverseGalois.CFT

open scoped Pointwise

section General

variable {ℓ : ℕ} {U W : Type*} [Group U] [Group W] {k Ω : Type*} [Field k] [Field Ω] [Algebra k Ω]

/-! ### A ramified cyclic local image -/

/-- **At a prime where the base realization splits completely, a ramified local image which is
cyclic and killed by the prime carries the whole restriction.**

The generator has order the prime, since a power of it is a nontrivial value on inertia; so the
image of the decomposition subgroup has prime order and the image of inertia, being a nontrivial
subgroup of it, is the whole of it — that is the totally ramified clause.  The roots of unity clause
asks the decomposition subgroup to fix the roots of unity of order the prime times the order of the
generator, which divides the square of the prime, and the decomposition subgroup lies in the kernel
of the base realization, which fixes those outright. -/
theorem isSplitTotallyRamifiedAt_of_zpowers {φ : Gal(Ω/k) →* U} {Ψ : Gal(Ω/k) →* W}
    {P : Ideal (𝓞 Ω)} {c : W} (hp : ℓ.Prime)
    (hφ : ∀ x ∈ stabilizer Gal(Ω/k) P, φ x = 1) (hc : c ^ ℓ = 1)
    (hcyc : ∀ x ∈ stabilizer Gal(Ω/k) P, Ψ x ∈ Subgroup.zpowers c)
    (hram : ∃ y ∈ Ideal.inertia Gal(Ω/k) P, Ψ y ≠ 1)
    (hmu : ∀ ζ : Ωˣ, ζ ^ (ℓ * ℓ) = 1 → ∀ σ ∈ φ.ker, σ • ζ = ζ) :
    IsSplitTotallyRamifiedAt ℓ φ Ψ P := by
  obtain ⟨y, hyI, hy1⟩ := hram
  have hyD : y ∈ stabilizer Gal(Ω/k) P := Ideal.inertia_le_stabilizer P hyI
  have hdvd : orderOf c ∣ ℓ := orderOf_dvd_of_pow_eq_one hc
  have hydvd : orderOf (Ψ y) ∣ orderOf c := orderOf_dvd_of_mem_zpowers (hcyc y hyD)
  have hyne : orderOf (Ψ y) ≠ 1 := fun h => hy1 (orderOf_eq_one_iff.1 h)
  have hcord : orderOf c = ℓ := by
    refine (hp.eq_one_or_self_of_dvd _ hdvd).resolve_left fun h => hyne ?_
    exact Nat.dvd_one.1 (h ▸ hydvd)
  have hyord : orderOf (Ψ y) = ℓ :=
    (hp.eq_one_or_self_of_dvd _ (hcord ▸ hydvd)).resolve_left hyne
  have hcardc : Nat.card ↥(Subgroup.zpowers c) = ℓ := (Nat.card_zpowers c).trans hcord
  haveI : Finite ↥(Subgroup.zpowers c) :=
    Nat.finite_of_card_ne_zero (by rw [hcardc]; exact hp.ne_zero)
  have heq : Subgroup.zpowers (Ψ y) = Subgroup.zpowers c :=
    Subgroup.eq_of_le_of_card_ge (Subgroup.zpowers_le.2 (hcyc y hyD))
      (by rw [hcardc, Nat.card_zpowers, hyord])
  refine ⟨hφ, fun x hx => ?_, c, hcyc, fun ζ hζ x hx => ?_⟩
  · obtain ⟨i, hi⟩ := Subgroup.mem_zpowers_iff.1 (heq ▸ hcyc x hx)
    exact ⟨y ^ i, zpow_mem hyI i, by rw [_root_.map_zpow, hi]⟩
  · refine hmu ζ ?_ x (hφ x hx)
    obtain ⟨d, hd⟩ : ℓ * orderOf c ∣ ℓ * ℓ := mul_dvd_mul_left ℓ hdvd
    rw [hd, pow_mul, hζ, one_pow]

/-- **A local image generated by one of its own values needs no separate torsion hypothesis.**
The generator is a value on the decomposition subgroup, so it is killed by the prime as soon as
every value there is. -/
theorem isSplitTotallyRamifiedAt_of_zpowers_self {φ : Gal(Ω/k) →* U} {Ψ : Gal(Ω/k) →* W}
    {P : Ideal (𝓞 Ω)} (hp : ℓ.Prime)
    (hφ : ∀ x ∈ stabilizer Gal(Ω/k) P, φ x = 1)
    (hpow : ∀ x ∈ stabilizer Gal(Ω/k) P, Ψ x ^ ℓ = 1)
    (hcyc : ∃ x₀ ∈ stabilizer Gal(Ω/k) P,
      ∀ x ∈ stabilizer Gal(Ω/k) P, Ψ x ∈ Subgroup.zpowers (Ψ x₀))
    (hram : ∃ y ∈ Ideal.inertia Gal(Ω/k) P, Ψ y ≠ 1)
    (hmu : ∀ ζ : Ωˣ, ζ ^ (ℓ * ℓ) = 1 → ∀ σ ∈ φ.ker, σ • ζ = ζ) :
    IsSplitTotallyRamifiedAt ℓ φ Ψ P := by
  obtain ⟨x₀, hx₀, hgen⟩ := hcyc
  exact isSplitTotallyRamifiedAt_of_zpowers hp hφ (hpow x₀ hx₀) hgen hram hmu

end General

/-! ### A lift across one layer -/

section Level

variable {ℓ : ℕ} [Fact ℓ.Prime] {U : Type} [Group U] {n : ℕ} {S : Type} [Group S] {j : ℕ}
  {k Ω : Type*} [Field k] [Field Ω] [Algebra k Ω]

/-- **For a lift across one layer over a solution which splits completely at the prime, cyclicity
of the local image is the whole of what is left of the restriction.**

The values of the lift on the decomposition subgroup lie over the identity of the solution below,
so they come from the layer and are killed by the prime; the base realization kills the
decomposition subgroup because the solution below does. -/
theorem isSplitTotallyRamifiedAt_of_zpowers_of_rightHom {φ : Gal(Ω/k) →* U}
    {Φ : Gal(Ω/k) →* GenericQuot ℓ U n S j} {Ψ : Gal(Ω/k) →* GenericQuot ℓ U n S (j + 1)}
    {P : Ideal (𝓞 Ω)}
    (hΦright : ∀ x, SemidirectProduct.rightHom (Φ x) = φ x)
    (hΨright : ∀ x, (layerExtension ℓ (genericAut U n S) j).rightHom (Ψ x) = Φ x)
    (hΦ : ∀ x ∈ stabilizer Gal(Ω/k) P, Φ x = 1)
    (hcyc : ∃ x₀ ∈ stabilizer Gal(Ω/k) P,
      ∀ x ∈ stabilizer Gal(Ω/k) P, Ψ x ∈ Subgroup.zpowers (Ψ x₀))
    (hram : ∃ y ∈ Ideal.inertia Gal(Ω/k) P, Ψ y ≠ 1)
    (hmu : ∀ ζ : Ωˣ, ζ ^ (ℓ * ℓ) = 1 → ∀ σ ∈ φ.ker, σ • ζ = ζ) :
    IsSplitTotallyRamifiedAt ℓ φ Ψ P := by
  refine isSplitTotallyRamifiedAt_of_zpowers_self (Fact.out : ℓ.Prime) (fun x hx => ?_)
    (fun x hx => ?_) hcyc hram hmu
  · rw [← hΦright x, hΦ x hx, _root_.map_one]
  · exact pow_eq_one_of_rightHom_eq_one ℓ U n S j (by rw [hΨright x, hΦ x hx])

end Level

end InverseGalois.Shafarevich
