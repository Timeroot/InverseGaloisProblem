import Mathlib
import InverseGalois.CFT.GroupCohomology.ToCocycle

/-!
# Correcting a two-generator family into a cyclic one

A decomposition group of a number field acts on the layer of a generic level through a
homomorphism whose image is generated by at most two elements: a tame generator `τ`, whose
powers already carry the whole inertia, and one further element `σ`.  Once the second
generator is written as `σ = ι ε · τ ^ m` with `ε` a layer element of order dividing `ℓ`, the
whole image lies in the set of products `ι (ε ^ q) · τ ^ n`.

This file constructs, out of such a two-generator presentation, a homomorphism `a` into the
layer that absorbs the `ε`-coordinate: after twisting by `a` the resulting map lands in the
cyclic group generated by the image of `τ`.  The correction is normalised so that `a τ = 1`,
which is what makes the twisted map cyclic with the *prescribed* generator, and it factors
through the original homomorphism, so smoothness is inherited.

The main results are:

* `mem_zpowers_zpow_of_ne_one`, the Bézout step: a nontrivial power of an `ℓ`-torsion element
  generates the same cyclic group;
* `eq_one_of_zpow_mem`, its contrapositive form: if a power `ε ^ d` maps into the cyclic group
  generated by `t` while `ε` itself does not, then `ε ^ d = 1`;
* `exists_generator_of_forall_mem_zpowers`, which upgrades "every value is a power of `ε`" to
  "every value is a power of one of the values";
* `exists_hom_layer_cyclic`, the correction itself;
* `exists_hom_cyclic_twist`, its form for a group extension, where the two-generator presentation
  is the one a decomposition group supplies.
-/

namespace InverseGalois.Shafarevich

/-- A nontrivial power of an element of order dividing a prime `ℓ` generates the same cyclic
group: the exponent is then prime to `ℓ`, and a Bézout relation writes `ε` as a power of
`ε ^ d`. -/
theorem mem_zpowers_zpow_of_ne_one {Lay : Type*} [CommGroup Lay] {ℓ : ℕ} (hℓ : ℓ.Prime) {ε : Lay}
    (hεℓ : ε ^ ℓ = 1) {d : ℤ} (hd : ε ^ d ≠ 1) : ε ∈ Subgroup.zpowers (ε ^ d) := by
  have hdvd : ¬ (ℓ : ℤ) ∣ d := by
    rintro ⟨c, rfl⟩
    exact hd (by rw [zpow_mul, zpow_natCast, hεℓ, one_zpow])
  have hgcd : Int.gcd d (ℓ : ℤ) = 1 := by
    have hnd : ¬ ℓ ∣ d.natAbs := fun h =>
      hdvd (Int.dvd_natAbs.1 (Int.natCast_dvd_natCast.2 h))
    have hcop : Nat.Coprime d.natAbs ℓ := ((Nat.Prime.coprime_iff_not_dvd hℓ).2 hnd).symm
    simpa [Int.gcd] using hcop
  have hbez := Int.gcd_eq_gcd_ab d (ℓ : ℤ)
  rw [hgcd] at hbez
  push_cast at hbez
  refine Subgroup.mem_zpowers_iff.2 ⟨Int.gcdA d (ℓ : ℤ), ?_⟩
  have hdA : d * Int.gcdA d (ℓ : ℤ) = 1 - (ℓ : ℤ) * Int.gcdB d (ℓ : ℤ) := by
    linear_combination -hbez
  rw [← zpow_mul, hdA, zpow_sub, zpow_one, zpow_mul, zpow_natCast, hεℓ, one_zpow, inv_one,
    mul_one]

/-- If `ε` has order dividing the prime `ℓ` and its image does not lie in the cyclic group
generated by `t`, then any power of `ε` whose image does lie there is already trivial. -/
theorem eq_one_of_zpow_mem {E Lay : Type*} [Group E] [CommGroup Lay] {ℓ : ℕ} (hℓ : ℓ.Prime)
    {ι : Lay →* E} {ε : Lay} {t : E} (hεℓ : ε ^ ℓ = 1) (hne : ι ε ∉ Subgroup.zpowers t) {d : ℤ}
    (hd : ι (ε ^ d) ∈ Subgroup.zpowers t) : ε ^ d = 1 := by
  by_contra hd1
  refine hne ?_
  obtain ⟨c, hc⟩ := Subgroup.mem_zpowers_iff.1 (mem_zpowers_zpow_of_ne_one hℓ hεℓ hd1)
  rw [← hc, _root_.map_zpow]
  exact Subgroup.zpow_mem _ hd _

/-- If every value of a homomorphism `a` is a power of a fixed element `ε` of order dividing the
prime `ℓ`, then every value is a power of a single value of `a`.

Either `a` is trivial, and any argument will do, or some value `a y₀` is a nontrivial power of
`ε`, and then `ε` itself is a power of `a y₀`. -/
theorem exists_generator_of_forall_mem_zpowers {D Lay : Type*} [Group D] [CommGroup Lay] {ℓ : ℕ}
    (hℓ : ℓ.Prime) {a : D →* Lay} {ε : Lay} (hεℓ : ε ^ ℓ = 1)
    (ha : ∀ y, a y ∈ Subgroup.zpowers ε) : ∃ x₀ : D, ∀ y, a y ∈ Subgroup.zpowers (a x₀) := by
  classical
  by_cases hall : ∀ y : D, a y = 1
  · refine ⟨1, fun y => ?_⟩
    rw [hall y]
    exact Subgroup.one_mem _
  · push_neg at hall
    obtain ⟨y₀, hy₀⟩ := hall
    refine ⟨y₀, fun y => ?_⟩
    obtain ⟨d, hd⟩ := Subgroup.mem_zpowers_iff.1 (ha y₀)
    have hdne : ε ^ d ≠ 1 := by rw [hd]; exact hy₀
    have hε : ε ∈ Subgroup.zpowers (a y₀) := by
      rw [← hd]
      exact mem_zpowers_zpow_of_ne_one hℓ hεℓ hdne
    exact Subgroup.zpowers_le.2 hε (ha y)

/-- Absorb the second generator of a two-generator image into the layer.

Suppose the image of `F` consists of the products `ι (ε ^ q) * F τ ^ n`, where `ε` is an
`ℓ`-torsion element of the layer whose image commutes with `F τ`.  Then there is a homomorphism
`a` into the layer, with cyclic image, trivial at `τ`, and factoring through `F`, such that the
twist of `F` by `a` lands in the cyclic group generated by `F τ`. -/
theorem exists_hom_layer_cyclic {D E Lay : Type*} [Group D] [Group E] [CommGroup Lay] {ℓ : ℕ}
    (hℓ : ℓ.Prime) {ι : Lay →* E} {F : D →* E} (τ : D) {ε : Lay}
    (hcomm : Commute (ι ε) (F τ)) (hεℓ : ε ^ ℓ = 1)
    (hgen : ∀ y : D, ∃ q n : ℤ, F y = ι (ε ^ q) * F τ ^ n) :
    ∃ a : D →* Lay, a τ = 1 ∧ (∃ x₀ : D, ∀ y, a y ∈ Subgroup.zpowers (a x₀)) ∧
      (∀ y, ι (a y) * F y ∈ Subgroup.zpowers (F τ)) ∧
      ∀ x y, F x = F y → a x = a y := by
  by_cases hmem : ι ε ∈ Subgroup.zpowers (F τ)
  · refine ⟨1, rfl, ⟨1, fun _ => Subgroup.one_mem _⟩, fun y => ?_, fun _ _ _ => rfl⟩
    obtain ⟨c, m, hcm⟩ := hgen y
    rw [MonoidHom.one_apply, _root_.map_one, one_mul, hcm, _root_.map_zpow]
    exact Subgroup.mul_mem _ (Subgroup.zpow_mem _ hmem _)
      (Subgroup.zpow_mem _ (Subgroup.mem_zpowers _) _)
  · classical
    choose q n hqn using hgen
    set u : E := ι ε with hudef
    set t : E := F τ with htdef
    have hqn' : ∀ y : D, F y = u ^ q y * t ^ n y := by
      intro y
      rw [hqn y, hudef, _root_.map_zpow]
    have huniq : ∀ c d m p : ℤ, u ^ c * t ^ m = u ^ d * t ^ p → ε ^ c = ε ^ d := by
      intro c d m p h
      have key : u ^ (c - d) = t ^ (p - m) := by
        calc u ^ (c - d) = (u ^ d)⁻¹ * (u ^ c * t ^ m) * (t ^ m)⁻¹ := by group
          _ = (u ^ d)⁻¹ * (u ^ d * t ^ p) * (t ^ m)⁻¹ := by rw [h]
          _ = t ^ (p - m) := by group
      have hz : ε ^ (c - d) = 1 := by
        refine eq_one_of_zpow_mem hℓ hεℓ hmem ?_
        rw [_root_.map_zpow, ← hudef, key]
        exact Subgroup.mem_zpowers_iff.2 ⟨p - m, rfl⟩
      rw [zpow_sub] at hz
      exact mul_inv_eq_one.1 hz
    have hmul : ∀ x y : D, (ε ^ q (x * y))⁻¹ = (ε ^ q x)⁻¹ * (ε ^ q y)⁻¹ := by
      intro x y
      have hc : t ^ n x * u ^ q y = u ^ q y * t ^ n x := hcomm.symm.zpow_zpow (n x) (q y)
      have hstep : u ^ q (x * y) * t ^ n (x * y) = u ^ (q x + q y) * t ^ (n x + n y) := by
        calc u ^ q (x * y) * t ^ n (x * y) = F (x * y) := (hqn' (x * y)).symm
          _ = F x * F y := _root_.map_mul F x y
          _ = u ^ q x * t ^ n x * (u ^ q y * t ^ n y) := by rw [hqn' x, hqn' y]
          _ = u ^ q x * (t ^ n x * u ^ q y) * t ^ n y := by group
          _ = u ^ q x * (u ^ q y * t ^ n x) * t ^ n y := by rw [hc]
          _ = u ^ (q x + q y) * t ^ (n x + n y) := by
              rw [zpow_add, zpow_add]
              group
      rw [huniq _ _ _ _ hstep, zpow_add, mul_inv]
    refine ⟨MonoidHom.mk' (fun y => (ε ^ q y)⁻¹) hmul, ?_, ?_, fun y => ?_,
      fun x y hxy => ?_⟩
    · show (ε ^ q τ)⁻¹ = 1
      have hτ : u ^ q τ * t ^ n τ = u ^ (0 : ℤ) * t ^ (1 : ℤ) := by
        rw [← hqn' τ, zpow_zero, zpow_one, one_mul, htdef]
      rw [huniq _ _ _ _ hτ, zpow_zero, inv_one]
    · refine exists_generator_of_forall_mem_zpowers hℓ hεℓ fun y => ?_
      show (ε ^ q y)⁻¹ ∈ Subgroup.zpowers ε
      exact Subgroup.inv_mem _ (Subgroup.zpow_mem _ (Subgroup.mem_zpowers _) _)
    · show ι (ε ^ q y)⁻¹ * F y ∈ Subgroup.zpowers t
      rw [hqn' y, _root_.map_inv, _root_.map_zpow, ← hudef, ← mul_assoc, inv_mul_cancel, one_mul]
      exact Subgroup.mem_zpowers_iff.2 ⟨n y, rfl⟩
    · show (ε ^ q x)⁻¹ = (ε ^ q y)⁻¹
      rw [huniq _ _ _ _ ((hqn' x).symm.trans (hxy.trans (hqn' y)))]

/-- **A two-generator image in a group extension becomes cyclic after a twist by the kernel.**

The subgroup is asked to act trivially on the kernel, its image to be generated by the values at
two elements `τ` and `σ`, and the value at `σ` to be a power of the value at `τ` after the
extension is projected away.  Then `f σ` and that power of `f τ` differ by an element `ε` of the
kernel, which the exponent kills, and the whole image consists of the products
`inl (ε ^ q) * f τ ^ n`.  Absorbing the `ε` coordinate leaves the powers of `f τ`.

The correction is normalised at `τ`, has cyclic image generated by one of its own values, and
factors through `f`. -/
theorem exists_hom_cyclic_twist {Γ Lay E G : Type*} [Group Γ] [CommGroup Lay] [Group E] [Group G]
    {ℓ : ℕ} (hℓ : ℓ.Prime) (Ext : GroupExtension Lay E G) (hlay : ∀ v : Lay, v ^ ℓ = 1)
    {ρ : Γ →* G} {f : Γ →* E} (hf : ∀ γ : Γ, Ext.rightHom (f γ) = ρ γ) (A : Subgroup Γ)
    (hfix : ∀ x ∈ A, ∀ v : Lay, Ext.conjActHom (ρ x) v = v) {τ σ : Γ} (hτ : τ ∈ A)
    (hgen : ∀ x ∈ A, ∃ i q : ℤ, f x = f τ ^ i * f σ ^ q)
    (hcyc : ρ σ ∈ Subgroup.zpowers (ρ τ)) :
    ∃ a : ↥A →* Lay, a ⟨τ, hτ⟩ = 1 ∧
      (∃ x₀ : ↥A, ∀ x : ↥A, a x ∈ Subgroup.zpowers (a x₀)) ∧
      (∀ x : ↥A, Ext.inl (a x) * f (x : Γ) ∈ Subgroup.zpowers (f τ)) ∧
      ∀ x y : ↥A, f (x : Γ) = f (y : Γ) → a x = a y := by
  obtain ⟨m, hm⟩ := Subgroup.mem_zpowers_iff.1 hcyc
  have hker : Ext.rightHom (f σ * (f τ ^ m)⁻¹) = 1 := by
    rw [_root_.map_mul, _root_.map_inv, _root_.map_zpow, hf, hf, hm, mul_inv_cancel]
  obtain ⟨ε, hε⟩ : ∃ ε : Lay, Ext.inl ε = f σ * (f τ ^ m)⁻¹ :=
    MonoidHom.mem_range.1 (by rw [Ext.range_inl_eq_ker_rightHom]; exact hker)
  have hσε : f σ = Ext.inl ε * f τ ^ m := by
    rw [hε]
    group
  have hcomm : Commute (Ext.inl ε) (f τ) := by
    have h : f τ * Ext.inl ε * (f τ)⁻¹ = Ext.inl ε := by
      rw [← Ext.inl_conjActHom (f τ) ε, hf, hfix τ hτ ε]
    exact (mul_inv_eq_iff_eq_mul.1 h).symm
  have hgen' : ∀ y : ↥A, ∃ q n : ℤ,
      (f.comp A.subtype) y = Ext.inl (ε ^ q) * (f.comp A.subtype) ⟨τ, hτ⟩ ^ n := by
    intro y
    obtain ⟨i, q, hiq⟩ := hgen (y : Γ) y.2
    refine ⟨q, i + m * q, ?_⟩
    show f (y : Γ) = Ext.inl (ε ^ q) * f τ ^ (i + m * q)
    calc f (y : Γ) = f τ ^ i * f σ ^ q := hiq
      _ = f τ ^ i * (Ext.inl ε * f τ ^ m) ^ q := by rw [hσε]
      _ = f τ ^ i * (Ext.inl ε ^ q * (f τ ^ m) ^ q) := by rw [(hcomm.zpow_right m).mul_zpow]
      _ = Ext.inl ε ^ q * (f τ ^ i * (f τ ^ m) ^ q) := by
          rw [← mul_assoc, ← (hcomm.zpow_zpow q i).eq, mul_assoc]
      _ = Ext.inl (ε ^ q) * f τ ^ (i + m * q) := by rw [_root_.map_zpow, ← zpow_mul, ← zpow_add]
  obtain ⟨a, haτ, hacyc, hazp, hafac⟩ :=
    exists_hom_layer_cyclic (ι := Ext.inl) (F := f.comp A.subtype) hℓ ⟨τ, hτ⟩ hcomm (hlay ε) hgen'
  exact ⟨a, haτ, hacyc, hazp, hafac⟩

end InverseGalois.Shafarevich
