import Mathlib

/-!
# The descending `p`-central series

Shafarevich's induction climbs a `p`-group one *elementary abelian central layer* at a time, and the
layers it uses are those of the descending `p`-central series

`P¹ = P`,  `P^{i+1} = (P^i)^p · [P^i, P]`.

Each term is characteristic, the successive quotients are elementary abelian and central in the
corresponding quotient of `P`, and the whole filtration is natural: a homomorphism carries the
series of the source into the series of the target, onto it when the homomorphism is surjective.
Naturality is what lets the series be used on a group carrying an action by operators, since the
operators are automorphisms and therefore preserve every term.

The indexing here is shifted by one from the classical one: `pCentral p P 0 = ⊤` is the whole
group, so `pCentral p P i` is the classical `P^{i+1}`.

## Main definitions

* `InverseGalois.Shafarevich.pCentral` — the descending `p`-central series.

## Main results

* `InverseGalois.Shafarevich.map_pCentral` — a surjection carries the series onto the series.
* `InverseGalois.Shafarevich.pCentral_characteristic` — every term is characteristic.
* `InverseGalois.Shafarevich.pow_mem_pCentral_succ`,
  `InverseGalois.Shafarevich.commutatorElement_mem_pCentral_succ` — the two defining membership
  rules, which say that the successive quotients are elementary abelian and central.
* `InverseGalois.Shafarevich.exists_pCentral_eq_bot` — the series of a finite `p`-group reaches the
  trivial subgroup, so that it can serve as an induction ladder.

## Tags

p-central series, Frattini series, embedding problem, Shafarevich's theorem
-/

namespace InverseGalois.Shafarevich

variable (p : ℕ) (P Q : Type*) [Group P] [Group Q]

/-- The **descending `p`-central series** of a group, indexed so that the zeroth term is the whole
group: `pCentral p P (i + 1)` is generated by the `p`-th powers of `pCentral p P i` together with
the commutators of `pCentral p P i` with the whole group. -/
def pCentral : ℕ → Subgroup P
  | 0 => ⊤
  | n + 1 =>
      Subgroup.closure ((· ^ p) '' (pCentral n : Set P)) ⊔ ⁅pCentral n, (⊤ : Subgroup P)⁆

@[simp]
theorem pCentral_zero : pCentral p P 0 = ⊤ := rfl

theorem pCentral_succ (n : ℕ) :
    pCentral p P (n + 1) =
      Subgroup.closure ((· ^ p) '' (pCentral p P n : Set P)) ⊔
        ⁅pCentral p P n, (⊤ : Subgroup P)⁆ := rfl

variable {P Q}

/-! ### Naturality -/

theorem map_pCentral_le (f : P →* Q) (n : ℕ) : (pCentral p P n).map f ≤ pCentral p Q n := by
  induction n with
  | zero => exact le_top
  | succ n ih =>
    rw [pCentral_succ, pCentral_succ, Subgroup.map_sup, MonoidHom.map_closure,
      Subgroup.map_commutator]
    refine sup_le (((Subgroup.closure_le _).mpr ?_).trans le_sup_left)
      ((Subgroup.commutator_mono ih le_top).trans le_sup_right)
    rintro _ ⟨_, ⟨x, hx, rfl⟩, rfl⟩
    exact Subgroup.subset_closure ⟨f x, ih ⟨x, hx, rfl⟩, by simp⟩

/-- **A surjection carries the descending `p`-central series onto the descending `p`-central
series.** -/
theorem map_pCentral (f : P →* Q) (hf : Function.Surjective f) (n : ℕ) :
    (pCentral p P n).map f = pCentral p Q n := by
  induction n with
  | zero => simpa using Subgroup.map_top_of_surjective f hf
  | succ n ih =>
    have himg : (f : P → Q) '' (pCentral p P n : Set P) = (pCentral p Q n : Set Q) := by
      rw [← Subgroup.coe_map, ih]
    rw [pCentral_succ, pCentral_succ, Subgroup.map_sup, MonoidHom.map_closure,
      Subgroup.map_commutator, ih, Subgroup.map_top_of_surjective f hf]
    congr 2
    rw [← himg, ← Set.image_comp, ← Set.image_comp]
    simp

instance pCentral_characteristic (n : ℕ) : (pCentral p P n).Characteristic :=
  Subgroup.characteristic_iff_map_eq.mpr fun φ =>
    map_pCentral p φ.toMonoidHom (EquivLike.surjective φ) n

/-! ### The defining membership rules -/

theorem closure_pow_le_pCentral_succ (n : ℕ) :
    Subgroup.closure ((· ^ p) '' (pCentral p P n : Set P)) ≤ pCentral p P (n + 1) := le_sup_left

theorem pow_mem_pCentral_succ {n : ℕ} {x : P} (hx : x ∈ pCentral p P n) :
    x ^ p ∈ pCentral p P (n + 1) :=
  closure_pow_le_pCentral_succ p n (Subgroup.subset_closure ⟨x, hx, rfl⟩)

theorem commutator_le_pCentral_succ (n : ℕ) :
    ⁅pCentral p P n, (⊤ : Subgroup P)⁆ ≤ pCentral p P (n + 1) := le_sup_right

theorem commutatorElement_mem_pCentral_succ {n : ℕ} {x : P} (hx : x ∈ pCentral p P n) (y : P) :
    ⁅x, y⁆ ∈ pCentral p P (n + 1) :=
  commutator_le_pCentral_succ p n (Subgroup.commutator_mem_commutator hx (Subgroup.mem_top y))

/-- Successive terms of the `p`-central series commute with one another modulo the next term. -/
theorem commutator_pCentral_le (n m : ℕ) :
    ⁅pCentral p P n, pCentral p P m⁆ ≤ pCentral p P (n + 1) :=
  (Subgroup.commutator_mono le_rfl le_top).trans (commutator_le_pCentral_succ p n)

/-! ### Monotonicity -/

theorem pCentral_succ_le (n : ℕ) : pCentral p P (n + 1) ≤ pCentral p P n := by
  rw [pCentral_succ]
  refine sup_le ((Subgroup.closure_le _).mpr ?_) (Subgroup.commutator_le_left _ _)
  rintro _ ⟨x, hx, rfl⟩
  exact pow_mem hx p

theorem pCentral_antitone : Antitone (pCentral p P) :=
  antitone_nat_of_succ_le (pCentral_succ_le p)

theorem pCentral_le_pCentral {m n : ℕ} (h : m ≤ n) : pCentral p P n ≤ pCentral p P m :=
  pCentral_antitone p h

/-! ### The layers -/

variable (P) in
/-- The `p`-central series is generated by the `p`-th powers and the commutators taken together. -/
theorem pCentral_succ_eq_closure (n : ℕ) :
    pCentral p P (n + 1) =
      Subgroup.closure ((· ^ p) '' (pCentral p P n : Set P) ∪
        {g : P | ∃ x ∈ pCentral p P n, ∃ y : P, ⁅x, y⁆ = g}) := by
  have hset : {g : P | ∃ x ∈ pCentral p P n, ∃ y ∈ (⊤ : Subgroup P), ⁅x, y⁆ = g}
      = {g : P | ∃ x ∈ pCentral p P n, ∃ y : P, ⁅x, y⁆ = g} := by
    ext g
    simp
  rw [pCentral_succ, Subgroup.closure_union, Subgroup.commutator_def, hset]

/-- **Every layer of the descending `p`-central series is central in the corresponding
quotient.** -/
theorem map_pCentral_le_center (n : ℕ) :
    (pCentral p P n).map (QuotientGroup.mk' (pCentral p P (n + 1))) ≤
      Subgroup.center (P ⧸ pCentral p P (n + 1)) := by
  rintro _ ⟨x, hx, rfl⟩
  simp only [QuotientGroup.mk'_apply, Subgroup.mem_center_iff]
  intro z
  induction z using QuotientGroup.induction_on with
  | _ y =>
    rw [← QuotientGroup.mk_mul, ← QuotientGroup.mk_mul, QuotientGroup.eq]
    simpa [commutatorElement_def, mul_assoc] using
      commutatorElement_mem_pCentral_succ p (inv_mem hx) y⁻¹

/-! ### Termination -/

/-- An element of the subgroup generated by the `p`-th powers of a central subgroup is itself the
`p`-th power of an element of that subgroup. -/
theorem exists_pow_of_mem_closure_pow {S : Subgroup P} (hS : S ≤ Subgroup.center P) {x : P}
    (hx : x ∈ Subgroup.closure ((· ^ p) '' (S : Set P))) : ∃ y ∈ S, y ^ p = x := by
  induction hx using Subgroup.closure_induction with
  | mem z hz =>
    obtain ⟨y, hy, rfl⟩ := hz
    exact ⟨y, hy, rfl⟩
  | one => exact ⟨1, one_mem S, one_pow p⟩
  | mul z z' _ _ ihz ihz' =>
    obtain ⟨y, hy, rfl⟩ := ihz
    obtain ⟨y', hy', rfl⟩ := ihz'
    exact ⟨y * y', mul_mem hy hy',
      Commute.mul_pow (Subgroup.mem_center_iff.mp (hS hy) y').symm p⟩
  | inv z _ ihz =>
    obtain ⟨y, hy, rfl⟩ := ihz
    exact ⟨y⁻¹, inv_mem hy, inv_pow y p⟩

/-- Past a term of the series that lies in the centre, every element of the series is a `p`-power-th
power of an element of that term: only the `p`-th powers still contribute. -/
theorem exists_pow_pow_of_mem_pCentral {N : ℕ} (hN : pCentral p P N ≤ Subgroup.center P) (j : ℕ)
    {x : P} (hx : x ∈ pCentral p P (N + j)) : ∃ y ∈ pCentral p P N, y ^ p ^ j = x := by
  induction j generalizing x with
  | zero => exact ⟨x, hx, by simp⟩
  | succ j ih =>
    have hle : pCentral p P (N + j) ≤ Subgroup.center P :=
      (pCentral_le_pCentral p (Nat.le_add_right N j)).trans hN
    have hcomm : ⁅pCentral p P (N + j), (⊤ : Subgroup P)⁆ = ⊥ := by
      rw [Subgroup.commutator_eq_bot_iff_le_centralizer, Subgroup.coe_top,
        Subgroup.centralizer_univ]
      exact hle
    rw [show N + (j + 1) = N + j + 1 from rfl, pCentral_succ, hcomm, sup_bot_eq] at hx
    obtain ⟨z, hz, rfl⟩ := exists_pow_of_mem_closure_pow p hle hx
    obtain ⟨y, hy, rfl⟩ := ih hz
    exact ⟨y, hy, by rw [← pow_mul, ← pow_succ]⟩

/-- Once a term of the series lies in the centre, the series reaches the trivial subgroup within as
many further steps as the order of the group has factors of `p`. -/
theorem pCentral_add_eq_bot_of_le_center [Finite P] {N : ℕ}
    (hN : pCentral p P N ≤ Subgroup.center P) {m : ℕ} (hm : Nat.card P ∣ p ^ m) :
    pCentral p P (N + m) = ⊥ := by
  refine eq_bot_iff.mpr fun x hx => ?_
  obtain ⟨y, _, rfl⟩ := exists_pow_pow_of_mem_pCentral p hN m hx
  obtain ⟨c, hc⟩ := hm
  rw [Subgroup.mem_bot, hc, pow_mul, pow_card_eq_one', one_pow]

private theorem exists_pCentral_eq_bot_aux [Fact p.Prime] (M : ℕ) :
    ∀ (R : Type*) [Group R] [Finite R], IsPGroup p R → Nat.card R ≤ M →
      ∃ n, pCentral p R n = ⊥ := by
  induction M with
  | zero =>
    intro R _ _ _ hcard
    exact absurd hcard (Nat.not_le.mpr Nat.card_pos)
  | succ M ih =>
    intro R _ _ hR hcard
    rcases subsingleton_or_nontrivial R with hs | hn
    · exact ⟨0, eq_bot_iff.mpr fun x _ => by rw [Subgroup.mem_bot]; exact hs.elim x 1⟩
    · haveI := hn
      haveI : Nontrivial ↥(Subgroup.center R) := hR.center_nontrivial
      have hprod : Nat.card R
          = Nat.card (R ⧸ Subgroup.center R) * Nat.card ↥(Subgroup.center R) :=
        Subgroup.card_eq_card_quotient_mul_card_subgroup _
      have hlt : Nat.card (R ⧸ Subgroup.center R) < Nat.card R := by
        rw [hprod, lt_mul_iff_one_lt_right Nat.card_pos]
        exact Finite.one_lt_card_iff_nontrivial.mpr inferInstance
      obtain ⟨N, hN⟩ := ih (R ⧸ Subgroup.center R) (hR.to_quotient _) (by omega)
      have hsurj : Function.Surjective (QuotientGroup.mk' (Subgroup.center R)) :=
        QuotientGroup.mk'_surjective _
      have hle : pCentral p R N ≤ Subgroup.center R := by
        intro x hx
        have hx' : QuotientGroup.mk' (Subgroup.center R) x
            ∈ (pCentral p R N).map (QuotientGroup.mk' (Subgroup.center R)) := ⟨x, hx, rfl⟩
        rw [map_pCentral p (QuotientGroup.mk' (Subgroup.center R)) hsurj N, hN, Subgroup.mem_bot,
          QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff] at hx'
        exact hx'
      obtain ⟨m, hm⟩ := hR.exists_card_eq
      exact ⟨N + m, pCentral_add_eq_bot_of_le_center p hle ⟨1, by rw [hm, mul_one]⟩⟩

/-- **The descending `p`-central series of a finite `p`-group reaches the trivial subgroup.**  This
is what makes the series usable as an induction ladder. -/
theorem exists_pCentral_eq_bot [Fact p.Prime] [Finite P] (hP : IsPGroup p P) :
    ∃ n, pCentral p P n = ⊥ :=
  exists_pCentral_eq_bot_aux p (Nat.card P) P hP le_rfl

end InverseGalois.Shafarevich
