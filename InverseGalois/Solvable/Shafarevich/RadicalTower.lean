import Mathlib
import InverseGalois.Rigidity.RET.KummerBase

/-!
# The radical extension generated by the conjugates of an element

Adjoining a single radical to a Galois extension `N / F` destroys normality over `F`: the
conjugates of the radical over `F` are radicals of the conjugates of the radicand, and they are
missing.  Adjoining the radicals of the *whole orbit* repairs this, and the resulting field is
again Galois over `F`.

The proof exhibits the multi-radical field as a splitting field over `F`.  If the conjugates
`σ b` of `b` are pairwise distinct then `b` generates `N`, so its minimal polynomial `m` over `F`
has degree `[N : F]` and factors over `N` as the product of the `X - σ b`.  Substituting `X ^ p`
therefore turns `m` into the very polynomial `∏ (X ^ p - σ b)` whose splitting field over `N` is
the multi-radical extension, and a splitting field of `m ∘ X ^ p` over `F` is what that
multi-radical extension is.

## Main results

* `InverseGalois.Shafarevich.adjoin_simple_eq_top_of_injective` — an element whose conjugates are
  distinct generates the whole extension.
* `InverseGalois.Shafarevich.map_minpoly_eq_prod_conj` — its minimal polynomial factors over the
  extension as the product of the linear factors given by its conjugates.
* `InverseGalois.Shafarevich.isSplittingField_conjRadExt` — the multi-radical extension attached to
  the orbit of such an element is a splitting field over the base field, hence
* `InverseGalois.Shafarevich.isGalois_conjRadExt` — it is a Galois extension of the base field.

## Tags

Galois extension, radical extension, splitting field, minimal polynomial, conjugates
-/

noncomputable section

open Polynomial IntermediateField Rigidity.RET.Kummer

namespace InverseGalois.Shafarevich

/-! ### An element with distinct conjugates -/

section Conjugates

variable {F N : Type*} [Field F] [Field N] [Algebra F N] [FiniteDimensional F N] [IsGalois F N]

/-- **An element of a Galois extension whose conjugates are pairwise distinct generates it.**  Its
stabilizer is trivial, so the subgroup fixing the field it generates is trivial, and the Galois
correspondence identifies that field with the whole extension. -/
theorem adjoin_simple_eq_top_of_injective {b : N}
    (hinj : Function.Injective fun σ : N ≃ₐ[F] N => σ b) : F⟮b⟯ = ⊤ := by
  have hfix : IntermediateField.fixingSubgroup F⟮b⟯ = ⊥ := by
    rw [eq_bot_iff]
    intro σ hσ
    rw [IntermediateField.mem_fixingSubgroup_iff] at hσ
    have h1 : σ b = b := hσ b (IntermediateField.mem_adjoin_simple_self F b)
    exact Subgroup.mem_bot.mpr (hinj (show σ b = (1 : N ≃ₐ[F] N) b from h1))
  rw [← IsGalois.fixedField_fixingSubgroup F⟮b⟯, hfix, IntermediateField.fixedField_bot]

/-- **The minimal polynomial of an element with distinct conjugates has the degree of the whole
extension.** -/
theorem natDegree_minpoly_eq_finrank {b : N}
    (hinj : Function.Injective fun σ : N ≃ₐ[F] N => σ b) :
    (minpoly F b).natDegree = Module.finrank F N := by
  rw [← IntermediateField.adjoin.finrank (IsIntegral.of_finite F b),
    adjoin_simple_eq_top_of_injective hinj, IntermediateField.finrank_top']

/-- **The minimal polynomial of an element with distinct conjugates splits over the extension as
the product over its orbit.** -/
theorem map_minpoly_eq_prod_conj {b : N}
    (hinj : Function.Injective fun σ : N ≃ₐ[F] N => σ b) :
    (minpoly F b).map (algebraMap F N) = ∏ σ : N ≃ₐ[F] N, (X - C (σ b)) := by
  classical
  have hint : IsIntegral F b := IsIntegral.of_finite F b
  set M := (minpoly F b).map (algebraMap F N) with hMdef
  have hmonic : M.Monic := (minpoly.monic hint).map _
  have hM0 : M ≠ 0 := hmonic.ne_zero
  have hroot : ∀ σ : N ≃ₐ[F] N, M.IsRoot (σ b) := by
    intro σ
    have h1 : Polynomial.aeval (σ.toAlgHom b) (minpoly F b)
        = σ.toAlgHom (Polynomial.aeval b (minpoly F b)) :=
      Polynomial.aeval_algHom_apply σ.toAlgHom b (minpoly F b)
    rw [minpoly.aeval, map_zero] at h1
    simpa [Polynomial.IsRoot, hMdef, Polynomial.eval_map, ← Polynomial.aeval_def] using h1
  set s : Multiset N := (Finset.univ : Finset (N ≃ₐ[F] N)).val.map fun σ => σ b with hsdef
  have hnodup : s.Nodup := Finset.univ.nodup.map hinj
  have hle : s ≤ M.roots := by
    refine (Multiset.le_iff_subset hnodup).mpr fun a ha => ?_
    simp only [hsdef, Multiset.mem_map, Finset.mem_val, Finset.mem_univ, true_and] at ha
    obtain ⟨σ, rfl⟩ := ha
    exact (Polynomial.mem_roots hM0).mpr (hroot σ)
  have hcards : Multiset.card s = Module.finrank F N := by
    rw [hsdef, Multiset.card_map]
    simpa using IsGalois.card_aut_eq_finrank F N
  have hdeg : M.natDegree = Module.finrank F N := by
    rw [hMdef, (minpoly.monic hint).natDegree_map, natDegree_minpoly_eq_finrank hinj]
  have hcard_le : Multiset.card M.roots ≤ M.natDegree := Polynomial.card_roots' M
  have heq : s = M.roots := Multiset.eq_of_le_of_card_le hle (by omega)
  have hprod := Polynomial.prod_multiset_X_sub_C_of_monic_of_roots_card_eq hmonic
    (by rw [← heq, hcards, hdeg])
  rw [← hprod, ← heq, hsdef, Multiset.map_map, Finset.prod]
  rfl

end Conjugates

/-! ### The multi-radical extension attached to an orbit -/

section Tower

variable (F : Type*) [Field F] {N : Type*} [Field N] [Algebra F N] [FiniteDimensional F N]
  [IsGalois F N] (p : ℕ) [NeZero p] (b : N)

/-- **The extension generated by `p`-th roots of all the conjugates of an element.** -/
abbrev ConjRadExt : Type _ := RadExt p fun σ : N ≃ₐ[F] N => σ b

variable {F p b}

omit [IsGalois F N] [NeZero p] in
/-- Adjoining a radical of every conjugate splits the polynomial obtained from the product of the
linear factors by substituting a `p`-th power. -/
theorem map_prod_conj_comp :
    (∏ σ : N ≃ₐ[F] N, ((X : N[X]) - C (σ b))).comp (X ^ p)
      = radPoly p fun σ : N ≃ₐ[F] N => σ b := by
  rw [Polynomial.prod_comp]
  refine Finset.prod_congr rfl fun σ _ => ?_
  rw [Polynomial.sub_comp, Polynomial.X_comp, Polynomial.C_comp]

/-- Every root of the multi-radical polynomial is a root of the minimal polynomial with `X ^ p`
substituted. -/
theorem rootSet_radPoly_subset (hinj : Function.Injective fun σ : N ≃ₐ[F] N => σ b) :
    (radPoly p fun σ : N ≃ₐ[F] N => σ b).rootSet (ConjRadExt F p b) ⊆
      ((minpoly F b).comp (X ^ p)).rootSet (ConjRadExt F p b) := by
  intro x hx
  rw [Polynomial.mem_rootSet] at hx ⊢
  obtain ⟨-, hx0⟩ := hx
  refine ⟨((minpoly.monic (IsIntegral.of_finite F b)).comp (monic_X_pow p)
    (by simpa using NeZero.ne p)).ne_zero, ?_⟩
  have hx0' : (Polynomial.aeval x) (∏ σ : N ≃ₐ[F] N, ((X : N[X]) ^ p - C (σ b))) = 0 := hx0
  have hxp : ∏ σ : N ≃ₐ[F] N, (x ^ p - algebraMap N (ConjRadExt F p b) (σ b)) = 0 := by
    rw [map_prod] at hx0'
    simpa using hx0'
  rw [Finset.prod_eq_zero_iff] at hxp
  obtain ⟨σ, -, hσ⟩ := hxp
  rw [sub_eq_zero] at hσ
  rw [Polynomial.aeval_comp, map_pow, Polynomial.aeval_X, hσ]
  have h1 : Polynomial.aeval (algebraMap N (ConjRadExt F p b) (σ b)) (minpoly F b)
      = algebraMap N (ConjRadExt F p b) (Polynomial.aeval (σ b) (minpoly F b)) :=
    Polynomial.aeval_algHom_apply (IsScalarTower.toAlgHom F N (ConjRadExt F p b)) (σ b)
      (minpoly F b)
  rw [h1]
  have h2 : (minpoly F b).map (algebraMap F N) = ∏ τ : N ≃ₐ[F] N, (X - C (τ b)) :=
    map_minpoly_eq_prod_conj hinj
  have h3 : Polynomial.aeval (σ b) (minpoly F b) = 0 := by
    have := Polynomial.aeval_algHom_apply σ.toAlgHom b (minpoly F b)
    rw [minpoly.aeval, map_zero] at this
    exact this
  rw [h3, map_zero]

/-- **The multi-radical extension attached to the orbit of an element with distinct conjugates is a
splitting field over the base field.** -/
theorem isSplittingField_conjRadExt (hinj : Function.Injective fun σ : N ≃ₐ[F] N => σ b) :
    IsSplittingField F (ConjRadExt F p b) ((minpoly F b).comp (X ^ p)) := by
  classical
  set g : (N ≃ₐ[F] N) → N := fun σ => σ b with hgdef
  set L := ConjRadExt F p b with hLdef
  have hmap : ((minpoly F b).comp (X ^ p)).map (algebraMap F N) = radPoly p g := by
    rw [Polynomial.map_comp, Polynomial.map_pow, Polynomial.map_X,
      map_minpoly_eq_prod_conj hinj, map_prod_conj_comp]
  refine ⟨?_, ?_⟩
  · have h1 : ((minpoly F b).comp (X ^ p)).map (algebraMap F L)
        = (((minpoly F b).comp (X ^ p)).map (algebraMap F N)).map (algebraMap N L) := by
      rw [Polynomial.map_map, ← IsScalarTower.algebraMap_eq]
    rw [h1, hmap]
    exact Polynomial.SplittingField.splits (radPoly p g)
  · -- the roots of the multi-radical polynomial already generate over `N`
    set S : Set L := (radPoly p g).rootSet L with hSdef
    set A : Subalgebra F L := Algebra.adjoin F (((minpoly F b).comp (X ^ p)).rootSet L) with hAdef
    have hSA : S ⊆ (A : Set L) :=
      fun x hx => Algebra.subset_adjoin (rootSet_radPoly_subset hinj hx)
    -- a radical of `b` itself lies in `A`, hence so does all of `N`
    obtain ⟨x, hxroot, hxpow⟩ : ∃ x : L, x ∈ S ∧ x ^ p = algebraMap N L b := by
      refine ⟨radRoot p g 1, ?_, by simpa [hgdef] using radRoot_pow (n := p) (g := g) 1⟩
      rw [hSdef, Polynomial.mem_rootSet]
      refine ⟨radPoly_ne_zero, ?_⟩
      show (Polynomial.aeval (radRoot p g 1))
        (∏ σ : N ≃ₐ[F] N, ((X : N[X]) ^ p - C (g σ))) = 0
      rw [map_prod]
      refine Finset.prod_eq_zero (Finset.mem_univ (1 : N ≃ₐ[F] N)) ?_
      rw [map_sub, map_pow, Polynomial.aeval_X, Polynomial.aeval_C,
        radRoot_pow (n := p) (g := g) 1, sub_self]
    have hbA : algebraMap N L b ∈ A := by
      rw [← hxpow]
      exact pow_mem (hSA hxroot) p
    have hrange : (IsScalarTower.toAlgHom F N L).range ≤ A := by
      have h1 : Algebra.adjoin F (algebraMap N L '' {b}) = (Algebra.adjoin F {b}).map
          (IsScalarTower.toAlgHom F N L) := Algebra.adjoin_algebraMap F L ({b} : Set N)
      have h2 : Algebra.adjoin F ({b} : Set N) = ⊤ := by
        rw [← IntermediateField.adjoin_simple_toSubalgebra_of_isAlgebraic
          (IsAlgebraic.of_finite F b), adjoin_simple_eq_top_of_injective hinj]
        rfl
      rw [h2, Algebra.map_top] at h1
      rw [← h1]
      refine Algebra.adjoin_le ?_
      rintro _ ⟨y, rfl, rfl⟩
      exact hbA
    have htop : (Algebra.adjoin N S).restrictScalars F
        = (IsScalarTower.toAlgHom F N L).range ⊔ Algebra.adjoin F S :=
      Algebra.Subalgebra.restrictScalars_adjoin F
    rw [Polynomial.SplittingField.adjoin_rootSet, Subalgebra.restrictScalars_top] at htop
    refine top_le_iff.mp ?_
    rw [htop]
    exact sup_le hrange (Algebra.adjoin_le hSA)

/-- **The multi-radical extension attached to the orbit of an element with distinct conjugates is
Galois over the base field.** -/
theorem isGalois_conjRadExt [CharZero F] (hinj : Function.Injective fun σ : N ≃ₐ[F] N => σ b) :
    IsGalois F (ConjRadExt F p b) := by
  haveI := isSplittingField_conjRadExt (F := F) (p := p) (b := b) hinj
  haveI : FiniteDimensional F (ConjRadExt F p b) :=
    Polynomial.IsSplittingField.finiteDimensional _ ((minpoly F b).comp (X ^ p))
  haveI : Normal F (ConjRadExt F p b) :=
    Normal.of_isSplittingField ((minpoly F b).comp (X ^ p))
  haveI : CharZero (ConjRadExt F p b) := charZero_of_injective_algebraMap
    (algebraMap F (ConjRadExt F p b)).injective
  exact ⟨⟩

end Tower

end InverseGalois.Shafarevich

end
