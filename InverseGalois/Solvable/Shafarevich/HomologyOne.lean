import Mathlib
import InverseGalois.Solvable.Shafarevich.Layer

/-!
# The first homology of a group with coefficients killed by `p`

For a representation on which the group acts trivially, the first homology is generated by the
classes of the cycles carried by a single group element.  When the coefficients are killed by `p`,
such a class only depends on the class of that group element in the zeroth layer of the descending
`p`-central series, because a commutator and a `p`-th power both give zero.  The first homology is
therefore a quotient of the zeroth layer tensored with the coefficients, and the resulting
presentation is compatible with changing the group and the coefficients at the same time.

This is the universal coefficient formula in the only shape the shrinking argument needs it: it
turns a homology class of the kernel of an embedding problem into a tensor whose factors are layers,
which is exactly what the Chevalley–Warning count operates on.

## Main definitions

* `InverseGalois.Shafarevich.h1Single` — the first homology class of the cycle carried by a single
  group element.
* `InverseGalois.Shafarevich.h1Mk` — the induced linear map from the zeroth layer tensored with the
  coefficients to the first homology.

## Main results

* `InverseGalois.Shafarevich.h1Mk_surjective` — **the zeroth layer tensored with the coefficients
  covers the first homology.**
* `InverseGalois.Shafarevich.map_h1Mk` — that covering is compatible with a homomorphism of groups
  and a morphism of coefficients.

## Tags

group homology, universal coefficients, p-central series, Shafarevich's theorem
-/

open Finsupp

open scoped TensorProduct

namespace InverseGalois.Shafarevich

section Trivial

variable {ℓ : ℕ} {G H : Type} [Group G] [Group H] {A : Rep (ZMod ℓ) G} {B : Rep (ZMod ℓ) H}

/-! ### The class of a single group element -/

/-- The class in the first homology of the cycle carried by a single group element. -/
noncomputable def h1Single [A.IsTrivial] (g : G) (a : A) : groupHomology.H1 A :=
  groupHomology.H1π A ((groupHomology.cycles₁IsoOfIsTrivial A).inv (single g a))

variable [A.IsTrivial]

theorem mkH1OfIsTrivial_eq (g : G) (a : A) :
    groupHomology.mkH1OfIsTrivial A (Additive.ofMul (Abelianization.of g)) a = h1Single g a := rfl

theorem h1Single_one (a : A) : h1Single (1 : G) a = 0 :=
  (groupHomology.H1π_eq_zero_iff _).2 (groupHomology.single_one_mem_boundaries₁ _)

theorem h1Single_mul (g h : G) (a : A) :
    h1Single (g * h) a = h1Single g a + h1Single h a := by
  have hx : (Additive.ofMul (Abelianization.of (g * h)) : Additive (Abelianization G))
      = Additive.ofMul (Abelianization.of g) + Additive.ofMul (Abelianization.of h) := by
    rw [map_mul]; rfl
  simp only [← mkH1OfIsTrivial_eq, hx, map_add, LinearMap.add_apply]

/-- The first homology class of a single group element, as a linear map in the coefficient. -/
noncomputable def h1SingleLinear (g : G) : A →ₗ[ZMod ℓ] groupHomology.H1 A :=
  AddMonoidHom.toZModLinearMap ℓ
    (groupHomology.mkH1OfIsTrivial A (Additive.ofMul (Abelianization.of g))).toAddMonoidHom

@[simp]
theorem h1SingleLinear_apply (g : G) (a : A) : h1SingleLinear g a = h1Single g a := rfl

/-- The first homology class of a single group element, as a homomorphism in that element. -/
noncomputable def h1SingleHom : G →* Multiplicative (A →ₗ[ZMod ℓ] groupHomology.H1 A) where
  toFun g := Multiplicative.ofAdd (h1SingleLinear g)
  map_one' := congrArg Multiplicative.ofAdd (LinearMap.ext fun a => h1Single_one a)
  map_mul' g h := congrArg Multiplicative.ofAdd (LinearMap.ext fun a => h1Single_mul g h a)

/-! ### The zeroth layer covers the first homology -/

/-- **The first homology of a trivial representation killed by `p`, presented by the zeroth layer of
the descending `p`-central series tensored with the coefficients.** -/
noncomputable def h1Mk : Layer ℓ G 0 ⊗[ZMod ℓ] A →ₗ[ZMod ℓ] groupHomology.H1 A :=
  TensorProduct.lift (layerZeroLift (h1SingleHom (A := A)))

@[simp]
theorem h1Mk_tmul (g : G) (a : A) : h1Mk (layerZeroMk ℓ g ⊗ₜ[ZMod ℓ] a) = h1Single g a := rfl

/-- **Every first homology class of a trivial representation killed by `p` comes from the zeroth
layer tensored with the coefficients.** -/
theorem h1Mk_surjective : Function.Surjective (h1Mk (A := A)) := by
  have hab : ∀ y : Abelianization G, ∃ g : G, Abelianization.of g = y := fun y =>
    QuotientGroup.induction_on y fun g => ⟨g, rfl⟩
  have key : ∀ y : Additive (Abelianization G) ⊗[ℤ] A,
      ∃ z, h1Mk z = (groupHomology.H1AddEquivOfIsTrivial A).symm y := by
    intro y
    induction y using TensorProduct.induction_on with
    | zero => exact ⟨0, by simp⟩
    | tmul x a =>
        obtain ⟨g, hg⟩ := hab (Additive.toMul x)
        have hx : x = Additive.ofMul (Abelianization.of g) := by simp [hg]
        refine ⟨layerZeroMk ℓ g ⊗ₜ[ZMod ℓ] a, ?_⟩
        rw [hx, groupHomology.H1AddEquivOfIsTrivial_symm_tmul, h1Mk_tmul]
        rfl
    | add y z hy hz =>
        obtain ⟨u, hu⟩ := hy
        obtain ⟨v, hv⟩ := hz
        exact ⟨u + v, by rw [map_add, hu, hv, map_add]⟩
  intro c
  obtain ⟨z, hz⟩ := key (groupHomology.H1AddEquivOfIsTrivial A c)
  exact ⟨z, by rw [hz, AddEquiv.symm_apply_apply]⟩

/-! ### Compatibility with a change of group and coefficients -/

variable [B.IsTrivial]

/-- The class of a single group element is carried to the class of its image. -/
theorem map_h1Single (f : G →* H) (φ : A ⟶ (Action.res _ f).obj B) (g : G) (a : A) :
    groupHomology.map f φ 1 (h1Single g a) = h1Single (f g) (φ.hom a) := by
  rw [h1Single, groupHomology.H1π_comp_map_apply]
  refine congrArg (groupHomology.H1π B) (Subtype.ext ?_)
  rw [groupHomology.coe_mapCycles₁, groupHomology.cycles₁IsoOfIsTrivial_inv_apply,
    groupHomology.cycles₁IsoOfIsTrivial_inv_apply]
  simp

/-- **The presentation of the first homology by the zeroth layer is compatible with a homomorphism
of groups and a morphism of coefficients.** -/
theorem map_h1Mk (f : G →* H) (φ : A ⟶ (Action.res _ f).obj B) (v : Layer ℓ G 0 ⊗[ZMod ℓ] A) :
    groupHomology.map f φ 1 (h1Mk v)
      = h1Mk (TensorProduct.map (layerLinear ℓ f 0) φ.hom.hom v) := by
  induction v using TensorProduct.induction_on with
  | zero => simp
  | tmul v a =>
      obtain ⟨g, rfl⟩ := exists_layerZeroMk v
      rw [TensorProduct.map_tmul, layerLinear_apply, layerMap_layerZeroMk, h1Mk_tmul, h1Mk_tmul]
      exact map_h1Single f φ g a
  | add v w hv hw => simp only [map_add, hv, hw]

end Trivial

end InverseGalois.Shafarevich
