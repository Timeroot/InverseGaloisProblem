import Mathlib
import InverseGalois.Solvable.Shafarevich.FlatPlaces
import InverseGalois.Solvable.Shafarevich.ReachableBlocks
import InverseGalois.Solvable.Shafarevich.ReachableKummer

/-!
# Spending the shrinking on a level which reaches every place

Reachability of every place of a level was traded for a disjointness: the level in which the
confinement is read has to meet a field of radicals, depending on the level below alone, in nothing
beyond the level below.  Read through the Galois correspondence that disjointness is a statement
about subgroups, namely that the subgroup fixing the level below is generated by the two subgroups
fixing the two fields, and the shrinking is what buys it.

The letters of the source are read in blocks.  Each block generates a subgroup of the lift, the
blocks jointly generate the part of the lift lying over nothing, which is exactly the subgroup the
level below cuts out, and the shrinking belonging to one block kills the subgroups of all the
others.  So the level attached to a block contains every other block's subgroup, and if the level
attached to each block in turn failed to fill up the level below together with the field of
radicals, the subgroups accumulated block by block would form a strictly increasing chain.  Such a
chain, read in the finite Galois group of the field of radicals — which it is legitimate to read it
in, the subgroup fixing that field lying at the bottom of the chain — cannot be longer than the
order of that group.  Announcing that many blocks therefore forces one of them to work.

Nothing in the counting depends on the lift, only on the field of radicals, which depends on the
level below and on the set of places the units are asked to be local powers at; so the number of
letters can be announced before the lift is handed over, once that set is named, which is the
shape the demand is made in.

## Main definitions

* `InverseGalois.Shafarevich.genericQuotInl` — the letters of a generic operator group, read inside
  the semidirect product a lift lands in.
* `InverseGalois.Shafarevich.blockLift` — the subgroup of the lift generated by one block.

## Main results

* `InverseGalois.Shafarevich.exists_iSup_ne_sup_ge`: **one of finitely many subgroups can be
  dropped** from a supremum taken together with a subgroup containing the kernel of a homomorphism
  to a finite group, as soon as there are more of them than the order of that group.
* `InverseGalois.Shafarevich.inf_le_of_fixingSubgroup_le_sup`: two fields whose fixing subgroups
  generate the fixing subgroup of a third meet inside that third.
* `InverseGalois.Shafarevich.exists_block_ker_sup_ge`: **some block's level fills up the level below
  together with a prescribed subgroup.**
* `InverseGalois.Shafarevich.exists_hasReachableLevel`: **the shrinking can be spent on a level
  reaching every place of the level below**, for any prime and any level holding the roots of
  unity.

## Tags

Shafarevich's theorem, embedding problem, shrinking, block, Kummer theory, Galois correspondence
-/

namespace InverseGalois.Shafarevich

open InverseGalois.CFT IsDedekindDomain NumberField

/-! ### A chain of subgroups read in a finite quotient -/

section Chain

variable {G : Type*} [Group G] {Γ : Type*} [Group Γ] [Finite Γ]

/-- A proper subgroup of a finite group is smaller than the one containing it. -/
theorem card_lt_card_of_lt {H N : Subgroup Γ} (h : H < N) : Nat.card ↥H < Nat.card ↥N := by
  have hsub : (H : Set Γ) ⊂ (N : Set Γ) := SetLike.coe_ssubset_coe.2 h
  simpa using Set.Finite.card_lt_card (Set.toFinite _) hsub

/-- **One of finitely many subgroups can be dropped** from their supremum, read together with a
subgroup containing the kernel of a homomorphism to a finite group, as soon as there are more of
them than the order of that group.

Were every one of them indispensable, adjoining them one at a time would give a chain of subgroups
each strictly inside the next, all containing the kernel; such a chain stays strictly increasing
when carried into the finite group, and so cannot be longer than the order of that group. -/
theorem exists_iSup_ne_sup_ge {r : ℕ} (𝔅 : Fin r → Subgroup G) (B : Subgroup G) (ρ : G →* Γ)
    (hker : ρ.ker ≤ B) (hr : Nat.card Γ ≤ r) :
    ∃ b : Fin r, (⨆ c, 𝔅 c) ≤ (⨆ c, ⨆ _ : c ≠ b, 𝔅 c) ⊔ B := by
  by_contra hcon
  push_neg at hcon
  have hnot : ∀ b : Fin r, ¬ 𝔅 b ≤ (⨆ c, ⨆ _ : c ≠ b, 𝔅 c) ⊔ B := by
    intro b hb
    refine hcon b (iSup_le fun c => ?_)
    by_cases hcb : c = b
    · rw [hcb]
      exact hb
    · exact le_sup_of_le_left (le_iSup₂ (f := fun (c : Fin r) (_ : c ≠ b) => 𝔅 c) c hcb)
  set Y : ℕ → Subgroup G := fun i => (⨆ c : Fin r, ⨆ _ : (c : ℕ) < i, 𝔅 c) ⊔ B
  have hmono : ∀ i : ℕ, Y i ≤ Y (i + 1) := by
    intro i
    show (⨆ c : Fin r, ⨆ _ : (c : ℕ) < i, 𝔅 c) ⊔ B
      ≤ (⨆ c : Fin r, ⨆ _ : (c : ℕ) < i + 1, 𝔅 c) ⊔ B
    refine sup_le_sup_right (iSup₂_le fun c hc => ?_) B
    exact le_iSup₂ (f := fun (c : Fin r) (_ : (c : ℕ) < i + 1) => 𝔅 c) c
      (hc.trans (Nat.lt_succ_self i))
  have hkerY : ∀ i : ℕ, ρ.ker ≤ Y i := by
    intro i
    show ρ.ker ≤ (⨆ c : Fin r, ⨆ _ : (c : ℕ) < i, 𝔅 c) ⊔ B
    exact hker.trans le_sup_right
  have hstrict : ∀ i : ℕ, i < r → Y i < Y (i + 1) := by
    intro i hi
    refine lt_of_le_of_ne (hmono i) fun heq => hnot ⟨i, hi⟩ ?_
    have hb : 𝔅 ⟨i, hi⟩ ≤ Y (i + 1) := by
      show 𝔅 ⟨i, hi⟩ ≤ (⨆ c : Fin r, ⨆ _ : (c : ℕ) < i + 1, 𝔅 c) ⊔ B
      exact le_sup_of_le_left
        (le_iSup₂ (f := fun (c : Fin r) (_ : (c : ℕ) < i + 1) => 𝔅 c) ⟨i, hi⟩ (Nat.lt_succ_self i))
    rw [← heq] at hb
    have hYi : Y i ≤ (⨆ c, ⨆ _ : c ≠ (⟨i, hi⟩ : Fin r), 𝔅 c) ⊔ B := by
      show (⨆ c : Fin r, ⨆ _ : (c : ℕ) < i, 𝔅 c) ⊔ B ≤ _
      refine sup_le_sup_right (iSup₂_le fun c hc => ?_) B
      have hcne : c ≠ (⟨i, hi⟩ : Fin r) := by
        intro hcb
        rw [hcb] at hc
        exact lt_irrefl i hc
      exact le_iSup₂ (f := fun (c : Fin r) (_ : c ≠ (⟨i, hi⟩ : Fin r)) => 𝔅 c) c hcne
    exact hb.trans hYi
  have hcard : ∀ i : ℕ, i ≤ r → i + 1 ≤ Nat.card ↥(Subgroup.map ρ (Y i)) := by
    intro i
    induction i with
    | zero => exact fun _ => Nat.card_pos
    | succ i ih =>
      intro hi
      have hi' : i < r := Nat.lt_of_succ_le hi
      have hlt : Subgroup.map ρ (Y i) < Subgroup.map ρ (Y (i + 1)) := by
        refine lt_of_le_of_ne (Subgroup.map_mono (hmono i)) fun heq => (hstrict i hi').ne ?_
        rw [← Subgroup.comap_map_eq_self (f := ρ) (hkerY i),
          ← Subgroup.comap_map_eq_self (f := ρ) (hkerY (i + 1)), heq]
      exact Nat.succ_le_of_lt (lt_of_le_of_lt (ih (le_of_lt hi')) (card_lt_card_of_lt hlt))
  have hfin := hcard r le_rfl
  have hle : Nat.card ↥(Subgroup.map ρ (Y r)) ≤ Nat.card Γ := Subgroup.card_le_card_group _
  omega

end Chain

/-! ### Preimages of a supremum -/

section Comap

variable {G H : Type*} [Group G] [Group H]

/-- The preimage of a supremum of subgroups along a surjection is the supremum of the preimages,
read together with the kernel. -/
theorem comap_iSup_le {f : G →* H} (hf : Function.Surjective f) {ι : Sort*} (X : ι → Subgroup H) :
    Subgroup.comap f (⨆ i, X i) ≤ (⨆ i, Subgroup.comap f (X i)) ⊔ f.ker := by
  intro x hx
  have hle : (⨆ i, X i) ≤ Subgroup.map f ((⨆ i, Subgroup.comap f (X i)) ⊔ f.ker) := by
    refine iSup_le fun i => ?_
    rw [← Subgroup.map_comap_eq_self_of_surjective hf (X i)]
    exact Subgroup.map_mono
      (le_sup_of_le_left (le_iSup (fun i => Subgroup.comap f (X i)) i))
  have hmem : x ∈ Subgroup.comap f
      (Subgroup.map f ((⨆ i, Subgroup.comap f (X i)) ⊔ f.ker)) := hle hx
  rwa [Subgroup.comap_map_eq_self (f := f) le_sup_right] at hmem

end Comap

/-! ### Two fields meeting inside a third -/

section Fields

variable {k Ω : Type*} [Field k] [Field Ω] [Algebra k Ω] [IsGalois k Ω]

/-- **Two fields whose fixing subgroups generate the fixing subgroup of a third meet inside that
third.**

An element of both is fixed by both fixing subgroups, hence by everything they generate, hence by
the fixing subgroup of the third; and the field fixed by the subgroup fixing a field is that field
again. -/
theorem inf_le_of_fixingSubgroup_le_sup {K E M : IntermediateField k Ω}
    (h : K.fixingSubgroup ≤ E.fixingSubgroup ⊔ M.fixingSubgroup) : E ⊓ M ≤ K := by
  intro x hx
  rw [← InfiniteGalois.fixedField_fixingSubgroup K, IntermediateField.mem_fixedField_iff]
  intro σ hσ
  have hE : E.fixingSubgroup ≤ MulAction.stabilizer Gal(Ω/k) x := fun τ hτ =>
    (IntermediateField.mem_fixingSubgroup_iff _ _).1 hτ x hx.1
  have hM : M.fixingSubgroup ≤ MulAction.stabilizer Gal(Ω/k) x := fun τ hτ =>
    (IntermediateField.mem_fixingSubgroup_iff _ _).1 hτ x hx.2
  exact MulAction.mem_stabilizer_iff.1 (sup_le hE hM (h hσ))

end Fields

/-! ### The blocks, read inside the lift -/

section Lift

variable {ℓ : ℕ} {U : Type} [Group U] {n : ℕ} {S : Type} [Group S] {j : ℕ}

/-- The letters of a generic operator group, read inside the semidirect product a lift lands in. -/
def genericQuotInl (ℓ : ℕ) (U : Type) [Group U] (N : ℕ) (S : Type) [Group S] (j : ℕ) :
    Generic U N S →* GenericQuot ℓ U N S j :=
  SemidirectProduct.inl.comp (QuotientGroup.mk' (pCentral ℓ (Generic U N S) j))

theorem genericQuotInl_apply (ℓ : ℕ) (U : Type) [Group U] (N : ℕ) (S : Type) [Group S] (j : ℕ)
    (g : Generic U N S) :
    genericQuotInl ℓ U N S j g = SemidirectProduct.inl (QuotientGroup.mk g) := rfl

/-- The letters fill out exactly the part of the lift lying over nothing. -/
theorem range_genericQuotInl (ℓ : ℕ) (U : Type) [Group U] (N : ℕ) (S : Type) [Group S] (j : ℕ) :
    (genericQuotInl ℓ U N S j).range
      = (SemidirectProduct.rightHom : GenericQuot ℓ U N S j →* U).ker := by
  rw [← SemidirectProduct.range_inl_eq_ker_rightHom]
  refine le_antisymm ?_ ?_
  · rintro _ ⟨g, rfl⟩
    exact ⟨QuotientGroup.mk g, rfl⟩
  · rintro _ ⟨x, rfl⟩
    obtain ⟨g, rfl⟩ := QuotientGroup.mk'_surjective (pCentral ℓ (Generic U N S) j) x
    exact ⟨g, rfl⟩

/-- A shrinking carries a letter to a letter. -/
theorem layerSemidirectMap_genericQuotInl {m : ℕ} {β : Generic U m S →* Generic U n S}
    (hβ : IsOperatorHom β) (g : Generic U m S) :
    layerSemidirectMap ℓ hβ j (genericQuotInl ℓ U m S j g) = genericQuotInl ℓ U n S j (β g) := rfl

/-- The subgroup of the lift generated by one block of letters. -/
def blockLift (ℓ : ℕ) (U : Type) [Group U] (r n : ℕ) (S : Type) [Group S] (j : ℕ) (b : Fin r) :
    Subgroup (GenericQuot ℓ U (r * n) S j) :=
  Subgroup.map (genericQuotInl ℓ U (r * n) S j) (Subgroup.closure (blockGen U r n S b))

/-- **The blocks jointly generate the part of the lift lying over nothing.** -/
theorem iSup_blockLift (ℓ : ℕ) (U : Type) [Group U] (r n : ℕ) (S : Type) [Group S] (j : ℕ) :
    ⨆ b : Fin r, blockLift ℓ U r n S j b
      = (SemidirectProduct.rightHom : GenericQuot ℓ U (r * n) S j →* U).ker := by
  show ⨆ b : Fin r, Subgroup.map (genericQuotInl ℓ U (r * n) S j)
      (Subgroup.closure (blockGen U r n S b)) = _
  rw [← Subgroup.map_iSup, iSup_closure_blockGen, ← MonoidHom.range_eq_map, range_genericQuotInl]

/-- The shrinking belonging to a block kills the subgroup of every other block. -/
theorem blockLift_le_ker (ℓ : ℕ) (U : Type) [Group U] {r n : ℕ} (S : Type) [Group S] {j : ℕ}
    {b c : Fin r} (hcb : c ≠ b) :
    blockLift ℓ U r n S (j + 1) c
      ≤ (layerSemidirectMap ℓ (isOperatorHom_blockShrink U r n S b) (j + 1)).ker := by
  rintro _ ⟨y, hy, rfl⟩
  refine MonoidHom.mem_ker.2 ?_
  rw [layerSemidirectMap_genericQuotInl,
    MonoidHom.mem_ker.1 (closure_blockGen_le_ker U r n S hcb hy), _root_.map_one]

end Lift

/-! ### The block whose level does the work -/

section Block

variable {ℓ : ℕ} {U : Type} [Group U] {n : ℕ} {S : Type} [Group S] {j : ℕ} {k Ω : Type} [Field k]
  [Field Ω] [Algebra k Ω] [IsGalois k Ω] {φ : Gal(Ω/k) →* U}

omit [IsGalois k Ω] in
/-- **Some block's level fills up the level below together with a prescribed subgroup**, as soon as
there are more blocks than the order of a finite quotient in which the prescribed subgroup contains
the kernel.

The subgroups the blocks cut out of the level below generate it, up to the kernel of the lift, which
every level killing the lift contains anyway; and the level belonging to a block contains the
subgroups of all the other blocks, the shrinking killing them.  So a block which cannot be dropped
from the joint generation is a block whose level does the work, and with enough blocks one of them
can be dropped. -/
theorem exists_block_ker_sup_ge {Γ : Type*} [Group Γ] [Finite Γ] (ρ : Gal(Ω/k) →* Γ)
    {B : Subgroup Gal(Ω/k)} (hkerρ : ρ.ker ≤ B) {r : ℕ} (hr : Nat.card Γ ≤ r)
    (F : Gal(Ω/k) →* GenericQuot ℓ U (r * n) S (j + 1)) (hFsurj : Function.Surjective F)
    (hFright : ∀ x, SemidirectProduct.rightHom (F x) = φ x) :
    ∃ b : Fin r, φ.ker
      ≤ ((layerSemidirectMap ℓ (isOperatorHom_blockShrink U r n S b) (j + 1)).comp F).ker ⊔ B := by
  obtain ⟨b, hb⟩ := exists_iSup_ne_sup_ge
    (fun c : Fin r => Subgroup.comap F (blockLift ℓ U r n S (j + 1) c)) B ρ hkerρ hr
  refine ⟨b, ?_⟩
  have hcompφ : (SemidirectProduct.rightHom :
      GenericQuot ℓ U (r * n) S (j + 1) →* U).comp F = φ := MonoidHom.ext hFright
  have hφ : φ.ker
      ≤ (⨆ c : Fin r, Subgroup.comap F (blockLift ℓ U r n S (j + 1) c)) ⊔ F.ker := by
    rw [← hcompφ, ← MonoidHom.comap_ker, ← iSup_blockLift ℓ U r n S (j + 1)]
    exact comap_iSup_le hFsurj _
  have hFker : F.ker
      ≤ ((layerSemidirectMap ℓ (isOperatorHom_blockShrink U r n S b) (j + 1)).comp F).ker := by
    intro x hx
    refine MonoidHom.mem_ker.2 ?_
    show layerSemidirectMap ℓ (isOperatorHom_blockShrink U r n S b) (j + 1) (F x) = 1
    rw [MonoidHom.mem_ker.1 hx, _root_.map_one]
  refine hφ.trans (sup_le (hb.trans (sup_le_sup_right (iSup₂_le fun c hc => ?_) B))
    (hFker.trans le_sup_left))
  rw [← MonoidHom.comap_ker]
  exact Subgroup.comap_mono (blockLift_le_ker ℓ U S hc)

end Block

/-! ### The level reaching every place -/

section Reachable

variable {k Ω : Type} [Field k] [NumberField k] [Field Ω] [Algebra k Ω] [IsGalois k Ω]
  [IsAlgClosed Ω]

omit [NumberField k] [IsAlgClosed Ω] in
/-- **A finite level cutting out exactly the kernel of a lift carried across a shrinking.**

A smooth homomorphism onto a discrete group has open kernel, and the kernel of the lift carried
across the shrinking is larger still, so a finite Galois level cuts it out on the nose.  That level
contains the level the base realization cuts out because the lift lies over the base realization. -/
theorem exists_level_fixingSubgroup_eq_ker {ℓ : ℕ} {U : Type} [Group U] {m n : ℕ} {S : Type}
    [Group S] {j : ℕ} {φ : Gal(Ω/k) →* U} {β : Generic U m S →* Generic U n S}
    (hβ : IsOperatorHom β) (K : IntermediateField k Ω) (hKker : K.fixingSubgroup = φ.ker)
    (F : Gal(Ω/k) →* GenericQuot ℓ U m S (j + 1)) (hFsm : IsSmoothHom F)
    (hFright : ∀ x, SemidirectProduct.rightHom (F x) = φ x) :
    ∃ E : IntermediateField k Ω, FiniteDimensional k ↥E ∧ IsGalois k ↥E ∧ K ≤ E ∧
      E.fixingSubgroup = ((layerSemidirectMap ℓ hβ (j + 1)).comp F).ker := by
  have hle : F.ker ≤ ((layerSemidirectMap ℓ hβ (j + 1)).comp F).ker := by
    intro x hx
    refine MonoidHom.mem_ker.2 ?_
    show layerSemidirectMap ℓ hβ (j + 1) (F x) = 1
    rw [MonoidHom.mem_ker.1 hx, _root_.map_one]
  obtain ⟨E, hEfin, hEgal, hEfix, hEmem⟩ :=
    exists_level_fixingSubgroup_eq (N := ((layerSemidirectMap ℓ hβ (j + 1)).comp F).ker)
      ⟨inferInstance, Subgroup.isOpen_mono hle (isOpenNormal_ker_of_isSmoothHom hFsm).isOpen⟩
  have hkerφ : ((layerSemidirectMap ℓ hβ (j + 1)).comp F).ker ≤ φ.ker := by
    intro x hx
    have hx1 : layerSemidirectMap ℓ hβ (j + 1) (F x) = 1 := MonoidHom.mem_ker.1 hx
    have h2 : (layerSemidirectMap ℓ hβ (j + 1) (F x)).right = φ x := hFright x
    rw [hx1] at h2
    exact MonoidHom.mem_ker.2 h2.symm
  refine ⟨E, hEfin, hEgal, fun x hx => hEmem x fun σ hσ => ?_, hEfix⟩
  have hσK : σ ∈ K.fixingSubgroup := by
    rw [hKker]
    exact hkerφ hσ
  exact (IntermediateField.mem_fixingSubgroup_iff _ _).1 hσK x hx

/-- **The shrinking can be spent on a level reaching every place of the level below.**

The field of radicals whose disjointness from the level buys reachability depends on the level
below and the prescribed set of places alone, so the number of blocks may be announced in advance:
as many as the order of its
Galois group.  One of them then survives the counting, its level fills up the level below together
with the field of radicals, and the two fields therefore meet inside the level below, which is
exactly the disjointness reachability was traded for. -/
theorem exists_hasReachableLevel {ℓ : ℕ} (hℓ : ℓ.Prime) (U : Type) [Group U]
    (n : ℕ) (S : Type) [Group S] (j : ℕ) {φ : Gal(Ω/k) →* U} (K : IntermediateField k Ω)
    [NumberField ↥K] {ζ : ↥K} (hζ : IsPrimitiveRoot ζ ℓ) (hKker : K.fixingSubgroup = φ.ker)
    {Tz : Set (HeightOneSpectrum (𝓞 ↥K))} (hTzfin : Tz.Finite) :
    ∃ N : ℕ, HasReachableLevel ℓ U n S j φ N K Tz := by
  obtain ⟨M, hKM, hMfin, hMgal, hMreach⟩ :=
    exists_finite_forall_isReachablePlace hℓ K hζ hTzfin
  haveI := hMfin
  haveI := hMgal
  haveI : Finite Gal(↥M/k) := Finite.of_fintype _
  refine ⟨Nat.card Gal(↥M/k) * n, ?_⟩
  intro F hFsurj hFsm hFright
  obtain ⟨b, hb⟩ := exists_block_ker_sup_ge (AlgEquiv.restrictNormalHom (F := k) (K₁ := Ω) ↥M)
    (le_of_eq (IntermediateField.restrictNormalHom_ker M)) (le_refl (Nat.card Gal(↥M/k))) F
    hFsurj hFright
  obtain ⟨E, hEfin, hEgal, hKE, hEfix⟩ :=
    exists_level_fixingSubgroup_eq_ker (isOperatorHom_blockShrink U _ n S b) K hKker F hFsm hFright
  refine ⟨blockShrink U _ n S b, isOperatorHom_blockShrink U _ n S b,
    blockShrink_surjective U _ n S b, E, hEfin, hEgal, hKE, le_of_eq hEfix, ?_⟩
  haveI := hEfin
  haveI := hEgal
  refine hMreach E hEfin hEgal hKE (inf_le_of_fixingSubgroup_le_sup ?_)
  rw [hKker, hEfix]
  exact hb

end Reachable

end InverseGalois.Shafarevich
