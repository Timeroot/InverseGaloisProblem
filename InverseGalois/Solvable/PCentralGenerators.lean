import Mathlib
import InverseGalois.Solvable.PCentral

/-!
# Generators of the lower `p`-central series

A group presented by a set of generators has all of its lower `p`-central terms generated by
iterated commutators of those generators and their `p`-th powers: starting from the generators
themselves, one passes from weight `n` to weight `n + 1` by taking a commutator with a generator
or by raising to the `p`-th power, and the elements so obtained generate the `n`-th term of the
series modulo the next one.  Once the series has reached the trivial subgroup, "modulo the next
one" is no condition at all and the last nonzero term is generated outright.

The proof is the usual bookkeeping of a graded argument, arranged so that no commutator
calculus beyond the two basic identities is needed.  Fix a normal subgroup `M` containing the
weight-`n + 1` generators and the term `λₙ₊₂`.  The elements whose commutators with the whole
group land in `M` and whose `p`-th power lands in `M` — that is, the preimage of the `p`-torsion
of the centre of `G ⧸ M` — form a normal subgroup, so the inductive hypothesis for weight `n`
reduces the claim to the two generating families, both of which are members by construction.
That the `p`-th power map behaves additively there is exactly the statement that the quotient
`G ⧸ M` has the image of `λₙ` in its centre, which the commutator half has already supplied.

## Main definitions

* `InverseGalois.basicSet`: the basic elements of weight `n` over a set of generators.
* `InverseGalois.basicSubgroup`: the normal subgroup they generate.

There are only finitely many basic elements of a given weight over a finite set of generators,
and the last nonzero term of the series is generated by them; since that term is central of
exponent `p`, it is finite, and an induction along the series shows that a finitely generated
group whose lower `p`-central series terminates is a finite `p`-group.  This is what makes the
relatively free objects of the theory — the free groups of a given rank in the variety of
`p`-groups of a given `p`-class — finite, hence available as Galois groups.

## Main results

* `InverseGalois.lowerPCentralSeries_le_basicSubgroup_sup`: **the `n`-th term of the lower
  `p`-central series is generated by the basic elements of weight `n` modulo the next term.**
* `InverseGalois.lowerPCentralSeries_eq_basicSubgroup`: **the last nonzero term of the series is
  generated by the basic elements of its weight.**
* `InverseGalois.finite_of_lowerPCentralSeries_eq_bot`: **a finitely generated group whose lower
  `p`-central series reaches the trivial subgroup is finite.**
* `InverseGalois.isPGroup_of_lowerPCentralSeries_eq_bot`: **a group whose lower `p`-central series
  reaches the trivial subgroup is a `p`-group.**

## Tags

lower central series, `p`-group, basic commutator, generators
-/

universe u

namespace InverseGalois

variable {G : Type*} [Group G]

/-! ## Central elements of order dividing `p` -/

/-- The central elements killed by the `p`-th power map. -/
def centralPow (p : ℕ) (Q : Type*) [Group Q] : Subgroup Q where
  carrier := {z | z ∈ Subgroup.center Q ∧ z ^ p = 1}
  one_mem' := ⟨Subgroup.one_mem _, one_pow p⟩
  mul_mem' := by
    rintro a b ⟨ha, ha'⟩ ⟨hb, hb'⟩
    refine ⟨Subgroup.mul_mem _ ha hb, ?_⟩
    have h : Commute a b := (Subgroup.mem_center_iff.mp ha b).symm
    rw [h.mul_pow, ha', hb', one_mul]
  inv_mem' := by
    rintro a ⟨ha, ha'⟩
    exact ⟨Subgroup.inv_mem _ ha, by rw [inv_pow, ha', inv_one]⟩

theorem mem_centralPow {p : ℕ} {Q : Type*} [Group Q] {z : Q} :
    z ∈ centralPow p Q ↔ z ∈ Subgroup.center Q ∧ z ^ p = 1 :=
  Iff.rfl

instance centralPow_normal (p : ℕ) (Q : Type*) [Group Q] : (centralPow p Q).Normal := by
  refine ⟨fun z hz g => ?_⟩
  have hconj : g * z * g⁻¹ = z := by
    rw [Subgroup.mem_center_iff.mp hz.1 g]
    group
  rw [hconj]
  exact hz

/-- The elements that are central modulo `M` and whose `p`-th power lies in `M`. -/
def centralPowPreimage (p : ℕ) (M : Subgroup G) [M.Normal] : Subgroup G :=
  Subgroup.comap (QuotientGroup.mk' M) (centralPow p (G ⧸ M))

instance centralPowPreimage_normal (p : ℕ) (M : Subgroup G) [M.Normal] :
    (centralPowPreimage p M).Normal :=
  Subgroup.normal_comap _

theorem mem_centralPowPreimage {p : ℕ} {M : Subgroup G} [M.Normal] {u : G} :
    u ∈ centralPowPreimage p M ↔ (∀ g : G, ⁅u, g⁆ ∈ M) ∧ u ^ p ∈ M := by
  have key : ∀ g : G, ⁅u, g⁆ ∈ M ↔
      (QuotientGroup.mk' M) g * (QuotientGroup.mk' M) u
        = (QuotientGroup.mk' M) u * (QuotientGroup.mk' M) g := by
    intro g
    rw [← QuotientGroup.eq_one_iff, ← QuotientGroup.mk'_apply, map_commutatorElement,
      commutatorElement_eq_one_iff_mul_comm, eq_comm]
  have hpow : ((QuotientGroup.mk' M) u) ^ p = 1 ↔ u ^ p ∈ M := by
    rw [← map_pow, QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff]
  rw [centralPowPreimage, Subgroup.mem_comap, mem_centralPow, Subgroup.mem_center_iff]
  refine and_congr ⟨fun h g => (key g).mpr (h _), fun h z => ?_⟩ hpow
  obtain ⟨g, rfl⟩ := QuotientGroup.mk'_surjective M z
  exact (key g).mp (h g)

/-! ## Basic elements -/

/-- The basic elements of weight `n` over a set `X`: weight zero is `X` itself, and one passes
from weight `n` to weight `n + 1` by taking a commutator with an element of `X` or by raising to
the `p`-th power. -/
def basicSet (p : ℕ) (X : Set G) : ℕ → Set G
  | 0 => X
  | n + 1 =>
    {g | ∃ y ∈ basicSet p X n, ∃ x ∈ X, g = ⁅y, x⁆} ∪ {g | ∃ y ∈ basicSet p X n, g = y ^ p}

/-- The normal subgroup generated by the basic elements of weight `n`. -/
def basicSubgroup (p : ℕ) (X : Set G) (n : ℕ) : Subgroup G :=
  Subgroup.normalClosure (basicSet p X n)

instance basicSubgroup_normal (p : ℕ) (X : Set G) (n : ℕ) : (basicSubgroup p X n).Normal :=
  Subgroup.normalClosure_normal

theorem basicSet_subset_basicSubgroup (p : ℕ) (X : Set G) (n : ℕ) :
    basicSet p X n ⊆ basicSubgroup p X n :=
  Subgroup.subset_normalClosure

theorem basicSubgroup_le {p : ℕ} {X : Set G} {n : ℕ} {L : Subgroup G} [L.Normal]
    (h : basicSet p X n ⊆ L) : basicSubgroup p X n ≤ L :=
  Subgroup.normalClosure_le_normal h

theorem commutatorElement_mem_basicSet {p : ℕ} {X : Set G} {n : ℕ} {y : G}
    (hy : y ∈ basicSet p X n) {x : G} (hx : x ∈ X) : ⁅y, x⁆ ∈ basicSet p X (n + 1) :=
  Or.inl ⟨y, hy, x, hx, rfl⟩

theorem pow_mem_basicSet {p : ℕ} {X : Set G} {n : ℕ} {y : G} (hy : y ∈ basicSet p X n) :
    y ^ p ∈ basicSet p X (n + 1) :=
  Or.inr ⟨y, hy, rfl⟩

theorem basicSet_subset_lowerPCentralSeries (p : ℕ) (X : Set G) (n : ℕ) :
    basicSet p X n ⊆ lowerPCentralSeries p G n := by
  induction n with
  | zero => exact fun x _ => Subgroup.mem_top x
  | succ n ih =>
    rintro g (⟨y, hy, x, _, rfl⟩ | ⟨y, hy, rfl⟩)
    · exact commutator_mem_lowerPCentralSeries_succ (ih hy)
    · exact pow_mem_lowerPCentralSeries_succ (ih hy)

theorem basicSubgroup_le_lowerPCentralSeries (p : ℕ) (X : Set G) (n : ℕ) :
    basicSubgroup p X n ≤ lowerPCentralSeries p G n :=
  basicSubgroup_le (basicSet_subset_lowerPCentralSeries p X n)

/-! ## The generating theorem -/

/-- The inductive step: a normal subgroup that contains the basic elements of weight `n + 1` and
the term of weight `n + 2` contains the term of weight `n + 1`. -/
private theorem lowerPCentralSeries_succ_le_of_basicSubgroup_le (p : ℕ) {X : Set G}
    (hX : Subgroup.closure X = ⊤) (n : ℕ)
    (ih : lowerPCentralSeries p G n ≤ basicSubgroup p X n ⊔ lowerPCentralSeries p G (n + 1))
    (M : Subgroup G) [hMn : M.Normal] (hbasic : basicSubgroup p X (n + 1) ≤ M)
    (hnext : lowerPCentralSeries p G (n + 2) ≤ M) :
    lowerPCentralSeries p G (n + 1) ≤ M := by
  have hA1 : ∀ b ∈ basicSet p X n, ∀ g : G, ⁅b, g⁆ ∈ M := by
    intro b hb g
    have hT : ∀ y ∈ Subgroup.closure X, ⁅b, y⁆ ∈ M := by
      intro y hy
      induction hy using Subgroup.closure_induction with
      | mem x hx =>
        exact hbasic (basicSet_subset_basicSubgroup _ _ _ (commutatorElement_mem_basicSet hb hx))
      | one => simp
      | mul y z _ _ hy hz =>
        have hid : ⁅b, y * z⁆ = ⁅b, y⁆ * (y * ⁅b, z⁆ * y⁻¹) := by
          simp only [commutatorElement_def]
          group
        rw [hid]
        exact M.mul_mem hy (hMn.conj_mem _ hz y)
      | inv y _ hy =>
        have hid : ⁅b, y⁻¹⁆ = y⁻¹ * ⁅b, y⁆⁻¹ * (y⁻¹)⁻¹ := by
          simp only [commutatorElement_def]
          group
        rw [hid]
        exact hMn.conj_mem _ (M.inv_mem hy) y⁻¹
    exact hT g (by rw [hX]; exact Subgroup.mem_top g)
  have hb1 : basicSubgroup p X n ≤ centralPowPreimage p M :=
    basicSubgroup_le fun b hb => mem_centralPowPreimage.mpr
      ⟨hA1 b hb, hbasic (basicSet_subset_basicSubgroup _ _ _ (pow_mem_basicSet hb))⟩
  have hb2 : lowerPCentralSeries p G (n + 1) ≤ centralPowPreimage p M := fun u hu =>
    mem_centralPowPreimage.mpr ⟨fun g => hnext (commutator_mem_lowerPCentralSeries_succ hu),
      hnext (pow_mem_lowerPCentralSeries_succ hu)⟩
  have hK : lowerPCentralSeries p G n ≤ centralPowPreimage p M := ih.trans (sup_le hb1 hb2)
  exact lowerPCentralSeries_succ_le_of (fun u hu g => (mem_centralPowPreimage.mp (hK hu)).1 g)
    fun u hu => (mem_centralPowPreimage.mp (hK hu)).2

/-- **The `n`-th term of the lower `p`-central series is generated by the basic elements of weight
`n` modulo the next term.** -/
theorem lowerPCentralSeries_le_basicSubgroup_sup (p : ℕ) {X : Set G} (hX : Subgroup.closure X = ⊤)
    (n : ℕ) :
    lowerPCentralSeries p G n ≤ basicSubgroup p X n ⊔ lowerPCentralSeries p G (n + 1) := by
  induction n with
  | zero =>
    rw [lowerPCentralSeries_zero, ← hX]
    refine le_sup_of_le_left ((Subgroup.closure_le _).mpr ?_)
    exact Subgroup.subset_normalClosure
  | succ n ih =>
    exact lowerPCentralSeries_succ_le_of_basicSubgroup_le p hX n ih _ le_sup_left le_sup_right

/-- **The last nonzero term of the lower `p`-central series is generated by the basic elements of
its weight.** -/
theorem lowerPCentralSeries_eq_basicSubgroup (p : ℕ) {X : Set G} (hX : Subgroup.closure X = ⊤)
    {c : ℕ} (hc : lowerPCentralSeries p G (c + 1) = ⊥) :
    lowerPCentralSeries p G c = basicSubgroup p X c := by
  refine le_antisymm ?_ (basicSubgroup_le_lowerPCentralSeries p X c)
  have h := lowerPCentralSeries_le_basicSubgroup_sup p hX c
  rwa [hc, sup_bot_eq] at h

/-! ## Finiteness -/

theorem basicSet_finite (p : ℕ) {X : Set G} (hX : X.Finite) (n : ℕ) : (basicSet p X n).Finite := by
  induction n with
  | zero => exact hX
  | succ n ih =>
    refine Set.Finite.union (Set.Finite.subset ((ih.prod hX).image fun q : G × G => ⁅q.1, q.2⁆) ?_)
      (Set.Finite.subset (ih.image (· ^ p)) ?_)
    · rintro g ⟨y, hy, x, hx, rfl⟩
      exact ⟨(y, x), ⟨hy, hx⟩, rfl⟩
    · rintro g ⟨y, hy, rfl⟩
      exact ⟨y, hy, rfl⟩

/-- A subgroup of the centre is normal. -/
theorem normal_of_le_center {H : Subgroup G} (h : H ≤ Subgroup.center G) : H.Normal :=
  ⟨fun x hx g => by rw [Subgroup.mem_center_iff.mp (h hx) g]; simpa using hx⟩

private theorem finite_closure_of_central_aux {p : ℕ} (hp : p ≠ 0) (S : Finset G) :
    (∀ s ∈ S, s ∈ Subgroup.center G) → (∀ s ∈ S, s ^ p = 1) →
      (Subgroup.closure (S : Set G) : Set G).Finite := by
  classical
  induction S using Finset.induction_on with
  | empty => intro _ _; simp
  | insert a S ha ih =>
    intro hcen hpow
    have hsplit : Subgroup.closure ((insert a S : Finset G) : Set G)
        = Subgroup.closure (S : Set G) ⊔ Subgroup.zpowers a := by
      rw [Finset.coe_insert, Set.insert_eq, Set.union_comm, Subgroup.closure_union,
        Subgroup.zpowers_eq_closure]
    have hacen : a ∈ Subgroup.center G := hcen a (Finset.mem_insert_self a S)
    haveI : (Subgroup.zpowers a).Normal :=
      normal_of_le_center (Subgroup.zpowers_le.mpr hacen)
    have hafin : (Subgroup.zpowers a : Set G).Finite :=
      IsOfFinOrder.finite_zpowers (isOfFinOrder_iff_pow_eq_one.mpr
        ⟨p, Nat.pos_of_ne_zero hp, hpow a (Finset.mem_insert_self a S)⟩)
    rw [hsplit, Subgroup.mul_normal]
    exact Set.Finite.mul
      (ih (fun s hs => hcen s (Finset.mem_insert_of_mem hs))
        (fun s hs => hpow s (Finset.mem_insert_of_mem hs))) hafin

/-- A finite set of central elements of order dividing a nonzero `p` generates a finite
subgroup. -/
theorem finite_closure_of_central {p : ℕ} (hp : p ≠ 0) {S : Set G} (hS : S.Finite)
    (hcen : S ⊆ Subgroup.center G) (hpow : ∀ s ∈ S, s ^ p = 1) :
    Finite ↥(Subgroup.closure S) := by
  classical
  have h := finite_closure_of_central_aux hp hS.toFinset
    (fun s hs => hcen (hS.mem_toFinset.mp hs)) fun s hs => hpow s (hS.mem_toFinset.mp hs)
  rw [hS.coe_toFinset] at h
  exact h.to_subtype

/-- **A finitely generated group whose lower `p`-central series reaches the trivial subgroup is
finite.** -/
theorem finite_of_lowerPCentralSeries_eq_bot {p : ℕ} (hp : p ≠ 0) :
    ∀ (n : ℕ) (G : Type u) [Group G] (X : Set G), X.Finite → Subgroup.closure X = ⊤ →
      lowerPCentralSeries p G n = ⊥ → Finite G := by
  intro n
  induction n with
  | zero =>
    intro G _ X _ _ h
    rw [lowerPCentralSeries_zero] at h
    haveI : Subsingleton G := by
      refine ⟨fun a b => ?_⟩
      have ha : a ∈ (⊥ : Subgroup G) := h ▸ Subgroup.mem_top a
      have hb : b ∈ (⊥ : Subgroup G) := h ▸ Subgroup.mem_top b
      rw [Subgroup.mem_bot.mp ha, Subgroup.mem_bot.mp hb]
    exact Finite.of_subsingleton
  | succ n ih =>
    intro G _ X hXfin hX h
    have hcen : lowerPCentralSeries p G n ≤ Subgroup.center G := by
      intro x hx
      rw [Subgroup.mem_center_iff]
      intro g
      have hx1 : ⁅x, g⁆ ∈ (⊥ : Subgroup G) := h ▸ commutator_mem_lowerPCentralSeries_succ hx
      exact (commutatorElement_eq_one_iff_mul_comm.mp (Subgroup.mem_bot.mp hx1)).symm
    have hbase : basicSet p X n ⊆ Subgroup.center G :=
      fun s hs => hcen (basicSet_subset_lowerPCentralSeries p X n hs)
    haveI hnorm : (Subgroup.closure (basicSet p X n)).Normal :=
      normal_of_le_center ((Subgroup.closure_le _).mpr hbase)
    have hgen : lowerPCentralSeries p G n = Subgroup.closure (basicSet p X n) := by
      rw [lowerPCentralSeries_eq_basicSubgroup p hX h]
      exact le_antisymm (Subgroup.normalClosure_le_normal Subgroup.subset_closure)
        ((Subgroup.closure_le _).mpr Subgroup.subset_normalClosure)
    haveI hNfin : Finite ↥(lowerPCentralSeries p G n) := by
      rw [hgen]
      refine finite_closure_of_central hp (basicSet_finite p hXfin n) hbase fun s hs => ?_
      have := h ▸ pow_mem_lowerPCentralSeries_succ (basicSet_subset_lowerPCentralSeries p X n hs)
      exact Subgroup.mem_bot.mp this
    haveI : Finite (G ⧸ lowerPCentralSeries p G n) := by
      refine ih _ (QuotientGroup.mk' (lowerPCentralSeries p G n) '' X) (hXfin.image _) ?_ ?_
      · rw [← MonoidHom.map_closure, hX]
        exact Subgroup.map_top_of_surjective _ (QuotientGroup.mk'_surjective _)
      · rw [← map_lowerPCentralSeries p (QuotientGroup.mk'_surjective _) n,
          Subgroup.map_eq_bot_iff, QuotientGroup.ker_mk']
    refine Nat.finite_of_card_ne_zero ?_
    rw [← Subgroup.card_mul_index (lowerPCentralSeries p G n), Subgroup.index_eq_card]
    exact Nat.mul_ne_zero Nat.card_pos.ne' Nat.card_pos.ne'

/-- **A group whose lower `p`-central series reaches the trivial subgroup is a `p`-group.** -/
theorem isPGroup_of_lowerPCentralSeries_eq_bot (p : ℕ) :
    ∀ (n : ℕ) (G : Type u) [Group G], lowerPCentralSeries p G n = ⊥ → IsPGroup p G := by
  intro n
  induction n with
  | zero =>
    intro G _ h g
    rw [lowerPCentralSeries_zero] at h
    exact ⟨0, Subgroup.mem_bot.mp (h ▸ Subgroup.mem_top g)⟩
  | succ n ih =>
    intro G _ h g
    obtain ⟨k, hk⟩ := ih (G ⧸ lowerPCentralSeries p G n)
      (by
        rw [← map_lowerPCentralSeries p (QuotientGroup.mk'_surjective _) n,
          Subgroup.map_eq_bot_iff, QuotientGroup.ker_mk'])
      (QuotientGroup.mk' (lowerPCentralSeries p G n) g)
    refine ⟨k + 1, ?_⟩
    have hmem : g ^ p ^ k ∈ lowerPCentralSeries p G n := by
      rw [← QuotientGroup.ker_mk' (lowerPCentralSeries p G n), MonoidHom.mem_ker, map_pow]
      exact hk
    have := h ▸ pow_mem_lowerPCentralSeries_succ hmem
    rw [pow_succ, pow_mul]
    exact Subgroup.mem_bot.mp this

end InverseGalois
