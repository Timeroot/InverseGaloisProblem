import Mathlib
import InverseGalois.Solvable.CentralDual
import InverseGalois.Solvable.PCentralGenerators

/-!
# A step of order two between two quotients

Cutting a central subgroup of exponent two down one hyperplane at a time presents a group as an
iterated central extension: the quotient by a subgroup and the quotient by a hyperplane of it differ
by a kernel of order two, generated by the class of any element of the subgroup outside the
hyperplane.

That element also provides what an embedding problem posed over the pair of quotients needs beyond
the kernel itself: a homomorphic lift of the kernel back into the group, namely the cyclic group it
generates, which meets the hyperplane trivially and therefore maps isomorphically onto the kernel.

## Main definitions

* `InverseGalois.quotientStep`: the natural map from the quotient by the smaller of two nested
  normal subgroups onto the quotient by the larger.

## Main results

* `InverseGalois.ker_quotientStep`: the kernel of the step is the image of the larger subgroup.
* `InverseGalois.card_ker_quotientStep`: **the step has kernel of order two** when the larger
  subgroup is generated by the smaller one together with an element of order two outside it.
* `InverseGalois.exists_section_quotientStep`: **the kernel of such a step lifts homomorphically to
  the larger subgroup.**
* `InverseGalois.mem_sup_zpowers_iff_mem_sup_sup`: **putting the omitted element back into a
  hyperplane does not change which of its elements are reached together with a distinguished
  element**, in each of the three positions the distinguished element can be in.

## Tags

quotient group, central extension, embedding problem, section, elementary abelian group
-/

namespace InverseGalois

variable {G : Type*} [Group G] {Y Y' : Subgroup G} [Y.Normal] [Y'.Normal]

/-! ### The step between two quotients -/

/-- The natural map from the quotient by the smaller of two nested normal subgroups onto the
quotient by the larger. -/
def quotientStep (h : Y' ≤ Y) : G ⧸ Y' →* G ⧸ Y :=
  QuotientGroup.map Y' Y (MonoidHom.id G) (by rwa [Subgroup.comap_id])

@[simp] theorem quotientStep_mk (h : Y' ≤ Y) (a : G) :
    quotientStep h (QuotientGroup.mk a) = QuotientGroup.mk a := rfl

theorem quotientStep_comp_mk' (h : Y' ≤ Y) :
    (quotientStep h).comp (QuotientGroup.mk' Y') = QuotientGroup.mk' Y :=
  MonoidHom.ext fun _ => rfl

theorem quotientStep_surjective (h : Y' ≤ Y) : Function.Surjective (quotientStep h) := by
  intro y
  obtain ⟨a, rfl⟩ := QuotientGroup.mk'_surjective Y y
  exact ⟨QuotientGroup.mk a, rfl⟩

/-- The kernel of the step is the image of the larger subgroup in the smaller quotient. -/
theorem ker_quotientStep (h : Y' ≤ Y) :
    (quotientStep h).ker = Y.map (QuotientGroup.mk' Y') := by
  have hcomap : ((quotientStep h).ker).comap (QuotientGroup.mk' Y') = Y := by
    rw [MonoidHom.comap_ker, quotientStep_comp_mk' h, QuotientGroup.ker_mk']
  have := congrArg (Subgroup.map (QuotientGroup.mk' Y')) hcomap
  rwa [Subgroup.map_comap_eq_self_of_surjective (QuotientGroup.mk'_surjective Y')] at this

/-! ### A step generated by an element of order two -/

section Line

variable {w : G}

theorem ker_quotientStep_eq_zpowers (h : Y' ≤ Y) (hsup : Y' ⊔ Subgroup.zpowers w = Y) :
    (quotientStep h).ker = Subgroup.zpowers (QuotientGroup.mk' Y' w) := by
  have hY' : Y'.map (QuotientGroup.mk' Y') = ⊥ :=
    (Subgroup.map_eq_bot_iff _).mpr (by rw [QuotientGroup.ker_mk'])
  rw [ker_quotientStep h, ← hsup, Subgroup.map_sup, hY', MonoidHom.map_zpowers, bot_sup_eq]

/-- **A step whose larger subgroup is generated by the smaller one together with an element of
order two outside it has kernel of order two.** -/
theorem card_ker_quotientStep (h : Y' ≤ Y) (hsup : Y' ⊔ Subgroup.zpowers w = Y) (hw2 : w ^ 2 = 1)
    (hwY' : w ∉ Y') : Nat.card ↥(quotientStep h).ker = 2 := by
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  rw [ker_quotientStep_eq_zpowers h hsup, Nat.card_zpowers]
  refine orderOf_eq_prime ?_ fun hc => hwY' ?_
  · rw [← map_pow, hw2, map_one]
  · exact (QuotientGroup.eq_one_iff w).mp hc

omit [Y.Normal] [Y'.Normal] in
theorem mem_of_sup_zpowers (hsup : Y' ⊔ Subgroup.zpowers w = Y) : w ∈ Y :=
  hsup ▸ Subgroup.mem_sup_right (Subgroup.mem_zpowers w)

/-- **The kernel of a step of order two lifts homomorphically to the larger subgroup.**  The cyclic
group generated by the element the step is built on meets the hyperplane trivially, so the quotient
map carries it isomorphically onto the kernel; the inverse of that isomorphism is the lift. -/
theorem exists_section_quotientStep (h : Y' ≤ Y) (hsup : Y' ⊔ Subgroup.zpowers w = Y)
    (hw2 : w ^ 2 = 1) (hwY' : w ∉ Y') :
    ∃ s : ↥(quotientStep h).ker →* ↥(QuotientGroup.mk' Y).ker,
      (∀ z, ((s z : G) ∈ Subgroup.zpowers w)) ∧ ∀ z, QuotientGroup.mk' Y' ↑(s z) = ↑z := by
  have hKz : (quotientStep h).ker = Subgroup.zpowers (QuotientGroup.mk' Y' w) :=
    ker_quotientStep_eq_zpowers h hsup
  have hmem : ∀ x : ↥(Subgroup.zpowers w),
      QuotientGroup.mk' Y' ↑x ∈ (quotientStep h).ker := by
    intro x
    obtain ⟨k, hk⟩ := x.2
    have hk' : w ^ k = (x : G) := hk
    rw [hKz]
    refine ⟨k, ?_⟩
    show (QuotientGroup.mk' Y' w) ^ k = QuotientGroup.mk' Y' (x : G)
    rw [← map_zpow, hk']
  set m : ↥(Subgroup.zpowers w) →* ↥(quotientStep h).ker :=
    MonoidHom.codRestrict ((QuotientGroup.mk' Y').comp (Subgroup.subtype _)) _ hmem with hm
  have hmapp : ∀ x : ↥(Subgroup.zpowers w), (m x : G ⧸ Y') = QuotientGroup.mk' Y' ↑x :=
    fun _ => rfl
  have hminj : Function.Injective m := by
    rw [injective_iff_map_eq_one]
    intro x hx
    have hx' : QuotientGroup.mk' Y' ↑x = 1 := by rw [← hmapp x, hx]; rfl
    have hxY' : (x : G) ∈ Y' := (QuotientGroup.eq_one_iff _).mp hx'
    rcases eq_one_or_eq_of_mem_zpowers hw2 x.2 with hx1 | hxw
    · exact Subtype.ext hx1
    · exact absurd (hxw ▸ hxY') hwY'
  have hmsurj : Function.Surjective m := by
    rintro ⟨y, hy⟩
    rw [hKz] at hy
    obtain ⟨k, hk⟩ := hy
    refine ⟨⟨w ^ k, k, rfl⟩, Subtype.ext ?_⟩
    show QuotientGroup.mk' Y' (w ^ k) = y
    rw [map_zpow]
    exact hk
  have hzle : Subgroup.zpowers w ≤ (QuotientGroup.mk' Y).ker := by
    rw [QuotientGroup.ker_mk']
    exact Subgroup.zpowers_le.mpr (mem_of_sup_zpowers hsup)
  set e := MulEquiv.ofBijective m ⟨hminj, hmsurj⟩ with he
  have hcoe : ∀ z, ((Subgroup.inclusion hzle) (e.symm z) : G)
      = ((e.symm z : ↥(Subgroup.zpowers w)) : G) := fun _ => rfl
  refine ⟨(Subgroup.inclusion hzle).comp e.symm.toMonoidHom, fun z => ?_, fun z => ?_⟩
  · show ((Subgroup.inclusion hzle) (e.symm z) : G) ∈ Subgroup.zpowers w
    rw [hcoe]
    exact (e.symm z).2
  · show QuotientGroup.mk' Y' ((Subgroup.inclusion hzle) (e.symm z) : G) = (z : G ⧸ Y')
    rw [hcoe, ← hmapp (e.symm z)]
    exact congrArg Subtype.val (e.apply_symm_apply z)

end Line

/-! ### Adjoining the omitted element -/

section Adjoin

variable {Z W V : Subgroup G} {zi w θ : G}

/-- **Putting the omitted element back into a hyperplane does not change which of its elements are
reached together with a distinguished element**, in each of three positions the distinguished
element can be in: inside the hyperplane, outside the hyperplane enlarged by the omitted element,
or generating the omitted element.

In the first two positions the omitted element cannot occur in a decomposition of a member of the
hyperplane — in the first because everything else in the decomposition already lies in the
hyperplane, in the second because the distinguished element cannot occur either — and in the third
it is a power of the distinguished element, so it was already accounted for. -/
theorem mem_sup_zpowers_of_mem_sup_sup (hZ : Z ≤ Subgroup.center G) (hexp : ∀ z ∈ Z, z ^ 2 = 1)
    (hVW : V ≤ W) (hziZ : zi ∈ Z) (hwZ : w ∈ Z) (hwW : w ∉ W)
    (hcase : zi ∈ W ∨ zi ∉ W ⊔ Subgroup.zpowers w ∨ w ∈ Subgroup.zpowers zi) (hθ : θ ∈ W)
    (hmem : θ ∈ Subgroup.zpowers zi ⊔ (V ⊔ Subgroup.zpowers w)) :
    θ ∈ Subgroup.zpowers zi ⊔ V := by
  haveI : (Subgroup.zpowers w).Normal :=
    normal_of_le_center (Subgroup.zpowers_le.mpr (hZ hwZ))
  have hw2 : w ^ 2 = 1 := hexp w hwZ
  have hzi2 : zi ^ 2 = 1 := hexp zi hziZ
  rcases hcase with hcase | hcase | hcase
  · -- the distinguished element lies inside the hyperplane
    have hle : Subgroup.zpowers zi ⊔ V ≤ W := sup_le (Subgroup.zpowers_le.mpr hcase) hVW
    rw [← sup_assoc, ← SetLike.mem_coe, Subgroup.mul_normal] at hmem
    obtain ⟨u, hu, v, hv, huv⟩ := hmem
    have hu' : u ∈ Subgroup.zpowers zi ⊔ V := hu
    have hv' : v ∈ Subgroup.zpowers w := hv
    have huv' : u * v = θ := huv
    rcases eq_one_or_eq_of_mem_zpowers hw2 hv' with rfl | rfl
    · rw [mul_one] at huv'
      exact huv' ▸ hu'
    · refine absurd ?_ hwW
      have hwuθ : v = u⁻¹ * θ := by rw [← huv']; group
      rw [hwuθ]
      exact W.mul_mem (W.inv_mem (hle hu')) hθ
  · -- the distinguished element lies outside the enlarged hyperplane
    haveI : (Subgroup.zpowers zi).Normal :=
      normal_of_le_center (Subgroup.zpowers_le.mpr (hZ hziZ))
    rw [← SetLike.mem_coe, Subgroup.normal_mul] at hmem
    obtain ⟨a, ha, y, hy, hay⟩ := hmem
    have ha' : a ∈ Subgroup.zpowers zi := ha
    have hay' : a * y = θ := hay
    have hy' : y ∈ V ⊔ Subgroup.zpowers w := hy
    rw [← SetLike.mem_coe, Subgroup.mul_normal] at hy'
    obtain ⟨v, hv, b, hb, hvb⟩ := hy'
    have hv' : v ∈ V := hv
    have hb' : b ∈ Subgroup.zpowers w := hb
    have hvb' : v * b = y := hvb
    have hθab : θ = a * (v * b) := by rw [← hay', hvb']
    -- the distinguished element does not occur
    have haW : a ∈ W ⊔ Subgroup.zpowers w := by
      have ha2 : a = θ * (v * b)⁻¹ := by rw [hθab]; group
      rw [ha2]
      exact Subgroup.mul_mem _ (Subgroup.mem_sup_left hθ)
        (Subgroup.inv_mem _ (Subgroup.mul_mem _ (Subgroup.mem_sup_left (hVW hv'))
          (Subgroup.mem_sup_right hb')))
    have ha1 : a = 1 := by
      rcases eq_one_or_eq_of_mem_zpowers hzi2 ha' with h1 | h1
      · exact h1
      · exact absurd (h1 ▸ haW) hcase
    -- and therefore neither does the omitted element
    have hbW : b ∈ W := by
      have hb2 : b = v⁻¹ * θ := by rw [hθab, ha1]; group
      rw [hb2]
      exact W.mul_mem (W.inv_mem (hVW hv')) hθ
    have hb1 : b = 1 := by
      rcases eq_one_or_eq_of_mem_zpowers hw2 hb' with h1 | h1
      · exact h1
      · exact absurd (h1 ▸ hbW) hwW
    rw [hθab, ha1, hb1, one_mul, mul_one]
    exact Subgroup.mem_sup_right hv'
  · -- the omitted element is a power of the distinguished element
    exact sup_le le_sup_left
      (sup_le le_sup_right (Subgroup.zpowers_le.mpr (Subgroup.mem_sup_left hcase))) hmem

/-- **Putting the omitted element back into a hyperplane does not change which of its elements are
reached together with a distinguished element.**  One direction is monotonicity of the join. -/
theorem mem_sup_zpowers_iff_mem_sup_sup (hZ : Z ≤ Subgroup.center G) (hexp : ∀ z ∈ Z, z ^ 2 = 1)
    (hVW : V ≤ W) (hziZ : zi ∈ Z) (hwZ : w ∈ Z) (hwW : w ∉ W)
    (hcase : zi ∈ W ∨ zi ∉ W ⊔ Subgroup.zpowers w ∨ w ∈ Subgroup.zpowers zi) (hθ : θ ∈ W) :
    θ ∈ Subgroup.zpowers zi ⊔ V ↔ θ ∈ Subgroup.zpowers zi ⊔ (V ⊔ Subgroup.zpowers w) :=
  ⟨fun h => SetLike.le_def.mp (sup_le_sup_left le_sup_left _) h,
    mem_sup_zpowers_of_mem_sup_sup hZ hexp hVW hziZ hwZ hwW hcase hθ⟩

end Adjoin

end InverseGalois
