import Mathlib
import InverseGalois.NumberTheory.SplitCompletely

/-!
# Splitting completely descends to subfields

A rational prime that splits completely in a number field splits completely in every subfield.
The reason is the multiplicativity of the ramification index and of the residue degree in a
tower `ℤ → 𝓞 K → 𝓞 M`: a prime `𝔭` of `𝓞 K` above `p` is maximal, so going up produces a prime
`𝔓` of `𝓞 M` lying over `𝔭`, and `𝔓` lies over `p` as well.  The two identities
`e (𝔓 | p) = e (𝔭 | p) · e (𝔓 | 𝔭)` and `f (𝔓 | p) = f (𝔭 | p) · f (𝔓 | 𝔭)` exhibit the invariants
downstairs as divisors of the ones upstairs, and a natural number dividing `1` is `1`.

Since the argument uses nothing about the embedding `K → M` beyond its existence, it applies
verbatim to a subfield of a number field, and — reading an isomorphism as an embedding in either
direction — shows that splitting completely is invariant under isomorphism of number fields.

## Main results

* `InverseGalois.NumberTheory.splitsCompletely_of_algebra`: a prime splitting completely in `M`
  splits completely in any number field `K` admitting an algebra map to `M`.
* `InverseGalois.NumberTheory.splitsCompletely_of_algHom`: the same, phrased for a homomorphism of
  number fields over the rationals.
* `InverseGalois.NumberTheory.splitsCompletely_intermediateField`: **splitting completely descends
  to subfields.**
* `InverseGalois.NumberTheory.splitsCompletely_of_ringEquiv` and
  `InverseGalois.NumberTheory.splitsCompletely_of_algEquiv`: transport along an isomorphism.
* `InverseGalois.NumberTheory.splitsCompletely_ringEquiv_iff` and
  `InverseGalois.NumberTheory.splitsCompletely_algEquiv_iff`: the same transport as equivalences.
-/

open NumberField

namespace InverseGalois.NumberTheory

/-! ### Preliminaries on the ideal generated by a rational prime -/

/-- A prime of the ring of integers lying over a rational prime is nonzero. -/
private theorem ne_bot_of_liesOver_span {F : Type*} [Field F] [NumberField F] {p : ℕ}
    (hp : p.Prime) {P : Ideal (𝓞 F)} (hover : P.LiesOver (Ideal.span {(p : ℤ)})) : P ≠ ⊥ := by
  intro h
  have hspan : Ideal.span {(p : ℤ)} ≠ ⊥ := by
    simpa [Ideal.span_singleton_eq_bot] using hp.ne_zero
  refine hspan ?_
  rw [hover.over, h, Ideal.under,
    Ideal.comap_bot_of_injective _ (FaithfulSMul.algebraMap_injective ℤ (𝓞 F))]

/-- The ideal generated by a rational prime is maximal in the integers. -/
private theorem isMaximal_span_intCast {p : ℕ} (hp : p.Prime) :
    (Ideal.span {(p : ℤ)}).IsMaximal := by
  have hspan : Ideal.span {(p : ℤ)} ≠ ⊥ := by
    simpa [Ideal.span_singleton_eq_bot] using hp.ne_zero
  haveI : (Ideal.span {(p : ℤ)}).IsPrime := by
    rw [Ideal.span_singleton_prime (by exact_mod_cast hp.ne_zero)]
    exact Nat.prime_iff_prime_int.mp hp
  exact Ideal.IsPrime.isMaximal inferInstance hspan

/-- The extension of a nonzero ideal along an injective algebra map is nonzero. -/
private theorem map_ne_bot {R S : Type*} [CommRing R] [CommRing S] [Algebra R S]
    (h : Function.Injective (algebraMap R S)) {I : Ideal R} (hI : I ≠ ⊥) :
    I.map (algebraMap R S) ≠ ⊥ := by
  obtain ⟨x, hxI, hx⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hI
  intro hmap
  refine hx (h ?_)
  have hmem : algebraMap R S x ∈ I.map (algebraMap R S) := Ideal.mem_map_of_mem _ hxI
  rw [hmap, Ideal.mem_bot] at hmem
  rw [hmem, map_zero]

/-! ### Descent along an embedding -/

/-- **A rational prime that splits completely in a number field splits completely in every
number field mapping into it.**  A prime `𝔭` of `𝓞 K` above `p` is maximal, so some prime `𝔓` of
`𝓞 M` lies over it, and then over `p` as well.  Multiplicativity of the ramification index and of
the residue degree along the tower `ℤ → 𝓞 K → 𝓞 M` exhibits the invariants of `𝔭` as factors of
those of `𝔓`, both of which are one. -/
theorem splitsCompletely_of_algebra (K M : Type*) [Field K] [NumberField K] [Field M]
    [NumberField M] [Algebra K M] {p : ℕ} (hp : p.Prime) (h : SplitsCompletely M p) :
    SplitsCompletely K p := by
  have hspan : Ideal.span {(p : ℤ)} ≠ ⊥ := by
    simpa [Ideal.span_singleton_eq_bot] using hp.ne_zero
  haveI := isMaximal_span_intCast hp
  rintro 𝔭 ⟨h𝔭prime, h𝔭over⟩
  haveI : 𝔭.IsPrime := h𝔭prime
  haveI : 𝔭.LiesOver (Ideal.span {(p : ℤ)}) := h𝔭over
  have h𝔭0 : 𝔭 ≠ ⊥ := ne_bot_of_liesOver_span hp h𝔭over
  haveI : 𝔭.IsMaximal := Ring.DimensionLEOne.maximalOfPrime h𝔭0 inferInstance
  obtain ⟨𝔓, h𝔓max, h𝔓over⟩ :=
    Ideal.exists_maximal_ideal_liesOver_of_isIntegral (R := 𝓞 K) (S := 𝓞 M) 𝔭
  haveI : 𝔓.IsMaximal := h𝔓max
  haveI : 𝔓.LiesOver 𝔭 := h𝔓over
  haveI : 𝔓.LiesOver (Ideal.span {(p : ℤ)}) := Ideal.LiesOver.trans 𝔓 𝔭 (Ideal.span {(p : ℤ)})
  obtain ⟨he, hf⟩ := h 𝔓 ⟨h𝔓max.isPrime, inferInstance⟩
  -- the residue degrees multiply along the tower
  have hftower := Ideal.inertiaDeg_algebra_tower (R := ℤ) (S := 𝓞 K) (T := 𝓞 M)
    (Ideal.span {(p : ℤ)}) 𝔭 𝔓
  rw [hf] at hftower
  -- so do the ramification indices
  have hmap : 𝔭.map (algebraMap (𝓞 K) (𝓞 M)) ≠ ⊥ :=
    map_ne_bot (FaithfulSMul.algebraMap_injective (𝓞 K) (𝓞 M)) h𝔭0
  have hfg : (Ideal.span {(p : ℤ)}).map (algebraMap ℤ (𝓞 M)) ≠ ⊥ :=
    map_ne_bot (FaithfulSMul.algebraMap_injective ℤ (𝓞 M)) hspan
  have hle : 𝔭.map (algebraMap (𝓞 K) (𝓞 M)) ≤ 𝔓 :=
    Ideal.map_le_iff_le_comap.mpr h𝔓over.over.le
  have hetower := Ideal.ramificationIdx_algebra_tower (R := ℤ) (S := 𝓞 K) (T := 𝓞 M)
    (p := Ideal.span {(p : ℤ)}) (P := 𝔭) (Q := 𝔓) hmap hfg hle
  rw [he] at hetower
  exact ⟨Nat.eq_one_of_mul_eq_one_right hetower.symm,
    Nat.eq_one_of_mul_eq_one_right hftower.symm⟩

/-- **Splitting completely is inherited along a homomorphism of number fields over the
rationals.** -/
theorem splitsCompletely_of_algHom {K M : Type*} [Field K] [NumberField K] [Field M]
    [NumberField M] (f : K →ₐ[ℚ] M) {p : ℕ} (hp : p.Prime) (h : SplitsCompletely M p) :
    SplitsCompletely K p :=
  letI : Algebra K M := (f : K →+* M).toAlgebra
  splitsCompletely_of_algebra K M hp h

/-- **Splitting completely descends to subfields.**  A rational prime splitting completely in a
number field `M` splits completely in every intermediate field of `M` over the rationals. -/
theorem splitsCompletely_intermediateField {M : Type*} [Field M] [NumberField M]
    (A : IntermediateField ℚ M) {p : ℕ} (hp : p.Prime) (h : SplitsCompletely M p) :
    SplitsCompletely ↥A p :=
  splitsCompletely_of_algebra ↥A M hp h

/-! ### Transport along an isomorphism -/

/-- **Splitting completely is transported along a ring isomorphism of number fields.** -/
theorem splitsCompletely_of_ringEquiv {K M : Type*} [Field K] [NumberField K] [Field M]
    [NumberField M] (e : K ≃+* M) {p : ℕ} (hp : p.Prime) (h : SplitsCompletely M p) :
    SplitsCompletely K p :=
  letI : Algebra K M := (e : K →+* M).toAlgebra
  splitsCompletely_of_algebra K M hp h

/-- **Isomorphic number fields have the same completely split primes.** -/
theorem splitsCompletely_ringEquiv_iff {K M : Type*} [Field K] [NumberField K] [Field M]
    [NumberField M] (e : K ≃+* M) {p : ℕ} (hp : p.Prime) :
    SplitsCompletely K p ↔ SplitsCompletely M p :=
  ⟨splitsCompletely_of_ringEquiv e.symm hp, splitsCompletely_of_ringEquiv e hp⟩

/-- **Splitting completely is transported along an isomorphism of number fields over the
rationals.** -/
theorem splitsCompletely_of_algEquiv {K M : Type*} [Field K] [NumberField K] [Field M]
    [NumberField M] (e : K ≃ₐ[ℚ] M) {p : ℕ} (hp : p.Prime) (h : SplitsCompletely M p) :
    SplitsCompletely K p :=
  splitsCompletely_of_algHom (e : K →ₐ[ℚ] M) hp h

/-- **Number fields isomorphic over the rationals have the same completely split primes.** -/
theorem splitsCompletely_algEquiv_iff {K M : Type*} [Field K] [NumberField K] [Field M]
    [NumberField M] (e : K ≃ₐ[ℚ] M) {p : ℕ} (hp : p.Prime) :
    SplitsCompletely K p ↔ SplitsCompletely M p :=
  ⟨splitsCompletely_of_algEquiv e.symm hp, splitsCompletely_of_algEquiv e hp⟩

end InverseGalois.NumberTheory
