import Mathlib
import InverseGalois.CFT.BaseRamification
import InverseGalois.CFT.PoitouTate.NormLocalPower

/-!
# A radical of an element of order one is moved by inertia

A radicand read at a place of the base field where it has order one is, at a place of an extension
above it, of order the ramification index; a radical of it has order the quotient of that index by
the exponent, so the exponent divides the ramification index.  An extension generated by such a
radical therefore has nontrivial inertia at every place above that one, the order of the inertia
group being the ramification index; and inertia cannot fix the radical, for an automorphism fixing
a generating family is the identity.

The order of a radicand is a statement about the base field alone, so this is a criterion which
asks nothing of the extension beyond the radical generating it: at a place where the radicand has
order one — a uniformizer, say — the radical is genuinely moved.

## Main results

* `InverseGalois.CFT.eq_one_of_forall_smul_eq_of_adjoin_range_eq_top`: an automorphism fixing every
  member of a family generating the extension is the identity.
* `InverseGalois.CFT.dvd_ramIdx_of_ord_eq_one`: **the exponent of a radical divides the ramification
  index at a place above one where the radicand has order one.**
* `InverseGalois.CFT.exists_mem_inertia_smul_ne_of_ord_eq_one`: **inertia at a place above one where
  the radicand has order one moves a radical generating the extension.**

## Tags

number field, Kummer theory, radical, ramification index, inertia subgroup, order
-/

namespace InverseGalois.CFT

open IsDedekindDomain MulAction NumberField Rigidity.RET

/-! ### An automorphism fixing a generating family -/

section Generate

variable {K M : Type*} [Field K] [Field M] [Algebra K M]

/-- **An automorphism fixing every member of a family generating the extension is the identity.**
The powers of the automorphism fix each member of the family, hence fix the field it generates,
which is the whole extension; and only the identity fixes the whole extension. -/
theorem eq_one_of_forall_smul_eq_of_adjoin_range_eq_top {ι : Type*} {α : ι → M}
    (h : IntermediateField.adjoin K (Set.range α) = ⊤) {σ : Gal(M/K)} (hσ : ∀ i, σ (α i) = α i) :
    σ = 1 := by
  have hle : Subgroup.zpowers σ ≤ (IntermediateField.adjoin K (Set.range α)).fixingSubgroup := by
    rw [← IntermediateField.le_iff_le, IntermediateField.adjoin_le_iff]
    rintro _ ⟨i, rfl⟩
    have hzs : Subgroup.zpowers σ ≤ stabilizer Gal(M/K) (α i) :=
      Subgroup.zpowers_le.2 (mem_stabilizer_iff.2 (hσ i))
    exact fun τ => hzs τ.2
  rw [h, IntermediateField.fixingSubgroup_top] at hle
  exact Subgroup.mem_bot.1 (hle (Subgroup.mem_zpowers σ))

end Generate

/-! ### The ramification index of a radical of an element of order one -/

section Ramified

variable {k L : Type} [Field k] [NumberField k] [Field L] [NumberField L] [Algebra k L] {q : ℕ}

/-- **The exponent of a radical divides the ramification index at a place above one where the
radicand has order one.**  The order of the radicand at the place of the extension is the
ramification index, being its order below multiplied by that index, and it is also the exponent
times the order of the radical. -/
theorem dvd_ramIdx_of_ord_eq_one (hq : q ≠ 0) {b : L} {a : k} (hane : a ≠ 0)
    (ha : b ^ q = algebraMap k L a) (w : HeightOneSpectrum (𝓞 L))
    (hord : ord k (primeUnder (𝓞 k) w) a = 1) : (q : ℤ) ∣ (ramIdx (𝓞 k) w : ℤ) := by
  have hb0 : b ≠ 0 := by
    intro h
    refine hane ((map_eq_zero_iff _ (algebraMap k L).injective).1 ?_)
    rw [← ha, h, zero_pow hq]
  have h1 : ord L w (algebraMap k L a) = (ramIdx (𝓞 k) w : ℤ) := by
    rw [ord_algebraMap_eq_ramIdx_mul k w hane, hord, mul_one]
  rw [← ha, ord_pow w hb0] at h1
  exact ⟨ord L w b, h1.symm⟩

variable [IsGalois k L]

/-- **Inertia at a place above one where the radicand has order one moves a radical generating the
extension.**  Were the radical fixed by the whole inertia group, that group would be trivial, the
radical generating the extension; but its order is the ramification index, which the exponent
divides. -/
theorem exists_mem_inertia_smul_ne_of_ord_eq_one (hq : q.Prime) {b : L} {a : k} (hane : a ≠ 0)
    (ha : b ^ q = algebraMap k L a) (hgen : ∀ σ : Gal(L/k), σ b = b → σ = 1)
    (w : HeightOneSpectrum (𝓞 L)) (hord : ord k (primeUnder (𝓞 k) w) a = 1) :
    ∃ σ : Gal(L/k), σ ∈ Ideal.inertia Gal(L/k) w.asIdeal ∧ σ b ≠ b := by
  by_contra hc
  push_neg at hc
  have hle : Ideal.inertia Gal(L/k) w.asIdeal ≤ ⊥ := fun σ hσ =>
    Subgroup.mem_bot.2 (hgen σ (hc σ hσ))
  have he : ramIdx (𝓞 k) w = 1 := (inertia_eq_bot_iff_ramIdx_eq_one w).1 (le_bot_iff.1 hle)
  have hdvd := dvd_ramIdx_of_ord_eq_one hq.ne_zero hane ha w hord
  rw [he, Nat.cast_one] at hdvd
  have hq1 : q ∣ 1 := by exact_mod_cast hdvd
  exact hq.one_lt.ne' (Nat.dvd_one.1 hq1)

end Ramified

end InverseGalois.CFT
