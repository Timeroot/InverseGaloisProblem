import InverseGalois.CFT.Units.LocalEmbedding

/-!
# Prescribing the local behaviour of an `S`-unit

Let `K` be a number field containing the `p`-th roots of unity, let `S` be a finite set of places
containing the infinite ones and those above `p`, and let `a` be an `S`-unit which is not a `p`-th
power.  The extension `M` generated by the `p`-th roots of all `S`-units is abelian of exponent `p`
and of degree `p ^ s` over `K`, where `s` is the number of places in `S`; the subfield cut out by a
`p`-th root of `a` corresponds to a subgroup of index `p`.

The decomposition groups at the places splitting completely in that subfield generate it, and a
finite independent family of them is indexed by a finite set `T` of places of `K`, disjoint from
`S`, with `p ^ (#T) * p = p ^ s`.  The content of this file is that the resulting map
`U(S) → ∏_{v ∈ T} U_v / U_v ^ p` is **surjective**: its kernel is exactly the subgroup generated by
`a` and the `p`-th powers, by the local-global principle for radicals, and comparing indices with
the order `p ^ (#T)` of the target leaves no room.

Surjectivity is what lets one prescribe, at the auxiliary places of `T`, the local behaviour of a
global `S`-unit; it is the hypothesis under which an element that is locally a `p`-th power on `S`
and a unit outside `S ∪ T` is a global `p`-th power.

## Main definitions

* `InverseGalois.CFT.sUnitLocalHom`: an `X`-unit read as a unit of the valuation ring at a place
  outside `X`.

## Main results

* `InverseGalois.CFT.mem_localUnitGroup_of_pow_mem`: the units of the valuation ring are saturated.
* `InverseGalois.CFT.card_powQuotient_localUnitGroup`: at a place not dividing `n`, the units of the
  valuation ring modulo their `n`-th powers form a group of order `n`, the base field containing
  the `n`-th roots of unity.
* `InverseGalois.CFT.exists_finset_primes_sUnitSurj`: **the `S`-units surject onto the product of
  the local unit groups modulo `p`-th powers at a suitable finite set of auxiliary places**, which
  moreover split completely in the field the radical generates, so that the radicand is a local
  `p`-th power there, and which are independent enough that the subgroup fixing that field has
  order `p` raised to their number.

## Tags

number field, `S`-unit, completion, Kummer theory, second inequality, local behaviour
-/

namespace InverseGalois.CFT

open IsDedekindDomain MulAction NumberField Rigidity.RET IntermediateField

open scoped WithZero

universe u

section Valued

variable {A : Type*} [Field A] [Valued A ℤᵐ⁰]

theorem mem_localUnitGroup_of_pow_mem {n : ℕ} (hn : n ≠ 0) {u : Aˣ}
    (h : u ^ n ∈ localUnitGroup A) : u ∈ localUnitGroup A := by
  refine mem_localUnitGroup.mpr (mem_ker_unitVal (x := Additive.ofMul u).mp
    (AddMonoidHom.mem_ker.mpr ?_))
  have hzero : unitVal (n • Additive.ofMul u) = 0 := by
    rw [show (n • Additive.ofMul u : Additive Aˣ) = Additive.ofMul (u ^ n) from rfl]
    exact mem_ker_unitVal.mpr (mem_localUnitGroup.mp h)
  rw [map_nsmul, nsmul_eq_mul] at hzero
  exact (mul_eq_zero.mp hzero).resolve_left (Int.natCast_ne_zero.mpr hn)

end Valued

section Local

variable {K : Type*} [Field K] [NumberField K] {X : Set (HeightOneSpectrum (𝓞 K))}

theorem adicCoe_eq_algebraMap (y : K) (v : HeightOneSpectrum (𝓞 K)) :
    adicCoe y v = algebraMap K (v.adicCompletion K) y := rfl

/-- An `X`-unit is a unit of the valuation ring at every place outside `X`. -/
theorem adicUnitHom_mem_localUnitGroup {u : Kˣ} (hu : u ∈ sUnits K X)
    {v : HeightOneSpectrum (𝓞 K)} (hv : v ∉ X) :
    adicUnitHom v u ∈ localUnitGroup (v.adicCompletion K) := by
  refine mem_localUnitGroup.mpr
    (mem_ker_unitVal (x := Additive.ofMul (adicUnitHom v u)).mp (AddMonoidHom.mem_ker.mpr ?_))
  rw [unitVal_adicUnitHom, mem_sUnits.mp hu v hv, neg_zero]

variable (X) in
/-- **The `X`-units as units of the valuation ring at a place outside `X`.** -/
noncomputable def sUnitLocalHom {v : HeightOneSpectrum (𝓞 K)} (hv : v ∉ X) :
    ↥(sUnits K X) →* ↥(localUnitGroup (v.adicCompletion K)) :=
  MonoidHom.codRestrict ((adicUnitHom v).comp (sUnits K X).subtype) _
    fun u => adicUnitHom_mem_localUnitGroup u.2 hv

@[simp]
theorem coe_sUnitLocalHom {v : HeightOneSpectrum (𝓞 K)} (hv : v ∉ X) (u : ↥(sUnits K X)) :
    ((sUnitLocalHom X hv u : ↥(localUnitGroup (v.adicCompletion K))) : (v.adicCompletion K)ˣ)
      = adicUnitHom v (u : Kˣ) := rfl

end Local

section Card

variable {K : Type*} [Field K] [NumberField K] {n : ℕ}

/-- The number of `n`-th powers among the units of the valuation ring at a place not dividing
`n`. -/
theorem card_powQuotient_localUnitGroup [NeZero n] {ζ : K} (hζ : IsPrimitiveRoot ζ n)
    (v : HeightOneSpectrum (𝓞 K)) (hv : Valued.v ((n : ℕ) : v.adicCompletion K) = 1) :
    Nat.card (powQuotient (localUnitGroup (v.adicCompletion K)) n) = n := by
  obtain ⟨q, e, hres⟩ := exists_hasResidueChar_adicCompletion v
  have h := index_range_powMonoidHom_localUnitGroup_of_valued_eq_one
    (valued_adicCompletion_surjective v) hres (NeZero.ne n) hv
  rw [show Nat.card (powQuotient (localUnitGroup (v.adicCompletion K)) n)
    = (powMonoidHom n : ↥(localUnitGroup (v.adicCompletion K)) →*
        ↥(localUnitGroup (v.adicCompletion K))).range.index from rfl, h,
    card_rootsOfUnity_of_isPrimitiveRoot (K := K) (L := v.adicCompletion K) hζ]

end Card

/-! ### Surjectivity onto the local quotients -/

section Surj

variable {K : Type u} [Field K] [NumberField K] {Y : Type*} [Fintype Y]
  {ι : Y → HeightOneSpectrum (𝓞 K)} {p s : ℕ} {ζ : K}

set_option synthInstance.maxHeartbeats 400000
set_option maxHeartbeats 1000000

theorem exists_finset_primes_sUnitSurj (hp : p.Prime) (hζ : IsPrimitiveRoot ζ p)
    (hpX : ∀ v : HeightOneSpectrum (𝓞 K),
      Valued.v ((p : ℕ) : v.adicCompletion K) ≠ 1 → v ∈ Set.range ι)
    (P : PowBasis (sUnits K (Set.range ι)) p s)
    (hs : Nat.card (powQuotient (sUnits K (Set.range ι)) p) = p ^ s)
    {a : Kˣ} (ha : a ∈ sUnits K (Set.range ι)) (hnot : ∀ y : Kˣ, a ≠ y ^ p)
    {wa : P.ext} (hwa : wa ^ p = algebraMap K P.ext (a : K))
    (hunr : ∀ w : HeightOneSpectrum (𝓞 P.ext), primeUnder (𝓞 K) w ∉ Set.range ι →
      Algebra.IsUnramifiedAt (𝓞 K) w.asIdeal) :
    ∃ T : Finset (HeightOneSpectrum (𝓞 K)),
      (∀ v ∈ T, v ∉ Set.range ι) ∧
      (∀ v ∈ T, ∃ w : HeightOneSpectrum (𝓞 P.ext),
        w ∈ splitPlaces (fixedField (stabilizer Gal(P.ext/K) wa)) (Set.range ι) ∧
          primeUnder (𝓞 K) w = v) ∧
      Nat.card ↥(stabilizer Gal(P.ext/K) wa) = p ^ T.card ∧
      (∀ v ∈ T, ∃ c : v.adicCompletion K,
        c ^ p = algebraMap K (v.adicCompletion K) (a : K)) ∧
      ∀ c : (v : HeightOneSpectrum (𝓞 K)) → (v.adicCompletion K)ˣ,
        (∀ v ∈ T, Valued.v ((c v : v.adicCompletion K)) = 1) →
        ∃ u : Kˣ, u ∈ sUnits K (Set.range ι) ∧ ∀ v ∈ T, ∃ z : (v.adicCompletion K)ˣ,
          adicUnitHom v u = c v * z ^ p := by
  classical
  haveI : NeZero p := ⟨hp.ne_zero⟩
  haveI : Fact p.Prime := ⟨hp⟩
  haveI : IsGalois K P.ext := P.isGalois_ext hζ
  haveI : IsSolvable Gal(P.ext/K) := P.isSolvable_gal hζ
  set L : IntermediateField K P.ext := fixedField (stabilizer Gal(P.ext/K) wa) with hL
  haveI : IsSolvable Gal(P.ext/↥L) := isSolvable_gal_intermediate L
  have hfix : L.fixingSubgroup = stabilizer Gal(P.ext/K) wa :=
    IntermediateField.fixingSubgroup_fixedField _
  obtain ⟨T, hT1, hT2, hT3, hT4⟩ := exists_finset_primes_splitPlaces (L := L) hp
    (P.mul_comm_gal hζ) (P.pow_eq_one_gal hζ) (Set.finite_range ι) hunr
  -- the local `p`-th power of `a` at a place of `T`
  have hloc : ∀ v ∈ T, ∃ c : (v.adicCompletion K), c ^ p = algebraMap K (v.adicCompletion K) a := by
    intro v hv
    obtain ⟨w, hw, hwv⟩ := hT2 v hv
    have hfixw : ∀ σ : ↥(stabilizer Gal(P.ext/K) w), (σ : Gal(P.ext/K)) wa = wa := by
      intro σ
      have := hw.2 σ.2
      rw [hfix] at this
      exact this
    have := (forall_stabilizer_smul_eq_iff_exists_pow w hζ hp.ne_zero hwa.symm).mp hfixw
    rw [hwv] at this
    exact this
  refine ⟨T, hT1, hT2, by rw [← hfix]; exact hT3, hloc, ?_⟩
  intro c hc
  -- the places of `T` do not divide `p`
  have hpv : ∀ v ∈ T, Valued.v ((p : ℕ) : v.adicCompletion K) = 1 := by
    intro v hv
    by_contra h
    exact hT1 v hv (hpX v h)
  -- the map to the product of the local quotients
  set Φ : ↥(sUnits K (Set.range ι)) →* ((v : {v // v ∈ T}) →
      powQuotient (localUnitGroup ((v : HeightOneSpectrum (𝓞 K)).adicCompletion K)) p) :=
    Pi.monoidHom fun v => (QuotientGroup.mk' _).comp
      (sUnitLocalHom (Set.range ι) (hT1 v.1 v.2)) with hΦ
  have hcardTgt : Nat.card ((v : {v // v ∈ T}) →
      powQuotient (localUnitGroup ((v : HeightOneSpectrum (𝓞 K)).adicCompletion K)) p)
      = p ^ T.card := by
    have hone : ∀ v : {v // v ∈ T},
        Nat.card (powQuotient
          (localUnitGroup ((v : HeightOneSpectrum (𝓞 K)).adicCompletion K)) p) = p :=
      fun v => card_powQuotient_localUnitGroup hζ _ (hpv v.1 v.2)
    rw [Nat.card_pi, show (∏ v : {v // v ∈ T}, Nat.card (powQuotient
        (localUnitGroup ((v : HeightOneSpectrum (𝓞 K)).adicCompletion K)) p))
      = ∏ _v : {v // v ∈ T}, p from Finset.prod_congr rfl fun v _ => hone v,
      Finset.prod_const, Finset.card_univ, Fintype.card_coe]
  haveI : Finite ((v : {v // v ∈ T}) →
      powQuotient (localUnitGroup ((v : HeightOneSpectrum (𝓞 K)).adicCompletion K)) p) := by
    refine Nat.finite_of_card_ne_zero ?_
    rw [hcardTgt]
    exact pow_ne_zero _ hp.pos.ne'
  -- the subgroup cut out by `a`
  set π : ↥(sUnits K (Set.range ι)) →* powQuotient (sUnits K (Set.range ι)) p :=
    QuotientGroup.mk' _ with hπ
  set a' : ↥(sUnits K (Set.range ι)) := ⟨a, ha⟩ with ha'
  set H : Subgroup ↥(sUnits K (Set.range ι)) :=
    Subgroup.comap π (Subgroup.zpowers (π a')) with hH
  -- the kernel of the local map is that subgroup
  have hkerle : Φ.ker ≤ H := by
    intro u hu
    have hu' : ∀ v ∈ T, ∃ z : (v.adicCompletion K)ˣ, adicUnitHom v (u : Kˣ) = z ^ p := by
      intro v hv
      have hv' := congrFun (MonoidHom.mem_ker.mp hu) ⟨v, hv⟩
      rw [hΦ] at hv'
      simp only [Pi.monoidHom_apply, MonoidHom.coe_comp, Function.comp_apply, Pi.one_apply,
        QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff] at hv'
      obtain ⟨z, hz⟩ := hv'
      refine ⟨(z : (v.adicCompletion K)ˣ), ?_⟩
      rw [← coe_sUnitLocalHom (hT1 v hv) u, ← hz]
      rfl
    -- the places of the extension above `T` that split completely in `L`
    have hW : ∀ w ∈ {w : HeightOneSpectrum (𝓞 P.ext) |
        w ∈ splitPlaces L (Set.range ι) ∧ primeUnder (𝓞 K) w ∈ T},
        ∃ cw : (primeUnder (𝓞 K) w).adicCompletion K,
          cw ^ p = algebraMap K ((primeUnder (𝓞 K) w).adicCompletion K) ((u : Kˣ) : K) := by
      rintro w ⟨-, hwT⟩
      obtain ⟨z, hz⟩ := hu' _ hwT
      refine ⟨(z : (primeUnder (𝓞 K) w).adicCompletion K), ?_⟩
      rw [← Units.val_pow_eq_pow_val, ← hz, coe_adicUnitHom, adicCoe_eq_algebraMap]
    have hgen : ∀ σ : Gal(P.ext/K), σ wa = wa →
        σ ∈ Subgroup.closure (⋃ w ∈ {w : HeightOneSpectrum (𝓞 P.ext) |
          w ∈ splitPlaces L (Set.range ι) ∧ primeUnder (𝓞 K) w ∈ T},
          (stabilizer Gal(P.ext/K) w : Set Gal(P.ext/K))) := by
      intro σ hσ
      have hcl := hT4
      rw [hfix] at hcl
      rw [show (⋃ w ∈ {w : HeightOneSpectrum (𝓞 P.ext) |
          w ∈ splitPlaces L (Set.range ι) ∧ primeUnder (𝓞 K) w ∈ T},
          (stabilizer Gal(P.ext/K) w : Set Gal(P.ext/K)))
        = ⋃ w, ⋃ _ : w ∈ splitPlaces L (Set.range ι) ∧ primeUnder (𝓞 K) w ∈ T,
          (stabilizer Gal(P.ext/K) w : Set Gal(P.ext/K)) from rfl, hcl]
      exact mem_stabilizer_iff.mpr hσ
    obtain ⟨l, y, hy⟩ :=
      P.exists_zpow_mul_pow_of_forall_local hp hζ ha u.2 hwa hW hgen
    have hyeq : y ^ p = (a ^ l)⁻¹ * (u : Kˣ) := by rw [hy, inv_mul_cancel_left]
    have hymem : y ∈ sUnits K (Set.range ι) := by
      refine mem_sUnits_of_pow_mem hp.ne_zero ?_
      rw [hyeq]
      exact Subgroup.mul_mem _ (Subgroup.inv_mem _ (Subgroup.zpow_mem _ ha l)) u.2
    have hueq : u = a' ^ l * (⟨y, hymem⟩ : ↥(sUnits K (Set.range ι))) ^ p := by
      refine Subtype.ext ?_
      push_cast
      exact hy
    refine Subgroup.mem_comap.mpr ?_
    rw [hueq, map_mul, map_zpow, map_pow, pow_eq_one_powQuotient]
    exact Subgroup.mul_mem _ (Subgroup.zpow_mem _ (Subgroup.mem_zpowers _) l)
      (Subgroup.one_mem _)
  have hlekker : H ≤ Φ.ker := by
    intro u hu
    obtain ⟨l, hl⟩ := Subgroup.mem_zpowers_iff.mp (Subgroup.mem_comap.mp hu)
    have hquot : π ((a' ^ l)⁻¹ * u) = 1 := by
      rw [map_mul, map_inv, map_zpow, hl, inv_mul_cancel]
    rw [hπ, QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff] at hquot
    obtain ⟨z, hz⟩ := hquot
    have hueq : (u : Kˣ) = a ^ l * (z : Kˣ) ^ p := by
      have : ((a' ^ l)⁻¹ * u : ↥(sUnits K (Set.range ι))) = z ^ p := hz.symm
      have h2 := congrArg (Subtype.val (p := fun g : Kˣ => g ∈ sUnits K (Set.range ι))) this
      push_cast at h2
      rw [← h2, mul_inv_cancel_left]
    refine MonoidHom.mem_ker.mpr (funext fun v => ?_)
    obtain ⟨cv, hcv⟩ := hloc v.1 v.2
    have hcv0 : cv ≠ 0 := by
      intro h0
      rw [h0, zero_pow hp.ne_zero] at hcv
      exact (Units.ne_zero a) ((map_eq_zero _).mp hcv.symm)
    have hca : adicUnitHom (v : HeightOneSpectrum (𝓞 K)) a = (Units.mk0 cv hcv0) ^ p :=
      Units.ext (by rw [coe_adicUnitHom, adicCoe_eq_algebraMap, ← hcv, Units.val_pow_eq_pow_val,
        Units.val_mk0])
    have hcomm : ((Units.mk0 cv hcv0) ^ p) ^ l = ((Units.mk0 cv hcv0) ^ l) ^ p := by
      rw [← zpow_natCast (Units.mk0 cv hcv0) p, ← zpow_mul,
        ← zpow_natCast ((Units.mk0 cv hcv0) ^ l) p, ← zpow_mul, mul_comm]
    have hfinal : adicUnitHom (v : HeightOneSpectrum (𝓞 K)) (u : Kˣ)
        = ((Units.mk0 cv hcv0) ^ l * adicUnitHom (v : HeightOneSpectrum (𝓞 K)) (z : Kˣ)) ^ p := by
      rw [hueq, map_mul, map_zpow, map_pow, hca, hcomm, mul_pow]
    have hmem : ((Units.mk0 cv hcv0) ^ l * adicUnitHom (v : HeightOneSpectrum (𝓞 K)) (z : Kˣ))
        ∈ localUnitGroup ((v : HeightOneSpectrum (𝓞 K)).adicCompletion K) := by
      refine mem_localUnitGroup_of_pow_mem hp.ne_zero ?_
      rw [← hfinal]
      exact adicUnitHom_mem_localUnitGroup u.2 (hT1 v.1 v.2)
    rw [hΦ]
    simp only [Pi.monoidHom_apply, MonoidHom.coe_comp, Function.comp_apply, Pi.one_apply,
      QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff]
    exact ⟨⟨_, hmem⟩, Subtype.ext (by rw [coe_sUnitLocalHom]; exact hfinal.symm)⟩
  have hker : Φ.ker = H := le_antisymm hkerle hlekker
  -- the index of that subgroup
  have hcardGal : Nat.card Gal(P.ext/K) = p ^ s := by
    rw [IsGalois.card_aut_eq_finrank, P.finrank_ext hζ]
  have hstab : Nat.card ↥(stabilizer Gal(P.ext/K) wa) * p = p ^ s := by
    have h := Subgroup.card_mul_index (stabilizer Gal(P.ext/K) wa)
    rw [index_stabilizer_eq hp hcardGal hwa hnot, hcardGal] at h
    exact h
  have hTpow : p ^ T.card * p = p ^ s := by
    rw [← hstab, ← hfix, hT3]
  have hzp : Nat.card ↥(Subgroup.zpowers (π a')) = p := by
    rw [Nat.card_zpowers]
    refine orderOf_eq_prime (pow_eq_one_powQuotient _) ?_
    intro h1
    rw [hπ, QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff] at h1
    obtain ⟨z, hz⟩ := h1
    refine hnot (z : Kˣ) ?_
    have h2 := congrArg (Subtype.val (p := fun g : Kˣ => g ∈ sUnits K (Set.range ι))) hz
    push_cast at h2
    exact h2.symm
  have hHindex : H.index = p ^ T.card := by
    have h1 : H.index = (Subgroup.zpowers (π a')).index := by
      rw [hH, hπ]
      exact Subgroup.index_comap_of_surjective _ (QuotientGroup.mk'_surjective _)
    have h2 : (Subgroup.zpowers (π a')).index * p = p ^ s := by
      have h3 := Subgroup.index_mul_card (Subgroup.zpowers (π a'))
      rw [hzp, hs] at h3
      exact h3
    rw [h1]
    exact Nat.eq_of_mul_eq_mul_right hp.pos (h2.trans hTpow.symm)
  -- hence the local map is surjective
  have hrange : Nat.card ↥(MonoidHom.range (N := (v : {v // v ∈ T}) →
      powQuotient (localUnitGroup ((v : HeightOneSpectrum (𝓞 K)).adicCompletion K)) p) Φ)
      = Nat.card ((v : {v // v ∈ T}) →
      powQuotient (localUnitGroup ((v : HeightOneSpectrum (𝓞 K)).adicCompletion K)) p) := by
    rw [← Subgroup.index_ker (G' := (v : {v // v ∈ T}) →
      powQuotient (localUnitGroup ((v : HeightOneSpectrum (𝓞 K)).adicCompletion K)) p) Φ,
      hker, hHindex, hcardTgt]
  have hsurj : Function.Surjective Φ :=
    MonoidHom.range_eq_top.mp (Subgroup.eq_top_of_card_eq _ hrange)
  obtain ⟨u, hu⟩ := hsurj fun v => (QuotientGroup.mk' (powMonoidHom p :
      ↥(localUnitGroup ((v : HeightOneSpectrum (𝓞 K)).adicCompletion K)) →*
      ↥(localUnitGroup ((v : HeightOneSpectrum (𝓞 K)).adicCompletion K))).range)
    ⟨c (v : HeightOneSpectrum (𝓞 K)), mem_localUnitGroup.mpr (hc v.1 v.2)⟩
  refine ⟨(u : Kˣ), u.2, fun v hv => ?_⟩
  have hv' := congrFun hu ⟨v, hv⟩
  rw [hΦ] at hv'
  simp only [Pi.monoidHom_apply, MonoidHom.coe_comp, Function.comp_apply,
    QuotientGroup.mk'_apply] at hv'
  obtain ⟨z, hz⟩ := QuotientGroup.eq.mp hv'.symm
  refine ⟨(z : (v.adicCompletion K)ˣ), ?_⟩
  have h3 : ((z : ↥(localUnitGroup (v.adicCompletion K))) : (v.adicCompletion K)ˣ) ^ p
      = (c v)⁻¹ * adicUnitHom v (u : Kˣ) := by
    have h4 := congrArg
      (Subtype.val (p := fun g : (v.adicCompletion K)ˣ => g ∈ localUnitGroup (v.adicCompletion K)))
      hz
    push_cast at h4
    exact h4
  rw [h3, mul_inv_cancel_left]

end Surj

end InverseGalois.CFT
