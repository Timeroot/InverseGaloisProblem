import Mathlib
import InverseGalois.CFT.Kummer.PowBasis
import InverseGalois.CFT.Units.SUnitIndex

/-!
# The extension generated by the `p`-th roots of the `S`-units

Let `K` be a number field containing the `p`-th roots of unity, for a prime `p`, and let `S`
consist of the infinite places together with a finite injective family of primes.  The group of
`S`-units is *saturated*: an element whose `p`-th power has order zero at a prime outside `S`
already has order zero there, because that order is killed by `p`.  Its quotient by the `p`-th
powers has order `p` raised to the number of places of `S`, which is the index computed from the
short exact sequence of the `S`-units.

Choosing a basis of that quotient therefore produces a family of `S`-units which is independent
modulo `p`-th powers of the whole multiplicative group, and the extension generated by their
`p`-th roots is Galois of degree `p` raised to the number of places of `S` and contains a `p`-th
root of every `S`-unit.

## Main results

* `InverseGalois.CFT.mem_sUnits_of_pow_mem`: **the group of `X`-units is saturated.**
* `InverseGalois.CFT.card_powQuotient_sUnits`: the quotient of the `S`-units by their `p`-th powers
  has order `p` raised to the number of places of `S`.
* `InverseGalois.CFT.nonempty_powBasis_sUnits`: **the `S`-units have a basis modulo `p`-th
  powers.**
* `InverseGalois.CFT.exists_kummer_sUnits`: **the extension generated by the `p`-th roots of the
  `S`-units is Galois of degree `p` raised to the number of places of `S`.**

## Tags

number field, S-unit, Kummer theory, radical extension, saturated subgroup
-/

universe u

namespace InverseGalois.CFT

open IsDedekindDomain NumberField Rigidity.RET

/-! ### Saturation -/

section Saturated

variable {R : Type*} [CommRing R] [IsDedekindDomain R] {K : Type*} [Field K] [Algebra R K]
  [IsFractionRing R K] {n : ℕ}

/-- **The group of `X`-units is saturated**: if a power of an element is an `X`-unit then so is the
element, its order at a prime outside `X` being killed by the exponent. -/
theorem mem_sUnits_of_pow_mem (hn : n ≠ 0) {X : Set (HeightOneSpectrum R)} {u : Kˣ}
    (h : u ^ n ∈ sUnits K X) : u ∈ sUnits K X := by
  refine mem_sUnits.mpr fun v hv => ?_
  have hpow : ord K v (((u ^ n : Kˣ) : K)) = 0 := mem_sUnits.mp h v hv
  rw [Units.val_pow_eq_pow_val, ord_pow v u.ne_zero] at hpow
  exact (mul_eq_zero.mp hpow).resolve_left (Int.natCast_ne_zero.mpr hn)

end Saturated

/-! ### The Kummer basis of the `S`-units -/

section Basis

variable {K : Type u} [Field K] [NumberField K] {Y : Type*} [Fintype Y]
  {ι : Y → HeightOneSpectrum (𝓞 K)} {p : ℕ}

/-- **The quotient of the `S`-units by their `p`-th powers** has order `p` raised to the number of
places of `S`. -/
theorem card_powQuotient_sUnits (hinj : Function.Injective ι) [NeZero p]
    [HasEnoughRootsOfUnity K p] :
    Nat.card (powQuotient (sUnits K (Set.range ι)) p)
      = p ^ (Fintype.card (InfinitePlace K) + Fintype.card Y) :=
  index_range_powMonoidHom_sUnits (n := p) hinj

/-- **The `S`-units have a basis modulo `p`-th powers**, of size the number of places of `S`. -/
theorem nonempty_powBasis_sUnits (hp : p.Prime) (hinj : Function.Injective ι)
    [HasEnoughRootsOfUnity K p] :
    Nonempty (PowBasis (sUnits K (Set.range ι)) p
      (Fintype.card (InfinitePlace K) + Fintype.card Y)) := by
  haveI : NeZero p := ⟨hp.ne_zero⟩
  exact nonempty_powBasis hp (fun _ hy => mem_sUnits_of_pow_mem hp.ne_zero hy)
    (card_powQuotient_sUnits hinj)

/-- **The extension generated by the `p`-th roots of the `S`-units** of a number field containing
the `p`-th roots of unity is Galois of degree `p` raised to the number of places of `S`, and every
`S`-unit has a `p`-th root in it. -/
theorem exists_kummer_sUnits (hp : p.Prime) (hinj : Function.Injective ι)
    [HasEnoughRootsOfUnity K p] :
    ∃ (M : Type u) (_ : Field M) (_ : Algebra K M), IsGalois K M ∧
      Module.finrank K M = p ^ (Fintype.card (InfinitePlace K) + Fintype.card Y) ∧
      ∀ u ∈ sUnits K (Set.range ι), ∃ w : M, w ^ p = algebraMap K M ((u : Kˣ) : K) := by
  haveI : NeZero p := ⟨hp.ne_zero⟩
  obtain ⟨ζ, hζ⟩ := HasEnoughRootsOfUnity.exists_primitiveRoot K p
  obtain ⟨P⟩ := nonempty_powBasis_sUnits hp hinj
  exact ⟨P.ext, inferInstance, inferInstance, P.isGalois_ext hζ, P.finrank_ext hζ,
    fun u hu => P.exists_root hu⟩

end Basis

end InverseGalois.CFT
