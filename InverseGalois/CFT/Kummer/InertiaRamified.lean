import Mathlib
import InverseGalois.CFT.Kummer.InfiniteLevelPower
import InverseGalois.CFT.Kummer.RamifiedRadical
import InverseGalois.CFT.Kummer.StableRadField
import InverseGalois.CFT.Units.InertiaLift

/-!
# Inertia moves a radical whose radicand has order prime to the exponent

Let `Ω` be an arbitrary Galois extension of a number field `k` containing a primitive `q`-th root of
unity, let `b` be an element of `Ω` whose `q`-th power `a` lies in `k`, and let `P` be a nonzero
prime of the integers of `Ω`.  If `q` does not divide the order of `a` at the place of `k` below
`P`, then some element of the inertia subgroup at `P` moves `b`.

This is the converse of the criterion that inertia fixes a radical whose radicand has order a
multiple of the exponent, and it is the sharp form of it: a radicand whose order at the place below
is prime to the exponent is as far from being a norm-compatible power as it can be, and the radical
detects that.

The passage to an arbitrary extension is a descent to a level, but this time to a *chosen* level:
the radical alone generates a finite Galois subextension, the root of unity being in the base, and
there the ramification index at the place below `P` is divisible by the exponent, so inertia at
that place is nontrivial and — the level being generated by the radical — moves it.  Lifting the
element of inertia back up is exactly the surjectivity of restriction on inertia subgroups, which
is what makes the descent available in this direction.

## Main results

* `InverseGalois.CFT.exists_mem_inertia_smul_ne_of_not_dvd_ord_level`: the statement at a level the
  radical generates, transported to the extension above it.
* `InverseGalois.CFT.exists_mem_inertia_smul_ne_of_not_dvd_ord'`: **the inertia subgroup at a
  nonzero prime of an arbitrary Galois extension moves every radical whose radicand has order at
  the place below prime to the exponent.**

## Tags

number field, infinite Galois theory, inertia subgroup, Kummer theory, radical, order
-/

namespace InverseGalois.CFT

open IsDedekindDomain MulAction NumberField Rigidity.RET

section Inertia

variable {k Ω : Type} [Field k] [NumberField k] [Field Ω] [Algebra k Ω] [IsGalois k Ω] {q : ℕ}

/-- The statement at a level the radical generates, transported to the extension above it.  The
place of the level below the prime lies below the same place of the base field, so the criterion
for an extension of number fields applies there and produces an element of inertia of the level
moving the radical; that element is the restriction of an element of inertia at the prime, and
restriction commutes with the inclusion of the level. -/
theorem exists_mem_inertia_smul_ne_of_not_dvd_ord_level (hq : q.Prime)
    (L : IntermediateField k Ω) [FiniteDimensional k ↥L] [IsGalois k ↥L] {b : Ω} (hbL : b ∈ L)
    (hgen : ∀ σ : Gal(↥L/k), σ ⟨b, hbL⟩ = ⟨b, hbL⟩ → σ = 1) {a : k} (hane : a ≠ 0)
    (ha : algebraMap k Ω a = b ^ q) {P : Ideal (𝓞 Ω)} [P.IsPrime] {v : HeightOneSpectrum (𝓞 k)}
    (hv : v.asIdeal = Ideal.under (𝓞 k) P) (hord : ¬ (q : ℤ) ∣ ord k v a) :
    ∃ σ : Gal(Ω/k), σ ∈ Ideal.inertia Gal(Ω/k) P ∧ σ b ≠ b := by
  haveI : NumberField ↥L := NumberField.of_module_finite k ↥L
  have hunder : Ideal.under (𝓞 k) (Ideal.under (𝓞 ↥L) P) = v.asIdeal := by
    rw [Ideal.under_under, hv]
  have hbot : Ideal.under (𝓞 ↥L) P ≠ ⊥ := by
    intro h
    refine v.ne_bot ?_
    rw [← hunder, h, Ideal.under_def, ← RingHom.ker_eq_comap_bot,
      RingOfIntegers.ker_algebraMap_eq_bot]
  haveI : (Ideal.under (𝓞 ↥L) P).IsPrime := Ideal.IsPrime.under _ P
  obtain ⟨w, hw⟩ : ∃ w : HeightOneSpectrum (𝓞 ↥L), w.asIdeal = Ideal.under (𝓞 ↥L) P :=
    ⟨⟨Ideal.under (𝓞 ↥L) P, inferInstance, hbot⟩, rfl⟩
  have hbb : (algebraMap (↥L) Ω) (⟨b, hbL⟩ : ↥L) = b := rfl
  have hveq : primeUnder (𝓞 k) w = v :=
    HeightOneSpectrum.ext (by rw [primeUnder_asIdeal, hw, hunder])
  have haL : (⟨b, hbL⟩ : ↥L) ^ q = algebraMap k ↥L a := by
    refine (algebraMap (↥L) Ω).injective ?_
    rw [← IsScalarTower.algebraMap_apply k ↥L Ω, map_pow, hbb, ha]
  obtain ⟨τ, hτI, hτb⟩ := exists_mem_inertia_smul_ne_of_not_dvd_ord hq hane haL hgen w
    (by rw [hveq]; exact hord)
  obtain ⟨σ, hσI, hσL⟩ := exists_mem_inertia_restrictNormalHom_eq L hw hτI
  refine ⟨σ, hσI, fun hcon => hτb ?_⟩
  have h1 : σ.restrictNormal ↥L = τ := hσL
  have hcom := AlgEquiv.restrictNormal_commutes σ ↥L (⟨b, hbL⟩ : ↥L)
  rw [h1, hbb, hcon] at hcom
  exact Subtype.ext hcom

/-- **The inertia subgroup at a nonzero prime of an arbitrary Galois extension moves every radical
whose radicand has order at the place below prime to the exponent.**  The radical generates a finite
Galois level
over the base field, the root of unity being there, and the level is generated by the radical, so
the criterion at a level applies. -/
theorem exists_mem_inertia_smul_ne_of_not_dvd_ord' (hq : q.Prime) {ζ : k}
    (hζ : IsPrimitiveRoot ζ q) {b : Ω} {a : k} (hane : a ≠ 0) (ha : algebraMap k Ω a = b ^ q)
    {P : Ideal (𝓞 Ω)} [P.IsPrime] {v : HeightOneSpectrum (𝓞 k)}
    (hv : v.asIdeal = Ideal.under (𝓞 k) P) (hord : ¬ (q : ℤ) ∣ ord k v a) :
    ∃ σ : Gal(Ω/k), σ ∈ Ideal.inertia Gal(Ω/k) P ∧ σ b ≠ b := by
  haveI : Normal k ↥(IntermediateField.adjoin k (Set.range fun _ : Unit => b)) :=
    normal_adjoin_radicals (α := fun _ : Unit => b) hq hζ (b := fun _ : Unit => a)
      (fun _ => hane) (fun _ => ha.symm)
  haveI : Finite ↥(Set.range fun _ : Unit => b) := (Set.finite_range _).to_subtype
  haveI : FiniteDimensional k ↥(IntermediateField.adjoin k (Set.range fun _ : Unit => b)) :=
    IntermediateField.finiteDimensional_adjoin (by
      rintro _ ⟨i, rfl⟩
      refine ⟨Polynomial.X ^ q - Polynomial.C a, Polynomial.monic_X_pow_sub_C _ hq.ne_zero, ?_⟩
      rw [Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_C, ha, sub_self])
  haveI : IsGalois k ↥(IntermediateField.adjoin k (Set.range fun _ : Unit => b)) := ⟨⟩
  refine exists_mem_inertia_smul_ne_of_not_dvd_ord_level hq
    (IntermediateField.adjoin k (Set.range fun _ : Unit => b))
    (IntermediateField.subset_adjoin k _ ⟨(), rfl⟩) (fun σ hσ => ?_) hane ha hv hord
  exact eq_one_of_forall_smul_eq_of_adjoin_range_eq_top
    (adjoin_range_val_eq_top (K := k) (fun _ : Unit => b)) fun _ => hσ

end Inertia

end InverseGalois.CFT
