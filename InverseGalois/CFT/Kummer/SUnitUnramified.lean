import Mathlib
import InverseGalois.CFT.Kummer.GlobalPower
import InverseGalois.CFT.Kummer.SUnitExt
import InverseGalois.CFT.Kummer.Unramified
import InverseGalois.CFT.Units.SUnitValuation

/-!
# The extension generated by the `p`-th roots of the `S`-units is unramified outside `S`

A radical extension of number fields is unramified at every prime away from the exponent at which
all of its radicands are units.  The extension generated by the `p`-th roots of a basis of the
`S`-units modulo `p`-th powers is radical, its radicands being `S`-units, so it is unramified at
every prime outside `S` once `S` contains every prime above `p`.

## Main results

* `InverseGalois.CFT.PowBasis.isUnramifiedAt_ext`: **the extension generated by the `p`-th roots of
  a basis of the `S`-units is unramified at every prime outside `S`.**

## Tags

number field, S-unit, Kummer theory, radical extension, unramified
-/

universe u

namespace InverseGalois.CFT

open IsDedekindDomain NumberField Rigidity.RET

namespace PowBasis

variable {K : Type u} [Field K] [NumberField K] {Y : Type*} [Fintype Y]
  {ι : Y → HeightOneSpectrum (𝓞 K)} {p s : ℕ} {ζ : K}

omit [Fintype Y] in
/-- **The extension generated by the `p`-th roots of a basis of the `S`-units is unramified at
every prime outside `S`**, provided `S` carries every prime above `p`: the radicands are `S`-units,
hence units at such a prime. -/
theorem isUnramifiedAt_ext (P : PowBasis (sUnits K (Set.range ι)) p s) (hp : p.Prime)
    (hζ : IsPrimitiveRoot ζ p)
    (hpX : ∀ v : HeightOneSpectrum (𝓞 K), (p : 𝓞 K) ∈ v.asIdeal → v ∈ Set.range ι)
    (w : HeightOneSpectrum (𝓞 P.ext)) (hw : primeUnder (𝓞 K) w ∉ Set.range ι) :
    Algebra.IsUnramifiedAt (𝓞 K) w.asIdeal := by
  haveI : NeZero p := ⟨hp.ne_zero⟩
  haveI : IsGalois K P.ext := P.isGalois_ext hζ
  refine isUnramifiedAt_of_radicals hp hζ (α := Kummer.radRoot p P.rad) (a := P.rad)
    (fun i => Kummer.radRoot_pow (n := p) (g := P.rad) i)
    (Kummer.adjoin_radRoot_eq_top hζ P.rad_ne_zero) ?_
    fun i => valuation_eq_one_of_mem_sUnits (P.mem i) hw
  intro hmem
  refine hw (hpX _ ?_)
  rw [primeUnder_asIdeal, Ideal.under_def, Ideal.mem_comap, map_natCast]
  exact hmem

end PowBasis

end InverseGalois.CFT
