import Mathlib
import InverseGalois.CFT.Kummer.RadicalNormal

/-!
# The field generated by the radicals of a stable family

Fix a field `k`, a normal extension `A` of `k`, and an intermediate field `Ω` of `A / k` containing
a primitive `p`-th root of unity.  Given a family of nonzero elements of `Ω` and a choice of a
`p`-th root of each of them inside `A`, the field they generate over `Ω` is normal over `k` as soon
as the family of radicands is carried into itself by every `k`-embedding of `A`: a conjugate of a
radical is a `p`-th root of another radicand, so it differs from the chosen root of that radicand
by a `p`-th root of unity, which already lies in `Ω`.

This is the same argument that makes the radical field of a power basis normal, but it asks nothing
of the family beyond stability — no independence, no saturation, no basis.  For the same reason the
field is normal, finite and hence Galois over `Ω` itself: a conjugate over `Ω` of a radical is a
`p`-th root of the *same* radicand.

Two lemmas about generation accompany this.  A family of elements of an extension generates, over
the base, the field it generates read inside that field; and if a set generates an extension over
an intermediate field, then that intermediate field together with the field the set generates over
the bottom field generate the extension over the bottom field.  Together they present the radical
field as a compositum of the intermediate field with a field generated over the bottom field by
radicals alone.

That second factor is itself normal over the bottom field, for the same reason as before and with
no stability hypothesis at all: its generators are roots of elements of the bottom field, so a
conjugate of a generator is a root of the very same element.

## Main results

* `InverseGalois.CFT.adjoin_range_val_eq_top`: a family generates, over the base, the field it
  generates, read inside that field.
* `InverseGalois.CFT.fieldRange_sup_adjoin_eq_top`: **an intermediate field and the field a
  generating set spans over the bottom field generate the whole extension.**
* `InverseGalois.CFT.map_mem_ambientRadField_of_forall`: the conjugates of the radicals of a stable
  family stay inside the field they generate.
* `InverseGalois.CFT.normal_ambientRadField_of_forall`: **the field generated by the radicals of a
  stable family is normal over the bottom field.**
* `InverseGalois.CFT.normal_base_ambientRadField_of_forall`,
  `InverseGalois.CFT.finiteDimensional_ambientRadField_of_forall`,
  `InverseGalois.CFT.isGalois_ambientRadField_of_forall`: it is finite and Galois over the
  intermediate field it is built on.
* `InverseGalois.CFT.normal_adjoin_radicals`: **the field a family of radicals of elements of the
  base field generates over it is normal over it**, as soon as the base contains a primitive root
  of unity of the exponent.

## Tags

Kummer theory, radical extension, normal extension, compositum
-/

namespace InverseGalois.CFT

/-! ### Generation -/

section Generate

variable {K M : Type*} [Field K] [Field M] [Algebra K M]

/-- **A family of elements generates, over the base field, the field it generates, read inside that
field.**  Lifting the two sides back to the ambient extension turns the claim into the definition of
the field the family generates. -/
theorem adjoin_range_val_eq_top {ι : Type*} (α : ι → M) :
    IntermediateField.adjoin K (Set.range fun i =>
        (⟨α i, IntermediateField.subset_adjoin K (Set.range α) ⟨i, rfl⟩⟩ :
          ↥(IntermediateField.adjoin K (Set.range α)))) = ⊤ := by
  refine IntermediateField.lift_injective _ ?_
  rw [IntermediateField.lift_adjoin, IntermediateField.lift_top, ← Set.range_comp]
  rfl

variable {L : Type*} [Field L] [Algebra K L] [Algebra L M] [IsScalarTower K L M]

/-- **An intermediate field, together with the field a set generating the extension over it spans
over the bottom field, generates the extension over the bottom field.**  The two of them span a
field of the extension which is stable under multiplication by the intermediate field, hence is an
extension of it containing the generating set. -/
theorem fieldRange_sup_adjoin_eq_top {S : Set M} (h : IntermediateField.adjoin L S = ⊤) :
    (IsScalarTower.toAlgHom K L M).fieldRange ⊔ IntermediateField.adjoin K S = ⊤ := by
  have hmemL : ∀ l : L, algebraMap L M l ∈
      (IsScalarTower.toAlgHom K L M).fieldRange ⊔ IntermediateField.adjoin K S := fun l =>
    SetLike.le_def.1 le_sup_left (AlgHom.mem_fieldRange.2 ⟨l, rfl⟩)
  let T : IntermediateField L M :=
    ((IsScalarTower.toAlgHom K L M).fieldRange ⊔
      IntermediateField.adjoin K S).toSubfield.toIntermediateField hmemL
  have hSZ : ∀ y ∈ S, y ∈ (IsScalarTower.toAlgHom K L M).fieldRange ⊔
      IntermediateField.adjoin K S := fun y hy =>
    SetLike.le_def.1 (le_sup_right (a := (IsScalarTower.toAlgHom K L M).fieldRange))
      (IntermediateField.subset_adjoin K S hy)
  have hS : S ⊆ (T : Set M) := hSZ
  have hle : IntermediateField.adjoin L S ≤ T := IntermediateField.adjoin_le_iff.2 hS
  rw [h] at hle
  refine le_antisymm le_top fun x _ => ?_
  exact hle (IntermediateField.mem_top (x := x))

end Generate

/-! ### The radical field of a stable family -/

section Family

variable {k A : Type*} [Field k] [Field A] [Algebra k A] {Ω : IntermediateField k A}
  {p : ℕ} {ι : Type*} {w : ι → A} {a : ι → ↥Ω}

/-- A radical is nonzero when its radicand is. -/
theorem radical_ne_zero_of_pow_eq (hp : p ≠ 0) (ha : ∀ i, a i ≠ 0)
    (hw : ∀ i, w i ^ p = algebraMap ↥Ω A (a i)) (i : ι) : w i ≠ 0 := by
  intro h
  refine ha i ?_
  have hzero := hw i
  rw [h, zero_pow hp] at hzero
  exact (map_eq_zero_iff _ (algebraMap ↥Ω A).injective).1 hzero.symm

/-- **An element of the ambient field whose `p`-th power is that of a chosen radical lies in the
field the radicals generate**, differing from that radical by a `p`-th root of unity. -/
theorem mem_ambientRadField_of_pow_eq [NeZero p] {ζ : ↥Ω} (hζ : IsPrimitiveRoot ζ p)
    {x : A} {j : ι} (hj : w j ≠ 0) (hx : x ^ p = w j ^ p) : x ∈ ambientRadField Ω w := by
  have hone : (x / w j) ^ p = 1 := by rw [div_pow, hx, div_self (pow_ne_zero _ hj)]
  have hsplit : x = x / w j * w j := (div_mul_cancel₀ _ hj).symm
  rw [hsplit]
  exact mul_mem (mem_ambientRadField_of_pow_eq_one hζ w hone) (mem_ambientRadField Ω w j)

/-- **The conjugates of the radicals of a stable family stay inside the field they generate.**  A
conjugate of a radical is a `p`-th root of another radicand of the family, hence differs from the
chosen radical of that radicand by a `p`-th root of unity. -/
theorem map_mem_ambientRadField_of_forall (hp : p.Prime) {ζ : ↥Ω} (hζ : IsPrimitiveRoot ζ p)
    (ha : ∀ i, a i ≠ 0) (hw : ∀ i, w i ^ p = algebraMap ↥Ω A (a i)) {τ : A →ₐ[k] A}
    (hstab : ∀ i, ∃ j, τ (algebraMap ↥Ω A (a i)) = algebraMap ↥Ω A (a j)) (i : ι) :
    τ (w i) ∈ ambientRadField Ω w := by
  haveI : NeZero p := ⟨hp.ne_zero⟩
  obtain ⟨j, hj⟩ := hstab i
  refine mem_ambientRadField_of_pow_eq hζ (radical_ne_zero_of_pow_eq hp.ne_zero ha hw j) ?_
  rw [← map_pow, hw i, hj, hw j]

/-- **The field generated by the radicals of a stable family is normal over the bottom field.**  It
is generated over the bottom field by the intermediate field, which is normal, together with the
radicals, whose conjugates it contains. -/
theorem normal_ambientRadField_of_forall [Normal k A] [Normal k ↥Ω] (hp : p.Prime) {ζ : ↥Ω}
    (hζ : IsPrimitiveRoot ζ p) (ha : ∀ i, a i ≠ 0)
    (hw : ∀ i, w i ^ p = algebraMap ↥Ω A (a i))
    (hstab : ∀ (τ : A →ₐ[k] A) (i : ι), ∃ j, τ (algebraMap ↥Ω A (a i)) = algebraMap ↥Ω A (a j)) :
    Normal k ↥(ambientRadField Ω w) := by
  refine (IntermediateField.restrictScalars_normal (F := k)).mp ?_
  refine IntermediateField.normal_iff_forall_map_le.2 fun τ => ?_
  rw [IntermediateField.map_le_iff_le_comap]
  refine (IntermediateField.restrictScalars_adjoin_eq_sup k Ω (Set.range w)).trans_le ?_
  refine sup_le (fun x hx => ?_) (IntermediateField.adjoin_le_iff.2 ?_)
  · show τ x ∈ ambientRadField Ω w
    have hxΩ : τ x ∈ Ω :=
      IntermediateField.normal_iff_forall_map_le.1 ‹Normal k ↥Ω› τ ⟨x, hx, rfl⟩
    exact (ambientRadField Ω w).algebraMap_mem ⟨τ x, hxΩ⟩
  · rintro _ ⟨i, rfl⟩
    show τ (w i) ∈ ambientRadField Ω w
    exact map_mem_ambientRadField_of_forall hp hζ ha hw (hstab τ) i

/-- **The field generated by radicals is normal over the intermediate field it is built on**: a
conjugate over that field of a radical is a `p`-th root of the same radicand. -/
theorem normal_base_ambientRadField_of_forall [Normal k A] (hp : p.Prime) {ζ : ↥Ω}
    (hζ : IsPrimitiveRoot ζ p) (ha : ∀ i, a i ≠ 0)
    (hw : ∀ i, w i ^ p = algebraMap ↥Ω A (a i)) : Normal ↥Ω ↥(ambientRadField Ω w) := by
  haveI : NeZero p := ⟨hp.ne_zero⟩
  haveI : Normal ↥Ω A := Normal.tower_top_of_normal k ↥Ω A
  refine IntermediateField.normal_iff_forall_map_le.2 fun τ => ?_
  rw [IntermediateField.map_le_iff_le_comap]
  refine IntermediateField.adjoin_le_iff.2 ?_
  rintro _ ⟨i, rfl⟩
  show τ (w i) ∈ ambientRadField Ω w
  refine mem_ambientRadField_of_pow_eq hζ (radical_ne_zero_of_pow_eq hp.ne_zero ha hw i) ?_
  rw [← map_pow, hw i, AlgHom.commutes]

/-- The field generated by finitely many radicals is finite over the intermediate field it is built
on, each radical being a root of a binomial. -/
theorem finiteDimensional_ambientRadField_of_forall [Finite ι] (hp : p ≠ 0)
    (hw : ∀ i, w i ^ p = algebraMap ↥Ω A (a i)) :
    FiniteDimensional ↥Ω ↥(ambientRadField Ω w) := by
  haveI : Finite ↥(Set.range w) := (Set.finite_range w).to_subtype
  refine IntermediateField.finiteDimensional_adjoin ?_
  rintro _ ⟨i, rfl⟩
  refine ⟨Polynomial.X ^ p - Polynomial.C (a i), Polynomial.monic_X_pow_sub_C _ hp, ?_⟩
  rw [Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_C, hw i, sub_self]

/-- The field generated by finitely many radicals is Galois over the intermediate field it is built
on. -/
theorem isGalois_ambientRadField_of_forall [Finite ι] [Normal k A] [CharZero ↥Ω] (hp : p.Prime)
    {ζ : ↥Ω} (hζ : IsPrimitiveRoot ζ p) (ha : ∀ i, a i ≠ 0)
    (hw : ∀ i, w i ^ p = algebraMap ↥Ω A (a i)) : IsGalois ↥Ω ↥(ambientRadField Ω w) := by
  haveI := normal_base_ambientRadField_of_forall hp hζ ha hw
  haveI := finiteDimensional_ambientRadField_of_forall (a := a) hp.ne_zero hw
  exact ⟨⟩

end Family

/-! ### Radicals of elements of the base field -/

section BaseRadicals

variable {F E : Type*} [Field F] [Field E] [Algebra F E] {p : ℕ} {ι : Type*} {α : ι → E}

/-- **A `p`-th root of unity of an extension lies in the field a family generates over the base**,
because the base already contains a primitive one. -/
theorem mem_adjoin_of_pow_eq_one [NeZero p] {ζ : F} (hζ : IsPrimitiveRoot ζ p) (α : ι → E)
    {x : E} (hx : x ^ p = 1) : x ∈ IntermediateField.adjoin F (Set.range α) := by
  obtain ⟨i, -, rfl⟩ := (hζ.map_of_injective (algebraMap F E).injective).eq_pow_of_pow_eq_one hx
  exact pow_mem ((IntermediateField.adjoin F (Set.range α)).algebraMap_mem ζ) i

/-- **The field a family of `p`-th roots of elements of the base field generates over it is normal
over it.**  A conjugate of such a radical is a `p`-th root of the same radicand, so it differs from
the radical by a `p`-th root of unity, which the base field already contains. -/
theorem normal_adjoin_radicals [Normal F E] (hp : p.Prime) {ζ : F} (hζ : IsPrimitiveRoot ζ p)
    {b : ι → F} (hb : ∀ i, b i ≠ 0) (hα : ∀ i, α i ^ p = algebraMap F E (b i)) :
    Normal F ↥(IntermediateField.adjoin F (Set.range α)) := by
  haveI : NeZero p := ⟨hp.ne_zero⟩
  refine IntermediateField.normal_iff_forall_map_le.2 fun τ => ?_
  rw [IntermediateField.map_le_iff_le_comap]
  refine IntermediateField.adjoin_le_iff.2 ?_
  rintro _ ⟨i, rfl⟩
  show τ (α i) ∈ IntermediateField.adjoin F (Set.range α)
  have hbne : algebraMap F E (b i) ≠ 0 :=
    (map_ne_zero_iff _ (algebraMap F E).injective).2 (hb i)
  have hne : α i ≠ 0 := fun h => hbne (by rw [← hα i, h, zero_pow hp.ne_zero])
  have hone : (τ (α i) / α i) ^ p = 1 := by
    rw [div_pow, ← _root_.map_pow, hα i, AlgHom.commutes, div_self hbne]
  have hsplit : τ (α i) = τ (α i) / α i * α i := (div_mul_cancel₀ _ hne).symm
  rw [hsplit]
  exact mul_mem (mem_adjoin_of_pow_eq_one hζ α hone)
    (IntermediateField.subset_adjoin F (Set.range α) ⟨i, rfl⟩)

end BaseRadicals

end InverseGalois.CFT
