import Mathlib
import InverseGalois.Rigidity.RET.KummerBase

/-!
# A basis for a subgroup modulo its `p`-th powers

Let `B` be a subgroup of a commutative group and let `p` be a prime.  The quotient of `B` by the
subgroup of `p`-th powers of its elements is killed by `p`, so it is a vector space over the field
with `p` elements; if it is finite of order `p ^ s` it has a basis of `s` elements.  Lifting that
basis back to `B` gives a family `g` of `s` elements of `B` such that a product of integer powers
of the `g` is a `p`-th power exactly when every exponent is divisible by `p`, and such that every
element of `B` is a product of powers of the `g` times a `p`-th power.

For a subgroup of the units of a field which is *saturated*, in the sense that an element whose
`p`-th power lies in the subgroup already lies in it, such a family is independent modulo `p`-th
powers of the whole multiplicative group.  It therefore carries a Kummer setup, and the extension
generated by `p`-th roots of the family has degree `p ^ s` and contains a `p`-th root of every
element of the subgroup.

## Main definitions

* `InverseGalois.CFT.powQuotient`: the quotient of a subgroup by the `p`-th powers of its elements.
* `InverseGalois.CFT.PowBasis`: a family of elements of a subgroup of the units of a field which is
  independent modulo `p`-th powers and spans the subgroup modulo `p`-th powers.
* `InverseGalois.CFT.PowBasis.setup`: the Kummer setup attached to such a family.

## Main results

* `InverseGalois.CFT.exists_pow_basis`: **a subgroup of a commutative group whose quotient by its
  `p`-th powers has order `p ^ s` has a family of `s` elements which is independent and spanning
  modulo `p`-th powers.**
* `InverseGalois.CFT.nonempty_powBasis`: the same for a saturated subgroup of the units of a field.
* `InverseGalois.CFT.PowBasis.exists_root`: **every element of the subgroup has a `p`-th root in
  the extension generated by the `p`-th roots of the family.**
* `InverseGalois.CFT.PowBasis.finrank_ext`: **that extension has degree `p ^ s`.**
* `InverseGalois.CFT.PowBasis.isGalois_ext`: and it is Galois.

## Tags

Kummer theory, radical extension, elementary abelian, basis, saturated subgroup
-/

namespace InverseGalois.CFT

open Rigidity.RET

/-! ### The quotient of a subgroup by its `p`-th powers -/

section Quotient

variable {G : Type*} [CommGroup G] (B : Subgroup G) (p : ℕ)

/-- **The quotient of a subgroup of a commutative group by the subgroup of `p`-th powers of its
elements.** -/
abbrev powQuotient : Type _ := ↥B ⧸ (powMonoidHom p : ↥B →* ↥B).range

variable {B p}

/-- The quotient of a subgroup by its `p`-th powers is killed by `p`. -/
theorem pow_eq_one_powQuotient (q : powQuotient B p) : q ^ p = 1 := by
  refine QuotientGroup.induction_on q fun b => ?_
  rw [← QuotientGroup.mk_pow, QuotientGroup.eq_one_iff]
  exact ⟨b, powMonoidHom_apply p b⟩

/-- Read additively, the quotient of a subgroup by its `p`-th powers is killed by `p`. -/
theorem nsmul_eq_zero_powQuotient (x : Additive (powQuotient B p)) : p • x = 0 :=
  pow_eq_one_powQuotient (Additive.toMul x)

variable (B p) in
/-- **The quotient of a subgroup by its `p`-th powers is a vector space over the field with `p`
elements**, being killed by `p`. -/
instance instModuleZModPowQuotient : Module (ZMod p) (Additive (powQuotient B p)) :=
  AddCommGroup.zmodModule nsmul_eq_zero_powQuotient

/-- **A subgroup of a commutative group whose quotient by its `p`-th powers has order `p ^ s` has
a family of `s` elements which is independent and spanning modulo `p`-th powers.** -/
theorem exists_pow_basis {s : ℕ} (hp : p.Prime) (hcard : Nat.card (powQuotient B p) = p ^ s) :
    ∃ g : Fin s → ↥B,
      (∀ (m : Fin s → ℤ) (y : ↥B), y ^ p = ∏ i, g i ^ m i → ∀ i, (p : ℤ) ∣ m i) ∧
      (∀ b : ↥B, ∃ (m : Fin s → ℤ) (z : ↥B), b = (∏ i, g i ^ m i) * z ^ p) := by
  haveI : Fact p.Prime := ⟨hp⟩
  haveI : NeZero p := ⟨hp.ne_zero⟩
  haveI : Finite (powQuotient B p) := by
    refine Nat.finite_of_card_ne_zero ?_
    rw [hcard]
    exact pow_ne_zero _ hp.ne_zero
  haveI : Finite (Additive (powQuotient B p)) := inferInstanceAs (Finite (powQuotient B p))
  set π : ↥B →* powQuotient B p := QuotientGroup.mk' _ with hπ
  -- the quotient is a vector space of dimension `s` over the field with `p` elements
  have hfr : Module.finrank (ZMod p) (Additive (powQuotient B p)) = s := by
    haveI := Fintype.ofFinite (Additive (powQuotient B p))
    have h1 : Nat.card (Additive (powQuotient B p))
        = p ^ Module.finrank (ZMod p) (Additive (powQuotient B p)) := by
      rw [Nat.card_eq_fintype_card, Module.card_eq_pow_finrank (K := ZMod p), ZMod.card]
    have h2 : Nat.card (Additive (powQuotient B p)) = p ^ s := hcard
    rw [h2] at h1
    exact (Nat.pow_right_injective hp.two_le h1).symm
  obtain ⟨bas⟩ : Nonempty (Module.Basis (Fin s) (ZMod p) (Additive (powQuotient B p))) :=
    ⟨Module.finBasisOfFinrankEq (ZMod p) (Additive (powQuotient B p)) hfr⟩
  -- lift the basis to the subgroup
  have hrep : ∀ i : Fin s, ∃ x : ↥B, Additive.ofMul (π x) = bas i := by
    intro i
    obtain ⟨x, hx⟩ := QuotientGroup.mk_surjective (Additive.toMul (bas i))
    exact ⟨x, by rw [hπ, QuotientGroup.mk'_apply, hx]; rfl⟩
  choose g hg using hrep
  have hkey : ∀ m : Fin s → ℤ, Additive.ofMul (π (∏ i, g i ^ m i)) = ∑ i, m i • bas i := by
    intro m
    rw [map_prod, ofMul_prod]
    exact Finset.sum_congr rfl fun i _ => by rw [map_zpow, ofMul_zpow, hg i]
  refine ⟨g, ?_, ?_⟩
  · -- independence
    intro m y hy i
    have hzero : ∑ i, m i • bas i = 0 := by
      rw [← hkey m, ← hy, map_pow]
      exact congrArg Additive.ofMul (pow_eq_one_powQuotient _)
    have hli := bas.linearIndependent
    rw [Fintype.linearIndependent_iff] at hli
    have hz : ∀ j, ((m j : ZMod p)) = 0 := by
      refine hli (fun j => (m j : ZMod p)) ?_
      rw [← hzero]
      exact Finset.sum_congr rfl fun j _ => Int.cast_smul_eq_zsmul (ZMod p) (m j) (bas j)
    exact (ZMod.intCast_zmod_eq_zero_iff_dvd (m i) p).mp (hz i)
  · -- spanning
    intro b
    set x : Additive (powQuotient B p) := Additive.ofMul (π b) with hx
    refine ⟨fun i => ((bas.repr x i).val : ℤ), ?_⟩
    have hsum : ∑ i, ((bas.repr x i).val : ℤ) • bas i = x := by
      conv_rhs => rw [← bas.sum_repr x]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [← Int.cast_smul_eq_zsmul (ZMod p) ((bas.repr x i).val : ℤ) (bas i)]
      congr 1
      push_cast
      exact ZMod.natCast_rightInverse (bas.repr x i)
    have heq : π (∏ i, g i ^ ((bas.repr x i).val : ℤ)) = π b := by
      refine Additive.ofMul.injective ?_
      rw [hkey, hsum, hx]
    rw [hπ, QuotientGroup.mk'_apply, QuotientGroup.mk'_apply, QuotientGroup.eq] at heq
    obtain ⟨z, hz⟩ := heq
    refine ⟨z, ?_⟩
    rw [powMonoidHom_apply] at hz
    show b = (∏ i, g i ^ ((bas.repr x i).val : ℤ)) * z ^ p
    rw [hz, mul_inv_cancel_left]

end Quotient

/-! ### A saturated subgroup of the units of a field -/

section Field

variable {K : Type*} [Field K] {p s : ℕ}

/-- **A family of elements of a subgroup of the units of a field which is independent modulo
`p`-th powers and spans the subgroup modulo `p`-th powers.** -/
structure PowBasis (B : Subgroup Kˣ) (p s : ℕ) where
  /-- The chosen radicands. -/
  g : Fin s → Kˣ
  /-- The radicands belong to the subgroup. -/
  mem : ∀ i, g i ∈ B
  /-- A product of powers of the radicands is a `p`-th power only when all the exponents are
  divisible by `p`. -/
  indep : ∀ (m : Fin s → ℤ) (y : K), y ≠ 0 → y ^ p = ∏ i, ((g i : K)) ^ m i → ∀ i, (p : ℤ) ∣ m i
  /-- Every element of the subgroup is a product of powers of the radicands times a `p`-th
  power. -/
  span : ∀ b ∈ B, ∃ (m : Fin s → ℤ) (z : Kˣ), b = (∏ i, g i ^ m i) * z ^ p

/-- **A saturated subgroup of the units of a field whose quotient by its `p`-th powers has order
`p ^ s` carries a family of `s` radicands.**  Saturation turns independence inside the subgroup
into independence inside the whole multiplicative group. -/
theorem nonempty_powBasis (hp : p.Prime) {B : Subgroup Kˣ}
    (hsat : ∀ y : Kˣ, y ^ p ∈ B → y ∈ B) (hcard : Nat.card (powQuotient B p) = p ^ s) :
    Nonempty (PowBasis B p s) := by
  obtain ⟨g, hindep, hspan⟩ := exists_pow_basis hp hcard
  refine ⟨⟨fun i => (g i : Kˣ), fun i => (g i).2, ?_, ?_⟩⟩
  · intro m y hy hpow i
    set u : Kˣ := Units.mk0 y hy with hu
    have hup : u ^ p = ∏ i, ((g i : Kˣ)) ^ m i := by
      refine Units.ext ?_
      push_cast
      exact hpow
    have hmem : (∏ i, ((g i : Kˣ)) ^ m i) ∈ B :=
      Subgroup.prod_mem _ fun i _ => zpow_mem (g i).2 _
    have huB : u ∈ B := hsat u (hup ▸ hmem)
    refine hindep m ⟨u, huB⟩ (Subtype.ext ?_) i
    push_cast
    exact hup
  · intro b hb
    obtain ⟨m, z, hz⟩ := hspan ⟨b, hb⟩
    refine ⟨m, (z : Kˣ), ?_⟩
    have h := congrArg (fun x : ↥B => (x : Kˣ)) hz
    push_cast at h
    exact h

namespace PowBasis

variable {B : Subgroup Kˣ} (P : PowBasis B p s)

/-- The radicands of the family, read in the field. -/
def rad : Fin s → K := fun i => ((P.g i : Kˣ) : K)

theorem rad_ne_zero (i : Fin s) : P.rad i ≠ 0 := Units.ne_zero _

/-- **The extension generated by `p`-th roots of the radicands of the family.** -/
abbrev ext : Type _ := Kummer.RadExt p P.rad

variable [NeZero p]

/-- **Every element of the subgroup has a `p`-th root in the extension.** -/
theorem exists_root {b : Kˣ} (hb : b ∈ B) :
    ∃ w : P.ext, w ^ p = algebraMap K P.ext (b : K) := by
  obtain ⟨m, z, hz⟩ := P.span b hb
  refine ⟨(∏ i, Kummer.radRoot p P.rad i ^ m i) * algebraMap K P.ext (z : K), ?_⟩
  have hstep : ∀ i : Fin s, (Kummer.radRoot p P.rad i ^ m i) ^ p
      = algebraMap K P.ext (P.rad i) ^ m i := by
    intro i
    rw [← Kummer.radRoot_pow (n := p) (g := P.rad) i,
      ← zpow_natCast (Kummer.radRoot p P.rad i ^ m i) p, ← zpow_mul,
      ← zpow_natCast (Kummer.radRoot p P.rad i) p, ← zpow_mul, mul_comm]
  have hb' : (b : K) = (∏ i, P.rad i ^ m i) * (z : K) ^ p := by
    have h := congrArg (fun u : Kˣ => (u : K)) hz
    push_cast at h
    exact h
  rw [mul_pow, ← Finset.prod_pow, hb', map_mul, map_prod, map_pow]
  refine congrArg (fun x => x * (algebraMap K P.ext (z : K)) ^ p) ?_
  exact Finset.prod_congr rfl fun i _ => (hstep i).trans (map_zpow₀ _ _ _).symm

section Setup

variable [CharZero K] {ζ : K} (hζ : IsPrimitiveRoot ζ p)

/-- **The Kummer setup attached to the family.** -/
noncomputable def setup : Kummer.Setup K P.ext (Fin s) p :=
  Kummer.setupOfIndep ζ hζ P.rad P.rad_ne_zero P.indep

include hζ in
/-- **The extension generated by the `p`-th roots of the radicands has degree `p ^ s`.** -/
theorem finrank_ext : Module.finrank K P.ext = p ^ s := by
  rw [(P.setup hζ).finrank_eq, Fintype.card_fin]

include hζ in
/-- The extension generated by the `p`-th roots of the radicands is Galois. -/
theorem isGalois_ext : IsGalois K P.ext := (P.setup hζ).isGalois

end Setup

end PowBasis

end Field

end InverseGalois.CFT
