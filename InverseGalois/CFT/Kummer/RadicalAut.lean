import Mathlib
import InverseGalois.CFT.Kummer.Pairing

/-!
# The automorphisms of an extension generated by radicals of prime exponent

Let a field containing a primitive `p`-th root of unity be extended by a set of elements whose
`p`-th powers lie in it.  An automorphism of the extension over the base multiplies each of those
elements by a `p`-th root of unity, and that root of unity, lying in the base, is fixed by every
automorphism.  Two automorphisms therefore have the same effect on a generator in either order,
and the `p`-th iterate of an automorphism multiplies a generator by the `p`-th power of a root of
unity, that is, leaves it alone.

Since the generators generate, an automorphism is determined by its effect on them.  So **the
automorphisms of such an extension commute and are killed by `p`**: the group is elementary
abelian.  In particular every subgroup is normal, and an automorphism other than the identity has
order exactly `p` when `p` is prime — which is what a Chebotarev argument prescribing a
decomposition group of prime order asks for.

## Main results

* `InverseGalois.CFT.pow_radicalRatio_eq_one`: the ratio by which an automorphism multiplies a
  radical is a `p`-th root of unity.
* `InverseGalois.CFT.map_radicalRatio_eq_self`: that ratio is fixed by every automorphism.
* `InverseGalois.CFT.mul_comm_of_adjoin_radical`: **the automorphisms of an extension generated by
  radicals of exponent `p` commute.**
* `InverseGalois.CFT.pow_eq_one_of_adjoin_radical`: **they are killed by `p`.**
* `InverseGalois.CFT.orderOf_eq_of_adjoin_radical`: an automorphism other than the identity has
  order `p`, for `p` prime.
* `InverseGalois.CFT.normal_zpowers_of_adjoin_radical`: the subgroup it generates is normal.

## Tags

Kummer theory, radical extension, elementary abelian, root of unity, automorphism
-/

namespace InverseGalois.CFT

/-! ### The ratio by which an automorphism moves a radical -/

section Ratio

variable {Ω N : Type*} [Field Ω] [Field N] [Algebra Ω N] {p : ℕ} [NeZero p] {ζ : Ω} {r : N}

omit [NeZero p] in
/-- **The ratio by which an automorphism multiplies a radical is a `p`-th root of unity**: the
`p`-th power of the radical lies in the base, so it is fixed. -/
theorem pow_radicalRatio_eq_one (σ : N ≃ₐ[Ω] N) (hr : r ≠ 0)
    (h : ∃ a : Ω, r ^ p = algebraMap Ω N a) : (σ r / r) ^ p = 1 := by
  obtain ⟨a, ha⟩ := h
  rw [div_pow, ← map_pow, ha, AlgEquiv.commutes, ← ha, div_self (pow_ne_zero p hr)]

/-- **The ratio by which an automorphism multiplies a radical is fixed by every automorphism**,
being a `p`-th root of unity in an extension of a field containing a primitive one. -/
theorem map_radicalRatio_eq_self (hζ : IsPrimitiveRoot ζ p) (σ τ : N ≃ₐ[Ω] N) (hr : r ≠ 0)
    (h : ∃ a : Ω, r ^ p = algebraMap Ω N a) : τ (σ r / r) = σ r / r :=
  map_eq_self_of_pow_eq_one hζ τ (pow_radicalRatio_eq_one σ hr h)

/-- Two automorphisms have the same effect on a radical in either order. -/
theorem radicalAut_apply_comm (hζ : IsPrimitiveRoot ζ p) (σ τ : N ≃ₐ[Ω] N)
    (h : ∃ a : Ω, r ^ p = algebraMap Ω N a) : σ (τ r) = τ (σ r) := by
  rcases eq_or_ne r 0 with rfl | hr
  · simp only [map_zero]
  · have hσ : σ r = (σ r / r) * r := (div_mul_cancel₀ _ hr).symm
    have hτ : τ r = (τ r / r) * r := (div_mul_cancel₀ _ hr).symm
    calc σ (τ r) = (τ r / r) * σ r := by
          conv_lhs => rw [hτ]
          rw [map_mul, map_radicalRatio_eq_self hζ τ σ hr h]
      _ = (τ r / r) * ((σ r / r) * r) := by rw [← hσ]
      _ = (σ r / r) * ((τ r / r) * r) := by ring
      _ = (σ r / r) * τ r := by rw [← hτ]
      _ = τ (σ r) := by
          conv_rhs => rw [hσ]
          rw [map_mul, map_radicalRatio_eq_self hζ σ τ hr h]

/-- The `n`-th iterate of an automorphism multiplies a radical by the `n`-th power of the ratio. -/
theorem radicalAut_pow_apply (hζ : IsPrimitiveRoot ζ p) (σ : N ≃ₐ[Ω] N) (hr : r ≠ 0)
    (h : ∃ a : Ω, r ^ p = algebraMap Ω N a) (n : ℕ) : (σ ^ n) r = (σ r / r) ^ n * r := by
  induction n with
  | zero => rw [pow_zero, pow_zero, one_mul, AlgEquiv.one_apply]
  | succ n ih =>
      rw [pow_succ' σ n, AlgEquiv.mul_apply, ih, map_mul, map_pow,
        map_radicalRatio_eq_self hζ σ σ hr h, pow_succ, mul_assoc]
      exact congrArg (fun x => (σ r / r) ^ n * x) (div_mul_cancel₀ _ hr).symm

/-- The `p`-th iterate of an automorphism fixes a radical. -/
theorem radicalAut_pow_apply_eq_self (hζ : IsPrimitiveRoot ζ p) (σ : N ≃ₐ[Ω] N)
    (h : ∃ a : Ω, r ^ p = algebraMap Ω N a) : (σ ^ p) r = r := by
  rcases eq_or_ne r 0 with rfl | hr
  · rw [map_zero]
  · rw [radicalAut_pow_apply hζ σ hr h, pow_radicalRatio_eq_one σ hr h, one_mul]

end Ratio

/-! ### Extensions generated by radicals -/

section Adjoin

variable {Ω N : Type*} [Field Ω] [Field N] [Algebra Ω N] [Algebra.IsAlgebraic Ω N] {p : ℕ}
  [NeZero p] {ζ : Ω} {R : Set N}

/-- A set of algebraic elements generating an extension as an intermediate field generates it as an
algebra. -/
theorem algebraAdjoin_eq_top_of_adjoin_eq_top (htop : IntermediateField.adjoin Ω R = ⊤) :
    Algebra.adjoin Ω R = ⊤ := by
  rw [← IntermediateField.adjoin_toSubalgebra_of_isAlgebraic
      (F := Ω) (S := R) fun x _ => Algebra.IsAlgebraic.isAlgebraic x,
    htop, IntermediateField.top_toSubalgebra]

/-- Two automorphisms of an extension generated by a set agreeing on that set are equal. -/
theorem aut_eq_of_eqOn (htop : IntermediateField.adjoin Ω R = ⊤) {σ τ : N ≃ₐ[Ω] N}
    (h : ∀ r ∈ R, σ r = τ r) : σ = τ := by
  have hcoe : ((σ : N →ₐ[Ω] N)) = ((τ : N →ₐ[Ω] N)) :=
    AlgHom.ext_of_adjoin_eq_top (algebraAdjoin_eq_top_of_adjoin_eq_top htop) fun r hr => h r hr
  exact AlgEquiv.ext fun x => AlgHom.congr_fun hcoe x

variable (hζ : IsPrimitiveRoot ζ p)
  (hR : ∀ r ∈ R, ∃ a : Ω, r ^ p = algebraMap Ω N a)
  (htop : IntermediateField.adjoin Ω R = ⊤)

include hζ hR htop

/-- **The automorphisms of an extension generated by radicals of exponent `p` commute.** -/
theorem mul_comm_of_adjoin_radical (σ τ : N ≃ₐ[Ω] N) : σ * τ = τ * σ :=
  aut_eq_of_eqOn htop fun r hr => by
    rw [AlgEquiv.mul_apply, AlgEquiv.mul_apply]
    exact radicalAut_apply_comm hζ σ τ (hR r hr)

/-- **The automorphisms of an extension generated by radicals of exponent `p` are killed by
`p`.** -/
theorem pow_eq_one_of_adjoin_radical (σ : N ≃ₐ[Ω] N) : σ ^ p = 1 :=
  aut_eq_of_eqOn htop fun r hr => by
    rw [AlgEquiv.one_apply]
    exact radicalAut_pow_apply_eq_self hζ σ (hR r hr)

/-- **An automorphism other than the identity of an extension generated by radicals of prime
exponent has order that prime.** -/
theorem orderOf_eq_of_adjoin_radical (hp : p.Prime) {σ : N ≃ₐ[Ω] N} (hσ : σ ≠ 1) :
    orderOf σ = p := by
  have hdvd : orderOf σ ∣ p := orderOf_dvd_of_pow_eq_one (pow_eq_one_of_adjoin_radical hζ hR htop σ)
  rcases (Nat.Prime.eq_one_or_self_of_dvd hp _ hdvd) with h | h
  · exact absurd (orderOf_eq_one_iff.mp h) hσ
  · exact h

/-- **The subgroup generated by an automorphism of an extension generated by radicals of exponent
`p` is normal**, the automorphisms commuting. -/
theorem normal_zpowers_of_adjoin_radical (σ : N ≃ₐ[Ω] N) : (Subgroup.zpowers σ).Normal := by
  refine ⟨fun τ hτ g => ?_⟩
  have hcomm : g * τ = τ * g := mul_comm_of_adjoin_radical hζ hR htop g τ
  rw [hcomm, mul_assoc, mul_inv_cancel, mul_one]
  exact hτ

end Adjoin

end InverseGalois.CFT
