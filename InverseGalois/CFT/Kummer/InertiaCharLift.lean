/-!
# Every character of inertia away from the exponent is a Kummer character

Let `Ω` be an algebraically closed Galois extension of a number field `K` containing a primitive
`n`-th root of unity of `K`, and let `P` be a nonzero prime of the integers of `Ω` away from `n`.
A character of the inertia subgroup at `P` which is trivial on an open subgroup is the Kummer
character of a unit of `K`, and the unit can be taken to be a power of one uniformizer at the place
below `P`.

Two facts meet.  On the group side, inertia at a prime away from the exponent is generated by a
single element modulo an open subgroup and modulo raising to a power prime to the exponent: at a
finite Galois level over the rationals the tame character is a character into a cyclic group and
its kernel is a group of prime-to-`n` order.  On the arithmetic side, a uniformizer at the place
below `P` has a Kummer character which is already onto the residues on inertia: if some prime
factor `q` of `n` divided all of its values, the `n / q`-th power of the chosen root would be fixed
by the whole inertia subgroup while its `q`-th power is the uniformizer, which contradicts the
fact that a radical whose radicand has order at the place below prime to the exponent is moved by
inertia.

The group-side fact is what makes the characters of inertia lie on a line: two of them, each trivial
on an open subgroup, are proportional as soon as one takes a value which is a unit.

Together they name the character: the value of the uniformizer at the distinguished element is a
unit of the residues, so the prescribed value there is a multiple of it, and the corresponding
power of the uniformizer carries the whole character, both sides being determined by the value at
the distinguished element.

## Main results

* `InverseGalois.CFT.kummerChar_units_pow` — the Kummer character of a power of a unit.
* `InverseGalois.CFT.exists_isOpen_forall_kummerChar_eq_zero` — the Kummer character of a unit
  vanishes on an open subgroup.
* `InverseGalois.CFT.exists_mem_inertia_not_dvd_kummerChar` — **a prime factor of the exponent which
  does not divide the order of a radicand does not divide its Kummer character everywhere on
  inertia.**
* `InverseGalois.CFT.exists_forall_zmodChar_eq_mul` — **two characters of inertia at a prime away
  from the exponent, each trivial on an open subgroup, are proportional as soon as one of them takes
  a value which is a unit.**
* `InverseGalois.CFT.hasKummerCharInertiaLift` — **every character of the inertia subgroup at a
  prime away from the exponent is the Kummer character of a unit of the base field.**

## Tags

number field, Kummer theory, inertia subgroup, character, uniformizer, tame character
-/

namespace InverseGalois.CFT

open IsDedekindDomain MulAction NumberField Rigidity.RET

open scoped Pointwise

/-! ### Characters with values in the residues -/

section AddChar

variable {G : Type*} [Group G] {n : ℕ} {χ : G → ZMod n}

/-- An additive character of a group vanishes at the identity. -/
theorem zmodChar_one_eq_zero (hχ : ∀ x y : G, χ (x * y) = χ x + χ y) : χ 1 = 0 := by
  have h1 := hχ 1 1
  rw [mul_one] at h1
  exact left_eq_add.mp h1

/-- An additive character of a group multiplies by the exponent at a power. -/
theorem zmodChar_pow (hχ : ∀ x y : G, χ (x * y) = χ x + χ y) (x : G) (m : ℕ) :
    χ (x ^ m) = m • χ x := by
  induction m with
  | zero => rw [pow_zero, zero_smul, zmodChar_one_eq_zero hχ]
  | succ m ih => rw [pow_succ, hχ, ih, succ_nsmul]

/-- An additive character of a group negates at an inverse. -/
theorem zmodChar_inv (hχ : ∀ x y : G, χ (x * y) = χ x + χ y) (x : G) : χ x⁻¹ = -χ x := by
  have h1 := hχ x x⁻¹
  rw [mul_inv_cancel, zmodChar_one_eq_zero hχ] at h1
  linear_combination -h1

/-- An additive character of a group multiplies by the exponent at an integer power. -/
theorem zmodChar_zpow (hχ : ∀ x y : G, χ (x * y) = χ x + χ y) (x : G) (i : ℤ) :
    χ (x ^ i) = i • χ x := by
  induction i using Int.induction_on with
  | zero => rw [zpow_zero, zero_smul, zmodChar_one_eq_zero hχ]
  | succ m ih => rw [zpow_add_one, hχ, ih, add_smul, one_smul]
  | pred m ih => rw [zpow_sub_one, hχ, zmodChar_inv hχ, ih, sub_smul, one_smul, ← sub_eq_add_neg]

end AddChar

/-! ### Powers of a unit and smoothness -/

section Char

variable {K : Type} {Ω : Type*} [Field K] [Field Ω] [Algebra K Ω] [IsGalois K Ω] {n : ℕ}
  [NeZero n] {ζ : K} {hζ : IsPrimitiveRoot ζ n}

attribute [local instance] zmodTrivialAction

variable (h : IsKummerData K Ω (Multiplicative (ZMod n)) (zmodRootHom hζ) n)

/-- The Kummer character of a power of a unit is the multiple of its Kummer character. -/
theorem kummerChar_units_pow (a : Kˣ) (m : ℕ) (g : Gal(Ω/K)) :
    kummerChar h (a ^ m) g = m • kummerChar h a g := by
  induction m with
  | zero => rw [pow_zero, zero_smul, kummerChar_one_units]
  | succ m ih => rw [pow_succ, kummerChar_mul_units, ih, succ_nsmul]

/-- The Kummer character of a unit vanishes on an open subgroup, the Kummer cochain being constant
on the cosets of one. -/
theorem exists_isOpen_forall_kummerChar_eq_zero (a : Kˣ) :
    ∃ N : Subgroup Gal(Ω/K), IsOpen (N : Set Gal(Ω/K)) ∧ ∀ g ∈ N, kummerChar h a g = 0 := by
  obtain ⟨N, hN, hNc⟩ := h.cochain_isSmooth₁ a
  refine ⟨N, hN.isOpen, fun g hg => ?_⟩
  have hc := hNc 1 g hg
  rw [one_mul] at hc
  rw [kummerChar_apply, hc, ← kummerChar_apply]
  exact kummerChar_one h a

end Char

/-! ### A uniformizer is seen by inertia -/

section Ramified

variable {K Ω : Type} [Field K] [NumberField K] [Field Ω] [Algebra K Ω] [IsGalois K Ω] {n : ℕ}
  [NeZero n] {ζ : K} {hζ : IsPrimitiveRoot ζ n}

attribute [local instance] zmodTrivialAction

variable (h : IsKummerData K Ω (Multiplicative (ZMod n)) (zmodRootHom hζ) n)

/-- **A prime factor of the exponent which does not divide the order of a radicand does not divide
its Kummer character everywhere on the inertia subgroup.**  Were it to, the corresponding power of
the chosen root would be fixed by the whole inertia subgroup, while its own power by that prime is
the radicand, which inertia moves because the prime does not divide the order of the radicand at the
place below. -/
theorem exists_mem_inertia_not_dvd_kummerChar {q : ℕ} (hq : q.Prime) (hqn : q ∣ n) (a : Kˣ)
    {P : Ideal (𝓞 Ω)} [P.IsPrime] {v : HeightOneSpectrum (𝓞 K)}
    (hv : v.asIdeal = Ideal.under (𝓞 K) P) (hord : ¬ (q : ℤ) ∣ ord K v (a : K)) :
    ∃ σ ∈ Ideal.inertia Gal(Ω/K) P, ¬ (q : ZMod n) ∣ kummerChar h a σ := by
  by_contra hcon
  push_neg at hcon
  have hdq : n / q * q = n := Nat.div_mul_cancel hqn
  have hζ' : IsPrimitiveRoot (ζ ^ (n / q)) q :=
    IsPrimitiveRoot.pow (Nat.pos_of_ne_zero (NeZero.ne n)) hζ hdq.symm
  have hRn : ((kummerRootUnit Ω hζ : Ωˣ) : Ω) ^ n = 1 := by
    rw [← Units.val_pow_eq_pow_val, kummerRootUnit_pow_eq_one, Units.val_one]
  have hbq : algebraMap K Ω (a : K) = (((h.root a : Ωˣ) : Ω) ^ (n / q)) ^ q := by
    rw [← pow_mul, hdq, coe_root_pow h a]
  have hfix : ∀ σ : Gal(Ω/K), σ ∈ Ideal.inertia Gal(Ω/K) P →
      σ (((h.root a : Ωˣ) : Ω) ^ (n / q)) = ((h.root a : Ωˣ) : Ω) ^ (n / q) := by
    intro σ hσ
    obtain ⟨w, hw⟩ := hcon σ hσ
    have hdvd : n ∣ (kummerChar h a σ).val * (n / q) := by
      refine (ZMod.natCast_eq_zero_iff _ _).mp ?_
      rw [Nat.cast_mul, ZMod.natCast_zmod_val, hw]
      have hqd : (q : ZMod n) * ((n / q : ℕ) : ZMod n) = 0 := by
        rw [← Nat.cast_mul, mul_comm q (n / q), hdq, ZMod.natCast_self]
      calc (q : ZMod n) * w * ((n / q : ℕ) : ZMod n)
          = (q : ZMod n) * ((n / q : ℕ) : ZMod n) * w := by ring
        _ = 0 := by rw [hqd, zero_mul]
    have hR : σ ((h.root a : Ωˣ) : Ω)
        = ((kummerRootUnit Ω hζ : Ωˣ) : Ω) ^ (kummerChar h a σ).val * ((h.root a : Ωˣ) : Ω) := by
      have hs := congrArg Units.val (smul_root_eq_kummerRootUnit_pow h a σ)
      rw [Units.val_mul, Units.val_pow_eq_pow_val] at hs
      exact hs
    obtain ⟨e, he⟩ := hdvd
    rw [map_pow, hR, mul_pow, ← pow_mul, he, pow_mul, hRn, one_pow, one_mul]
  obtain ⟨σ, hσI, hσb⟩ := exists_mem_inertia_smul_ne_of_not_dvd_ord' hq hζ' a.ne_zero hbq hv hord
  exact hσb (hfix σ hσI)

end Ramified

/-! ### The characters of inertia lie on a line -/

section Line

variable {K Ω : Type*} [Field K] [NumberField K] [Field Ω] [Algebra K Ω] [IsGalois K Ω]
  [IsAlgClosed Ω]

/-- **Two characters of the inertia subgroup at a prime away from the exponent, each trivial on an
open subgroup, are proportional as soon as one of them takes a value which is a unit.**

Inertia at a prime away from the exponent is generated by a single element modulo the intersection
of the two open subgroups and modulo raising to a power prime to the exponent, so each character is
the multiple of its own value at that element by one and the same multiplier.  A unit value of the
second character therefore forces its value at the distinguished element to be a unit, and the
quotient of the two values there is the factor of proportionality. -/
theorem exists_forall_zmodChar_eq_mul {n : ℕ} {P : Ideal (𝓞 Ω)} [P.IsPrime] (hP : P ≠ ⊥)
    (hn : (n : 𝓞 Ω) ∉ P) {χ ψ : ↥(Ideal.inertia Gal(Ω/K) P) → ZMod n}
    (hχ : ∀ x y : ↥(Ideal.inertia Gal(Ω/K) P), χ (x * y) = χ x + χ y)
    (hψ : ∀ x y : ↥(Ideal.inertia Gal(Ω/K) P), ψ (x * y) = ψ x + ψ y)
    (hχsm : ∃ N : Subgroup Gal(Ω/K), IsOpen (N : Set Gal(Ω/K)) ∧
      ∀ x : ↥(Ideal.inertia Gal(Ω/K) P), (x : Gal(Ω/K)) ∈ N → χ x = 0)
    (hψsm : ∃ N : Subgroup Gal(Ω/K), IsOpen (N : Set Gal(Ω/K)) ∧
      ∀ x : ↥(Ideal.inertia Gal(Ω/K) P), (x : Gal(Ω/K)) ∈ N → ψ x = 0)
    {x₁ : ↥(Ideal.inertia Gal(Ω/K) P)} (hx₁ : IsUnit (ψ x₁)) :
    ∃ c : ZMod n, ∀ x : ↥(Ideal.inertia Gal(Ω/K) P), χ x = c * ψ x := by
  classical
  obtain ⟨N, hNopen, hNχ⟩ := hχsm
  obtain ⟨N', hN'open, hN'ψ⟩ := hψsm
  have hinter : IsOpen ((N ⊓ N' : Subgroup Gal(Ω/K)) : Set Gal(Ω/K)) := by
    rw [Subgroup.coe_inf]
    exact hNopen.inter hN'open
  obtain ⟨g, m, hmn, hg⟩ := exists_mem_inertia_forall_pow_mem (n := n) P hP hn hinter
  have hmunit : IsUnit ((m : ℕ) : ZMod n) := (ZMod.isUnit_iff_coprime m n).2 hmn
  have key : ∀ x : ↥(Ideal.inertia Gal(Ω/K) P), ∃ j : ℕ, χ x = j • χ g ∧ ψ x = j • ψ g := by
    intro x
    obtain ⟨j, hj⟩ := hg x
    have hjN := (Subgroup.mem_inf.mp hj).1
    have hjN' := (Subgroup.mem_inf.mp hj).2
    have hxfac : x = x * (g ^ j)⁻¹ * g ^ j := by group
    refine ⟨j, ?_, ?_⟩
    · have h0 : χ ((x * (g ^ j)⁻¹) ^ m) = 0 := hNχ _ hjN
      rw [zmodChar_pow hχ, nsmul_eq_mul] at h0
      have hz : χ (x * (g ^ j)⁻¹) = 0 := hmunit.mul_right_eq_zero.mp h0
      rw [hxfac, hχ, hz, zero_add, zmodChar_pow hχ]
    · have h0 : ψ ((x * (g ^ j)⁻¹) ^ m) = 0 := hN'ψ _ hjN'
      rw [zmodChar_pow hψ, nsmul_eq_mul] at h0
      have hz : ψ (x * (g ^ j)⁻¹) = 0 := hmunit.mul_right_eq_zero.mp h0
      rw [hxfac, hψ, hz, zero_add, zmodChar_pow hψ]
  have hgunit : IsUnit (ψ g) := by
    obtain ⟨j, -, hj⟩ := key x₁
    rw [hj, nsmul_eq_mul] at hx₁
    exact isUnit_of_mul_isUnit_right hx₁
  obtain ⟨u, hu⟩ := hgunit
  have huinv : ((u⁻¹ : (ZMod n)ˣ) : ZMod n) * ψ g = 1 := by
    rw [← hu, ← Units.val_mul, inv_mul_cancel, Units.val_one]
  refine ⟨χ g * ((u⁻¹ : (ZMod n)ˣ) : ZMod n), fun x => ?_⟩
  obtain ⟨j, hjχ, hjψ⟩ := key x
  rw [hjχ, hjψ, nsmul_eq_mul, nsmul_eq_mul]
  linear_combination (-((j : ZMod n) * χ g)) * huinv

end Line

/-! ### The lift -/

section Lift

variable {K Ω : Type} [Field K] [NumberField K] [Field Ω] [Algebra K Ω] [IsGalois K Ω]
  [IsAlgClosed Ω] {n : ℕ} [NeZero n] {ζ : K} {hζ : IsPrimitiveRoot ζ n}

attribute [local instance] zmodTrivialAction

variable (h : IsKummerData K Ω (Multiplicative (ZMod n)) (zmodRootHom hζ) n)

/-- **Every character of the inertia subgroup at a prime away from the exponent is the Kummer
character of a unit of the base field.**

A uniformizer at the place below the prime is chosen first, and the open subgroup on which its own
Kummer character vanishes is intersected with the one on which the prescribed character vanishes.
Inertia is generated by one element modulo that intersection and modulo a power prime to the
exponent, so both characters are determined by their values at that element, with the same
multiplier.  The value of the uniformizer there is a unit of the residues, because no prime factor
of the exponent divides its character everywhere on inertia, and the matching power of the
uniformizer therefore carries the prescribed character. -/
theorem hasKummerCharInertiaLift : HasKummerCharInertiaLift h := by
  intro P hPp hPbot hnP χ hχ hsm
  haveI := hPp
  obtain ⟨N, hNopen, hNχ⟩ := hsm
  obtain ⟨v, hv⟩ : ∃ v : HeightOneSpectrum (𝓞 K), v.asIdeal = Ideal.under (𝓞 K) P := by
    haveI : (Ideal.under (𝓞 K) P).IsPrime := Ideal.IsPrime.under _ P
    exact ⟨⟨Ideal.under (𝓞 K) P, inferInstance, Ideal.under_ne_bot (𝓞 K) hPbot⟩, rfl⟩
  obtain ⟨a, haord⟩ : ∃ a : Kˣ, ord K v (a : K) = 1 := by
    obtain ⟨t, ht⟩ : ∃ t : K, ord K v t = 1 := exists_ord_eq_one
    exact ⟨Units.mk0 t (ne_zero_of_ord_eq_one ht), ht⟩
  obtain ⟨N', hN'open, hN'⟩ := exists_isOpen_forall_kummerChar_eq_zero h a
  have hinter : IsOpen ((N ⊓ N' : Subgroup Gal(Ω/K)) : Set Gal(Ω/K)) := by
    rw [Subgroup.coe_inf]
    exact hNopen.inter hN'open
  obtain ⟨g, m, hmn, hg⟩ := exists_mem_inertia_forall_pow_mem (n := n) P hPbot hnP hinter
  have hmunit : IsUnit ((m : ℕ) : ZMod n) := (ZMod.isUnit_iff_coprime m n).2 hmn
  have key : ∀ x : ↥(Ideal.inertia Gal(Ω/K) P), ∃ j : ℕ, χ x = j • χ g ∧
      kummerChar h a (x : Gal(Ω/K)) = j • kummerChar h a (g : Gal(Ω/K)) := by
    intro x
    obtain ⟨j, hj⟩ := hg x
    have hjN := (Subgroup.mem_inf.mp hj).1
    have hjN' := (Subgroup.mem_inf.mp hj).2
    have hxfac : x = x * (g ^ j)⁻¹ * g ^ j := by group
    refine ⟨j, ?_, ?_⟩
    · have h0 : χ ((x * (g ^ j)⁻¹) ^ m) = 0 := hNχ _ hjN
      rw [zmodChar_pow hχ, nsmul_eq_mul] at h0
      have hz : χ (x * (g ^ j)⁻¹) = 0 := hmunit.mul_right_eq_zero.mp h0
      rw [hxfac, hχ, hz, zero_add, zmodChar_pow hχ]
    · have h0 := hN' _ hjN'
      rw [Subgroup.coe_pow, kummerChar_pow, nsmul_eq_mul] at h0
      have hz : kummerChar h a ((x * (g ^ j)⁻¹ : ↥(Ideal.inertia Gal(Ω/K) P)) : Gal(Ω/K)) = 0 :=
        hmunit.mul_right_eq_zero.mp h0
      rw [hxfac, Subgroup.coe_mul, kummerChar_mul, hz, zero_add, Subgroup.coe_pow, kummerChar_pow]
  have hunit : IsUnit (kummerChar h a (g : Gal(Ω/K))) := by
    have hcast : (((kummerChar h a (g : Gal(Ω/K))).val : ℕ) : ZMod n)
        = kummerChar h a (g : Gal(Ω/K)) := ZMod.natCast_zmod_val _
    rw [← hcast, ZMod.isUnit_iff_coprime]
    by_contra hnc
    rw [Nat.coprime_iff_gcd_eq_one] at hnc
    obtain ⟨q, hq, hqd⟩ := Nat.exists_prime_and_dvd hnc
    have hq1 : q ∣ (kummerChar h a (g : Gal(Ω/K))).val := hqd.trans (Nat.gcd_dvd_left _ _)
    have hq2 : q ∣ n := hqd.trans (Nat.gcd_dvd_right _ _)
    have hdvdg : (q : ZMod n) ∣ kummerChar h a (g : Gal(Ω/K)) := by
      obtain ⟨c, hc⟩ := hq1
      exact ⟨(c : ZMod n), by rw [← Nat.cast_mul, ← hc, hcast]⟩
    have hordq : ¬ (q : ℤ) ∣ ord K v (a : K) := by
      rw [haord]
      intro hdvd
      exact hq.one_lt.ne' (Nat.dvd_one.1 (by exact_mod_cast hdvd))
    obtain ⟨σ, hσI, hσ⟩ := exists_mem_inertia_not_dvd_kummerChar h hq hq2 a hv hordq
    refine hσ ?_
    obtain ⟨j, -, hjψ⟩ := key ⟨σ, hσI⟩
    have hjψ' : kummerChar h a σ = (j : ZMod n) * kummerChar h a (g : Gal(Ω/K)) := by
      rw [← nsmul_eq_mul]
      exact hjψ
    rw [hjψ']
    exact hdvdg.mul_left _
  obtain ⟨s, hs⟩ : ∃ s : ZMod n, s * kummerChar h a (g : Gal(Ω/K)) = χ g := by
    obtain ⟨u, hu⟩ := hunit
    refine ⟨χ g * ((u⁻¹ : (ZMod n)ˣ) : ZMod n), ?_⟩
    rw [← hu, mul_assoc, ← Units.val_mul, inv_mul_cancel, Units.val_one, mul_one]
  refine ⟨a ^ s.val, fun x => ?_⟩
  obtain ⟨j, hjχ, hjψ⟩ := key x
  rw [kummerChar_units_pow, hjψ, hjχ]
  simp only [nsmul_eq_mul]
  rw [ZMod.natCast_zmod_val, ← hs]
  ring

/-- **A character of a decomposition subgroup, or of the inertia subgroup at a prime away from the
exponent, is named by a unit of the base field together with all the powers of its class in the
completion at the place below**: a unit whose class is a power of the class of the named one carries
the corresponding multiple of the character.

The named unit is one carrying the character, so a power of its class is the class of the same power
of it, and the Kummer character of a power of a unit is the multiple of its Kummer character. -/
theorem exists_localClass_forall_kummerChar_nsmul (hlift : HasKummerCharInertiaLift h)
    {P : Ideal (𝓞 Ω)} [P.IsPrime] (hP : P ≠ ⊥) {v : HeightOneSpectrum (𝓞 K)}
    (hv : v.asIdeal = Ideal.under (𝓞 K) P) {A : Subgroup Gal(Ω/K)}
    (hA : A = stabilizer Gal(Ω/K) P ∨ (A = Ideal.inertia Gal(Ω/K) P ∧ (n : 𝓞 Ω) ∉ P))
    (χ : ↥A → ZMod n) (hχ : ∀ x y : ↥A, χ (x * y) = χ x + χ y)
    (hsm : ∃ N : Subgroup Gal(Ω/K), IsOpen (N : Set Gal(Ω/K)) ∧
      ∀ x : ↥A, (x : Gal(Ω/K)) ∈ N → χ x = 0) :
    ∃ u : Kˣ, ∀ (m : ℕ) (a : Kˣ), localClassHom v n a = localClassHom v n u ^ m →
      ∀ x : ↥A, kummerChar h a (x : Gal(Ω/K)) = m • χ x := by
  have hAle : A ≤ stabilizer Gal(Ω/K) P := by
    rcases hA with rfl | ⟨rfl, -⟩
    · exact le_rfl
    · exact Ideal.inertia_le_stabilizer P
  obtain ⟨a₀, ha₀⟩ : ∃ a : Kˣ, ∀ x : ↥A, kummerChar h a (x : Gal(Ω/K)) = χ x := by
    rcases hA with rfl | ⟨rfl, hnP⟩
    · exact exists_units_forall_kummerChar_eq_of_stabilizer h hP χ hχ hsm
    · exact hlift P hP hnP χ hχ hsm
  refine ⟨a₀, fun m a hac x => ?_⟩
  have hpow : localClassHom v n a = localClassHom v n (a₀ ^ m) := by
    rw [hac, _root_.map_pow]
  rw [kummerChar_eq_of_localClassHom_eq h hv hpow (hAle x.2), kummerChar_units_pow, ha₀]

end Lift

end InverseGalois.CFT
