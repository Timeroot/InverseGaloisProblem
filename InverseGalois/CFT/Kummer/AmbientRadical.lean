import Mathlib
import InverseGalois.CFT.Kummer.PowBasisExtend

/-!
# Radical extensions inside a fixed ambient field

The extension generated by `p`-th roots of a power basis of a subgroup of the units of a field is
built abstractly, as a splitting field.  For the arithmetic applications the extension has to sit
inside a fixed algebraic closure instead, so that it can be compared with the other fields of a
tower and its Galois group can be described by decomposition groups of places.

Nothing in the description of the Galois group depends on the abstract model.  A Kummer setup is a
system of radicals of an independent family, in an arbitrary extension of the base which they
generate, and all that is used below is the setup: the radical attached to an exponent vector, the
`p`-th power of that radical, and the automorphism prescribed by a vector of exponents of the root
of unity.  Rerunning the comparison of a character with an automorphism in that generality lets the
automorphism be produced directly inside an ambient field, once a system of radicals has been chosen
there.

## Main definitions

* `InverseGalois.CFT.setupRadOf`: the radical attached to an exponent vector in a Kummer setup.
* `InverseGalois.CFT.PowBasis.setupOfRoots`: the Kummer setup carried by a chosen system of radicals
  of a power basis inside an ambient field.

## Main results

* `InverseGalois.CFT.exists_aut_setupRadOf_iff`: **for every exponent vector there is an
  automorphism of a Kummer extension fixing exactly the radicals whose exponent vector is orthogonal
  to it modulo `p`.**
* `InverseGalois.CFT.PowBasis.exists_aut_fix_iff_of_setup`: **a character of a subgroup of the
  subgroup, trivial on the `p`-th powers it contains, is realised by an automorphism of any Kummer
  extension attached to the power basis.**
* `InverseGalois.CFT.PowBasis.exists_aut_fix_iff_ambient`: the same statement for the subfield of an
  ambient field generated by a chosen system of radicals.

## Tags

Kummer theory, radical extension, power basis, ambient field, character
-/

namespace InverseGalois.CFT

open Rigidity.RET

/-! ### The radical attached to an exponent vector in a Kummer setup -/

section SetupRadOf

variable {K L : Type*} [Field K] [Field L] [Algebra K L] {p s : ℕ}

/-- The `p`-th root, in a Kummer extension, of the element of the base described by an exponent
vector and a correction factor. -/
noncomputable def setupRadOf (S : Kummer.Setup K L (Fin s) p) (m : Fin s → ℤ) (z : Kˣ) : L :=
  (∏ i, S.w i ^ m i) * algebraMap K L (z : K)

theorem setupRadOf_eq (S : Kummer.Setup K L (Fin s) p) (m : Fin s → ℤ) (z : Kˣ) :
    setupRadOf S m z = (∏ i, S.w i ^ m i) * algebraMap K L (z : K) := rfl

variable [NeZero p]

/-- A product of powers of the radicals of a Kummer setup is nonzero. -/
theorem prod_zpow_w_ne_zero (S : Kummer.Setup K L (Fin s) p) (m : Fin s → ℤ) :
    (∏ i, S.w i ^ m i) ≠ 0 :=
  Finset.prod_ne_zero_iff.mpr fun i _ => zpow_ne_zero _ (S.w_ne_zero i)

theorem setupRadOf_ne_zero (S : Kummer.Setup K L (Fin s) p) (m : Fin s → ℤ) (z : Kˣ) :
    setupRadOf S m z ≠ 0 := by
  refine mul_ne_zero (prod_zpow_w_ne_zero S m) ?_
  simp only [ne_eq, map_eq_zero]
  exact Units.ne_zero z

omit [NeZero p] in
/-- The `p`-th power of the radical attached to an exponent vector is the corresponding product of
radicands, times the `p`-th power of the correction factor. -/
theorem setupRadOf_pow (S : Kummer.Setup K L (Fin s) p) (m : Fin s → ℤ) (z : Kˣ) :
    setupRadOf S m z ^ p = algebraMap K L ((∏ i, S.g i ^ m i) * (z : K) ^ p) := by
  have hstep : ∀ i : Fin s, (S.w i ^ m i) ^ p = algebraMap K L (S.g i) ^ m i := by
    intro i
    rw [← S.w_pow i, ← zpow_natCast (S.w i ^ m i) p, ← zpow_mul, ← zpow_natCast (S.w i) p,
      ← zpow_mul, mul_comm]
  rw [setupRadOf_eq, mul_pow, ← Finset.prod_pow, map_mul, map_prod, map_pow]
  refine congrArg (fun x => x * (algebraMap K L (z : K)) ^ p) ?_
  exact Finset.prod_congr rfl fun i _ => (hstep i).trans (map_zpow₀ _ _ _).symm

/-- An automorphism fixes the radical attached to an exponent vector exactly when the corresponding
product of the roots of unity it introduces is trivial. -/
theorem aut_setupRadOf_eq_iff (S : Kummer.Setup K L (Fin s) p) (σ : L ≃ₐ[K] L) (m : Fin s → ℤ)
    (z : Kˣ) :
    σ (setupRadOf S m z) = setupRadOf S m z ↔ ∏ i, (σ (S.w i) / S.w i) ^ m i = 1 := by
  have hz : algebraMap K L (z : K) ≠ 0 := by
    simp only [ne_eq, map_eq_zero]
    exact Units.ne_zero z
  have hdiv : ∏ i, (σ (S.w i) / S.w i) ^ m i
      = (∏ i, (σ (S.w i)) ^ m i) / (∏ i, S.w i ^ m i) := by
    rw [← Finset.prod_div_distrib]
    exact Finset.prod_congr rfl fun i _ => div_zpow _ _ _
  have hσ : σ (setupRadOf S m z)
      = (∏ i, (σ (S.w i)) ^ m i) * algebraMap K L (z : K) := by
    rw [setupRadOf_eq, map_mul, map_prod, AlgEquiv.commutes]
    exact congrArg (fun x => x * algebraMap K L (z : K))
      (Finset.prod_congr rfl fun i _ => map_zpow₀ σ _ _)
  rw [hdiv, div_eq_one_iff_eq (prod_zpow_w_ne_zero S m), hσ, setupRadOf_eq]
  exact mul_left_inj' hz

variable [CharZero K]

/-- **For every exponent vector there is an automorphism of a Kummer extension fixing exactly the
radicals whose exponent vector is orthogonal to it modulo `p`.**  The automorphism multiplying the
`i`-th radical by the `cᵢ`-th power of the root of unity multiplies the radical of an exponent
vector `m` by the power of the root of unity at `∑ cᵢ mᵢ`. -/
theorem exists_aut_setupRadOf_iff (S : Kummer.Setup K L (Fin s) p) (c : Fin s → ℤ) :
    ∃ σ : L ≃ₐ[K] L, ∀ (m : Fin s → ℤ) (z : Kˣ),
      (σ (setupRadOf S m z) = setupRadOf S m z ↔ (p : ℤ) ∣ ∑ i, c i * m i) := by
  obtain ⟨σ, hσ⟩ := S.exists_aut_zpow c
  refine ⟨σ, fun m z => ?_⟩
  rw [aut_setupRadOf_eq_iff S σ m z]
  have hstep : ∀ i, σ (S.w i) / S.w i = S.zetaL ^ c i := by
    intro i
    rw [hσ i, mul_div_assoc, div_self (S.w_ne_zero i), mul_one]
  have hmul : ∀ i, (S.zetaL ^ c i) ^ m i = S.zetaL ^ (c i * m i) := fun i => (zpow_mul _ _ _).symm
  simp only [hstep, hmul]
  rw [prod_zpow_eq_zpow_sum Finset.univ S.zetaL_ne_zero]
  exact S.zetaL_isPrimitiveRoot.zpow_eq_one_iff_dvd _

end SetupRadOf

namespace PowBasis

/-! ### A power basis inside an arbitrary Kummer extension -/

section OfSetup

variable {K L : Type*} [Field K] [Field L] [Algebra K L] {p s : ℕ} [NeZero p] {B : Subgroup Kˣ}

omit [NeZero p] in
/-- The radical attached to a presentation of an element of the subgroup is a `p`-th root of that
element. -/
theorem setupRadOf_pow_of_span (P : PowBasis B p s) (S : Kummer.Setup K L (Fin s) p)
    (hS : ∀ i, S.g i = P.rad i) {x : Kˣ} {m : Fin s → ℤ} {z : Kˣ}
    (hx : x = (∏ i, P.g i ^ m i) * z ^ p) :
    setupRadOf S m z ^ p = algebraMap K L (x : K) := by
  have hg : ∀ i, S.g i = ((P.g i : Kˣ) : K) := hS
  rw [setupRadOf_pow, hx]
  congr 1
  push_cast
  exact congrArg (fun t => t * ((z : K) ^ p)) (Finset.prod_congr rfl fun i _ => by rw [hg i])

omit [NeZero p] in
/-- **Every element of the subgroup has a `p`-th root in any Kummer extension attached to the power
basis.** -/
theorem exists_root_of_setup (P : PowBasis B p s) (S : Kummer.Setup K L (Fin s) p)
    (hS : ∀ i, S.g i = P.rad i) {b : Kˣ} (hb : b ∈ B) :
    ∃ v : L, v ^ p = algebraMap K L (b : K) := by
  obtain ⟨m, z, hm⟩ := P.span b hb
  exact ⟨setupRadOf S m z, P.setupRadOf_pow_of_span S hS hm⟩

variable [CharZero K]

/-- **A character of a subgroup of the subgroup, trivial on the `p`-th powers it contains, is
realised by an automorphism of any Kummer extension attached to the power basis.**  The character is
computed by an exponent vector, and the automorphism attached to that vector fixes a radical of an
element of the smaller subgroup exactly when the character is trivial there. -/
theorem exists_aut_fix_iff_of_setup (P : PowBasis B p s) (S : Kummer.Setup K L (Fin s) p)
    (hS : ∀ i, S.g i = P.rad i) (hp : p.Prime) (hfin : Finite (powQuotient B p))
    (hsat : ∀ y : Kˣ, y ^ p ∈ B → y ∈ B) {U : Subgroup Kˣ} (hU : U ≤ B) (Φ : ↥U →* Kˣ)
    (hΦ : ∀ (u : Kˣ) (hu : u ∈ U) (y : Kˣ), u = y ^ p → Φ ⟨u, hu⟩ = 1) :
    ∃ σ : L ≃ₐ[K] L, ∀ (u : Kˣ) (hu : u ∈ U) (v : L),
      v ^ p = algebraMap K L (u : K) → (σ v = v ↔ Φ ⟨u, hu⟩ = 1) := by
  obtain ⟨c, hc⟩ := P.exists_expVector hp S.isPrimitiveRoot hfin hsat hU Φ hΦ
  obtain ⟨σ, hσ⟩ := exists_aut_setupRadOf_iff S c
  refine ⟨σ, fun u hu v hv => ?_⟩
  obtain ⟨m, z, hm⟩ := P.span u (hU hu)
  have hvne : v ≠ 0 := by
    intro h
    rw [h, zero_pow hp.ne_zero] at hv
    exact Units.ne_zero u ((map_eq_zero _).mp hv.symm)
  have hpow : v ^ p = setupRadOf S m z ^ p := by
    rw [hv, P.setupRadOf_pow_of_span S hS hm]
  rw [aut_fix_iff_of_pow_eq S.isPrimitiveRoot σ hvne (setupRadOf_ne_zero S m z) hpow, hσ m z]
  exact (hc u hu m z hm).symm

end OfSetup

/-! ### A system of radicals inside an ambient field -/

section Ambient

variable {K A : Type*} [Field K] [Field A] [Algebra K A] {p s : ℕ} {B : Subgroup Kˣ}

/-- **The Kummer setup carried by a chosen system of radicals of a power basis inside an ambient
field.**  The radicals generate an intermediate field of the ambient extension, and the family of
radicands is independent modulo `p`-th powers by the very definition of a power basis. -/
def setupOfRoots (P : PowBasis B p s) {ζ : K} (hζ : IsPrimitiveRoot ζ p) (w : Fin s → A)
    (hw : ∀ i, w i ^ p = algebraMap K A (P.rad i)) (F : IntermediateField K A)
    (hwF : ∀ i, w i ∈ F) (hgen : IntermediateField.adjoin K (Set.range w) = F) :
    Kummer.Setup K ↥F (Fin s) p where
  zeta := ζ
  g := P.rad
  w := fun i => ⟨w i, hwF i⟩
  isPrimitiveRoot := hζ
  g_ne_zero := P.rad_ne_zero
  w_pow := fun i => Subtype.ext (hw i)
  adjoin_eq_top := by
    have himg : ((↑) '' (Set.range fun i => (⟨w i, hwF i⟩ : ↥F)) : Set A) = Set.range w := by
      ext x
      constructor
      · rintro ⟨-, ⟨i, rfl⟩, rfl⟩
        exact ⟨i, rfl⟩
      · rintro ⟨i, rfl⟩
        exact ⟨⟨w i, hwF i⟩, ⟨i, rfl⟩, rfl⟩
    refine IntermediateField.lift_injective F ?_
    rw [IntermediateField.lift_adjoin, IntermediateField.lift_top, himg, hgen]
  indep := P.indep

@[simp]
theorem setupOfRoots_g (P : PowBasis B p s) {ζ : K} (hζ : IsPrimitiveRoot ζ p) (w : Fin s → A)
    (hw : ∀ i, w i ^ p = algebraMap K A (P.rad i)) (F : IntermediateField K A)
    (hwF : ∀ i, w i ∈ F) (hgen : IntermediateField.adjoin K (Set.range w) = F) :
    (P.setupOfRoots hζ w hw F hwF hgen).g = P.rad := rfl

variable [CharZero K]

omit [CharZero K] in
/-- **Every element of the subgroup has a `p`-th root in the subfield of an ambient field generated
by a chosen system of radicals of the power basis.** -/
theorem exists_root_ambient (P : PowBasis B p s) {ζ : K} (hζ : IsPrimitiveRoot ζ p)
    (w : Fin s → A) (hw : ∀ i, w i ^ p = algebraMap K A (P.rad i)) (F : IntermediateField K A)
    (hwF : ∀ i, w i ∈ F) (hgen : IntermediateField.adjoin K (Set.range w) = F)
    {b : Kˣ} (hb : b ∈ B) : ∃ v : ↥F, v ^ p = algebraMap K ↥F (b : K) :=
  P.exists_root_of_setup (P.setupOfRoots hζ w hw F hwF hgen) (fun _ => rfl) hb

/-- **A character of a subgroup of the subgroup, trivial on the `p`-th powers it contains, is
realised by an automorphism of the subfield of an ambient field generated by a chosen system of
radicals of the power basis.** -/
theorem exists_aut_fix_iff_ambient (P : PowBasis B p s) (hp : p.Prime) {ζ : K}
    (hζ : IsPrimitiveRoot ζ p) (hfin : Finite (powQuotient B p))
    (hsat : ∀ y : Kˣ, y ^ p ∈ B → y ∈ B) (w : Fin s → A)
    (hw : ∀ i, w i ^ p = algebraMap K A (P.rad i)) (F : IntermediateField K A)
    (hwF : ∀ i, w i ∈ F) (hgen : IntermediateField.adjoin K (Set.range w) = F)
    {U : Subgroup Kˣ} (hU : U ≤ B) (Φ : ↥U →* Kˣ)
    (hΦ : ∀ (u : Kˣ) (hu : u ∈ U) (y : Kˣ), u = y ^ p → Φ ⟨u, hu⟩ = 1) :
    ∃ σ : ↥F ≃ₐ[K] ↥F, ∀ (u : Kˣ) (hu : u ∈ U) (v : ↥F),
      v ^ p = algebraMap K ↥F (u : K) → (σ v = v ↔ Φ ⟨u, hu⟩ = 1) := by
  haveI : NeZero p := ⟨hp.ne_zero⟩
  exact P.exists_aut_fix_iff_of_setup (P.setupOfRoots hζ w hw F hwF hgen) (fun _ => rfl) hp hfin
    hsat hU Φ hΦ

/-- The subfield of an ambient field generated by a chosen system of radicals of a power basis is
finite over the base. -/
theorem finiteDimensional_ambient (P : PowBasis B p s) {ζ : K} (hζ : IsPrimitiveRoot ζ p)
    (w : Fin s → A) (hw : ∀ i, w i ^ p = algebraMap K A (P.rad i)) (F : IntermediateField K A)
    (hwF : ∀ i, w i ∈ F) (hgen : IntermediateField.adjoin K (Set.range w) = F) [NeZero p] :
    FiniteDimensional K ↥F :=
  (P.setupOfRoots hζ w hw F hwF hgen).finiteDimensional

end Ambient

end PowBasis

end InverseGalois.CFT
