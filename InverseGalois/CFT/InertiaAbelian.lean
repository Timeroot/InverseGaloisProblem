import Mathlib
import InverseGalois.CFT.Decomposition
import InverseGalois.CFT.InertiaGeneration
import InverseGalois.CFT.SubgroupCounting
import InverseGalois.NumberTheory.SplitDensity

/-!
# Bounding the degree of an abelian number field by its inertia groups

The inertia subgroups of a Galois number field generate its Galois group, and a group generated by
finitely many normal subgroups is no larger than the product of their orders.  Combining the two
bounds the degree of the field by a product of ramification indices, one factor for each ramified
rational prime.

Passing from primes of the ring of integers to rational primes is where commutativity enters: the
Galois group permutes the primes above a given rational prime transitively and conjugates their
inertia subgroups accordingly, so in an abelian extension all the primes above `p` share one
inertia subgroup.  Without that, the same prime `p` would contribute one factor for each prime
above it and the bound would be useless.

## Main results

* `InverseGalois.CFT.card_le_prod_of_inertia_le`: if every inertia subgroup lies in the subgroup
  generated by a finite family of normal subgroups, the degree is at most the product of their
  orders.
* `InverseGalois.CFT.inertia_eq_of_under_eq`: in an abelian extension the inertia subgroup at a
  prime depends only on the rational prime below it.
* `InverseGalois.CFT.card_le_prod_of_inertia_card_le`: **the degree of an abelian number field is
  at most the product, over any finite set of rational primes carrying all the ramification, of a
  bound on the order of the inertia subgroup there.**
* `InverseGalois.CFT.card_inertia_eq_ramificationIdx`: the order of the inertia subgroup is the
  ramification index.
* `InverseGalois.CFT.card_le_prod_of_ramifiedSet`: the same bound, with the covering hypothesis
  supplied by the set of ramified primes.
-/

open NumberField

namespace InverseGalois.CFT

variable {K : Type*} [Field K] [NumberField K] [IsGalois ℚ K]

/-- **Absorbing every inertia subgroup bounds the degree.**  If a finite family of normal subgroups
generates a subgroup containing every inertia subgroup, then it is the whole Galois group, whose
order is therefore at most the product of the orders of the family. -/
theorem card_le_prod_of_inertia_le (S : Finset ℕ) (H : ℕ → Subgroup Gal(K/ℚ))
    (hnorm : ∀ p, (H p).Normal)
    (hH : ∀ P : Ideal (𝓞 K), P.IsMaximal → Ideal.inertia Gal(K/ℚ) P ≤ ⨆ p ∈ S, H p) :
    Nat.card Gal(K/ℚ) ≤ ∏ p ∈ S, Nat.card (H p) := by
  refine card_le_prod_of_iSup_eq_top H hnorm S (top_le_iff.mp ?_)
  rw [← iSup_inertia_eq_top (K := K)]
  exact iSup_le fun P => hH P.1 P.2

omit [IsGalois ℚ K] in
/-- **Conjugation is trivial in an abelian Galois group.** -/
private theorem conj_eq_id [IsMulCommutative Gal(K/ℚ)] (σ : Gal(K/ℚ)) :
    (MulAut.conj σ : Gal(K/ℚ) →* Gal(K/ℚ)) = MonoidHom.id Gal(K/ℚ) := by
  ext x
  simp [MulAut.conj]

/-- **In an abelian extension inertia only depends on the prime below.**  The Galois group is
transitive on the primes above a given rational prime, and conjugating an inertia subgroup by a
Galois element gives the inertia subgroup at the image prime; commutativity makes the conjugation
trivial. -/
theorem inertia_eq_of_under_eq [IsMulCommutative Gal(K/ℚ)] (P Q : Ideal (𝓞 K))
    (hP : P.IsPrime) (hQ : Q.IsPrime) (h : P.under ℤ = Q.under ℤ) :
    Ideal.inertia Gal(K/ℚ) P = Ideal.inertia Gal(K/ℚ) Q := by
  haveI := hP
  haveI := hQ
  obtain ⟨σ, rfl⟩ := Algebra.IsInvariant.exists_smul_of_under_eq ℤ (𝓞 K) Gal(K/ℚ) P Q h
  rw [inertia_smul, conj_eq_id σ, Subgroup.map_id]

/-- **The degree of an abelian number field is bounded by its ramification indices.**  Let `S` be a
finite set of rational primes such that every prime of the ring of integers either lies over a
member of `S` or is unramified, and let `c p` bound the order of the inertia subgroup at a prime
over `p`.  Then the degree of the field is at most `∏ p ∈ S, c p`. -/
theorem card_le_prod_of_inertia_card_le [IsMulCommutative Gal(K/ℚ)] (S : Finset ℕ) (c : ℕ → ℕ)
    (hc1 : ∀ p ∈ S, 1 ≤ c p)
    (hc : ∀ p ∈ S, ∀ P : Ideal (𝓞 K), P.IsPrime → P.under ℤ = Ideal.span {(p : ℤ)} →
      Nat.card (Ideal.inertia Gal(K/ℚ) P) ≤ c p)
    (hcov : ∀ P : Ideal (𝓞 K), P.IsMaximal →
      (∃ p ∈ S, P.under ℤ = Ideal.span {(p : ℤ)}) ∨ Ideal.inertia Gal(K/ℚ) P = ⊥) :
    Nat.card Gal(K/ℚ) ≤ ∏ p ∈ S, c p := by
  classical
  set Q : ℕ → Prop := fun p => ∃ P : Ideal (𝓞 K), P.IsPrime ∧ P.under ℤ = Ideal.span {(p : ℤ)}
    with hQdef
  set H : ℕ → Subgroup Gal(K/ℚ) := fun p =>
    if h : Q p then Ideal.inertia Gal(K/ℚ) h.choose else ⊥ with hHdef
  have hcard : ∀ p ∈ S, Nat.card (H p) ≤ c p := by
    intro p hp
    by_cases h : Q p
    · have hspec := h.choose_spec
      simp only [hHdef, dif_pos h]
      exact hc p hp _ hspec.1 hspec.2
    · simpa [hHdef, dif_neg h] using hc1 p hp
  refine le_trans (card_le_prod_of_inertia_le S H (fun _ => inferInstance) ?_)
    (Finset.prod_le_prod' hcard)
  intro P hPmax
  rcases hcov P hPmax with ⟨p, hpS, hpu⟩ | hbot
  · have hQp : Q p := ⟨P, hPmax.isPrime, hpu⟩
    have hspec := hQp.choose_spec
    have hHp : H p = Ideal.inertia Gal(K/ℚ) P := by
      simp only [hHdef, dif_pos hQp]
      exact inertia_eq_of_under_eq _ _ hspec.1 hPmax.isPrime (hspec.2.trans hpu.symm)
    rw [← hHp]
    exact le_trans (le_iSup (fun _ : p ∈ S => H p) hpS) (le_iSup (fun q => ⨆ _ : q ∈ S, H q) p)
  · rw [hbot]
    exact bot_le

section RamifiedSet

open InverseGalois.NumberTheory

/-- **The order of the inertia subgroup is the ramification index.** -/
theorem card_inertia_eq_ramificationIdx (P : Ideal (𝓞 K)) [P.IsPrime] (hP : P ≠ ⊥) :
    Nat.card (Ideal.inertia Gal(K/ℚ) P) =
      Ideal.ramificationIdx (algebraMap ℤ (𝓞 K)) (P.under ℤ) P := by
  haveI := isMaximal_of_ne_bot P hP
  haveI := finite_quotient_of_ne_bot P hP
  haveI := isMaximal_under_of_ne_bot P hP
  haveI := isSeparable_residue_of_ne_bot P hP
  rw [Ideal.card_inertia_eq_ramificationIdxIn (G := Gal(K/ℚ)) (P.under ℤ) (under_ne_bot P hP) P,
    Ideal.ramificationIdxIn_eq_ramificationIdx (P.under ℤ) P Gal(K/ℚ)]

omit [NumberField K] [IsGalois ℚ K] in
/-- **Every nonzero prime of the ring of integers lies over a rational prime.** -/
theorem exists_prime_under (P : Ideal (𝓞 K)) [P.IsPrime] (hP : P ≠ ⊥) :
    ∃ p : ℕ, p.Prime ∧ P.under ℤ = Ideal.span {(p : ℤ)} :=
  (Ideal.isPrime_int_iff.mp inferInstance).resolve_left (under_ne_bot P hP)

/-- **A prime with nontrivial inertia is ramified.** -/
theorem mem_ramifiedSet_of_inertia_ne_bot (P : Ideal (𝓞 K)) [P.IsPrime] (hP : P ≠ ⊥)
    (p : ℕ) (hp : p.Prime) (hpu : P.under ℤ = Ideal.span {(p : ℤ)})
    (h : Ideal.inertia Gal(K/ℚ) P ≠ ⊥) : p ∈ ramifiedSet K := by
  refine ⟨hp, P, ⟨inferInstance, ⟨hpu.symm⟩⟩, fun he => h ?_⟩
  rw [← Subgroup.card_eq_one, card_inertia_eq_ramificationIdx P hP, hpu, he]

/-- **The degree of an abelian number field is bounded by its ramification indices.**  Every prime
outside the given finite set is unramified, so it contributes nothing to the bound. -/
theorem card_le_prod_of_ramifiedSet [IsMulCommutative Gal(K/ℚ)] (S : Finset ℕ) (c : ℕ → ℕ)
    (hc1 : ∀ p ∈ S, 1 ≤ c p)
    (hc : ∀ p ∈ S, ∀ P : Ideal (𝓞 K), P.IsPrime → P.under ℤ = Ideal.span {(p : ℤ)} →
      Nat.card (Ideal.inertia Gal(K/ℚ) P) ≤ c p)
    (hram : ∀ p ∈ ramifiedSet K, p ∈ S) :
    Nat.card Gal(K/ℚ) ≤ ∏ p ∈ S, c p := by
  refine card_le_prod_of_inertia_card_le S c hc1 hc fun P hPmax => ?_
  by_cases h : Ideal.inertia Gal(K/ℚ) P = ⊥
  · exact Or.inr h
  · haveI := hPmax.isPrime
    have hP : P ≠ ⊥ :=
      Ring.ne_bot_of_isMaximal_of_not_isField hPmax (NumberField.RingOfIntegers.not_isField K)
    obtain ⟨p, hp, hpu⟩ := exists_prime_under P hP
    exact Or.inl ⟨p, hram p (mem_ramifiedSet_of_inertia_ne_bot P hP p hp hpu h), hpu⟩

end RamifiedSet

end InverseGalois.CFT
