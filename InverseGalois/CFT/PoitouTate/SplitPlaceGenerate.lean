/-!
# Finitely many completely split places detect a radical

Let `k ⊆ F ⊆ N` be number fields with both `F` and `N` normal over `k`.  A prime of the base
splitting completely in the middle field has all its decomposition groups in the top field inside
the subgroup fixing the middle field, and the converse holds for the fixed field of a normal
subgroup: a prime all of whose decomposition groups lie in the subgroup splits completely in the
fixed field.

Those two facts turn the density theorem into a generation statement.  Let `S` be a set of primes
of the base which contains every prime outside a prescribed finite set that splits completely in
the middle field and contains only primes splitting completely there, and let `H` be the subgroup
generated by the decomposition groups at the primes of the top field above `S`.  Then `H` fixes the
middle field, and were the containment strict the fixed field of `H` would be strictly larger, so
infinitely many primes would split completely in the middle field but not in that fixed field; one
of them avoids the prescribed set, hence belongs to `S`, hence has all its decomposition groups
inside `H`, hence splits completely in the fixed field after all.  The Galois group being finite,
the generating family may be cut down to the primes above finitely many primes of the base.

The point of the construction is the statement about radicals.  If the middle field contains the
`p`-th roots of unity and a radical of one of its elements lies in the top field, an automorphism
in a decomposition group fixes the radical exactly when the radicand is a `p`-th power in the
completion below.  Prescribing the radicand to be a local power at each of the finitely many chosen
primes therefore makes the whole subgroup fixing the middle field fix the radical, so the radical
lies in the middle field and the radicand is a power there.

## Main definitions

* `InverseGalois.CFT.decompositionSetAbove`: the automorphisms fixing a finite place whose place
  below belongs to a prescribed set.
* `InverseGalois.CFT.decompositionSubgroupAbove`: the subgroup generated by those decomposition
  groups.

## Main results

* `InverseGalois.CFT.stabilizer_le_fixingSubgroup_of_splitsCompletelyIn`: above a prime splitting
  completely in an intermediate field the decomposition group fixes that field.
* `InverseGalois.CFT.splitsCompletelyIn_fixedField_of_forall`: a prime all of whose decomposition
  groups lie in a normal subgroup splits completely in the fixed field of that subgroup.
* `InverseGalois.CFT.fixingSubgroup_le_decompositionSubgroupAbove`: **the decomposition groups at
  the primes above the completely split primes generate the subgroup fixing the intermediate
  field.**
* `InverseGalois.CFT.exists_finite_subset_decompositionSubgroupAbove`: finitely many primes of the
  base already carry the whole subgroup.
* `InverseGalois.CFT.exists_finite_splitsCompletelyIn_pow_of_forall_localPow`: **there are finitely
  many completely split primes of an intermediate field, avoiding any prescribed finite set of
  primes of the base, at which being a local power forces a radicand whose radical lies in the top
  field to be a power already in the intermediate field.**

## Tags

number field, place, decomposition group, completely split, Chebotarev, Kummer theory, radical
-/

set_option synthInstance.maxHeartbeats 800000

namespace InverseGalois.CFT

open IsDedekindDomain MulAction NumberField InverseGalois.NumberTheory

open scoped Pointwise

/-! ### The decomposition groups above a prescribed set of primes -/

section Above

variable (k K : Type*) [Field k] [NumberField k] [Field K] [NumberField K] [Algebra k K]
  [IsGalois k K] (S : Set (HeightOneSpectrum (𝓞 k)))

/-- **The automorphisms fixing a finite place whose place below belongs to the prescribed set.** -/
def decompositionSetAbove : Set Gal(K/k) :=
  {σ | ∃ v : HeightOneSpectrum (𝓞 K), primeUnder (𝓞 k) v ∈ S ∧ σ • v = v}

/-- **The subgroup generated by the decomposition groups at the finite places above the prescribed
set.** -/
def decompositionSubgroupAbove : Subgroup Gal(K/k) :=
  Subgroup.closure (decompositionSetAbove k K S)

variable {k K S} in
omit [NumberField k] [IsGalois k K] in
theorem mem_decompositionSetAbove {σ : Gal(K/k)} :
    σ ∈ decompositionSetAbove k K S ↔
      ∃ v : HeightOneSpectrum (𝓞 K), primeUnder (𝓞 k) v ∈ S ∧ σ • v = v :=
  Iff.rfl

omit [NumberField k] [IsGalois k K] in
/-- The places above a set are the places outside its complement. -/
theorem decompositionSetAbove_eq_outside :
    decompositionSetAbove k K S = decompositionSetOutside k K Sᶜ := by
  ext σ
  simp only [decompositionSetAbove, decompositionSetOutside, Set.mem_setOf_eq, Set.mem_compl_iff,
    not_not]

omit [NumberField k] [IsGalois k K] in
/-- The subgroup generated by the decomposition groups above a set is the one generated by the
decomposition groups outside its complement. -/
theorem decompositionSubgroupAbove_eq_outside :
    decompositionSubgroupAbove k K S = decompositionSubgroupOutside k K Sᶜ := by
  rw [decompositionSubgroupAbove, decompositionSubgroupOutside, decompositionSetAbove_eq_outside]

instance decompositionSubgroupAbove_normal : (decompositionSubgroupAbove k K S).Normal := by
  rw [decompositionSubgroupAbove_eq_outside]
  infer_instance

omit [NumberField k] [IsGalois k K] in
theorem subset_decompositionSubgroupAbove :
    decompositionSetAbove k K S ⊆ decompositionSubgroupAbove k K S :=
  Subgroup.subset_closure

omit [NumberField k] [IsGalois k K] in
/-- The decomposition group at a finite place above the prescribed set lies in the subgroup they
generate. -/
theorem stabilizer_le_decompositionSubgroupAbove {v : HeightOneSpectrum (𝓞 K)}
    (hv : primeUnder (𝓞 k) v ∈ S) :
    stabilizer Gal(K/k) v ≤ decompositionSubgroupAbove k K S :=
  fun _ hσ => subset_decompositionSubgroupAbove k K S ⟨v, hv, hσ⟩

variable {k K S} in
omit [NumberField k] [IsGalois k K] in
/-- To bound the subgroup generated by the decomposition groups it is enough to bound each of
their elements. -/
theorem decompositionSubgroupAbove_le {H : Subgroup Gal(K/k)}
    (h : ∀ σ ∈ decompositionSetAbove k K S, σ ∈ H) : decompositionSubgroupAbove k K S ≤ H :=
  (Subgroup.closure_le H).mpr fun _ hσ => h _ hσ

end Above

/-! ### Degrees of intermediate fields -/

section Degree

variable {k N : Type*} [Field k] [Field N] [Algebra k N] [FiniteDimensional k N]

/-- A strictly larger intermediate field has strictly larger degree over the base, because the
degrees over the two of them multiply to the same thing. -/
theorem finrank_lt_finrank_of_intermediateField_lt {E F : IntermediateField k N} (h : E < F) :
    Module.finrank k ↥E < Module.finrank k ↥F := by
  have h1 := Module.finrank_mul_finrank k ↥E N
  have h2 := Module.finrank_mul_finrank k ↥F N
  have h3 := IntermediateField.finrank_lt_of_gt h
  by_contra hcon
  have h5 := mul_lt_mul_of_pos_left h3 (Module.finrank_pos (R := k) (M := ↥E))
  have h6 : Module.finrank k ↥F * Module.finrank ↥F N
      < Module.finrank k ↥E * Module.finrank ↥E N :=
    lt_of_le_of_lt (mul_le_mul_left (not_lt.mp hcon) _) h5
  rw [h1, h2] at h6
  exact lt_irrefl _ h6

end Degree

/-! ### Splitting completely and the decomposition groups -/

section Detect

variable {k N : Type*} [Field k] [NumberField k] [Field N] [NumberField N] [Algebra k N]
  [IsGalois k N]

omit [NumberField k] [IsGalois k N] in
/-- A finite place lies above the place of the base it restricts to. -/
theorem liesOver_of_primeUnder_eq {P : HeightOneSpectrum (𝓞 N)} {v : HeightOneSpectrum (𝓞 k)}
    (hP : primeUnder (𝓞 k) P = v) : P.asIdeal.LiesOver v.asIdeal :=
  ⟨by rw [← hP]; rfl⟩

omit [IsGalois k N] in
/-- **Above a prime of the base splitting completely in an intermediate field the decomposition
group fixes that field.**  Restriction sends the decomposition group of the top field into the
decomposition group of the intermediate one, which is trivial because the prime splits completely
there, so every element of it restricts to the identity. -/
theorem stabilizer_le_fixingSubgroup_of_splitsCompletelyIn (E : IntermediateField k N)
    [NumberField ↥E] [IsGalois k ↥E] {v : HeightOneSpectrum (𝓞 k)}
    (hv : SplitsCompletelyIn k ↥E v) {P : HeightOneSpectrum (𝓞 N)}
    (hP : primeUnder (𝓞 k) P = v) : stabilizer Gal(N/k) P ≤ E.fixingSubgroup := by
  haveI : P.asIdeal.IsPrime := P.isPrime
  haveI : P.asIdeal.LiesOver v.asIdeal := liesOver_of_primeUnder_eq hP
  haveI : (P.asIdeal.under (𝓞 ↥E)).LiesOver v.asIdeal :=
    ⟨by rw [Ideal.under_under]
        exact Ideal.LiesOver.over (A := 𝓞 k) (P := P.asIdeal) (p := v.asIdeal)⟩
  have hbot : stabilizer Gal(↥E/k) (P.asIdeal.under (𝓞 ↥E)) = ⊥ :=
    relStabilizer_eq_bot_of_splitsCompletelyIn hv (P.asIdeal.under (𝓞 ↥E))
  rw [stabilizer_eq_stabilizer_asIdeal]
  intro τ hτ
  have hmem := relRestrictNormal_mem_stabilizer E P.asIdeal hτ
  rw [hbot, Subgroup.mem_bot] at hmem
  rw [IntermediateField.mem_fixingSubgroup_iff]
  intro x hx
  have hcom := AlgEquiv.restrictNormal_commutes τ ↥E ⟨x, hx⟩
  rw [hmem] at hcom
  simpa using hcom.symm

/-- **A prime of the base all of whose decomposition groups lie in a normal subgroup splits
completely in the fixed field of that subgroup.**  An automorphism of the fixed field fixing a
prime above the given one is the restriction of an automorphism of the top field fixing a prime
above it, which lies in the subgroup and so restricts to the identity; a prime with trivial
decomposition group everywhere above it is unramified of residue degree one. -/
theorem splitsCompletelyIn_fixedField_of_forall {H : Subgroup Gal(N/k)} [H.Normal]
    [NumberField ↥(IntermediateField.fixedField H)] {v : HeightOneSpectrum (𝓞 k)}
    (h : ∀ P : HeightOneSpectrum (𝓞 N), primeUnder (𝓞 k) P = v → stabilizer Gal(N/k) P ≤ H) :
    SplitsCompletelyIn k ↥(IntermediateField.fixedField H) v := by
  intro Q hQ
  obtain ⟨hQprime, hQover⟩ := hQ
  haveI := hQprime
  haveI := hQover
  have hQ0 : Q ≠ ⊥ := Ideal.ne_bot_of_liesOver_of_ne_bot v.ne_bot Q
  have hunder : Q.under (𝓞 k) = v.asIdeal :=
    (Ideal.LiesOver.over (A := 𝓞 k) (P := Q) (p := v.asIdeal)).symm
  have hbot : stabilizer Gal(↥(IntermediateField.fixedField H)/k) Q = ⊥ := by
    refine (Subgroup.eq_bot_iff_forall _).mpr fun τ hτ => ?_
    have hτ' : τ • (⟨Q, hQprime, hQ0⟩ :
        HeightOneSpectrum (𝓞 ↥(IntermediateField.fixedField H))) = ⟨Q, hQprime, hQ0⟩ := by
      refine HeightOneSpectrum.ext ?_
      rw [asIdeal_smul]
      exact mem_stabilizer_iff.mp hτ
    obtain ⟨σ, ⟨P, hPu, hP⟩, hres⟩ := exists_restrictNormalHom_eq_of_prime_above N τ hτ'
    have hPv : primeUnder (𝓞 k) P = v := by
      rw [← primeUnder_primeUnder k ↥(IntermediateField.fixedField H) P, hPu]
      exact HeightOneSpectrum.ext hunder
    rw [← hres, ← MonoidHom.mem_ker, ker_restrictNormalHom_fixedField]
    exact h P hPv hP
  rw [← hunder, ← relStabilizer_eq_bot_iff Q hQ0]
  exact hbot

/-! ### The generation theorem -/

/-- **The decomposition groups at the primes above the completely split primes generate the
subgroup fixing an intermediate field.**  Each of those decomposition groups fixes the intermediate
field, so the subgroup they generate does; were the containment strict, its fixed field would be
strictly larger than the intermediate field, so infinitely many primes of the base would split
completely in the intermediate field and not in that fixed field.  One of them avoids the
prescribed finite set and therefore belongs to the prescribed collection, so all its decomposition
groups lie in the subgroup and it splits completely in the fixed field, a contradiction. -/
theorem fixingSubgroup_le_decompositionSubgroupAbove (F : IntermediateField k N) [NumberField ↥F]
    [IsGalois k ↥F] (T : Finset (HeightOneSpectrum (𝓞 k)))
    {S : Set (HeightOneSpectrum (𝓞 k))} (hSsplit : ∀ v ∈ S, SplitsCompletelyIn k ↥F v)
    (hSmem : ∀ v : HeightOneSpectrum (𝓞 k), v ∉ T → SplitsCompletelyIn k ↥F v → v ∈ S) :
    F.fixingSubgroup ≤ decompositionSubgroupAbove k N S := by
  classical
  by_contra hcon
  haveI : NumberField ↥(IntermediateField.fixedField (decompositionSubgroupAbove k N S)) := ⟨⟩
  have hHF : decompositionSubgroupAbove k N S ≤ F.fixingSubgroup := by
    refine decompositionSubgroupAbove_le fun σ hσ => ?_
    obtain ⟨P, hPS, hPσ⟩ := mem_decompositionSetAbove.mp hσ
    exact stabilizer_le_fixingSubgroup_of_splitsCompletelyIn F (hSsplit _ hPS) rfl hPσ
  have hFE : F < IntermediateField.fixedField (decompositionSubgroupAbove k N S) := by
    refine lt_of_le_of_ne ((IntermediateField.le_iff_le _ _).mpr hHF) fun heq => hcon ?_
    rw [heq, IntermediateField.fixingSubgroup_fixedField]
  have hlt : Module.finrank k ↥F <
      Module.finrank k ↥(IntermediateField.fixedField (decompositionSubgroupAbove k N S)) :=
    finrank_lt_finrank_of_intermediateField_lt hFE
  obtain ⟨v, ⟨hsplitF, hnsplitE⟩, hvT⟩ :=
    (infinite_setOf_splitsCompletelyIn_not_splitsCompletelyIn k ↥F
      ↥(IntermediateField.fixedField (decompositionSubgroupAbove k N S))
      hlt).exists_notMem_finset T
  refine hnsplitE (splitsCompletelyIn_fixedField_of_forall fun P hP => ?_)
  refine stabilizer_le_decompositionSubgroupAbove k N S ?_
  rw [hP]
  exact hSmem v hvT hsplitF

omit [IsGalois k N] in
/-- **Finitely many primes of the base already carry the whole subgroup generated by the
decomposition groups above a set of primes.**  The Galois group is finite, so only finitely many
automorphisms occur among the generators, and each of them fixes a place lying above one prime of
the base; those finitely many primes suffice. -/
theorem exists_finite_subset_decompositionSubgroupAbove (S : Set (HeightOneSpectrum (𝓞 k))) :
    ∃ S₀ ⊆ S, S₀.Finite ∧
      decompositionSubgroupAbove k N S ≤ decompositionSubgroupAbove k N S₀ := by
  classical
  have hch : ∀ σ : ↥(decompositionSetAbove k N S), ∃ v : HeightOneSpectrum (𝓞 k), v ∈ S ∧
      ∃ P : HeightOneSpectrum (𝓞 N), primeUnder (𝓞 k) P = v ∧ (σ : Gal(N/k)) • P = P := by
    intro σ
    obtain ⟨P, hPS, hPσ⟩ := mem_decompositionSetAbove.mp σ.2
    exact ⟨primeUnder (𝓞 k) P, hPS, P, rfl, hPσ⟩
  choose f hfS hfP using hch
  refine ⟨Set.range f, ?_, Set.finite_range f, ?_⟩
  · rintro _ ⟨σ, rfl⟩
    exact hfS σ
  · refine decompositionSubgroupAbove_le fun σ hσ => ?_
    obtain ⟨P, hP1, hP2⟩ := hfP ⟨σ, hσ⟩
    refine stabilizer_le_decompositionSubgroupAbove k N _ (v := P) ?_ hP2
    rw [hP1]
    exact Set.mem_range_self _

/-! ### Detecting a radical -/

/-- **There are finitely many completely split primes of an intermediate field, avoiding any
prescribed finite set of primes of the base, at which being a local power forces a radicand whose
radical lies in the top field to be a power already in the intermediate field.**  The decomposition
groups at the primes of the top field above those primes generate the subgroup fixing the
intermediate field, and an automorphism in a decomposition group fixes the radical exactly when the
radicand is a power in the completion below.  A radical fixed by the whole subgroup lies in the
intermediate field, and its power there is the radicand. -/
theorem exists_finite_splitsCompletelyIn_pow_of_forall_localPow (F : IntermediateField k N)
    [NumberField ↥F] [IsGalois k ↥F] {p : ℕ} (hp : p ≠ 0) {ζ : ↥F} (hζ : IsPrimitiveRoot ζ p)
    (T : Finset (HeightOneSpectrum (𝓞 k))) :
    ∃ S : Set (HeightOneSpectrum (𝓞 ↥F)), S.Finite ∧
      (∀ W ∈ S, primeUnder (𝓞 k) W ∉ T ∧ SplitsCompletelyIn k ↥F (primeUnder (𝓞 k) W)) ∧
      ∀ (x : ↥F) (ξ : N), ξ ^ p = algebraMap (↥F) N x →
        (∀ W ∈ S, ∃ c : W.adicCompletion ↥F,
          c ^ p = algebraMap (↥F) (W.adicCompletion ↥F) x) → ∃ y : ↥F, y ^ p = x := by
  classical
  obtain ⟨S₀, hS₀sub, hS₀fin, hS₀le⟩ :=
    exists_finite_subset_decompositionSubgroupAbove (N := N)
      {v : HeightOneSpectrum (𝓞 k) | v ∉ T ∧ SplitsCompletelyIn k ↥F v}
  have hkey : F.fixingSubgroup ≤ decompositionSubgroupAbove k N S₀ :=
    le_trans (fixingSubgroup_le_decompositionSubgroupAbove F T
      (S := {v : HeightOneSpectrum (𝓞 k) | v ∉ T ∧ SplitsCompletelyIn k ↥F v})
      (fun _ hv => hv.2) (fun _ h1 h2 => ⟨h1, h2⟩)) hS₀le
  refine ⟨{W : HeightOneSpectrum (𝓞 ↥F) | primeUnder (𝓞 k) W ∈ S₀},
    finite_setOf_primeUnder_mem (K := ↥F) k hS₀fin, fun W hW => hS₀sub hW, ?_⟩
  intro x ξ hξ hloc
  have hsub : decompositionSubgroupAbove k N S₀ ≤ stabilizer Gal(N/k) ξ := by
    refine decompositionSubgroupAbove_le fun τ hτ => ?_
    obtain ⟨P, hPS, hPτ⟩ := mem_decompositionSetAbove.mp hτ
    have hτF : τ ∈ F.fixingSubgroup :=
      stabilizer_le_fixingSubgroup_of_splitsCompletelyIn F (hS₀sub hPS).2 rfl hPτ
    have hker : AlgEquiv.restrictNormalHom ↥F τ = 1 := by
      rw [← MonoidHom.mem_ker, IntermediateField.restrictNormalHom_ker]
      exact hτF
    obtain ⟨ρ, hρ⟩ := exists_restrictScalars_of_restrictNormalHom_eq_one k hker
    have hρP : ρ ∈ stabilizer Gal(N/↥F) P := by
      rw [mem_stabilizer_iff]
      refine HeightOneSpectrum.ext ?_
      rw [asIdeal_smul, ← relRestrictScalars_smul_ideal (k := k) ρ P.asIdeal, hρ]
      exact congrArg HeightOneSpectrum.asIdeal hPτ
    have hWmem : primeUnder (𝓞 ↥F) P ∈
        {W : HeightOneSpectrum (𝓞 ↥F) | primeUnder (𝓞 k) W ∈ S₀} := by
      show primeUnder (𝓞 k) (primeUnder (𝓞 ↥F) P) ∈ S₀
      rwa [primeUnder_primeUnder k ↥F P]
    have hfix :=
      (forall_stabilizer_smul_eq_iff_exists_pow P hζ hp hξ.symm).mpr (hloc _ hWmem) ⟨ρ, hρP⟩
    rw [mem_stabilizer_iff, AlgEquiv.smul_def, ← hρ]
    exact hfix
  have hmem : ξ ∈ IntermediateField.fixedField F.fixingSubgroup := by
    rw [IntermediateField.mem_fixedField_iff]
    intro τ hτ
    exact mem_stabilizer_iff.mp (hsub (hkey hτ))
  rw [IsGalois.fixedField_fixingSubgroup] at hmem
  refine ⟨⟨ξ, hmem⟩, (algebraMap (↥F) N).injective ?_⟩
  rw [_root_.map_pow]
  exact hξ

end Detect

end InverseGalois.CFT
