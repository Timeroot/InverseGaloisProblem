import InverseGalois.CFT.PoitouTate.RadicandPlaces
import InverseGalois.CFT.Units.ClassPlaces

/-!
# The class of a prime, refined by the local classes at a finite set of places

An element of a number field with prescribed orders is produced by comparing ideal classes: two
primes of the same class differ by a principal ideal, and a generator of that ideal has order one
at the first prime, minus one at the second, and none anywhere else.  A prescription that also asks
the generator to be a local `n`-th power at finitely many named places is served by the same
argument once the ideal class is refined: divide the invertible fractional ideals not by all the
principal ones but only by those generated by an element which is a local `n`-th power at every
named place.

The refinement is still a finite group.  An ideal class and the vector of local classes of a
generator determine the refined class, the local classes at a place are finite in number, and there
are finitely many named places.  So the primes still fall into finitely many refined classes, and
one prime of each class suffices as a **correction room** — a room whose generators are local
`n`-th powers at the named places for free, which is exactly the condition a confined unit carries.

## Main definitions

* `InverseGalois.CFT.localPowerUnits`: the elements which are local `n`-th powers at every named
  place.
* `InverseGalois.CFT.localIdealClass`: **the class group refined by the local classes at the named
  places.**
* `InverseGalois.CFT.clsLocalPlace`: the refined class of a prime.

## Main results

* `InverseGalois.CFT.finite_localIdealClass`: **the refined class group is finite.**
* `InverseGalois.CFT.exists_ord_sub_of_clsLocalPlace_eq`: **two primes of the same refined class
  differ by the divisor of an element which is a local `n`-th power at every named place.**
* `InverseGalois.CFT.exists_localClass_reps`: **a set of at most twice the refined class number many
  primes, avoiding a prescribed set, meeting every refined class met outside it.**
* `InverseGalois.CFT.exists_stable_localClass_reps`: the same set stable under the Galois group.

## Tags

number field, class group, local class, fractional ideal, place, correction room
-/

namespace InverseGalois.CFT

open FractionalIdeal IsDedekindDomain NumberField Rigidity.RET

open scoped nonZeroDivisors

/-! ### The refined class group -/

section Refined

variable (K : Type) [Field K] [NumberField K] (n : ℕ) (Tz : Set (HeightOneSpectrum (𝓞 K)))

/-- **The elements of a number field which are local `n`-th powers at every place of a set.** -/
def localPowerUnits : Subgroup Kˣ where
  carrier := {x : Kˣ | ∀ w ∈ Tz, x ∈ (localClassHom w n).ker}
  mul_mem' hx hy v hv := Subgroup.mul_mem _ (hx v hv) (hy v hv)
  one_mem' _ _ := Subgroup.one_mem _
  inv_mem' hx v hv := Subgroup.inv_mem _ (hx v hv)

theorem mem_localPowerUnits_ker {x : Kˣ} :
    x ∈ localPowerUnits K n Tz ↔ ∀ w ∈ Tz, x ∈ (localClassHom w n).ker := Iff.rfl

theorem mem_localPowerUnits {x : Kˣ} :
    x ∈ localPowerUnits K n Tz ↔ ∀ w ∈ Tz, localClassHom w n x = 1 := Iff.rfl

/-- **The principal ideals generated by an element which is a local `n`-th power at every named
place.** -/
noncomputable def localPrincipalSubgroup : Subgroup ((FractionalIdeal (𝓞 K)⁰ K)ˣ) :=
  ((toPrincipalIdeal (𝓞 K) K).comp (localPowerUnits K n Tz).subtype).range

theorem mem_localPrincipalSubgroup {I : (FractionalIdeal (𝓞 K)⁰ K)ˣ} :
    I ∈ localPrincipalSubgroup K n Tz ↔
      ∃ x : Kˣ, x ∈ localPowerUnits K n Tz ∧ toPrincipalIdeal (𝓞 K) K x = I :=
  ⟨fun ⟨u, hu⟩ => ⟨(u : Kˣ), u.2, hu⟩, fun ⟨x, hx, hxI⟩ => ⟨⟨x, hx⟩, hxI⟩⟩

/-- **The class group refined by the local classes modulo `n`-th powers at a set of places.** -/
abbrev localIdealClass : Type :=
  (FractionalIdeal (𝓞 K)⁰ K)ˣ ⧸ localPrincipalSubgroup K n Tz

/-- **The refined class of a prime.** -/
noncomputable def clsLocalPlace (v : HeightOneSpectrum (𝓞 K)) : localIdealClass K n Tz :=
  QuotientGroup.mk' (localPrincipalSubgroup K n Tz) (placeUnit K v)

theorem clsLocalPlace_def (v : HeightOneSpectrum (𝓞 K)) :
    clsLocalPlace K n Tz v
      = QuotientGroup.mk' (localPrincipalSubgroup K n Tz) (placeUnit K v) := rfl

/-- **The refined class group is finite.**  An ideal class and the vector of local classes of a
generator of the correcting principal ideal determine the refined class, and there are finitely
many of each. -/
theorem finite_localIdealClass [NeZero n] [Finite ↥Tz] : Finite (localIdealClass K n Tz) := by
  classical
  haveI : ∀ w : ↥Tz, Finite (localClasses (w : HeightOneSpectrum (𝓞 K)) n) := fun _ =>
    finite_localClasses _
  haveI : Finite ((w : ↥Tz) → localClasses (w : HeightOneSpectrum (𝓞 K)) n) := Pi.finite
  obtain ⟨rep, hrep⟩ := exists_rep_quotient K
  set φ : Kˣ → ((w : ↥Tz) → localClasses (w : HeightOneSpectrum (𝓞 K)) n) :=
    fun x w => localClassHom (w : HeightOneSpectrum (𝓞 K)) n x with hφ
  have hsec : ∀ ξ : ((w : ↥Tz) → localClasses (w : HeightOneSpectrum (𝓞 K)) n),
      ∃ x : Kˣ, ξ ∈ Set.range φ → φ x = ξ := by
    intro ξ
    by_cases hξ : ξ ∈ Set.range φ
    · obtain ⟨x, hx⟩ := hξ
      exact ⟨x, fun _ => hx⟩
    · exact ⟨1, fun h => absurd h hξ⟩
  choose s hs using hsec
  refine Finite.of_surjective
    (f := fun c : ((FractionalIdeal (𝓞 K)⁰ K)ˣ ⧸ (toPrincipalIdeal (𝓞 K) K).range) ×
        ((w : ↥Tz) → localClasses (w : HeightOneSpectrum (𝓞 K)) n) =>
      (QuotientGroup.mk' (localPrincipalSubgroup K n Tz)
        (rep c.1 * toPrincipalIdeal (𝓞 K) K (s c.2)) : localIdealClass K n Tz))
    fun y => ?_
  induction y using QuotientGroup.induction_on with
  | _ I =>
    obtain ⟨z, hz⟩ : ∃ z : Kˣ, toPrincipalIdeal (𝓞 K) K z
        = (rep (QuotientGroup.mk' (toPrincipalIdeal (𝓞 K) K).range I))⁻¹ * I :=
      QuotientGroup.eq.mp (hrep (QuotientGroup.mk' (toPrincipalIdeal (𝓞 K) K).range I))
    refine ⟨(QuotientGroup.mk' (toPrincipalIdeal (𝓞 K) K).range I, φ z), ?_⟩
    have hsz : φ (s (φ z)) = φ z := hs (φ z) ⟨z, rfl⟩
    refine QuotientGroup.eq.mpr ((mem_localPrincipalSubgroup K n Tz).mpr
      ⟨(s (φ z))⁻¹ * z, (mem_localPowerUnits_ker K n Tz).mpr fun w hw => ?_, ?_⟩)
    · have h1 : localClassHom w n (s (φ z)) = localClassHom w n z := congrFun hsz ⟨w, hw⟩
      have h2 : localClassHom w n ((s (φ z))⁻¹ * z)
          = (localClassHom w n z)⁻¹ * localClassHom w n z := by
        rw [_root_.map_mul, _root_.map_inv, h1]
      exact MonoidHom.mem_ker.mpr (h2.trans (inv_mul_cancel _))
    · rw [_root_.map_mul, _root_.map_inv, hz, mul_inv_rev, mul_assoc]

end Refined

/-! ### Comparing two primes of the same refined class -/

section Compare

variable {K : Type} [Field K] [NumberField K] {n : ℕ} {Tz : Set (HeightOneSpectrum (𝓞 K))}

open scoped Classical in
/-- The exponent of one prime in another is one where they agree and zero where they do not. -/
theorem count_coeIdeal_asIdeal (u w : HeightOneSpectrum (𝓞 K)) :
    FractionalIdeal.count K u ((w.asIdeal : FractionalIdeal (𝓞 K)⁰ K))
      = if u = w then (1 : ℤ) else 0 := by
  by_cases huw : u = w
  · subst huw
    rw [if_pos rfl, FractionalIdeal.count_self]
  · rw [if_neg huw, FractionalIdeal.count_maximal_coprime K u fun h => huw h.symm]

open scoped Classical in
/-- **Two primes of the same refined class differ by the divisor of an element which is a local
`n`-th power at every named place.**  The element generates the principal ideal by which the two
primes differ, and the refinement is exactly the demand that such a generator be trivial in the
local classes. -/
theorem exists_ord_sub_of_clsLocalPlace_eq {v v' : HeightOneSpectrum (𝓞 K)}
    (h : clsLocalPlace K n Tz v = clsLocalPlace K n Tz v') :
    ∃ x : Kˣ, (∀ w ∈ Tz, localClassHom w n x = 1) ∧
      ∀ u : HeightOneSpectrum (𝓞 K),
        ord K u ((x : Kˣ) : K)
          = (if u = v then (1 : ℤ) else 0) - (if u = v' then (1 : ℤ) else 0) := by
  obtain ⟨y, hy2, hy1⟩ := (mem_localPrincipalSubgroup K n Tz).mp
    (QuotientGroup.eq.mp h : (placeUnit K v)⁻¹ * placeUnit K v' ∈ localPrincipalSubgroup K n Tz)
  have hy3 : placeUnit K v * toPrincipalIdeal (𝓞 K) K y = placeUnit K v' := by
    rw [hy1, mul_inv_cancel_left]
  have hord : ∀ u : HeightOneSpectrum (𝓞 K),
      (if u = v then (1 : ℤ) else 0) + ord K u ((y : Kˣ) : K)
        = (if u = v' then (1 : ℤ) else 0) := by
    intro u
    have h4 : FractionalIdeal.count K u
        ((placeUnit K v * toPrincipalIdeal (𝓞 K) K y : (FractionalIdeal (𝓞 K)⁰ K)ˣ) :
          FractionalIdeal (𝓞 K)⁰ K)
        = FractionalIdeal.count K u ((v.asIdeal : FractionalIdeal (𝓞 K)⁰ K))
          + ord K u ((y : Kˣ) : K) := by
      rw [Units.val_mul, coe_placeUnit, coe_toPrincipalIdeal,
        FractionalIdeal.count_mul K u (coeIdeal_ne_zero.mpr v.ne_bot)
          (spanSingleton_ne_zero_iff.mpr (Units.ne_zero y)), ord_def]
    rw [← count_coeIdeal_asIdeal u v, ← count_coeIdeal_asIdeal u v', ← h4, hy3, coe_placeUnit]
  refine ⟨y⁻¹, (mem_localPowerUnits K n Tz).mp ((localPowerUnits K n Tz).inv_mem hy2),
    fun u => ?_⟩
  · rw [Units.val_inv_eq_inv_val, ord_inv]
    have h5 := hord u
    split_ifs at h5 ⊢ <;> omega

end Compare

/-! ### A correction room meeting every refined class -/

section Room

variable (K : Type) [Field K] [NumberField K] (n : ℕ) [NeZero n]
  (Tz : Set (HeightOneSpectrum (𝓞 K))) [Finite ↥Tz]

/-- **A set of at most twice the refined class number many primes, avoiding a prescribed set, which
meets every refined class met outside that set.**  One prime is kept for each refined class met
outside the prescribed set inside a distinguished set of places, and one for each met outside the
prescribed set anywhere; the two together are what a prescription with a divisibility condition
away from the distinguished set consumes. -/
theorem exists_localClass_reps (E Y : Set (HeightOneSpectrum (𝓞 K))) :
    ∃ A : Set (HeightOneSpectrum (𝓞 K)), A.Finite ∧ (∀ w ∈ A, w ∉ E) ∧
      Nat.card ↥A ≤ 2 * Nat.card (localIdealClass K n Tz) ∧
      (∀ v ∈ Y, v ∉ E → ∃ w ∈ A, w ∈ Y ∧
        clsLocalPlace K n Tz w = clsLocalPlace K n Tz v) ∧
      (∀ v ∉ E, ∃ w ∈ A, clsLocalPlace K n Tz w = clsLocalPlace K n Tz v) := by
  classical
  haveI := finite_localIdealClass K n Tz
  have hchoose₁ : ∀ c : ↥(clsLocalPlace K n Tz '' (Y \ E)),
      ∃ w, (w ∈ Y ∧ w ∉ E) ∧ clsLocalPlace K n Tz w = (c : localIdealClass K n Tz) := fun c => c.2
  have hchoose₂ : ∀ c : ↥(clsLocalPlace K n Tz '' Eᶜ),
      ∃ w, w ∉ E ∧ clsLocalPlace K n Tz w = (c : localIdealClass K n Tz) := fun c => c.2
  choose g₁ hg₁ hc₁ using hchoose₁
  choose g₂ hg₂ hc₂ using hchoose₂
  have hle : ∀ (S : Set (localIdealClass K n Tz)) (g : ↥S → HeightOneSpectrum (𝓞 K)),
      Nat.card ↥(Set.range g) ≤ Nat.card (localIdealClass K n Tz) := by
    intro S g
    refine le_trans (Nat.card_le_card_of_surjective
      (fun c => (⟨g c, ⟨c, rfl⟩⟩ : ↥(Set.range g))) fun y => ?_)
      (Nat.card_le_card_of_injective (Subtype.val : ↥S → localIdealClass K n Tz)
        Subtype.val_injective)
    obtain ⟨c, hc⟩ := y.2
    exact ⟨c, Subtype.ext hc⟩
  refine ⟨Set.range g₁ ∪ Set.range g₂,
    (Set.finite_range g₁).union (Set.finite_range g₂), ?_, ?_, ?_, ?_⟩
  · rintro w (⟨c, rfl⟩ | ⟨c, rfl⟩)
    · exact (hg₁ c).2
    · exact hg₂ c
  · have hcard := Set.ncard_union_le (Set.range g₁) (Set.range g₂)
    rw [← _root_.Nat.card_coe_set_eq, ← _root_.Nat.card_coe_set_eq,
      ← _root_.Nat.card_coe_set_eq] at hcard
    refine hcard.trans ?_
    rw [two_mul]
    exact Nat.add_le_add (hle _ g₁) (hle _ g₂)
  · intro v hvY hvE
    exact ⟨g₁ ⟨clsLocalPlace K n Tz v, ⟨v, ⟨hvY, hvE⟩, rfl⟩⟩, Or.inl ⟨_, rfl⟩,
      (hg₁ _).1, hc₁ _⟩
  · intro v hvE
    exact ⟨g₂ ⟨clsLocalPlace K n Tz v, ⟨v, hvE, rfl⟩⟩, Or.inr ⟨_, rfl⟩, hc₂ _⟩

end Room

/-! ### Making the correction room invariant -/

section Stable

variable {k : Type} {K : Type} [Field k] [Field K] [Algebra k K] [NumberField K]
  [Finite Gal(K/k)] (n : ℕ) [NeZero n] (Tz : Set (HeightOneSpectrum (𝓞 K))) [Finite ↥Tz]

omit [NumberField K] in
/-- **The hull of a finite set is covered by the translates of the set**, so it has at most the
order of the group times as many elements. -/
theorem nat_card_stableHull_le (A : Set (HeightOneSpectrum (𝓞 K))) [Finite ↥A] :
    Nat.card ↥(stableHull k K A) ≤ Nat.card Gal(K/k) * Nat.card ↥A := by
  classical
  refine le_trans (Nat.card_le_card_of_surjective
    (fun ga : Gal(K/k) × ↥A => (⟨ga.1⁻¹ • (ga.2 : HeightOneSpectrum (𝓞 K)),
      ⟨ga.1, by rw [smul_inv_smul]; exact ga.2.2⟩⟩ : ↥(stableHull k K A))) fun y => ?_)
    (le_of_eq (Nat.card_prod _ _))
  obtain ⟨σ, hσ⟩ := y.2
  exact ⟨(σ, ⟨σ • (y : HeightOneSpectrum (𝓞 K)), hσ⟩), Subtype.ext (inv_smul_smul σ _)⟩

/-- **A stable set of at most the order of the group times twice the refined class number many
primes, avoiding a prescribed stable set, which meets every refined class met outside it.**  The
bound belongs to the field and its extension, not to the primes, so it is known before the primes
to be avoided are chosen. -/
theorem exists_stable_localClass_reps (E Y : Set (HeightOneSpectrum (𝓞 K)))
    [IsGaloisStablePlaces k K E] :
    ∃ A : Set (HeightOneSpectrum (𝓞 K)), A.Finite ∧ IsGaloisStablePlaces k K A ∧
      (∀ w ∈ A, w ∉ E) ∧
      Nat.card ↥A ≤ Nat.card Gal(K/k) * (2 * Nat.card (localIdealClass K n Tz)) ∧
      (∀ v ∈ Y, v ∉ E → ∃ w ∈ A, w ∈ Y ∧
        clsLocalPlace K n Tz w = clsLocalPlace K n Tz v) ∧
      (∀ v ∉ E, ∃ w ∈ A, clsLocalPlace K n Tz w = clsLocalPlace K n Tz v) := by
  classical
  obtain ⟨A, hAfin, hAE, hAcard, hAin, hAout⟩ := exists_localClass_reps K n Tz E Y
  haveI : Finite ↥A := hAfin.to_subtype
  refine ⟨stableHull k K A, stableHull_finite (k := k) hAfin,
    isGaloisStablePlaces_stableHull k K A, ?_, ?_, ?_, ?_⟩
  · rintro w ⟨σ, hσ⟩ hwE
    exact hAE _ hσ ((IsGaloisStablePlaces.smul_mem_iff (k := k) (T := E) σ w).2 hwE)
  · exact le_trans (nat_card_stableHull_le (k := k) A) (Nat.mul_le_mul_left _ hAcard)
  · intro v hvY hvE
    obtain ⟨w, hwA, hwY, hwc⟩ := hAin v hvY hvE
    exact ⟨w, subset_stableHull k K A hwA, hwY, hwc⟩
  · intro v hvE
    obtain ⟨w, hwA, hwc⟩ := hAout v hvE
    exact ⟨w, subset_stableHull k K A hwA, hwc⟩

end Stable

end InverseGalois.CFT
