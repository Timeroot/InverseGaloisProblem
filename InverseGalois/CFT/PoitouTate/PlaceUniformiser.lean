import Mathlib
import InverseGalois.CFT.PoitouTate.ClosingChain
import InverseGalois.CFT.PoitouTate.Prescribed

/-!
# A ramified class prescribed at one finite place

The classes of a completion of a number field modulo `n`-th powers are generated by the unramified
ones together with the class of a uniformiser, and the quotient by the unramified ones is cyclic of
order `n`, generated by that class.  A prescription which is to be ramified at one place is
therefore given there by a power of the class of a uniformiser, the exponent being prime to `n`.

Such a prescription is easy to pair against a class coming from a unit of the number field which is
unramified at the place: the norm residue symbol of an element whose value the exponent divides,
against anything, is its value at the Frobenius automorphism raised to the value of the second
argument, and the value of a power of a uniformiser is that power.  The pairing is thus the value
of the unit at the Frobenius automorphism of the place, raised to the prescribed exponent.

Reading the valuation of the prescription modulo `n` also identifies the value at the place of any
unit whose class meets the prescription up to an unramified class: it is congruent to the exponent,
so the unit is ramified there as soon as the exponent is prime to `n`.

## Main definitions

* `InverseGalois.CFT.placeUniformiser`: a uniformiser of the completion at a finite place.
* `InverseGalois.CFT.placeUniformiserClass`: **the class of a power of a uniformiser**, the
  prescription which is ramified at one place.

## Main results

* `InverseGalois.CFT.unitValModQuot_placeUniformiserClass`: its valuation modulo `n` is the
  exponent.
* `InverseGalois.CFT.placeUniformiserClass_notMem_localUnramified`: it is ramified as soon as the
  exponent is prime to `n`.
* `InverseGalois.CFT.localClassPairing_localClassHom_placeUniformiserClass`: **the pairing of the
  class of an unramified unit against it** is the value of that unit at the Frobenius automorphism
  of the place, raised to the exponent.
* `InverseGalois.CFT.placeValue_modEq_of_localClassHom_mul_eq`: a unit whose class meets the
  prescription up to an unramified class has value at the place congruent to the exponent.

## Tags

norm residue symbol, uniformiser, ramified, unramified, Frobenius, number field, class field theory
-/

namespace InverseGalois.CFT

open IsDedekindDomain NumberField

/-! ### The class of a power of a uniformiser -/

section Uniformiser

variable {K : Type} [Field K] [NumberField K]

/-- **A uniformiser of the completion of a number field at a finite place**: a unit of the
completion whose value is the chosen generator of the value group. -/
noncomputable def placeUniformiser (v : HeightOneSpectrum (𝓞 K)) : (v.adicCompletion K)ˣ :=
  (exists_unitValDiv_eq_one (isUnitValGen_one (valued_adicCompletion_surjective v))).choose

theorem unitValDiv_placeUniformiser (v : HeightOneSpectrum (𝓞 K)) :
    unitValDiv (isUnitValGen_one (valued_adicCompletion_surjective v))
        (Additive.ofMul (placeUniformiser v)) = 1 :=
  (exists_unitValDiv_eq_one (isUnitValGen_one (valued_adicCompletion_surjective v))).choose_spec

/-- The value of a power of a uniformiser is that power. -/
theorem unitValDiv_placeUniformiser_zpow (v : HeightOneSpectrum (𝓞 K)) (j : ℤ) :
    unitValDiv (isUnitValGen_one (valued_adicCompletion_surjective v))
        (Additive.ofMul (placeUniformiser v ^ j)) = j := by
  rw [ofMul_zpow, map_zsmul, unitValDiv_placeUniformiser, smul_eq_mul, mul_one]

/-- **The class of a power of a uniformiser at a finite place**, modulo `n`-th powers. -/
noncomputable def placeUniformiserClass (v : HeightOneSpectrum (𝓞 K)) (n : ℕ) (j : ℤ) :
    localClasses v n :=
  QuotientGroup.mk (placeUniformiser v ^ j)

/-- **The valuation modulo `n` of the class of a power of a uniformiser is that power.** -/
theorem unitValModQuot_placeUniformiserClass (v : HeightOneSpectrum (𝓞 K)) (n : ℕ) (j : ℤ) :
    unitValModQuot (isUnitValGen_one (valued_adicCompletion_surjective v)) n
        (placeUniformiserClass v n j)
      = Multiplicative.ofAdd ((j : ZMod n)) := by
  rw [placeUniformiserClass, unitValModQuot_mk, unitValMod_apply,
    unitValDiv_placeUniformiser_zpow]

/-- **The class of a power of a uniformiser is ramified as soon as the exponent is prime to
`n`.** -/
theorem placeUniformiserClass_notMem_localUnramified {n : ℕ} [NeZero n]
    {v : HeightOneSpectrum (𝓞 K)} {j : ℤ} (hj : ¬ (n : ℤ) ∣ j) :
    placeUniformiserClass v n j ∉ localUnramified v n := by
  rw [placeUniformiserClass, localUnramified,
    mk_mem_unramifiedClasses_iff _ (placeUniformiser v ^ j), unitValDiv_placeUniformiser_zpow]
  exact hj

end Uniformiser

/-! ### Pairing against the prescription -/

section Pairing

variable {K : Type} [Field K] [NumberField K] {n : ℕ} [NeZero n]
  {P E : HeightOneSpectrum (𝓞 K) → ℕ}

/-- **The pairing of the class of a unit unramified at a finite place against the class of a power
of a uniformiser there** is the value of that unit at the Frobenius automorphism of the place,
raised to the exponent. -/
theorem localClassPairing_localClassHom_placeUniformiserClass (hn : n.Prime)
    (hres : ∀ v : HeightOneSpectrum (𝓞 K), HasResidueChar (v.adicCompletion K) (P v) (E v))
    {ζ : K} (hζ : IsPrimitiveRoot ζ n) {v : HeightOneSpectrum (𝓞 K)} (hv : ¬ P v ∣ n) {u : Kˣ}
    (hu : (n : ℤ) ∣ placeValue v u) (j : ℤ) :
    localClassPairing hres hζ v (localClassHom v n u) (placeUniformiserClass v n j)
      = (placeFrobValue hres hζ v u ^ j)⁻¹ := by
  have h : localClassPairing hres hζ v (localClassHom v n u) (placeUniformiserClass v n j)
      = localSymbol (hres v) (isUnitValGen_one (valued_adicCompletion_surjective v))
        (hζ.map_of_injective (algebraMap K (v.adicCompletion K)).injective)
        (placeUniformiser v ^ j)
        (Units.map (algebraMap K (v.adicCompletion K)).toMonoidHom u) := rfl
  have hu' : (n : ℤ) ∣ unitValDiv (isUnitValGen_one (valued_adicCompletion_surjective v))
      (Additive.ofMul (Units.map (algebraMap K (v.adicCompletion K)).toMonoidHom u)) := hu
  rw [h, localSymbol_eq_frobValue_zpow_right _ _ _ hn hv hu', unitValDiv_placeUniformiser_zpow]
  rfl

omit [NeZero n] in
/-- **A unit whose class at a finite place meets the class of a power of a uniformiser up to an
unramified class has value there congruent to the exponent.** -/
theorem placeValue_modEq_of_localClassHom_mul_eq {v : HeightOneSpectrum (𝓞 K)} {a : Kˣ}
    {l : localClasses v n} (hl : l ∈ localUnramified v n) {j : ℤ}
    (h : localClassHom v n a * l = placeUniformiserClass v n j) :
    placeValue v a ≡ j [ZMOD (n : ℤ)] := by
  have hl1 : unitValModQuot (isUnitValGen_one (valued_adicCompletion_surjective v)) n l = 1 := hl
  have hval := congrArg
    (unitValModQuot (isUnitValGen_one (valued_adicCompletion_surjective v)) n) h
  rw [_root_.map_mul, unitValModQuot_localClassHom, unitValModQuot_placeUniformiserClass, hl1,
    mul_one, Equiv.apply_eq_iff_eq] at hval
  exact (ZMod.intCast_eq_intCast_iff _ _ _).mp hval

omit [NeZero n] in
/-- **A unit whose class at a finite place meets the class of a power of a uniformiser with
exponent prime to `n`, up to an unramified class, is ramified there.** -/
theorem not_dvd_placeValue_of_localClassHom_mul_eq {v : HeightOneSpectrum (𝓞 K)} {a : Kˣ}
    {l : localClasses v n} (hl : l ∈ localUnramified v n) {j : ℤ} (hj : ¬ (n : ℤ) ∣ j)
    (h : localClassHom v n a * l = placeUniformiserClass v n j) :
    ¬ (n : ℤ) ∣ placeValue v a := by
  intro hdvd
  have hmod := (placeValue_modEq_of_localClassHom_mul_eq hl h).dvd
  exact hj (by simpa using dvd_add hmod hdvd)

end Pairing

end InverseGalois.CFT
