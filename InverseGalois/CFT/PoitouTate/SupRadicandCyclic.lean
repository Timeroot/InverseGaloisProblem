import Mathlib
import InverseGalois.CFT.PoitouTate.CyclicPairing
import InverseGalois.CFT.PoitouTate.SupRadicandChar

/-!
# A radicand of a compositum against a prescription carried on a line

The prescription character kills a radicand of a compositum of two extensions for two reasons, one
for each factor.  The first factor is handled by the product formula, exactly as before.  For the
second factor the reason available so far was orthogonality of the unramified classes, which asks
the prescription to be unramified where it is carried; that is what confines the whole construction
to unramified prescriptions.

Isotropy of a cyclic group of classes replaces it.  Where the prescription is carried it is asked
only that the class of every radicand of the second extension lie on the same line as the
prescribed class — a condition that says nothing about ramification, and which a prescription
ramified where it is carried can satisfy.  In the intended use the second extension is generated by
the roots of the units already built, so the classes of its radicands at a prescribed place are the
classes those units were prescribed there, and the condition asks exactly that all the coordinates
of the prescription at one place lie on one line.

The first factor keeps its own reason as long as the prescription is carried by a global unit
somewhere.  When the first extension splits completely at *every* place of the prescribed set — as
it does when it is the base field itself — the reason becomes trivial: the radicand is a local power
at each of those places, so it pairs trivially with the prescription there and the product formula
is not needed.  That version of the statement asks for no global unit and for no ramification
hypothesis whatsoever.

## Main results

* `InverseGalois.CFT.prescriptionChar_eq_one_of_mul_zpowers`: the prescription character kills a
  product of a unit trivial off the part of the prescription carried by a global unit and a unit
  whose class lies on the line of the prescription.
* `InverseGalois.CFT.prescriptionChar_eq_one_of_pow_mul_zpowers`: the same with the first factor
  given as a radicand of an extension splitting completely off that part.
* `InverseGalois.CFT.prescriptionChar_eq_one_of_factor_zpowers`: the same with each factor given as
  a radicand of its own extension.
* `InverseGalois.CFT.prescriptionChar_eq_one_of_pow_sup_zpowers`: **the prescription character
  kills every radicand of a compositum** whose second factor carries all its radicands on the line
  of the prescription, with no unramifiedness asked of the prescription.
* `InverseGalois.CFT.prescriptionChar_eq_one_of_forall_localClassHom_eq_one`: the prescription
  character kills a unit which is a local power at every place of the prescribed set.
* `InverseGalois.CFT.prescriptionChar_eq_one_of_pow_sup_split`: the same as the compositum theorem
  for a first extension splitting completely at *every* place of the prescribed set, where no
  global unit and no ramification hypothesis is needed at all.

## Tags

norm residue symbol, local class, isotropic, cyclic, prescription character, compositum, radicand
-/

namespace InverseGalois.CFT

open IsDedekindDomain MulAction NumberField Rigidity.RET

/-! ### The two halves of the character -/

section Halves

variable {K : Type} [Field K] [NumberField K] {n : ℕ} [NeZero n]
  {P E : HeightOneSpectrum (𝓞 K) → ℕ}

/-- **The prescription character kills a product of the two shapes of unit it kills**, the second
shape now being a unit whose class at each prescribed place lies on the line of the prescribed
class.  A radicand of a compositum is such a product, one factor coming from each of the two
extensions. -/
theorem prescriptionChar_eq_one_of_mul_zpowers (hn : n.Prime) (hn2 : n ≠ 2)
    (hres : ∀ v : HeightOneSpectrum (𝓞 K), HasResidueChar (v.adicCompletion K) (P v) (E v))
    {ζ : K} (hζ : IsPrimitiveRoot ζ n) {T Tn : Finset (HeightOneSpectrum (𝓞 K))} (hT : T ⊆ Tn)
    (hnTn : ∀ v : HeightOneSpectrum (𝓞 K), FinitePlace.mk v ((n : ℕ) : K) ≠ 1 → v ∈ Tn)
    {c : (v : HeightOneSpectrum (𝓞 K)) → localClasses v n} {g : Kˣ}
    (hg : g ∈ sUnits K (Tn : Set (HeightOneSpectrum (𝓞 K))))
    (hc : ∀ v ∈ T, c v = localClassHom v n g) (hcT : ∀ v ∈ Tn, v ∉ T → c v = 1)
    {u u₁ u₂ : Kˣ} (hu : u = u₁ * u₂)
    (h1 : ∀ v ∈ Tn, v ∉ T → localClassHom v n u₁ = 1)
    (h1out : ∀ v ∉ Tn, (n : ℤ) ∣ placeValue v u₁)
    (h2 : ∀ v ∈ T, ∃ d : localClasses v n,
      localClassHom v n u₂ ∈ Subgroup.zpowers d ∧ c v ∈ Subgroup.zpowers d) :
    prescriptionChar hres hζ Tn c u = 1 := by
  rw [hu, _root_.map_mul,
    prescriptionChar_eq_one_of_localClassHom_eq_one hn hn2 hres hζ hT hnTn hg hc h1 h1out,
    prescriptionChar_eq_one_of_mem_zpowers hres hζ (hn.odd_of_ne_two hn2) hcT h2, one_mul]

end Halves

/-! ### The first factor as a radicand -/

section Radicand

variable {K M : Type} [Field K] [NumberField K] [Field M] [NumberField M] [Algebra K M]
  [IsGalois K M] {n : ℕ} [NeZero n] {P E : HeightOneSpectrum (𝓞 K) → ℕ}

/-- **The prescription character kills a product whose first factor is a radicand of an extension
splitting completely off the part of the prescription carried by a global unit** and whose second
factor has its class on the line of the prescription.  At such a place the decomposition group is
trivial, so the radicand is already a power in the completion and its local class there is
trivial. -/
theorem prescriptionChar_eq_one_of_pow_mul_zpowers (hn : n.Prime) (hn2 : n ≠ 2)
    (hres : ∀ v : HeightOneSpectrum (𝓞 K), HasResidueChar (v.adicCompletion K) (P v) (E v))
    {ζ : K} (hζ : IsPrimitiveRoot ζ n) {T Tn : Finset (HeightOneSpectrum (𝓞 K))} (hT : T ⊆ Tn)
    (hnTn : ∀ v : HeightOneSpectrum (𝓞 K), FinitePlace.mk v ((n : ℕ) : K) ≠ 1 → v ∈ Tn)
    {c : (v : HeightOneSpectrum (𝓞 K)) → localClasses v n} {g : Kˣ}
    (hg : g ∈ sUnits K (Tn : Set (HeightOneSpectrum (𝓞 K))))
    (hc : ∀ v ∈ T, c v = localClassHom v n g) (hcT : ∀ v ∈ Tn, v ∉ T → c v = 1)
    (hsplit : ∀ v ∈ Tn, v ∉ T → ∃ w : HeightOneSpectrum (𝓞 M),
      primeUnder (𝓞 K) w = v ∧ stabilizer Gal(M/K) w = ⊥)
    {u u₁ u₂ : Kˣ} (hu : u = u₁ * u₂) {b : M} (hb : algebraMap K M (u₁ : K) = b ^ n)
    (h1out : ∀ v ∉ Tn, (n : ℤ) ∣ placeValue v u₁)
    (h2 : ∀ v ∈ T, ∃ d : localClasses v n,
      localClassHom v n u₂ ∈ Subgroup.zpowers d ∧ c v ∈ Subgroup.zpowers d) :
    prescriptionChar hres hζ Tn c u = 1 := by
  refine prescriptionChar_eq_one_of_mul_zpowers hn hn2 hres hζ hT hnTn hg hc hcT hu
    (fun v hv hv0 => ?_) h1out h2
  obtain ⟨w, rfl, hw⟩ := hsplit v hv hv0
  exact localClassHom_eq_one_of_stabilizer_eq_bot (NeZero.ne n) hζ hw hb

end Radicand

/-! ### The two factors as radicands of two extensions -/

section Factor

variable {K M₁ M₂ : Type} [Field K] [NumberField K] [Field M₁] [NumberField M₁] [Algebra K M₁]
  [IsGalois K M₁] [Field M₂] [NumberField M₂] [Algebra K M₂] {n : ℕ} [NeZero n]
  {P E : HeightOneSpectrum (𝓞 K) → ℕ}

omit [NumberField M₂] in
/-- **The prescription character kills a product of a radicand of one extension and a radicand of
another**, when the first extension splits completely where the prescription is not carried by a
global unit and is unramified outside the prescribed set, and every radicand of the second has its
class on the line of the prescription where the prescription is carried. -/
theorem prescriptionChar_eq_one_of_factor_zpowers (hn : n.Prime) (hn2 : n ≠ 2)
    (hres : ∀ v : HeightOneSpectrum (𝓞 K), HasResidueChar (v.adicCompletion K) (P v) (E v))
    {ζ : K} (hζ : IsPrimitiveRoot ζ n) {T Tn : Finset (HeightOneSpectrum (𝓞 K))} (hT : T ⊆ Tn)
    (hnTn : ∀ v : HeightOneSpectrum (𝓞 K), FinitePlace.mk v ((n : ℕ) : K) ≠ 1 → v ∈ Tn)
    {c : (v : HeightOneSpectrum (𝓞 K)) → localClasses v n} {g : Kˣ}
    (hg : g ∈ sUnits K (Tn : Set (HeightOneSpectrum (𝓞 K))))
    (hc : ∀ v ∈ T, c v = localClassHom v n g) (hcT : ∀ v ∈ Tn, v ∉ T → c v = 1)
    (hsplit : ∀ v ∈ Tn, v ∉ T → ∃ w : HeightOneSpectrum (𝓞 M₁),
      primeUnder (𝓞 K) w = v ∧ stabilizer Gal(M₁/K) w = ⊥)
    (hram₁ : ∀ v ∉ Tn, ∃ w : HeightOneSpectrum (𝓞 M₁),
      primeUnder (𝓞 K) w = v ∧ ramIdx (𝓞 K) w = 1)
    (hcyc₂ : ∀ v ∈ T, ∃ d : localClasses v n, c v ∈ Subgroup.zpowers d ∧
      ∀ w : Kˣ, (∃ y : M₂, algebraMap K M₂ (w : K) = y ^ n) →
        localClassHom v n w ∈ Subgroup.zpowers d)
    {u u₁ u₂ : Kˣ} (hu : u = u₁ * u₂) {y₁ : M₁} (hy₁ : algebraMap K M₁ (u₁ : K) = y₁ ^ n)
    {y₂ : M₂} (hy₂ : algebraMap K M₂ (u₂ : K) = y₂ ^ n) :
    prescriptionChar hres hζ Tn c u = 1 := by
  refine prescriptionChar_eq_one_of_pow_mul_zpowers hn hn2 hres hζ hT hnTn hg hc hcT hsplit
    hu hy₁ (fun v hv => ?_) (fun v hv => ?_)
  · obtain ⟨w, rfl, hw⟩ := hram₁ v hv
    exact dvd_placeValue_of_pow_eq_of_ramIdx_eq_one hn.ne_zero w hw hy₁
  · obtain ⟨d, hcd, hwd⟩ := hcyc₂ v hv
    exact ⟨d, hwd u₂ ⟨y₂, hy₂⟩, hcd⟩

end Factor

/-! ### A radicand of a compositum -/

section Compositum

variable {K M₁ M₂ L : Type} [Field K] [NumberField K] [Field M₁] [NumberField M₁] [Algebra K M₁]
  [IsGalois K M₁] [Field M₂] [NumberField M₂] [Algebra K M₂] [Normal K M₂] [Field L]
  [NumberField L] [Algebra K L] [IsGalois K L] [Algebra M₁ L] [IsScalarTower K M₁ L]
  [Algebra M₂ L] [IsScalarTower K M₂ L] {n : ℕ} [NeZero n]
  {P E : HeightOneSpectrum (𝓞 K) → ℕ}

omit [NumberField M₂] in
/-- **The prescription character kills every radicand of a compositum of two extensions**, the
first splitting completely where the prescription is not carried by a global unit and unramified
outside the prescribed set, the second with abelian Galois group of exponent the exponent and every
radicand of it carrying, at a prescribed place, a class on the line of the prescribed class.  The
radicand factors as a radicand of the first extension times a radicand of the second, and each
factor is then killed for its own reason; nothing is asked about the ramification of the
prescription. -/
theorem prescriptionChar_eq_one_of_pow_sup_zpowers (hn : n.Prime) (hn2 : n ≠ 2)
    (hres : ∀ v : HeightOneSpectrum (𝓞 K), HasResidueChar (v.adicCompletion K) (P v) (E v))
    {ζ : K} (hζ : IsPrimitiveRoot ζ n) {T Tn : Finset (HeightOneSpectrum (𝓞 K))} (hT : T ⊆ Tn)
    (hnTn : ∀ v : HeightOneSpectrum (𝓞 K), FinitePlace.mk v ((n : ℕ) : K) ≠ 1 → v ∈ Tn)
    {c : (v : HeightOneSpectrum (𝓞 K)) → localClasses v n} {g : Kˣ}
    (hg : g ∈ sUnits K (Tn : Set (HeightOneSpectrum (𝓞 K))))
    (hc : ∀ v ∈ T, c v = localClassHom v n g) (hcT : ∀ v ∈ Tn, v ∉ T → c v = 1)
    (hsup : (IsScalarTower.toAlgHom K M₁ L).fieldRange ⊔
      (IsScalarTower.toAlgHom K M₂ L).fieldRange = ⊤)
    (hcomm : ∀ σ τ : M₂ ≃ₐ[K] M₂, σ * τ = τ * σ) (hexp : ∀ σ : M₂ ≃ₐ[K] M₂, σ ^ n = 1)
    (hsplit : ∀ v ∈ Tn, v ∉ T → ∃ w : HeightOneSpectrum (𝓞 M₁),
      primeUnder (𝓞 K) w = v ∧ stabilizer Gal(M₁/K) w = ⊥)
    (hram₁ : ∀ v ∉ Tn, ∃ w : HeightOneSpectrum (𝓞 M₁),
      primeUnder (𝓞 K) w = v ∧ ramIdx (𝓞 K) w = 1)
    (hcyc₂ : ∀ v ∈ T, ∃ d : localClasses v n, c v ∈ Subgroup.zpowers d ∧
      ∀ w : Kˣ, (∃ y : M₂, algebraMap K M₂ (w : K) = y ^ n) →
        localClassHom v n w ∈ Subgroup.zpowers d)
    {u : Kˣ} {b : L} (hb : algebraMap K L (u : K) = b ^ n) :
    prescriptionChar hres hζ Tn c u = 1 := by
  classical
  have φ₁ : M₁ ≃ₐ[K] ↥(IsScalarTower.toAlgHom K M₁ L).fieldRange :=
    AlgEquiv.ofInjectiveField (IsScalarTower.toAlgHom K M₁ L)
  have φ₂ : M₂ ≃ₐ[K] ↥(IsScalarTower.toAlgHom K M₂ L).fieldRange :=
    AlgEquiv.ofInjectiveField (IsScalarTower.toAlgHom K M₂ L)
  haveI : Normal K ↥(IsScalarTower.toAlgHom K M₁ L).fieldRange := Normal.of_algEquiv φ₁
  haveI : Normal K ↥(IsScalarTower.toAlgHom K M₂ L).fieldRange := Normal.of_algEquiv φ₂
  have e₂ := AlgEquiv.autCongr φ₂
  obtain ⟨b₁, b₂, hmul, ⟨x₁, hx₁, hx₁pow⟩, ⟨x₂, hx₂, hx₂pow⟩⟩ :=
    exists_mul_eq_pow_of_pow_mem_sup hn hζ hsup
      (fun σ τ => by simpa using congrArg e₂ (hcomm (e₂.symm σ) (e₂.symm τ)))
      (fun σ => by simpa using congrArg e₂ (hexp (e₂.symm σ)))
      (b := ((u : Kˣ) : K)) u.ne_zero hb.symm
  have hb₁ : b₁ ≠ 0 := by
    intro h
    rw [h, zero_mul] at hmul
    exact u.ne_zero hmul
  have hb₂ : b₂ ≠ 0 := by
    intro h
    rw [h, mul_zero] at hmul
    exact u.ne_zero hmul
  obtain ⟨y₁, hy₁⟩ := AlgHom.mem_fieldRange.1 hx₁
  obtain ⟨y₂, hy₂⟩ := AlgHom.mem_fieldRange.1 hx₂
  have hy₁' : algebraMap M₁ L y₁ = x₁ := hy₁
  have hy₂' : algebraMap M₂ L y₂ = x₂ := hy₂
  refine prescriptionChar_eq_one_of_factor_zpowers hn hn2 hres hζ hT hnTn hg hc hcT hsplit
    hram₁ hcyc₂ (u₁ := Units.mk0 b₁ hb₁) (u₂ := Units.mk0 b₂ hb₂) (by ext; simpa using hmul)
    (y₁ := y₁) ?_ (y₂ := y₂) ?_
  · refine (algebraMap M₁ L).injective ?_
    rw [← IsScalarTower.algebraMap_apply, _root_.map_pow, hy₁', hx₁pow, Units.val_mk0]
  · refine (algebraMap M₂ L).injective ?_
    rw [← IsScalarTower.algebraMap_apply, _root_.map_pow, hy₂', hx₂pow, Units.val_mk0]

end Compositum

/-! ### The first factor a local power at every prescribed place -/

section Everywhere

variable {K : Type} [Field K] [NumberField K] {n : ℕ} [NeZero n]
  {P E : HeightOneSpectrum (𝓞 K) → ℕ}

/-- **The prescription character kills a unit which is a local power at every prescribed place.**
Each factor of the product is then a pairing against the trivial class. -/
theorem prescriptionChar_eq_one_of_forall_localClassHom_eq_one
    (hres : ∀ v : HeightOneSpectrum (𝓞 K), HasResidueChar (v.adicCompletion K) (P v) (E v))
    {ζ : K} (hζ : IsPrimitiveRoot ζ n) {Tn : Finset (HeightOneSpectrum (𝓞 K))}
    (c : (v : HeightOneSpectrum (𝓞 K)) → localClasses v n) {u : Kˣ}
    (hu : ∀ v ∈ Tn, localClassHom v n u = 1) :
    prescriptionChar hres hζ Tn c u = 1 := by
  rw [prescriptionChar_apply]
  refine Finset.prod_eq_one fun v hv => ?_
  rw [hu v hv, _root_.map_one, MonoidHom.one_apply]

/-- **The prescription character kills a product of a unit which is a local power at every
prescribed place and a unit whose class lies on the line of the prescription.**  Neither half asks
anything about the ramification of the prescription, nor about a global unit carrying it. -/
theorem prescriptionChar_eq_one_of_mul_split (hn : n.Prime) (hn2 : n ≠ 2)
    (hres : ∀ v : HeightOneSpectrum (𝓞 K), HasResidueChar (v.adicCompletion K) (P v) (E v))
    {ζ : K} (hζ : IsPrimitiveRoot ζ n) {T Tn : Finset (HeightOneSpectrum (𝓞 K))}
    {c : (v : HeightOneSpectrum (𝓞 K)) → localClasses v n}
    (hcT : ∀ v ∈ Tn, v ∉ T → c v = 1) {u u₁ u₂ : Kˣ} (hu : u = u₁ * u₂)
    (h1 : ∀ v ∈ Tn, localClassHom v n u₁ = 1)
    (h2 : ∀ v ∈ T, ∃ d : localClasses v n,
      localClassHom v n u₂ ∈ Subgroup.zpowers d ∧ c v ∈ Subgroup.zpowers d) :
    prescriptionChar hres hζ Tn c u = 1 := by
  rw [hu, _root_.map_mul, prescriptionChar_eq_one_of_forall_localClassHom_eq_one hres hζ c h1,
    prescriptionChar_eq_one_of_mem_zpowers hres hζ (hn.odd_of_ne_two hn2) hcT h2, one_mul]

end Everywhere

/-! ### The first factor a radicand of an extension split at every prescribed place -/

section RadicandSplit

variable {K M : Type} [Field K] [NumberField K] [Field M] [NumberField M] [Algebra K M]
  [IsGalois K M] {n : ℕ} [NeZero n] {P E : HeightOneSpectrum (𝓞 K) → ℕ}

/-- **The prescription character kills a product whose first factor is a radicand of an extension
splitting completely at every prescribed place** and whose second factor has its class on the line
of the prescription.  At such a place the decomposition group is trivial, so the radicand is already
a power in the completion. -/
theorem prescriptionChar_eq_one_of_pow_mul_split (hn : n.Prime) (hn2 : n ≠ 2)
    (hres : ∀ v : HeightOneSpectrum (𝓞 K), HasResidueChar (v.adicCompletion K) (P v) (E v))
    {ζ : K} (hζ : IsPrimitiveRoot ζ n) {T Tn : Finset (HeightOneSpectrum (𝓞 K))}
    {c : (v : HeightOneSpectrum (𝓞 K)) → localClasses v n}
    (hcT : ∀ v ∈ Tn, v ∉ T → c v = 1)
    (hsplit : ∀ v ∈ Tn, ∃ w : HeightOneSpectrum (𝓞 M),
      primeUnder (𝓞 K) w = v ∧ stabilizer Gal(M/K) w = ⊥)
    {u u₁ u₂ : Kˣ} (hu : u = u₁ * u₂) {b : M} (hb : algebraMap K M (u₁ : K) = b ^ n)
    (h2 : ∀ v ∈ T, ∃ d : localClasses v n,
      localClassHom v n u₂ ∈ Subgroup.zpowers d ∧ c v ∈ Subgroup.zpowers d) :
    prescriptionChar hres hζ Tn c u = 1 := by
  refine prescriptionChar_eq_one_of_mul_split hn hn2 hres hζ hcT hu (fun v hv => ?_) h2
  obtain ⟨w, rfl, hw⟩ := hsplit v hv
  exact localClassHom_eq_one_of_stabilizer_eq_bot (NeZero.ne n) hζ hw hb

end RadicandSplit

/-! ### The two factors as radicands, the first split at every prescribed place -/

section FactorSplit

variable {K M₁ M₂ : Type} [Field K] [NumberField K] [Field M₁] [NumberField M₁] [Algebra K M₁]
  [IsGalois K M₁] [Field M₂] [NumberField M₂] [Algebra K M₂] {n : ℕ} [NeZero n]
  {P E : HeightOneSpectrum (𝓞 K) → ℕ}

omit [NumberField M₂] in
/-- **The prescription character kills a product of a radicand of one extension and a radicand of
another**, when the first extension splits completely at every prescribed place and every radicand
of the second has its class on the line of the prescription where the prescription is carried. -/
theorem prescriptionChar_eq_one_of_factor_split (hn : n.Prime) (hn2 : n ≠ 2)
    (hres : ∀ v : HeightOneSpectrum (𝓞 K), HasResidueChar (v.adicCompletion K) (P v) (E v))
    {ζ : K} (hζ : IsPrimitiveRoot ζ n) {T Tn : Finset (HeightOneSpectrum (𝓞 K))}
    {c : (v : HeightOneSpectrum (𝓞 K)) → localClasses v n}
    (hcT : ∀ v ∈ Tn, v ∉ T → c v = 1)
    (hsplit : ∀ v ∈ Tn, ∃ w : HeightOneSpectrum (𝓞 M₁),
      primeUnder (𝓞 K) w = v ∧ stabilizer Gal(M₁/K) w = ⊥)
    (hcyc₂ : ∀ v ∈ T, ∃ d : localClasses v n, c v ∈ Subgroup.zpowers d ∧
      ∀ w : Kˣ, (∃ y : M₂, algebraMap K M₂ (w : K) = y ^ n) →
        localClassHom v n w ∈ Subgroup.zpowers d)
    {u u₁ u₂ : Kˣ} (hu : u = u₁ * u₂) {y₁ : M₁} (hy₁ : algebraMap K M₁ (u₁ : K) = y₁ ^ n)
    {y₂ : M₂} (hy₂ : algebraMap K M₂ (u₂ : K) = y₂ ^ n) :
    prescriptionChar hres hζ Tn c u = 1 := by
  refine prescriptionChar_eq_one_of_pow_mul_split hn hn2 hres hζ hcT hsplit hu hy₁ fun v hv => ?_
  obtain ⟨d, hcd, hwd⟩ := hcyc₂ v hv
  exact ⟨d, hwd u₂ ⟨y₂, hy₂⟩, hcd⟩

end FactorSplit

/-! ### A radicand of a compositum, the first factor split at every prescribed place -/

section CompositumSplit

variable {K M₁ M₂ L : Type} [Field K] [NumberField K] [Field M₁] [NumberField M₁] [Algebra K M₁]
  [IsGalois K M₁] [Field M₂] [NumberField M₂] [Algebra K M₂] [Normal K M₂] [Field L]
  [NumberField L] [Algebra K L] [IsGalois K L] [Algebra M₁ L] [IsScalarTower K M₁ L]
  [Algebra M₂ L] [IsScalarTower K M₂ L] {n : ℕ} [NeZero n]
  {P E : HeightOneSpectrum (𝓞 K) → ℕ}

omit [NumberField M₂] in
/-- **The prescription character kills every radicand of a compositum of two extensions**, the
first splitting completely at every prescribed place, the second with abelian Galois group of
exponent the exponent and every radicand of it carrying, at a place where the prescription is
carried, a class on the line of the prescribed class.  The radicand factors as a radicand of the
first extension times a radicand of the second, and each factor is then killed for its own reason;
no global unit is involved and nothing is asked about ramification. -/
theorem prescriptionChar_eq_one_of_pow_sup_split (hn : n.Prime) (hn2 : n ≠ 2)
    (hres : ∀ v : HeightOneSpectrum (𝓞 K), HasResidueChar (v.adicCompletion K) (P v) (E v))
    {ζ : K} (hζ : IsPrimitiveRoot ζ n) {T Tn : Finset (HeightOneSpectrum (𝓞 K))}
    {c : (v : HeightOneSpectrum (𝓞 K)) → localClasses v n}
    (hcT : ∀ v ∈ Tn, v ∉ T → c v = 1)
    (hsup : (IsScalarTower.toAlgHom K M₁ L).fieldRange ⊔
      (IsScalarTower.toAlgHom K M₂ L).fieldRange = ⊤)
    (hcomm : ∀ σ τ : M₂ ≃ₐ[K] M₂, σ * τ = τ * σ) (hexp : ∀ σ : M₂ ≃ₐ[K] M₂, σ ^ n = 1)
    (hsplit : ∀ v ∈ Tn, ∃ w : HeightOneSpectrum (𝓞 M₁),
      primeUnder (𝓞 K) w = v ∧ stabilizer Gal(M₁/K) w = ⊥)
    (hcyc₂ : ∀ v ∈ T, ∃ d : localClasses v n, c v ∈ Subgroup.zpowers d ∧
      ∀ w : Kˣ, (∃ y : M₂, algebraMap K M₂ (w : K) = y ^ n) →
        localClassHom v n w ∈ Subgroup.zpowers d)
    {u : Kˣ} {b : L} (hb : algebraMap K L (u : K) = b ^ n) :
    prescriptionChar hres hζ Tn c u = 1 := by
  classical
  have φ₁ : M₁ ≃ₐ[K] ↥(IsScalarTower.toAlgHom K M₁ L).fieldRange :=
    AlgEquiv.ofInjectiveField (IsScalarTower.toAlgHom K M₁ L)
  have φ₂ : M₂ ≃ₐ[K] ↥(IsScalarTower.toAlgHom K M₂ L).fieldRange :=
    AlgEquiv.ofInjectiveField (IsScalarTower.toAlgHom K M₂ L)
  haveI : Normal K ↥(IsScalarTower.toAlgHom K M₁ L).fieldRange := Normal.of_algEquiv φ₁
  haveI : Normal K ↥(IsScalarTower.toAlgHom K M₂ L).fieldRange := Normal.of_algEquiv φ₂
  have e₂ := AlgEquiv.autCongr φ₂
  obtain ⟨b₁, b₂, hmul, ⟨x₁, hx₁, hx₁pow⟩, ⟨x₂, hx₂, hx₂pow⟩⟩ :=
    exists_mul_eq_pow_of_pow_mem_sup hn hζ hsup
      (fun σ τ => by simpa using congrArg e₂ (hcomm (e₂.symm σ) (e₂.symm τ)))
      (fun σ => by simpa using congrArg e₂ (hexp (e₂.symm σ)))
      (b := ((u : Kˣ) : K)) u.ne_zero hb.symm
  have hb₁ : b₁ ≠ 0 := by
    intro h
    rw [h, zero_mul] at hmul
    exact u.ne_zero hmul
  have hb₂ : b₂ ≠ 0 := by
    intro h
    rw [h, mul_zero] at hmul
    exact u.ne_zero hmul
  obtain ⟨y₁, hy₁⟩ := AlgHom.mem_fieldRange.1 hx₁
  obtain ⟨y₂, hy₂⟩ := AlgHom.mem_fieldRange.1 hx₂
  have hy₁' : algebraMap M₁ L y₁ = x₁ := hy₁
  have hy₂' : algebraMap M₂ L y₂ = x₂ := hy₂
  refine prescriptionChar_eq_one_of_factor_split hn hn2 hres hζ hcT hsplit hcyc₂
    (u₁ := Units.mk0 b₁ hb₁) (u₂ := Units.mk0 b₂ hb₂) (by ext; simpa using hmul)
    (y₁ := y₁) ?_ (y₂ := y₂) ?_
  · refine (algebraMap M₁ L).injective ?_
    rw [← IsScalarTower.algebraMap_apply, _root_.map_pow, hy₁', hx₁pow, Units.val_mk0]
  · refine (algebraMap M₂ L).injective ?_
    rw [← IsScalarTower.algebraMap_apply, _root_.map_pow, hy₂', hx₂pow, Units.val_mk0]

end CompositumSplit

end InverseGalois.CFT
