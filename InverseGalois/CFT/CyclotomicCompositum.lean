import Mathlib
import InverseGalois.CFT.Compositum

/-!
# The compositum of a number field with a cyclotomic field

Fix an algebraic closure `Ω = AlgebraicClosure ℚ`. Given a number field `L` and a natural
number `n ≠ 0` we place two subfields of `Ω` side by side:

* `cycSubfield n`, generated by a chosen primitive `n`-th root of unity of `Ω`;
* `embSubfield L`, the image of a chosen `ℚ`-algebra embedding `L →ₐ[ℚ] Ω`;

and we study their compositum `cycCompositum L n = embSubfield L ⊔ cycSubfield n`.

Inside the compositum the two factors reappear as intermediate fields `innerL L n` and
`innerCyc L n`, which together generate the compositum. Comparing the degree of the compositum
with `Nat.totient n` in both directions pins down when `L` embeds into a cyclotomic field: this
is the field-theoretic half of the compositum step in the Kronecker–Weber theorem.

## Main definitions

* `InverseGalois.CFT.cycSubfield`: the `n`-th cyclotomic subfield of `AlgebraicClosure ℚ`.
* `InverseGalois.CFT.embSubfield`: a copy of `L` inside `AlgebraicClosure ℚ`.
* `InverseGalois.CFT.cycCompositum`: the compositum of the two.
* `InverseGalois.CFT.innerL`, `InverseGalois.CFT.innerCyc`: the two factors seen as intermediate
  fields of the compositum.

## Main results

* `InverseGalois.CFT.finrank_cycSubfield`: `[cycSubfield n : ℚ] = Nat.totient n`.
* `InverseGalois.CFT.innerL_sup_innerCyc`: `innerL L n ⊔ innerCyc L n = ⊤`.
* `InverseGalois.CFT.totient_le_finrank_cycCompositum`:
  `Nat.totient n ≤ [cycCompositum L n : ℚ]`.
* `InverseGalois.CFT.nonempty_algHom_cyclotomicField_of_finrank_le`: if the degree of the
  compositum is at most `Nat.totient n`, then `L` embeds into `CyclotomicField n ℚ`.

-/

namespace InverseGalois.CFT

open Module IntermediateField

variable (L : Type*) [Field L] [NumberField L] (n : ℕ) [NeZero n]

/-! ### The cyclotomic subfield of an algebraic closure of `ℚ` -/

/-- An algebraic closure of `ℚ` contains a primitive `n`-th root of unity for every `n ≠ 0`. -/
theorem exists_isPrimitiveRoot_algebraicClosure :
    ∃ ζ : AlgebraicClosure ℚ, IsPrimitiveRoot ζ n := by
  haveI : NeZero ((n : ℕ) : ℚ) := ⟨Nat.cast_ne_zero.2 (NeZero.ne n)⟩
  exact HasEnoughRootsOfUnity.exists_primitiveRoot _ n

/-- A chosen primitive `n`-th root of unity in `AlgebraicClosure ℚ`. -/
noncomputable def cycRoot : AlgebraicClosure ℚ :=
  (exists_isPrimitiveRoot_algebraicClosure n).choose

/-- The chosen element `cycRoot n` is indeed a primitive `n`-th root of unity. -/
theorem cycRoot_spec : IsPrimitiveRoot (cycRoot n) n :=
  (exists_isPrimitiveRoot_algebraicClosure n).choose_spec

/-- The `n`-th cyclotomic subfield of `AlgebraicClosure ℚ`, generated by `cycRoot n`. -/
noncomputable def cycSubfield : IntermediateField ℚ (AlgebraicClosure ℚ) :=
  IntermediateField.adjoin ℚ {cycRoot n}

/-- `cycSubfield n` is an `n`-th cyclotomic extension of `ℚ`. -/
instance isCyclotomicExtension_cycSubfield :
    IsCyclotomicExtension {n} ℚ ↥(cycSubfield n) :=
  (cycRoot_spec n).intermediateField_adjoin_isCyclotomicExtension ℚ

/-- The cyclotomic subfield is a finite extension of `ℚ`. -/
instance finiteDimensional_cycSubfield : FiniteDimensional ℚ ↥(cycSubfield n) :=
  IsCyclotomicExtension.finiteDimensional {n} ℚ _

/-- The cyclotomic subfield is a number field. -/
instance numberField_cycSubfield : NumberField ↥(cycSubfield n) := ⟨⟩

/-- The cyclotomic subfield is Galois over `ℚ`. -/
instance isGalois_cycSubfield : IsGalois ℚ ↥(cycSubfield n) :=
  IsCyclotomicExtension.isGalois {n} ℚ _

/-- The degree of the `n`-th cyclotomic subfield over `ℚ` is `Nat.totient n`. -/
theorem finrank_cycSubfield : Module.finrank ℚ ↥(cycSubfield n) = Nat.totient n :=
  IsCyclotomicExtension.Rat.finrank n _

/-! ### A copy of the number field inside the algebraic closure -/

/-- A chosen `ℚ`-algebra embedding of the number field `L` into `AlgebraicClosure ℚ`. -/
noncomputable def embHom : L →ₐ[ℚ] AlgebraicClosure ℚ := IsAlgClosed.lift

/-- The image of `L` in `AlgebraicClosure ℚ` under the chosen embedding `embHom L`. -/
noncomputable def embSubfield : IntermediateField ℚ (AlgebraicClosure ℚ) :=
  (embHom L).fieldRange

/-- The chosen embedding identifies `L` with the subfield `embSubfield L`. -/
noncomputable def embEquiv : L ≃ₐ[ℚ] ↥(embSubfield L) :=
  AlgEquiv.ofInjectiveField (embHom L)

/-- The copy of `L` inside the algebraic closure is a finite extension of `ℚ`. -/
instance finiteDimensional_embSubfield : FiniteDimensional ℚ ↥(embSubfield L) :=
  LinearEquiv.finiteDimensional (embEquiv L).toLinearEquiv

/-- The copy of `L` inside the algebraic closure is a number field. -/
instance numberField_embSubfield : NumberField ↥(embSubfield L) := ⟨⟩

/-- If `L` is Galois over `ℚ`, then so is its copy inside the algebraic closure. -/
instance isGalois_embSubfield [IsGalois ℚ L] : IsGalois ℚ ↥(embSubfield L) :=
  IsGalois.of_algEquiv (embEquiv L)

/-! ### The compositum -/

/-- The compositum, inside `AlgebraicClosure ℚ`, of the copy of `L` and the `n`-th cyclotomic
subfield. -/
noncomputable def cycCompositum : IntermediateField ℚ (AlgebraicClosure ℚ) :=
  embSubfield L ⊔ cycSubfield n

/-- The compositum is a finite extension of `ℚ`. -/
instance finiteDimensional_cycCompositum : FiniteDimensional ℚ ↥(cycCompositum L n) := by
  unfold cycCompositum
  infer_instance

/-- The compositum is a number field. -/
instance numberField_cycCompositum : NumberField ↥(cycCompositum L n) := ⟨⟩

/-- The compositum of a Galois number field with a cyclotomic field is Galois over `ℚ`. -/
instance isGalois_cycCompositum [IsGalois ℚ L] : IsGalois ℚ ↥(cycCompositum L n) := by
  unfold cycCompositum
  infer_instance

/-! ### The two factors seen inside the compositum -/

/-- The copy of `L`, viewed as an intermediate field of the compositum. -/
noncomputable def innerL : IntermediateField ℚ ↥(cycCompositum L n) :=
  IntermediateField.restrict (le_sup_left : embSubfield L ≤ cycCompositum L n)

/-- The cyclotomic subfield, viewed as an intermediate field of the compositum. -/
noncomputable def innerCyc : IntermediateField ℚ ↥(cycCompositum L n) :=
  IntermediateField.restrict (le_sup_right : cycSubfield n ≤ cycCompositum L n)

/-- The two factors generate the compositum. -/
theorem innerL_sup_innerCyc : innerL L n ⊔ innerCyc L n = ⊤ :=
  restrict_sup_restrict (embSubfield L) (cycSubfield n)

/-- The inner copy of `L` is `ℚ`-isomorphic to `embSubfield L`. -/
noncomputable def innerLEquiv : ↥(innerL L n) ≃ₐ[ℚ] ↥(embSubfield L) :=
  (IntermediateField.restrict_algEquiv _).symm

/-- The inner copy of the cyclotomic subfield is `ℚ`-isomorphic to `cycSubfield n`. -/
noncomputable def innerCycEquiv : ↥(innerCyc L n) ≃ₐ[ℚ] ↥(cycSubfield n) :=
  (IntermediateField.restrict_algEquiv _).symm

/-- If `L` is Galois over `ℚ`, its inner copy inside the compositum is normal over `ℚ`. -/
instance normal_innerL [IsGalois ℚ L] : Normal ℚ ↥(innerL L n) :=
  Normal.of_algEquiv (IntermediateField.restrict_algEquiv _)

/-- The inner copy of the cyclotomic subfield is normal over `ℚ`. -/
instance normal_innerCyc : Normal ℚ ↥(innerCyc L n) :=
  Normal.of_algEquiv (IntermediateField.restrict_algEquiv _)

/-! ### Degree comparisons -/

/-- The compositum has degree at least `Nat.totient n`, since it contains the `n`-th cyclotomic
subfield. -/
theorem totient_le_finrank_cycCompositum :
    Nat.totient n ≤ Module.finrank ℚ ↥(cycCompositum L n) := by
  rw [← finrank_cycSubfield n]
  have hinj : Function.Injective ⇑(IntermediateField.inclusion
      (le_sup_right : cycSubfield n ≤ cycCompositum L n)).toLinearMap :=
    fun a b hab => (IntermediateField.inclusion
      (le_sup_right : cycSubfield n ≤ cycCompositum L n)).toRingHom.injective hab
  exact LinearMap.finrank_le_finrank_of_injective hinj

/-- If the compositum of `L` with the `n`-th cyclotomic field has degree at most `Nat.totient n`,
then `L` admits a `ℚ`-algebra embedding into `CyclotomicField n ℚ`. -/
theorem nonempty_algHom_cyclotomicField_of_finrank_le
    (h : Module.finrank ℚ ↥(cycCompositum L n) ≤ Nat.totient n) :
    Nonempty (L →ₐ[ℚ] CyclotomicField n ℚ) := by
  have heq : cycSubfield n = cycCompositum L n :=
    IntermediateField.eq_of_le_of_finrank_le le_sup_right
      (by rw [finrank_cycSubfield]; exact h)
  have hL : embSubfield L ≤ cycSubfield n := heq ▸ le_sup_left
  exact ⟨(IsCyclotomicExtension.algEquiv {n} ℚ ↥(cycSubfield n)
    (CyclotomicField n ℚ)).toAlgHom.comp
      ((IntermediateField.inclusion hL).comp (embEquiv L).toAlgHom)⟩

end InverseGalois.CFT
