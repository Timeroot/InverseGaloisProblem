import Mathlib
import InverseGalois.CFT.TateCohomology.Cyclic

/-!
# Vanishing of the complete cohomology of a cyclic group, from the two middle degrees

The two middle degrees of complete cohomology are elementary: degree zero is the invariants modulo
the norms, and degree minus one is the classes in the coinvariants killed by the norm.  A vanishing
statement in either of them is therefore an entirely concrete assertion about the module — that
every invariant vector is a norm, and that every vector killed by the norm is a difference of a
vector and one of its translates.  For a group generated by a single element the norm is the sum of
the powers of the generator below its order, so both assertions are the ones the arithmetic of a
cyclic extension actually produces.

Periodicity carries them everywhere.  The complete cohomology of a finite cyclic group in a degree
is its complete cohomology two degrees lower, so a degree without cohomology has none two degrees
higher and none two degrees lower; starting from the two adjacent middle degrees, an induction over
the integers in both directions reaches every degree.  A cyclic group whose module has all its
invariants norms and all its norm-zero vectors differences therefore has no complete cohomology at
all.

## Main results

* `InverseGalois.CFT.Tate.normMap_eq_sum_range`: **for a group generated by a single element the
  norm is the sum of the powers of the generator below its order.**
* `InverseGalois.CFT.Tate.isZero_tateModule_zero_of_forall_exists_normMap`: **the complete
  cohomology in degree zero vanishes when every invariant vector is a norm.**
* `InverseGalois.CFT.Tate.isZero_tateModule_neg_one_of_forall_exists_sub`: **the complete cohomology
  in degree minus one vanishes when every vector killed by the norm is the difference of a vector
  and its translate by a generator.**
* `InverseGalois.CFT.Tate.isZero_tateModule_of_add_two`: **a representation of a finite cyclic group
  without complete cohomology in a degree has none two degrees lower.**
* `InverseGalois.CFT.Tate.isZero_tateModule_of_isZero_zero_neg_one`: **a representation of a finite
  cyclic group without complete cohomology in the two middle degrees has none in any degree.**
* `InverseGalois.CFT.Tate.isZero_tateModule_of_forall_mem_zpowers`: the same conclusion phrased
  entirely in terms of a generator of the group.

## Tags

Tate cohomology, cyclic group, periodicity, norm map, invariants, coinvariants
-/

namespace InverseGalois.CFT.Tate

open CategoryTheory Representation

universe u

noncomputable section

/-! ### The norm of a cyclic action -/

section NormRange

variable {k G V : Type*} [CommRing k] [Group G] [Finite G] [AddCommGroup V] [Module k V]
  (ρ : Representation k G V)

/-- **For a group generated by a single element the norm is the sum of the powers of the generator
below its order**: those powers run through the group exactly once. -/
theorem normMap_eq_sum_range {σ : G} (hgen : ∀ g : G, g ∈ Subgroup.zpowers σ) {d : ℕ}
    (hd : Nat.card G = d) (x : V) :
    normMap ρ x = ∑ i ∈ Finset.range d, ρ (σ ^ i) x := by
  letI := Fintype.ofFinite G
  have hord : orderOf σ = d := (orderOf_eq_card_of_forall_mem_zpowers hgen).trans hd
  have hlt : ∀ i : Fin d, (i : ℕ) ∈ Set.Iio (orderOf σ) := by
    intro i
    simp only [Set.mem_Iio, hord]
    exact i.isLt
  have hbij : Function.Bijective (fun i : Fin d => σ ^ (i : ℕ)) := by
    refine (Fintype.bijective_iff_injective_and_card _).mpr ⟨fun i j hij => ?_, ?_⟩
    · exact Fin.ext (pow_injOn_Iio_orderOf (hlt i) (hlt j) hij)
    · rw [Fintype.card_fin, ← Nat.card_eq_fintype_card, hd]
  rw [normMap_apply, ← Fin.sum_univ_eq_sum_range]
  exact (Fintype.sum_bijective _ hbij _ (fun g => ρ g x) fun _ => rfl).symm

end NormRange

/-! ### The two middle degrees -/

section Middle

variable {k G : Type u} [CommRing k] [Group G] [Finite G] (A : Rep k G)

/-- **The complete cohomology in degree zero vanishes when every invariant vector is a norm.** -/
theorem isZero_tateModule_zero_of_forall_exists_normMap
    (h : ∀ x : ↥A.V, x ∈ A.ρ.invariants → ∃ y, normMap A.ρ y = x) :
    Limits.IsZero (tateModule A 0) := by
  rw [tateModule_zero, ModuleCat.isZero_iff_subsingleton]
  refine ⟨fun a b => ?_⟩
  obtain ⟨x, rfl⟩ := H0mk_surjective A.ρ a
  obtain ⟨y, rfl⟩ := H0mk_surjective A.ρ b
  rw [← sub_eq_zero, ← map_sub]
  exact (H0mk_eq_zero_iff A.ρ _).2 (h _ (x - y).2)

/-- **The complete cohomology in degree minus one vanishes when every vector killed by the norm has
trivial class in the coinvariants.** -/
theorem isZero_tateModule_neg_one_of_forall_mk
    (h : ∀ x : ↥A.V, normMap A.ρ x = 0 → Coinvariants.mk A.ρ x = 0) :
    Limits.IsZero (tateModule A (-1)) := by
  rw [tateModule_neg_one, ModuleCat.isZero_iff_subsingleton]
  have key : ∀ a : Hm1 A.ρ, a = 0 := by
    intro a
    obtain ⟨v, hv, rfl⟩ := exists_Hm1mk A.ρ a
    refine Subtype.ext ?_
    rw [Hm1mk_coe, ZeroMemClass.coe_zero]
    exact h v hv
  exact ⟨fun a b => by rw [key a, key b]⟩

/-- **The complete cohomology in degree minus one vanishes when every vector killed by the norm is
the difference of a vector and its translate.** -/
theorem isZero_tateModule_neg_one_of_forall_exists_sub {σ : G}
    (h : ∀ x : ↥A.V, normMap A.ρ x = 0 → ∃ y, A.ρ σ y - y = x) :
    Limits.IsZero (tateModule A (-1)) := by
  refine isZero_tateModule_neg_one_of_forall_mk A fun x hx => ?_
  obtain ⟨y, rfl⟩ := h x hx
  rw [map_sub, Coinvariants.mk_self_apply, sub_self]

end Middle

/-! ### Propagation through all the degrees -/

section Propagate

variable {k G : Type u} [CommRing k] [Group G] [Finite G] (A : Rep k G)

/-- Complete cohomology in a degree only depends on the degree. -/
theorem isZero_tateModule_congr {m n : ℤ} (h : m = n)
    (hm : Limits.IsZero (tateModule A m)) : Limits.IsZero (tateModule A n) :=
  h ▸ hm

variable [IsCyclic G]

/-- **A representation of a finite cyclic group without complete cohomology in a degree has none
two degrees lower.** -/
theorem isZero_tateModule_of_add_two (n : ℤ) (h : Limits.IsZero (tateModule A (n + 1 + 1))) :
    Limits.IsZero (tateModule A n) :=
  Limits.IsZero.of_iso h (tateCyclicPeriod A n).symm.toModuleIso

/-- **A representation of a finite cyclic group without complete cohomology in the two middle
degrees has none in any degree.** -/
theorem isZero_tateModule_of_isZero_zero_neg_one (h0 : Limits.IsZero (tateModule A 0))
    (hm1 : Limits.IsZero (tateModule A (-1))) (n : ℤ) : Limits.IsZero (tateModule A n) := by
  have key : ∀ j : ℤ,
      Limits.IsZero (tateModule A j) ∧ Limits.IsZero (tateModule A (j + 1)) := by
    intro j
    induction j using Int.induction_on with
    | zero =>
      exact ⟨h0, isZero_tateModule_congr A (by ring)
        (isZero_tateModule_add_two A (-1) hm1)⟩
    | succ i ih => exact ⟨ih.2, isZero_tateModule_add_two A i ih.1⟩
    | pred i ih =>
      exact ⟨isZero_tateModule_of_add_two A (-(i : ℤ) - 1)
          (isZero_tateModule_congr A (by ring) ih.2),
        isZero_tateModule_congr A (by ring) ih.1⟩
  exact (key n).1

end Propagate

/-! ### The criterion in terms of a generator -/

section Generator

variable {k G : Type u} [CommRing k] [Group G] [Finite G] (A : Rep k G)

/-- **A representation of a group generated by a single element has no complete cohomology in any
degree at all** as soon as every invariant vector is a sum of the translates of a vector by the
powers of the generator below its order, and every vector whose translates by those powers sum to
zero is the difference of a vector and its translate by the generator.  Both hypotheses mention
only the generator, so a computation in a cyclic extension can be read into them directly. -/
theorem isZero_tateModule_of_forall_mem_zpowers {σ : G} (hgen : ∀ g : G, g ∈ Subgroup.zpowers σ)
    {d : ℕ} (hd : Nat.card G = d)
    (h0 : ∀ x : ↥A.V, (∀ g : G, A.ρ g x = x) → ∃ y, ∑ i ∈ Finset.range d, A.ρ (σ ^ i) y = x)
    (hm1 : ∀ x : ↥A.V, ∑ i ∈ Finset.range d, A.ρ (σ ^ i) x = 0 → ∃ y, A.ρ σ y - y = x)
    (n : ℤ) : Limits.IsZero (tateModule A n) := by
  haveI : IsCyclic G := ⟨σ, fun x => Subgroup.mem_zpowers_iff.mp (hgen x)⟩
  refine isZero_tateModule_of_isZero_zero_neg_one A ?_ ?_ n
  · refine isZero_tateModule_zero_of_forall_exists_normMap A fun x hx => ?_
    obtain ⟨y, hy⟩ := h0 x fun g => (Representation.mem_invariants _ _).1 hx g
    exact ⟨y, (normMap_eq_sum_range A.ρ hgen hd y).trans hy⟩
  · refine isZero_tateModule_neg_one_of_forall_exists_sub A (σ := σ) fun x hx => ?_
    exact hm1 x ((normMap_eq_sum_range A.ρ hgen hd x).symm.trans hx)

end Generator

end

end InverseGalois.CFT.Tate
