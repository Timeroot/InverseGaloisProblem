import Mathlib
import InverseGalois.CFT.TateCohomology.PTorsionTrivial

/-!
# The characters of a finite abelian group

A character of an abelian group is a homomorphism of it into the rational circle.  For a finite
group there are exactly as many characters as there are elements, and the group is recovered from
its characters: reading an element as the functional "evaluate at me" identifies a finite abelian
group with the characters of its characters.

The count is proved by reducing to a cyclic group, where the characters are the torsion of the
rational circle of the corresponding order, a cyclic group generated by the reciprocal of that
order.  The recovery then follows formally: evaluation is injective because a nonzero element is
detected by some character, and an injection between finite sets of the same size is a bijection.

## Main definitions

* `InverseGalois.CFT.Tate.circleGen`: the reciprocal of a natural number, read in the rational
  circle.
* `InverseGalois.CFT.Tate.evalDual`: **the evaluation of a module in the characters of its
  characters.**

## Main results

* `InverseGalois.CFT.Tate.card_characterModule`: **a finite abelian group has as many characters as
  elements.**
* `InverseGalois.CFT.Tate.bijective_evalDual`: **a finite abelian group is the characters of its
  characters.**

## Tags

character module, Pontryagin duality, rational circle, finite abelian group
-/

namespace InverseGalois.CFT.Tate

/-! ### The torsion of the rational circle -/

section RationalCircle

/-- The reciprocal of a natural number, read in the rational circle. -/
def circleGen (n : ℕ) : AddCircle (1 : ℚ) := (((n : ℚ)⁻¹ : ℚ) : AddCircle (1 : ℚ))

theorem addOrderOf_circleGen {n : ℕ} (hn : 0 < n) : addOrderOf (circleGen n) = n := by
  haveI : Fact ((0 : ℚ) < 1) := ⟨one_pos⟩
  simpa [circleGen, one_div] using AddCircle.addOrderOf_period_div (p := (1 : ℚ)) hn

theorem nsmul_circleGen {n : ℕ} (hn : 0 < n) : n • circleGen n = 0 := by
  have : (n : ℚ) ≠ 0 := Nat.cast_ne_zero.2 hn.ne'
  have h : n • ((n : ℚ)⁻¹ : ℚ) = (1 : ℚ) := by
    rw [nsmul_eq_mul, mul_inv_cancel₀ this]
  show ((n • ((n : ℚ)⁻¹ : ℚ) : ℚ) : AddCircle (1 : ℚ)) = 0
  rw [h]
  exact AddCircle.coe_period (1 : ℚ)

/-- **The torsion of the rational circle of an order is the multiples of the reciprocal of that
order.** -/
theorem nsmul_eq_zero_iff_mem_zmultiples {n : ℕ} (hn : 0 < n) (x : AddCircle (1 : ℚ)) :
    n • x = 0 ↔ x ∈ AddSubgroup.zmultiples (circleGen n) := by
  constructor
  · intro hx
    obtain ⟨q, rfl⟩ := QuotientAddGroup.mk_surjective (s := AddSubgroup.zmultiples (1 : ℚ)) x
    rw [show (n • (q : AddCircle (1 : ℚ))) = ((n • q : ℚ) : AddCircle (1 : ℚ)) from rfl,
      AddCircle.coe_eq_zero_iff] at hx
    obtain ⟨m, hm⟩ := hx
    refine ⟨m, ?_⟩
    have hn' : (n : ℚ) ≠ 0 := Nat.cast_ne_zero.2 hn.ne'
    have hm' : (m : ℚ) = (n : ℚ) * q := by simpa [zsmul_eq_mul, nsmul_eq_mul] using hm
    have hq : q = (m : ℚ) * ((n : ℚ)⁻¹) := by
      rw [hm', mul_comm ((n : ℚ)) q, mul_assoc, mul_inv_cancel₀ hn', mul_one]
    show ((m • ((n : ℚ)⁻¹ : ℚ) : ℚ) : AddCircle (1 : ℚ)) = _
    rw [zsmul_eq_mul, ← hq]
  · rintro ⟨m, rfl⟩
    rw [smul_comm, nsmul_circleGen hn, smul_zero]

/-- **The torsion of the rational circle of an order has exactly that many elements.** -/
theorem card_circleTorsion {n : ℕ} (hn : 0 < n) :
    Nat.card {x : AddCircle (1 : ℚ) // n • x = 0} = n := by
  rw [Nat.card_congr (Equiv.subtypeEquivRight (nsmul_eq_zero_iff_mem_zmultiples hn)),
    Nat.card_zmultiples, addOrderOf_circleGen hn]

end RationalCircle

/-! ### The characters of a cyclic group -/

section Cyclic

/-- The characters of a cyclic group are the torsion of the rational circle of its order. -/
def zmodCharacterEquiv (n : ℕ) :
    {x : AddCircle (1 : ℚ) // n • x = 0} ≃ CharacterModule (ZMod n) :=
  (Equiv.subtypeEquiv (zmultiplesHom (AddCircle (1 : ℚ)))
    (fun x => by simp [natCast_zsmul])).trans (ZMod.lift n)

/-- **A cyclic group has as many characters as elements.** -/
theorem card_characterModule_zmod {n : ℕ} (hn : 0 < n) :
    Nat.card (CharacterModule (ZMod n)) = n := by
  rw [← Nat.card_congr (zmodCharacterEquiv n), card_circleTorsion hn]

end Cyclic

/-! ### The characters of a finite abelian group -/

section Finite

open Classical in
/-- The characters of a finite product are the products of the characters. -/
noncomputable def piCharacterEquiv {ι : Type*} [Fintype ι] (M : ι → Type*)
    [∀ i, AddCommGroup (M i)] :
    CharacterModule (∀ i, M i) ≃ (∀ i, CharacterModule (M i)) :=
  ((addMonoidHomLequivInt (A := ∀ i, M i) (B := AddCircle (1 : ℚ)) ℤ).toEquiv.trans
      (LinearMap.lsum ℤ M ℤ).toEquiv.symm).trans
    (Equiv.piCongrRight fun i => (addMonoidHomLequivInt (A := M i) ℤ).toEquiv.symm)

/-- **A finite abelian group has as many characters as elements.** -/
theorem card_characterModule (A : Type*) [AddCommGroup A] [Finite A] :
    Nat.card (CharacterModule A) = Nat.card A := by
  obtain ⟨ι, hι, n, hn, ⟨e⟩⟩ := AddCommGroup.equiv_directSum_zmod_of_finite' A
  have hn0 : ∀ i, 0 < n i := fun i => lt_trans one_pos (hn i)
  have f : A ≃ₗ[ℤ] (∀ i, ZMod (n i)) :=
    (AddEquiv.toIntLinearEquiv e).trans (DirectSum.linearEquivFunOnFintype ℤ ι fun i => ZMod (n i))
  calc Nat.card (CharacterModule A)
      = Nat.card (CharacterModule (∀ i, ZMod (n i))) :=
        Nat.card_congr (CharacterModule.congr f).toEquiv
    _ = Nat.card (∀ i, CharacterModule (ZMod (n i))) :=
        Nat.card_congr (piCharacterEquiv fun i => ZMod (n i))
    _ = ∏ i, Nat.card (CharacterModule (ZMod (n i))) := Nat.card_pi
    _ = ∏ i, Nat.card (ZMod (n i)) := by
        refine Finset.prod_congr rfl fun i _ => ?_
        haveI : NeZero (n i) := ⟨(hn0 i).ne'⟩
        rw [card_characterModule_zmod (hn0 i), Nat.card_eq_fintype_card, ZMod.card]
    _ = Nat.card (∀ i, ZMod (n i)) := Nat.card_pi.symm
    _ = Nat.card A := Nat.card_congr f.toEquiv.symm

instance finite_characterModule (A : Type*) [AddCommGroup A] [Finite A] :
    Finite (CharacterModule A) := by
  have h : 0 < Nat.card (CharacterModule A) := by
    rw [card_characterModule]
    exact Nat.card_pos
  exact (Nat.card_pos_iff.1 h).2

end Finite

/-! ### The characters of the characters -/

section DoubleDual

variable {M N : Type*} [AddCommGroup M] [Module ℤ M] [AddCommGroup N] [Module ℤ N]

@[simp]
theorem intLinear_apply (f : M →+ N) (x : M) : intLinear f x = f x := rfl

/-- The additive maps of modules over the integers are exactly their linear maps. -/
def intLinearEquiv : (M →+ N) ≃ (M →ₗ[ℤ] N) where
  toFun := intLinear
  invFun := LinearMap.toAddMonoidHom
  left_inv _ := rfl
  right_inv _ := rfl

variable (M)

/-- **A finite module over the integers has as many linear functionals into the rational circle as
elements.** -/
theorem card_linearDual [Finite M] :
    Nat.card (M →ₗ[ℤ] AddCircle (1 : ℚ)) = Nat.card M :=
  (Nat.card_congr (intLinearEquiv (M := M) (N := AddCircle (1 : ℚ))).symm).trans
    (card_characterModule M)

theorem finite_linearDual [Finite M] : Finite (M →ₗ[ℤ] AddCircle (1 : ℚ)) := by
  have h : 0 < Nat.card (M →ₗ[ℤ] AddCircle (1 : ℚ)) := by
    rw [card_linearDual]
    exact Nat.card_pos
  exact (Nat.card_pos_iff.1 h).2

/-- **The evaluation of a module in the characters of its characters.** -/
def evalDual : M →ₗ[ℤ] ((M →ₗ[ℤ] AddCircle (1 : ℚ)) →ₗ[ℤ] AddCircle (1 : ℚ)) :=
  LinearMap.flip LinearMap.id

@[simp]
theorem evalDual_apply (m : M) (f : M →ₗ[ℤ] AddCircle (1 : ℚ)) :
    evalDual M m f = f m := rfl

/-- **A nonzero element is detected by some character**, so evaluation is injective. -/
theorem injective_evalDual : Function.Injective (evalDual M) := by
  rw [injective_iff_map_eq_zero]
  intro m hm
  by_contra hne
  obtain ⟨c, hc⟩ := CharacterModule.exists_character_apply_ne_zero_of_ne_zero hne
  exact hc (by simpa using LinearMap.congr_fun hm (intLinear c))

/-- **A finite abelian group is the characters of its characters.** -/
theorem bijective_evalDual [Finite M] : Function.Bijective (evalDual M) := by
  haveI := finite_linearDual M
  haveI := finite_linearDual (M →ₗ[ℤ] AddCircle (1 : ℚ))
  refine (Nat.bijective_iff_injective_and_card _).2 ⟨injective_evalDual M, ?_⟩
  rw [card_linearDual, card_linearDual]

end DoubleDual

end InverseGalois.CFT.Tate
