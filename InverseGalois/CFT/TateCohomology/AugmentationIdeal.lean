import Mathlib
import InverseGalois.CFT.TateCohomology.SylowTrivial

/-!
# The augmentation ideal and the complete cohomology of the base ring

The functions on a finite group with values in the base ring are the group ring, and the map that
sums the values is the augmentation.  Its kernel is the augmentation ideal, which is by definition
the coshift of the base ring with the trivial action; dimension shifting therefore identifies the
complete cohomology of the base ring in a degree with that of the augmentation ideal in the
following degree.

Over the integers the two middle degrees and the first degree are completely known.  The
coinvariants of the trivial representation are the integers again and the norm is multiplication by
the order of the group, which is injective, so nothing survives in degree minus one; the invariants
are the integers and the norms are the multiples of the order of the group, so degree zero is
cyclic of that order, generated by the class of one; and a cocycle in degree one is a homomorphism
from the group to the integers, so degree one vanishes.

Consequently a short exact sequence whose quotient is the augmentation ideal and whose middle term
has no complete cohomology at all splices the two identifications together: the complete cohomology
of the integers in a degree becomes the complete cohomology of the sub two degrees higher.

## Main definitions

* `InverseGalois.CFT.Tate.augIdeal`: the augmentation ideal, the kernel of the map summing the
  values of a function on the group.
* `InverseGalois.CFT.Tate.tateAugEquiv`: the identification of the complete cohomology of the base
  ring in a degree with that of the augmentation ideal in the following degree.
* `InverseGalois.CFT.Tate.tateIntGen`: the class of one in degree zero over the integers.

## Main results

* `InverseGalois.CFT.Tate.isZero_tateModule_trivialInt_neg_one`,
  `InverseGalois.CFT.Tate.isZero_tateModule_trivialInt_one`: **the complete cohomology of the
  integers vanishes in degree minus one and in degree one.**
* `InverseGalois.CFT.Tate.exists_zsmul_tateIntGen`,
  `InverseGalois.CFT.Tate.zsmul_tateIntGen_eq_zero_iff`: **the complete cohomology of the integers
  in degree zero is cyclic of order the order of the group, generated by the class of one.**
* `InverseGalois.CFT.Tate.tateExtensionEquiv`: **an extension of the augmentation ideal with no
  complete cohomology in the middle raises the degree by two.**

## Tags

Tate cohomology, augmentation ideal, dimension shifting, Tate's theorem
-/

namespace InverseGalois.CFT.Tate

open CategoryTheory Representation

universe u

noncomputable section

/-! ### The augmentation ideal -/

section Aug

variable (k G : Type u) [CommRing k] [Group G] [Finite G]

/-- **The augmentation ideal of a finite group**: the functions on the group whose values sum to
zero, as a representation. -/
abbrev augIdeal : Rep k G := coshiftObj (Rep.trivial k G k)

omit [Finite G] in
/-- **Every element of the base ring is invariant** for the trivial action. -/
theorem mem_invariants_trivial (c : k) : c ∈ (Rep.trivial k G k).ρ.invariants := fun _ => rfl

/-- **The complete cohomology of the base ring in a degree is the complete cohomology of the
augmentation ideal in the following degree.** -/
def tateAugEquiv (n : ℤ) :
    tateModule (Rep.trivial k G k) n ≃ₗ[k] tateModule (augIdeal k G) (n + 1) :=
  tateCoshiftEquiv (Rep.trivial k G k) n

end Aug

/-! ### The integers with the trivial action -/

section Int

variable (G : Type) [Group G] [Finite G]

omit [Finite G] in
theorem mem_invariants_trivialInt (m : ℤ) : m ∈ (Rep.trivial ℤ G ℤ).ρ.invariants :=
  mem_invariants_trivial ℤ G m

theorem normMap_trivialInt (m : ℤ) :
    normMap (Rep.trivial ℤ G ℤ).ρ m = (Nat.card G : ℤ) * m := by
  rw [normMap_of_mem_invariants _ (mem_invariants_trivialInt G m), nsmul_eq_mul]

/-- **The complete cohomology of the integers vanishes in degree minus one.** -/
theorem isZero_tateModule_trivialInt_neg_one :
    Limits.IsZero (tateModule (Rep.trivial ℤ G ℤ) (-1)) := by
  refine isZero_of_forall_eq_zero fun x => ?_
  obtain ⟨v, hv, rfl⟩ := exists_Hm1mk (Rep.trivial ℤ G ℤ).ρ x
  rw [normMap_trivialInt] at hv
  have hv0 : v = 0 := by
    rcases mul_eq_zero.1 hv with h | h
    · exact absurd (Nat.cast_eq_zero.1 h) Nat.card_pos.ne'
    · exact h
  subst hv0
  refine Subtype.ext ?_
  rw [Hm1mk_coe, map_zero]
  rfl

/-! ### Degree one -/

theorem eq_zero_of_addMonoidHom_int (f : Additive G →+ ℤ) (x : Additive G) : f x = 0 := by
  have hx : Nat.card G • x = 0 :=
    addOrderOf_dvd_iff_nsmul_eq_zero.1 (addOrderOf_dvd_natCard x)
  have h : (Nat.card G : ℤ) * f x = 0 := by
    rw [← nsmul_eq_mul, ← map_nsmul, hx, map_zero]
  rcases mul_eq_zero.1 h with h' | h'
  · exact absurd (Nat.cast_eq_zero.1 h') Nat.card_pos.ne'
  · exact h'

instance subsingleton_addMonoidHom_int : Subsingleton (Additive G →+ ℤ) :=
  ⟨fun f g => AddMonoidHom.ext fun x => by
    rw [eq_zero_of_addMonoidHom_int G f x, eq_zero_of_addMonoidHom_int G g x]⟩

/-- **The complete cohomology of the integers vanishes in degree one.** -/
theorem isZero_tateModule_trivialInt_one :
    Limits.IsZero (tateModule (Rep.trivial ℤ G ℤ) 1) :=
  Limits.IsZero.of_iso
    (ModuleCat.isZero_of_subsingleton (ModuleCat.of ℤ (Additive G →+ ℤ)))
    (groupCohomology.H1IsoOfIsTrivial (Rep.trivial ℤ G ℤ))

/-! ### Degree zero -/

/-- **The class of one in the complete cohomology of the integers in degree zero.** -/
def tateIntGen : tateModule (Rep.trivial ℤ G ℤ) 0 :=
  H0mk (Rep.trivial ℤ G ℤ).ρ ⟨1, mem_invariants_trivialInt G 1⟩

theorem H0mk_trivialInt (m : ℤ) :
    H0mk (Rep.trivial ℤ G ℤ).ρ ⟨m, mem_invariants_trivialInt G m⟩ = m • tateIntGen G := by
  have h : (⟨m, mem_invariants_trivialInt G m⟩ : (Rep.trivial ℤ G ℤ).ρ.invariants)
      = m • ⟨1, mem_invariants_trivialInt G 1⟩ := by
    refine Subtype.ext ?_
    rw [SetLike.val_smul, smul_eq_mul, mul_one]
  rw [tateIntGen, h, map_zsmul]

/-- **Every class in degree zero over the integers is a multiple of the class of one.** -/
theorem exists_zsmul_tateIntGen (x : tateModule (Rep.trivial ℤ G ℤ) 0) :
    ∃ m : ℤ, x = m • tateIntGen G := by
  obtain ⟨y, rfl⟩ := H0mk_surjective (Rep.trivial ℤ G ℤ).ρ x
  refine ⟨(y : ℤ), ?_⟩
  rw [← H0mk_trivialInt]

/-- **A multiple of the class of one vanishes exactly when the order of the group divides it.** -/
theorem zsmul_tateIntGen_eq_zero_iff (m : ℤ) :
    m • tateIntGen G = 0 ↔ (Nat.card G : ℤ) ∣ m := by
  rw [← H0mk_trivialInt, H0mk_eq_zero_iff]
  constructor
  · rintro ⟨y, hy⟩
    exact ⟨y, by rw [← normMap_trivialInt G y, hy]⟩
  · rintro ⟨y, rfl⟩
    exact ⟨y, normMap_trivialInt G y⟩

/-- **The order of the group annihilates the class of one.** -/
theorem card_nsmul_tateIntGen : (Nat.card G : ℤ) • tateIntGen G = 0 :=
  (zsmul_tateIntGen_eq_zero_iff G _).2 dvd_rfl

end Int

/-! ### Raising the degree by two -/

section Extension

variable {G : Type} [Group G] [Finite G]

/-- **An extension of the augmentation ideal whose middle term has no complete cohomology
identifies the complete cohomology of the integers in a degree with that of the sub two degrees
higher.** -/
def tateExtensionEquiv {X : ShortComplex (Rep ℤ G)} (hX : X.ShortExact)
    (e : X.X₃ ≅ augIdeal ℤ G) (hB : ∀ n : ℤ, Limits.IsZero (tateModule X.X₂ n)) (n : ℤ) :
    tateModule (Rep.trivial ℤ G ℤ) n ≃ₗ[ℤ] tateModule X.X₁ (n + 1 + 1) :=
  ((tateAugEquiv ℤ G n).trans (tateMapIso e (n + 1)).toLinearEquiv.symm).trans
    (LinearEquiv.ofBijective (tateδ hX (n + 1)).hom
      (bijective_tateδ hX (n + 1) (hB (n + 1)) (hB (n + 1 + 1))))

end Extension

end

end InverseGalois.CFT.Tate
