import Mathlib

/-!
# Explicit two-cocycles for a finite cyclic group

Let `G` be a finite cyclic group generated by `g`, of order `n = Nat.card G`, acting on a
commutative group `M` through a `MulDistribMulAction`.  Writing every element of `G` as `g ^ i`
with `0 ≤ i < n`, an element `a : M` fixed by `G` gives rise to the function

`f (g ^ i, g ^ j) = if i + j < n then 1 else a`,

which is a multiplicative two-cocycle.  This file constructs that cocycle and characterises when
it is a multiplicative two-coboundary: exactly when `a` lies in the image of the norm map
`m ↦ ∏ σ : G, σ • m`.  Thus the construction realises the Tate group `Ĥ⁰(G, M) = M^G / N M`
inside `H²(G, M)`.

Specialising to a finite cyclic Galois extension `L/K` and to `M = Lˣ`, an element `a : Kˣ`
produces an explicit two-cocycle on `Gal(L/K)` with values in `Lˣ`, and that cocycle is a
coboundary exactly when `a` is a norm from `Lˣ`.

## Main definitions

* `InverseGalois.CFT.dlog`: the discrete logarithm of `σ : G` to the base `g`, as an element of
  `ZMod (Nat.card G)`.
* `InverseGalois.CFT.cyclicCocycle`: the two-cocycle `f` above.
* `InverseGalois.CFT.partialNorm`: the partial products `∏_{t < i} g ^ t • m` witnessing that a
  norm gives a coboundary.
* `InverseGalois.CFT.cyclicUnitCocycle`: the specialisation of `cyclicCocycle` to a cyclic Galois
  extension `L/K` and an element `a : Kˣ`.

## Main results

* `InverseGalois.CFT.isMulCocycle₂_cyclicCocycle`: for `a : M` fixed by `G`, the function
  `cyclicCocycle g a` is a multiplicative two-cocycle.
* `InverseGalois.CFT.isMulCoboundary₂_cyclicCocycle_iff`: `cyclicCocycle g a` is a multiplicative
  two-coboundary if and only if `a = ∏ σ : G, σ • m` for some `m : M`.
* `InverseGalois.CFT.isMulCocycle₂_cyclicUnitCocycle`: the Galois-theoretic specialisation, a
  multiplicative two-cocycle on `Gal(L/K)` with values in `Lˣ`.
* `InverseGalois.CFT.isMulCoboundary₂_cyclicUnitCocycle_iff`: that cocycle is a coboundary if and
  only if `a` is the norm of a unit of `L`.
* `InverseGalois.CFT.H2π_cyclicCocycle_eq_zero_iff`: the class of `cyclicCocycle g a` in
  `H²(G, M)` vanishes if and only if `a` is a norm.

-/

namespace InverseGalois.CFT

open groupCohomology

/-! ### Discrete logarithms in a finite cyclic group -/

section DiscreteLog

variable {G : Type*} [Group G]

open Classical in
/-- Some natural number `i` with `g ^ i = σ`, chosen when such an `i` exists, and `0`
otherwise. -/
noncomputable def dlogNat (g σ : G) : ℕ :=
  if h : ∃ i : ℕ, g ^ i = σ then h.choose else 0

/-- The discrete logarithm of `σ : G` to the base `g`, as an element of `ZMod (Nat.card G)`. -/
noncomputable def dlog (g σ : G) : ZMod (Nat.card G) := (dlogNat g σ : ZMod (Nat.card G))

variable [Fintype G] {g : G}

/-- In a finite group `G` whose elements are all integer powers of `g`, every element is in fact
a natural power of `g`. -/
theorem exists_pow_eq (hg : ∀ x, x ∈ Subgroup.zpowers g) (σ : G) : ∃ i : ℕ, g ^ i = σ :=
  (Submonoid.mem_powers_iff σ g).1 (mem_powers_iff_mem_zpowers.2 (hg σ))

/-- The chosen natural discrete logarithm really is a logarithm. -/
theorem pow_dlogNat (hg : ∀ x, x ∈ Subgroup.zpowers g) (σ : G) : g ^ dlogNat g σ = σ := by
  rw [dlogNat, dif_pos (exists_pow_eq hg σ)]
  exact (exists_pow_eq hg σ).choose_spec

omit [Fintype G] in
/-- A generator of a finite group has order the cardinality of the group. -/
theorem orderOf_of_forall_mem_zpowers (hg : ∀ x, x ∈ Subgroup.zpowers g) :
    orderOf g = Nat.card G :=
  orderOf_eq_card_of_forall_mem_zpowers hg

/-- The order of a finite group is nonzero. -/
theorem neZero_card (G : Type*) [Group G] [Fintype G] : NeZero (Nat.card G) :=
  ⟨Nat.card_pos.ne'⟩

/-- The value of the discrete logarithm is smaller than the order of the group. -/
theorem val_dlog_lt (g σ : G) : (dlog g σ).val < Nat.card G :=
  letI := neZero_card G
  ZMod.val_lt _

/-- The discrete logarithm turns multiplication into addition. -/
theorem dlog_mul (hg : ∀ x, x ∈ Subgroup.zpowers g) (σ τ : G) :
    dlog g (σ * τ) = dlog g σ + dlog g τ := by
  have h : g ^ dlogNat g (σ * τ) = g ^ (dlogNat g σ + dlogNat g τ) := by
    rw [pow_add, pow_dlogNat hg, pow_dlogNat hg, pow_dlogNat hg]
  have h' := pow_eq_pow_iff_modEq.1 h
  rw [orderOf_of_forall_mem_zpowers hg] at h'
  rw [dlog, dlog, dlog, ← Nat.cast_add, ZMod.natCast_eq_natCast_iff]
  exact h'

/-- Raising `g` to its discrete logarithm recovers the element. -/
theorem pow_val_dlog (hg : ∀ x, x ∈ Subgroup.zpowers g) (σ : G) : g ^ (dlog g σ).val = σ := by
  letI := neZero_card G
  rw [dlog, ZMod.val_natCast, ← orderOf_of_forall_mem_zpowers hg, pow_mod_orderOf,
    pow_dlogNat hg]

/-- The discrete logarithm of an explicit power of `g`. -/
theorem dlog_pow (hg : ∀ x, x ∈ Subgroup.zpowers g) (i : ℕ) :
    dlog g (g ^ i) = (i : ZMod (Nat.card G)) := by
  rw [dlog, ZMod.natCast_eq_natCast_iff, ← orderOf_of_forall_mem_zpowers hg]
  exact pow_eq_pow_iff_modEq.1 (pow_dlogNat hg (g ^ i))

/-- A product over the powers `g ^ 0, ..., g ^ (n - 1)` is a product over the whole group. -/
theorem prod_range_card {M : Type*} [CommMonoid M] (hg : ∀ x, x ∈ Subgroup.zpowers g)
    (F : G → M) : ∏ i ∈ Finset.range (Nat.card G), F (g ^ i) = ∏ σ : G, F σ := by
  refine Finset.prod_bij' (fun i _ => g ^ i) (fun σ _ => (dlog g σ).val)
    (fun _ _ => Finset.mem_univ _) (fun σ _ => Finset.mem_range.2 (val_dlog_lt g σ))
    (fun i hi => ?_) (fun σ _ => pow_val_dlog hg σ) (fun _ _ => rfl)
  letI := neZero_card G
  show (dlog g (g ^ i)).val = i
  rw [dlog_pow hg, ZMod.val_natCast, Nat.mod_eq_of_lt (Finset.mem_range.1 hi)]

end DiscreteLog

/-! ### The explicit two-cocycle -/

section Cocycle

variable {G M : Type*} [Group G] [Fintype G] [CommGroup M] [MulDistribMulAction G M]

/-- The explicit multiplicative two-cocycle attached to a generator `g` of a finite cyclic group
`G` and to an element `a : M`: it takes the value `a` exactly when the discrete logarithms of the
two arguments add up to at least the order of `G`, and the value `1` otherwise. -/
noncomputable def cyclicCocycle (g : G) (a : M) : G × G → M :=
  fun p => if (dlog g p.1).val + (dlog g p.2).val < Nat.card G then 1 else a

omit [Fintype G] [MulDistribMulAction G M] in
/-- The defining formula for `cyclicCocycle`. -/
theorem cyclicCocycle_apply (g : G) (a : M) (σ τ : G) :
    cyclicCocycle g a (σ, τ) =
      if (dlog g σ).val + (dlog g τ).val < Nat.card G then 1 else a := rfl

/-- The elementary carrying identity underlying the two-cocycle condition. -/
theorem carry_identity {n : ℕ} [NeZero n] (a : M) (x y z : ZMod n) :
    (if (x + y).val + z.val < n then (1 : M) else a) * (if x.val + y.val < n then 1 else a) =
      (if y.val + z.val < n then (1 : M) else a) *
        (if x.val + (y + z).val < n then 1 else a) := by
  have hx := ZMod.val_lt x
  have hy := ZMod.val_lt y
  have hz := ZMod.val_lt z
  rcases Nat.lt_or_ge (x.val + y.val) n with h1 | h1 <;>
    rcases Nat.lt_or_ge (y.val + z.val) n with h2 | h2
  · rw [ZMod.val_add_of_lt h1, ZMod.val_add_of_lt h2]
    split_ifs <;> first | rfl | exact mul_comm _ _ | (exfalso; omega)
  · rw [ZMod.val_add_of_lt h1, ZMod.val_add_of_le h2]
    split_ifs <;> first | rfl | exact mul_comm _ _ | (exfalso; omega)
  · rw [ZMod.val_add_of_le h1, ZMod.val_add_of_lt h2]
    split_ifs <;> first | rfl | exact mul_comm _ _ | (exfalso; omega)
  · rw [ZMod.val_add_of_le h1, ZMod.val_add_of_le h2]
    split_ifs <;> first | rfl | exact mul_comm _ _ | (exfalso; omega)

variable {g : G}

/-- For a `G`-invariant `a : M`, the function `cyclicCocycle g a` satisfies the multiplicative
two-cocycle condition. -/
theorem isMulCocycle₂_cyclicCocycle (hg : ∀ x, x ∈ Subgroup.zpowers g) {a : M}
    (ha : ∀ σ : G, σ • a = a) : IsMulCocycle₂ (cyclicCocycle g a) := by
  letI := neZero_card G
  intro σ τ υ
  have hsm : σ • cyclicCocycle g a (τ, υ) = cyclicCocycle g a (τ, υ) := by
    rw [cyclicCocycle_apply]
    split_ifs
    · exact smul_one σ
    · exact ha σ
  rw [hsm, cyclicCocycle_apply, cyclicCocycle_apply, cyclicCocycle_apply, cyclicCocycle_apply,
    dlog_mul hg, dlog_mul hg]
  exact carry_identity a _ _ _

/-- The partial norms `∏_{t < i} g ^ t • m`, where `i` is the discrete logarithm of `σ`. -/
noncomputable def partialNorm (g : G) (m : M) (σ : G) : M :=
  ∏ t ∈ Finset.range (dlog g σ).val, (g ^ t) • m

/-- The failure of `partialNorm` to be a crossed homomorphism is measured by the cocycle
attached to the norm of `m`. -/
theorem partialNorm_mul_smul (hg : ∀ x, x ∈ Subgroup.zpowers g) (m : M) (σ τ : G) :
    partialNorm g m σ * σ • partialNorm g m τ =
      cyclicCocycle g (∏ ρ : G, ρ • m) (σ, τ) * partialNorm g m (σ * τ) := by
  letI := neZero_card G
  have hgn : g ^ Nat.card G = 1 := by
    rw [← orderOf_of_forall_mem_zpowers hg]
    exact pow_orderOf_eq_one g
  have hσ : g ^ (dlog g σ).val = σ := pow_val_dlog hg σ
  have hsm : σ • partialNorm g m τ =
      ∏ t ∈ Finset.range (dlog g τ).val, (g ^ ((dlog g σ).val + t)) • m := by
    rw [partialNorm, Finset.smul_prod']
    exact Finset.prod_congr rfl fun t _ => by rw [smul_smul, pow_add, hσ]
  have hcomb : partialNorm g m σ * σ • partialNorm g m τ =
      ∏ t ∈ Finset.range ((dlog g σ).val + (dlog g τ).val), (g ^ t) • m := by
    rw [hsm, partialNorm, Finset.prod_range_add]
  rw [hcomb, cyclicCocycle_apply, partialNorm, dlog_mul hg]
  split_ifs with h
  · rw [ZMod.val_add_of_lt h, one_mul]
  · rw [ZMod.val_add_of_le (Nat.not_lt.1 h)]
    obtain ⟨k, hk⟩ : ∃ k, (dlog g σ).val + (dlog g τ).val = Nat.card G + k :=
      ⟨(dlog g σ).val + (dlog g τ).val - Nat.card G, by omega⟩
    rw [hk, Nat.add_sub_cancel_left, Finset.prod_range_add,
      prod_range_card hg (fun ρ : G => ρ • m)]
    refine congrArg (fun u => _ * u) ?_
    exact Finset.prod_congr rfl fun t _ => by rw [pow_add, hgn, one_mul]

/-- If `a` is a norm, then `cyclicCocycle g a` is a multiplicative two-coboundary. -/
theorem isMulCoboundary₂_cyclicCocycle (hg : ∀ x, x ∈ Subgroup.zpowers g) {a m : M}
    (hm : ∏ σ : G, σ • m = a) : IsMulCoboundary₂ (cyclicCocycle g a) := by
  refine ⟨partialNorm g m, fun σ τ => ?_⟩
  have h := partialNorm_mul_smul hg m σ τ
  rw [hm] at h
  rw [div_mul_eq_mul_div, mul_comm (σ • partialNorm g m τ) (partialNorm g m σ), h,
    mul_div_assoc, div_self', mul_one]

/-- If `cyclicCocycle g a` is a multiplicative two-coboundary, then `a` is a norm. -/
theorem exists_prod_smul_eq (hg : ∀ x, x ∈ Subgroup.zpowers g) {a : M}
    (hf : IsMulCoboundary₂ (cyclicCocycle g a)) : ∃ m : M, ∏ σ : G, σ • m = a := by
  letI := neZero_card G
  obtain ⟨x, hx⟩ := hf
  rcases eq_or_lt_of_le (Nat.one_le_iff_ne_zero.2 (NeZero.ne (Nat.card G))) with h1 | h1
  · -- the group is trivial, and every element of `M` is its own norm
    haveI : Subsingleton G := (Nat.card_eq_one_iff_unique.1 h1.symm).1
    exact ⟨a, by rw [Fintype.prod_subsingleton _ (1 : G), one_smul]⟩
  · refine ⟨x g, ?_⟩
    have hgn : g ^ Nat.card G = 1 := by
      rw [← orderOf_of_forall_mem_zpowers hg]
      exact pow_orderOf_eq_one g
    have hdg : (dlog g g).val = 1 := by
      have h := dlog_pow hg (g := g) 1
      rw [pow_one] at h
      rw [h, ZMod.val_natCast, Nat.mod_eq_of_lt h1]
    obtain ⟨p, hp⟩ : ∃ p, Nat.card G = p + 1 := ⟨Nat.card G - 1, by omega⟩
    -- the product of the cocycle along the first row is `a`
    have h1' : ∏ t ∈ Finset.range (Nat.card G), cyclicCocycle g a (g ^ t, g) = a := by
      have hterm : ∀ t ∈ Finset.range (Nat.card G),
          cyclicCocycle g a (g ^ t, g) = if t + 1 < Nat.card G then (1 : M) else a := by
        intro t ht
        rw [Finset.mem_range] at ht
        rw [cyclicCocycle_apply, dlog_pow hg, ZMod.val_natCast, Nat.mod_eq_of_lt ht, hdg]
      have hone : ∏ t ∈ Finset.range p, (if t + 1 < p + 1 then (1 : M) else a) = 1 :=
        Finset.prod_eq_one fun t ht => if_pos (by rw [Finset.mem_range] at ht; omega)
      rw [Finset.prod_congr rfl hterm, hp, Finset.prod_range_succ, hone, one_mul,
        if_neg (by omega)]
    -- the same product, computed from the coboundary, is the norm of `x g`
    have hshift : ∏ t ∈ Finset.range (Nat.card G), x (g ^ (t + 1)) =
        ∏ t ∈ Finset.range (Nat.card G), x (g ^ t) := by
      rw [hp, Finset.prod_range_succ, Finset.prod_range_succ']
      refine congrArg (fun u => _ * u) ?_
      rw [show p + 1 = Nat.card G from hp.symm, hgn, pow_zero]
    have h2' : ∏ t ∈ Finset.range (Nat.card G), cyclicCocycle g a (g ^ t, g) =
        ∏ σ : G, σ • x g := by
      have hterm : ∀ t ∈ Finset.range (Nat.card G),
          cyclicCocycle g a (g ^ t, g) = (g ^ t) • x g / x (g ^ (t + 1)) * x (g ^ t) := by
        intro t _
        rw [← hx (g ^ t) g, pow_succ]
      rw [Finset.prod_congr rfl hterm, Finset.prod_mul_distrib, Finset.prod_div_distrib, hshift,
        div_mul_cancel, prod_range_card hg (fun ρ : G => ρ • x g)]
    rw [← h2', h1']

/-- The cocycle attached to `a` is a multiplicative two-coboundary exactly when `a` is a norm. -/
theorem isMulCoboundary₂_cyclicCocycle_iff (hg : ∀ x, x ∈ Subgroup.zpowers g) (a : M) :
    IsMulCoboundary₂ (cyclicCocycle g a) ↔ ∃ m : M, ∏ σ : G, σ • m = a :=
  ⟨exists_prod_smul_eq hg, fun ⟨_, hm⟩ => isMulCoboundary₂_cyclicCocycle hg hm⟩

end Cocycle

/-! ### The cyclic algebra cocycle of a cyclic Galois extension -/

section Galois

variable {K L : Type*} [Field K] [Field L] [Algebra K L] [FiniteDimensional K L]

omit [FiniteDimensional K L] in
/-- The image in `Lˣ` of a unit of `K` is fixed by every `K`-automorphism of `L`. -/
theorem smul_unitsMap_algebraMap (a : Kˣ) (σ : L ≃ₐ[K] L) :
    σ • Units.map (algebraMap K L).toMonoidHom a = Units.map (algebraMap K L).toMonoidHom a := by
  ext
  simp

/-- The explicit two-cocycle on `Gal(L/K)` with values in `Lˣ` attached to a generator `σ₀` of a
cyclic Galois group and an element `a : Kˣ`. -/
noncomputable def cyclicUnitCocycle (σ₀ : L ≃ₐ[K] L) (a : Kˣ) :
    (L ≃ₐ[K] L) × (L ≃ₐ[K] L) → Lˣ :=
  cyclicCocycle σ₀ (Units.map (algebraMap K L).toMonoidHom a)

omit [FiniteDimensional K L] in
/-- The defining formula for `cyclicUnitCocycle`, read inside `L`. -/
theorem cyclicUnitCocycle_apply (σ₀ : L ≃ₐ[K] L) (a : Kˣ) (σ τ : L ≃ₐ[K] L) :
    (cyclicUnitCocycle σ₀ a (σ, τ) : L) =
      if (dlog σ₀ σ).val + (dlog σ₀ τ).val < Nat.card (L ≃ₐ[K] L) then 1
      else algebraMap K L a := by
  rw [cyclicUnitCocycle, cyclicCocycle_apply]
  split_ifs <;> simp

variable {σ₀ : L ≃ₐ[K] L}

/-- The cyclic algebra cocycle of a cyclic Galois extension is a multiplicative two-cocycle. -/
theorem isMulCocycle₂_cyclicUnitCocycle (hσ₀ : ∀ x, x ∈ Subgroup.zpowers σ₀) (a : Kˣ) :
    IsMulCocycle₂ (cyclicUnitCocycle σ₀ a) :=
  isMulCocycle₂_cyclicCocycle hσ₀ (smul_unitsMap_algebraMap a)

variable [IsGalois K L]

/-- The product of the Galois conjugates of a unit of `L` is the image of its norm. -/
theorem val_prod_smul (m : Lˣ) :
    ((∏ σ : L ≃ₐ[K] L, σ • m : Lˣ) : L) = algebraMap K L (Algebra.norm K (m : L)) := by
  rw [Algebra.norm_eq_prod_automorphisms, Units.coe_prod]
  exact Finset.prod_congr rfl fun σ _ => by simp

/-- The norm condition on units, rewritten as an equality inside `Lˣ`. -/
theorem prod_smul_eq_iff (m : Lˣ) (a : Kˣ) :
    (∏ σ : L ≃ₐ[K] L, σ • m) = Units.map (algebraMap K L).toMonoidHom a ↔
      Algebra.norm K (m : L) = (a : K) := by
  rw [Units.ext_iff, val_prod_smul]
  refine ⟨fun h => (algebraMap K L).injective ?_, fun h => ?_⟩
  · simpa using h
  · simpa using congrArg (algebraMap K L) h

/-- The cyclic algebra cocycle of `a : Kˣ` is a multiplicative two-coboundary exactly when `a` is
the norm of a unit of `L`. -/
theorem isMulCoboundary₂_cyclicUnitCocycle_iff (hσ₀ : ∀ x, x ∈ Subgroup.zpowers σ₀) (a : Kˣ) :
    IsMulCoboundary₂ (cyclicUnitCocycle σ₀ a) ↔ ∃ b : Lˣ, Algebra.norm K (b : L) = (a : K) := by
  rw [cyclicUnitCocycle, isMulCoboundary₂_cyclicCocycle_iff hσ₀]
  exact exists_congr fun m => prod_smul_eq_iff m a

end Galois

/-! ### The class of the cocycle in `H²` -/

section H2

variable {G M : Type} [Group G] [Fintype G] [CommGroup M] [MulDistribMulAction G M] {g : G}

/-- The class in `H²(G, M)` of the explicit cocycle attached to a `G`-invariant `a : M` vanishes
if and only if `a` is a norm; this identifies the image of `M ^ G / N M` in `H²(G, M)`. -/
theorem H2π_cyclicCocycle_eq_zero_iff (hg : ∀ x, x ∈ Subgroup.zpowers g) {a : M}
    (ha : ∀ σ : G, σ • a = a) :
    H2π (Rep.ofMulDistribMulAction G M)
        (cocyclesOfIsMulCocycle₂ (isMulCocycle₂_cyclicCocycle hg ha)) = 0 ↔
      ∃ m : M, ∏ σ : G, σ • m = a := by
  rw [H2π_eq_zero_iff, ← isMulCoboundary₂_cyclicCocycle_iff hg a]
  exact ⟨fun h => isMulCoboundary₂_of_mem_coboundaries₂ _ h,
    fun h => (coboundariesOfIsMulCoboundary₂ h).2⟩

end H2

end InverseGalois.CFT
