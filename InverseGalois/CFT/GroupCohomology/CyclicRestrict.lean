import Mathlib
import InverseGalois.CFT.GroupCohomology.Cyclic

/-!
# Restricting the explicit cyclic two-cocycle along a subgroup

Let `G` be a finite cyclic group generated by `g` and let `H` be a finite cyclic group generated
by `h`, joined by a homomorphism `ψ : H → G` with `ψ h = g ^ d`, where `d` is the ratio of the two
orders.  Then `ψ` multiplies discrete logarithms by `d`, and because the ratio of the orders is the
same `d`, the comparison `d i + d j < d m` defining the value of the cocycle upstairs is the very
comparison `i + j < m` defining it downstairs.

Consequently **the explicit cyclic two-cocycle of `G` pulls back along `ψ` to the explicit cyclic
two-cocycle of `H` with the same value `a`**, on the nose and not merely up to a coboundary.  This
is what makes the invariant of a cyclic algebra behave predictably under restriction to an
intermediate field.

## Main results

* `InverseGalois.CFT.val_dlog_map`: a homomorphism of cyclic groups sending a generator to the
  `d`-th power of a generator multiplies discrete logarithms by `d`.
* `InverseGalois.CFT.cyclicCocycle_map`: **the explicit cyclic two-cocycle pulls back to the
  explicit cyclic two-cocycle.**

## Tags

group cohomology, cyclic group, two-cocycle, restriction, discrete logarithm
-/

namespace InverseGalois.CFT

section Restrict

variable {G H : Type*} [Group G] [Group H] [Fintype G] [Fintype H]

/-! ### The ratio of the orders is positive -/

omit [Group H] [Fintype H] in
/-- If the order of a finite group is the product of `d` with another order, then `d` is
positive. -/
theorem pos_of_natCard_eq_mul {d : ℕ} (hcard : Nat.card G = d * Nat.card H) : 0 < d := by
  rcases Nat.eq_zero_or_pos d with rfl | hd
  · rw [Nat.zero_mul] at hcard
    exact absurd hcard Nat.card_pos.ne'
  · exact hd

/-! ### Discrete logarithms along a homomorphism of cyclic groups -/

/-- **A homomorphism of finite cyclic groups sending a generator to the `d`-th power of a generator
multiplies discrete logarithms by `d`**, provided `d` is the ratio of the two orders: the product of
`d` with a discrete logarithm downstairs is then already smaller than the order upstairs, so no
reduction takes place. -/
theorem val_dlog_map (ψ : H →* G) {g : G} {h : H} (hg : ∀ x : G, x ∈ Subgroup.zpowers g)
    (hh : ∀ y : H, y ∈ Subgroup.zpowers h) {d : ℕ} (hψ : ψ h = g ^ d)
    (hcard : Nat.card G = d * Nat.card H) (y : H) :
    (dlog g (ψ y)).val = d * (dlog h y).val := by
  letI := neZero_card G
  have hd : 0 < d := pos_of_natCard_eq_mul hcard
  have hy : ψ y = g ^ (d * (dlog h y).val) := by
    have hpow : ψ (h ^ (dlog h y).val) = g ^ (d * (dlog h y).val) := by
      rw [map_pow, hψ, ← pow_mul]
    rwa [pow_val_dlog hh y] at hpow
  have hlt : d * (dlog h y).val < Nat.card G := by
    rw [hcard]
    exact (Nat.mul_lt_mul_left hd).2 (val_dlog_lt h y)
  rw [hy, dlog_pow hg, ZMod.val_natCast, Nat.mod_eq_of_lt hlt]

/-! ### The pullback of the explicit cyclic two-cocycle -/

variable {N : Type*} [CommGroup N]

/-- **The explicit cyclic two-cocycle of a finite cyclic group pulls back along a homomorphism of
cyclic groups to the explicit cyclic two-cocycle with the same value.**  The homomorphism scales
discrete logarithms by the ratio `d` of the orders, and scaling both sides of the comparison
`i + j < m` by `d` leaves it unchanged. -/
theorem cyclicCocycle_map (ψ : H →* G) {g : G} {h : H} (hg : ∀ x : G, x ∈ Subgroup.zpowers g)
    (hh : ∀ y : H, y ∈ Subgroup.zpowers h) {d : ℕ} (hψ : ψ h = g ^ d)
    (hcard : Nat.card G = d * Nat.card H) (a : N) (σ τ : H) :
    cyclicCocycle g a (ψ σ, ψ τ) = cyclicCocycle h a (σ, τ) := by
  have hd : 0 < d := pos_of_natCard_eq_mul hcard
  rw [cyclicCocycle_apply, cyclicCocycle_apply, val_dlog_map ψ hg hh hψ hcard σ,
    val_dlog_map ψ hg hh hψ hcard τ, hcard, ← Nat.mul_add]
  simp only [Nat.mul_lt_mul_left hd]

end Restrict

end InverseGalois.CFT
