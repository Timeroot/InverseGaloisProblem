import Mathlib
import InverseGalois.CFT.GroupCohomology.Cohomologous
import InverseGalois.CFT.GroupCohomology.Cyclic

/-!
# Every two-cocycle on a finite cyclic group is cohomologous to an explicit one

Let `G` be a finite cyclic group generated by `g`, of order `n = Nat.card G`, acting on a
commutative group `M` through a `MulDistribMulAction`.  The file
`InverseGalois.CFT.GroupCohomology.Cyclic` attaches to every `G`-invariant `a : M` the explicit
multiplicative two-cocycle `cyclicCocycle g a`.  Here we prove that these exhaust all
multiplicative two-cocycles up to coboundaries: every multiplicative two-cocycle `f` on `G` with
values in `M` is cohomologous to `cyclicCocycle g a` for some `G`-invariant `a`.

The proof is the classical crossed-product computation, carried out directly on cochains.  A
multiplicative two-cocycle `f` is the multiplication table of symbols `u σ` subject to
`u σ * u τ = f (σ, τ) * u (σ * τ)`, and the partial products
`cocyclePartial g f i = ∏_{j < i} f (g ^ j, g)` are exactly the coefficients expressing the `i`-th
power of `u g` in terms of `u (g ^ i)`.  The element `a = cocyclePartial g f n` plays the role of
`(u g) ^ n`; it is `G`-invariant, and rescaling the symbols by the partial products turns `f` into
`cyclicCocycle g a`.

Together with `InverseGalois.CFT.isMulCoboundary₂_cyclicCocycle_iff` this is the isomorphism
`H²(G, M) ≅ M ^ G / N M` for a finite cyclic group `G`, in explicit cochain form.

## Main definitions

* `InverseGalois.CFT.cocyclePartial`: the partial products `∏_{j < i} f (g ^ j, g)`.

## Main results

* `InverseGalois.CFT.cocyclePartial_mul_smul`: the key multiplicativity property of the partial
  products, expressing that they compute the powers of the symbol attached to `g`.
* `InverseGalois.CFT.exists_isMulCoboundary₂_div_cyclicCocycle_of_map_one`: the main computation,
  for a normalised multiplicative two-cocycle.
* `InverseGalois.CFT.exists_isMulCoboundary₂_div_cyclicCocycle`: every multiplicative two-cocycle
  on a finite cyclic group is cohomologous to `cyclicCocycle g a` for some `G`-invariant `a`.
* `InverseGalois.CFT.exists_H2π_cyclicCocycle_eq`: every class in `H²(G, M)` is the class of some
  `cyclicCocycle g a`.
* `InverseGalois.CFT.exists_isMulCoboundary₂_div_cyclicUnitCocycle`: for a finite cyclic Galois
  extension `L / K`, every multiplicative two-cocycle on `Gal(L/K)` with values in `Lˣ` is
  cohomologous to the cyclic algebra cocycle `cyclicUnitCocycle σ₀ a` of some `a : Kˣ`.
-/

namespace InverseGalois.CFT

open groupCohomology

/-! ### Partial products of a two-cocycle along the powers of a generator -/

section Partial

variable {G M : Type*} [Group G] [CommGroup M] [MulDistribMulAction G M]

/-- The partial products `∏_{j < i} f (g ^ j, g)` of a function `f : G × G → M` along the powers
of `g`.  For a multiplicative two-cocycle `f`, viewed as the multiplication table of symbols
`u σ` with `u σ * u τ = f (σ, τ) * u (σ * τ)`, these are the coefficients expressing `(u g) ^ i`
in terms of `u (g ^ i)`. -/
def cocyclePartial (g : G) (f : G × G → M) (i : ℕ) : M :=
  ∏ j ∈ Finset.range i, f (g ^ j, g)

omit [MulDistribMulAction G M] in
/-- The empty partial product is trivial. -/
@[simp] theorem cocyclePartial_zero (g : G) (f : G × G → M) : cocyclePartial g f 0 = 1 :=
  Finset.prod_range_zero _

omit [MulDistribMulAction G M] in
/-- The recursion satisfied by the partial products. -/
theorem cocyclePartial_succ (g : G) (f : G × G → M) (i : ℕ) :
    cocyclePartial g f (i + 1) = cocyclePartial g f i * f (g ^ i, g) :=
  Finset.prod_range_succ _ _

/-- A multiplicative two-cocycle taking the value `1` at `(1, 1)` takes the value `1` on the whole
first row. -/
theorem map_one_fst_eq_one {f : G × G → M} (hf : IsMulCocycle₂ f) (hf1 : f (1, 1) = 1) (σ : G) :
    f (1, σ) = 1 := by
  rw [map_one_fst_of_isMulCocycle₂ hf, hf1]

/-- A multiplicative two-cocycle taking the value `1` at `(1, 1)` takes the value `1` on the whole
first column. -/
theorem map_one_snd_eq_one {f : G × G → M} (hf : IsMulCocycle₂ f) (hf1 : f (1, 1) = 1) (σ : G) :
    f (σ, 1) = 1 := by
  rw [map_one_snd_of_isMulCocycle₂ hf, hf1, smul_one]

/-- The multiplicativity of the partial products: this is the statement that the symbols
`(u g) ^ i` multiply as the powers of a single element. -/
theorem cocyclePartial_mul_smul {f : G × G → M} (hf : IsMulCocycle₂ f) (hf1 : f (1, 1) = 1)
    (g : G) (i j : ℕ) :
    cocyclePartial g f i * (g ^ i) • cocyclePartial g f j * f (g ^ i, g ^ j)
      = cocyclePartial g f (i + j) := by
  induction j with
  | zero =>
    rw [cocyclePartial_zero, smul_one, mul_one, pow_zero, map_one_snd_eq_one hf hf1, mul_one,
      Nat.add_zero]
  | succ j ih =>
    have hco := hf (g ^ i) (g ^ j) g
    rw [← pow_add, ← pow_succ] at hco
    have e1 : cocyclePartial g f i * (g ^ i) • cocyclePartial g f (j + 1) *
        f (g ^ i, g ^ (j + 1))
        = cocyclePartial g f i * (g ^ i) • cocyclePartial g f j *
            ((g ^ i) • f (g ^ j, g) * f (g ^ i, g ^ (j + 1))) := by
      rw [cocyclePartial_succ, smul_mul']
      apply Additive.ofMul.injective
      simp only [ofMul_mul]
      abel
    have e2 : cocyclePartial g f i * (g ^ i) • cocyclePartial g f j *
        ((g ^ i) • f (g ^ j, g) * f (g ^ i, g ^ (j + 1)))
        = (cocyclePartial g f i * (g ^ i) • cocyclePartial g f j * f (g ^ i, g ^ j)) *
            f (g ^ (i + j), g) := by
      rw [← hco]
      apply Additive.ofMul.injective
      simp only [ofMul_mul]
      abel
    rw [e1, e2, ih, ← Nat.add_assoc, cocyclePartial_succ]

end Partial

/-! ### The main computation -/

section Cyclic

variable {G M : Type*} [Group G] [Fintype G] [CommGroup M] [MulDistribMulAction G M] {g : G}

/-- The top partial product `∏_{j < n} f (g ^ j, g)`, the analogue of the `n`-th power of the
symbol attached to `g`, is fixed by `G`. -/
theorem smul_cocyclePartial_card (hg : ∀ x : G, x ∈ Subgroup.zpowers g) {f : G × G → M}
    (hf : IsMulCocycle₂ f) (hf1 : f (1, 1) = 1) (σ : G) :
    σ • cocyclePartial g f (Nat.card G) = cocyclePartial g f (Nat.card G) := by
  have hgn : g ^ Nat.card G = 1 := by
    rw [← orderOf_of_forall_mem_zpowers hg]
    exact pow_orderOf_eq_one g
  have hP1 : cocyclePartial g f 1 = 1 := by
    rw [cocyclePartial, Finset.prod_range_one, pow_zero, map_one_fst_eq_one hf hf1]
  have hPn1 : cocyclePartial g f (1 + Nat.card G) = cocyclePartial g f (Nat.card G) := by
    rw [Nat.add_comm 1 (Nat.card G), cocyclePartial_succ, hgn, map_one_fst_eq_one hf hf1, mul_one]
  have hgen : g • cocyclePartial g f (Nat.card G) = cocyclePartial g f (Nat.card G) := by
    have h := cocyclePartial_mul_smul hf hf1 g 1 (Nat.card G)
    rw [pow_one, hgn, map_one_snd_eq_one hf hf1, mul_one, hP1, one_mul, hPn1] at h
    exact h
  have hpow : ∀ k : ℕ, (g ^ k) • cocyclePartial g f (Nat.card G)
      = cocyclePartial g f (Nat.card G) := by
    intro k
    induction k with
    | zero => rw [pow_zero, one_smul]
    | succ k ih => rw [pow_succ, mul_smul, hgen, ih]
  rw [← pow_val_dlog hg σ, hpow]

omit [Fintype G] in
/-- Partial products of length at least the order of the group split off the top partial
product. -/
theorem cocyclePartial_card_add (hg : ∀ x : G, x ∈ Subgroup.zpowers g) {f : G × G → M}
    (hf : IsMulCocycle₂ f) (hf1 : f (1, 1) = 1) (k : ℕ) :
    cocyclePartial g f (Nat.card G + k)
      = cocyclePartial g f (Nat.card G) * cocyclePartial g f k := by
  have hgn : g ^ Nat.card G = 1 := by
    rw [← orderOf_of_forall_mem_zpowers hg]
    exact pow_orderOf_eq_one g
  have h := cocyclePartial_mul_smul hf hf1 g (Nat.card G) k
  rw [hgn, one_smul, map_one_fst_eq_one hf hf1, mul_one] at h
  exact h.symm

/-- A multiplicative two-cocycle on a finite cyclic group which is normalised at `(1, 1)` is
cohomologous to the explicit cocycle attached to the `G`-invariant element
`∏_{j < n} f (g ^ j, g)`. -/
theorem exists_isMulCoboundary₂_div_cyclicCocycle_of_map_one
    (hg : ∀ x : G, x ∈ Subgroup.zpowers g) {f : G × G → M} (hf : IsMulCocycle₂ f)
    (hf1 : f (1, 1) = 1) :
    ∃ a : M, (∀ σ : G, σ • a = a) ∧
      IsMulCoboundary₂ (fun p : G × G => f p / cyclicCocycle g a p) := by
  letI := neZero_card G
  refine ⟨cocyclePartial g f (Nat.card G), smul_cocyclePartial_card hg hf hf1,
    fun σ => (cocyclePartial g f (dlog g σ).val)⁻¹, fun σ τ => ?_⟩
  show σ • (cocyclePartial g f (dlog g τ).val)⁻¹ /
      (cocyclePartial g f (dlog g (σ * τ)).val)⁻¹ * (cocyclePartial g f (dlog g σ).val)⁻¹
      = f (σ, τ) / cyclicCocycle g (cocyclePartial g f (Nat.card G)) (σ, τ)
  have key := cocyclePartial_mul_smul hf hf1 g (dlog g σ).val (dlog g τ).val
  rw [pow_val_dlog hg σ, pow_val_dlog hg τ] at key
  rw [cyclicCocycle_apply, smul_inv']
  by_cases h : (dlog g σ).val + (dlog g τ).val < Nat.card G
  · have hval : (dlog g (σ * τ)).val = (dlog g σ).val + (dlog g τ).val := by
      rw [dlog_mul hg, ZMod.val_add_of_lt h]
    rw [if_pos h, div_one, hval, ← key]
    apply Additive.ofMul.injective
    simp only [ofMul_mul, ofMul_div, ofMul_inv]
    abel
  · have h' : Nat.card G ≤ (dlog g σ).val + (dlog g τ).val := Nat.not_lt.1 h
    have hval : (dlog g (σ * τ)).val = (dlog g σ).val + (dlog g τ).val - Nat.card G := by
      rw [dlog_mul hg, ZMod.val_add_of_le h']
    have hsplit : (dlog g σ).val + (dlog g τ).val
        = Nat.card G + (dlog g (σ * τ)).val := by
      rw [hval]; omega
    rw [hsplit, cocyclePartial_card_add hg hf hf1] at key
    have hPk : cocyclePartial g f (dlog g (σ * τ)).val
        = cocyclePartial g f (dlog g σ).val * σ • cocyclePartial g f (dlog g τ).val *
            f (σ, τ) / cocyclePartial g f (Nat.card G) := by
      refine (div_eq_iff_eq_mul.2 ?_).symm
      rw [key]
      exact mul_comm _ _
    rw [if_neg h, hPk]
    apply Additive.ofMul.injective
    simp only [ofMul_mul, ofMul_div, ofMul_inv]
    abel

omit [Fintype G] in
/-- Dividing a multiplicative two-cocycle by the coboundary `σ ↦ σ • b` of a constant `1`-cochain
again yields a multiplicative two-cocycle. -/
theorem isMulCocycle₂_div_smul {f : G × G → M} (hf : IsMulCocycle₂ f) (b : M) :
    IsMulCocycle₂ (fun p : G × G => f p / p.1 • b) := by
  intro σ τ υ
  show f (σ * τ, υ) / (σ * τ) • b * (f (σ, τ) / σ • b)
      = σ • (f (τ, υ) / τ • b) * (f (σ, τ * υ) / σ • b)
  rw [smul_div', ← mul_smul, div_mul_div_comm, div_mul_div_comm, hf σ τ υ]

/-- Every multiplicative two-cocycle on a finite cyclic group `G` is cohomologous to the explicit
cocycle `cyclicCocycle g a` attached to some `G`-invariant `a : M`. -/
theorem exists_isMulCoboundary₂_div_cyclicCocycle (hg : ∀ x : G, x ∈ Subgroup.zpowers g)
    {f : G × G → M} (hf : IsMulCocycle₂ f) :
    ∃ a : M, (∀ σ : G, σ • a = a) ∧
      IsMulCoboundary₂ (fun p : G × G => f p / cyclicCocycle g a p) := by
  have hf' : IsMulCocycle₂ (fun p : G × G => f p / p.1 • f (1, 1)) :=
    isMulCocycle₂_div_smul hf _
  have hf'1 : (fun p : G × G => f p / p.1 • f (1, 1)) ((1 : G), (1 : G)) = 1 := by
    show f (1, 1) / (1 : G) • f (1, 1) = 1
    rw [one_smul, div_self']
  obtain ⟨a, ha, x, hx⟩ := exists_isMulCoboundary₂_div_cyclicCocycle_of_map_one hg hf' hf'1
  refine ⟨a, ha, fun σ => x σ * f (1, 1), fun σ τ => ?_⟩
  have hxst : σ • x τ / x (σ * τ) * x σ
      = f (σ, τ) / σ • f (1, 1) / cyclicCocycle g a (σ, τ) := hx σ τ
  show σ • (x τ * f (1, 1)) / (x (σ * τ) * f (1, 1)) * (x σ * f (1, 1))
      = f (σ, τ) / cyclicCocycle g a (σ, τ)
  rw [smul_mul']
  have e1 : σ • x τ * σ • f (1, 1) / (x (σ * τ) * f (1, 1)) * (x σ * f (1, 1))
      = σ • x τ / x (σ * τ) * x σ * σ • f (1, 1) := by
    apply Additive.ofMul.injective
    simp only [ofMul_mul, ofMul_div]
    abel
  rw [e1, hxst]
  apply Additive.ofMul.injective
  simp only [ofMul_mul, ofMul_div]
  abel

end Cyclic

/-! ### The consequence for the second cohomology group -/

section H2

variable {G M : Type} [Group G] [Fintype G] [CommGroup M] [MulDistribMulAction G M] {g : G}

/-- Every class in `H²(G, M)` for a finite cyclic group `G` is the class of an explicit cocycle
`cyclicCocycle g a` attached to a `G`-invariant `a : M`. -/
theorem exists_H2π_cyclicCocycle_eq (hg : ∀ x : G, x ∈ Subgroup.zpowers g)
    (x : H2 (Rep.ofMulDistribMulAction G M)) :
    ∃ (a : M) (ha : ∀ σ : G, σ • a = a),
      H2π (Rep.ofMulDistribMulAction G M)
        (cocyclesOfIsMulCocycle₂ (isMulCocycle₂_cyclicCocycle hg ha)) = x := by
  obtain ⟨f, hf, rfl⟩ := groupCohomology.exists_isMulCocycle₂_H2π_eq x
  obtain ⟨a, ha, hb⟩ := exists_isMulCoboundary₂_div_cyclicCocycle hg hf
  exact ⟨a, ha, ((H2π_eq_H2π_iff_isMulCoboundary₂_div hf
    (isMulCocycle₂_cyclicCocycle hg ha)).2 hb).symm⟩

end H2

/-! ### The cyclic Galois case -/

section Galois

variable {K L : Type*} [Field K] [Field L] [Algebra K L] [FiniteDimensional K L] [IsGalois K L]

/-- A unit of `L` fixed by the whole Galois group of a finite Galois extension `L / K` is the
image of a unit of `K`. -/
theorem exists_units_map_algebraMap_eq {m : Lˣ} (hm : ∀ σ : L ≃ₐ[K] L, σ • m = m) :
    ∃ b : Kˣ, Units.map (algebraMap K L).toMonoidHom b = m := by
  have hfix : ((m : L)) ∈ Set.range (algebraMap K L) :=
    (IsGalois.mem_range_algebraMap_iff_fixed (m : L)).2 fun φ => by
      simpa using congrArg Units.val (hm φ)
  obtain ⟨x, hx⟩ := hfix
  have hinv : ((m⁻¹ : Lˣ) : L) ∈ Set.range (algebraMap K L) :=
    (IsGalois.mem_range_algebraMap_iff_fixed _).2 fun φ => by
      simpa using congrArg (fun u : Lˣ => ((u⁻¹ : Lˣ) : L)) (hm φ)
  obtain ⟨y, hy⟩ := hinv
  have hxy : x * y = 1 := by
    refine (algebraMap K L).injective ?_
    rw [map_mul, hx, hy, map_one, ← Units.val_mul, mul_inv_cancel, Units.val_one]
  have hyx : y * x = 1 := by rw [mul_comm]; exact hxy
  exact ⟨⟨x, y, hxy, hyx⟩, Units.ext hx⟩

/-- For a finite cyclic Galois extension `L / K`, every multiplicative two-cocycle on `Gal(L/K)`
with values in `Lˣ` is cohomologous to the cyclic algebra cocycle of some `a : Kˣ`. -/
theorem exists_isMulCoboundary₂_div_cyclicUnitCocycle {σ₀ : L ≃ₐ[K] L}
    (hσ₀ : ∀ x : L ≃ₐ[K] L, x ∈ Subgroup.zpowers σ₀)
    {f : (L ≃ₐ[K] L) × (L ≃ₐ[K] L) → Lˣ} (hf : IsMulCocycle₂ f) :
    ∃ a : Kˣ, IsMulCoboundary₂
      (fun p : (L ≃ₐ[K] L) × (L ≃ₐ[K] L) => f p / cyclicUnitCocycle σ₀ a p) := by
  obtain ⟨m, hm, hb⟩ := exists_isMulCoboundary₂_div_cyclicCocycle hσ₀ hf
  obtain ⟨b, hbm⟩ := exists_units_map_algebraMap_eq hm
  refine ⟨b, ?_⟩
  simpa only [cyclicUnitCocycle, hbm] using hb

end Galois

end InverseGalois.CFT
