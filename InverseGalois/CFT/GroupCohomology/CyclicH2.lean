import Mathlib
import InverseGalois.CFT.GroupCohomology.CyclicSurjective

/-!
# The second cohomology of a finite cyclic group

Let `G` be a finite cyclic group, generated by `g`, acting on a commutative group `M` through a
`MulDistribMulAction`.  The two files
`InverseGalois.CFT.GroupCohomology.Cyclic` and
`InverseGalois.CFT.GroupCohomology.CyclicSurjective` attach to every `G`-invariant `a : M` an
explicit multiplicative two-cocycle `cyclicCocycle g a`, show that its class in `H²(G, M)`
vanishes exactly when `a` is a norm, and show that every class in `H²(G, M)` arises this way.

Here those two statements are packaged into the classical computation

`H²(G, M) ≅ M ^ G / N M`,

the identification of the second cohomology group of a finite cyclic group with the Tate group
`Ĥ⁰(G, M)`.

## Main definitions

* `InverseGalois.CFT.CyclicH2.invariantsSubgroup`: the subgroup `M ^ G` of `G`-invariants.
* `InverseGalois.CFT.CyclicH2.normHom`: the norm homomorphism `m ↦ ∏ σ : G, σ • m`.
* `InverseGalois.CFT.CyclicH2.normSubgroup`: its image `N M`, a subgroup of `M ^ G`.
* `InverseGalois.CFT.CyclicH2.h2OfInvariant`: the homomorphism `M ^ G → H²(G, M)` sending `a` to
  the class of `cyclicCocycle g a`.

## Main results

* `InverseGalois.CFT.CyclicH2.h2OfInvariant_surjective`: every class in `H²(G, M)` comes from a
  `G`-invariant element.
* `InverseGalois.CFT.CyclicH2.ker_h2OfInvariant`: the kernel of `h2OfInvariant` is the subgroup of
  norms.
* `InverseGalois.CFT.CyclicH2.h2CyclicEquiv`: the isomorphism `M ^ G / N M ≃* H²(G, M)`.
* `InverseGalois.CFT.CyclicH2.subsingleton_h2`: if every `G`-invariant element is a norm, then
  `H²(G, M)` is trivial.
-/

namespace InverseGalois.CFT

open groupCohomology

namespace CyclicH2

/-! ### Two elementary properties of the explicit cocycle -/

section Helpers

variable {G M : Type} [Group G] [CommGroup M]

/-- The explicit cocycle depends multiplicatively on the invariant element it is attached to. -/
theorem cyclicCocycle_mul (g : G) (a b : M) (p : G × G) :
    cyclicCocycle g a p * cyclicCocycle g b p = cyclicCocycle g (a * b) p := by
  simp only [cyclicCocycle]
  split <;> simp

/-- The explicit cocycle attached to the trivial element is the trivial cocycle. -/
theorem cyclicCocycle_one (g : G) : cyclicCocycle g (1 : M) = fun _ => 1 := by
  funext p
  simp only [cyclicCocycle]
  split <;> simp

end Helpers

/-! ### Invariants and norms -/

/-- The subgroup `M ^ G` of elements of `M` fixed by every element of `G`. -/
def invariantsSubgroup (G M : Type) [Group G] [CommGroup M] [MulDistribMulAction G M] :
    Subgroup M where
  carrier := {x : M | ∀ σ : G, σ • x = x}
  mul_mem' hx hy σ := by rw [smul_mul', hx σ, hy σ]
  one_mem' σ := smul_one σ
  inv_mem' hx σ := by rw [smul_inv', hx σ]

/-- The norm homomorphism `m ↦ ∏ σ : G, σ • m` of a finite group acting on a commutative
group. -/
def normHom (G M : Type) [Group G] [Fintype G] [CommGroup M] [MulDistribMulAction G M] :
    M →* M where
  toFun m := ∏ σ : G, σ • m
  map_one' := by simp
  map_mul' x y := by simp [smul_mul', Finset.prod_mul_distrib]

/-- The subgroup `N M` of norms, the image of the norm homomorphism. -/
def normSubgroup (G M : Type) [Group G] [Fintype G] [CommGroup M] [MulDistribMulAction G M] :
    Subgroup M :=
  (normHom G M).range

section Basic

variable {G M : Type} [Group G] [Fintype G] [CommGroup M] [MulDistribMulAction G M]

omit [Fintype G] in
/-- Membership in the subgroup of invariants. -/
theorem mem_invariantsSubgroup {x : M} :
    x ∈ invariantsSubgroup G M ↔ ∀ σ : G, σ • x = x := Iff.rfl

/-- Membership in the subgroup of norms. -/
theorem mem_normSubgroup {x : M} :
    x ∈ normSubgroup G M ↔ ∃ m : M, ∏ σ : G, σ • m = x := Iff.rfl

/-- The norm of an element is invariant: multiplying by `σ` permutes the factors. -/
theorem smul_prod_smul (σ : G) (m : M) : σ • ∏ τ : G, τ • m = ∏ τ : G, τ • m := by
  rw [Finset.smul_prod']
  exact Fintype.prod_equiv (Equiv.mulLeft σ) _ _ fun τ => (mul_smul σ τ m).symm

/-- Every norm is a `G`-invariant element. -/
theorem normSubgroup_le_invariantsSubgroup :
    normSubgroup G M ≤ invariantsSubgroup G M := by
  rintro x ⟨m, rfl⟩
  exact fun σ => smul_prod_smul σ m

end Basic

/-! ### The homomorphism from the invariants to `H²` -/

section H2

variable {G M : Type} [Group G] [Fintype G] [CommGroup M] [MulDistribMulAction G M] {g : G}

/-- The class in `H²(G, M)` of the explicit cocycle attached to a `G`-invariant element, as a
homomorphism from `M ^ G` to the multiplicative copy of `H²(G, M)`. -/
noncomputable def h2OfInvariant (hg : ∀ x : G, x ∈ Subgroup.zpowers g) :
    invariantsSubgroup G M →* Multiplicative (H2 (Rep.ofMulDistribMulAction G M)) where
  toFun a := Multiplicative.ofAdd (H2π (Rep.ofMulDistribMulAction G M)
    (cocyclesOfIsMulCocycle₂ (isMulCocycle₂_cyclicCocycle hg (mem_invariantsSubgroup.1 a.2))))
  map_one' := ofAdd_eq_one.2 ((H2π_cyclicCocycle_eq_zero_iff hg
    (mem_invariantsSubgroup.1 (1 : invariantsSubgroup G M).2)).2 ⟨1, by simp⟩)
  map_mul' a b := by
    show Multiplicative.ofAdd _ = Multiplicative.ofAdd _ * Multiplicative.ofAdd _
    rw [← ofAdd_add, ← map_add]
    refine congrArg Multiplicative.ofAdd (congrArg _ (Subtype.ext (funext fun p => ?_)))
    exact congrArg Additive.ofMul (cyclicCocycle_mul g (a : M) (b : M) p).symm

/-- The value of `h2OfInvariant` on a `G`-invariant element. -/
theorem h2OfInvariant_apply (hg : ∀ x : G, x ∈ Subgroup.zpowers g) {a : M}
    (ha : ∀ σ : G, σ • a = a) :
    h2OfInvariant hg ⟨a, ha⟩ = Multiplicative.ofAdd (H2π (Rep.ofMulDistribMulAction G M)
      (cocyclesOfIsMulCocycle₂ (isMulCocycle₂_cyclicCocycle hg ha))) := rfl

/-- Every class in `H²(G, M)` is the image of a `G`-invariant element. -/
theorem h2OfInvariant_surjective (hg : ∀ x : G, x ∈ Subgroup.zpowers g) :
    Function.Surjective (h2OfInvariant (M := M) hg) := by
  intro x
  obtain ⟨a, ha, hx⟩ := exists_H2π_cyclicCocycle_eq hg (Multiplicative.toAdd x)
  exact ⟨⟨a, ha⟩, congrArg Multiplicative.ofAdd hx⟩

/-- The kernel of `h2OfInvariant` consists exactly of the norms. -/
theorem ker_h2OfInvariant (hg : ∀ x : G, x ∈ Subgroup.zpowers g) :
    (h2OfInvariant (M := M) hg).ker
      = (normSubgroup G M).subgroupOf (invariantsSubgroup G M) := by
  ext a
  rw [MonoidHom.mem_ker, Subgroup.mem_subgroupOf, mem_normSubgroup, h2OfInvariant_apply hg a.2,
    ofAdd_eq_one]
  exact H2π_cyclicCocycle_eq_zero_iff hg a.2

/-- **The second cohomology of a finite cyclic group.**  For a finite cyclic group `G` acting on a
commutative group `M`, the quotient of the invariants `M ^ G` by the norms `N M` is isomorphic to
`H²(G, M)`. -/
noncomputable def h2CyclicEquiv (hg : ∀ x : G, x ∈ Subgroup.zpowers g) :
    (invariantsSubgroup G M ⧸ (normSubgroup G M).subgroupOf (invariantsSubgroup G M)) ≃*
      Multiplicative (H2 (Rep.ofMulDistribMulAction G M)) :=
  (QuotientGroup.quotientMulEquivOfEq (ker_h2OfInvariant hg).symm).trans
    (QuotientGroup.quotientKerEquivOfSurjective _ (h2OfInvariant_surjective hg))

/-- The isomorphism `M ^ G / N M ≃* H²(G, M)` is induced by `h2OfInvariant`. -/
theorem h2CyclicEquiv_mk (hg : ∀ x : G, x ∈ Subgroup.zpowers g) (a : invariantsSubgroup G M) :
    h2CyclicEquiv hg (QuotientGroup.mk a) = h2OfInvariant hg a := rfl

/-- If every `G`-invariant element of `M` is a norm, then `H²(G, M)` vanishes. -/
theorem subsingleton_h2 (hg : ∀ x : G, x ∈ Subgroup.zpowers g)
    (h : invariantsSubgroup G M ≤ normSubgroup G M) :
    Subsingleton (H2 (Rep.ofMulDistribMulAction G M)) := by
  have key : ∀ x : H2 (Rep.ofMulDistribMulAction G M), x = 0 := by
    intro x
    obtain ⟨a, ha, hx⟩ := exists_H2π_cyclicCocycle_eq hg x
    exact hx.symm.trans ((H2π_cyclicCocycle_eq_zero_iff hg ha).2 (h ha))
  exact ⟨fun x y => (key x).trans (key y).symm⟩

end H2

end CyclicH2

end InverseGalois.CFT
