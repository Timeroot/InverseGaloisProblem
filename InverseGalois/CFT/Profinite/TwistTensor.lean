import Mathlib
import InverseGalois.CFT.Profinite.TwistConj

/-!
# The twisting map of the tensor product is equivariant

The twisting construction takes a class the base group provides and a homomorphism of the
coefficients and returns a class of the first cohomology of a normal subgroup, and it is bilinear,
so it is a map out of a tensor product.  Conjugation by the ambient group moves both arguments: the
class the base group provides is moved by whatever action the base group carries, and the
homomorphism of the coefficients is moved by translating its argument backwards and its value
forwards.  **The twisting map out of the tensor product intertwines the two**, the tensor product
being moved factor by factor.

That is the whole of the equivariance, because a tensor product is generated by its pure tensors
and both sides of the equality are additive.  What it buys is that the identification of the first
cohomology with a tensor product is an identification of modules, not merely of groups: the ambient
group acts on the left through the two factors and on the right by conjugation, and the two agree.

Conjugation by an element of the normal subgroup is the identity on the first cohomology of that
subgroup, so for the action to be an action of the quotient the two factors have to be moved
trivially as well.  For the homomorphisms of the coefficients this is automatic once the subgroup
acts trivially on the source and on the target, which is recorded here.

## Main definitions

* `InverseGalois.CFT.homSMulHom`: conjugation of a homomorphism of the coefficients, packaged as a
  homomorphism of the group of such homomorphisms.

## Main results

* `InverseGalois.CFT.homSMul_eq_self_of_mem`: a subgroup acting trivially on the source and on the
  target acts trivially on the homomorphisms between them.
* `InverseGalois.CFT.conjH1_twistMap`: **the twisting map out of the tensor product is
  equivariant.**

## Tags

Galois cohomology, conjugation, twist, tensor product, equivariance
-/

namespace InverseGalois.CFT

open groupCohomology TensorProduct

/-! ### Conjugation of a homomorphism of the coefficients -/

section Hom

variable {G : Type*} [Group G] {M E : Type*} [CommGroup M] [CommGroup E]
variable [MulDistribMulAction G M] [MulDistribMulAction G E]

/-- **Conjugating a homomorphism of the coefficients is itself a homomorphism** of the group of
homomorphisms of the coefficients. -/
def homSMulHom (σ : G) : (M →* E) →* (M →* E) :=
  MonoidHom.mk' (homSMul σ) (homSMul_mul σ)

@[simp]
theorem homSMulHom_apply (σ : G) (w : M →* E) : homSMulHom σ w = homSMul σ w := rfl

variable {N : Subgroup G}

/-- **A subgroup acting trivially on the source and on the target acts trivially on the
homomorphisms between them**, so conjugation of a homomorphism of the coefficients is an action of
the quotient. -/
theorem homSMul_eq_self_of_mem (htrivM : ∀ (x : ↥N) (m : M), x • m = m)
    (htrivE : ∀ (x : ↥N) (e : E), x • e = e) {g : G} (hg : g ∈ N) (w : M →* E) :
    homSMul g w = w :=
  MonoidHom.ext fun m => by
    rw [homSMul_apply, show g⁻¹ • m = m from htrivM ⟨g⁻¹, N.inv_mem hg⟩ m,
      show g • w m = w m from htrivE ⟨g, hg⟩ (w m)]

end Hom

/-! ### The equivariance of the twisting map -/

section Twist

variable {G : Type*} [Group G] [TopologicalSpace G] [ContinuousMul G] {N : Subgroup G}
variable {M E A : Type*} [CommGroup M] [CommGroup E] [CommGroup A]
variable [MulDistribMulAction G M] [MulDistribMulAction G E]
variable (hN : N.Normal)
variable (htrivM : ∀ (x : ↥N) (m : M), x • m = m) (htrivE : ∀ (x : ↥N) (e : E), x • e = e)
variable (κ : A →* SmoothH1 ↥N M) (ρ : G → (A →* A))

/-- **The twisting map out of the tensor product is equivariant**: conjugating a twisted class is
moving the element of the base group by the action it carries and the homomorphism of the
coefficients by conjugation, one factor of the tensor product each. -/
theorem conjH1_twistMap (hκ : ∀ (σ : G) (a : A), conjH1 hN σ (κ a) = κ (ρ σ a)) (σ : G)
    (z : Additive A ⊗[ℤ] Additive (M →* E)) :
    MonoidHom.toAdditive (conjH1 hN σ) (twistMap htrivM htrivE κ z)
      = twistMap htrivM htrivE κ
        (TensorProduct.map (MonoidHom.toAdditive (ρ σ)).toIntLinearMap
          (MonoidHom.toAdditive (homSMulHom σ)).toIntLinearMap z) := by
  induction z using TensorProduct.induction_on with
  | zero => simp only [map_zero]
  | add z z' hz hz' => simp only [map_add, hz, hz']
  | tmul x y =>
    rw [TensorProduct.map_tmul]
    exact congrArg Additive.ofMul
      (conjH1_twistClass hN htrivM htrivE κ (fun σ a => ρ σ a) hκ σ x.toMul y.toMul)

end Twist

end InverseGalois.CFT
