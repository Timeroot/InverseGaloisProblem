import Mathlib
import InverseGalois.CFT.Kummer.RootIndex
import InverseGalois.CFT.Profinite.Krull
import InverseGalois.CFT.Profinite.SymbolCyclic

/-!
# The cyclic level cut out by the Kummer character

The Kummer character of a unit of the base is a homomorphism from the Galois group to the residues
modulo `n`, and an automorphism fixes the chosen `n`-th root of the unit exactly when the character
vanishes on it.  The subfield generated by that root is therefore a level whose fixing subgroup is
the kernel of the character.

That level is finite over the base, because the root kills a monic polynomial of degree `n`, and it
is Galois over the base, because an automorphism moves the root by a root of unity of the base and
so preserves the subfield.  Restriction to the level identifies two automorphisms exactly when the
character takes the same value on them, so when the character is surjective the level has degree
`n`, its Galois group is generated by the restriction of any automorphism whose character is one,
and the discrete logarithm to that generator computes the character.

## Main results

* `InverseGalois.CFT.kummerLevel`: **the level of a unit**, generated by its chosen `n`-th root.
* `InverseGalois.CFT.isGalois_kummerLevel`: **the level is Galois over the base.**
* `InverseGalois.CFT.mem_fixingSubgroup_kummerLevel_iff`: **the subgroup fixing the level is the
  kernel of the Kummer character.**
* `InverseGalois.CFT.exists_generator_kummerLevel`: **a unit whose Kummer character is surjective
  has a level of degree `n` whose Galois group is generated by an automorphism whose discrete
  logarithm computes the character.**

## Tags

Kummer theory, root of unity, cyclic extension, discrete logarithm, Galois theory
-/

namespace InverseGalois.CFT

open groupCohomology IntermediateField MulAction

section KummerLevel

variable {k Ω : Type*} [Field k] [Field Ω] [Algebra k Ω] [IsGalois k Ω] {n : ℕ} [NeZero n]
  {ζ : k} {hζ : IsPrimitiveRoot ζ n}

attribute [local instance] zmodTrivialAction isSmoothAction_zmod

/-! ### The chosen root of unity of the extension -/

variable (Ω hζ) in
omit [IsGalois k Ω] in
/-- The chosen root of unity of the extension is a primitive `n`-th root of unity there, because
the structure map of the extension is injective. -/
theorem isPrimitiveRoot_kummerRootUnit : IsPrimitiveRoot (kummerRootUnit Ω hζ) n :=
  (isPrimitiveRoot_primitiveRootUnit hζ).map_of_injective
    (f := Units.map (algebraMap k Ω : k →* Ω))
    (Units.map_injective (algebraMap k Ω).injective)

variable (h : IsKummerData k Ω (Multiplicative (ZMod n)) (zmodRootHom hζ) n)

/-! ### The Kummer character is a homomorphism -/

/-- The Kummer character of a unit takes the value zero at the identity. -/
theorem kummerChar_one (b : kˣ) : kummerChar h b 1 = 0 := by
  have hc := kummerChar_mul h b 1 1
  rw [mul_one] at hc
  exact left_eq_add.mp hc

/-- The Kummer character of a unit takes opposite values at inverse automorphisms. -/
theorem kummerChar_inv (b : kˣ) (g : Gal(Ω/k)) : kummerChar h b g⁻¹ = -kummerChar h b g := by
  have hc := kummerChar_mul h b g⁻¹ g
  rw [inv_mul_cancel, kummerChar_one] at hc
  exact eq_neg_of_add_eq_zero_left hc.symm

/-- The Kummer character of a unit multiplies by the exponent at a power. -/
theorem kummerChar_pow (b : kˣ) (g : Gal(Ω/k)) (m : ℕ) :
    kummerChar h b (g ^ m) = m • kummerChar h b g := by
  induction m with
  | zero => rw [pow_zero, zero_smul, kummerChar_one]
  | succ m ih => rw [pow_succ, kummerChar_mul, ih, succ_nsmul]

/-- The Kummer character of a unit at a power of an automorphism where it takes the value one is
the exponent. -/
theorem kummerChar_pow_of_eq_one {b : kˣ} {g : Gal(Ω/k)} (hg : kummerChar h b g = 1) (m : ℕ) :
    kummerChar h b (g ^ m) = (m : ZMod n) := by
  rw [kummerChar_pow, hg, nsmul_eq_mul, mul_one]

/-! ### The character measures the motion of the root -/

/-- **An automorphism fixes the chosen root of a unit exactly when the Kummer character of the unit
vanishes on it.** -/
theorem smul_root_eq_self_iff (b : kˣ) (g : Gal(Ω/k)) :
    g • h.root b = h.root b ↔ kummerChar h b g = 0 := by
  rw [smul_root_eq_kummerRootUnit_pow h b g]
  refine ⟨fun hg => ?_, fun hg => by rw [hg, ZMod.val_zero, pow_zero, one_mul]⟩
  have h1 : kummerRootUnit Ω hζ ^ (kummerChar h b g).val = 1 :=
    mul_right_cancel (b := h.root b) (hg.trans (one_mul (h.root b)).symm)
  have h2 := ((isPrimitiveRoot_kummerRootUnit Ω hζ).pow_eq_one_iff_dvd _).mp h1
  exact (ZMod.val_eq_zero _).mp (Nat.eq_zero_of_dvd_of_lt h2 (ZMod.val_lt _))

/-! ### The level of a unit -/

/-- **The level of a unit of the base**: the subfield of the extension generated by the chosen
`n`-th root of the unit. -/
noncomputable def kummerLevel (b : kˣ) : IntermediateField k Ω := k⟮((h.root b : Ωˣ) : Ω)⟯

omit [IsGalois k Ω] in
theorem kummerLevel_eq (b : kˣ) : kummerLevel h b = k⟮((h.root b : Ωˣ) : Ω)⟯ := rfl

omit [IsGalois k Ω] in
/-- The chosen root of a unit lies in its level. -/
theorem root_mem_kummerLevel (b : kˣ) : ((h.root b : Ωˣ) : Ω) ∈ kummerLevel h b :=
  mem_adjoin_simple_self k _

omit [IsGalois k Ω] in
/-- The chosen root of a unit is integral over the base, being a root of a monic polynomial of
degree `n`. -/
theorem isIntegral_kummerRoot (b : kˣ) : IsIntegral k ((h.root b : Ωˣ) : Ω) := by
  refine ⟨Polynomial.X ^ n - Polynomial.C (b : k),
    Polynomial.monic_X_pow_sub_C _ (NeZero.ne n), ?_⟩
  have hp : ((h.root b : Ωˣ) : Ω) ^ n = algebraMap k Ω (b : k) := congrArg Units.val (h.root_pow b)
  simp [hp]

omit [IsGalois k Ω] in
/-- The level of a unit is finite over the base. -/
theorem finiteDimensional_kummerLevel (b : kˣ) : FiniteDimensional k ↥(kummerLevel h b) :=
  adjoin.finiteDimensional (isIntegral_kummerRoot h b)

/-- **An automorphism carries the chosen root of a unit into the level of the unit**, because it
multiplies it by a root of unity of the base. -/
theorem smul_root_mem_kummerLevel (b : kˣ) (σ : Gal(Ω/k)) :
    σ ((h.root b : Ωˣ) : Ω) ∈ kummerLevel h b := by
  have hs := congrArg Units.val (smul_root_eq_kummerRootUnit_pow h b σ)
  simp only [Units.val_mul, Units.val_pow_eq_pow_val, kummerRootUnit, Units.coe_map,
    MonoidHom.coe_coe] at hs
  rw [show σ ((h.root b : Ωˣ) : Ω) = ((σ • h.root b : Ωˣ) : Ω) from rfl, hs]
  exact mul_mem (pow_mem (IntermediateField.algebraMap_mem _ _) _) (root_mem_kummerLevel h b)

/-- The level of a unit is normal over the base. -/
theorem normal_kummerLevel (b : kˣ) : Normal k ↥(kummerLevel h b) := by
  rw [normal_iff_forall_map_le']
  intro σ
  rw [kummerLevel_eq, adjoin_map]
  refine adjoin_le_iff.mpr ?_
  rintro y ⟨x, hx, rfl⟩
  rw [Set.mem_singleton_iff] at hx
  subst hx
  exact smul_root_mem_kummerLevel h b σ

/-- **The level of a unit is Galois over the base.** -/
theorem isGalois_kummerLevel (b : kˣ) : IsGalois k ↥(kummerLevel h b) := by
  haveI := normal_kummerLevel h b
  haveI := Algebra.isSeparable_tower_bot_of_isSeparable k ↥(kummerLevel h b) Ω
  exact ⟨⟩

attribute [local instance] finiteDimensional_kummerLevel isGalois_kummerLevel

/-! ### Restriction to the level is the Kummer character -/

/-- **The subgroup fixing the level of a unit is the kernel of the Kummer character.** -/
theorem mem_fixingSubgroup_kummerLevel_iff (b : kˣ) (g : Gal(Ω/k)) :
    g ∈ (kummerLevel h b).fixingSubgroup ↔ kummerChar h b g = 0 := by
  rw [kummerLevel_eq, fixingSubgroup_adjoin_simple_eq_stabilizer, mem_stabilizer_iff,
    ← smul_root_eq_self_iff h b g]
  exact ⟨fun hx => Units.ext hx, fun hx => congrArg Units.val hx⟩

/-- **An automorphism restricts to the identity on the level of a unit exactly when the Kummer
character of the unit vanishes on it.** -/
theorem restrictNormalHom_kummerLevel_eq_one_iff (b : kˣ) (g : Gal(Ω/k)) :
    AlgEquiv.restrictNormalHom ↥(kummerLevel h b) g = 1 ↔ kummerChar h b g = 0 := by
  rw [← MonoidHom.mem_ker, IntermediateField.restrictNormalHom_ker,
    mem_fixingSubgroup_kummerLevel_iff]

/-- **Two automorphisms have the same restriction to the level of a unit exactly when the Kummer
character of the unit takes the same value on them.** -/
theorem restrictNormalHom_kummerLevel_eq_iff (b : kˣ) (g g' : Gal(Ω/k)) :
    AlgEquiv.restrictNormalHom ↥(kummerLevel h b) g
        = AlgEquiv.restrictNormalHom ↥(kummerLevel h b) g' ↔
      kummerChar h b g = kummerChar h b g' := by
  rw [← inv_mul_eq_one, ← map_inv, ← map_mul, restrictNormalHom_kummerLevel_eq_one_iff,
    kummerChar_mul, kummerChar_inv, neg_add_eq_zero, eq_comm]

/-! ### A surjective character makes the level cyclic of degree `n` -/

/-- **The level of a unit whose Kummer character is surjective is a cyclic extension of degree `n`
of the base whose discrete logarithm computes the character.**  Restriction to the level identifies
two automorphisms exactly when the character agrees on them, so the restriction of an automorphism
whose character is one generates a group of order `n`. -/
theorem exists_generator_kummerLevel (b : kˣ) {g₀ : Gal(Ω/k)} (hg₀ : kummerChar h b g₀ = 1) :
    ∃ σ₀ : Gal(↥(kummerLevel h b)/k),
      (∀ x : Gal(↥(kummerLevel h b)/k), x ∈ Subgroup.zpowers σ₀) ∧
      Nat.card Gal(↥(kummerLevel h b)/k) = n ∧
      ∀ g : Gal(Ω/k),
        (dlog σ₀ (AlgEquiv.restrictNormalHom ↥(kummerLevel h b) g)).val
          = (kummerChar h b g).val := by
  haveI : Fintype Gal(↥(kummerLevel h b)/k) := AlgEquiv.fintype k ↥(kummerLevel h b)
  set σ₀ := AlgEquiv.restrictNormalHom (F := k) (K₁ := Ω) ↥(kummerLevel h b) g₀ with hσ₀def
  have key : ∀ g : Gal(Ω/k),
      AlgEquiv.restrictNormalHom ↥(kummerLevel h b) g = σ₀ ^ (kummerChar h b g).val := by
    intro g
    rw [hσ₀def, ← map_pow]
    refine (restrictNormalHom_kummerLevel_eq_iff h b g (g₀ ^ (kummerChar h b g).val)).mpr ?_
    rw [kummerChar_pow_of_eq_one h hg₀]
    exact (ZMod.natCast_rightInverse _).symm
  have hgen : ∀ x : Gal(↥(kummerLevel h b)/k), x ∈ Subgroup.zpowers σ₀ := by
    intro x
    obtain ⟨g, rfl⟩ := restrictNormalHom_surjective_level (kummerLevel h b) x
    rw [key g]
    exact Subgroup.pow_mem _ (Subgroup.mem_zpowers σ₀) _
  have horder : orderOf σ₀ = n := by
    refine (orderOf_eq_iff (Nat.pos_of_ne_zero (NeZero.ne n))).mpr ⟨?_, fun m hmn hm hcon => ?_⟩
    · rw [hσ₀def, ← map_pow, restrictNormalHom_kummerLevel_eq_one_iff,
        kummerChar_pow_of_eq_one h hg₀, ZMod.natCast_self]
    · rw [hσ₀def, ← map_pow, restrictNormalHom_kummerLevel_eq_one_iff,
        kummerChar_pow_of_eq_one h hg₀, ZMod.natCast_eq_zero_iff] at hcon
      exact absurd (Nat.le_of_dvd hm hcon) (Nat.not_le.mpr hmn)
  have hcard : Nat.card Gal(↥(kummerLevel h b)/k) = n := by
    rw [← orderOf_of_forall_mem_zpowers hgen, horder]
  refine ⟨σ₀, hgen, hcard, fun g => ?_⟩
  have h2 : σ₀ ^ (dlog σ₀ (AlgEquiv.restrictNormalHom ↥(kummerLevel h b) g)).val
      = σ₀ ^ (kummerChar h b g).val := by
    rw [pow_val_dlog hgen, key g]
  have h3 := pow_eq_pow_iff_modEq.mp h2
  rw [horder, Nat.ModEq] at h3
  have hlt : (dlog σ₀ (AlgEquiv.restrictNormalHom ↥(kummerLevel h b) g)).val < n :=
    lt_of_lt_of_le (val_dlog_lt σ₀ _) hcard.le
  rwa [Nat.mod_eq_of_lt hlt, Nat.mod_eq_of_lt (ZMod.val_lt _)] at h3

end KummerLevel

end InverseGalois.CFT
