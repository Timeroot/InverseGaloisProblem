import Mathlib
import InverseGalois.CFT.Local.CyclicNormIndex

/-!
# A radical extension of a local field always has a unit which is not a norm

Let `K` be a local field containing a primitive `q`-th root of unity for a prime `q`, and let `a` be
an element of `K` which is not a `q`-th power.  Then `X ^ q - a` is irreducible, its splitting field
is a cyclic extension of `K` of degree `q`, and the norm index of a cyclic extension of a local
field is its degree.  So some unit of `K` fails to be a norm from `K(q√a)`.

Written with the norm residue symbol `(a, c)` — the class of the cyclic algebra of `K(q√a)` with
coefficient `c`, equivalently the value by which the Artin symbol of `c` moves `q√a` — this says
that the symbol is nondegenerate in its second argument: for every `a` which is not a `q`-th power
there is a `c` with `(a, c) ≠ 1`.  That is the local duality between the first cohomology with
coefficients in the `q`-th roots of unity and the first cohomology with coefficients in the integers
modulo `q`, in the only shape in which the arithmetic of embedding problems consumes it.

## Main results

* `InverseGalois.CFT.exists_notMem_normSubgroup_of_isSplittingField`: **the splitting field of
  `X ^ q - a` over a local field with a primitive `q`-th root of unity has a unit of the base field
  which is not a norm**, as soon as `a` is not a `q`-th power.
* `InverseGalois.CFT.exists_cyclic_notMem_normSubgroup`: the same, packaged with the construction of
  the extension: **a local field with a primitive `q`-th root of unity has, for every element which
  is not a `q`-th power, a cyclic extension of degree `q` generated by a `q`-th root of it in which
  some unit of the base field is not a norm.**

## Tags

local field, norm index, Kummer extension, radical extension, norm residue symbol, local duality
-/

namespace InverseGalois.CFT

open Module

open scoped Valued WithZero

variable (K : Type) [Field K] [Valued K ℤᵐ⁰]
  [Valuation.RankOne (Valued.v : Valuation K ℤᵐ⁰)] [CompleteSpace K] [ProperSpace K] {p e : ℕ}

/-! ### The splitting field of a radical polynomial -/

variable (L : Type) [Field L] [Algebra K L] [FiniteDimensional K L]

/-- **The splitting field of `X ^ q - a` over a local field with a primitive `q`-th root of unity
has a unit of the base field which is not a norm**, as soon as `a` is not a `q`-th power.  The
polynomial is then irreducible, so the splitting field is cyclic of degree the prime `q`, and the
norm index of a cyclic extension of a local field is its degree. -/
theorem exists_notMem_normSubgroup_of_isSplittingField {q : ℕ} (hq : q.Prime) {ζ : K}
    (hζ : IsPrimitiveRoot ζ q) {a : K} (ha : ∀ b : K, b ^ q ≠ a)
    [Polynomial.IsSplittingField K L (Polynomial.X ^ q - Polynomial.C a)]
    (hres : HasResidueChar K p e) :
    ∃ c : Kˣ, c ∉ normSubgroup K L := by
  have hirr : Irreducible (Polynomial.X ^ q - Polynomial.C a) :=
    X_pow_sub_C_irreducible_of_prime hq ha
  have hprim : (primitiveRoots q K).Nonempty := ⟨ζ, (mem_primitiveRoots hq.pos).2 hζ⟩
  haveI : NeZero q := ⟨hq.ne_zero⟩
  haveI : IsGalois K L := isGalois_of_isSplittingField_X_pow_sub_C hprim hirr L
  haveI : IsCyclic (L ≃ₐ[K] L) := isCyclic_of_isSplittingField_X_pow_sub_C hprim hirr L
  have hrank : finrank K L = q := finrank_of_isSplittingField_X_pow_sub_C hprim hirr L
  exact exists_notMem_normSubgroup K L hres (by rw [hrank]; exact hq.one_lt)

/-! ### The extension built from a root -/

/-- **A local field with a primitive `q`-th root of unity has, for every element which is not a
`q`-th power, a cyclic extension of degree `q` generated by a `q`-th root of it in which some unit
of the base field is not a norm.**  The extension is the one obtained by adjoining a root of
`X ^ q - a`. -/
theorem exists_cyclic_notMem_normSubgroup {q : ℕ} (hq : q.Prime) {ζ : K}
    (hζ : IsPrimitiveRoot ζ q) {a : K} (ha : ∀ b : K, b ^ q ≠ a) (hres : HasResidueChar K p e) :
    ∃ (M : Type) (_ : Field M) (_ : Algebra K M) (_ : FiniteDimensional K M), IsGalois K M ∧
      IsCyclic (M ≃ₐ[K] M) ∧ finrank K M = q ∧ (∃ α : M, α ^ q = algebraMap K M a) ∧
        ∃ c : Kˣ, c ∉ normSubgroup K M := by
  have hirr : Irreducible (Polynomial.X ^ q - Polynomial.C a) :=
    X_pow_sub_C_irreducible_of_prime hq ha
  have hprim : (primitiveRoots q K).Nonempty := ⟨ζ, (mem_primitiveRoots hq.pos).2 hζ⟩
  haveI : NeZero q := ⟨hq.ne_zero⟩
  haveI := Fact.mk hirr
  set M := AdjoinRoot (Polynomial.X ^ q - Polynomial.C a) with hM
  haveI : Polynomial.IsSplittingField K M (Polynomial.X ^ q - Polynomial.C a) :=
    isSplittingField_AdjoinRoot_X_pow_sub_C hprim hirr
  haveI : FiniteDimensional K M :=
    Polynomial.IsSplittingField.finiteDimensional M (Polynomial.X ^ q - Polynomial.C a)
  haveI : IsGalois K M := isGalois_of_isSplittingField_X_pow_sub_C hprim hirr M
  haveI : IsCyclic (M ≃ₐ[K] M) := isCyclic_of_isSplittingField_X_pow_sub_C hprim hirr M
  refine ⟨M, inferInstance, inferInstance, inferInstance, inferInstance, inferInstance,
    finrank_of_isSplittingField_X_pow_sub_C hprim hirr M,
    ⟨AdjoinRoot.root _, ?_⟩,
    exists_notMem_normSubgroup_of_isSplittingField K M hq hζ ha hres⟩
  rw [AdjoinRoot.algebraMap_eq]
  exact root_X_pow_sub_C_pow q a

end InverseGalois.CFT
