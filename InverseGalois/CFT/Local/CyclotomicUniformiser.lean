import Mathlib
import InverseGalois.CFT.Local.NatValuation
import InverseGalois.CFT.Local.RootOfUnityValued

/-!
# The opposite of a prime as a power of the difference of a root of unity and one

A prime of odd order factors, in a ring containing a primitive root of unity of that order, as the
product of the partial geometric sums of the root times the corresponding power of the difference
of the root and one.  Each partial geometric sum is congruent to the number of its terms modulo
that difference, so the whole product is congruent to the factorial of one less than the prime,
which is congruent to minus one by Wilson's theorem.

In a valued field of that residue characteristic the difference of the root and one is therefore a
root, up to a factor congruent to one, of the *opposite* of the prime.  That is the first step of
the identification of the completion at the ramified place as a radical extension: the extension
generated by a root of unity of prime order is generated by a root of the opposite of that prime.

## Main results

* `InverseGalois.CFT.prod_geomSum_mul_pow_sub_one`: **a prime of odd order is the product of the
  partial geometric sums of a primitive root of unity of that order, times the corresponding power
  of the difference of the root and one.**
* `InverseGalois.CFT.valued_prod_sub_prod_lt_one`: two products of elements of the valuation ring
  whose factors are congruent are congruent.
* `InverseGalois.CFT.valued_prod_geomSum_add_one_lt_one`: **the product of the partial geometric
  sums of a primitive root of unity of prime order is congruent to minus one.**
* `InverseGalois.CFT.valued_sub_one_lt_one`: **a primitive root of unity of prime order is
  congruent to one** in a valued field of that residue characteristic.
* `InverseGalois.CFT.exists_pow_sub_one_eq_neg_natCast_mul`: **the power of exponent one less than
  the prime of the difference of a primitive root of unity of that order and one is the opposite of
  the prime, times a factor congruent to one.**

## Tags

valued field, root of unity, cyclotomic field, uniformiser, Wilson's theorem, residue field
-/

namespace InverseGalois.CFT

open scoped WithZero

/-! ### The factorisation of the prime -/

section Domain

variable {R : Type*} [CommRing R] [IsDomain R]

/-- **A number of odd order is the product of the partial geometric sums of a primitive root of
unity of that order, times the corresponding power of the difference of the root and one.**  Each
factor of the classical product formula for the order is the opposite of one such partial sum times
that difference, and the signs cancel because one less than an odd number is even. -/
theorem prod_geomSum_mul_pow_sub_one {q : ℕ} (hq : Odd q) {ζ : R} (hζ : IsPrimitiveRoot ζ q) :
    (∏ k ∈ Finset.range (q - 1), ∑ i ∈ Finset.range (k + 1), ζ ^ i) * (ζ - 1) ^ (q - 1)
      = (q : R) := by
  obtain ⟨m, rfl⟩ := hq
  have hsub : 2 * m + 1 - 1 = 2 * m := by omega
  rw [hsub]
  have hprod := hζ.prod_one_sub_pow_eq_order
  have hrw : ∀ k ∈ Finset.range (2 * m),
      (1 : R) - ζ ^ (k + 1) = -1 * ((∑ i ∈ Finset.range (k + 1), ζ ^ i) * (ζ - 1)) := by
    intro k _
    rw [geom_sum_mul]
    ring
  rw [Finset.prod_congr rfl hrw, Finset.prod_mul_distrib, Finset.prod_const, Finset.card_range,
    Finset.prod_mul_distrib, Finset.prod_const, Finset.card_range,
    Even.neg_one_pow ⟨m, by ring⟩, one_mul] at hprod
  rw [hprod]
  push_cast
  ring

end Domain

/-! ### Congruences between products -/

section Products

variable {A : Type*} [Field A] [Valued A ℤᵐ⁰]

/-- A product of elements of the valuation ring lies in the valuation ring. -/
theorem valued_prod_le_one {ι : Type*} {s : Finset ι} {f : ι → A}
    (hf : ∀ i ∈ s, Valued.v (f i) ≤ 1) : Valued.v (∏ i ∈ s, f i) ≤ 1 := by
  rw [map_prod]
  exact Finset.prod_le_one' hf

/-- **Two products of elements of the valuation ring whose factors are congruent modulo the
maximal ideal are congruent modulo the maximal ideal.** -/
theorem valued_prod_sub_prod_lt_one {ι : Type*} {s : Finset ι} {f g : ι → A}
    (hf : ∀ i ∈ s, Valued.v (f i) ≤ 1) (hg : ∀ i ∈ s, Valued.v (g i) ≤ 1)
    (h : ∀ i ∈ s, Valued.v (f i - g i) < 1) :
    Valued.v ((∏ i ∈ s, f i) - ∏ i ∈ s, g i) < 1 := by
  classical
  revert hf hg h
  induction s using Finset.induction_on with
  | empty =>
    intro _ _ _
    simp
  | @insert a s ha ih =>
    intro hf hg h
    rw [Finset.prod_insert ha, Finset.prod_insert ha]
    have hkey : f a * (∏ i ∈ s, f i) - g a * ∏ i ∈ s, g i
        = (f a - g a) * (∏ i ∈ s, f i) + g a * ((∏ i ∈ s, f i) - ∏ i ∈ s, g i) := by ring
    rw [hkey]
    refine lt_of_le_of_lt (Valuation.map_add Valued.v _ _) (max_lt ?_ ?_)
    · rw [Valuation.map_mul]
      calc Valued.v (f a - g a) * Valued.v (∏ i ∈ s, f i)
          ≤ Valued.v (f a - g a) * 1 :=
            mul_le_mul_right (valued_prod_le_one fun i hi => hf i (Finset.mem_insert_of_mem hi)) _
        _ = Valued.v (f a - g a) := mul_one _
        _ < 1 := h a (Finset.mem_insert_self a s)
    · rw [Valuation.map_mul]
      calc Valued.v (g a) * Valued.v ((∏ i ∈ s, f i) - ∏ i ∈ s, g i)
          ≤ 1 * Valued.v ((∏ i ∈ s, f i) - ∏ i ∈ s, g i) :=
            mul_le_mul_left (hg a (Finset.mem_insert_self a s)) _
        _ = Valued.v ((∏ i ∈ s, f i) - ∏ i ∈ s, g i) := one_mul _
        _ < 1 := ih (fun i hi => hf i (Finset.mem_insert_of_mem hi))
            (fun i hi => hg i (Finset.mem_insert_of_mem hi))
            (fun i hi => h i (Finset.mem_insert_of_mem hi))

end Products

/-! ### The partial geometric sums of a root of unity -/

section GeomSum

variable {A : Type*} [Field A] [Valued A ℤᵐ⁰] {ζ : A}

/-- A partial geometric sum of an element of the valuation ring lies in the valuation ring. -/
theorem valued_geomSum_le_one (hζv : Valued.v ζ ≤ 1) (j : ℕ) :
    Valued.v (∑ i ∈ Finset.range j, ζ ^ i) ≤ 1 :=
  Valuation.map_sum_le Valued.v fun t _ => by
    rw [Valuation.map_pow]
    exact pow_le_one' hζv t

/-- **A partial geometric sum of an element of the valuation ring congruent to one is congruent to
the number of its terms.** -/
theorem valued_geomSum_sub_natCast_lt_one (hζv : Valued.v ζ ≤ 1) (hζ1 : Valued.v (ζ - 1) < 1)
    (j : ℕ) : Valued.v ((∑ i ∈ Finset.range j, ζ ^ i) - (j : A)) < 1 := by
  have hsum : (∑ i ∈ Finset.range j, ζ ^ i) - (j : A)
      = ∑ i ∈ Finset.range j, (ζ ^ i - 1) := by
    rw [Finset.sum_sub_distrib, Finset.sum_const, Finset.card_range, nsmul_eq_mul, mul_one]
  rw [hsum]
  refine Valuation.map_sum_lt' Valued.v zero_lt_one fun i _ => ?_
  rw [← geom_sum_mul ζ i, Valuation.map_mul]
  calc Valued.v (∑ t ∈ Finset.range i, ζ ^ t) * Valued.v (ζ - 1)
      ≤ 1 * Valued.v (ζ - 1) := mul_le_mul_left (valued_geomSum_le_one hζv i) _
    _ = Valued.v (ζ - 1) := one_mul _
    _ < 1 := hζ1

/-- **The product of the partial geometric sums of an element of the valuation ring congruent to
one is congruent to the factorial.** -/
theorem valued_prod_geomSum_sub_factorial_lt_one (hζv : Valued.v ζ ≤ 1)
    (hζ1 : Valued.v (ζ - 1) < 1) (n : ℕ) :
    Valued.v ((∏ k ∈ Finset.range n, ∑ i ∈ Finset.range (k + 1), ζ ^ i)
      - ((n.factorial : ℕ) : A)) < 1 := by
  have hfac : ((n.factorial : ℕ) : A) = ∏ k ∈ Finset.range n, ((k + 1 : ℕ) : A) := by
    rw [← Nat.cast_prod, Finset.prod_range_add_one_eq_factorial]
  rw [hfac]
  refine valued_prod_sub_prod_lt_one (fun k _ => valued_geomSum_le_one hζv (k + 1))
    (fun k _ => valued_natCast_le_one _) fun k _ => ?_
  simpa using valued_geomSum_sub_natCast_lt_one hζv hζ1 (k + 1)

/-- **The product of the partial geometric sums of a primitive root of unity of prime order is
congruent to minus one**, the factorial of one less than a prime being congruent to minus one by
Wilson's theorem. -/
theorem valued_prod_geomSum_add_one_lt_one {q : ℕ} (hq : q.Prime) (hζv : Valued.v ζ ≤ 1)
    (hζ1 : Valued.v (ζ - 1) < 1) (hqv : Valued.v ((q : ℕ) : A) < 1) :
    Valued.v ((∏ k ∈ Finset.range (q - 1), ∑ i ∈ Finset.range (k + 1), ζ ^ i) + 1) < 1 := by
  haveI : Fact q.Prime := ⟨hq⟩
  obtain ⟨c, hc⟩ : q ∣ (q - 1).factorial + 1 := by
    have hw : (((q - 1).factorial : ℕ) : ZMod q) = -1 := ZMod.wilsons_lemma q
    rw [← ZMod.natCast_eq_zero_iff, Nat.cast_add, Nat.cast_one, hw, neg_add_cancel]
  have hsplit : (∏ k ∈ Finset.range (q - 1), ∑ i ∈ Finset.range (k + 1), ζ ^ i) + 1
      = ((∏ k ∈ Finset.range (q - 1), ∑ i ∈ Finset.range (k + 1), ζ ^ i)
          - (((q - 1).factorial : ℕ) : A)) + (((q - 1).factorial + 1 : ℕ) : A) := by
    push_cast
    ring
  rw [hsplit]
  refine lt_of_le_of_lt (Valuation.map_add Valued.v _ _)
    (max_lt (valued_prod_geomSum_sub_factorial_lt_one hζv hζ1 _) ?_)
  rw [hc, Nat.cast_mul, Valuation.map_mul]
  calc Valued.v ((q : ℕ) : A) * Valued.v ((c : ℕ) : A)
      ≤ Valued.v ((q : ℕ) : A) * 1 := mul_le_mul_right (valued_natCast_le_one _) _
    _ = Valued.v ((q : ℕ) : A) := mul_one _
    _ < 1 := hqv

end GeomSum

/-! ### A root of unity of the residue characteristic -/

section Congruent

variable {A : Type*} [Field A] [Valued A ℤᵐ⁰] {ζ : A}

/-- Every nontrivial power of a primitive root of unity of prime order is at least as far from one
as the root itself: the root is a power of that power. -/
theorem valued_sub_one_le_valued_pow_sub_one {q : ℕ} (hq : q.Prime) (hζ : IsPrimitiveRoot ζ q)
    (hζv : Valued.v ζ ≤ 1) {a : ℕ} (ha : ¬ q ∣ a) :
    Valued.v (1 - ζ) ≤ Valued.v (1 - ζ ^ a) := by
  haveI : NeZero q := ⟨hq.ne_zero⟩
  have hcop : a.Coprime q := (Nat.coprime_comm.mp ((Nat.Prime.coprime_iff_not_dvd hq).mpr ha))
  obtain ⟨b, -, hb⟩ := (hζ.pow_of_coprime a hcop).eq_pow_of_pow_eq_one hζ.pow_eq_one
  have hg : (∑ i ∈ Finset.range b, (ζ ^ a) ^ i) * (ζ ^ a - 1) = ζ - 1 := by
    rw [geom_sum_mul, hb]
  have hfac : (1 : A) - ζ = (∑ t ∈ Finset.range b, (ζ ^ a) ^ t) * (1 - ζ ^ a) := by
    linear_combination hg
  rw [hfac, Valuation.map_mul]
  calc Valued.v (∑ t ∈ Finset.range b, (ζ ^ a) ^ t) * Valued.v (1 - ζ ^ a)
      ≤ 1 * Valued.v (1 - ζ ^ a) := by
        refine mul_le_mul_left (valued_geomSum_le_one ?_ b) _
        rw [Valuation.map_pow]
        exact pow_le_one' hζv a
    _ = Valued.v (1 - ζ ^ a) := one_mul _

/-- **A primitive root of unity of prime order is congruent to one** in a valued field in which
that prime is not a unit: the product of the differences of one and the nontrivial powers of the
root is the prime, and every factor of that product is at least as small as the difference of one
and the root itself. -/
theorem valued_sub_one_lt_one {q : ℕ} (hq : q.Prime) (hζ : IsPrimitiveRoot ζ q)
    (hqv : Valued.v ((q : ℕ) : A) < 1) : Valued.v (ζ - 1) < 1 := by
  have hζv : Valued.v ζ = 1 := valued_eq_one_of_pow_eq_one₀ hq.ne_zero hζ.pow_eq_one
  obtain ⟨n, hn⟩ : ∃ n, q = n + 1 := ⟨q - 1, by have := hq.pos; omega⟩
  have hprod : ∏ k ∈ Finset.range n, ((1 : A) - ζ ^ (k + 1)) = (q : A) := by
    rw [hn] at hζ ⊢
    rw [hζ.prod_one_sub_pow_eq_order]
    push_cast
    ring
  have hle : Valued.v (1 - ζ) ^ n ≤ Valued.v ((q : ℕ) : A) := by
    rw [← hprod, map_prod]
    calc Valued.v (1 - ζ) ^ n = ∏ _k ∈ Finset.range n, Valued.v (1 - ζ) := by
          rw [Finset.prod_const, Finset.card_range]
      _ ≤ ∏ k ∈ Finset.range n, Valued.v (1 - ζ ^ (k + 1)) := by
          refine Finset.prod_le_prod' fun k hk => ?_
          refine valued_sub_one_le_valued_pow_sub_one hq hζ (le_of_eq hζv) ?_
          rw [hn]
          exact Nat.not_dvd_of_pos_of_lt (Nat.succ_pos k)
            (Nat.succ_lt_succ (Finset.mem_range.mp hk))
  have hle1 : Valued.v (1 - ζ) ≤ 1 := by
    refine le_trans (Valuation.map_sub Valued.v 1 ζ) ?_
    rw [Valuation.map_one, hζv]
    exact le_of_eq (max_self 1)
  have hlt : Valued.v (1 - ζ) ^ n < 1 := lt_of_le_of_lt hle hqv
  have hfin : Valued.v (1 - ζ) < 1 := by
    rcases lt_or_eq_of_le hle1 with h | h
    · exact h
    · rw [h, one_pow] at hlt
      exact absurd hlt (lt_irrefl 1)
  rwa [← Valuation.map_neg, neg_sub] at hfin

end Congruent

/-! ### The difference of the root and one as a radical -/

section Radical

variable {A : Type*} [Field A] [Valued A ℤᵐ⁰] {ζ : A}

/-- **The power of exponent one less than an odd prime of the difference of a primitive root of
unity of that order and one is the opposite of the prime, times a factor congruent to one.**  The
prime is the product of the partial geometric sums of the root times that power, and the product of
the partial geometric sums is congruent to minus one. -/
theorem exists_pow_sub_one_eq_neg_natCast_mul {q : ℕ} (hq : q.Prime) (hodd : Odd q)
    (hζ : IsPrimitiveRoot ζ q) (hqv : Valued.v ((q : ℕ) : A) < 1) :
    ∃ u : A, Valued.v (u - 1) < 1 ∧ (ζ - 1) ^ (q - 1) = -((q : ℕ) : A) * u := by
  have hζv : Valued.v ζ = 1 := valued_eq_one_of_pow_eq_one₀ hq.ne_zero hζ.pow_eq_one
  have hζ1 : Valued.v (ζ - 1) < 1 := valued_sub_one_lt_one hq hζ hqv
  set S := ∏ k ∈ Finset.range (q - 1), ∑ i ∈ Finset.range (k + 1), ζ ^ i with hSdef
  have hS : S * (ζ - 1) ^ (q - 1) = ((q : ℕ) : A) := prod_geomSum_mul_pow_sub_one hodd hζ
  have hS1 : Valued.v (S + 1) < 1 :=
    valued_prod_geomSum_add_one_lt_one hq (le_of_eq hζv) hζ1 hqv
  have hSv : Valued.v S = 1 := by
    have hlt : Valued.v (S - (-1 : A)) < Valued.v (-1 : A) := by
      rw [Valuation.map_neg, Valuation.map_one, sub_neg_eq_add]
      exact hS1
    have heq := Valuation.map_eq_of_sub_lt Valued.v hlt
    rwa [Valuation.map_neg, Valuation.map_one] at heq
  have hS0 : S ≠ 0 := by
    intro h
    rw [h, map_zero] at hSv
    exact zero_ne_one hSv
  refine ⟨-S⁻¹, ?_, ?_⟩
  · have hu : -S⁻¹ - 1 = -((S + 1) * S⁻¹) := by
      field_simp
      ring
    rw [hu, Valuation.map_neg, Valuation.map_mul, map_inv₀, hSv, inv_one, mul_one]
    exact hS1
  · have hneg : -((q : ℕ) : A) * -S⁻¹ = ((q : ℕ) : A) * S⁻¹ := by ring
    rw [hneg, ← hS, mul_comm S ((ζ - 1) ^ (q - 1)), mul_assoc, mul_inv_cancel₀ hS0, mul_one]

end Radical

end InverseGalois.CFT
