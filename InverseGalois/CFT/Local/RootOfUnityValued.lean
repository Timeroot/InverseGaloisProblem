import Mathlib
import InverseGalois.CFT.Local.NatValuation
import InverseGalois.CFT.Local.UnitPowIndex

/-!
# Roots of unity of order invertible in the residue field

The product of `1 - ζ ^ i` over the nontrivial powers of a primitive `m`-th root of unity is `m`.
In a valued field each factor has valuation at most one, so as soon as `m` itself has valuation one
every factor has valuation one: **two `m`-th roots of unity whose difference has valuation less
than one are equal.**  Reduction modulo the maximal ideal is therefore injective on the roots of
unity of order invertible in the residue field.

That is what makes a Frobenius canonical.  An automorphism of a valued extension which raises every
element of the valuation ring to the `q`-th power modulo the maximal ideal has no choice on such a
root of unity: it must send `ζ` to `ζ ^ q`, because the two agree modulo the maximal ideal and are
both `m`-th roots of unity.  So an extension generated by one root of unity of order invertible in
the residue field admits at most one Frobenius, and the `j`-th power of a Frobenius raises that
root of unity to the `q ^ j`-th power.

## Main definitions

* `InverseGalois.CFT.IsValuedFrobenius`: an automorphism which raises every element of the
  valuation ring to the `q`-th power modulo the maximal ideal.

## Main results

* `InverseGalois.CFT.valued_one_sub_pow_eq_one`: a nontrivial power of a primitive `m`-th root of
  unity differs from one by a unit, as soon as `m` has valuation one.
* `InverseGalois.CFT.eq_one_of_valued_sub_one_lt_one`: a root of unity of order of valuation one
  which is congruent to one is one.
* `InverseGalois.CFT.eq_of_valued_sub_lt_one`: **two `m`-th roots of unity whose difference has
  valuation less than one are equal.**
* `InverseGalois.CFT.IsValuedFrobenius.apply_rootOfUnity`: **a Frobenius raises a root of unity of
  order of valuation one to the `q`-th power.**
* `InverseGalois.CFT.IsValuedFrobenius.pow_apply_rootOfUnity`: the `j`-th power of a Frobenius
  raises it to the `q ^ j`-th power.
* `InverseGalois.CFT.IsValuedFrobenius.eq_of_forall_fixing_eq_one`: **an extension generated by one
  root of unity of order of valuation one has at most one Frobenius.**

## Tags

valued field, root of unity, residue field, Frobenius, unramified extension
-/

namespace InverseGalois.CFT

open scoped WithZero

/-! ### Roots of unity are far apart -/

section Field

variable {A : Type*} [Field A] [Valued A ℤᵐ⁰]

/-- **A root of unity is a unit of the valuation ring**, the value group being torsion free. -/
theorem valued_eq_one_of_pow_eq_one₀ {m : ℕ} (hm : m ≠ 0) {ζ : A} (hζ : ζ ^ m = 1) :
    Valued.v ζ = 1 := by
  have hζ0 : ζ ≠ 0 := by
    rintro rfl
    rw [zero_pow hm] at hζ
    exact zero_ne_one hζ
  have hu : (Units.mk0 ζ hζ0) ^ m = 1 := Units.ext (by simpa using hζ)
  exact valued_eq_one_of_pow_eq_one hm hu

/-- A factor of a product of elements of valuation at most one whose product is one has valuation
one. -/
private theorem eq_one_of_prod_eq_one {ι : Type*} [DecidableEq ι] {s : Finset ι} {f : ι → ℤᵐ⁰}
    (hf : ∀ i ∈ s, f i ≤ 1) (h : ∏ i ∈ s, f i = 1) {j : ι} (hj : j ∈ s) : f j = 1 := by
  refine le_antisymm (hf j hj) ?_
  have hrest : ∏ i ∈ s.erase j, f i ≤ 1 :=
    Finset.prod_induction f (· ≤ 1) (fun _ _ ha hb => mul_le_one' ha hb) le_rfl
      fun i hi => hf i (Finset.mem_of_mem_erase hi)
  calc (1 : ℤᵐ⁰) = f j * ∏ i ∈ s.erase j, f i := by rw [Finset.mul_prod_erase s f hj, h]
    _ ≤ f j * 1 := by gcongr
    _ = f j := mul_one _

/-- **A nontrivial power of a primitive `m`-th root of unity differs from one by a unit**, as soon
as `m` has valuation one: the product of those differences is `m`, and each factor already has
valuation at most one. -/
theorem valued_one_sub_pow_eq_one {m : ℕ} {ζ : A} (hζ : IsPrimitiveRoot ζ m)
    (hmv : Valued.v (m : A) = 1) {i : ℕ} (hi0 : i ≠ 0) (hi : i < m) :
    Valued.v (1 - ζ ^ i) = 1 := by
  obtain ⟨n, rfl⟩ : ∃ n, m = n + 1 := ⟨m - 1, by omega⟩
  have hroot : ∀ k : ℕ, (ζ ^ k) ^ (n + 1) = 1 := by
    intro k
    rw [← pow_mul, mul_comm, pow_mul, hζ.pow_eq_one, one_pow]
  have hle : ∀ k ∈ Finset.range n, Valued.v (1 - ζ ^ (k + 1)) ≤ 1 := by
    intro k _
    refine le_trans (Valuation.map_sub Valued.v _ _) (max_le ?_ ?_)
    · simp
    · exact le_of_eq (valued_eq_one_of_pow_eq_one₀ (Nat.succ_ne_zero n) (hroot (k + 1)))
  have hprod : ∏ k ∈ Finset.range n, (1 - ζ ^ (k + 1)) = ((n : A) + 1) :=
    hζ.prod_one_sub_pow_eq_order
  have hprodv : ∏ k ∈ Finset.range n, Valued.v (1 - ζ ^ (k + 1)) = 1 := by
    rw [← map_prod, hprod, ← Nat.cast_succ]
    exact hmv
  have hmem : i - 1 ∈ Finset.range n := Finset.mem_range.mpr (by omega)
  have := eq_one_of_prod_eq_one hle hprodv hmem
  rwa [show i - 1 + 1 = i from by omega] at this

/-- **A root of unity congruent to one is one**, as soon as its order has valuation one.  The order
of such an element divides one of valuation one, so it too has valuation one, and a primitive
`d`-th root of unity with `d > 1` is at distance one from one. -/
theorem eq_one_of_valued_sub_one_lt_one {m : ℕ} (hm : m ≠ 0) (hmv : Valued.v (m : A) = 1) {η : A}
    (hη : η ^ m = 1) (h : Valued.v (η - 1) < 1) : η = 1 := by
  have hdvd : orderOf η ∣ m := orderOf_dvd_of_pow_eq_one hη
  have hd0 : orderOf η ≠ 0 := by
    rintro hz
    rw [hz] at hdvd
    exact hm (Nat.eq_zero_of_zero_dvd hdvd)
  have hdv : Valued.v ((orderOf η : ℕ) : A) = 1 := by
    obtain ⟨c, hc⟩ := hdvd
    have hmul : Valued.v ((orderOf η : ℕ) : A) * Valued.v (c : A) = 1 := by
      rw [← Valuation.map_mul, ← Nat.cast_mul, ← hc]
      exact hmv
    refine le_antisymm (valued_natCast_le_one _) ?_
    by_contra hlt
    push_neg at hlt
    have hlt' : Valued.v ((orderOf η : ℕ) : A) * Valued.v (c : A) < 1 :=
      lt_of_le_of_lt (mul_le_of_le_one_right' (valued_natCast_le_one c)) hlt
    exact absurd hmul (ne_of_lt hlt')
  have hprim : IsPrimitiveRoot η (orderOf η) := IsPrimitiveRoot.orderOf η
  rcases eq_or_lt_of_le (Nat.one_le_iff_ne_zero.mpr hd0) with h1 | h1
  · have hpow := hprim.pow_eq_one
    rwa [← h1, pow_one] at hpow
  · have hone : Valued.v (1 - η ^ 1) = 1 :=
      valued_one_sub_pow_eq_one hprim hdv one_ne_zero h1
    rw [pow_one] at hone
    have heq : Valued.v (η - 1) = 1 := by
      rw [← Valuation.map_neg, neg_sub]
      exact hone
    exact absurd heq (ne_of_lt h)

/-- **Two `m`-th roots of unity whose difference has valuation less than one are equal**, as soon
as `m` has valuation one: their quotient is a root of unity congruent to one. -/
theorem eq_of_valued_sub_lt_one {m : ℕ} (hm : m ≠ 0) (hmv : Valued.v (m : A) = 1) {ζ ξ : A}
    (hζ : ζ ^ m = 1) (hξ : ξ ^ m = 1) (h : Valued.v (ζ - ξ) < 1) : ζ = ξ := by
  have hξ0 : ξ ≠ 0 := by
    rintro rfl
    rw [zero_pow hm] at hξ
    exact zero_ne_one hξ
  have hηpow : (ζ * ξ⁻¹) ^ m = 1 := by
    rw [mul_pow, hζ, inv_pow, hξ, inv_one, mul_one]
  have hξv : Valued.v ξ = 1 := valued_eq_one_of_pow_eq_one₀ hm hξ
  have hsub : ζ * ξ⁻¹ - 1 = (ζ - ξ) * ξ⁻¹ := by
    rw [sub_mul, mul_inv_cancel₀ hξ0]
  have hηv : Valued.v (ζ * ξ⁻¹ - 1) < 1 := by
    rw [hsub, Valuation.map_mul, map_inv₀, hξv, inv_one, mul_one]
    exact h
  have hone := eq_one_of_valued_sub_one_lt_one hm hmv hηpow hηv
  rwa [← div_eq_mul_inv, div_eq_one_iff_eq hξ0] at hone

end Field

/-! ### The Frobenius of a valued extension -/

section Frobenius

variable {K L : Type*} [Field K] [Field L] [Algebra K L] [Valued L ℤᵐ⁰]

/-- **A Frobenius of a valued extension**: an automorphism which raises every element of the
valuation ring to the `q`-th power, modulo the maximal ideal. -/
def IsValuedFrobenius (q : ℕ) (σ : L ≃ₐ[K] L) : Prop :=
  ∀ x : L, Valued.v x ≤ 1 → Valued.v (σ x - x ^ q) < 1

variable {q : ℕ} {σ τ : L ≃ₐ[K] L}

/-- **A Frobenius raises a root of unity of order of valuation one to the `q`-th power.**  The two
are `m`-th roots of unity which agree modulo the maximal ideal, and roots of unity of order of
valuation one are separated by it. -/
theorem IsValuedFrobenius.apply_rootOfUnity (hσ : IsValuedFrobenius q σ) {m : ℕ} (hm : m ≠ 0)
    (hmv : Valued.v (m : L) = 1) {ζ : L} (hζ : ζ ^ m = 1) : σ ζ = ζ ^ q := by
  refine eq_of_valued_sub_lt_one hm hmv ?_ ?_ (hσ ζ ?_)
  · rw [← map_pow, hζ, map_one]
  · rw [← pow_mul, mul_comm, pow_mul, hζ, one_pow]
  · exact le_of_eq (valued_eq_one_of_pow_eq_one₀ hm hζ)

/-- **The `j`-th power of a Frobenius raises a root of unity of order of valuation one to the
`q ^ j`-th power.** -/
theorem IsValuedFrobenius.pow_apply_rootOfUnity (hσ : IsValuedFrobenius q σ) {m : ℕ} (hm : m ≠ 0)
    (hmv : Valued.v (m : L) = 1) {ζ : L} (hζ : ζ ^ m = 1) (j : ℕ) :
    (σ ^ j) ζ = ζ ^ (q ^ j) := by
  induction j with
  | zero => simp
  | succ j ih =>
    have hroot : (ζ ^ (q ^ j)) ^ m = 1 := by
      rw [← pow_mul, mul_comm, pow_mul, hζ, one_pow]
    calc (σ ^ (j + 1)) ζ = σ ((σ ^ j) ζ) := by rw [pow_succ']; rfl
      _ = σ (ζ ^ (q ^ j)) := by rw [ih]
      _ = (ζ ^ (q ^ j)) ^ q := hσ.apply_rootOfUnity hm hmv hroot
      _ = ζ ^ (q ^ (j + 1)) := by rw [← pow_mul, pow_succ]

/-- A power of a Frobenius which is the identity leaves the `q ^ j`-th power map fixed on the roots
of unity of order of valuation one. -/
theorem IsValuedFrobenius.pow_pow_eq_self (hσ : IsValuedFrobenius q σ) {m : ℕ} (hm : m ≠ 0)
    (hmv : Valued.v (m : L) = 1) {ζ : L} (hζ : ζ ^ m = 1) {j : ℕ} (hj : σ ^ j = 1) :
    ζ ^ (q ^ j) = ζ := by
  have h := hσ.pow_apply_rootOfUnity hm hmv hζ j
  rw [hj] at h
  simpa using h.symm

/-- **An extension generated by one root of unity of order of valuation one has at most one
Frobenius.**  Two of them agree on that root of unity, so their quotient fixes it. -/
theorem IsValuedFrobenius.eq_of_forall_fixing_eq_one (hσ : IsValuedFrobenius q σ)
    (hτ : IsValuedFrobenius q τ) {m : ℕ} (hm : m ≠ 0) (hmv : Valued.v (m : L) = 1) {ζ : L}
    (hζ : ζ ^ m = 1) (hgen : ∀ ρ : L ≃ₐ[K] L, ρ ζ = ζ → ρ = 1) : σ = τ := by
  have hst : σ ζ = τ ζ :=
    (hσ.apply_rootOfUnity hm hmv hζ).trans (hτ.apply_rootOfUnity hm hmv hζ).symm
  have hfix : (τ⁻¹ * σ) ζ = ζ := by
    show τ⁻¹ (σ ζ) = ζ
    rw [hst]
    exact τ.symm_apply_apply ζ
  exact (inv_mul_eq_one.mp (hgen _ hfix)).symm

end Frobenius

end InverseGalois.CFT
