import Mathlib
import InverseGalois.CFT.SquareClasses

/-!
# Generators of the group of nonzero rationals

The group of units of the rationals is generated by `-1` together with the rational primes: a
nonzero rational is its numerator over its denominator, and each of those is a signed product of
primes.  A multiplicative map out of that group therefore vanishes as soon as it vanishes on `-1`
and on every prime.

This is the reduction that turns a reciprocity law into a finite computation.  The total invariant
of a cyclic algebra depends multiplicatively on its coefficient, so checking that it vanishes on
`-1` and on the primes checks it on every coefficient at once.

## Main results

* `InverseGalois.CFT.eq_one_of_neg_one_of_prime`: **a multiplicative map out of the units of the
  rationals that kills `-1` and every prime is trivial.**

## Tags

rational numbers, units, prime factorisation, multiplicative map, reciprocity
-/

namespace InverseGalois.CFT

/-! ### Checking a multiplicative map on `-1` and the primes -/

section Generators

variable {M : Type*} [Monoid M] (Ψ : ℚˣ →* M)

/-- A multiplicative map out of the units of the rationals that kills `-1` and every prime kills
every unit whose value is a nonzero integer: the nonzero integers are generated by `1`, `-1` and
the primes under multiplication. -/
theorem eq_one_of_intCast (hneg : Ψ (-1) = 1)
    (hprime : ∀ (p : ℕ) (u : ℚˣ), p.Prime → (u : ℚ) = (p : ℚ) → Ψ u = 1) {n : ℤ} (hn : n ≠ 0) :
    ∀ u : ℚˣ, (u : ℚ) = (n : ℚ) → Ψ u = 1 := by
  refine Int.induction_on_prime_mul
    (motive := fun n : ℤ => ∀ u : ℚˣ, (u : ℚ) = (n : ℚ) → Ψ u = 1) ?_ ?_ ?_ hn
  · intro u hu
    have hu1 : u = 1 := by
      refine Units.ext ?_
      simpa using hu
    rw [hu1, map_one]
  · intro u hu
    have hu1 : u = -1 := by
      refine Units.ext ?_
      simpa using hu
    rw [hu1, hneg]
  · intro p b hp hb ih u hu
    have hp0 : ((p : ℕ) : ℚ) ≠ 0 := Nat.cast_ne_zero.2 hp.ne_zero
    have hb0 : ((b : ℤ) : ℚ) ≠ 0 := Int.cast_ne_zero.2 hb
    have hsplit : u = Units.mk0 ((p : ℕ) : ℚ) hp0 * Units.mk0 ((b : ℤ) : ℚ) hb0 := by
      refine Units.ext ?_
      rw [hu, Units.val_mul, Units.val_mk0, Units.val_mk0]
      push_cast
      ring
    rw [hsplit, map_mul, hprime p _ hp (Units.val_mk0 hp0), ih _ (Units.val_mk0 hb0), one_mul]

/-- **A multiplicative map out of the units of the rationals that kills `-1` and every prime is
trivial.**  A nonzero rational is its numerator divided by its denominator, and both of those are
nonzero integers, so the map kills the unit named by the denominator and the unit named by the
numerator, hence their quotient. -/
theorem eq_one_of_neg_one_of_prime (hneg : Ψ (-1) = 1)
    (hprime : ∀ (p : ℕ) (u : ℚˣ), p.Prime → (u : ℚ) = (p : ℚ) → Ψ u = 1) (u : ℚˣ) : Ψ u = 1 := by
  have hx : (u : ℚ) ≠ 0 := u.ne_zero
  have hden : (((u : ℚ).den : ℚ)) ≠ 0 := Nat.cast_ne_zero.2 (u : ℚ).den_nz
  have hnum := Rat.num_div_den (u : ℚ)
  rw [div_eq_iff hden] at hnum
  have h2 : Ψ (Units.mk0 (((u : ℚ).den : ℚ)) hden) = 1 := by
    refine eq_one_of_intCast Ψ hneg hprime (n := (((u : ℚ).den : ℕ) : ℤ))
      (Int.natCast_ne_zero.2 (u : ℚ).den_nz) _ ?_
    rw [Units.val_mk0]
    push_cast
    ring
  have h1 : Ψ (u * Units.mk0 (((u : ℚ).den : ℚ)) hden) = 1 := by
    refine eq_one_of_intCast Ψ hneg hprime (n := (u : ℚ).num) (Rat.num_ne_zero.2 hx) _ ?_
    rw [Units.val_mul, Units.val_mk0]
    exact hnum.symm
  rwa [map_mul, h2, mul_one] at h1

end Generators

end InverseGalois.CFT
