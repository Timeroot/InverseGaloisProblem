import Mathlib
import InverseGalois.CFT.Brauer.DivisionCyclic
import InverseGalois.CFT.Brauer.UnramifiedAdjoin

/-!
# The automorphisms of an unramified extension of a local field

An unramified extension of a nonarchimedean local field is generated by a root of unity whose order
is the number of nonzero residues, and that root of unity is primitive of that order.  An
automorphism of the extension therefore raises it to a power prime to the order, and is determined
by that power: **the automorphism group embeds into the units of the integers modulo the number of
nonzero residues.**  In particular it is commutative, and since the extension is generated by a
root of unity of invertible order it is even cyclic.

The embedding is the one which names the Frobenius automorphism, the element which raises the root
of unity to the number of residues of the base field.

## Main results

* `InverseGalois.CFT.exists_isPrimitiveRoot_adjoin_eq_top_of_unramified`: an unramified extension is
  generated by a primitive root of unity of order the number of nonzero residues.
* `InverseGalois.CFT.autToPow_injective`: **an automorphism of an extension generated by a primitive
  root of unity is determined by the power to which it raises that root of unity.**
* `InverseGalois.CFT.mul_comm_algEquiv_of_unramified`: **the automorphism group of an unramified
  extension of a local field is commutative.**
* `InverseGalois.CFT.isCyclic_algEquiv_of_unramified`: **the automorphism group of an unramified
  extension of a local field is cyclic.**

## Tags

local field, unramified extension, root of unity, automorphism, Frobenius
-/

universe u

namespace InverseGalois.CFT

open Module

variable {K L : Type u} [NontriviallyNormedField K] [IsUltrametricDist K] [ProperSpace K]
variable [Field L] [Algebra K L] [FiniteDimensional K L]

/-! ### The primitive root of unity -/

variable (K L) in
/-- **An extension of a local field has at least one nonzero residue.** -/
theorem neZero_card_divisionResidue_sub_one :
    NeZero (Nat.card (DivisionResidue K L) - 1) := by
  refine ⟨?_⟩
  have h : 1 < Nat.card (DivisionResidue K L) := Finite.one_lt_card
  omega

variable (K L) in
/-- **An unramified extension of a local field is generated by a primitive root of unity** whose
order is the number of nonzero residues. -/
theorem exists_isPrimitiveRoot_adjoin_eq_top_of_unramified
    (hur : ∀ z : L, z ≠ 0 → ∃ c : K, c ≠ 0 ∧ divisionNorm K L z = ‖c‖) :
    ∃ ζ : L, IsPrimitiveRoot ζ (Nat.card (DivisionResidue K L) - 1) ∧
      Algebra.adjoin K ({ζ} : Set L) = ⊤ := by
  obtain ⟨ζ, h1, h2, htop⟩ := exists_adjoin_rootOfUnity_eq_top_of_unramified K L hur
  exact ⟨ζ, ⟨h1, h2⟩, htop⟩

/-! ### The embedding into the units modulo the order -/

omit [IsUltrametricDist K] [ProperSpace K] [FiniteDimensional K L] in
/-- **An automorphism of an extension generated by a primitive root of unity is determined by the
power to which it raises that root of unity.** -/
theorem autToPow_injective {ζ : L} {N : ℕ} [NeZero N] (hζ : IsPrimitiveRoot ζ N)
    (htop : Algebra.adjoin K ({ζ} : Set L) = ⊤) :
    Function.Injective (hζ.autToPow K) := by
  intro σ τ h
  refine algEquiv_eq_of_apply_eq_of_adjoin_eq_top htop ?_
  rw [← hζ.autToPow_spec K σ, ← hζ.autToPow_spec K τ, h]

variable (K L) in
/-- **The automorphism group of an unramified extension of a local field is commutative**, because
it embeds into the units of the integers modulo the number of nonzero residues. -/
theorem mul_comm_algEquiv_of_unramified
    (hur : ∀ z : L, z ≠ 0 → ∃ c : K, c ≠ 0 ∧ divisionNorm K L z = ‖c‖) (σ τ : L ≃ₐ[K] L) :
    σ * τ = τ * σ := by
  haveI := neZero_card_divisionResidue_sub_one K L
  obtain ⟨ζ, hζ, htop⟩ := exists_isPrimitiveRoot_adjoin_eq_top_of_unramified K L hur
  refine autToPow_injective hζ htop ?_
  rw [map_mul, map_mul, mul_comm]

/-! ### Cyclicity -/

variable (K L) in
/-- **The automorphism group of an unramified extension of a local field is cyclic**, because the
extension is generated by a root of unity whose order is invertible in the base field. -/
theorem isCyclic_algEquiv_of_unramified
    (hur : ∀ z : L, z ≠ 0 → ∃ c : K, c ≠ 0 ∧ divisionNorm K L z = ‖c‖) :
    IsCyclic (L ≃ₐ[K] L) := by
  obtain ⟨ζ, h1, _, htop⟩ := exists_adjoin_rootOfUnity_eq_top_of_unramified K L hur
  exact isCyclic_algEquiv_of_rootOfUnity h1 (norm_natCast_card_divisionResidue_sub_one K L) htop

end InverseGalois.CFT
