import Mathlib
import InverseGalois.CFT.Brauer.DivisionMaximal

/-!
# Roots of unity generating the residues of a division algebra over a local field

The residue ring of a division algebra `D` over a nonarchimedean local field is a finite field with
`Q` elements, and there is an integer of `D` whose powers meet every element of absolute value one.
Such an integer can be chosen to be a root of unity of order exactly `Q - 1`: starting from any
integer `y` of absolute value one, the sequence `y ^ (Q ^ j)` is Cauchy, because raising to the
power `Q` contracts the distance to a `(Q-1)`-st root of unity by the factor `|Q| < 1`, and its
limit is a root of unity congruent to `y`.

The subfield generated by such a root of unity is the unramified maximal subfield of `D`, and it is
generated by a root of unity of order prime to the residue characteristic, which is what makes it
Galois over the base field.

## Main results

* `InverseGalois.CFT.divisionNorm_pow_sub_one_le`: raising an integer to the power `m` multiplies
  its distance to one by at most the larger of that distance and the absolute value of `m`.
* `InverseGalois.CFT.exists_pow_eq_one_divisionNorm_sub_lt_one`: **the Teichmüller lift** — an
  integer of absolute value one whose `(Q-1)`-st power is congruent to one is congruent to a
  `(Q-1)`-st root of unity, provided `|Q| < 1`.
* `InverseGalois.CFT.exists_rootOfUnity_pow_divisionNorm_sub_lt_one`: **a root of unity of order
  exactly `Q - 1` whose powers meet every element of absolute value one.**
* `InverseGalois.CFT.exists_rootOfUnity_unramified_generator`: **a division algebra over a
  nonarchimedean local field is generated over its base field by a root of unity of order prime to
  the residue characteristic, and that root of unity generates an unramified maximal subfield.**

## Tags

division algebra, local field, Teichmüller lift, root of unity, unramified, residue field
-/

set_option maxHeartbeats 1000000
set_option synthInstance.maxHeartbeats 1000000

universe u

open Module Filter Topology

namespace InverseGalois.CFT

/-! ### Finite domains -/

/-- The nonzero elements of a finite ring without zero divisors satisfy `x ^ (q - 1) = 1`, where `q`
is the number of elements. -/
theorem pow_card_sub_one_eq_one_of_finite_isDomain (R : Type*) [Ring R] [IsDomain R] [Finite R]
    (x : R) (hx : x ≠ 0) : x ^ (Nat.card R - 1) = 1 := by
  classical
  letI : Fintype R := Fintype.ofFinite R
  letI : Field R := (Finite.isDomain_to_isField R).toField
  rw [Nat.card_eq_fintype_card]
  exact FiniteField.pow_card_sub_one_eq_one x hx

/-- The number of elements of a finite ring with unit is zero in that ring. -/
theorem natCast_card_eq_zero_of_finite (R : Type*) [AddGroupWithOne R] [Finite R] :
    ((Nat.card R : ℕ) : R) = 0 := by
  classical
  letI : Fintype R := Fintype.ofFinite R
  rw [Nat.card_eq_fintype_card]
  exact Nat.cast_card_eq_zero R

/-- An element whose powers exhaust the nonzero elements of a finite ring without zero divisors has
order exactly one less than the number of elements. -/
theorem card_sub_one_dvd_of_pow_eq_one {R : Type*} [Ring R] [IsDomain R] [Finite R] {g : R}
    (hg0 : g ≠ 0) (hgen : ∀ x : R, x ≠ 0 → ∃ i : ℕ, x = g ^ i) {m : ℕ} (hm : g ^ m = 1) :
    Nat.card R - 1 ∣ m := by
  classical
  letI : Fintype R := Fintype.ofFinite R
  letI : Field R := (Finite.isDomain_to_isField R).toField
  set gU : Rˣ := Units.mk0 g hg0 with hgU
  have hmem : ∀ u : Rˣ, u ∈ Subgroup.zpowers gU := by
    intro u
    obtain ⟨i, hi⟩ := hgen (u : R) u.ne_zero
    refine Subgroup.mem_zpowers_iff.2 ⟨(i : ℤ), ?_⟩
    rw [zpow_natCast]
    exact Units.ext (by simp [hgU, hi])
  have hord : orderOf gU = Nat.card R - 1 := by
    rw [orderOf_eq_card_of_forall_mem_zpowers hmem, Nat.card_units]
  rw [← hord]
  refine orderOf_dvd_of_pow_eq_one (Units.ext ?_)
  simpa [hgU] using hm

/-! ### The Teichmüller lift -/

section Teichmuller

variable {K D : Type u} [NontriviallyNormedField K] [IsUltrametricDist K] [ProperSpace K]
variable [DivisionRing D] [Algebra K D] [FiniteDimensional K D]

/-- The absolute value of a difference is at most the larger of the two absolute values. -/
theorem divisionNorm_sub_le (x y : D) :
    divisionNorm K D (x - y) ≤ max (divisionNorm K D x) (divisionNorm K D y) := by
  rw [sub_eq_add_neg]
  refine (divisionNorm_isNonarchimedean _ _).trans (le_of_eq ?_)
  rw [divisionNorm_neg]

omit [ProperSpace K] in
variable (K) in
/-- Every natural number is an integer of a division algebra over a nonarchimedean field. -/
theorem divisionNorm_natCast_le_one (m : ℕ) : divisionNorm K D (m : D) ≤ 1 := by
  rw [show ((m : D)) = algebraMap K D (m : K) by rw [map_natCast], divisionNorm_algebraMap]
  exact IsUltrametricDist.norm_natCast_le_one K m

/-- A sum of integers of a division algebra over a nonarchimedean field is an integer. -/
theorem divisionNorm_sum_le_one {ι : Type*} (s : Finset ι) (f : ι → D)
    (hf : ∀ i ∈ s, divisionNorm K D (f i) ≤ 1) : divisionNorm K D (∑ i ∈ s, f i) ≤ 1 :=
  mem_divisionIntegers.1
    (Subring.sum_mem _ fun i hi => mem_divisionIntegers.2 (hf i hi))

/-- **The contraction estimate.**  Raising an integer to the power `m` multiplies its distance to
one by at most the larger of that distance and the absolute value of `m`.  Indeed the geometric sum
`1 + a + ⋯ + a ^ (m-1)` differs from `m` by a multiple of `a - 1`, so it is bounded by the larger of
`|m|` and `|a - 1|`, and `a ^ m - 1` is its product with `a - 1`. -/
theorem divisionNorm_pow_sub_one_le {a : D} (ha : divisionNorm K D a ≤ 1) (m : ℕ) :
    divisionNorm K D (a ^ m - 1) ≤
      max (divisionNorm K D (m : D)) (divisionNorm K D (a - 1)) * divisionNorm K D (a - 1) := by
  classical
  have hai : ∀ i : ℕ, divisionNorm K D (a ^ i) ≤ 1 := fun i => by
    rw [divisionNorm_pow]
    exact pow_le_one₀ (divisionNorm_nonneg _) ha
  set S : D := ∑ i ∈ Finset.range m, a ^ i with hS
  set T : D := ∑ i ∈ Finset.range m, ∑ k ∈ Finset.range i, a ^ k with hT
  have hgeom : S * (a - 1) = a ^ m - 1 := geom_sum_mul a m
  have hTeq : T * (a - 1) = S - (m : D) := by
    rw [hT, Finset.sum_mul, Finset.sum_congr rfl fun i _ => geom_sum_mul a i,
      Finset.sum_sub_distrib]
    simp [hS]
  have hTle : divisionNorm K D T ≤ 1 :=
    divisionNorm_sum_le_one _ _ fun i _ => divisionNorm_sum_le_one _ _ fun k _ => hai k
  have hSm : divisionNorm K D (S - (m : D)) ≤ divisionNorm K D (a - 1) := by
    rw [← hTeq, divisionNorm_mul]
    exact mul_le_of_le_one_left (divisionNorm_nonneg _) hTle
  have hsplit : S - (m : D) + (m : D) = S := by abel
  have hSle : divisionNorm K D S ≤
      max (divisionNorm K D (m : D)) (divisionNorm K D (a - 1)) := by
    calc divisionNorm K D S = divisionNorm K D (S - (m : D) + (m : D)) := by rw [hsplit]
      _ ≤ max (divisionNorm K D (S - (m : D))) (divisionNorm K D (m : D)) :=
          divisionNorm_isNonarchimedean _ _
      _ ≤ max (divisionNorm K D (m : D)) (divisionNorm K D (a - 1)) :=
          max_le (le_max_of_le_right hSm) (le_max_left _ _)
  calc divisionNorm K D (a ^ m - 1) = divisionNorm K D (S * (a - 1)) := by rw [hgeom]
    _ = divisionNorm K D S * divisionNorm K D (a - 1) := divisionNorm_mul _ _
    _ ≤ _ := mul_le_mul_of_nonneg_right hSle (divisionNorm_nonneg _)

/-- **The Teichmüller lift.**  Let `Q` be a natural number of absolute value less than one in a
division algebra over a nonarchimedean local field.  An integer `y` of absolute value one whose
`(Q-1)`-st power is congruent to one is congruent to a genuine `(Q-1)`-st root of unity.  The
sequence `y ^ (Q ^ j)` is Cauchy, because the contraction estimate makes the distance from
`y ^ ((Q-1) * Q ^ j)` to one shrink geometrically, and its limit is the root of unity. -/
theorem exists_pow_eq_one_divisionNorm_sub_lt_one {Q : ℕ} (hQ : 0 < Q)
    (hQnorm : divisionNorm K D (Q : D) < 1) {y : D} (hy : divisionNorm K D y = 1)
    (hy1 : divisionNorm K D (y ^ (Q - 1) - 1) < 1) :
    ∃ ζ : D, ζ ^ (Q - 1) = 1 ∧ divisionNorm K D (ζ - y) < 1 := by
  classical
  obtain ⟨d, rfl⟩ : ∃ d : ℕ, Q = d + 1 := ⟨Q - 1, by omega⟩
  simp only [Nat.add_sub_cancel] at hy1 ⊢
  -- the two sequences
  set u : ℕ → D := fun j => y ^ ((d + 1) ^ j) with hu
  set v : ℕ → D := fun j => y ^ (d * (d + 1) ^ j) with hv
  have hnormu : ∀ j, divisionNorm K D (u j) = 1 := by
    intro j; rw [hu]; simp [divisionNorm_pow, hy]
  have hnormv : ∀ j, divisionNorm K D (v j) = 1 := by
    intro j; rw [hv]; simp [divisionNorm_pow, hy]
  have hvsucc : ∀ j, v (j + 1) = v j ^ (d + 1) := by
    intro j
    have hexp : d * (d + 1) ^ j * (d + 1) = d * (d + 1) ^ (j + 1) := by ring
    simp only [hv]
    rw [← pow_mul, hexp]
  have husucc : ∀ j, u (j + 1) = u j ^ (d + 1) := by
    intro j
    have hexp : (d + 1) ^ j * (d + 1) = (d + 1) ^ (j + 1) := by ring
    simp only [hu]
    rw [← pow_mul, hexp]
  have hudiff : ∀ j, u (j + 1) - u j = u j * (v j - 1) := by
    intro j
    have he : u j * v j = u (j + 1) := by
      have hexp : (d + 1) ^ j + d * (d + 1) ^ j = (d + 1) ^ (j + 1) := by ring
      simp only [hu, hv]
      rw [← pow_add, hexp]
    rw [mul_sub, mul_one, he]
  -- the geometric contraction
  set δ : ℕ → ℝ := fun j => divisionNorm K D (v j - 1) with hδ
  set c : ℝ := max (divisionNorm K D ((d + 1 : ℕ) : D)) (δ 0) with hc
  have hδ0 : δ 0 < 1 := by
    rw [hδ, hv]
    simpa using hy1
  have hc0 : 0 ≤ c := le_trans (divisionNorm_nonneg _) (le_max_left _ _)
  have hc1 : c < 1 := max_lt hQnorm hδ0
  have hstep : ∀ j, δ (j + 1) ≤ max (divisionNorm K D ((d + 1 : ℕ) : D)) (δ j) * δ j := by
    intro j
    rw [hδ]
    simp only
    rw [hvsucc j]
    exact divisionNorm_pow_sub_one_le (le_of_eq (hnormv j)) (d + 1)
  have hδnonneg : ∀ j, 0 ≤ δ j := fun j => divisionNorm_nonneg _
  have hgeo : ∀ j, δ j ≤ c ^ (j + 1) := by
    intro j
    induction j with
    | zero =>
      calc δ 0 ≤ c := by rw [hc]; exact le_max_right _ _
        _ = c ^ (0 + 1) := by ring
    | succ j ih =>
      have hpow : c ^ (j + 1) ≤ c := by
        simpa using pow_le_pow_of_le_one hc0 hc1.le (Nat.succ_le_succ (Nat.zero_le j))
      have h1 : max (divisionNorm K D ((d + 1 : ℕ) : D)) (δ j) ≤ c :=
        max_le (le_max_left _ _) (ih.trans hpow)
      calc δ (j + 1) ≤ max (divisionNorm K D ((d + 1 : ℕ) : D)) (δ j) * δ j := hstep j
        _ ≤ c * c ^ (j + 1) :=
            mul_le_mul h1 ih (hδnonneg j) hc0
        _ = c ^ (j + 1 + 1) := by ring
  -- the metric structure
  have hfd : FiniteDimensional K D := inferInstance
  letI : NormedDivisionRing D := divisionNormedDivisionRing K D
  have hdist : ∀ x z : D, dist x z = divisionNorm K D (x - z) := fun _ _ => rfl
  letI : NormedAlgebra K D :=
    { (inferInstance : Algebra K D) with
      norm_smul_le := fun r x => le_of_eq (by
        show divisionNorm K D (r • x) = ‖r‖ * divisionNorm K D x
        rw [Algebra.smul_def, divisionNorm_mul, divisionNorm_algebraMap]) }
  haveI : FiniteDimensional K D := hfd
  haveI : CompleteSpace D := FiniteDimensional.complete K D
  have hcauchy : CauchySeq u := by
    refine cauchySeq_of_le_geometric c 1 hc1 fun j => ?_
    rw [hdist, ← divisionNorm_neg, neg_sub, hudiff j, divisionNorm_mul, hnormu j, one_mul]
    have h1 : divisionNorm K D (v j - 1) ≤ c ^ (j + 1) := hgeo j
    have h2 : c ^ (j + 1) ≤ c ^ j := pow_le_pow_of_le_one hc0 hc1.le (Nat.le_succ j)
    rw [one_mul]
    exact h1.trans h2
  obtain ⟨ζ, htend⟩ := cauchySeq_tendsto_of_complete hcauchy
  -- the limit is congruent to `y`
  have hball : ∀ j, divisionNorm K D (u j - y) ≤ c := by
    intro j
    induction j with
    | zero => simpa [hu] using hc0
    | succ j ih =>
      have he : u (j + 1) - y = (u (j + 1) - u j) + (u j - y) := by abel
      rw [he]
      refine le_trans (divisionNorm_isNonarchimedean _ _) (max_le ?_ ih)
      rw [hudiff j, divisionNorm_mul, hnormu j, one_mul]
      exact (hgeo j).trans (by
        simpa using pow_le_pow_of_le_one hc0 hc1.le (Nat.succ_le_succ (Nat.zero_le j)))
  have hζy : divisionNorm K D (ζ - y) ≤ c := by
    have hmem : ζ ∈ Metric.closedBall y c :=
      Metric.isClosed_closedBall.mem_of_tendsto htend
        (Eventually.of_forall fun j => by
          rw [Metric.mem_closedBall, hdist]
          exact hball j)
    rw [Metric.mem_closedBall, hdist] at hmem
    exact hmem
  -- the limit is a root of unity
  have hfix : ζ ^ (d + 1) = ζ := by
    have h1 : Tendsto (fun j => u j ^ (d + 1)) atTop (𝓝 (ζ ^ (d + 1))) := htend.pow (d + 1)
    have h2 : Tendsto (fun j => u (j + 1)) atTop (𝓝 ζ) := htend.comp (tendsto_add_atTop_nat 1)
    refine tendsto_nhds_unique ?_ h2
    simpa only [husucc] using h1
  have hζnorm : divisionNorm K D ζ = 1 := by
    have hle : divisionNorm K D ζ ≤ 1 := by
      have he : ζ = (ζ - y) + y := by abel
      calc divisionNorm K D ζ = divisionNorm K D ((ζ - y) + y) := by rw [← he]
        _ ≤ max (divisionNorm K D (ζ - y)) (divisionNorm K D y) :=
            divisionNorm_isNonarchimedean _ _
        _ ≤ 1 := max_le (hζy.trans hc1.le) hy.le
    have hge : 1 ≤ divisionNorm K D ζ := by
      by_contra hcon
      push_neg at hcon
      have he : y = ζ - (ζ - y) := by abel
      have : divisionNorm K D y < 1 := by
        rw [he]
        exact lt_of_le_of_lt (divisionNorm_sub_le _ _) (max_lt hcon (lt_of_le_of_lt hζy hc1))
      rw [hy] at this
      exact absurd this (lt_irrefl 1)
    exact le_antisymm hle hge
  have hζ0 : ζ ≠ 0 := fun h => by
    rw [h, divisionNorm_zero] at hζnorm
    exact absurd hζnorm.symm (by norm_num)
  refine ⟨ζ, ?_, lt_of_le_of_lt hζy hc1⟩
  refine mul_right_cancel₀ hζ0 ?_
  rw [one_mul, ← pow_succ]
  exact hfix

end Teichmuller

/-! ### The residue field of a division algebra -/

section Residue

variable {K D : Type u} [NontriviallyNormedField K] [IsUltrametricDist K] [ProperSpace K]
variable [DivisionRing D] [Algebra K D] [FiniteDimensional K D]

variable (K D) in
/-- The number of residues of a division algebra over a nonarchimedean local field has absolute
value less than one. -/
theorem divisionNorm_natCard_divisionResidue_lt_one :
    divisionNorm K D ((Nat.card (DivisionResidue K D) : ℕ) : D) < 1 := by
  set m : ℕ := Nat.card (DivisionResidue K D) with hm
  have hcoe : (((m : divisionIntegers K D)) : DivisionResidue K D) = ((m : ℕ) :
      DivisionResidue K D) := by
    have h := map_natCast ((divisionResidueCon K D).mk') m
    rwa [RingCon.coe_mk'] at h
  have hzero : (((m : divisionIntegers K D)) : DivisionResidue K D) = 0 := by
    rw [hcoe, hm]
    exact natCast_card_eq_zero_of_finite (DivisionResidue K D)
  have := (divisionResidue_eq_zero_iff ((m : ℕ) : divisionIntegers K D)).1 hzero
  simpa using this

/-- An element of absolute value one has `(Q-1)`-st power congruent to one, where `Q` is the number
of residues of the division algebra. -/
theorem divisionNorm_pow_card_sub_one_sub_lt_one {x : D} (hx : divisionNorm K D x = 1) :
    divisionNorm K D (x ^ (Nat.card (DivisionResidue K D) - 1) - 1) < 1 := by
  set m : ℕ := Nat.card (DivisionResidue K D) with hm
  set xO : divisionIntegers K D := ⟨x, mem_divisionIntegers.2 hx.le⟩ with hxO
  have hne : ((xO : divisionIntegers K D) : DivisionResidue K D) ≠ 0 := fun h => by
    have h1 := (divisionResidue_eq_zero_iff xO).1 h
    rw [hxO] at h1
    simp only at h1
    rw [hx] at h1
    exact absurd h1 (lt_irrefl 1)
  have hpow := pow_card_sub_one_eq_one_of_finite_isDomain (DivisionResidue K D) _ hne
  rw [← hm] at hpow
  have hcast : ((xO ^ (m - 1) : divisionIntegers K D) : DivisionResidue K D)
      = ((xO : DivisionResidue K D)) ^ (m - 1) := by
    simp
  have hone : ((1 : divisionIntegers K D) : DivisionResidue K D) = 1 := rfl
  have heq : ((xO ^ (m - 1) : divisionIntegers K D) : DivisionResidue K D)
      = ((1 : divisionIntegers K D) : DivisionResidue K D) := by rw [hcast, hone, hpow]
  have := divisionResidue_eq_iff.1 heq
  simpa [hxO] using this

variable (K D) in
/-- **A root of unity of order exactly one less than the number of residues whose powers meet every
element of absolute value one.**  The Teichmüller lift of a generator of the residues is such a root
of unity: it is congruent to the generator, so its powers are congruent to the powers of the
generator. -/
theorem exists_rootOfUnity_pow_divisionNorm_sub_lt_one :
    ∃ ζ : D, ζ ^ (Nat.card (DivisionResidue K D) - 1) = 1 ∧
      (∀ m : ℕ, ζ ^ m = 1 → Nat.card (DivisionResidue K D) - 1 ∣ m) ∧
      ∀ x : D, divisionNorm K D x = 1 → ∃ i : ℕ, divisionNorm K D (x - ζ ^ i) < 1 := by
  classical
  obtain ⟨y, hy, hcov⟩ := exists_pow_divisionNorm_sub_lt_one K D
  have hQpos : 0 < Nat.card (DivisionResidue K D) :=
    lt_trans Nat.zero_lt_one (Finite.one_lt_card)
  obtain ⟨ζ, hζpow, hζy⟩ := exists_pow_eq_one_divisionNorm_sub_lt_one hQpos
    (divisionNorm_natCard_divisionResidue_lt_one K D) hy
    (divisionNorm_pow_card_sub_one_sub_lt_one hy)
  -- the powers of `ζ` are congruent to the powers of `y`
  have hζnorm : divisionNorm K D ζ = 1 := by
    have hle : divisionNorm K D ζ ≤ 1 := by
      have he : ζ = (ζ - y) + y := by abel
      calc divisionNorm K D ζ = divisionNorm K D ((ζ - y) + y) := by rw [← he]
        _ ≤ max (divisionNorm K D (ζ - y)) (divisionNorm K D y) :=
            divisionNorm_isNonarchimedean _ _
        _ ≤ 1 := max_le hζy.le hy.le
    refine le_antisymm hle ?_
    by_contra hcon
    push_neg at hcon
    have he : y = ζ - (ζ - y) := by abel
    have hlt : divisionNorm K D y < 1 := by
      rw [he]
      exact lt_of_le_of_lt (divisionNorm_sub_le _ _) (max_lt hcon hζy)
    rw [hy] at hlt
    exact absurd hlt (lt_irrefl 1)
  have hdiff : ∀ i : ℕ, divisionNorm K D (ζ ^ i - y ^ i) < 1 := by
    intro i
    induction i with
    | zero => simp
    | succ i ih =>
      have he : ζ ^ (i + 1) - y ^ (i + 1) = ζ ^ i * (ζ - y) + (ζ ^ i - y ^ i) * y := by
        noncomm_ring
      rw [he]
      refine lt_of_le_of_lt (divisionNorm_isNonarchimedean _ _) (max_lt ?_ ?_)
      · rw [divisionNorm_mul, divisionNorm_pow, hζnorm, one_pow, one_mul]
        exact hζy
      · rw [divisionNorm_mul, hy, mul_one]
        exact ih
  have hcovζ : ∀ x : D, divisionNorm K D x = 1 → ∃ i : ℕ, divisionNorm K D (x - ζ ^ i) < 1 := by
    intro x hx
    obtain ⟨i, hi⟩ := hcov x hx
    refine ⟨i, ?_⟩
    have he : x - ζ ^ i = (x - y ^ i) + (y ^ i - ζ ^ i) := by abel
    rw [he]
    refine lt_of_le_of_lt (divisionNorm_isNonarchimedean _ _) (max_lt hi ?_)
    rw [← divisionNorm_neg, neg_sub]
    exact hdiff i
  refine ⟨ζ, hζpow, ?_, hcovζ⟩
  -- the order of `ζ` is exactly `Q - 1`
  set ζO : divisionIntegers K D := ⟨ζ, mem_divisionIntegers.2 hζnorm.le⟩ with hζO
  have hcast : ∀ i : ℕ, ((ζO ^ i : divisionIntegers K D) : DivisionResidue K D)
      = ((ζO : DivisionResidue K D)) ^ i := fun i => by
    simp
  have hone : ((1 : divisionIntegers K D) : DivisionResidue K D) = 1 := rfl
  have hg0 : ((ζO : DivisionResidue K D)) ≠ 0 := fun h => by
    have h1 := (divisionResidue_eq_zero_iff ζO).1 h
    rw [hζO] at h1
    simp only at h1
    rw [hζnorm] at h1
    exact absurd h1 (lt_irrefl 1)
  have hgen : ∀ r : DivisionResidue K D, r ≠ 0 →
      ∃ i : ℕ, r = ((ζO : DivisionResidue K D)) ^ i := by
    intro r hr
    obtain ⟨x, rfl⟩ := (divisionResidueCon K D).mk'_surjective r
    rw [RingCon.coe_mk'] at hr ⊢
    have hxle := mem_divisionIntegers.1 x.2
    have hx1 : divisionNorm K D (x : D) = 1 := by
      refine le_antisymm hxle (le_of_not_gt fun hlt => hr ?_)
      exact (divisionResidue_eq_zero_iff x).2 hlt
    obtain ⟨i, hi⟩ := hcovζ (x : D) hx1
    refine ⟨i, ?_⟩
    rw [← hcast i]
    refine divisionResidue_eq_iff.2 ?_
    rw [hζO]
    simpa using hi
  intro m hm
  refine card_sub_one_dvd_of_pow_eq_one hg0 hgen (m := m) ?_
  rw [← hcast m, ← hone]
  refine divisionResidue_eq_iff.2 ?_
  rw [hζO]
  simp [hm]

end Residue

/-! ### The unramified maximal subfield is generated by a root of unity -/

section Generator

variable (K D : Type u) [NontriviallyNormedField K] [IsUltrametricDist K] [ProperSpace K]
variable [DivisionRing D] [Algebra K D] [FiniteDimensional K D] [Algebra.IsCentral K D]

/-- **A division algebra over a nonarchimedean local field is generated over its base field by a
root of unity of order one less than the number of residues.**  The subfield it generates has degree
the square root of the dimension, and the absolute values of its nonzero elements are exactly the
absolute values of the nonzero scalars. -/
theorem exists_rootOfUnity_unramified_generator {n : ℕ} (hn : n * n = finrank K D) :
    ∃ ζ : D, ζ ^ (Nat.card (DivisionResidue K D) - 1) = 1 ∧
      (∀ m : ℕ, ζ ^ m = 1 → Nat.card (DivisionResidue K D) - 1 ∣ m) ∧
      IsField ↥(Algebra.adjoin K ({ζ} : Set D)) ∧
      finrank K ↥(Algebra.adjoin K ({ζ} : Set D)) = n ∧
      ∀ z : D, z ∈ Algebra.adjoin K ({ζ} : Set D) → z ≠ 0 →
        ∃ c : K, c ≠ 0 ∧ divisionNorm K D z = ‖c‖ := by
  obtain ⟨ζ, hζpow, hζord, hζcov⟩ := exists_rootOfUnity_pow_divisionNorm_sub_lt_one K D
  have hζmem : ζ ∈ Algebra.adjoin K ({ζ} : Set D) := Algebra.subset_adjoin (Set.mem_singleton ζ)
  have hdn : finrank K ↥(Algebra.adjoin K ({ζ} : Set D)) ≤ n := by
    have hsq := finrank_adjoin_singleton_mul_self_le K ζ
    rw [← hn] at hsq
    by_contra hcon
    push_neg at hcon
    nlinarith
  have hcov : ∀ x : D, divisionNorm K D x ≤ 1 →
      ∃ z : ↥(Algebra.adjoin K ({ζ} : Set D)), divisionNorm K D (x - (z : D)) < 1 := by
    intro x hx
    rcases lt_or_eq_of_le hx with hlt | heq
    · exact ⟨0, by simpa using hlt⟩
    · obtain ⟨i, hi⟩ := hζcov x heq
      exact ⟨⟨ζ ^ i, pow_mem hζmem i⟩, hi⟩
  obtain ⟨h1, h2⟩ := finrank_eq_and_exists_norm_eq_of_cover hn hdn hcov
  exact ⟨ζ, hζpow, hζord, isField_adjoin_singleton (K := K) ζ, h1, h2⟩

end Generator

end InverseGalois.CFT
