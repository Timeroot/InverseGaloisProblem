import Mathlib
import InverseGalois.CFT.Brauer.DivisionNorm
import InverseGalois.CFT.Local.SpectralNorm

/-!
# The absolute value of a division algebra over a complete field

Let `K` be a field complete with respect to a nontrivial nonarchimedean absolute value and let `D`
be a finite-dimensional division algebra over `K`, of dimension `N`.  Setting

`|x| = ‖N_{D/K}(x)‖ ^ (1 / N)`

produces an absolute value on `D` extending that of `K`.  Multiplicativity is free, the norm being
a monoid homomorphism, and non-vanishing is free too, `N_{D/K}(x)` being a unit whenever `x` is.
The ultrametric inequality is the only substantial point, and it is reduced to the commutative
case: dividing by `y` turns `|x + y| ≤ max |x| |y|` into `|z + 1| ≤ max |z| 1`, and `z + 1` lies in
the subfield `K[z]` generated by the single element `z`, where the quantity above is Mathlib's
spectral norm (`InverseGalois.CFT.spectralNorm_eq_norm_algebraNorm_rpow`) and hence
nonarchimedean.

## Main results

* `InverseGalois.CFT.divisionNorm`: the function `x ↦ ‖N_{D/K}(x)‖ ^ (1 / N)`.
* `InverseGalois.CFT.divisionNorm_mul`, `InverseGalois.CFT.divisionNorm_eq_zero_iff`,
  `InverseGalois.CFT.divisionNorm_algebraMap`: it is multiplicative, faithful, and extends the
  absolute value of `K`.
* `InverseGalois.CFT.divisionNorm_algHom`: on a subfield of `D` it is the spectral norm.
* `InverseGalois.CFT.divisionNorm_isNonarchimedean`: the ultrametric inequality.

## Tags

division algebra, absolute value, spectral norm, complete field
-/

universe u

open Module

namespace InverseGalois.CFT

/-! ### The definition and its formal properties -/

section Defs

variable (K : Type u) [NormedField K] (D : Type u) [Ring D] [Algebra K D]

/-- The absolute value of a finite-dimensional algebra over a normed field: the `N`-th root of
the absolute value of the algebra norm, where `N` is the dimension. -/
noncomputable def divisionNorm (x : D) : ℝ := ‖Algebra.norm K x‖ ^ (1 / finrank K D : ℝ)

variable {K D}

theorem divisionNorm_nonneg (x : D) : 0 ≤ divisionNorm K D x :=
  Real.rpow_nonneg (norm_nonneg _) _

theorem divisionNorm_one : divisionNorm K D 1 = 1 := by
  rw [divisionNorm, map_one, norm_one, Real.one_rpow]

theorem divisionNorm_mul (x y : D) :
    divisionNorm K D (x * y) = divisionNorm K D x * divisionNorm K D y := by
  rw [divisionNorm, divisionNorm, divisionNorm, map_mul, norm_mul,
    Real.mul_rpow (norm_nonneg _) (norm_nonneg _)]

variable [Nontrivial D] [FiniteDimensional K D]

theorem divisionNorm_algebraMap (k : K) : divisionNorm K D (algebraMap K D k) = ‖k‖ := by
  have hN : (finrank K D : ℝ) ≠ 0 := Nat.cast_ne_zero.2 (Module.finrank_pos (R := K) (M := D)).ne'
  rw [divisionNorm, Algebra.norm_algebraMap, norm_pow,
    ← Real.rpow_natCast ‖k‖ (finrank K D), ← Real.rpow_mul (norm_nonneg _),
    mul_one_div, div_self hN, Real.rpow_one]

end Defs

/-! ### Faithfulness -/

section Faithful

variable {K D : Type u} [NormedField K] [DivisionRing D] [Algebra K D]

theorem algebraNorm_ne_zero {x : D} (hx : x ≠ 0) : Algebra.norm K x ≠ 0 := by
  have h : Algebra.norm K x * Algebra.norm K x⁻¹ = 1 := by
    rw [← map_mul, mul_inv_cancel₀ hx, map_one]
  exact left_ne_zero_of_mul_eq_one h

variable [FiniteDimensional K D]

theorem divisionNorm_eq_zero_iff {x : D} : divisionNorm K D x = 0 ↔ x = 0 := by
  have hN : (1 / finrank K D : ℝ) ≠ 0 := by
    simp [Nat.cast_ne_zero.2 (Module.finrank_pos (R := K) (M := D)).ne']
  constructor
  · intro h
    by_contra hx
    rw [divisionNorm, Real.rpow_eq_zero_iff_of_nonneg (norm_nonneg _)] at h
    exact algebraNorm_ne_zero hx (norm_eq_zero.1 h.1)
  · rintro rfl
    have hb := Module.Free.chooseBasis K D
    haveI : Nonempty (Module.Free.ChooseBasisIndex K D) := hb.index_nonempty
    have h0 : Algebra.norm K (0 : D) = 0 := by
      rw [Algebra.norm_apply, map_zero, LinearMap.det_zero' hb]
    rw [divisionNorm, h0, norm_zero, Real.zero_rpow hN]

end Faithful

/-! ### The ultrametric inequality -/

section Ultrametric

variable {K D : Type u} [NontriviallyNormedField K] [IsUltrametricDist K] [CompleteSpace K]
variable [DivisionRing D] [Algebra K D]

/-- On a subfield of `D` the absolute value of `D` is the spectral norm. -/
theorem divisionNorm_algHom {L : Type u} [Field L] [Algebra K L] [FiniteDimensional K L]
    (f : L →ₐ[K] D) {d : ℕ} (hd : 0 < d) (hdim : finrank K L * d = finrank K D)
    (hnorm : ∀ y : L, Algebra.norm K (f y) = Algebra.norm K y ^ d) (y : L) :
    divisionNorm K D (f y) = spectralNorm K L y := by
  have hn : (finrank K L : ℝ) ≠ 0 := Nat.cast_ne_zero.2 (Module.finrank_pos (R := K) (M := L)).ne'
  have hd' : (d : ℝ) ≠ 0 := Nat.cast_ne_zero.2 hd.ne'
  rw [divisionNorm, hnorm, norm_pow, spectralNorm_eq_norm_algebraNorm_rpow,
    ← Real.rpow_natCast ‖Algebra.norm K y‖ d, ← Real.rpow_mul (norm_nonneg _), ← hdim]
  congr 1
  push_cast
  field_simp

variable [FiniteDimensional K D]

/-- **The absolute value of a division algebra over a complete nonarchimedean field is
nonarchimedean.** Dividing by `y` reduces the claim to `|z + 1| ≤ max |z| 1`, and `z + 1` lies in
the commutative subfield generated by `z`, where the absolute value is the spectral norm. -/
theorem divisionNorm_isNonarchimedean : IsNonarchimedean (divisionNorm K D) := by
  intro x y
  rcases eq_or_ne y 0 with rfl | hy
  · rw [add_zero]
    exact le_max_left _ _
  set z := x * y⁻¹ with hz
  have hxz : z * y = x := inv_mul_cancel_right₀ hy x
  obtain ⟨L, _, _, f, d, hfinL, hd0, hrange, hdim, hnorm⟩ := exists_algHom_norm_pow (K := K) z
  haveI : FiniteDimensional K L := hfinL
  haveI : Algebra.IsAlgebraic K L := Algebra.IsAlgebraic.of_finite K L
  obtain ⟨v, hv⟩ : z ∈ Set.range f := by
    rw [hrange]; exact Algebra.self_mem_adjoin_singleton K z
  have hfv : f (v + 1) = z + 1 := by rw [map_add, map_one, hv]
  have hsplit : x + y = f (v + 1) * y := by rw [hfv, add_mul, one_mul, hxz]
  have key : divisionNorm K D (f (v + 1)) ≤ max (divisionNorm K D z) 1 := by
    have h := isNonarchimedean_spectralNorm (K := K) (L := L) v 1
    rw [spectralNorm_one, ← divisionNorm_algHom f hd0 hdim hnorm v, hv,
      ← divisionNorm_algHom f hd0 hdim hnorm (v + 1)] at h
    exact h
  calc divisionNorm K D (x + y) = divisionNorm K D (f (v + 1)) * divisionNorm K D y := by
        rw [hsplit, divisionNorm_mul]
    _ ≤ max (divisionNorm K D z) 1 * divisionNorm K D y :=
        mul_le_mul_of_nonneg_right key (divisionNorm_nonneg _)
    _ = max (divisionNorm K D z * divisionNorm K D y) (divisionNorm K D y) := by
        rw [max_mul_of_nonneg _ _ (divisionNorm_nonneg (K := K) y), one_mul]
    _ = max (divisionNorm K D x) (divisionNorm K D y) := by
        rw [← divisionNorm_mul, hxz]

end Ultrametric

end InverseGalois.CFT
