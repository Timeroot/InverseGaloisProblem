import Mathlib
import InverseGalois.CFT.Brauer.PlaceTotallyRamified
import InverseGalois.CFT.Brauer.RadicalInvariant

/-!
# The invariant at a place whose completion is a radical extension

The invariant of a Brauer class at a finite place is the local invariant of its base change to the
completion, and the base change of a cyclic algebra is the cyclic algebra of the decomposition
group with the same coefficient.  When the completion of the extension is generated by a radical —
an element whose power is a unit of the completion of the base, multiplied by a root of unity by
the local generator — the local invariant is the power residue symbol of the coefficient against
that unit.

Nothing is asked of the place: it may be ramified, and in the intended application it is totally
ramified, which is exactly the case the unramified formula cannot see.  At a totally ramified place
the local generator restricts to the global one with no correcting power, so the discrete logarithm
of the Frobenius disappears from the statement and only the symbol remains.

## Main results

* `InverseGalois.CFT.placeInvariant_cyclicBrauerHom_of_radical`: **the invariant at a finite place
  of a cyclic algebra whose completed splitting field is presented by a radical is the inverse of
  the power residue symbol of its coefficient against the power of the radical.**
* `InverseGalois.CFT.placeInvariant_cyclicBrauerHom_of_radical_of_inertia_eq_top`: the same
  statement at a totally ramified place, where the local generator restricts to the global one.

## Tags

Brauer group, cyclic algebra, local invariant, power residue symbol, radical extension, totally
ramified, class field theory
-/

set_option synthInstance.maxHeartbeats 1000000

namespace InverseGalois.CFT

open IsDedekindDomain MulAction NumberField

open scoped Pointwise

/-! ### The invariant against a radical of the completion -/

section PlaceRadical

attribute [local instance] isGalois_adicCompletion

variable {k K : Type} [Field k] [NumberField k] [Field K] [NumberField K] [Algebra k K]
  [IsGalois k K] (w : HeightOneSpectrum (𝓞 K)) {p e n : ℕ} [NeZero n]

variable (k) in
/-- **The invariant at a finite place of a cyclic algebra whose completed splitting field is
presented by a radical is the inverse of the power residue symbol of its coefficient against the
power of the radical.**  Base change to the completion turns the cyclic algebra into the cyclic
algebra of the decomposition group with the same coefficient, and a level presented by a radical
carries the Kummer character of that power. -/
theorem placeInvariant_cyclicBrauerHom_of_radical
    (hres : HasResidueChar ((primeUnder (𝓞 k) w).adicCompletion k) p e)
    {ζ : (primeUnder (𝓞 k) w).adicCompletion k} (hζ : IsPrimitiveRoot ζ n) {σ₀ : Gal(K/k)}
    (hσ₀ : ∀ x : Gal(K/k), x ∈ Subgroup.zpowers σ₀)
    {σ : Gal(w.adicCompletion K/(primeUnder (𝓞 k) w).adicCompletion k)}
    (hσ : ∀ x : Gal(w.adicCompletion K/(primeUnder (𝓞 k) w).adicCompletion k),
      x ∈ Subgroup.zpowers σ)
    (hrestr : (localDecompositionEquiv k w σ).restrictScalars k
      = σ₀ ^ (stabilizer Gal(K/k) w).index)
    (hcard : Nat.card Gal(w.adicCompletion K/(primeUnder (𝓞 k) w).adicCompletion k) = n)
    {b : ((primeUnder (𝓞 k) w).adicCompletion k)ˣ} {ν : w.adicCompletion K}
    (hpow : ν ^ n
      = algebraMap ((primeUnder (𝓞 k) w).adicCompletion k) (w.adicCompletion K) (b : _))
    (hact : σ ν
      = algebraMap ((primeUnder (𝓞 k) w).adicCompletion k) (w.adicCompletion K) ζ * ν)
    (a : kˣ) :
    placeInvariant k (primeUnder (𝓞 k) w) (cyclicBrauerHom hσ₀ a)
      = (localSymbol hres
          (isUnitValGen_one (valued_adicCompletion_surjective (primeUnder (𝓞 k) w))) hζ
          (Units.map (algebraMap k ((primeUnder (𝓞 k) w).adicCompletion k)).toMonoidHom a)
          b)⁻¹ := by
  rw [placeInvariant_apply, baseChangeHom_cyclicBrauerHom_adicCompletion k w hσ₀ hσ hrestr a]
  exact localInvariantHom_cyclicBrauerHom_eq_inv_localSymbol_of_radical hres
    (isUnitValGen_one (valued_adicCompletion_surjective (primeUnder (𝓞 k) w))) hζ hσ hcard hpow
    hact _

variable (k) in
/-- **At a totally ramified place the invariant of a cyclic algebra whose completed splitting field
is presented by a radical is the inverse of the power residue symbol of its coefficient against the
power of the radical**, for a local generator restricting to the global one.  The decomposition
group is the whole Galois group, so its index carries no correcting power. -/
theorem placeInvariant_cyclicBrauerHom_of_radical_of_inertia_eq_top
    (hres : HasResidueChar ((primeUnder (𝓞 k) w).adicCompletion k) p e)
    (hinertia : Ideal.inertia Gal(K/k) w.asIdeal = ⊤)
    {ζ : (primeUnder (𝓞 k) w).adicCompletion k} (hζ : IsPrimitiveRoot ζ n) {σ₀ : Gal(K/k)}
    (hσ₀ : ∀ x : Gal(K/k), x ∈ Subgroup.zpowers σ₀)
    {σ : Gal(w.adicCompletion K/(primeUnder (𝓞 k) w).adicCompletion k)}
    (hσ : ∀ x : Gal(w.adicCompletion K/(primeUnder (𝓞 k) w).adicCompletion k),
      x ∈ Subgroup.zpowers σ)
    (hrestr : (localDecompositionEquiv k w σ).restrictScalars k = σ₀)
    (hcard : Nat.card Gal(w.adicCompletion K/(primeUnder (𝓞 k) w).adicCompletion k) = n)
    {b : ((primeUnder (𝓞 k) w).adicCompletion k)ˣ} {ν : w.adicCompletion K}
    (hpow : ν ^ n
      = algebraMap ((primeUnder (𝓞 k) w).adicCompletion k) (w.adicCompletion K) (b : _))
    (hact : σ ν
      = algebraMap ((primeUnder (𝓞 k) w).adicCompletion k) (w.adicCompletion K) ζ * ν)
    (a : kˣ) :
    placeInvariant k (primeUnder (𝓞 k) w) (cyclicBrauerHom hσ₀ a)
      = (localSymbol hres
          (isUnitValGen_one (valued_adicCompletion_surjective (primeUnder (𝓞 k) w))) hζ
          (Units.map (algebraMap k ((primeUnder (𝓞 k) w).adicCompletion k)).toMonoidHom a) b)⁻¹ :=
  placeInvariant_cyclicBrauerHom_of_radical k w hres hζ hσ₀ hσ
    (by rw [hrestr, index_stabilizer_eq_one_of_inertia_eq_top w hinertia, pow_one]) hcard hpow
    hact a

end PlaceRadical

end InverseGalois.CFT
