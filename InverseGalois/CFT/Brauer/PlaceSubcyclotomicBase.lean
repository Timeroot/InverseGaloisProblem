import Mathlib
import InverseGalois.CFT.Brauer.CyclicTower
import InverseGalois.CFT.Brauer.PlaceFrobeniusDegree
import InverseGalois.CFT.Brauer.PlaceSubcyclotomic

/-!
# The invariant at a place of a subfield generated by a root of unity, over an arbitrary base

The invariant of a cyclic algebra at an unramified finite place is known when the splitting field
is generated by a root of unity, because the Frobenius is then the automorphism raising that root
of unity to the power given by the number of residues of the base.  A subfield of such a field
inherits the computation through the compatibility of cyclic algebras along a tower: the cyclic
algebra of the subfield for the restricted generator is the cyclic algebra of the larger field for
the coefficient raised to the relative degree.

Raising the coefficient to the relative degree multiplies its value at the place by that degree,
and the degree of the larger field is the degree of the subfield times the same relative degree, so
the two factors cancel in the rationals modulo the integers and the answer is the one the subfield
alone would predict.  Over the rationals this is what makes the totally real subfield of a
cyclotomic field of prime conductor usable; the same argument runs over an arbitrary number field,
with the number of residues of the base supplying the exponent.

## Main results

* `InverseGalois.CFT.placeInvariant_cyclicBrauerHom_subcyclotomic_base`: **the invariant at an
  unramified finite place of a cyclic algebra over an arbitrary number field, split by a subfield
  of an extension generated by a root of unity**, in terms of the exponent expressing the
  automorphism raising that root of unity to the power of the number of residues of the base as a
  power of the chosen generator.

## Tags

number field, cyclotomic field, subfield, Brauer group, local invariant, cyclic algebra, tower,
reciprocity, class field theory
-/

set_option synthInstance.maxHeartbeats 1000000
set_option maxHeartbeats 1000000

namespace InverseGalois.CFT

open IsDedekindDomain Module NumberField

section SubcyclotomicBase

attribute [local instance] isGalois_adicCompletion

variable {k K F : Type} [Field k] [NumberField k] [Field K] [NumberField K] [Algebra k K]
  [IsGalois k K] [Field F] [NumberField F] [Algebra k F] [Algebra F K] [IsScalarTower k F K]
  [IsGalois k F] (w : HeightOneSpectrum (𝓞 K))

variable (k F) in
/-- **The invariant at an unramified finite place of a cyclic algebra over an arbitrary number
field, split by a subfield of an extension generated by a root of unity.**  The cyclic algebra of
the subfield for the restricted generator is the cyclic algebra of the larger field for the
coefficient raised to the relative degree, and the relative degree cancels between the value of
that power and the degree of the larger field. -/
theorem placeInvariant_cyclicBrauerHom_subcyclotomic_base {σ : Gal(K/k)}
    (hσ : ∀ x : Gal(K/k), x ∈ Subgroup.zpowers σ) {p : ℕ} (hp : p.Prime)
    [(primeUnder (𝓞 k) w).asIdeal.LiesOver (Ideal.span {(p : ℤ)})] (hram : ramIdx (𝓞 k) w = 1)
    {m : ℕ} (hm : m ≠ 0) (hmv : w.valuation K ((m : ℕ) : K) = 1) {ζ : K} (hζ : ζ ^ m = 1)
    (hgen : Algebra.adjoin k ({ζ} : Set K) = ⊤) {τ : Gal(K/k)}
    (hτ : τ ζ = ζ ^ p ^ (Ideal.span {(p : ℤ)}).inertiaDeg (primeUnder (𝓞 k) w).asIdeal) {c : ℕ}
    (hc : τ = σ ^ c) (a : kˣ) :
    placeInvariant k (primeUnder (𝓞 k) w)
        (cyclicBrauerHom (forall_mem_zpowers_restrictNormal (L := F) hσ) a)
      = Multiplicative.ofAdd (intQModZ (Nat.card Gal(F/k))
        ((c : ℤ) * placeValue (primeUnder (𝓞 k) w) a)) := by
  haveI : Module.Finite F K := FiniteDimensional.right k F K
  have hd : finrank F K ≠ 0 := Module.finrank_pos.ne'
  have hfin : finrank k F * finrank F K = finrank k K := Module.finrank_mul_finrank k F K
  have key : (c : ℤ) * placeValue (primeUnder (𝓞 k) w) (a ^ finrank F K)
      = ((c : ℤ) * placeValue (primeUnder (𝓞 k) w) a) * (finrank F K : ℤ) := by
    rw [placeValue_pow]
    ring
  rw [cyclicBrauerHom_restrictNormal hσ a,
    placeInvariant_cyclicBrauerHom_of_adjoin k w hσ hp hram hm hmv hζ hgen hτ hc
      (a ^ finrank F K),
    key, IsGalois.card_aut_eq_finrank k K, ← hfin, IsGalois.card_aut_eq_finrank k F,
    intQModZ_mul_natCast _ hd]

end SubcyclotomicBase

end InverseGalois.CFT
