import Mathlib
import InverseGalois.CFT.Brauer.PlaceCyclotomic
import InverseGalois.CFT.Brauer.PlaceFrobenius
import InverseGalois.CFT.Brauer.ResidueCardDegree

/-!
# The Frobenius of a place of arbitrary residue degree

The Frobenius automorphism of an unramified place raises a root of unity to the power given by the
number of residues of the base field.  Over the rationals that number is the rational prime below
the place, because every finite place of the rationals has residue degree one.  Over an arbitrary
number field it is the rational prime raised to the residue degree of the place of the base over
the rational prime below it.

That is the only change the cyclotomic description of the Frobenius needs in order to hold over an
arbitrary base: the Frobenius of a place of an extension generated by a root of unity is the
automorphism raising that root of unity to the power given by the number of residues, and the
invariant of a cyclic algebra at an unramified finite place is the exponent expressing that
automorphism as a power of the chosen generator, times the value of the coefficient, divided by the
degree.

## Main results

* `InverseGalois.CFT.restrictToBase_divisionFrobenius_rootOfUnity_pow`: **the Frobenius of an
  unramified place raises a root of unity to the power of the rational prime below the place raised
  to the residue degree of the base.**
* `InverseGalois.CFT.restrictToBase_divisionFrobenius_eq_of_adjoin_pow`: **when the extension is
  generated by that root of unity the description determines the Frobenius.**
* `InverseGalois.CFT.placeInvariant_cyclicBrauerHom_of_adjoin`: **the invariant at an unramified
  place of a cyclic algebra whose splitting field is generated by a root of unity**, over an
  arbitrary number field.

## Tags

number field, completion, unramified place, Frobenius, residue degree, root of unity, local
invariant, cyclic algebra, class field theory
-/

set_option synthInstance.maxHeartbeats 1000000

namespace InverseGalois.CFT

open IsDedekindDomain Module MulAction NumberField

section PlaceFrobeniusDegree

attribute [local instance] isGalois_adicCompletion

variable {k K : Type} [Field k] [NumberField k] [Field K] [NumberField K] [Algebra k K]
  [IsGalois k K] (w : HeightOneSpectrum (𝓞 K))

/-! ### The cyclotomic description of the Frobenius -/

variable (k) in
/-- **The Frobenius of an unramified place raises a root of unity of the extension to the power of
the rational prime below the place raised to the residue degree of the place of the base.**  The
completion of the base has that many residues. -/
theorem restrictToBase_divisionFrobenius_rootOfUnity_pow {p : ℕ} (hp : p.Prime)
    [(primeUnder (𝓞 k) w).asIdeal.LiesOver (Ideal.span {(p : ℤ)})] (hram : ramIdx (𝓞 k) w = 1)
    {m : ℕ} (hm : m ≠ 0) (hmv : w.valuation K (m : K) = 1) {ζ : K} (hζ : ζ ^ m = 1) :
    restrictToBase k w (divisionFrobenius ((primeUnder (𝓞 k) w).adicCompletion k)
        (w.adicCompletion K)
        (fun z hz => exists_divisionNorm_eq_norm_adicCompletion k w hram z hz)) ζ
      = ζ ^ p ^ (Ideal.span {(p : ℤ)}).inertiaDeg (primeUnder (𝓞 k) w).asIdeal := by
  rw [restrictToBase_divisionFrobenius_rootOfUnity k w hram hm hmv hζ,
    natCard_divisionResidue_adicCompletion_eq_pow_inertiaDeg hp (primeUnder (𝓞 k) w)]

variable (k) in
/-- **The Frobenius of an unramified place of an extension generated by a root of unity is the
automorphism raising that root of unity to the power of the rational prime below the place raised
to the residue degree of the place of the base.** -/
theorem restrictToBase_divisionFrobenius_eq_of_adjoin_pow {p : ℕ} (hp : p.Prime)
    [(primeUnder (𝓞 k) w).asIdeal.LiesOver (Ideal.span {(p : ℤ)})] (hram : ramIdx (𝓞 k) w = 1)
    {m : ℕ} (hm : m ≠ 0) (hmv : w.valuation K (m : K) = 1) {ζ : K} (hζ : ζ ^ m = 1)
    (hgen : Algebra.adjoin k ({ζ} : Set K) = ⊤) {τ : Gal(K/k)}
    (hτ : τ ζ = ζ ^ p ^ (Ideal.span {(p : ℤ)}).inertiaDeg (primeUnder (𝓞 k) w).asIdeal) :
    restrictToBase k w (divisionFrobenius ((primeUnder (𝓞 k) w).adicCompletion k)
        (w.adicCompletion K)
        (fun z hz => exists_divisionNorm_eq_norm_adicCompletion k w hram z hz)) = τ := by
  refine restrictToBase_divisionFrobenius_eq_of_adjoin k w hram hm hmv hζ hgen ?_
  rw [natCard_divisionResidue_adicCompletion_eq_pow_inertiaDeg hp (primeUnder (𝓞 k) w)]
  exact hτ

/-! ### The invariant at such a place -/

variable (k) in
/-- **The invariant at an unramified place of a cyclic algebra whose splitting field is generated
by a root of unity**, over an arbitrary number field.  The Frobenius raises the root of unity to
the power of the rational prime below the place raised to the residue degree of the place of the
base, so the exponent in the formula is the one of that automorphism. -/
theorem placeInvariant_cyclicBrauerHom_of_adjoin {σ₀ : Gal(K/k)}
    (hσ₀ : ∀ x : Gal(K/k), x ∈ Subgroup.zpowers σ₀) {p : ℕ} (hp : p.Prime)
    [(primeUnder (𝓞 k) w).asIdeal.LiesOver (Ideal.span {(p : ℤ)})] (hram : ramIdx (𝓞 k) w = 1)
    {m : ℕ} (hm : m ≠ 0) (hmv : w.valuation K ((m : ℕ) : K) = 1) {ζ : K} (hζ : ζ ^ m = 1)
    (hgen : Algebra.adjoin k ({ζ} : Set K) = ⊤) {τ : Gal(K/k)}
    (hτ : τ ζ = ζ ^ p ^ (Ideal.span {(p : ℤ)}).inertiaDeg (primeUnder (𝓞 k) w).asIdeal) {c : ℕ}
    (hc : τ = σ₀ ^ c) (a : kˣ) :
    placeInvariant k (primeUnder (𝓞 k) w) (cyclicBrauerHom hσ₀ a)
      = Multiplicative.ofAdd (intQModZ (Nat.card Gal(K/k))
        ((c : ℤ) * placeValue (primeUnder (𝓞 k) w) a)) := by
  refine placeInvariant_cyclicBrauerHom_eq_intQModZ_of_ramIdx_eq_one k w hσ₀ hram ?_ a
  rw [restrictToBase_divisionFrobenius_eq_of_adjoin_pow k w hp hram hm hmv hζ hgen hτ, hc]

end PlaceFrobeniusDegree

end InverseGalois.CFT
