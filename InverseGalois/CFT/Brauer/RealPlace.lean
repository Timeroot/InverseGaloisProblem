import Mathlib
import InverseGalois.CFT.Brauer.CyclicNorm
import InverseGalois.CFT.Brauer.Quaternion

/-!
# The Brauer group at the real place

The extension `ℂ / ℝ` is Galois with group of order two, generated by complex conjugation, so the
cyclic-algebra machinery of `InverseGalois.CFT.Brauer.CyclicNorm` identifies the relative Brauer
group `Br(ℂ / ℝ)` with the quotient of `ℝˣ` by the norms from `ℂˣ`.  The norm of `ℂ / ℝ` is the
squared absolute value, so the norms are exactly the positive reals and the quotient is the sign
group, cyclic of order two.

## Main results

* `InverseGalois.CFT.forall_mem_zpowers_conjAe`: `Gal(ℂ/ℝ)` is generated by complex conjugation.
* `InverseGalois.CFT.mem_normSubgroup_real_complex_iff`: the norms from `ℂˣ` are exactly the
  positive real units.
* `InverseGalois.CFT.realSign` and `InverseGalois.CFT.ker_realSign`: the sign homomorphism
  `ℝˣ →* Multiplicative (ZMod 2)`, whose kernel is the group of norms.
* `InverseGalois.CFT.realUnitsQuotientEquiv`: `ℝˣ / N(ℂˣ) ≃* Multiplicative (ZMod 2)`.
* `InverseGalois.CFT.brauerRelativeRealEquiv`: **the main result**, `Br(ℂ / ℝ)` is cyclic of order
  two, with the corollaries `InverseGalois.CFT.nontrivial_relative_real_complex`,
  `InverseGalois.CFT.card_relative_real_complex` and
  `InverseGalois.CFT.sq_eq_one_of_mem_relative_real`.

## Tags

Brauer group, real place, complex conjugation, norm
-/

open Module

namespace InverseGalois.CFT

/-! ### The Galois group of `ℂ / ℝ` -/

/-- **Complex conjugation generates `Gal(ℂ/ℝ)`.**  Every `ℝ`-algebra automorphism of `ℂ` is the
identity or complex conjugation, and both are powers of complex conjugation. -/
theorem forall_mem_zpowers_conjAe :
    ∀ x : Gal(ℂ/ℝ), x ∈ Subgroup.zpowers Complex.conjAe := by
  intro x
  rcases Complex.real_algHom_eq_id_or_conj x.toAlgHom with h | h
  · have hx : x = 1 := by
      refine AlgEquiv.ext fun z => ?_
      exact congrArg (fun f : ℂ →ₐ[ℝ] ℂ => f z) h
    rw [hx]
    exact one_mem _
  · have hx : x = Complex.conjAe := by
      refine AlgEquiv.ext fun z => ?_
      exact congrArg (fun f : ℂ →ₐ[ℝ] ℂ => f z) h
    rw [hx]
    exact Subgroup.mem_zpowers _

/-! ### The norms from `ℂ` -/

/-- The norm of a nonzero complex number is strictly positive. -/
theorem norm_real_complex_pos {z : ℂ} (hz : z ≠ 0) : 0 < Algebra.norm ℝ z := by
  rw [Algebra.norm_complex_apply]
  exact Complex.normSq_pos.mpr hz

/-- **The norms from `ℂ` are exactly the positive reals.**  A real unit is the norm of a complex
unit precisely when it is positive. -/
theorem mem_normSubgroup_real_complex_iff (a : ℝˣ) :
    a ∈ normSubgroup ℝ ℂ ↔ 0 < (a : ℝ) := by
  rw [mem_normSubgroup_iff]
  constructor
  · rintro ⟨b, hb⟩
    rw [← hb]
    exact norm_real_complex_pos b.ne_zero
  · intro ha
    have hs : (Real.sqrt (a : ℝ) : ℂ) ≠ 0 := by
      simpa using (Real.sqrt_pos.mpr ha).ne'
    refine ⟨Units.mk0 _ hs, ?_⟩
    rw [Units.val_mk0, Algebra.norm_complex_apply, Complex.normSq_ofReal]
    exact Real.mul_self_sqrt ha.le

/-! ### The sign homomorphism -/

/-- **The sign homomorphism** `ℝˣ →* Multiplicative (ZMod 2)`, sending a positive unit to `0` and
a negative unit to `1`. -/
noncomputable def realSign : ℝˣ →* Multiplicative (ZMod 2) where
  toFun a := Multiplicative.ofAdd (if 0 < (a : ℝ) then 0 else 1)
  map_one' := by simp
  map_mul' a b := by
    have ha : (a : ℝ) ≠ 0 := a.ne_zero
    have hb : (b : ℝ) ≠ 0 := b.ne_zero
    rw [← ofAdd_add]
    refine congrArg Multiplicative.ofAdd ?_
    simp only [Units.val_mul]
    rcases lt_or_gt_of_ne ha with ha' | ha' <;> rcases lt_or_gt_of_ne hb with hb' | hb'
    · rw [if_pos (mul_pos_of_neg_of_neg ha' hb'), if_neg (asymm ha'), if_neg (asymm hb')]
      decide
    · rw [if_neg (asymm (mul_neg_of_neg_of_pos ha' hb')), if_neg (asymm ha'), if_pos hb']
      ring
    · rw [if_neg (asymm (mul_neg_of_pos_of_neg ha' hb')), if_pos ha', if_neg (asymm hb')]
      ring
    · rw [if_pos (mul_pos ha' hb'), if_pos ha', if_pos hb']
      ring

/-- The sign homomorphism evaluated at a positive unit. -/
theorem realSign_of_pos {a : ℝˣ} (ha : 0 < (a : ℝ)) : realSign a = 1 := by
  simp [realSign, ha]

/-- The sign homomorphism evaluated at a negative unit. -/
theorem realSign_of_neg {a : ℝˣ} (ha : (a : ℝ) < 0) :
    realSign a = Multiplicative.ofAdd 1 := by
  simp [realSign, asymm ha]

/-- **The kernel of the sign homomorphism is the group of norms from `ℂˣ`.** -/
theorem ker_realSign : realSign.ker = normSubgroup ℝ ℂ := by
  ext a
  rw [MonoidHom.mem_ker, mem_normSubgroup_real_complex_iff]
  constructor
  · intro h
    by_contra hpos
    rw [realSign_of_neg (lt_of_le_of_ne (not_lt.mp hpos) a.ne_zero)] at h
    exact absurd (Multiplicative.ofAdd.injective h) (by decide)
  · intro h
    exact realSign_of_pos h

/-- The sign homomorphism is surjective. -/
theorem realSign_surjective : Function.Surjective realSign := by
  have hz : ∀ x : ZMod 2, x ≠ 0 → x = 1 := by decide
  intro y
  rcases eq_or_ne (Multiplicative.toAdd y) 0 with h | h
  · refine ⟨1, ?_⟩
    rw [realSign_of_pos (by norm_num)]
    exact (Multiplicative.toAdd.injective h).symm
  · refine ⟨-1, ?_⟩
    rw [realSign_of_neg (by norm_num)]
    exact (Multiplicative.toAdd.injective (hz _ h)).symm

/-- **The real units modulo the norms from `ℂ` form a group of order two.** -/
noncomputable def realUnitsQuotientEquiv :
    (ℝˣ ⧸ normSubgroup ℝ ℂ) ≃* Multiplicative (ZMod 2) :=
  (QuotientGroup.quotientMulEquivOfEq ker_realSign.symm).trans
    (QuotientGroup.quotientKerEquivOfSurjective _ realSign_surjective)

/-! ### The relative Brauer group of `ℂ / ℝ` -/

/-- **The relative Brauer group of `ℂ / ℝ` is cyclic of order two.**  This is the invariant of the
Brauer group at the real place. -/
noncomputable def brauerRelativeRealEquiv :
    BrauerGroup.relative ℝ ℂ ≃* Multiplicative (ZMod 2) :=
  (cyclicBrauerEquiv forall_mem_zpowers_conjAe).symm.trans realUnitsQuotientEquiv

/-- **The relative Brauer group of `ℂ / ℝ` is nontrivial.** -/
theorem nontrivial_relative_real_complex : Nontrivial (BrauerGroup.relative ℝ ℂ) :=
  brauerRelativeRealEquiv.toEquiv.nontrivial

/-- **The relative Brauer group of `ℂ / ℝ` has exactly two elements.** -/
theorem card_relative_real_complex : Nat.card (BrauerGroup.relative ℝ ℂ) = 2 := by
  rw [Nat.card_congr brauerRelativeRealEquiv.toEquiv]
  simp [Nat.card_eq_fintype_card]

/-- **Every Brauer class split by `ℂ` has order dividing two.** -/
theorem sq_eq_one_of_mem_relative_real (x : BrauerGroup ℝ)
    (hx : x ∈ BrauerGroup.relative ℝ ℂ) : x ^ 2 = 1 := by
  have h := pow_finrank_eq_one_of_mem_relative (K := ℝ) (L := ℂ) x hx
  rwa [Complex.finrank_real_complex] at h

end InverseGalois.CFT
