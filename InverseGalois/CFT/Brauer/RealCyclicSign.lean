/-!
# The archimedean invariants of a cyclic algebra with a totally complex splitting field

The complex numbers are a quadratic Galois extension of the reals, generated by complex
conjugation, so a real unit produces a cyclic algebra over the reals and hence an invariant at the
real place.  The kernel of the cyclic algebra construction is the group of norms, which over the
reals is the group of positive units, so this invariant is nothing but the sign of the unit, read
in the group of order two inside the rationals modulo the integers.

The same invariant governs a cyclic algebra over an arbitrary number field whose splitting field is
a quadratic extension with no real place.  At a real place of the base the completion is the reals,
the splitting field embeds into the complex numbers over that completion, and the embedding is not
real, so restriction identifies the Galois group of the complex numbers over the reals with the
Galois group of the splitting field over the base.  Base change therefore carries the cyclic
algebra over the base to the cyclic algebra over the reals with the same coefficient, read through
the embedding: the invariant at that place is the sign of the coefficient there.

Multiplying those signs over all the infinite places gives the product of the real embeddings of
the coefficient, and that product has the sign of the norm of the coefficient down to the
rationals.  Consequently the archimedean invariants of the algebra over the base multiply out to
the archimedean invariant of the corresponding algebra over the rationals, taken at the norm of the
coefficient.  This is the archimedean comparison that reciprocity over an arbitrary base needs when
the degree is two, where a totally real splitting field is not available.

## Main definitions

* `InverseGalois.CFT.realCyclicInvariant`: the invariant at the real place of the cyclic algebra
  attached to a real unit.

## Main results

* `InverseGalois.CFT.realCyclicInvariant_eq_one_iff`: **the cyclic algebra attached to a real unit
  is split exactly when the unit is positive.**
* `InverseGalois.CFT.realCyclicInvariant_eq_of_mul_pos`: two real units of the same sign have the
  same invariant.
* `InverseGalois.CFT.baseChangeHom_cyclicBrauerHom_real`: **base change to the reals carries a
  cyclic algebra whose splitting field is a totally complex quadratic extension to the cyclic
  algebra over the reals with the same coefficient.**
* `InverseGalois.CFT.infinitePlaceInvariant_cyclicBrauerHom_of_isTotallyComplex`: **the invariant of
  such an algebra at a real place is the sign of the coefficient there.**
* `InverseGalois.CFT.prod_infinitePlaceInvariant_cyclicBrauerHom_eq_rat`: **the archimedean
  invariants of such an algebra multiply out to the archimedean invariant over the rationals of the
  algebra attached to the norm of the coefficient.**

## Tags

Brauer group, real place, cyclic algebra, sign, norm, totally complex, invariant, reciprocity,
class field theory
-/

set_option synthInstance.maxHeartbeats 1000000
set_option maxHeartbeats 1000000

namespace InverseGalois.CFT

open Module NumberField

/-! ### The invariant of a cyclic algebra over the reals -/

/-- **The invariant at the real place of the cyclic algebra attached to a real unit**, the algebra
built from the quadratic extension by the complex numbers and complex conjugation. -/
noncomputable def realCyclicInvariant : ℝˣ →* Multiplicative QModZ :=
  realBrauerInvariant.comp (cyclicBrauerHom forall_mem_zpowers_conjAe)

theorem realCyclicInvariant_apply (a : ℝˣ) :
    realCyclicInvariant a = realBrauerInvariant (cyclicBrauerHom forall_mem_zpowers_conjAe a) :=
  rfl

/-- **The cyclic algebra attached to a real unit is split exactly when the unit is positive.**  The
kernel of the cyclic algebra construction is the group of norms from the complex numbers, and those
are exactly the positive reals. -/
theorem realCyclicInvariant_eq_one_iff (a : ℝˣ) : realCyclicInvariant a = 1 ↔ 0 < (a : ℝ) := by
  rw [realCyclicInvariant_apply, realBrauerInvariant_eq_one_iff, ← MonoidHom.mem_ker,
    mem_ker_cyclicBrauerHom_iff, ← mem_normSubgroup_iff, mem_normSubgroup_real_complex_iff]

/-- The invariant of a cyclic algebra over the reals has order dividing two, the Brauer group of
the reals having order two. -/
theorem realCyclicInvariant_sq (a : ℝˣ) : realCyclicInvariant a ^ 2 = 1 := by
  rw [realCyclicInvariant_apply, ← map_pow, sq_eq_one_brauerGroup_real, map_one]

/-- **Two real units of the same sign have the same invariant.**  Their product is positive, so its
invariant is trivial, and the invariant of either has order dividing two. -/
theorem realCyclicInvariant_eq_of_mul_pos {a b : ℝˣ} (h : 0 < (a : ℝ) * (b : ℝ)) :
    realCyclicInvariant a = realCyclicInvariant b := by
  have hab : realCyclicInvariant a * realCyclicInvariant b = 1 := by
    rw [← map_mul]
    exact (realCyclicInvariant_eq_one_iff (a * b)).mpr (by rwa [Units.val_mul])
  have hb : realCyclicInvariant b * realCyclicInvariant b = 1 := by
    rw [← sq]
    exact realCyclicInvariant_sq b
  calc realCyclicInvariant a
      = realCyclicInvariant a * (realCyclicInvariant b * realCyclicInvariant b) := by
        rw [hb, mul_one]
    _ = realCyclicInvariant b := by rw [← mul_assoc, hab, one_mul]

/-- Every automorphism of the complex numbers over the reals is the identity or complex
conjugation. -/
theorem eq_one_or_eq_conjAe (x : Gal(ℂ/ℝ)) : x = 1 ∨ x = Complex.conjAe := by
  rcases Complex.real_algHom_eq_id_or_conj x.toAlgHom with h | h
  · exact Or.inl (AlgEquiv.ext fun z => congrArg (fun f : ℂ →ₐ[ℝ] ℂ => f z) h)
  · exact Or.inr (AlgEquiv.ext fun z => congrArg (fun f : ℂ →ₐ[ℝ] ℂ => f z) h)

/-! ### Base change of a cyclic algebra to the reals -/

section Compositum

variable {k E : Type} [Field k] [NumberField k] [Field E] [NumberField E] [Algebra k E]
  [IsGalois k E] [IsTotallyComplex E] [Algebra k ℝ]

/-- **Base change to the reals carries a cyclic algebra over a number field whose splitting field
is a totally complex quadratic extension to the cyclic algebra over the reals with the same
coefficient.**  The splitting field embeds into the complex numbers over the given real embedding
of the base, and the embedding is not real, so restricting an automorphism of the complex numbers
over the reals to the splitting field is an injection of a group of order two into a group of order
two, hence a bijection carrying complex conjugation to the chosen generator.  Base change along a
field that is not intermediate then keeps the coefficient. -/
theorem baseChangeHom_cyclicBrauerHom_real (hdeg : finrank k E = 2) {σ₀ : Gal(E/k)}
    (hσ₀ : ∀ x : Gal(E/k), x ∈ Subgroup.zpowers σ₀) (a : kˣ) :
    BrauerGroup.baseChangeHom ℝ (cyclicBrauerHom hσ₀ a)
      = cyclicBrauerHom forall_mem_zpowers_conjAe (Units.map (algebraMap k ℝ).toMonoidHom a) := by
  letI : Algebra k ℂ := ((algebraMap ℝ ℂ).comp (algebraMap k ℝ)).toAlgebra
  haveI : IsScalarTower k ℝ ℂ := IsScalarTower.of_algebraMap_eq fun _ => rfl
  haveI : Algebra.IsAlgebraic k E := Algebra.IsAlgebraic.of_finite k E
  let φ : E →ₐ[k] ℂ := IsAlgClosed.lift
  letI : Algebra E ℂ := φ.toRingHom.toAlgebra
  haveI : IsScalarTower k E ℂ := IsScalarTower.of_algebraMap_eq fun x => (φ.commutes x).symm
  let f : Gal(ℂ/ℝ) →* Gal(E/k) :=
    (AlgEquiv.restrictNormalHom E).comp
      { toFun := fun σ => σ.restrictScalars k
        map_one' := rfl
        map_mul' := fun _ _ => rfl }
  have he : ∀ (σ : Gal(ℂ/ℝ)) (x : E), σ (algebraMap E ℂ x) = algebraMap E ℂ (f σ x) :=
    fun σ x => (AlgEquiv.restrictNormal_commutes (σ.restrictScalars k) E x).symm
  have hconj : f Complex.conjAe ≠ 1 := by
    intro h
    refine IsTotallyComplex.complexEmbedding_not_isReal (φ : E →+* ℂ) ?_
    refine ComplexEmbedding.isReal_iff.mpr (RingHom.ext fun x => ?_)
    have hx := he Complex.conjAe x
    rw [h, AlgEquiv.one_apply] at hx
    exact hx
  have hinj : Function.Injective f := by
    refine (injective_iff_map_eq_one f).mpr fun σ hσ => ?_
    rcases eq_one_or_eq_conjAe σ with h | h
    · exact h
    · rw [h] at hσ
      exact absurd hσ hconj
  have hσ₀ne : σ₀ ≠ 1 := by
    intro h
    refine hconj ?_
    obtain ⟨n, hn⟩ := Subgroup.mem_zpowers_iff.mp (hσ₀ (f Complex.conjAe))
    rw [← hn, h, one_zpow]
  have hcard : Nat.card Gal(E/k) = 2 := by rw [IsGalois.card_aut_eq_finrank k E, hdeg]
  obtain ⟨y, -, hy⟩ := (Nat.card_eq_two_iff' (1 : Gal(E/k))).mp hcard
  have hgen : f Complex.conjAe = σ₀ := (hy _ hconj).trans (hy _ hσ₀ne).symm
  have hsurj : Function.Surjective f := by
    intro z
    obtain ⟨n, hn⟩ := Subgroup.mem_zpowers_iff.mp (hσ₀ z)
    exact ⟨Complex.conjAe ^ n, by rw [map_zpow, hgen, hn]⟩
  exact baseChangeHom_cyclicBrauerHom_compositum (e := MulEquiv.ofBijective f ⟨hinj, hsurj⟩) hσ₀
    forall_mem_zpowers_conjAe hgen he a

end Compositum

/-! ### The invariant at a real place -/

section Place

variable {k E : Type} [Field k] [NumberField k] [Field E] [NumberField E] [Algebra k E]
  [IsGalois k E] [IsTotallyComplex E]

/-- **The invariant at a real place of a cyclic algebra whose splitting field is a totally complex
quadratic extension is the sign of the coefficient there.**  The completion at the place is the
reals along the associated embedding, and base change there keeps the coefficient. -/
theorem infinitePlaceInvariant_cyclicBrauerHom_of_isTotallyComplex (hdeg : finrank k E = 2)
    {σ₀ : Gal(E/k)} (hσ₀ : ∀ x : Gal(E/k), x ∈ Subgroup.zpowers σ₀) {u : InfinitePlace k}
    (hu : u.IsReal) (a : kˣ) :
    infinitePlaceInvariant k u (cyclicBrauerHom hσ₀ a)
      = realCyclicInvariant
          (Units.map (InfinitePlace.embedding_of_isReal hu).toMonoidHom a) := by
  letI : Algebra k ℝ := (InfinitePlace.embedding_of_isReal hu).toAlgebra
  rw [infinitePlaceInvariant_of_isReal k hu]
  show realEmbeddingInvariant k (cyclicBrauerHom hσ₀ a) = _
  rw [realEmbeddingInvariant_apply, baseChangeHom_cyclicBrauerHom_real hdeg hσ₀ a]
  rfl

end Place

/-! ### The archimedean comparison with the rationals -/

section Comparison

/-- Every infinite place of the rationals is real, the rationals having a single embedding into the
complex numbers. -/
theorem isReal_infinitePlace_rat (u : InfinitePlace ℚ) : u.IsReal :=
  InfinitePlace.isReal_iff.mpr (ComplexEmbedding.isReal_iff.mpr (Subsingleton.elim _ _))

variable {k E F₀ : Type} [Field k] [NumberField k] [Field E] [NumberField E] [Algebra k E]
  [IsGalois k E] [IsTotallyComplex E] [Field F₀] [NumberField F₀] [IsGalois ℚ F₀]
  [IsTotallyComplex F₀]

/-- **The archimedean invariants of a cyclic algebra whose splitting field is a totally complex
quadratic extension multiply out to the archimedean invariant over the rationals of the algebra
attached to the norm of the coefficient**, itself split by a totally complex quadratic field.  Each
factor on the left is the sign of the coefficient at a real place, so the product is the sign of the
product of the real embeddings of the coefficient; the complex places contribute a positive factor
to the norm, so that product has the sign of the norm, which is what the single factor on the right
reads. -/
theorem prod_infinitePlaceInvariant_cyclicBrauerHom_eq_rat (hdeg : finrank k E = 2)
    (hdeg₀ : finrank ℚ F₀ = 2) {σ₀ : Gal(E/k)} (hσ₀ : ∀ x : Gal(E/k), x ∈ Subgroup.zpowers σ₀)
    {τ₀ : Gal(F₀/ℚ)} (hτ₀ : ∀ x : Gal(F₀/ℚ), x ∈ Subgroup.zpowers τ₀) (a : kˣ) :
    (∏ u : InfinitePlace k, infinitePlaceInvariant k u (cyclicBrauerHom hσ₀ a))
      = ∏ u : InfinitePlace ℚ, infinitePlaceInvariant ℚ u
          (cyclicBrauerHom hτ₀ (Units.map (Algebra.norm ℚ : k →* ℚ) a)) := by
  classical
  set G : InfinitePlace k → ℝˣ := fun u =>
    if hu : u.IsReal then Units.map (InfinitePlace.embedding_of_isReal hu).toMonoidHom a else 1
    with hG
  have hGr : ∀ (u : InfinitePlace k) (hu : u.IsReal),
      G u = Units.map (InfinitePlace.embedding_of_isReal hu).toMonoidHom a := by
    intro u hu
    simp only [hG, dif_pos hu]
  have hGc : ∀ u : InfinitePlace k, u.IsComplex → G u = 1 := by
    intro u hu
    simp only [hG, dif_neg (InfinitePlace.not_isReal_iff_isComplex.mpr hu)]
  have hleft : (∏ u : InfinitePlace k, infinitePlaceInvariant k u (cyclicBrauerHom hσ₀ a))
      = realCyclicInvariant (∏ u : InfinitePlace k, G u) := by
    rw [map_prod]
    refine Finset.prod_congr rfl fun u _ => ?_
    rcases u.isReal_or_isComplex with hu | hu
    · rw [infinitePlaceInvariant_cyclicBrauerHom_of_isTotallyComplex hdeg hσ₀ hu a, hGr u hu]
    · rw [infinitePlaceInvariant_of_isComplex k hu, MonoidHom.one_apply, hGc u hu, map_one]
  obtain ⟨u₀⟩ : Nonempty (InfinitePlace ℚ) := inferInstance
  have hu₀ : u₀.IsReal := isReal_infinitePlace_rat u₀
  have hright : (∏ u : InfinitePlace ℚ, infinitePlaceInvariant ℚ u
        (cyclicBrauerHom hτ₀ (Units.map (Algebra.norm ℚ : k →* ℚ) a)))
      = realCyclicInvariant (Units.map (InfinitePlace.embedding_of_isReal hu₀).toMonoidHom
          (Units.map (Algebra.norm ℚ : k →* ℚ) a)) := by
    rw [prod_infinitePlaceInvariant_rat _ u₀,
      infinitePlaceInvariant_cyclicBrauerHom_of_isTotallyComplex hdeg₀ hτ₀ hu₀ _]
  rw [hleft, hright]
  refine realCyclicInvariant_eq_of_mul_pos ?_
  have hvalr : ∀ (u : InfinitePlace k) (hu : u.IsReal),
      ((G u : ℝ)) = InfinitePlace.embedding_of_isReal hu (a : k) := by
    intro u hu
    rw [hGr u hu]
    rfl
  have hvalc : ∀ u : InfinitePlace k, u.IsComplex → ((G u : ℝ)) = 1 := by
    intro u hu
    rw [hGc u hu, Units.val_one]
  have hprod : ((∏ u : InfinitePlace k, G u : ℝˣ) : ℝ)
      = ∏ u : InfinitePlace k, ((G u : ℝ)) := map_prod (Units.coeHom ℝ) G Finset.univ
  have hnorm : ((Units.map (InfinitePlace.embedding_of_isReal hu₀).toMonoidHom
      (Units.map (Algebra.norm ℚ : k →* ℚ) a) : ℝˣ) : ℝ)
      = ((Algebra.norm ℚ (a : k) : ℚ) : ℝ) := by
    show InfinitePlace.embedding_of_isReal hu₀ (Algebra.norm ℚ (a : k)) = _
    exact eq_ratCast (InfinitePlace.embedding_of_isReal hu₀) _
  rw [hprod, hnorm, mul_comm]
  exact InverseGalois.NumberTheory.norm_mul_prod_pos (f := fun u => ((G u : ℝ))) a.ne_zero
    hvalr hvalc

end Comparison

end InverseGalois.CFT
