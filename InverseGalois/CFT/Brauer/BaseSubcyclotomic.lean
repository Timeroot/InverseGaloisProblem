/-! ### The invariant at the conductor, read as a power residue congruence -/

section ConductorResidue

variable {q : ℕ} (k K F : Type) [Field k] [NumberField k] [Field K] [NumberField K]
  [Algebra k K] [IsGalois k K] [Field F] [NumberField F] [Algebra k F] [Algebra F K]
  [IsScalarTower k F K] [IsGalois k F]

/-- **The invariant at the place of the conductor of a cyclic algebra split by a subfield of the
field of the primitive roots of unity of an odd prime is named by the exponent expressing the
coefficient as a power residue there.**  The completion of the base at that place contains a
primitive root of unity of the degree congruent to the complementary power of the generator of the
residues, the invariant is the class of the exponent expressing the power residue symbol of the
coefficient as a power of that root of unity, and being close to a power of a root of unity is
being congruent to it modulo the place. -/
theorem exists_mk_pow_eq_placeInvariant_conductor (hq : q.Prime) (hodd : Odd q)
    {v : HeightOneSpectrum (𝓞 k)} (W : HeightOneSpectrum (𝓞 K))
    (hvW : primeUnder (𝓞 k) (primeUnder (𝓞 F) W) = v)
    (hmemK : ((q : ℕ) : 𝓞 K) ∈ W.asIdeal) {N M : ℕ} [NeZero N] (hcard : Nat.card Gal(F/k) = N)
    (hMN : finrank F K * N = q - 1) (hM : finrank F K = M)
    (hinertia : Ideal.inertia Gal(F/k) (primeUnder (𝓞 F) W).asIdeal = ⊤) (hram : ramIdx ℤ v = 1)
    {g : ℕ} (hgnd : ¬ q ∣ g) (hgord : ∀ m : ℕ, q ∣ g ^ m - 1 → (q - 1) ∣ m) {ζK : K}
    (hζK : IsPrimitiveRoot ζK q) {σ : Gal(K/k)} (hgen : ∀ x : Gal(K/k), x ∈ Subgroup.zpowers σ)
    (hσW : σ • W = W) (hσζ : σ ζK = ζK ^ g) {a : kˣ} {b : 𝓞 k}
    (hab : (a : k) = algebraMap (𝓞 k) k b) (hav : placeValue v a = 0) :
    ∃ j : ℕ,
      Ideal.Quotient.mk v.asIdeal (b ^ ((Nat.card (𝓞 k ⧸ v.asIdeal) - 1) / N))
          = Ideal.Quotient.mk v.asIdeal ((((g ^ M) ^ j : ℕ) : 𝓞 k)) ∧
        placeInvariant k v (cyclicBrauerHom (forall_mem_zpowers_restrictNormal (L := F) hgen) a)
          = Multiplicative.ofAdd (zmodQModZ N (j : ZMod N)) := by
  subst hvW
  subst hM
  haveI : Fact q.Prime := ⟨hq⟩
  haveI := liesOver_span_of_natCast_mem hq W hmemK
  have hmemF : ((q : ℕ) : 𝓞 F) ∈ (primeUnder (𝓞 F) W).asIdeal := by
    rw [primeUnder_asIdeal, Ideal.under_def, Ideal.mem_comap, map_natCast]
    exact hmemK
  have hmemk : ((q : ℕ) : 𝓞 k) ∈ (primeUnder (𝓞 k) (primeUnder (𝓞 F) W)).asIdeal := by
    rw [primeUnder_asIdeal, Ideal.under_def, Ideal.mem_comap, map_natCast]
    exact hmemF
  haveI := liesOver_span_of_natCast_mem hq (primeUnder (𝓞 k) (primeUnder (𝓞 F) W)) hmemk
  have hresidue :
      HasResidueChar ((primeUnder (𝓞 k) (primeUnder (𝓞 F) W)).adicCompletion k) q 1 :=
    hasResidueChar_adicCompletion_of_ramIdx_eq_one hq _ hram
  obtain ⟨ζ, hζprim, hζres⟩ :=
    exists_isPrimitiveRoot_valued_sub_natCast_lt_one hresidue hgnd hgord (NeZero.ne N) hMN
  have hav' : Valued.v (algebraMap k
      ((primeUnder (𝓞 k) (primeUnder (𝓞 F) W)).adicCompletion k) (a : k)) = 1 :=
    valued_eq_one_of_placeValue_eq_zero _ hav
  obtain ⟨j, hj, hinv⟩ := exists_placeInvariant_cyclicBrauerHom_conductor_base k K F hq hodd W
    hcard hMN hinertia hram hζK hgen hσW hσζ hζprim hζres hav'
  refine ⟨j, ?_, hinv⟩
  have hζ1 : Valued.v ζ ≤ 1 :=
    le_of_eq (valued_eq_one_of_pow_eq_one₀ (NeZero.ne N) hζprim.pow_eq_one)
  rw [hab] at hj
  exact mk_pow_eq_mk_natCast_pow_of_divisionResidue _ hζ1 hζres hj

end ConductorResidue

/-! ### Reciprocity over a number field for a subcyclotomic cyclic algebra -/

section BaseSubcyclotomic

variable {q : ℕ} [NeZero q] {k K E L₀ F₀ : Type} [Field k] [NumberField k]
  [Field K] [NumberField K] [Algebra k K] [IsGalois k K]
  [Field E] [NumberField E] [Algebra k E] [IsGalois k E] [Algebra E K] [IsScalarTower k E K]
  [Field L₀] [NumberField L₀] [IsCyclotomicExtension {q} ℚ L₀] [IsGalois ℚ L₀]
  [Field F₀] [NumberField F₀] [Algebra F₀ L₀] [IsScalarTower ℚ F₀ L₀] [IsGalois ℚ F₀]
  [IsTotallyReal F₀] [Algebra F₀ E]

/-- **The total invariant of a cyclic algebra over a number field split by a subfield of the field
of the primitive roots of unity of an odd prime, with an integral coefficient that is a unit above
that prime, vanishes.**  The comparison is with the algebra over the rationals attached to the same
subfield of the rational cyclotomic field and to the norm of the coefficient, whose total invariant
vanishes by reciprocity over the rationals.  Both splitting fields are generated by a totally real
field, so nothing is contributed at the infinite places; away from the conductor the invariants
above a rational prime are read from the same exponent weighted by the residue degrees, which add
up with the values to the value of the norm; and at the conductor the exponents naming the power
residues above the prime add up to the exponent naming the power residue of the norm below it. -/
theorem totalInvariant_cyclicBrauerHom_base_subcyclotomic (hq : q.Prime) (hodd : Odd q) {N : ℕ}
    [NeZero N] (hcardE : Nat.card Gal(E/k) = N) (hcardF₀ : Nat.card Gal(F₀/ℚ) = N)
    (hMN : finrank E K * N = q - 1) (hMN₀ : finrank F₀ L₀ * N = q - 1) (h2N : 2 * N ∣ q - 1)
    {g : ℕ} (hg : Nat.Coprime g q) (hgord : ∀ m : ℕ, q ∣ g ^ m - 1 → (q - 1) ∣ m)
    (hgen₀ : ∀ x : Gal(L₀/ℚ), x ∈ Subgroup.zpowers (cyclotomicPowerAut q L₀ hg))
    (hinertia₀ : ∀ (Q : Ideal (𝓞 F₀)) (_ : Q.IsPrime) (_ : Q.LiesOver (Ideal.span {(q : ℤ)})),
      Ideal.inertia Gal(F₀/ℚ) Q = ⊤)
    {σ : Gal(K/k)} (hσ : ∀ x : Gal(K/k), x ∈ Subgroup.zpowers σ) {ζ : K}
    (hζ : IsPrimitiveRoot ζ q) (hgenK : Algebra.adjoin k ({ζ} : Set K) = ⊤) (hσζ : σ ζ = ζ ^ g)
    (hgenE : Algebra.adjoin k (Set.range (algebraMap F₀ E)) = ⊤)
    (hinertiaE : ∀ (Q : Ideal (𝓞 E)) (_ : Q.IsPrime) (_ : Q.LiesOver (Ideal.span {(q : ℤ)})),
      Ideal.inertia Gal(E/k) Q = ⊤)
    (hσW : ∀ W : HeightOneSpectrum (𝓞 K), ((q : ℕ) : 𝓞 K) ∈ W.asIdeal → σ • W = W)
    (hunramk : ∀ v : HeightOneSpectrum (𝓞 k), ((q : ℕ) : 𝓞 k) ∈ v.asIdeal → ramIdx ℤ v = 1)
    (hunramK : ∀ (w : HeightOneSpectrum (𝓞 K)) (p : ℕ), p.Prime → ¬ p ∣ q →
      ((p : ℕ) : 𝓞 K) ∈ w.asIdeal → ramIdx (𝓞 k) w = 1)
    {a : kˣ} {b : 𝓞 k} (hab : (a : k) = algebraMap (𝓞 k) k b)
    (hav : ∀ v : HeightOneSpectrum (𝓞 k), ((q : ℕ) : 𝓞 k) ∈ v.asIdeal → placeValue v a = 0) :
    totalInvariant k (cyclicBrauerHom (forall_mem_zpowers_restrictNormal (L := E) hσ) a) = 1 := by
  haveI : Fact q.Prime := ⟨hq⟩
  have hgnd : ¬ q ∣ g := (Nat.Prime.coprime_iff_not_dvd hq).mp hg.symm
  have hM : finrank E K = finrank F₀ L₀ :=
    Nat.eq_of_mul_eq_mul_right (Nat.pos_of_ne_zero (NeZero.ne N)) (hMN.trans hMN₀.symm)
  have hab' : ((Units.map (Algebra.norm ℚ : k →* ℚ) a : ℚˣ) : ℚ)
      = algebraMap (𝓞 ℚ) ℚ (Algebra.norm (𝓞 ℚ) b) := by
    have h1 : ((Units.map (Algebra.norm ℚ : k →* ℚ) a : ℚˣ) : ℚ)
        = Algebra.norm ℚ ((a : k)) := rfl
    rw [h1, hab, algebraMap_norm_ringOfIntegers_rat b]
  refine totalInvariant_eq_one_of_fibre _
    (cyclicBrauerHom (forall_mem_zpowers_restrictNormal (L := F₀) hgen₀)
      (Units.map (Algebra.norm ℚ : k →* ℚ) a)) ?_ ?_ ?_ ?_
  · exact fun u => infinitePlaceInvariant_cyclicBrauerHom_of_adjoin_isTotallyReal
      (forall_mem_zpowers_restrictNormal (L := E) hσ) hgenE a u
  · exact fun u => infinitePlaceInvariant_cyclicBrauerHom_of_isTotallyReal
      (forall_mem_zpowers_restrictNormal (L := F₀) hgen₀) _ u
  · intro P
    obtain ⟨W₀, hW₀⟩ := exists_primeUnder_eq (𝓞 ℚ) (𝓞 L₀) P
    obtain ⟨p, hp, hPp, hPLO, hPdeg⟩ := exists_prime_liesOver_inertiaDeg_eq_one_rat P
    haveI : Fact p.Prime := ⟨hp⟩
    have hmemQ : ((p : ℕ) : 𝓞 ℚ) ∈ (primeUnder (𝓞 ℚ) W₀).asIdeal := by rw [hW₀]; exact hPp
    have hmemL₀ : ((p : ℕ) : 𝓞 L₀) ∈ W₀.asIdeal := by
      rw [primeUnder_asIdeal, Ideal.under_def, Ideal.mem_comap, map_natCast] at hmemQ
      exact hmemQ
    haveI := liesOver_span_of_natCast_mem hp W₀ hmemL₀
    haveI := liesOver_span_of_natCast_mem hp (primeUnder (𝓞 ℚ) W₀) hmemQ
    have hPW₀ : primeUnder (𝓞 ℚ) (primeUnder (𝓞 F₀) W₀) = P :=
      (primeUnder_primeUnder ℚ F₀ W₀).trans hW₀
    by_cases hpq : p = q
    · -- the place of the conductor
      have hPq : ((q : ℕ) : 𝓞 ℚ) ∈ P.asIdeal := by rw [← hpq]; exact hPp
      have hqL₀ : ((q : ℕ) : 𝓞 L₀) ∈ W₀.asIdeal := by rw [← hpq]; exact hmemL₀
      haveI : W₀.asIdeal.LiesOver (Ideal.span {(q : ℤ)}) :=
        liesOver_span_of_natCast_mem hq W₀ hqL₀
      have hmemF₀ : ((q : ℕ) : 𝓞 F₀) ∈ (primeUnder (𝓞 F₀) W₀).asIdeal := by
        rw [primeUnder_asIdeal, Ideal.under_def, Ideal.mem_comap, map_natCast]
        exact hqL₀
      haveI := liesOver_span_of_natCast_mem hq (primeUnder (𝓞 F₀) W₀) hmemF₀
      have hinert₀ : Ideal.inertia Gal(F₀/ℚ) (primeUnder (𝓞 F₀) W₀).asIdeal = ⊤ :=
        hinertia₀ _ (primeUnder (𝓞 F₀) W₀).isPrime inferInstance
      have hσW₀ : cyclotomicPowerAut q L₀ hg • W₀ = W₀ := by
        haveI : IsCyclotomicExtension {q ^ 1} ℚ L₀ := by rwa [pow_one]
        have hinertiaL : Ideal.inertia Gal(L₀/ℚ) W₀.asIdeal = ⊤ :=
          inertia_eq_top_cyclotomic_primePow q 1 L₀ W₀.asIdeal
        have hstab := stabilizer_place_eq_top_of_inertia_eq_top (k := ℚ) W₀ hinertiaL
        have hmem : cyclotomicPowerAut q L₀ hg ∈ stabilizer Gal(L₀/ℚ) W₀ := by
          rw [hstab]
          exact Subgroup.mem_top _
        exact hmem
      -- the exponents naming the invariants above the conductor
      have hkey : ∀ v : HeightOneSpectrum (𝓞 k), ∃ jv : ℕ, primeUnder (𝓞 ℚ) v = P →
          Ideal.Quotient.mk v.asIdeal (b ^ ((Nat.card (𝓞 k ⧸ v.asIdeal) - 1) / N))
                = Ideal.Quotient.mk v.asIdeal ((((g ^ finrank F₀ L₀) ^ jv : ℕ) : 𝓞 k)) ∧
              placeInvariant k v
                  (cyclicBrauerHom (forall_mem_zpowers_restrictNormal (L := E) hσ) a)
                = Multiplicative.ofAdd (zmodQModZ N (jv : ZMod N)) := by
        intro v
        by_cases hv : primeUnder (𝓞 ℚ) v = P
        · obtain ⟨w, hw⟩ := exists_primeUnder_eq (𝓞 k) (𝓞 K) v
          have hmemk : ((q : ℕ) : 𝓞 k) ∈ v.asIdeal := by
            have h := hPq
            rw [← hv, primeUnder_asIdeal, Ideal.under_def, Ideal.mem_comap, map_natCast] at h
            exact h
          have hmemK : ((q : ℕ) : 𝓞 K) ∈ w.asIdeal := by
            have h := hmemk
            rw [← hw, primeUnder_asIdeal, Ideal.under_def, Ideal.mem_comap, map_natCast] at h
            exact h
          have hmemE : ((q : ℕ) : 𝓞 E) ∈ (primeUnder (𝓞 E) w).asIdeal := by
            rw [primeUnder_asIdeal, Ideal.under_def, Ideal.mem_comap, map_natCast]
            exact hmemK
          haveI := liesOver_span_of_natCast_mem hq (primeUnder (𝓞 E) w) hmemE
          obtain ⟨jv, h1, h2⟩ := exists_mk_pow_eq_placeInvariant_conductor k K E hq hodd w
            ((primeUnder_primeUnder k E w).trans hw) hmemK hcardE hMN hM
            (hinertiaE _ (primeUnder (𝓞 E) w).isPrime inferInstance) (hunramk v hmemk) hgnd
            hgord hζ hσ (hσW w hmemK) hσζ hab (hav v hmemk)
          exact ⟨jv, fun _ => ⟨h1, h2⟩⟩
        · exact ⟨0, fun h => absurd h hv⟩
      choose j hj using hkey
      -- the exponent naming the invariant at the conductor
      have hav' : placeValue P (Units.map (Algebra.norm ℚ : k →* ℚ) a) = 0 := by
        refine placeValue_normUnit_eq_zero P a fun v hv => hav v ?_
        have h := hPq
        rw [← hv, primeUnder_asIdeal, Ideal.under_def, Ideal.mem_comap, map_natCast] at h
        exact h
      obtain ⟨j', hres', hlocP⟩ := exists_mk_pow_eq_placeInvariant_conductor ℚ L₀ F₀ hq hodd W₀
        hPW₀ hqL₀ hcardF₀ hMN₀ rfl hinert₀ (ramIdx_int_rat_eq_one P) hgnd hgord
        (IsCyclotomicExtension.zeta_spec q ℚ L₀) hgen₀ hσW₀
        (cyclotomicPowerAut_apply q L₀ hg (IsCyclotomicExtension.zeta_spec q ℚ L₀).pow_eq_one)
        hab' hav'
      have hcardP : Nat.card (𝓞 ℚ ⧸ P.asIdeal) = q := natCard_quotient_rat hq P hPq
      have hNP : N ∣ Nat.card (𝓞 ℚ ⧸ P.asIdeal) - 1 :=
        ⟨finrank F₀ L₀, by rw [hcardP, ← hMN₀]; ring⟩
      have hord : orderOf (Ideal.Quotient.mk P.asIdeal
          (((g ^ finrank F₀ L₀ : ℕ) : 𝓞 ℚ))) = N :=
        orderOf_mk_natCast_pow_rat hq P hPq hgnd hgord hMN₀
      have hunram : ∀ v : HeightOneSpectrum (𝓞 k), primeUnder (𝓞 ℚ) v = P →
          Ideal.ramificationIdx (algebraMap (𝓞 ℚ) (𝓞 k)) P.asIdeal v.asIdeal = 1 := by
        intro v hv
        have hmemk : ((q : ℕ) : 𝓞 k) ∈ v.asIdeal := by
          have h := hPq
          rw [← hv, primeUnder_asIdeal, Ideal.under_def, Ideal.mem_comap, map_natCast] at h
          exact h
        have h1 : ramIdx (𝓞 ℚ) v = 1 := by
          rw [ramIdx_rat_eq_ramificationIdx_int]
          exact hunramk v hmemk
        rw [← hv]
        exact h1
      exact finprod_placeInvariant_fibre_eq_of_residue _ _ P hNP hord j hunram
        (fun v hv => (hj v hv).1) hres' (fun v hv => (hj v hv).2) hlocP
    · -- a place away from the conductor
      have hpqc : Nat.Coprime p q := (Nat.coprime_primes hp hq).mpr hpq
      have hnpq : ¬ p ∣ q := (Nat.Prime.coprime_iff_not_dvd hp).mp hpqc
      obtain ⟨c, hc⟩ := exists_pow_eq_cyclotomicPowerAut q L₀ hg hgen₀ hpqc
      have hgc : Nat.ModEq q (g ^ c) p := by
        have h := natCast_zmod_eq_pow_of_cyclotomicPowerAut_eq_pow q L₀ hg hpqc hc
        rw [← Nat.cast_pow] at h
        exact ((ZMod.natCast_eq_natCast_iff _ _ _).mp h).symm
      refine finprod_placeInvariant_fibre_eq_of_value (N := N) _ _ a c P ?_ ?_
      · intro v hv
        obtain ⟨w, hw⟩ := exists_primeUnder_eq (𝓞 k) (𝓞 K) v
        subst hw
        have hmemk : ((p : ℕ) : 𝓞 k) ∈ (primeUnder (𝓞 k) w).asIdeal := by
          have h := hPp
          rw [← hv, primeUnder_asIdeal, Ideal.under_def, Ideal.mem_comap, map_natCast] at h
          exact h
        have hmemK : ((p : ℕ) : 𝓞 K) ∈ w.asIdeal := by
          have h := hmemk
          rw [primeUnder_asIdeal, Ideal.under_def, Ideal.mem_comap, map_natCast] at h
          exact h
        haveI := liesOver_span_of_natCast_mem hp (primeUnder (𝓞 k) w) hmemk
        haveI := liesOver_span_of_natCast_mem hp w hmemK
        haveI : (primeUnder (𝓞 k) w).asIdeal.LiesOver P.asIdeal :=
          (primeUnder_eq_iff_liesOver P (primeUnder (𝓞 k) w)).mp hv
        rw [placeInvariant_cyclicBrauerHom_subcyclotomic_fibre k E w hσ hp P
          (hunramK w p hp hnpq hmemK) hq.ne_zero
          (valuation_natCast_eq_one_of_not_dvd w (p := p) hnpq) hζ.pow_eq_one hgenK hσζ hgc a,
          hcardE]
      · have hram₀ : ramIdx (𝓞 ℚ) W₀ = 1 := ramIdx_rat_eq_one_of_not_dvd q L₀ p W₀ hnpq
        have h := placeInvariant_cyclicBrauerHom_subcyclotomic_power ℚ F₀ W₀ hgen₀ hp hram₀
          hq.ne_zero (valuation_natCast_eq_one_of_not_dvd W₀ (p := p) hnpq)
          (IsCyclotomicExtension.zeta_spec q ℚ L₀).pow_eq_one (adjoin_zeta_rat_eq_top q L₀)
          (cyclotomicPowerAut_apply q L₀ hg (IsCyclotomicExtension.zeta_spec q ℚ L₀).pow_eq_one)
          hgc (Units.map (Algebra.norm ℚ : k →* ℚ) a)
        rw [hW₀, hPdeg, mul_one, hcardF₀] at h
        exact h
  · exact totalInvariant_cyclicBrauerHom_subcyclotomic q L₀ F₀ hodd hcardF₀ hinertia₀ hg hgord
      hgen₀ h2N _

end BaseSubcyclotomic

end InverseGalois.CFT
