/-!
# The invariant at the place of the conductor over an arbitrary base

A prime unramified in a number field is a uniformiser of the completion at a place containing it,
because the valuation of a rational prime is the exponential of minus the ramification index.  So
the radical of the opposite of an odd prime, which presents the completion of a subfield of the
field generated by the primitive roots of unity of that prime, has a uniformiser as its coefficient
over an arbitrary base, exactly as it does over the rationals.

What changes over an arbitrary base is the residue field: it is no longer the field with as many
elements as the prime, but an extension of it of degree the residue degree of the place.  The
generator of its residues whose complementary power is the root of unity multiplying the radical is
therefore no longer a rational primitive root; it is produced instead from the root of unity
itself, the complementary power of a generator of the residues running through all the roots of
unity of the prescribed order.

Naming the exponent by that generator is not stable under a change of place, so the exponent is
recorded here by the congruence it satisfies: the coefficient raised to the complementary power of
the degree is congruent to the power of the root of unity by the exponent.  That congruence is
what compares the places of the base above one rational prime with the rational prime itself.

## Main results

* `InverseGalois.CFT.valued_natCast_adicCompletion_of_ramIdx_eq_one`: **a rational prime
  unramified at a place of a number field is a uniformiser of the completion there.**
* `InverseGalois.CFT.hasResidueChar_adicCompletion_of_ramIdx_eq_one`: such a completion has that
  prime as residue characteristic with exponent one.
* `InverseGalois.CFT.exists_placeInvariant_cyclicBrauerHom_conductor_base`: **the invariant, at a
  place above an odd prime unramified in the base, of a cyclic algebra split by a subfield of the
  field generated by the primitive roots of unity of that prime, with a coefficient that is a unit
  there**, is the class of the exponent naming the coefficient raised to the complementary power of
  the degree as a power of the root of unity multiplying the radical.

## Tags

number field, cyclotomic field, Brauer group, local invariant, cyclic algebra, totally ramified,
power residue symbol, reciprocity, class field theory
-/

set_option synthInstance.maxHeartbeats 1000000
set_option maxHeartbeats 1000000

namespace InverseGalois.CFT

open IsDedekindDomain Module MulAction NumberField

open scoped Pointwise WithZero

/-! ### An unramified prime is a uniformiser -/

section Unramified

variable {K : Type*} [Field K] [NumberField K] {q : ℕ}

/-- **A rational prime unramified at a place of a number field is a uniformiser of the completion
there.**  Its valuation is the exponential of minus the ramification index. -/
theorem valued_natCast_adicCompletion_of_ramIdx_eq_one (hq : q.Prime)
    (v : HeightOneSpectrum (𝓞 K)) [v.asIdeal.LiesOver (Ideal.span {(q : ℤ)})]
    (hram : ramIdx ℤ v = 1) :
    Valued.v ((q : ℕ) : v.adicCompletion K) = WithZero.exp (-1 : ℤ) := by
  have hval : Valued.v ((q : ℕ) : v.adicCompletion K) = v.valuation K ((q : ℕ) : K) := by
    rw [← map_natCast (algebraMap (𝓞 K) (v.adicCompletion K)) q,
      HeightOneSpectrum.valuedAdicCompletion_eq_valuation]
    norm_cast
  rw [hval, valuation_natCast_eq_exp_neg_ramificationIdx hq v,
    ← ramIdx_eq_ramificationIdx_span (p := q) v, hram, Nat.cast_one]

/-- **The completion at a place unramified over the rational prime it lies above has that prime as
its residue characteristic, with exponent one.** -/
theorem hasResidueChar_adicCompletion_of_ramIdx_eq_one (hq : q.Prime)
    (v : HeightOneSpectrum (𝓞 K)) [v.asIdeal.LiesOver (Ideal.span {(q : ℤ)})]
    (hram : ramIdx ℤ v = 1) : HasResidueChar (v.adicCompletion K) q 1 :=
  ⟨hq, one_pos, by rw [valued_natCast_adicCompletion_of_ramIdx_eq_one hq v hram, Nat.cast_one]⟩

end Unramified

/-! ### The invariant at the place of the conductor -/

section ConductorBase

attribute [local instance] isGalois_adicCompletion

variable {q : ℕ} (k L F : Type) [Field k] [NumberField k] [Field L] [NumberField L] [Field F]
  [NumberField F] [Algebra k F] [Algebra F L] [Algebra k L] [IsScalarTower k F L] [IsGalois k F]
  [IsGalois k L]

/-- **The invariant, at a place above an odd prime unramified in the base, of a cyclic algebra
split by a subfield of the field generated by the primitive roots of unity of that prime, with a
coefficient that is a unit there.**  The completion of the subfield is presented by a radical of
the opposite of the prime, which is a uniformiser because the prime is unramified, and the chosen
generator multiplies that radical by the prescribed root of unity.  That root of unity is the
complementary power of a generator of the residues, so the power residue symbol of the coefficient
reads the exponent naming the coefficient as a power of that generator; raising the congruence to
the complementary power replaces the generator by the root of unity. -/
theorem exists_placeInvariant_cyclicBrauerHom_conductor_base (hq : q.Prime) (hodd : Odd q)
    (W : HeightOneSpectrum (𝓞 L)) [W.asIdeal.LiesOver (Ideal.span {(q : ℤ)})] {N : ℕ} [NeZero N]
    (hcard : Nat.card Gal(F/k) = N) (hMN : finrank F L * N = q - 1)
    (hinertia : Ideal.inertia Gal(F/k) (primeUnder (𝓞 F) W).asIdeal = ⊤)
    (hram : ramIdx ℤ (primeUnder (𝓞 k) (primeUnder (𝓞 F) W)) = 1) {g : ℕ} {ζL : L}
    (hζL : IsPrimitiveRoot ζL q) {σ₀ : Gal(L/k)}
    (hgen : ∀ x : Gal(L/k), x ∈ Subgroup.zpowers σ₀) (hσW : σ₀ • W = W) (hσζ : σ₀ ζL = ζL ^ g)
    {ζ : (primeUnder (𝓞 k) (primeUnder (𝓞 F) W)).adicCompletion k} (hζ : IsPrimitiveRoot ζ N)
    (hζres : Valued.v (ζ - ((g ^ finrank F L : ℕ) :
      (primeUnder (𝓞 k) (primeUnder (𝓞 F) W)).adicCompletion k)) < 1) {a : kˣ}
    (hav : Valued.v (algebraMap k ((primeUnder (𝓞 k) (primeUnder (𝓞 F) W)).adicCompletion k)
      (a : k)) = 1) :
    ∃ j : ℕ,
      Valued.v ((algebraMap k ((primeUnder (𝓞 k) (primeUnder (𝓞 F) W)).adicCompletion k) (a : k))
            ^ ((Nat.card (DivisionResidue
                  ((primeUnder (𝓞 k) (primeUnder (𝓞 F) W)).adicCompletion k)
                  ((primeUnder (𝓞 k) (primeUnder (𝓞 F) W)).adicCompletion k)) - 1) / N)
          - ζ ^ j) < 1 ∧
        placeInvariant k (primeUnder (𝓞 k) (primeUnder (𝓞 F) W))
            (cyclicBrauerHom (forall_mem_zpowers_restrictNormal (L := F) hgen) a)
          = Multiplicative.ofAdd (zmodQModZ N (j : ZMod N)) := by
  haveI : Fact q.Prime := ⟨hq⟩
  haveI : IsGalois F L := IsGalois.tower_top_of_isGalois k F L
  haveI : Module.Finite F L := FiniteDimensional.right k F L
  -- the place of the conductor, seen in the three fields of the tower
  have hmemL : ((q : ℕ) : 𝓞 L) ∈ W.asIdeal := natCast_mem_of_liesOver_span (q := q) W.asIdeal
  have hmemF : ((q : ℕ) : 𝓞 F) ∈ (primeUnder (𝓞 F) W).asIdeal := by
    rw [primeUnder_asIdeal, Ideal.under_def, Ideal.mem_comap, map_natCast]
    exact hmemL
  have hmemk : ((q : ℕ) : 𝓞 k) ∈ (primeUnder (𝓞 k) (primeUnder (𝓞 F) W)).asIdeal := by
    rw [primeUnder_asIdeal, Ideal.under_def, Ideal.mem_comap, map_natCast]
    exact hmemF
  haveI := liesOver_span_of_natCast_mem hq (primeUnder (𝓞 k) (primeUnder (𝓞 F) W)) hmemk
  have hres : HasResidueChar
      ((primeUnder (𝓞 k) (primeUnder (𝓞 F) W)).adicCompletion k) q 1 :=
    hasResidueChar_adicCompletion_of_ramIdx_eq_one hq _ hram
  have hqN : ¬ q ∣ N := by
    intro hd
    have h1 : q ≤ N := Nat.le_of_dvd (Nat.pos_of_ne_zero (NeZero.ne N)) hd
    have h2 : N ≤ q - 1 := Nat.le_of_dvd (by have := hq.one_lt; omega) (Dvd.intro_left _ hMN)
    have := hq.one_lt
    omega
  -- the radical presenting the completion of the subfield
  obtain ⟨ν, hνpow, hνact⟩ :=
    exists_pow_eq_neg_natCast_aut_eq_algebraMap_mul (k := k) F W hq hodd hζL hmemL hMN
      (IsGalois.card_aut_eq_finrank F L) hσW hσζ hζ.pow_eq_one hζres
  have hst : σ₀.restrictNormal F • primeUnder (𝓞 F) W = primeUnder (𝓞 F) W :=
    restrictNormalHom_smul_primeUnder F hσW
  have hact : adicCompletionAut (primeUnder (𝓞 F) W) (σ₀.restrictNormal F) hst ν
      = algebraMap ((primeUnder (𝓞 k) (primeUnder (𝓞 F) W)).adicCompletion k)
          ((primeUnder (𝓞 F) W).adicCompletion F) ζ * ν := hνact
  -- the coefficient of the radical is a uniformiser of the completion of the base
  have hqne : ((q : ℕ) : (primeUnder (𝓞 k) (primeUnder (𝓞 F) W)).adicCompletion k) ≠ 0 :=
    hres.natCast_ne_zero hq.ne_zero
  have hpow : ν ^ N = algebraMap ((primeUnder (𝓞 k) (primeUnder (𝓞 F) W)).adicCompletion k)
      ((primeUnder (𝓞 F) W).adicCompletion F)
      ((Units.mk0 (-((q : ℕ) : (primeUnder (𝓞 k) (primeUnder (𝓞 F) W)).adicCompletion k))
        (neg_ne_zero.mpr hqne) :
        ((primeUnder (𝓞 k) (primeUnder (𝓞 F) W)).adicCompletion k)ˣ) : _) := by
    rw [hνpow, Units.val_mk0, map_neg, map_natCast]
  have hb : unitValDiv (isUnitValGen_one
        (valued_adicCompletion_surjective (primeUnder (𝓞 k) (primeUnder (𝓞 F) W))))
      (Additive.ofMul (Units.mk0
        (-((q : ℕ) : (primeUnder (𝓞 k) (primeUnder (𝓞 F) W)).adicCompletion k))
        (neg_ne_zero.mpr hqne))) = -1 := by
    refine unitValDiv_eq_neg_one_of_valued_eq_exp_neg_one
      (valued_adicCompletion_surjective (primeUnder (𝓞 k) (primeUnder (𝓞 F) W))) ?_
    rw [Units.val_mk0, Valuation.map_neg]
    exact valued_natCast_adicCompletion_of_ramIdx_eq_one hq _ hram
  -- a generator of the residues whose complementary power is the root of unity
  have hdvd : N ∣ Nat.card (DivisionResidue
      ((primeUnder (𝓞 k) (primeUnder (𝓞 F) W)).adicCompletion k)
      ((primeUnder (𝓞 k) (primeUnder (𝓞 F) W)).adicCompletion k)) - 1 := by
    rw [natCard_divisionResidue_adicCompletion_eq_pow_inertiaDeg hq
      (primeUnder (𝓞 k) (primeUnder (𝓞 F) W))]
    refine dvd_trans (Dvd.intro_left _ hMN) ?_
    simpa only [one_pow] using Nat.sub_dvd_pow_sub_pow q 1
      ((Ideal.span {(q : ℤ)}).inertiaDeg (primeUnder (𝓞 k) (primeUnder (𝓞 F) W)).asIdeal)
  obtain ⟨u, hu, hupow, hucov⟩ := exists_valued_eq_one_pow_eq_of_isPrimitiveRoot
    (primeUnder (𝓞 k) (primeUnder (𝓞 F) W)) (NeZero.ne N) hdvd hζ
  obtain ⟨j, hj⟩ := hucov _ hav
  have hu1 : Valued.v (ζ - u ^ ((Nat.card (DivisionResidue
      ((primeUnder (𝓞 k) (primeUnder (𝓞 F) W)).adicCompletion k)
      ((primeUnder (𝓞 k) (primeUnder (𝓞 F) W)).adicCompletion k)) - 1) / N)) < 1 := by
    rw [hupow, sub_self, map_zero]
    exact zero_lt_one
  refine ⟨j, ?_, ?_⟩
  · have hle2 : Valued.v (u ^ j) ≤ 1 := by rw [map_pow, hu, one_pow]
    have hpowu : (u ^ j) ^ ((Nat.card (DivisionResidue
        ((primeUnder (𝓞 k) (primeUnder (𝓞 F) W)).adicCompletion k)
        ((primeUnder (𝓞 k) (primeUnder (𝓞 F) W)).adicCompletion k)) - 1) / N) = ζ ^ j := by
      rw [← pow_mul, mul_comm j _, pow_mul, hupow]
    have hkey := valued_sub_pow_lt_one (le_of_eq hav) hle2 hj
      ((Nat.card (DivisionResidue
        ((primeUnder (𝓞 k) (primeUnder (𝓞 F) W)).adicCompletion k)
        ((primeUnder (𝓞 k) (primeUnder (𝓞 F) W)).adicCompletion k)) - 1) / N)
    rwa [hpowu] at hkey
  · exact placeInvariant_cyclicBrauerHom_of_radical_aut k (primeUnder (𝓞 F) W) hres hinertia
      hζ hqN (forall_mem_zpowers_restrictNormal (L := F) hgen) hst hcard hpow hact hb hu hu1 hj

end ConductorBase

end InverseGalois.CFT
