import Mathlib
import InverseGalois.CFT.Brauer.RatCount
import InverseGalois.CFT.Units.Places

/-!
# The value of a norm at a place of the base field

Let `K` be a finite extension of a number field `k` and let `a` be a nonzero element of `K`.  The
places of `K` above a place `v` of `k` each measure `a`, and the norm of `a` down to `k` collects
those measurements: the value of the norm at `v` is the sum of the values of `a` at the places
above `v`, each weighted by the residue degree of that place over `v`.

The proof is the factorisation of ideals.  The multiplicity of a height one prime in an ideal is
additive in the ideal and is read off from the adic valuation, the relative ideal norm carries a
prime of `K` to the power of the prime below it whose exponent is the residue degree, and a
principal ideal generated by an algebraic integer has as relative norm the principal ideal
generated by the norm of that integer.  Putting the three together and passing from integers to
fractions gives the statement for an arbitrary nonzero element.

## Main definitions

* `InverseGalois.CFT.primeCount`: **the multiplicity of a height one prime in an ideal.**
* `InverseGalois.CFT.placeOrd`: **the value of an element of a number field at a finite place.**

## Main results

* `InverseGalois.CFT.primeCount_relNorm`: **the multiplicity of a prime of the base in the
  relative norm of an ideal** is the sum over the primes above it of the residue degree times the
  multiplicity there.
* `InverseGalois.CFT.placeOrd_norm`: **the value of a norm at a place of the base field** is the
  sum over the places of the extension of the residue degree times the value there.
* `InverseGalois.CFT.placeValue_normUnit`: the same statement for a unit and the value used by
  the local invariants.

## Tags

number field, ideal norm, ramification, residue degree, valuation, place
-/

set_option synthInstance.maxHeartbeats 1000000
set_option maxHeartbeats 1000000

namespace InverseGalois.CFT

open IsDedekindDomain NumberField

/-! ### The multiplicity of a prime in an ideal -/

section PrimeCount

variable {R : Type*} [CommRing R] [IsDedekindDomain R]

open scoped Classical in
/-- **The multiplicity of a height one prime in an ideal**, the exponent with which the prime
occurs in the factorisation of the ideal. -/
noncomputable def primeCount (v : HeightOneSpectrum R) (I : Ideal R) : ℕ :=
  (Associates.mk v.asIdeal).count (Associates.mk I).factors

/-- **The unit ideal has multiplicity zero at every prime.** -/
theorem primeCount_top (v : HeightOneSpectrum R) : primeCount v (⊤ : Ideal R) = 0 := by
  classical
  rw [primeCount, ← Ideal.one_eq_top, Associates.mk_one, Associates.factors_one,
    Associates.count_zero v.associates_irreducible]

/-- **The multiplicity of a prime in a product of nonzero ideals** is the sum of the
multiplicities. -/
theorem primeCount_mul (v : HeightOneSpectrum R) {I J : Ideal R} (hI : I ≠ ⊥) (hJ : J ≠ ⊥) :
    primeCount v (I * J) = primeCount v I + primeCount v J := by
  classical
  rw [primeCount, primeCount, primeCount, ← Associates.mk_mul_mk,
    Associates.count_mul (Associates.mk_ne_zero.mpr hI) (Associates.mk_ne_zero.mpr hJ)
      v.associates_irreducible]

open scoped Classical in
/-- **The multiplicity of a prime in another prime** is one if they agree and zero otherwise. -/
theorem primeCount_asIdeal (v w : HeightOneSpectrum R) :
    primeCount v w.asIdeal = if w = v then 1 else 0 := by
  by_cases h : w = v
  · subst h
    rw [if_pos rfl, primeCount, Associates.count_self w.associates_irreducible]
  · rw [if_neg h]
    by_contra hc
    have hdvd := (Associates.count_ne_zero_iff_dvd w.ne_bot v.irreducible).mp hc
    exact h (HeightOneSpectrum.ext
      (w.isMaximal.eq_of_le v.isMaximal.ne_top (Ideal.le_of_dvd hdvd)))

/-- **The multiplicity of a prime in a power of a nonzero ideal** is the multiple of the
multiplicity. -/
theorem primeCount_pow (v : HeightOneSpectrum R) {I : Ideal R} (hI : I ≠ ⊥) (n : ℕ) :
    primeCount v (I ^ n) = n * primeCount v I := by
  induction n with
  | zero => rw [pow_zero, Ideal.one_eq_top, primeCount_top, Nat.zero_mul]
  | succ n ih => rw [pow_succ, primeCount_mul v (pow_ne_zero n hI) hI, ih, Nat.succ_mul]

/-- **Only finitely many primes have positive multiplicity in a nonzero ideal.** -/
theorem finite_primeCount_ne_zero {I : Ideal R} (hI : I ≠ ⊥) :
    {v : HeightOneSpectrum R | primeCount v I ≠ 0}.Finite := by
  classical
  exact (Ideal.finite_factors hI).subset fun v hv =>
    (Associates.count_ne_zero_iff_dvd hI v.irreducible).mp hv

/-- **The adic valuation of a nonzero element of the ring is the exponential of minus its
multiplicity.** -/
theorem intValuation_eq_exp_neg_primeCount (v : HeightOneSpectrum R) {x : R} (hx : x ≠ 0) :
    v.intValuation x = WithZero.exp (-(primeCount v (Ideal.span {x})) : ℤ) := by
  classical
  rw [HeightOneSpectrum.intValuation_apply, v.intValuationDef_if_neg hx]
  rfl

end PrimeCount

/-! ### A vanishing residue degree -/

section InertiaDeg

/-- **The residue degree of a prime over one it does not lie over vanishes.** -/
theorem inertiaDeg_eq_zero_of_comap_ne {R S : Type*} [CommRing R] [CommRing S] [Algebra R S]
    {p : Ideal R} {P : Ideal S} (h : Ideal.comap (algebraMap R S) P ≠ p) :
    Ideal.inertiaDeg p P = 0 := by
  rw [Ideal.inertiaDeg, dif_neg h]

end InertiaDeg

/-! ### The value of an element at a finite place -/

section PlaceOrd

variable {k : Type} [Field k] [NumberField k]

/-- **The value of an element of a number field at a finite place**, the exponent with which the
place occurs in the element. -/
noncomputable def placeOrd (v : HeightOneSpectrum (𝓞 k)) (x : k) : ℤ :=
  WithZero.log (v.valuation k x)

theorem placeOrd_apply (v : HeightOneSpectrum (𝓞 k)) (x : k) :
    placeOrd v x = WithZero.log (v.valuation k x) := rfl

/-- The adic valuation of a nonzero element is nonzero. -/
theorem valuation_ne_zero (v : HeightOneSpectrum (𝓞 k)) {x : k} (hx : x ≠ 0) :
    v.valuation k x ≠ 0 :=
  (Valuation.ne_zero_iff _).mpr hx

/-- **The value of a product of nonzero elements** is the sum of the values. -/
theorem placeOrd_mul (v : HeightOneSpectrum (𝓞 k)) {x y : k} (hx : x ≠ 0) (hy : y ≠ 0) :
    placeOrd v (x * y) = placeOrd v x + placeOrd v y := by
  rw [placeOrd_apply, placeOrd_apply, placeOrd_apply, map_mul,
    WithZero.log_mul (valuation_ne_zero v hx) (valuation_ne_zero v hy)]

/-- **The value of a quotient of nonzero elements** is the difference of the values. -/
theorem placeOrd_div (v : HeightOneSpectrum (𝓞 k)) {x y : k} (hx : x ≠ 0) (hy : y ≠ 0) :
    placeOrd v (x / y) = placeOrd v x - placeOrd v y := by
  rw [placeOrd_apply, placeOrd_apply, placeOrd_apply, map_div₀,
    WithZero.log_div (valuation_ne_zero v hx) (valuation_ne_zero v hy)]

/-- A quotient recognised through a product has the difference of the values. -/
theorem placeOrd_eq_sub_of_mul (v : HeightOneSpectrum (𝓞 k)) {x y z : k} (hy : y ≠ 0)
    (hz : z ≠ 0) (h : x * z = y) : placeOrd v x = placeOrd v y - placeOrd v z := by
  have hx : x ≠ 0 := by
    rintro rfl
    exact hy (by rw [← h, zero_mul])
  rw [← h, placeOrd_mul v hx hz, add_sub_cancel_right]

/-- **The value of an algebraic integer at a place** is minus its multiplicity there. -/
theorem placeOrd_algebraMap (v : HeightOneSpectrum (𝓞 k)) {x : 𝓞 k} (hx : x ≠ 0) :
    placeOrd v (algebraMap (𝓞 k) k x) = -(primeCount v (Ideal.span {x}) : ℤ) := by
  rw [placeOrd_apply, HeightOneSpectrum.valuation_of_algebraMap,
    intValuation_eq_exp_neg_primeCount v hx, WithZero.log_exp]

/-- **The value of a unit at a place is the value of the underlying element.** -/
theorem placeValue_eq_placeOrd (v : HeightOneSpectrum (𝓞 k)) (a : kˣ) :
    placeValue v a = placeOrd v (a : k) := by
  rw [placeValue_def, unitValDiv_apply, Int.ediv_one, unitVal_apply, placeOrd_apply,
    Units.coe_map]
  exact congrArg WithZero.log (valued_algebraMap_eq_valuation v (a : k))

/-- **Only finitely many places give a nonzero value to a nonzero element.** -/
theorem finite_placeOrd_ne_zero {x : k} (hx : x ≠ 0) :
    {v : HeightOneSpectrum (𝓞 k) | placeOrd v x ≠ 0}.Finite := by
  obtain ⟨y, z, hz, rfl⟩ := IsFractionRing.div_surjective (A := 𝓞 k) x
  have hz0 : z ≠ 0 := nonZeroDivisors.ne_zero hz
  have hzK : algebraMap (𝓞 k) k z ≠ 0 :=
    (map_ne_zero_iff _ (FaithfulSMul.algebraMap_injective (𝓞 k) k)).mpr hz0
  have hy0 : y ≠ 0 := by
    rintro rfl
    exact hx (by rw [map_zero, zero_div])
  have hyK : algebraMap (𝓞 k) k y ≠ 0 :=
    (map_ne_zero_iff _ (FaithfulSMul.algebraMap_injective (𝓞 k) k)).mpr hy0
  have hby : Ideal.span {y} ≠ ⊥ := fun hc => hy0 (Ideal.span_singleton_eq_bot.mp hc)
  have hbz : Ideal.span {z} ≠ ⊥ := fun hc => hz0 (Ideal.span_singleton_eq_bot.mp hc)
  refine ((finite_primeCount_ne_zero hby).union (finite_primeCount_ne_zero hbz)).subset ?_
  intro v hv
  simp only [Set.mem_setOf_eq, placeOrd_div v hyK hzK, sub_ne_zero] at hv
  by_contra hc
  simp only [Set.mem_union, Set.mem_setOf_eq, not_or, not_not] at hc
  exact hv (by rw [placeOrd_algebraMap v hy0, placeOrd_algebraMap v hz0, hc.1, hc.2])

end PlaceOrd

/-! ### The relative norm and multiplicities -/

section RelNorm

variable {k K : Type} [Field k] [NumberField k] [Field K] [NumberField K] [Algebra k K]

local instance instModuleFiniteRingOfIntegers : Module.Finite (𝓞 k) (𝓞 K) :=
  Module.Finite.of_restrictScalars_finite ℤ (𝓞 k) (𝓞 K)

local instance instIsIntegralRingOfIntegers : Algebra.IsIntegral (𝓞 k) (𝓞 K) :=
  Algebra.IsIntegral.tower_top (R := ℤ)

/-- **The relative norm of a prime of the extension is the prime below it raised to the residue
degree.** -/
theorem relNorm_asIdeal (W : HeightOneSpectrum (𝓞 K)) :
    Ideal.relNorm (𝓞 k) W.asIdeal
      = (primeUnder (𝓞 k) W).asIdeal ^
        Ideal.inertiaDeg (primeUnder (𝓞 k) W).asIdeal W.asIdeal := by
  haveI : W.asIdeal.IsMaximal := W.isMaximal
  haveI : (Ideal.under (𝓞 k) W.asIdeal).IsMaximal :=
    Ideal.isMaximal_comap_of_isIntegral_of_isMaximal _
  haveI : W.asIdeal.LiesOver (Ideal.under (𝓞 k) W.asIdeal) := ⟨rfl⟩
  exact Ideal.relNorm_eq_pow_of_isMaximal W.asIdeal (Ideal.under (𝓞 k) W.asIdeal)

omit [NumberField k] in
/-- The weighted multiplicities of a nonzero ideal have finite support. -/
theorem finite_support_inertiaDeg_mul (v : HeightOneSpectrum (𝓞 k)) {I : Ideal (𝓞 K)}
    (hI : I ≠ ⊥) :
    (Function.support fun W : HeightOneSpectrum (𝓞 K) =>
      (Ideal.inertiaDeg v.asIdeal W.asIdeal : ℤ) * (primeCount W I : ℤ)).Finite := by
  refine (finite_primeCount_ne_zero hI).subset fun W hW => ?_
  simp only [Function.mem_support, ne_eq, mul_eq_zero, not_or] at hW
  exact fun hc => hW.2 (by rw [hc, Nat.cast_zero])

/-- **The multiplicity of a prime of the base in the relative norm of a prime of the
extension.** -/
theorem primeCount_relNorm_asIdeal (v : HeightOneSpectrum (𝓞 k)) (W : HeightOneSpectrum (𝓞 K)) :
    (primeCount v (Ideal.relNorm (𝓞 k) W.asIdeal) : ℤ)
      = ∑ᶠ X : HeightOneSpectrum (𝓞 K),
        (Ideal.inertiaDeg v.asIdeal X.asIdeal : ℤ) * (primeCount X W.asIdeal : ℤ) := by
  classical
  have hsingle : (∑ᶠ X : HeightOneSpectrum (𝓞 K),
      (Ideal.inertiaDeg v.asIdeal X.asIdeal : ℤ) * (primeCount X W.asIdeal : ℤ))
      = (Ideal.inertiaDeg v.asIdeal W.asIdeal : ℤ) := by
    rw [finsum_eq_single _ W fun X hX => by
      rw [primeCount_asIdeal X W, if_neg (Ne.symm hX), Nat.cast_zero, mul_zero],
      primeCount_asIdeal W W, if_pos rfl, Nat.cast_one, mul_one]
  rw [hsingle, relNorm_asIdeal W, primeCount_pow v (primeUnder (𝓞 k) W).ne_bot,
    primeCount_asIdeal v (primeUnder (𝓞 k) W)]
  by_cases hv : primeUnder (𝓞 k) W = v
  · rw [if_pos hv, mul_one, hv]
  · rw [if_neg hv, mul_zero, Nat.cast_zero,
      inertiaDeg_eq_zero_of_comap_ne (fun hc => hv (HeightOneSpectrum.ext hc)), Nat.cast_zero]

/-- **The multiplicity of a prime of the base in the relative norm of an ideal** is the sum over
the primes of the extension of the residue degree over that prime times the multiplicity there.
Only the primes lying over the given one contribute, because the residue degree of the others
vanishes. -/
theorem primeCount_relNorm (v : HeightOneSpectrum (𝓞 k)) {I : Ideal (𝓞 K)} (hI : I ≠ ⊥) :
    (primeCount v (Ideal.relNorm (𝓞 k) I) : ℤ)
      = ∑ᶠ W : HeightOneSpectrum (𝓞 K),
        (Ideal.inertiaDeg v.asIdeal W.asIdeal : ℤ) * (primeCount W I : ℤ) := by
  classical
  have hmul : ∀ J₁ J₂ : Ideal (𝓞 K),
      (J₁ ≠ ⊥ ∧ (primeCount v (Ideal.relNorm (𝓞 k) J₁) : ℤ)
        = ∑ᶠ W : HeightOneSpectrum (𝓞 K),
          (Ideal.inertiaDeg v.asIdeal W.asIdeal : ℤ) * (primeCount W J₁ : ℤ)) →
      (J₂ ≠ ⊥ ∧ (primeCount v (Ideal.relNorm (𝓞 k) J₂) : ℤ)
        = ∑ᶠ W : HeightOneSpectrum (𝓞 K),
          (Ideal.inertiaDeg v.asIdeal W.asIdeal : ℤ) * (primeCount W J₂ : ℤ)) →
      (J₁ * J₂ ≠ ⊥ ∧ (primeCount v (Ideal.relNorm (𝓞 k) (J₁ * J₂)) : ℤ)
        = ∑ᶠ W : HeightOneSpectrum (𝓞 K),
          (Ideal.inertiaDeg v.asIdeal W.asIdeal : ℤ) * (primeCount W (J₁ * J₂) : ℤ)) := by
    rintro J₁ J₂ ⟨h₁, e₁⟩ ⟨h₂, e₂⟩
    refine ⟨mul_ne_zero h₁ h₂, ?_⟩
    have hn₁ : Ideal.relNorm (𝓞 k) J₁ ≠ ⊥ := fun hc => h₁ (Ideal.relNorm_eq_bot_iff.mp hc)
    have hn₂ : Ideal.relNorm (𝓞 k) J₂ ≠ ⊥ := fun hc => h₂ (Ideal.relNorm_eq_bot_iff.mp hc)
    have hsum : (∑ᶠ W : HeightOneSpectrum (𝓞 K),
        (Ideal.inertiaDeg v.asIdeal W.asIdeal : ℤ) * (primeCount W (J₁ * J₂) : ℤ))
        = (∑ᶠ W : HeightOneSpectrum (𝓞 K),
            (Ideal.inertiaDeg v.asIdeal W.asIdeal : ℤ) * (primeCount W J₁ : ℤ))
          + ∑ᶠ W : HeightOneSpectrum (𝓞 K),
            (Ideal.inertiaDeg v.asIdeal W.asIdeal : ℤ) * (primeCount W J₂ : ℤ) := by
      rw [← finsum_add_distrib (finite_support_inertiaDeg_mul v h₁)
        (finite_support_inertiaDeg_mul v h₂)]
      exact finsum_congr fun W => by
        rw [primeCount_mul W h₁ h₂, Nat.cast_add, mul_add]
    rw [map_mul, primeCount_mul v hn₁ hn₂, Nat.cast_add, e₁, e₂, hsum]
  have hone : (1 : Ideal (𝓞 K)) ≠ ⊥
      ∧ (primeCount v (Ideal.relNorm (𝓞 k) (1 : Ideal (𝓞 K))) : ℤ)
      = ∑ᶠ W : HeightOneSpectrum (𝓞 K),
        (Ideal.inertiaDeg v.asIdeal W.asIdeal : ℤ) * (primeCount W (1 : Ideal (𝓞 K)) : ℤ) := by
    refine ⟨one_ne_zero, ?_⟩
    rw [Ideal.one_eq_top, Ideal.relNorm_top, primeCount_top, Nat.cast_zero]
    refine (finsum_eq_zero_of_forall_eq_zero fun W => ?_).symm
    rw [primeCount_top, Nat.cast_zero, mul_zero]
  have hbase : ∀ J ∈ UniqueFactorizationMonoid.normalizedFactors I,
      J ≠ ⊥ ∧ (primeCount v (Ideal.relNorm (𝓞 k) J) : ℤ)
        = ∑ᶠ W : HeightOneSpectrum (𝓞 K),
          (Ideal.inertiaDeg v.asIdeal W.asIdeal : ℤ) * (primeCount W J : ℤ) := by
    intro J hJ
    have hJ0 : J ≠ ⊥ := UniqueFactorizationMonoid.ne_zero_of_mem_normalizedFactors hJ
    have hJp : J.IsPrime :=
      Ideal.isPrime_of_prime (UniqueFactorizationMonoid.prime_of_normalized_factor J hJ)
    exact ⟨hJ0, primeCount_relNorm_asIdeal v ⟨J, hJp, hJ0⟩⟩
  have hprod := Multiset.prod_induction
    (fun J : Ideal (𝓞 K) => J ≠ ⊥ ∧ (primeCount v (Ideal.relNorm (𝓞 k) J) : ℤ)
      = ∑ᶠ W : HeightOneSpectrum (𝓞 K),
        (Ideal.inertiaDeg v.asIdeal W.asIdeal : ℤ) * (primeCount W J : ℤ))
    (UniqueFactorizationMonoid.normalizedFactors I) hmul hone hbase
  rw [prod_normalizedFactors_eq_self hI] at hprod
  exact hprod.2

/-! ### The value of a norm -/

omit [NumberField k] in
/-- The weighted values of a nonzero element have finite support. -/
theorem finite_support_inertiaDeg_placeOrd (v : HeightOneSpectrum (𝓞 k)) {x : K} (hx : x ≠ 0) :
    (Function.support fun W : HeightOneSpectrum (𝓞 K) =>
      (Ideal.inertiaDeg v.asIdeal W.asIdeal : ℤ) * placeOrd W x).Finite := by
  refine (finite_placeOrd_ne_zero hx).subset fun W hW => ?_
  simp only [Function.mem_support, ne_eq, mul_eq_zero, not_or] at hW
  exact hW.2

/-- **The value of the norm of an algebraic integer at a place of the base field** is the sum over
the places of the extension of the residue degree times the value there. -/
theorem placeOrd_norm_algebraMap (v : HeightOneSpectrum (𝓞 k)) {y : 𝓞 K} (hy : y ≠ 0) :
    placeOrd v (Algebra.norm k (algebraMap (𝓞 K) K y))
      = ∑ᶠ W : HeightOneSpectrum (𝓞 K),
        (Ideal.inertiaDeg v.asIdeal W.asIdeal : ℤ) * placeOrd W (algebraMap (𝓞 K) K y) := by
  have hspan : Ideal.span {y} ≠ ⊥ := fun hc => hy (Ideal.span_singleton_eq_bot.mp hc)
  have hyK : algebraMap (𝓞 K) K y ≠ 0 :=
    (map_ne_zero_iff _ (FaithfulSMul.algebraMap_injective (𝓞 K) K)).mpr hy
  have hcompat := Algebra.algebraMap_intNorm (A := 𝓞 k) (K := k) (B := 𝓞 K) (L := K) y
  have hn0 : Algebra.intNorm (𝓞 k) (𝓞 K) y ≠ 0 := by
    intro hc
    rw [hc, map_zero] at hcompat
    exact (by simpa using hyK : Algebra.norm k (algebraMap (𝓞 K) K y) ≠ 0) hcompat.symm
  rw [← hcompat, placeOrd_algebraMap v hn0, ← Ideal.relNorm_singleton (𝓞 k) y,
    primeCount_relNorm v hspan, ← finsum_neg_distrib]
  exact finsum_congr fun W => by rw [placeOrd_algebraMap W hy, mul_neg]

/-- **The value of a norm at a place of the base field** is the sum over the places of the
extension of the residue degree over that place times the value there. -/
theorem placeOrd_norm (v : HeightOneSpectrum (𝓞 k)) {x : K} (hx : x ≠ 0) :
    placeOrd v (Algebra.norm k x)
      = ∑ᶠ W : HeightOneSpectrum (𝓞 K),
        (Ideal.inertiaDeg v.asIdeal W.asIdeal : ℤ) * placeOrd W x := by
  obtain ⟨y, z, hz, rfl⟩ := IsFractionRing.div_surjective (A := 𝓞 K) x
  have hz0 : z ≠ 0 := nonZeroDivisors.ne_zero hz
  have hzK : algebraMap (𝓞 K) K z ≠ 0 :=
    (map_ne_zero_iff _ (FaithfulSMul.algebraMap_injective (𝓞 K) K)).mpr hz0
  have hy0 : y ≠ 0 := by
    rintro rfl
    exact hx (by rw [map_zero, zero_div])
  have hyK : algebraMap (𝓞 K) K y ≠ 0 :=
    (map_ne_zero_iff _ (FaithfulSMul.algebraMap_injective (𝓞 K) K)).mpr hy0
  have hny : Algebra.norm k (algebraMap (𝓞 K) K y) ≠ 0 := by simpa using hyK
  have hnz : Algebra.norm k (algebraMap (𝓞 K) K z) ≠ 0 := by simpa using hzK
  have hmul : Algebra.norm k (algebraMap (𝓞 K) K y / algebraMap (𝓞 K) K z)
      * Algebra.norm k (algebraMap (𝓞 K) K z) = Algebra.norm k (algebraMap (𝓞 K) K y) := by
    rw [← map_mul, div_mul_cancel₀ _ hzK]
  rw [placeOrd_eq_sub_of_mul v hny hnz hmul, placeOrd_norm_algebraMap v hy0,
    placeOrd_norm_algebraMap v hz0, ← finsum_sub_distrib
      (finite_support_inertiaDeg_placeOrd v hyK) (finite_support_inertiaDeg_placeOrd v hzK)]
  exact finsum_congr fun W => by rw [placeOrd_div W hyK hzK, mul_sub]

/-- **The value at a place of the base field of the norm of a unit** is the sum over the places of
the extension of the residue degree over that place times the value there. -/
theorem placeValue_normUnit (v : HeightOneSpectrum (𝓞 k)) (a : Kˣ) :
    placeValue v (Units.map (Algebra.norm k : K →* k) a)
      = ∑ᶠ W : HeightOneSpectrum (𝓞 K),
        (Ideal.inertiaDeg v.asIdeal W.asIdeal : ℤ) * placeValue W a := by
  rw [placeValue_eq_placeOrd, Units.coe_map, placeOrd_norm v (Units.ne_zero a)]
  exact finsum_congr fun W => by rw [placeValue_eq_placeOrd]

end RelNorm

end InverseGalois.CFT
