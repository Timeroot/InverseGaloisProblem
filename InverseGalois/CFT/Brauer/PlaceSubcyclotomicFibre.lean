import Mathlib
import InverseGalois.CFT.Brauer.InertiaDegRat
import InverseGalois.CFT.Brauer.PlaceSubcyclotomicPower

/-!
# The exponent at a place, measured against the rational prime below it

The invariant at an unramified finite place of a cyclic algebra split by a subfield of an extension
generated by a root of unity is a fixed rational exponent times the residue degree of the place
times the value of the coefficient.  The local computation measures that residue degree against the
ideal generated by the rational prime in the integers, since the number of residues of a completion
is a power of the rational prime.

Adding up the invariants above one rational prime measures it instead against the place of the
rationals below, since the norm of the coefficient is taken relative to the integers of the
rationals.  The two measurements agree, so the invariant takes the shape in which a whole fibre can
be summed.

## Main results

* `InverseGalois.CFT.placeInvariant_cyclicBrauerHom_subcyclotomic_fibre`: **the invariant at an
  unramified finite place of a cyclic algebra split by a subfield of an extension generated by a
  root of unity, with the residue degree measured against the place of the rationals below.**

## Tags

number field, cyclotomic field, subfield, Brauer group, local invariant, cyclic algebra, residue
degree, reciprocity, class field theory
-/

set_option synthInstance.maxHeartbeats 1000000
set_option maxHeartbeats 1000000

namespace InverseGalois.CFT

open IsDedekindDomain Module NumberField

section SubcyclotomicFibre

variable {k K F : Type} [Field k] [NumberField k] [Field K] [NumberField K] [Algebra k K]
  [IsGalois k K] [Field F] [NumberField F] [Algebra k F] [Algebra F K] [IsScalarTower k F K]
  [IsGalois k F] (w : HeightOneSpectrum (𝓞 K))

variable (k F) in
/-- **The invariant at an unramified finite place of a cyclic algebra split by a subfield of an
extension generated by a root of unity, with the residue degree measured against the place of the
rationals below.**  The residue degree of a place over the ideal generated by the rational prime is
its residue degree over the place of the rationals containing that prime. -/
theorem placeInvariant_cyclicBrauerHom_subcyclotomic_fibre {σ : Gal(K/k)}
    (hσ : ∀ x : Gal(K/k), x ∈ Subgroup.zpowers σ) {p : ℕ} (hp : p.Prime)
    (P : HeightOneSpectrum (𝓞 ℚ)) [P.asIdeal.LiesOver (Ideal.span {(p : ℤ)})]
    [(primeUnder (𝓞 k) w).asIdeal.LiesOver (Ideal.span {(p : ℤ)})]
    [(primeUnder (𝓞 k) w).asIdeal.LiesOver P.asIdeal] (hram : ramIdx (𝓞 k) w = 1)
    {m : ℕ} (hm : m ≠ 0) (hmv : w.valuation K ((m : ℕ) : K) = 1) {ζ : K} (hζ : ζ ^ m = 1)
    (hgen : Algebra.adjoin k ({ζ} : Set K) = ⊤) {g : ℕ} (hσζ : σ ζ = ζ ^ g) {c : ℕ}
    (hgc : Nat.ModEq m (g ^ c) p) (a : kˣ) :
    placeInvariant k (primeUnder (𝓞 k) w)
        (cyclicBrauerHom (forall_mem_zpowers_restrictNormal (L := F) hσ) a)
      = Multiplicative.ofAdd (intQModZ (Nat.card Gal(F/k))
        ((c : ℤ) * (((P.asIdeal.inertiaDeg (primeUnder (𝓞 k) w).asIdeal : ℕ) : ℤ) *
          placeValue (primeUnder (𝓞 k) w) a))) := by
  have hcast : ((c * (Ideal.span {(p : ℤ)}).inertiaDeg (primeUnder (𝓞 k) w).asIdeal : ℕ) : ℤ) *
        placeValue (primeUnder (𝓞 k) w) a
      = (c : ℤ) * (((P.asIdeal.inertiaDeg (primeUnder (𝓞 k) w).asIdeal : ℕ) : ℤ) *
          placeValue (primeUnder (𝓞 k) w) a) := by
    rw [inertiaDeg_span_eq_inertiaDeg_rat P (primeUnder (𝓞 k) w) hp]
    push_cast
    ring
  rw [placeInvariant_cyclicBrauerHom_subcyclotomic_power k F w hσ hp hram hm hmv hζ hgen hσζ hgc a,
    hcast]

end SubcyclotomicFibre

end InverseGalois.CFT
