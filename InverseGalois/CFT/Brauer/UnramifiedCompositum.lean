import Mathlib
import InverseGalois.CFT.Brauer.ResidueGalois

/-!
# The compositum of two unramified extensions of a local field

An unramified extension of a nonarchimedean local field is generated by a root of unity whose order
is the number of nonzero residues, and adjoining a root of unity of order invertible in the residue
field never ramifies.  The compositum of two such extensions is generated by a root of unity whose
order is the least common multiple of the two orders, which is again invertible in the residue
field, so **the compositum of two unramified extensions is unramified.**

The unramified extensions of a local field inside a fixed extension therefore form a directed
family, which is what makes an invariant computed at one unramified level agree with the invariant
computed at another.

## Main results

* `InverseGalois.CFT.norm_natCast_lcm_eq_one`: the least common multiple of two natural numbers of
  absolute value one has absolute value one.
* `InverseGalois.CFT.unramified_sup`: **the compositum of two unramified extensions of a local field
  is unramified.**

## Tags

local field, unramified extension, compositum, root of unity
-/

set_option synthInstance.maxHeartbeats 800000

universe u

namespace InverseGalois.CFT

open Module

variable {K : Type u} [NontriviallyNormedField K] [IsUltrametricDist K] [ProperSpace K]

/-! ### The least common multiple of two invertible orders -/

omit [ProperSpace K] in
variable (K) in
/-- **The least common multiple of two natural numbers of absolute value one has absolute value
one**, because the product of the least common multiple and the greatest common divisor is the
product of the two numbers, and every natural number has absolute value at most one. -/
theorem norm_natCast_lcm_eq_one {a b : ℕ} (ha : ‖((a : ℕ) : K)‖ = 1) (hb : ‖((b : ℕ) : K)‖ = 1) :
    ‖((Nat.lcm a b : ℕ) : K)‖ = 1 := by
  have hmul : ‖((Nat.gcd a b : ℕ) : K)‖ * ‖((Nat.lcm a b : ℕ) : K)‖ = 1 := by
    rw [← norm_mul, ← Nat.cast_mul, Nat.gcd_mul_lcm, Nat.cast_mul, norm_mul, ha, hb, one_mul]
  have hg : ‖((Nat.gcd a b : ℕ) : K)‖ ≤ 1 := IsUltrametricDist.norm_natCast_le_one K _
  have hl : ‖((Nat.lcm a b : ℕ) : K)‖ ≤ 1 := IsUltrametricDist.norm_natCast_le_one K _
  nlinarith [norm_nonneg (((Nat.gcd a b : ℕ) : K)), norm_nonneg (((Nat.lcm a b : ℕ) : K))]

/-! ### The compositum -/

variable {Ω : Type u} [Field Ω] [Algebra K Ω]

/-- **The compositum of two unramified extensions of a local field is unramified.**  Each of the two
is a cyclotomic extension whose order is invertible in the residue field, so the compositum is a
cyclotomic extension whose order is the least common multiple of the two orders, and that order is
again invertible in the residue field. -/
theorem unramified_sup (L₁ L₂ : IntermediateField K Ω) [FiniteDimensional K L₁]
    [FiniteDimensional K L₂]
    (h₁ : ∀ z : ↥L₁, z ≠ 0 → ∃ c : K, c ≠ 0 ∧ divisionNorm K ↥L₁ z = ‖c‖)
    (h₂ : ∀ z : ↥L₂, z ≠ 0 → ∃ c : K, c ≠ 0 ∧ divisionNorm K ↥L₂ z = ‖c‖) :
    ∀ z : ↥(L₁ ⊔ L₂), z ≠ 0 → ∃ c : K, c ≠ 0 ∧ divisionNorm K ↥(L₁ ⊔ L₂) z = ‖c‖ := by
  haveI := isCyclotomicExtension_of_unramified K ↥L₁ h₁
  haveI := isCyclotomicExtension_of_unramified K ↥L₂ h₂
  haveI := neZero_card_divisionResidue_sub_one K ↥L₁
  haveI := neZero_card_divisionResidue_sub_one K ↥L₂
  haveI : IsCyclotomicExtension
      {Nat.lcm (Nat.card (DivisionResidue K ↥L₁) - 1) (Nat.card (DivisionResidue K ↥L₂) - 1)}
      K ↥(L₁ ⊔ L₂) := IntermediateField.isCyclotomicExtension_lcm_sup ..
  exact unramified_of_isCyclotomicExtension K ↥(L₁ ⊔ L₂)
    (norm_natCast_lcm_eq_one K (norm_natCast_card_divisionResidue_sub_one K ↥L₁)
      (norm_natCast_card_divisionResidue_sub_one K ↥L₂))

end InverseGalois.CFT
