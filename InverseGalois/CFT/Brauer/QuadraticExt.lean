import Mathlib
import InverseGalois.CFT.Brauer.CyclicNorm

/-!
# Quadratic extensions and their relative Brauer groups

Let `K` be a field and let `b : K` be a non-square.  Adjoining a root of `X ^ 2 - C b` produces
the quadratic extension `K(√b)`, here called `InverseGalois.CFT.sqrtExt K b`.  In characteristic
zero this extension is separable, hence Galois with cyclic Galois group of order two, so the
cyclic-algebra machinery of `InverseGalois.CFT.Brauer.CyclicNorm` applies: the relative Brauer
group `Br(K(√b) / K)` is the quotient of `Kˣ` by the group of norms, and the norm form of
`K(√b) / K` is the binary quadratic form `u ^ 2 - b * v ^ 2`.

The hypothesis `¬ IsSquare b` is carried through the file as an instance
`[Fact (Irreducible (X ^ 2 - C b))]`, which is what the `AdjoinRoot` field structure needs; the
lemma `InverseGalois.CFT.fact_irreducible_of_not_isSquare` builds this `Fact` from `¬ IsSquare b`.

## Main results

* `InverseGalois.CFT.sqrtExt`: the quadratic extension `K(√b)`, with its field, algebra,
  finite-dimensionality, `Algebra.IsQuadraticExtension` and (in characteristic zero)
  `Algebra.IsSeparable` instances, and `InverseGalois.CFT.finrank_sqrtExt`.
* `InverseGalois.CFT.sqrtExt.sqrt` and `InverseGalois.CFT.sqrtExt.sqrt_sq`: the adjoined square
  root, together with `InverseGalois.CFT.exists_eq_add_smul_sqrt` expressing every element in the
  form `u + v √b`.
* `InverseGalois.CFT.sqrtExt.norm_eq`: **the norm form**, `N(u + v √b) = u ^ 2 - b * v ^ 2`, and
  the resulting description `InverseGalois.CFT.mem_normSubgroup_iff_exists` of the norm subgroup.
* `InverseGalois.CFT.forall_mem_zpowers_sqrtExt`: the Galois group of `K(√b) / K` is generated by
  a single element.
* `InverseGalois.CFT.brauerSqrtExtEquiv`: **the main result**, `Kˣ / N(K(√b)ˣ) ≃* Br(K(√b) / K)`,
  with the criterion `InverseGalois.CFT.relative_sqrtExt_eq_bot_iff`.
* `InverseGalois.CFT.relative_sqrtExt_real_ne_bot`: the relative Brauer group of `ℝ(√(-1)) / ℝ`
  is nontrivial.

## Tags

Brauer group, quadratic extension, norm form, cyclic algebra
-/

open Module Polynomial

namespace InverseGalois.CFT

variable {K : Type} [Field K] {b : K}

/-! ### Irreducibility of `X ^ 2 - C b` -/

/-- **`X ^ 2 - C b` is irreducible over `K` exactly when `b` is not a square.**  This is the
half of that statement that produces the field structure on `K(√b)`. -/
theorem irreducible_X_pow_two_sub_C (hb : ¬ IsSquare b) : Irreducible (X ^ 2 - C b) := by
  rw [X_pow_sub_C_irreducible_iff_of_prime Nat.prime_two]
  intro c hc
  exact hb ⟨c, by rw [← hc]; ring⟩

/-- Irreducibility of `X ^ 2 - C b`, packaged as a `Fact` so that it can be supplied as an
instance to the constructions below. -/
theorem fact_irreducible_of_not_isSquare (hb : ¬ IsSquare b) :
    Fact (Irreducible (X ^ 2 - C b)) :=
  ⟨irreducible_X_pow_two_sub_C hb⟩

/-- The polynomial `X ^ 2 - C b` is monic. -/
theorem monic_X_pow_two_sub_C (b : K) : (X ^ 2 - C b).Monic :=
  monic_X_pow_sub_C b two_ne_zero

/-- The polynomial `X ^ 2 - C b` has degree two. -/
theorem natDegree_X_pow_two_sub_C (b : K) : (X ^ 2 - C b).natDegree = 2 :=
  natDegree_X_pow_sub_C

/-! ### The quadratic extension `K(√b)` -/

/-- **The quadratic extension `K(√b)`**, obtained by adjoining a root of `X ^ 2 - C b`.  It is a
field as soon as `X ^ 2 - C b` is irreducible, that is, as soon as `b` is not a square. -/
noncomputable def sqrtExt (K : Type) [Field K] (b : K) : Type :=
  AdjoinRoot (X ^ 2 - C b)

section Basic

variable [Fact (Irreducible (X ^ 2 - C (b : K)))]

/-- `K(√b)` is a field when `b` is not a square. -/
noncomputable instance sqrtExt.field : Field (sqrtExt K b) :=
  inferInstanceAs (Field (AdjoinRoot _))

/-- `K(√b)` is a `K`-algebra. -/
noncomputable instance sqrtExt.algebra : Algebra K (sqrtExt K b) :=
  inferInstanceAs (Algebra K (AdjoinRoot _))

/-- `K(√b)` is a finite extension of `K`. -/
instance sqrtExt.finiteDimensional : FiniteDimensional K (sqrtExt K b) :=
  (monic_X_pow_two_sub_C b).finite_adjoinRoot

/-- The basis `1, √b` of `K(√b)` over `K`. -/
noncomputable def sqrtBasis : Basis (Fin 2) K (sqrtExt K b) :=
  (AdjoinRoot.powerBasis' (monic_X_pow_two_sub_C b)).basis.reindex
    (finCongr (natDegree_X_pow_two_sub_C b))

/-- **`K(√b)` has degree two over `K`.** -/
theorem finrank_sqrtExt : finrank K (sqrtExt K b) = 2 := by
  simpa using finrank_eq_card_basis (sqrtBasis (K := K) (b := b))

/-- `K(√b)` is a quadratic extension of `K`. -/
instance sqrtExt.isQuadraticExtension : Algebra.IsQuadraticExtension K (sqrtExt K b) where
  finrank_eq_two' := finrank_sqrtExt

/-! ### The square root -/

/-- **The adjoined square root `√b` inside `K(√b)`.** -/
noncomputable def sqrtExt.sqrt : sqrtExt K b :=
  AdjoinRoot.root (X ^ 2 - C b)

/-- The defining relation `(√b) ^ 2 = b`. -/
theorem sqrtExt.sqrt_sq : (sqrtExt.sqrt : sqrtExt K b) ^ 2 = algebraMap K (sqrtExt K b) b :=
  root_X_pow_sub_C_pow 2 b

/-- The power basis of `AdjoinRoot (X ^ 2 - C b)`, reindexed by `Fin 2`, is the sequence of
powers of the adjoined root. -/
private theorem sqrtBasisAux (i : Fin 2) :
    (AdjoinRoot.powerBasis' (monic_X_pow_two_sub_C b)).basis.reindex
      (finCongr (natDegree_X_pow_two_sub_C b)) i = AdjoinRoot.root (X ^ 2 - C b) ^ (i : ℕ) := by
  rw [Basis.reindex_apply, PowerBasis.coe_basis]
  simp

/-- The basis `1, √b` consists of the powers of `√b`. -/
theorem sqrtBasis_apply (i : Fin 2) :
    (sqrtBasis (K := K) (b := b)) i = (sqrtExt.sqrt : sqrtExt K b) ^ (i : ℕ) :=
  sqrtBasisAux i

/-- The first basis vector of `K(√b)` is `1`. -/
@[simp] theorem sqrtBasis_zero : (sqrtBasis (K := K) (b := b)) 0 = 1 := by
  simp [sqrtBasis_apply]

/-- The second basis vector of `K(√b)` is `√b`. -/
@[simp] theorem sqrtBasis_one : (sqrtBasis (K := K) (b := b)) 1 = sqrtExt.sqrt := by
  simp [sqrtBasis_apply]

/-- **Every element of `K(√b)` is of the form `u + v √b` with `u v : K`.** -/
theorem exists_eq_add_smul_sqrt (x : sqrtExt K b) :
    ∃ u v : K, x = algebraMap K (sqrtExt K b) u + algebraMap K (sqrtExt K b) v * sqrtExt.sqrt := by
  refine ⟨sqrtBasis.repr x 0, sqrtBasis.repr x 1, ?_⟩
  conv_lhs => rw [← sqrtBasis.sum_repr x]
  rw [Fin.sum_univ_two, sqrtBasis_zero, sqrtBasis_one, Algebra.smul_def, Algebra.smul_def, mul_one]

/-- The coordinates of `u + v √b` in the basis `1, √b` are `u` and `v`. -/
theorem repr_add_mul_sqrt (u v : K) :
    ⇑((sqrtBasis (K := K) (b := b)).repr
      (algebraMap K (sqrtExt K b) u + algebraMap K (sqrtExt K b) v * sqrtExt.sqrt)) = ![u, v] := by
  have h : algebraMap K (sqrtExt K b) u + algebraMap K (sqrtExt K b) v * sqrtExt.sqrt
      = ∑ i, ![u, v] i • sqrtBasis i := by
    rw [Fin.sum_univ_two, sqrtBasis_zero, sqrtBasis_one]
    simp [Algebra.smul_def]
  rw [h, Basis.repr_sum_self]

/-! ### The norm form -/

/-- **The norm form of `K(√b) / K`.**  The norm of `u + v √b` is `u ^ 2 - b * v ^ 2`. -/
theorem sqrtExt.norm_eq (u v : K) :
    Algebra.norm K (algebraMap K (sqrtExt K b) u + algebraMap K (sqrtExt K b) v * sqrtExt.sqrt)
      = u ^ 2 - b * v ^ 2 := by
  have h0 : (algebraMap K (sqrtExt K b) u + algebraMap K (sqrtExt K b) v * sqrtExt.sqrt)
      * sqrtBasis 0
      = algebraMap K (sqrtExt K b) u + algebraMap K (sqrtExt K b) v * sqrtExt.sqrt := by
    rw [sqrtBasis_zero, mul_one]
  have h1 : (algebraMap K (sqrtExt K b) u + algebraMap K (sqrtExt K b) v * sqrtExt.sqrt)
      * sqrtBasis 1
      = algebraMap K (sqrtExt K b) (b * v) + algebraMap K (sqrtExt K b) u * sqrtExt.sqrt := by
    rw [sqrtBasis_one, map_mul]
    linear_combination (algebraMap K (sqrtExt K b) v) * sqrtExt.sqrt_sq (K := K) (b := b)
  rw [Algebra.norm_eq_matrix_det sqrtBasis, Matrix.det_fin_two]
  simp only [Algebra.leftMulMatrix_eq_repr_mul, h0, h1, repr_add_mul_sqrt,
    Matrix.cons_val_zero, Matrix.cons_val_one]
  ring

/-- **The norms from `K(√b)` are exactly the values of the form `u ^ 2 - b * v ^ 2`.** -/
theorem mem_normSubgroup_iff_exists (a : Kˣ) :
    a ∈ normSubgroup K (sqrtExt K b) ↔ ∃ u v : K, (a : K) = u ^ 2 - b * v ^ 2 := by
  rw [mem_normSubgroup_iff]
  constructor
  · rintro ⟨y, hy⟩
    obtain ⟨u, v, huv⟩ := exists_eq_add_smul_sqrt (y : sqrtExt K b)
    exact ⟨u, v, by rw [← hy, huv, sqrtExt.norm_eq]⟩
  · rintro ⟨u, v, huv⟩
    have hnorm : Algebra.norm K
        (algebraMap K (sqrtExt K b) u + algebraMap K (sqrtExt K b) v * sqrtExt.sqrt) = (a : K) := by
      rw [sqrtExt.norm_eq, ← huv]
    have hne : algebraMap K (sqrtExt K b) u + algebraMap K (sqrtExt K b) v * sqrtExt.sqrt ≠ 0 :=
      fun h => a.ne_zero (hnorm.symm.trans (Algebra.norm_eq_zero_iff.mpr h))
    exact ⟨(isUnit_iff_ne_zero.mpr hne).unit, by rw [IsUnit.unit_spec]; exact hnorm⟩

/-! ### The Galois group -/

/-- **The Galois group of `K(√b) / K` is generated by a single element.** -/
theorem forall_mem_zpowers_sqrtExt :
    ∃ σ₀ : Gal(sqrtExt K b/K), ∀ x : Gal(sqrtExt K b/K), x ∈ Subgroup.zpowers σ₀ :=
  IsCyclic.exists_generator

end Basic

section CharZero

variable [CharZero K] [Fact (Irreducible (X ^ 2 - C (b : K)))]

/-- In characteristic zero the quadratic extension `K(√b)` is separable, hence Galois. -/
instance sqrtExt.isSeparable : Algebra.IsSeparable K (sqrtExt K b) :=
  have : Algebra.IsAlgebraic K (sqrtExt K b) := Algebra.IsAlgebraic.of_finite K _
  Algebra.IsAlgebraic.isSeparable_of_perfectField

/-! ### The relative Brauer group -/

/-- **The relative Brauer group of a quadratic extension.**  For a non-square `b` in a field of
characteristic zero, `Br(K(√b) / K)` is the quotient of `Kˣ` by the norms from `K(√b)ˣ`. -/
noncomputable def brauerSqrtExtEquiv :
    (Kˣ ⧸ normSubgroup K (sqrtExt K b)) ≃* BrauerGroup.relative K (sqrtExt K b) :=
  cyclicBrauerEquiv (Classical.choose_spec (forall_mem_zpowers_sqrtExt (K := K) (b := b)))

/-- **`Br(K(√b) / K)` is trivial exactly when every unit of `K` is represented by the norm form
`u ^ 2 - b * v ^ 2`.** -/
theorem relative_sqrtExt_eq_bot_iff :
    BrauerGroup.relative K (sqrtExt K b) = ⊥ ↔ ∀ a : Kˣ, ∃ u v : K, (a : K) = u ^ 2 - b * v ^ 2 :=
  (relative_eq_bot_iff
      (Classical.choose_spec (forall_mem_zpowers_sqrtExt (K := K) (b := b)))).trans
    (forall_congr' fun a => (mem_normSubgroup_iff a).symm.trans (mem_normSubgroup_iff_exists a))

end CharZero

/-! ### The real place -/

/-- `-1` is not a square in `ℝ`. -/
theorem not_isSquare_neg_one_real : ¬ IsSquare (-1 : ℝ) := by
  rintro ⟨r, hr⟩
  nlinarith [mul_self_nonneg r]

/-- `X ^ 2 + 1` is irreducible over `ℝ`, so that `ℝ(√(-1))` is a field. -/
instance factIrreducibleNegOneReal : Fact (Irreducible (X ^ 2 - C (-1 : ℝ))) :=
  fact_irreducible_of_not_isSquare not_isSquare_neg_one_real

/-- **The relative Brauer group of `ℝ(√(-1)) / ℝ` is nontrivial**, because `-1` is not a sum of
two squares of real numbers. -/
theorem relative_sqrtExt_real_ne_bot : BrauerGroup.relative ℝ (sqrtExt ℝ (-1)) ≠ ⊥ := by
  rw [Ne, relative_sqrtExt_eq_bot_iff]
  intro h
  obtain ⟨u, v, huv⟩ := h (-1)
  rw [Units.val_neg, Units.val_one] at huv
  nlinarith [sq_nonneg u, sq_nonneg v]

end InverseGalois.CFT
