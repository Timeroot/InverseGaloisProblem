import Mathlib
import InverseGalois.CFT.Brauer.MaximalSubfield

/-!
# Commutative subfields of a division algebra, and the norm tower formula

Let `D` be a finite-dimensional division algebra over a field `K`.  A single element `x` of `D`
generates a commutative subalgebra `K[x]`, and because `D` has no zero divisors that subalgebra is
a field.  This file records that fact together with the formula it exists to serve: if `L` is a
subfield of `D` containing `K`, not necessarily central, and `d` is the dimension of `D` as a left
`L`-vector space, then

`N_{D/K}(y) = N_{L/K}(y) ^ d` for every `y` in `L`.

The proof is the observation that left multiplication by `y ∈ L` on `D` *is* the scalar action of
`y` on the `L`-vector space `D`, so its determinant over `L` is `y ^ d`, and
`LinearMap.det_restrictScalars` turns the determinant over `K` of the restriction of scalars into
the norm from `L` to `K` of that determinant.

## Main results

* `InverseGalois.CFT.isField_adjoin_singleton`: the subalgebra generated by one element of a
  finite-dimensional division algebra over `K` is a field.
* `InverseGalois.CFT.norm_algHom_eq_norm_pow`: the norm tower formula for a subfield.
* `InverseGalois.CFT.exists_algHom_norm_pow`: every element of a finite-dimensional division
  algebra lies in the image of a finite extension of `K` on which the two norms are related by
  that formula.

## Tags

division algebra, subfield, norm, tower formula
-/

universe u

open Module

namespace InverseGalois.CFT

/-! ### The subalgebra generated by one element -/

section Adjoin

variable {K D : Type u} [Field K] [Ring D] [Algebra K D]

/-- The subalgebra generated by a single element is contained in its own centralizer: every
element of it is a polynomial in `x`, hence commutes with `x`, hence commutes with every
polynomial in `x`. -/
theorem adjoin_singleton_le_centralizer (x : D) :
    Algebra.adjoin K ({x} : Set D) ≤
      Subalgebra.centralizer K (Algebra.adjoin K ({x} : Set D) : Set D) := by
  have h1 : Algebra.adjoin K ({x} : Set D) ≤ Subalgebra.centralizer K ({x} : Set D) := by
    refine Algebra.adjoin_le ?_
    rintro y rfl
    exact (Subalgebra.mem_centralizer_iff K).2 (by rintro g rfl; rfl)
  refine Algebra.adjoin_le ?_
  rintro y rfl
  refine SetLike.mem_coe.2 ((Subalgebra.mem_centralizer_iff K).2 fun g hg => ?_)
  exact ((Subalgebra.mem_centralizer_iff K).1 (h1 hg) y rfl).symm

variable [IsDomain D] [FiniteDimensional K D]

/-- The subalgebra generated by one element of a finite-dimensional division algebra is a field:
it commutes with itself and it inherits the absence of zero divisors. -/
theorem isField_adjoin_singleton (x : D) : IsField ↥(Algebra.adjoin K ({x} : Set D)) :=
  isField_of_le_centralizer (adjoin_singleton_le_centralizer x)

end Adjoin

/-! ### The norm tower formula across a subfield -/

section NormTower

variable {K L D : Type u} [Field K] [Field L] [Ring D] [Algebra K L] [Algebra K D]
variable [Module L D] [IsScalarTower K L D]

/-- **Norm tower formula across a subfield of an algebra.** If `L` embeds into `D` over `K` by
`f`, and the `L`-module structure of `D` is left multiplication along `f`, then the norm from `D`
to `K` of an element of the image is the norm from `L` to `K` raised to the `L`-dimension of `D`.
Unlike `Algebra.norm_norm` this does not ask `L` to be central in `D`; only that `D` be a left
`L`-vector space through `f`. -/
theorem norm_algHom_eq_norm_pow (f : L →ₐ[K] D) (hf : ∀ (y : L) (z : D), y • z = f y * z)
    (y : L) : Algebra.norm K (f y) = Algebra.norm K y ^ finrank L D := by
  have hlmul : (Algebra.lmul K D (f y) : D →ₗ[K] D)
      = LinearMap.restrictScalars K (y • (LinearMap.id : D →ₗ[L] D)) := by
    ext z
    simpa using (hf y z).symm
  rw [Algebra.norm_apply, hlmul, LinearMap.det_restrictScalars, LinearMap.det_smul,
    LinearMap.det_id, mul_one, map_pow]

end NormTower

/-! ### Every element lies in a subfield on which the formula applies -/

section Exists

variable {K D : Type u} [Field K] [Ring D] [IsDomain D] [Algebra K D] [FiniteDimensional K D]

/-- Every element of a finite-dimensional division algebra over `K` lies in a finite extension
`L` of `K` embedded in `D` with image the subalgebra it generates, and on that extension the norm
from `D` is the `d`-th power of the norm from `L`, where `d` is the codimension `[D : L]`. -/
theorem exists_algHom_norm_pow (x : D) :
    ∃ (L : Type u) (_ : Field L) (_ : Algebra K L) (f : L →ₐ[K] D) (d : ℕ),
      FiniteDimensional K L ∧ 0 < d ∧
        Set.range f = (Algebra.adjoin K ({x} : Set D) : Set D) ∧
        finrank K L * d = finrank K D ∧
        ∀ y : L, Algebra.norm K (f y) = Algebra.norm K y ^ d := by
  classical
  set S : Subalgebra K D := Algebra.adjoin K ({x} : Set D) with hS
  letI : Field ↥S := (isField_adjoin_singleton x).toField
  letI : Module ↥S D := (Subalgebra.val S).toRingHom.toModule
  haveI htower : IsScalarTower K ↥S D := ⟨fun k l d => by
    show ((Subalgebra.val S) (k • l)) * d = k • ((Subalgebra.val S l) * d)
    rw [map_smul, Algebra.smul_def, Algebra.smul_def, mul_assoc]⟩
  haveI : FiniteDimensional K ↥S := inferInstance
  haveI : Module.Finite ↥S D := Module.Finite.of_restrictScalars_finite K ↥S D
  have hrange : Set.range (Subalgebra.val S) = (S : Set D) :=
    Set.ext fun y => ⟨fun ⟨z, hz⟩ => hz ▸ z.2, fun hy => ⟨⟨y, hy⟩, rfl⟩⟩
  refine ⟨↥S, inferInstance, inferInstance, Subalgebra.val S, finrank ↥S D, inferInstance,
    Module.finrank_pos_iff.2 inferInstance, hrange,
    Module.finrank_mul_finrank K ↥S D, fun y => ?_⟩
  exact norm_algHom_eq_norm_pow (Subalgebra.val S) (fun _ _ => rfl) y

end Exists

end InverseGalois.CFT
