import Mathlib
import InverseGalois.CFT.Brauer.PlaceSubcyclotomicBase
import InverseGalois.CFT.Units.AdicRadical

/-!
# The exponent at a place split as a rational exponent times the residue degree

The invariant at an unramified finite place of a cyclic algebra split by a subfield of an extension
generated by a root of unity is recorded by the exponent expressing the automorphism raising that
root of unity to the power of the number of residues of the base as a power of the chosen
generator.  Over an arbitrary number field the number of residues is a power of the rational prime
below the place, the exponent being the residue degree of that prime, so the automorphism in
question is the iterate of the one attached to the rational prime.

That makes the exponent a product: choose once and for all a power of the generator that raises the
root of unity to the rational prime, and the exponent at a place is that choice times the residue
degree of the place.  The dependence on the place is then confined to a single natural number, the
residue degree, and the invariants over a whole fibre can be summed by the norm formula for values
at places.

## Main results

* `InverseGalois.CFT.placeInvariant_cyclicBrauerHom_subcyclotomic_power`: **the invariant at an
  unramified finite place of a cyclic algebra split by a subfield of an extension generated by a
  root of unity, with the exponent split as a rational exponent times the residue degree of the
  place.**

## Tags

number field, cyclotomic field, subfield, Brauer group, local invariant, cyclic algebra, residue
degree, reciprocity, class field theory
-/

set_option synthInstance.maxHeartbeats 1000000
set_option maxHeartbeats 1000000

namespace InverseGalois.CFT

open IsDedekindDomain Module NumberField

section SubcyclotomicPower

variable {k K F : Type} [Field k] [NumberField k] [Field K] [NumberField K] [Algebra k K]
  [IsGalois k K] [Field F] [NumberField F] [Algebra k F] [Algebra F K] [IsScalarTower k F K]
  [IsGalois k F] (w : HeightOneSpectrum (𝓞 K))

variable (k F) in
/-- **The invariant at an unramified finite place of a cyclic algebra split by a subfield of an
extension generated by a root of unity, with the exponent split as a rational exponent times the
residue degree of the place.**  A power of the generator raising the root of unity to the rational
prime below the place raises it, once iterated as many times as the residue degree, to the number
of residues of the base. -/
theorem placeInvariant_cyclicBrauerHom_subcyclotomic_power {σ : Gal(K/k)}
    (hσ : ∀ x : Gal(K/k), x ∈ Subgroup.zpowers σ) {p : ℕ} (hp : p.Prime)
    [(primeUnder (𝓞 k) w).asIdeal.LiesOver (Ideal.span {(p : ℤ)})] (hram : ramIdx (𝓞 k) w = 1)
    {m : ℕ} (hm : m ≠ 0) (hmv : w.valuation K ((m : ℕ) : K) = 1) {ζ : K} (hζ : ζ ^ m = 1)
    (hgen : Algebra.adjoin k ({ζ} : Set K) = ⊤) {g : ℕ} (hσζ : σ ζ = ζ ^ g) {c : ℕ}
    (hgc : Nat.ModEq m (g ^ c) p) (a : kˣ) :
    placeInvariant k (primeUnder (𝓞 k) w)
        (cyclicBrauerHom (forall_mem_zpowers_restrictNormal (L := F) hσ) a)
      = Multiplicative.ofAdd (intQModZ (Nat.card Gal(F/k))
        (((c * (Ideal.span {(p : ℤ)}).inertiaDeg (primeUnder (𝓞 k) w).asIdeal : ℕ) : ℤ) *
          placeValue (primeUnder (𝓞 k) w) a)) := by
  set f := (Ideal.span {(p : ℤ)}).inertiaDeg (primeUnder (𝓞 k) w).asIdeal with hf
  have hτ : (σ ^ (c * f)) ζ = ζ ^ p ^ f := by
    rw [aut_pow_apply_eq_pow_pow hσζ, pow_mul]
    exact pow_eq_pow_of_modEq (hgc.pow f) hζ
  exact placeInvariant_cyclicBrauerHom_subcyclotomic_base k F w hσ hp hram hm hmv hζ hgen hτ rfl a

end SubcyclotomicPower

end InverseGalois.CFT
