import Mathlib
import InverseGalois.CFT.Brauer.LocalSymbolUnits

/-!
# The tame form of the norm residue symbol

Over a complete discretely valued field whose residue characteristic does not divide the prime
exponent, the norm residue symbol is completely determined by its values on a uniformiser against
the units of the valuation ring.

Choosing a uniformiser writes every element as a power of it times a unit of the valuation ring.
Bilinearity, the skew relation and the triviality of the symbol of an element against its own
negative then move every occurrence of the uniformiser into the first argument, and the symbol of
two units of the valuation ring is trivial, so nothing else survives.  The resulting expression
pairs the uniformiser with a unit of the valuation ring built from the two arguments and their
valuations.

The remaining pairing of the uniformiser with a unit only sees the residue of that unit, because a
unit congruent to one is a power with any exponent prime to the residue characteristic.

## Main results

* `InverseGalois.CFT.localSymbol_zpow_mul_zpow_mul`: the symbol of two products of a power of a
  uniformiser and a unit of the valuation ring.
* `InverseGalois.CFT.localSymbol_eq_uniformiser`: **the tame form of the norm residue symbol** —
  the symbol of two elements is the symbol of a uniformiser against an explicit unit of the
  valuation ring.
* `InverseGalois.CFT.localSymbol_eq_one_of_valued_sub_one_lt`: a unit congruent to one pairs
  trivially.
* `InverseGalois.CFT.localSymbol_congr_of_valued_div_sub_one_lt`: **the symbol only depends on the
  residue of its second argument.**

## Tags

norm residue symbol, tame symbol, local field, uniformiser, residue field, class field theory
-/

namespace InverseGalois.CFT

open scoped Valued WithZero

/-! ### Uniformisers -/

section Uniformiser

variable {K : Type} [Field K] [Valued K ℤᵐ⁰] {m : ℤ}

/-- **A field whose value group is generated by the value of a unit has a uniformiser**: a unit
whose valuation is the chosen generator. -/
theorem exists_unitValDiv_eq_one (hm : IsUnitValGen K m) :
    ∃ π : Kˣ, unitValDiv hm (Additive.ofMul π) = 1 :=
  unitValDiv_surjective hm 1

/-- A unit of zero valuation is a unit of the valuation ring. -/
theorem valued_eq_one_of_unitValDiv_eq_zero (hm : IsUnitValGen K m) {a : Kˣ}
    (ha : unitValDiv hm (Additive.ofMul a) = 0) : Valued.v (a : K) = 1 :=
  mem_ker_unitVal.mp (by rw [← ker_unitValDiv hm]; exact AddMonoidHom.mem_ker.mpr ha)

/-- A unit of the valuation ring has zero valuation. -/
theorem unitValDiv_eq_zero_of_valued_eq_one (hm : IsUnitValGen K m) {a : Kˣ}
    (ha : Valued.v (a : K) = 1) : unitValDiv hm (Additive.ofMul a) = 0 :=
  AddMonoidHom.mem_ker.mp (by rw [ker_unitValDiv hm]; exact mem_ker_unitVal.mpr ha)

/-- **Dividing by the matching power of a uniformiser produces a unit of the valuation ring.** -/
theorem valued_mul_zpow_uniformiser (hm : IsUnitValGen K m) {π : Kˣ}
    (hπ : unitValDiv hm (Additive.ofMul π) = 1) (a : Kˣ) :
    Valued.v ((a * π ^ (-unitValDiv hm (Additive.ofMul a)) : Kˣ) : K) = 1 := by
  refine valued_eq_one_of_unitValDiv_eq_zero hm ?_
  rw [ofMul_mul, map_add, ofMul_zpow, map_zsmul, hπ, smul_eq_mul, mul_one,
    add_neg_cancel]

end Uniformiser

/-! ### Group identities -/

section GroupIdentities

variable {G : Type*} [CommGroup G]

/-- Multiplying back the power of the uniformiser recovers the original element. -/
theorem zpow_mul_mul_zpow_neg (π a : G) (i : ℤ) : π ^ i * (a * π ^ (-i)) = a := by
  rw [zpow_neg, mul_comm a, ← mul_assoc, mul_inv_cancel, one_mul]

/-- The powers of the uniformiser cancel in the second argument of the tame form. -/
theorem mul_zpow_neg_zpow_mul (π a b : G) (i j : ℤ) :
    (b * π ^ (-j)) ^ i * (a * π ^ (-i)) ^ (-j) = b ^ i * a ^ (-j) := by
  rw [mul_zpow, mul_zpow, ← zpow_mul, ← zpow_mul, mul_mul_mul_comm, ← zpow_add,
    show (-j) * i + (-i) * (-j) = 0 by ring, zpow_zero, mul_one]

end GroupIdentities

/-! ### The tame form -/

section Tame

variable {K : Type} [Field K] [Valued K ℤᵐ⁰]
  [Valuation.RankOne (Valued.v : Valuation K ℤᵐ⁰)] [CompleteSpace K] [ProperSpace K]
  [PerfectField K] {m : ℤ} {p e : ℕ} {n : ℕ} [NeZero n] {ζ : K}

/-- The norm residue symbol takes a power in its first argument to the same power of the symbol. -/
theorem localSymbol_zpow_left (hres : HasResidueChar K p e) (hm : IsUnitValGen K m)
    (hζ : IsPrimitiveRoot ζ n) (a b : Kˣ) (i : ℤ) :
    localSymbol hres hm hζ (a ^ i) b = localSymbol hres hm hζ a b ^ i := by
  simp

/-- The norm residue symbol of a uniformiser against itself is its symbol against minus one, since
the symbol of an element against its own negative is trivial and the symbol against minus one is
its own inverse. -/
theorem localSymbol_self_eq_neg_one (hres : HasResidueChar K p e) (hm : IsUnitValGen K m)
    (hζ : IsPrimitiveRoot ζ n) (π : Kˣ) :
    localSymbol hres hm hζ π π = localSymbol hres hm hζ π (-1) := by
  have hsq : localSymbol hres hm hζ π (-1) * localSymbol hres hm hζ π (-1) = 1 := by
    rw [← map_mul, show ((-1 : Kˣ)) * (-1 : Kˣ) = 1 by simp, map_one]
  have h1 : localSymbol hres hm hζ π (-1) * localSymbol hres hm hζ π π = 1 := by
    have h := localSymbol_neg_self hres hm hζ π
    rwa [show (-π : Kˣ) = (-1 : Kˣ) * π by simp, map_mul] at h
  exact (inv_eq_of_mul_eq_one_right h1).symm.trans (inv_eq_of_mul_eq_one_right hsq)

/-- **The norm residue symbol of two products of a power of a uniformiser and a unit of the
valuation ring.**  Bilinearity splits the symbol into four pieces; the two units pair trivially,
the skew relation moves the uniformiser out of the second argument, and the symbol of the
uniformiser against itself is its symbol against minus one. -/
theorem localSymbol_zpow_mul_zpow_mul (hres : HasResidueChar K p e) (hm : IsUnitValGen K m)
    (hζ : IsPrimitiveRoot ζ n) (hn : n.Prime) (hpn : ¬ p ∣ n) (π : Kˣ) {u w : Kˣ}
    (hu : Valued.v (u : K) = 1) (hw : Valued.v (w : K) = 1) (i j : ℤ) :
    localSymbol hres hm hζ (π ^ i * u) (π ^ j * w)
      = localSymbol hres hm hζ π ((-1) ^ (i * j) * w ^ i * u ^ (-j)) := by
  have hsw : ∀ x y : Kˣ, localSymbol hres hm hζ y x = (localSymbol hres hm hζ x y)⁻¹ :=
    fun x y => eq_inv_of_mul_eq_one_right (localSymbol_mul_swap hres hm hζ x y)
  have hunits : localSymbol hres hm hζ u w = 1 :=
    localSymbol_eq_one_of_valued_eq_one hres hm hζ hn hpn hu hw
  have hexp : localSymbol hres hm hζ (π ^ i * u) (π ^ j * w)
      = localSymbol hres hm hζ (π ^ i) (π ^ j) * localSymbol hres hm hζ (π ^ i) w
        * (localSymbol hres hm hζ u (π ^ j) * localSymbol hres hm hζ u w) := by
    rw [map_mul (localSymbol hres hm hζ) (π ^ i) u, MonoidHom.mul_apply,
      map_mul (localSymbol hres hm hζ (π ^ i)) (π ^ j) w,
      map_mul (localSymbol hres hm hζ u) (π ^ j) w]
  have e1 : localSymbol hres hm hζ (π ^ i) (π ^ j) = localSymbol hres hm hζ π π ^ (i * j) := by
    rw [localSymbol_zpow_left, map_zpow, ← zpow_mul, mul_comm j i]
  have e2 : localSymbol hres hm hζ (π ^ i) w = localSymbol hres hm hζ π w ^ i :=
    localSymbol_zpow_left hres hm hζ π w i
  have e3 : localSymbol hres hm hζ u (π ^ j) = localSymbol hres hm hζ π u ^ (-j) := by
    rw [map_zpow, hsw π u, inv_zpow, zpow_neg]
  have e4 : localSymbol hres hm hζ π ((-1) ^ (i * j) * w ^ i * u ^ (-j))
      = localSymbol hres hm hζ π (-1) ^ (i * j) * localSymbol hres hm hζ π w ^ i
        * localSymbol hres hm hζ π u ^ (-j) := by
    rw [map_mul, map_mul, map_zpow, map_zpow, map_zpow]
  rw [hexp, e1, e2, e3, hunits, mul_one, e4, localSymbol_self_eq_neg_one]

/-- **The tame form of the norm residue symbol.**  Once a uniformiser is chosen, the symbol of two
elements is the symbol of that uniformiser against an explicit unit of the valuation ring, built
from the two elements and their valuations. -/
theorem localSymbol_eq_uniformiser (hres : HasResidueChar K p e) (hm : IsUnitValGen K m)
    (hζ : IsPrimitiveRoot ζ n) (hn : n.Prime) (hpn : ¬ p ∣ n) {π : Kˣ}
    (hπ : unitValDiv hm (Additive.ofMul π) = 1) (a b : Kˣ) :
    localSymbol hres hm hζ a b
      = localSymbol hres hm hζ π
          ((-1) ^ (unitValDiv hm (Additive.ofMul a) * unitValDiv hm (Additive.ofMul b))
            * b ^ unitValDiv hm (Additive.ofMul a)
            * a ^ (-unitValDiv hm (Additive.ofMul b))) := by
  have hkey := localSymbol_zpow_mul_zpow_mul hres hm hζ hn hpn π
    (valued_mul_zpow_uniformiser hm hπ a) (valued_mul_zpow_uniformiser hm hπ b)
    (unitValDiv hm (Additive.ofMul a)) (unitValDiv hm (Additive.ofMul b))
  rw [zpow_mul_mul_zpow_neg, zpow_mul_mul_zpow_neg] at hkey
  refine hkey.trans (congrArg _ ?_)
  rw [mul_assoc, mul_zpow_neg_zpow_mul, ← mul_assoc]

omit [CompleteSpace K] [ProperSpace K] [PerfectField K] in
/-- The second argument of the tame form is a unit of the valuation ring. -/
theorem valued_tame_argument_eq_one (hm : IsUnitValGen K m) (a b : Kˣ) :
    Valued.v ((((-1) ^ (unitValDiv hm (Additive.ofMul a) * unitValDiv hm (Additive.ofMul b))
      * b ^ unitValDiv hm (Additive.ofMul a)
      * a ^ (-unitValDiv hm (Additive.ofMul b)) : Kˣ)) : K) = 1 := by
  refine valued_eq_one_of_unitValDiv_eq_zero hm ?_
  rw [ofMul_mul, map_add, ofMul_mul, map_add, ofMul_zpow,
    ofMul_zpow, ofMul_zpow, map_zsmul, map_zsmul, map_zsmul]
  have hneg1 : Valued.v ((-1 : Kˣ) : K) = 1 := by
    rw [show ((-1 : Kˣ) : K) = -1 by simp, Valuation.map_neg, map_one]
  rw [unitValDiv_eq_zero_of_valued_eq_one hm hneg1, smul_zero, zero_add, smul_eq_mul, smul_eq_mul]
  ring

end Tame

/-! ### The symbol depends only on the residue -/

section Residue

variable {K : Type} [Field K] [Valued K ℤᵐ⁰]
  [Valuation.RankOne (Valued.v : Valuation K ℤᵐ⁰)] [CompleteSpace K] [ProperSpace K]
  [PerfectField K] {m : ℤ} {p e : ℕ} {n : ℕ} [NeZero n] {ζ : K}

/-- **A unit congruent to one pairs trivially**, because it is an `n`-th power as soon as the
residue characteristic does not divide `n`. -/
theorem localSymbol_eq_one_of_valued_sub_one_lt (hres : HasResidueChar K p e)
    (hm : IsUnitValGen K m) (hζ : IsPrimitiveRoot ζ n) (hpn : ¬ p ∣ n) (a : Kˣ) {u : Kˣ}
    (hu : Valued.v ((u : K) - 1) < 1) : localSymbol hres hm hζ a u = 1 := by
  have hv : Valued.v (u : K) = 1 := by
    have h := Valuation.map_eq_of_sub_lt (Valued.v : Valuation K ℤᵐ⁰) (y := (u : K)) (x := 1)
      (by rwa [map_one])
    rwa [map_one] at h
  obtain ⟨y, hy⟩ := exists_pow_eq_of_valued_sub_lt_one hres (NeZero.ne n) hpn (ζ := u) (b := 1)
    hv (by simpa using hu)
  exact localSymbol_eq_one_of_isPow_right hres hm hζ a ⟨y, hy⟩

/-- **The norm residue symbol only depends on the residue of its second argument**, when that
argument is a unit of the valuation ring. -/
theorem localSymbol_congr_of_valued_div_sub_one_lt (hres : HasResidueChar K p e)
    (hm : IsUnitValGen K m) (hζ : IsPrimitiveRoot ζ n) (hpn : ¬ p ∣ n) (a : Kˣ) {u w : Kˣ}
    (h : Valued.v ((u : K) * (w : K)⁻¹ - 1) < 1) :
    localSymbol hres hm hζ a u = localSymbol hres hm hζ a w := by
  have hone := localSymbol_eq_one_of_valued_sub_one_lt hres hm hζ hpn a (u := u * w⁻¹)
    (by simpa using h)
  rwa [map_mul, map_inv, mul_inv_eq_one] at hone

end Residue

end InverseGalois.CFT
