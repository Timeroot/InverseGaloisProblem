/-!
# The correcting Brauer classes of a number field

Reciprocity over the rationals is proved by correcting an arbitrary Brauer class one rational prime
at a time, the corrections being the classes of cyclic algebras attached to a totally real subfield
of prescribed degree of the cyclotomic field of an auxiliary prime conductor.  Over an arbitrary
number field the very same corrections are available: one composes the base field with that
subfield inside an algebraic closure, which changes neither the degree nor the Galois group as long
as the auxiliary conductor is unramified in the base.

This module performs that construction and packages what it produces.  The auxiliary conductor is a
prime unramified in the base whose group of residues has order divisible by twice the wanted degree;
the cyclotomic field of that conductor is composed with the base to give a cyclic extension carrying
the roots of unity, and its subfield of the wanted degree is composed with the base to give the
splitting field of the corrections.  A unit of the base is sent to the class of the cyclic algebra
of that splitting field with the chosen generator and that unit.

Four properties of the resulting homomorphism are recorded, and they are exactly what the correction
argument consumes.  The classes are killed by the wanted degree, because they are split by an
extension of that degree.  They are trivial at every archimedean place, because the splitting field
is generated by a totally real field.  Their total invariant is trivial, which is the reciprocity
law already known for these particular classes on the integral units at the conductor, extended to
every unit by adjusting it by a norm from the splitting field: the conductor is totally ramified
there, so the norms achieve every family of values at the places above the conductor.  And at a
finite
place lying over a rational prime other than the conductor, the invariant is the valuation there
scaled by the discrete logarithm, to the base of the chosen primitive residue, of the residue
cardinality of the place; this last is what lets a correction be aimed at one prescribed place.

## Main results

* `InverseGalois.CFT.exists_pow_natCast_zmod_eq`: every residue prime to a prime conductor is a
  power of a fixed residue generating the group of residues.
* `InverseGalois.CFT.exists_placeInvariant_cyclicBrauerHom_base`: **the invariant of a cyclic class
  at a finite place of the base away from the conductor** is the valuation of the unit scaled by
  the discrete logarithm of the residue cardinality.
* `InverseGalois.CFT.exists_cyclicBrauerHom_base`: **the correcting Brauer classes of a number
  field**, with their exponent, their archimedean triviality, their reciprocity, and their
  invariants away from the conductor.

## Tags

Brauer group, number field, cyclic algebra, cyclotomic field, local invariant, reciprocity
-/

set_option synthInstance.maxHeartbeats 4000000
set_option maxHeartbeats 1000000

namespace InverseGalois.CFT

open IsDedekindDomain Module NumberField InverseGalois.NumberTheory

/-! ### Discrete logarithms modulo a prime conductor -/

section AuxPow

/-- **Every residue prime to a prime conductor is a power of a fixed generating residue.**  The
group of residues prime to the conductor is the Galois group of the cyclotomic field, so a residue
whose associated automorphism generates that Galois group generates the group of residues. -/
theorem exists_pow_natCast_zmod_eq {q : ℕ} (hq : q.Prime) {g : ℕ} (hg : Nat.Coprime g q)
    (hgord : ∀ m : ℕ, q ∣ g ^ m - 1 → (q - 1) ∣ m) {b : ℕ} (hb : Nat.Coprime b q) :
    ∃ c : ℕ, ((b : ℕ) : ZMod q) = ((g : ℕ) : ZMod q) ^ c := by
  haveI : Fact q.Prime := ⟨hq⟩
  haveI : NeZero q := ⟨hq.ne_zero⟩
  obtain ⟨c, hc⟩ := exists_pow_eq_cyclotomicPowerAut q (CyclotomicField q ℚ) hg
    (forall_mem_zpowers_cyclotomicPowerAut q (CyclotomicField q ℚ) hq hg hgord) hb
  exact ⟨c, natCast_zmod_eq_pow_of_cyclotomicPowerAut_eq_pow q (CyclotomicField q ℚ) hg hb hc⟩

end AuxPow

/-! ### The invariant at a place away from the conductor -/

section Invariant

variable {q : ℕ} [NeZero q] {k K E L₀ : Type} [Field k] [NumberField k]
  [Field K] [NumberField K] [Algebra k K] [IsGalois k K]
  [Field E] [NumberField E] [Algebra k E] [IsGalois k E] [Algebra E K] [IsScalarTower k E K]
  [Field L₀] [NumberField L₀] [IsCyclotomicExtension {q} ℚ L₀] [IsGalois ℚ L₀]
  [Algebra L₀ K] [IsScalarTower ℚ L₀ K] [IsScalarTower ℚ k K]

variable (E) in
/-- **The invariant of a cyclic class at a finite place of the base lying over a rational prime
other than the conductor.**  The residue cardinality of the place is a power of that rational
prime, hence a power of the chosen generating residue; the exponent expressing it is the multiplier
by which the valuation of the unit is scaled.  The place is unramified in the compositum because it
is unramified in the cyclotomic field, and the conductor is a unit there because two distinct
rational primes generate the unit ideal. -/
theorem exists_placeInvariant_cyclicBrauerHom_base (hq : q.Prime) {g : ℕ} (hg : Nat.Coprime g q)
    (hgord : ∀ m : ℕ, q ∣ g ^ m - 1 → (q - 1) ∣ m) {σ : Gal(K/k)}
    (hσ : ∀ x : Gal(K/k), x ∈ Subgroup.zpowers σ) {ζ : K} (hζ : IsPrimitiveRoot ζ q)
    (hgenζ : Algebra.adjoin k ({ζ} : Set K) = ⊤) (hσζ : σ ζ = ζ ^ g)
    (hgenK : Algebra.adjoin k (Set.range (algebraMap L₀ K)) = ⊤) (v : HeightOneSpectrum (𝓞 k))
    {p : ℕ} (hp : p.Prime) (hpq : p ≠ q) (hmem : ((p : ℕ) : 𝓞 k) ∈ v.asIdeal) :
    ∃ c : ℕ, ((g : ℕ) : ZMod q) ^ c
        = ((p : ℕ) : ZMod q) ^ (Ideal.span {(p : ℤ)}).inertiaDeg v.asIdeal ∧
      ∀ a : kˣ,
        placeInvariant k v (cyclicBrauerHom (forall_mem_zpowers_restrictNormal (L := E) hσ) a)
          = Multiplicative.ofAdd (intQModZ (Nat.card Gal(E/k)) ((c : ℤ) * placeValue v a)) := by
  haveI : Fact q.Prime := ⟨hq⟩
  haveI : Fact p.Prime := ⟨hp⟩
  haveI := liesOver_span_of_natCast_mem hp v hmem
  obtain ⟨w, rfl⟩ := exists_primeUnder_eq (𝓞 k) (𝓞 K) v
  set f := (Ideal.span {(p : ℤ)}).inertiaDeg (primeUnder (𝓞 k) w).asIdeal with hf
  have hpq' : Nat.Coprime p q := (Nat.coprime_primes hp hq).mpr hpq
  have hnotdvd : ¬ p ∣ q := fun h => hpq ((Nat.prime_dvd_prime_iff_eq hp hq).mp h)
  obtain ⟨c, hc⟩ := exists_pow_natCast_zmod_eq hq hg hgord (hpq'.pow_left f)
  refine ⟨c, ?_, fun a => ?_⟩
  · push_cast at hc ⊢
    exact hc.symm
  have hpow : ∀ n : ℕ, (σ ^ n) ζ = ζ ^ g ^ n := by
    intro n
    induction n with
    | zero => simp
    | succ n ih => rw [pow_succ, AlgEquiv.mul_apply, hσζ, map_pow, ih, ← pow_mul, ← pow_succ]
  have hcast : ((p ^ f : ℕ) : ZMod q) = ((g ^ c : ℕ) : ZMod q) := by push_cast at hc ⊢; exact hc
  have hmod : p ^ f ≡ g ^ c [MOD q] := (ZMod.natCast_eq_natCast_iff _ _ _).mp hcast
  have hτζ : (σ ^ c) ζ = ζ ^ p ^ f := by
    rw [hpow c]
    exact (pow_eq_pow_of_modEq hmod hζ.pow_eq_one).symm
  rw [primeUnder_asIdeal, Ideal.under_def, Ideal.mem_comap, map_natCast] at hmem
  have hmemL : ((p : ℕ) : 𝓞 L₀) ∈ (primeUnder (𝓞 L₀) w).asIdeal := by
    rw [primeUnder_asIdeal, Ideal.under_def, Ideal.mem_comap, map_natCast]
    exact hmem
  haveI := liesOver_span_of_natCast_mem hp (primeUnder (𝓞 L₀) w) hmemL
  have hram : ramIdx (𝓞 k) w = 1 :=
    ramIdx_eq_one_of_ramIdx_eq_one hgenK w
      (ramIdx_rat_eq_one_of_not_dvd q L₀ p (primeUnder (𝓞 L₀) w) hnotdvd)
  have hnotmem : ((q : ℕ) : 𝓞 K) ∉ w.asIdeal := by
    intro hqmem
    obtain ⟨u, u', huu⟩ : IsCoprime ((p : ℕ) : 𝓞 K) ((q : ℕ) : 𝓞 K) := by
      have h := (Nat.isCoprime_iff_coprime.mpr hpq').map (algebraMap ℤ (𝓞 K))
      simpa using h
    refine w.isPrime.ne_top ((Ideal.eq_top_iff_one _).mpr ?_)
    rw [← huu]
    exact Ideal.add_mem _ (Ideal.mul_mem_left _ _ hmem) (Ideal.mul_mem_left _ _ hqmem)
  have hmv : w.valuation K ((q : ℕ) : K) = 1 := (valuation_natCast_eq_one_iff K w q).mpr hnotmem
  exact placeInvariant_cyclicBrauerHom_subcyclotomic_base k E w hσ hp hram hq.ne_zero hmv
    hζ.pow_eq_one hgenζ hτζ rfl a

end Invariant

/-! ### The correcting classes -/

section Construction

/-- **The correcting Brauer classes of a number field.**  For a prime conductor unramified in the
base whose group of residues has order divisible by twice a prescribed degree, and a residue
generating that group, there is a homomorphism from the units of the base to its Brauer group whose
classes are killed by the prescribed degree, are trivial at every archimedean place, have trivial
total invariant, and have prescribed invariants at the finite places away from the conductor.  The
homomorphism is the cyclic algebra construction for the compositum of the base with a totally real
subfield of the cyclotomic field of the conductor.  The conductor is totally ramified in that
compositum, so the norms from it realise every family of values at the places above the conductor,
and adjusting by a norm reduces the total invariant of an arbitrary unit to that of an algebraic
integer which is a unit at the conductor. -/
theorem exists_cyclicBrauerHom_base (k : Type) [Field k] [NumberField k] {q : ℕ} (hq : q.Prime)
    (hqk : q ∉ ramifiedSet k) {N : ℕ} (hN : N ≠ 0) (h2N : 2 * N ∣ q - 1) {g : ℕ}
    (hg : Nat.Coprime g q) (hgord : ∀ m : ℕ, q ∣ g ^ m - 1 → (q - 1) ∣ m) :
    ∃ Y : kˣ →* BrauerGroup.{0, 0} k,
      (∀ a : kˣ, Y a ^ N = 1) ∧
      (∀ (a : kˣ) (u : InfinitePlace k), infinitePlaceInvariant k u (Y a) = 1) ∧
      (∀ a : kˣ, totalInvariant k (Y a) = 1) ∧
      ∀ (v : HeightOneSpectrum (𝓞 k)) (p : ℕ), p.Prime → p ≠ q →
        ((p : ℕ) : 𝓞 k) ∈ v.asIdeal →
        ∃ c : ℕ, ((g : ℕ) : ZMod q) ^ c
            = ((p : ℕ) : ZMod q) ^ (Ideal.span {(p : ℤ)}).inertiaDeg v.asIdeal ∧
          ∀ a : kˣ, placeInvariant k v (Y a)
            = Multiplicative.ofAdd (intQModZ N ((c : ℤ) * placeValue v a)) := by
  haveI : Fact q.Prime := ⟨hq⟩
  haveI : NeZero q := ⟨hq.ne_zero⟩
  haveI : NeZero N := ⟨hN⟩
  have hq2 : q ≠ 2 := by
    rintro rfl
    rw [show (2 : ℕ) - 1 = 1 from rfl] at h2N
    have h2 := Nat.le_of_dvd one_pos h2N
    omega
  have hodd : Odd q := hq.odd_of_ne_two hq2
  haveI : IsGalois ℚ (CyclotomicField q ℚ) := IsCyclotomicExtension.isGalois {q} ℚ _
  haveI : IsCyclotomicExtension {q ^ 1} ℚ (CyclotomicField q ℚ) := by rw [pow_one]; infer_instance
  obtain ⟨F, hrankF, hgalF, hcycF, hrealF, -, -, hinertia₀⟩ :=
    exists_intermediateField_subcyclotomic q hN h2N (CyclotomicField q ℚ)
  haveI := hgalF
  haveI := hcycF
  haveI := hrealF
  haveI : FiniteDimensional ℚ ↥F := IntermediateField.finiteDimensional_left F
  haveI : NumberField ↥F := ⟨⟩
  obtain ⟨ιL⟩ : Nonempty (CyclotomicField q ℚ →ₐ[ℚ] AlgebraicClosure k) := ⟨IsAlgClosed.lift⟩
  set ιF : ↥F →ₐ[ℚ] AlgebraicClosure k := ιL.comp F.val with hιF
  haveI : IsScalarTower ℚ k ↥(baseCompositum ιL) :=
    IsScalarTower.of_algebraMap_eq' (Subsingleton.elim _ _)
  haveI : IsScalarTower ℚ k ↥(baseCompositum ιF) :=
    IsScalarTower.of_algebraMap_eq' (Subsingleton.elim _ _)
  have hle : baseCompositum ιF ≤ baseCompositum ιL :=
    baseCompositum_le_of_range_subset ιF ιL (by rintro _ ⟨y, rfl⟩; exact ⟨F.val y, rfl⟩)
  letI : Algebra ↥(baseCompositum ιF) ↥(baseCompositum ιL) :=
    (IntermediateField.inclusion hle).toAlgebra
  haveI : IsScalarTower k ↥(baseCompositum ιF) ↥(baseCompositum ιL) :=
    IsScalarTower.of_algebraMap_eq fun x => ((IntermediateField.inclusion hle).commutes x).symm
  have hgenK : Algebra.adjoin k
      (Set.range (algebraMap (CyclotomicField q ℚ) ↥(baseCompositum ιL))) = ⊤ :=
    adjoin_range_algebraMap_eq_top ιL
  have hgenE : Algebra.adjoin k (Set.range (algebraMap ↥F ↥(baseCompositum ιF))) = ⊤ :=
    adjoin_range_algebraMap_eq_top ιF
  have hramL : ramifiedSet (CyclotomicField q ℚ) ⊆ {q} :=
    ramifiedSet_subset_singleton_primePow q 1 (CyclotomicField q ℚ) (CyclotomicField q ℚ)
  have hramF : ramifiedSet ↥F ⊆ {q} :=
    ramifiedSet_subset_singleton_primePow q 1 (CyclotomicField q ℚ) ↥F
  have hdisjL : Disjoint (ramifiedSet (CyclotomicField q ℚ)) (ramifiedSet k) :=
    Set.disjoint_left.mpr fun p hp hpk => hqk (by rwa [Set.mem_singleton_iff.mp (hramL hp)] at hpk)
  have hdisjF : Disjoint (ramifiedSet ↥F) (ramifiedSet k) :=
    Set.disjoint_left.mpr fun p hp hpk => hqk (by rwa [Set.mem_singleton_iff.mp (hramF hp)] at hpk)
  set ζ₀ : CyclotomicField q ℚ := IsCyclotomicExtension.zeta q ℚ (CyclotomicField q ℚ) with hζ₀def
  have hζ₀ : IsPrimitiveRoot ζ₀ q := IsCyclotomicExtension.zeta_spec q ℚ _
  set ζ : ↥(baseCompositum ιL) :=
    algebraMap (CyclotomicField q ℚ) ↥(baseCompositum ιL) ζ₀ with hζdef
  have hζ : IsPrimitiveRoot ζ q :=
    hζ₀.map_of_injective (algebraMap (CyclotomicField q ℚ) ↥(baseCompositum ιL)).injective
  have hθ : IntermediateField.adjoin ℚ ({ζ₀} : Set (CyclotomicField q ℚ)) = ⊤ := by
    refine IntermediateField.toSubalgebra_injective ?_
    rw [IntermediateField.adjoin_simple_toSubalgebra_of_isAlgebraic
      (Algebra.IsIntegral.isIntegral ζ₀).isAlgebraic, IntermediateField.top_toSubalgebra]
    exact adjoin_zeta_rat_eq_top q (CyclotomicField q ℚ)
  have hgenζ : Algebra.adjoin k ({ζ} : Set ↥(baseCompositum ιL)) = ⊤ :=
    adjoin_singleton_eq_top ιL hθ
  set σ : Gal(↥(baseCompositum ιL)/k) :=
    (galEquivSub k (CyclotomicField q ℚ) ↥(baseCompositum ιL) hgenK hdisjL).symm
      (cyclotomicPowerAut q (CyclotomicField q ℚ) hg) with hσdef
  have hres : galRestrictSub k (CyclotomicField q ℚ) ↥(baseCompositum ιL) σ
      = cyclotomicPowerAut q (CyclotomicField q ℚ) hg := by
    rw [hσdef]
    exact (galEquivSub k (CyclotomicField q ℚ) ↥(baseCompositum ιL) hgenK
      hdisjL).apply_symm_apply _
  have hσ : ∀ x : Gal(↥(baseCompositum ιL)/k), x ∈ Subgroup.zpowers σ := by
    intro x
    obtain ⟨n, hn⟩ := forall_mem_zpowers_cyclotomicPowerAut q (CyclotomicField q ℚ) hq hg hgord
      (galEquivSub k (CyclotomicField q ℚ) ↥(baseCompositum ιL) hgenK hdisjL x)
    refine ⟨n, ?_⟩
    refine (galEquivSub k (CyclotomicField q ℚ) ↥(baseCompositum ιL) hgenK hdisjL).injective ?_
    rw [map_zpow, hσdef, MulEquiv.apply_symm_apply]
    exact hn
  have hσζ : σ ζ = ζ ^ g := by
    have h2 := galRestrictSub_algebraMap (k := k) (F₀ := CyclotomicField q ℚ)
      (E := ↥(baseCompositum ιL)) σ ζ₀
    rw [hres, cyclotomicPowerAut_apply q (CyclotomicField q ℚ) hg hζ₀.pow_eq_one, map_pow] at h2
    exact h2.symm
  have hcardF₀ : Nat.card Gal(↥F/ℚ) = N := by rw [IsGalois.card_aut_eq_finrank ℚ ↥F, hrankF]
  have hcardE : Nat.card Gal(↥(baseCompositum ιF)/k) = N := by
    rw [IsGalois.card_aut_eq_finrank k ↥(baseCompositum ιF),
      finrank_eq_of_adjoin_eq_top hgenE hdisjF, hrankF]
  refine ⟨cyclicBrauerHom (forall_mem_zpowers_restrictNormal (L := ↥(baseCompositum ιF)) hσ),
    fun a => ?_, fun a u => ?_, fun a => ?_, fun v p hp hpq hmem => ?_⟩
  · have h := pow_finrank_eq_one_of_mem_relative
      (cyclicBrauerHom (forall_mem_zpowers_restrictNormal (L := ↥(baseCompositum ιF)) hσ) a)
      (cyclicBrauerHom_mem_relative
        (forall_mem_zpowers_restrictNormal (L := ↥(baseCompositum ιF)) hσ) a)
    rwa [finrank_eq_of_adjoin_eq_top hgenE hdisjF, hrankF] at h
  · exact infinitePlaceInvariant_eq_one_of_adjoin_isTotallyReal hgenE u
      (cyclicBrauerHom_mem_relative _ a)
  · refine totalInvariant_eq_one_of_integral_qunit (E := ↥(baseCompositum ιF)) hq _
      (fun θ => MonoidHom.mem_ker.mp ((mem_ker_cyclicBrauerHom_iff _ _).mpr ⟨θ, rfl⟩))
      (fun W hW => inertia_eq_top_of_natCast_mem hq hqk hinertia₀ hgenE W hW)
      (fun a hab hav => ?_) a
    obtain ⟨b, hb⟩ := hab
    exact totalInvariant_cyclicBrauerHom_base_cyclotomic hq hodd hcardF₀ h2N hqk hinertia₀ hg
      hgord hσ hζ hgenζ hσζ hgenK hgenE hb hav
  · obtain ⟨c, hc, hinv⟩ := exists_placeInvariant_cyclicBrauerHom_base
      (E := ↥(baseCompositum ιF)) hq hg hgord hσ hζ hgenζ hσζ hgenK v hp hpq hmem
    exact ⟨c, hc, fun a => by rw [hinv a, hcardE]⟩

end Construction

end InverseGalois.CFT
