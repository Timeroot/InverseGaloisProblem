import Mathlib
import InverseGalois.CFT.Brauer.DivisionMaximal
import InverseGalois.CFT.Brauer.DivisionTeichmuller

/-!
# An unramified extension of a local field is generated by a root of unity

Say that a finite extension of a nonarchimedean local field is unramified when the absolute values
of its nonzero elements are already absolute values of nonzero scalars.  Then a uniformizer of the
base field is a uniformizer of the extension, and the Teichmüller root of unity, whose powers
exhaust the nonzero residues, generates the extension: the dimension bound of a subfield covering
all residues costs a factor equal to the ramification, which here is one.

Because the extension is generated by a single root of unity, an automorphism of it over the base
field is determined by its value on that root of unity.  This is the statement which pins down the
Frobenius automorphism of an unramified extension.

## Main results

* `InverseGalois.CFT.isDivisionUniformizer_algebraMap`: a uniformizer of the base field is a
  uniformizer of an unramified extension.
* `InverseGalois.CFT.exists_adjoin_rootOfUnity_eq_top_of_unramified`: **an unramified extension of a
  local field is generated by a root of unity of order the number of nonzero residues.**
* `InverseGalois.CFT.algEquiv_eq_of_apply_eq_of_adjoin_eq_top`: an automorphism of an extension
  generated by one element is determined by its value on that element.

## Tags

local field, unramified extension, root of unity, Teichmüller lift, Frobenius
-/

universe u

namespace InverseGalois.CFT

open Module

variable {K L : Type u} [NontriviallyNormedField K] [IsUltrametricDist K] [ProperSpace K]
variable [Field L] [Algebra K L] [FiniteDimensional K L]

/-! ### The uniformizer of an unramified extension -/

variable (K L) in
omit [IsUltrametricDist K] [ProperSpace K] in
/-- **A uniformizer of the base field is a uniformizer of an unramified extension.**  An element of
absolute value less than one has the absolute value of a scalar, and that scalar has absolute value
less than one, so it does not exceed the uniformizer. -/
theorem isDivisionUniformizer_algebraMap
    (hur : ∀ z : L, z ≠ 0 → ∃ c : K, c ≠ 0 ∧ divisionNorm K L z = ‖c‖) {π : K}
    (hπ : IsNormUniformizer π) : IsDivisionUniformizer K L (algebraMap K L π) where
  ne_zero h := hπ.ne_zero ((algebraMap K L).injective (h.trans (map_zero _).symm))
  norm_lt_one := by
    rw [divisionNorm_algebraMap]
    exact hπ.norm_lt_one
  le_norm x hx := by
    rw [divisionNorm_algebraMap]
    rcases eq_or_ne x 0 with rfl | hx0
    · rw [divisionNorm_zero]
      exact hπ.norm_pos.le
    · obtain ⟨c, _, hc⟩ := hur x hx0
      rw [hc] at hx ⊢
      exact hπ.le_norm c hx

/-! ### The generator -/

variable (K L) in
/-- **An unramified extension of a local field is generated by a root of unity** whose order is the
number of nonzero residues.  Its powers cover every residue, so the subfield it generates spans the
extension over a uniformizer, and a uniformizer of the base field already serves. -/
theorem exists_adjoin_rootOfUnity_eq_top_of_unramified
    (hur : ∀ z : L, z ≠ 0 → ∃ c : K, c ≠ 0 ∧ divisionNorm K L z = ‖c‖) :
    ∃ ζ : L, ζ ^ (Nat.card (DivisionResidue K L) - 1) = 1 ∧
      (∀ m : ℕ, ζ ^ m = 1 → Nat.card (DivisionResidue K L) - 1 ∣ m) ∧
      Algebra.adjoin K ({ζ} : Set L) = ⊤ := by
  obtain ⟨π, hπ⟩ := exists_isNormUniformizer K
  obtain ⟨ζ, h1, h2, hcov0⟩ := exists_rootOfUnity_pow_divisionNorm_sub_lt_one K L
  refine ⟨ζ, h1, h2, ?_⟩
  set M : Subalgebra K L := Algebra.adjoin K ({ζ} : Set L) with hM
  have hζM : ζ ∈ M := Algebra.self_mem_adjoin_singleton K ζ
  have hϖ : IsDivisionUniformizer K L (algebraMap K L π) :=
    isDivisionUniformizer_algebraMap K L hur hπ
  have hcov : ∀ x : L, divisionNorm K L x ≤ 1 → ∃ z : M, divisionNorm K L (x - (z : L)) < 1 := by
    intro x hx
    rcases lt_or_eq_of_le hx with h | h
    · exact ⟨0, by simpa using h⟩
    · obtain ⟨i, hi⟩ := hcov0 x h
      exact ⟨⟨ζ ^ i, pow_mem hζM i⟩, hi⟩
  have hne : ((⟨algebraMap K L π, M.algebraMap_mem π⟩ : M) : L) ≠ 0 := hϖ.ne_zero
  have hnorm : divisionNorm K L ((⟨algebraMap K L π, M.algebraMap_mem π⟩ : M) : L)
      = divisionNorm K L (algebraMap K L π) ^ 1 := by rw [pow_one]
  have hle := finrank_le_mul_of_divisionNorm_eq_pow hϖ hπ hcov Nat.one_pos hne hnorm
  rw [one_mul] at hle
  have hge : finrank K ↥M ≤ finrank K L := by
    have := Submodule.finrank_le (Subalgebra.toSubmodule M)
    rwa [M.finrank_toSubmodule] at this
  exact Algebra.toSubmodule_eq_top.1
    (Submodule.eq_top_of_finrank_eq (M.finrank_toSubmodule.trans (le_antisymm hge hle)))

/-! ### Automorphisms of a simple extension -/

omit [IsUltrametricDist K] [ProperSpace K] [FiniteDimensional K L] in
/-- **An automorphism of an extension generated by one element is determined by its value on that
element.** -/
theorem algEquiv_eq_of_apply_eq_of_adjoin_eq_top {ζ : L}
    (hζ : Algebra.adjoin K ({ζ} : Set L) = ⊤) {σ τ : L ≃ₐ[K] L} (h : σ ζ = τ ζ) : σ = τ := by
  have hh : (σ : L →ₐ[K] L) = (τ : L →ₐ[K] L) :=
    AlgHom.ext_of_adjoin_eq_top hζ (Set.eqOn_singleton.2 h)
  exact AlgEquiv.ext fun x => AlgHom.congr_fun hh x

end InverseGalois.CFT
