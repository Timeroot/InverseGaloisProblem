import Mathlib
import InverseGalois.CFT.Brauer.DivisionAbsValue

/-!
# The integers of a division algebra over a discretely valued field

Let `K` be complete with respect to a nontrivial nonarchimedean absolute value which is *discrete*,
in the sense that among the elements of absolute value less than one there is one of largest
absolute value, a uniformizer.  Let `D` be a central division algebra over `K` of dimension `n ^ 2`.
The absolute value of `D` is then discrete as well, and this file constructs the objects that make
that precise.

The mechanism is the degree bound.  A single element `x` of `D` generates a subfield `K[x]`, which
is contained in its own centralizer, so its dimension is at most the dimension of that centralizer,
and the two dimensions multiply to `n ^ 2`; hence `[K[x] : K] ≤ n`.  The norm from `D` to `K` of `x`
is the appropriate power of the norm from `K[x]` to `K`, so some power `m ≤ n` of `|x|` is the
absolute value of a scalar.  Since every `m ≤ n` divides `n !`, the `n !`-th power of `|x|` is
always the absolute value of a scalar, and the absolute values of `D` are therefore integer powers
of the `n !`-th root of the absolute value of a uniformizer of `K`.  A set of integer powers of a
number less than one which is bounded above by one has a largest element, and that produces a
uniformizer of `D`.

## Main definitions

* `InverseGalois.CFT.IsNormUniformizer`: an element of largest absolute value among those of
  absolute value less than one.
* `InverseGalois.CFT.divisionIntegers`: the subring of elements of absolute value at most one.

## Main results

* `InverseGalois.CFT.IsNormUniformizer.exists_zpow`: the absolute values of the nonzero scalars are
  the integer powers of the absolute value of a uniformizer.
* `InverseGalois.CFT.finrank_adjoin_singleton_mul_self_le`: the square of the degree of the subfield
  generated by an element is at most the dimension of the algebra.
* `InverseGalois.CFT.exists_norm_eq_divisionNorm_pow`: some power at most `n` of the absolute value
  of an element of `D` is the absolute value of a scalar.
* `InverseGalois.CFT.exists_divisionNorm_zpow`: the absolute values of the nonzero elements of `D`
  are the integer powers of a fixed number less than one.
* `InverseGalois.CFT.exists_isNormUniformizer_divisionNorm`: **the absolute value of `D` has a
  uniformizer.**

## Tags

division algebra, absolute value, uniformizer, discrete valuation
-/

set_option maxHeartbeats 1000000
set_option synthInstance.maxHeartbeats 1000000

universe u

open Module

open scoped Nat

namespace InverseGalois.CFT

/-! ### Uniformizers -/

section Uniformizer

variable {K : Type u} [NormedField K]

/-- A **uniformizer** for a nonarchimedean absolute value: a nonzero element of absolute value less
than one whose absolute value is the largest among the elements of absolute value less than one. -/
structure IsNormUniformizer (π : K) : Prop where
  /-- A uniformizer is nonzero. -/
  ne_zero : π ≠ 0
  /-- A uniformizer has absolute value less than one. -/
  norm_lt_one : ‖π‖ < 1
  /-- No element of absolute value less than one has absolute value larger than a uniformizer. -/
  le_norm : ∀ c : K, ‖c‖ < 1 → ‖c‖ ≤ ‖π‖

theorem IsNormUniformizer.norm_pos {π : K} (hπ : IsNormUniformizer π) : 0 < ‖π‖ :=
  norm_pos_iff.2 hπ.ne_zero

/-- **The absolute values of the nonzero elements are the integer powers of the absolute value of a
uniformizer.**  Between two consecutive powers of the uniformizer there is nothing: dividing by the
appropriate power lands in the half-open interval from the absolute value of the uniformizer to
one, and the maximality of the uniformizer forces the value one. -/
theorem IsNormUniformizer.exists_zpow {π : K} (hπ : IsNormUniformizer π) {c : K} (hc : c ≠ 0) :
    ∃ i : ℤ, ‖c‖ = ‖π‖ ^ i := by
  have hp : 0 < ‖π‖ := hπ.norm_pos
  have hc0 : 0 < ‖c‖ := norm_pos_iff.2 hc
  have hq : 1 < ‖π‖⁻¹ := (one_lt_inv₀ hp).2 hπ.norm_lt_one
  obtain ⟨j, hj1, hj2⟩ := exists_mem_Ioc_zpow hc0 hq
  refine ⟨-(j + 1), ?_⟩
  have hjeq : ∀ t : ℤ, (‖π‖⁻¹ : ℝ) ^ t = ‖π‖ ^ (-t) := fun t => by
    rw [inv_zpow, ← zpow_neg]
  rw [hjeq] at hj1 hj2
  set i : ℤ := -(j + 1) with hi
  have hlt : ‖π‖ ^ (i + 1) < ‖c‖ := by
    have : i + 1 = -j := by omega
    rw [this]; exact hj1
  have hle : ‖c‖ ≤ ‖π‖ ^ i := by
    have : i = -(j + 1) := hi
    rw [this]; exact hj2
  set u : K := c * π ^ (-i) with hu
  have hnu : ‖u‖ = ‖c‖ * ‖π‖ ^ (-i) := by rw [hu, norm_mul, norm_zpow]
  have hu1 : ‖u‖ ≤ 1 := by
    rw [hnu]
    calc ‖c‖ * ‖π‖ ^ (-i) ≤ ‖π‖ ^ i * ‖π‖ ^ (-i) :=
          mul_le_mul_of_nonneg_right hle (zpow_pos hp _).le
      _ = 1 := by rw [← zpow_add₀ hp.ne', add_neg_cancel, zpow_zero]
  have hu2 : ‖π‖ < ‖u‖ := by
    rw [hnu]
    calc ‖π‖ = ‖π‖ ^ (i + 1) * ‖π‖ ^ (-i) := by
          rw [← zpow_add₀ hp.ne']
          simp
      _ < ‖c‖ * ‖π‖ ^ (-i) := by
          exact mul_lt_mul_of_pos_right hlt (zpow_pos hp _)
  have hueq : ‖u‖ = 1 := by
    rcases lt_or_eq_of_le hu1 with h | h
    · exact absurd (hπ.le_norm u h) (not_le.2 hu2)
    · exact h
  have hfin : ‖c‖ * ‖π‖ ^ (-i) = 1 := by rw [← hnu, hueq]
  rwa [zpow_neg, mul_inv_eq_one₀ (zpow_pos hp i).ne'] at hfin

end Uniformizer

/-! ### The degree bound -/

section Degree

variable {K D : Type u} [Field K] [DivisionRing D] [Algebra K D] [FiniteDimensional K D]

variable (K) in
/-- **The square of the degree of the subfield generated by a single element is at most the
dimension of the algebra.**  That subfield is contained in its own centralizer, so its dimension is
at most the dimension of the centralizer, and the product of the two is the dimension of the
algebra. -/
theorem finrank_adjoin_singleton_mul_self_le [Algebra.IsCentral K D] (x : D) :
    finrank K ↥(Algebra.adjoin K ({x} : Set D)) * finrank K ↥(Algebra.adjoin K ({x} : Set D))
      ≤ finrank K D := by
  set B : Subalgebra K D := Algebra.adjoin K ({x} : Set D) with hB
  have hBle : B ≤ Subalgebra.centralizer K (B : Set D) := adjoin_singleton_le_centralizer x
  letI : Field ↥B := (isField_adjoin_singleton x).toField
  have hmul : finrank K ↥B * finrank K ↥(Subalgebra.centralizer K (B : Set D)) = finrank K D :=
    Centralizer.finrank_mul_finrank_centralizer B
  have hle : finrank K ↥B ≤ finrank K ↥(Subalgebra.centralizer K (B : Set D)) :=
    Submodule.finrank_mono (Subalgebra.toSubmodule.monotone hBle)
  calc finrank K ↥B * finrank K ↥B
      ≤ finrank K ↥B * finrank K ↥(Subalgebra.centralizer K (B : Set D)) :=
        Nat.mul_le_mul_left _ hle
    _ = finrank K D := hmul

omit [FiniteDimensional K D] in
/-- A finite extension of `K` embedded in `D` with image the subalgebra generated by an element has
the degree of that subalgebra. -/
theorem finrank_eq_of_range_eq_adjoin {L : Type u} [Field L] [Algebra K L] (f : L →ₐ[K] D) {x : D}
    (hrange : Set.range f = (Algebra.adjoin K ({x} : Set D) : Set D)) :
    finrank K L = finrank K ↥(Algebra.adjoin K ({x} : Set D)) := by
  have hinj : Function.Injective f := f.toRingHom.injective
  have hr : f.range = Algebra.adjoin K ({x} : Set D) :=
    SetLike.coe_injective (by rw [AlgHom.coe_range, hrange])
  calc finrank K L = finrank K ↥f.range := (AlgEquiv.ofInjective f hinj).toLinearEquiv.finrank_eq
    _ = finrank K ↥(Algebra.adjoin K ({x} : Set D)) := by rw [hr]

end Degree

/-! ### Discreteness of the absolute value of a division algebra -/

section Discrete

variable {K D : Type u} [NontriviallyNormedField K] [IsUltrametricDist K] [CompleteSpace K]
variable [DivisionRing D] [Algebra K D] [FiniteDimensional K D]

omit [IsUltrametricDist K] [CompleteSpace K] in
theorem divisionNorm_pos {x : D} (hx : x ≠ 0) : 0 < divisionNorm K D x :=
  lt_of_le_of_ne (divisionNorm_nonneg x) fun h => hx (divisionNorm_eq_zero_iff.1 h.symm)

omit [IsUltrametricDist K] [CompleteSpace K] in
@[simp]
theorem divisionNorm_zero : divisionNorm K D 0 = 0 := divisionNorm_eq_zero_iff.2 rfl

omit [IsUltrametricDist K] [CompleteSpace K] in
@[simp]
theorem divisionNorm_neg (x : D) : divisionNorm K D (-x) = divisionNorm K D x := by
  have h : -x = algebraMap K D (-1) * x := by rw [map_neg, map_one, neg_one_mul]
  rw [h, divisionNorm_mul, divisionNorm_algebraMap, norm_neg, norm_one, one_mul]

variable (K D) in
omit [IsUltrametricDist K] [CompleteSpace K] in
/-- **Some power at most `n` of the absolute value of an element of `D` is the absolute value of a
scalar**, where `n ^ 2` is the dimension of `D`.  The element lies in a subfield of degree `m ≤ n`
over `K`, and the norm from `D` is the appropriate power of the norm from that subfield. -/
theorem exists_norm_eq_divisionNorm_pow [Algebra.IsCentral K D] {n : ℕ}
    (hn : n * n = finrank K D) {x : D} (hx : x ≠ 0) :
    ∃ (m : ℕ) (c : K), 0 < m ∧ m ≤ n ∧ c ≠ 0 ∧ divisionNorm K D x ^ m = ‖c‖ := by
  obtain ⟨L, _, _, f, d, hfinL, hd0, hrange, hdim, hnorm⟩ := exists_algHom_norm_pow (K := K) x
  haveI : FiniteDimensional K L := hfinL
  obtain ⟨y, hy⟩ : x ∈ Set.range f := by
    rw [hrange]; exact Algebra.self_mem_adjoin_singleton K x
  have hy0 : y ≠ 0 := fun h => hx (by rw [← hy, h, map_zero])
  have hmn : finrank K L ≤ n := by
    by_contra hcon
    push_neg at hcon
    have h1 := finrank_adjoin_singleton_mul_self_le K (D := D) x
    rw [← finrank_eq_of_range_eq_adjoin f hrange, ← hn] at h1
    exact absurd h1 (not_le.2 (Nat.mul_self_lt_mul_self hcon))
  refine ⟨finrank K L, Algebra.norm K y, Module.finrank_pos, hmn, algebraNorm_ne_zero hy0, ?_⟩
  set t : ℝ := ‖Algebra.norm K y‖ with ht0
  have ht : 0 ≤ t := norm_nonneg _
  have hL0 : (finrank K L : ℝ) ≠ 0 :=
    Nat.cast_ne_zero.2 (Module.finrank_pos (R := K) (M := L)).ne'
  have hd0' : (d : ℝ) ≠ 0 := Nat.cast_ne_zero.2 hd0.ne'
  have hD0 : ((finrank K D : ℕ) : ℝ) ≠ 0 := by
    rw [← hdim]; push_cast; exact mul_ne_zero hL0 hd0'
  have h1 : divisionNorm K D x = t ^ ((d : ℝ) / (finrank K D : ℝ)) := by
    rw [divisionNorm, ← hy, hnorm, norm_pow, ← Real.rpow_natCast t d, ← Real.rpow_mul ht]
    congr 1
    ring
  have h2 : (d : ℝ) / (finrank K D : ℝ) * (finrank K L : ℝ) = 1 := by
    rw [← hdim]
    push_cast
    field_simp
  rw [h1, ← Real.rpow_natCast (t ^ ((d : ℝ) / (finrank K D : ℝ))) (finrank K L),
    ← Real.rpow_mul ht, h2, Real.rpow_one]

variable (K D) in
omit [IsUltrametricDist K] [CompleteSpace K] in
/-- **The absolute values of the nonzero elements of `D` are the integer powers of the `n !`-th
root of the absolute value of a uniformizer of `K`**, where `n ^ 2` is the dimension of `D`.  Some
power `m ≤ n` of the absolute value of an element is the absolute value of a scalar, and `m`
divides `n !`. -/
theorem exists_divisionNorm_zpow [Algebra.IsCentral K D] {π : K} (hπ : IsNormUniformizer π)
    {n : ℕ} (hn : n * n = finrank K D) {x : D} (hx : x ≠ 0) :
    ∃ i : ℤ, divisionNorm K D x = (‖π‖ ^ ((n ! : ℝ)⁻¹)) ^ i := by
  have hp : 0 < ‖π‖ := hπ.norm_pos
  have hfac : (0 : ℝ) < (n ! : ℝ) := Nat.cast_pos.2 (Nat.factorial_pos n)
  set ρ : ℝ := ‖π‖ ^ ((n ! : ℝ)⁻¹) with hρdef
  have hρpos : 0 < ρ := Real.rpow_pos_of_pos hp _
  have hρpow : ρ ^ (n !) = ‖π‖ := by
    rw [hρdef, ← Real.rpow_natCast (‖π‖ ^ ((n ! : ℝ)⁻¹)) (n !), ← Real.rpow_mul hp.le,
      inv_mul_cancel₀ hfac.ne', Real.rpow_one]
  obtain ⟨m, c, hm0, hmn, hc0, hmc⟩ := exists_norm_eq_divisionNorm_pow K D hn hx
  obtain ⟨j, hj⟩ := hπ.exists_zpow hc0
  obtain ⟨s, hs⟩ : m ∣ n ! := Nat.dvd_factorial hm0 hmn
  refine ⟨j * s, ?_⟩
  have hpow : (ρ ^ (j * (s : ℤ))) ^ m = ‖c‖ := by
    rw [← zpow_natCast (ρ ^ (j * (s : ℤ))) m, ← zpow_mul, hj]
    have hexp : j * (s : ℤ) * (m : ℤ) = ((n ! : ℕ) : ℤ) * j := by
      rw [hs]; push_cast; ring
    rw [hexp, zpow_mul, zpow_natCast, hρpow]
  have := hmc.trans hpow.symm
  exact (pow_left_inj₀ (divisionNorm_nonneg x) (zpow_pos hρpos _).le hm0.ne' ).1 this

variable (K D) in
omit [IsUltrametricDist K] [CompleteSpace K] in
/-- **The absolute value of a division algebra over a complete discretely valued field has a
uniformizer.**  The absolute values of the nonzero elements are the integer powers of a fixed
number less than one, and the exponents that occur and are positive have a least element. -/
theorem exists_isNormUniformizer_divisionNorm [Algebra.IsCentral K D] {π : K}
    (hπ : IsNormUniformizer π) {n : ℕ} (hn : n * n = finrank K D) :
    ∃ ϖ : D, ϖ ≠ 0 ∧ divisionNorm K D ϖ < 1 ∧
      ∀ x : D, divisionNorm K D x < 1 → divisionNorm K D x ≤ divisionNorm K D ϖ := by
  have hp : 0 < ‖π‖ := hπ.norm_pos
  have hfac : (0 : ℝ) < (n ! : ℝ) := Nat.cast_pos.2 (Nat.factorial_pos n)
  set ρ : ℝ := ‖π‖ ^ ((n ! : ℝ)⁻¹) with hρdef
  have hρpos : 0 < ρ := Real.rpow_pos_of_pos hp _
  have hρ1 : ρ < 1 := Real.rpow_lt_one hp.le hπ.norm_lt_one (by positivity)
  have hρpow : ρ ^ (n !) = ‖π‖ := by
    rw [hρdef, ← Real.rpow_natCast (‖π‖ ^ ((n ! : ℝ)⁻¹)) (n !), ← Real.rpow_mul hp.le,
      inv_mul_cancel₀ hfac.ne', Real.rpow_one]
  set S : Set ℕ := {j | ∃ x : D, x ≠ 0 ∧ divisionNorm K D x = ρ ^ ((j : ℤ) + 1)} with hSdef
  have hfac1 : 1 ≤ n ! := Nat.one_le_iff_ne_zero.2 (Nat.factorial_ne_zero n)
  have hSne : S.Nonempty := by
    refine ⟨(n !) - 1, algebraMap K D π, ?_, ?_⟩
    · exact fun h => hπ.ne_zero ((algebraMap K D).injective (h.trans (map_zero _).symm))
    · have hcast : (((n !) - 1 : ℕ) : ℤ) + 1 = ((n ! : ℕ) : ℤ) := by omega
      rw [divisionNorm_algebraMap, hcast, zpow_natCast, hρpow]
  obtain ⟨ϖ, hϖ0, hϖ⟩ := Nat.sInf_mem hSne
  set j₀ : ℕ := sInf S with hj₀
  refine ⟨ϖ, hϖ0, ?_, ?_⟩
  · rw [hϖ]
    exact zpow_lt_one₀ hρpos hρ1 (by positivity)
  · intro x hx
    rcases eq_or_ne x 0 with rfl | hx0
    · rw [hϖ, divisionNorm_zero]
      exact (zpow_pos hρpos _).le
    · obtain ⟨i, hi⟩ := exists_divisionNorm_zpow K D hπ hn hx0
      rw [← hρdef] at hi
      rw [hi] at hx ⊢
      rw [hϖ]
      have hipos : 0 < i := by
        by_contra hcon
        push_neg at hcon
        have h1 : ρ ^ (0 : ℤ) ≤ ρ ^ i := zpow_le_zpow_right_of_le_one₀ hρpos hρ1.le hcon
        rw [zpow_zero] at h1
        exact absurd hx (not_lt.2 h1)
      have hmem : (i - 1).toNat ∈ S := by
        refine ⟨x, hx0, ?_⟩
        rw [hi]
        congr 1
        omega
      have hle : (j₀ : ℤ) + 1 ≤ i := by
        have := Nat.sInf_le hmem
        omega
      exact zpow_le_zpow_right_of_le_one₀ hρpos hρ1.le hle

end Discrete

/-! ### The subring of integers -/

section Integers

variable {K D : Type u} [NontriviallyNormedField K] [IsUltrametricDist K] [CompleteSpace K]
variable [DivisionRing D] [Algebra K D] [FiniteDimensional K D]

variable (K D) in
/-- The **integers** of a division algebra over a complete nonarchimedean field: the elements of
absolute value at most one. -/
noncomputable def divisionIntegers : Subring D where
  carrier := {x : D | divisionNorm K D x ≤ 1}
  zero_mem' := by
    show divisionNorm K D 0 ≤ 1
    rw [divisionNorm_zero]
    norm_num
  one_mem' := by
    show divisionNorm K D 1 ≤ 1
    rw [divisionNorm_one]
  add_mem' := fun {a b} ha hb =>
    le_trans (divisionNorm_isNonarchimedean a b) (max_le ha hb)
  neg_mem' := fun {a} ha => by
    show divisionNorm K D (-a) ≤ 1
    rwa [divisionNorm_neg]
  mul_mem' := fun {a b} ha hb => by
    show divisionNorm K D (a * b) ≤ 1
    rw [divisionNorm_mul]
    exact mul_le_one₀ ha (divisionNorm_nonneg _) hb

@[simp]
theorem mem_divisionIntegers {x : D} :
    x ∈ divisionIntegers K D ↔ divisionNorm K D x ≤ 1 := Iff.rfl

end Integers

end InverseGalois.CFT
