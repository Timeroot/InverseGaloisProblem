import Mathlib
import InverseGalois.CFT.Brauer.CrossedProductCohomologous
import InverseGalois.CFT.Brauer.CrossedProductSplit
import InverseGalois.CFT.Brauer.CrossedProductSplitting
import InverseGalois.CFT.GroupCohomology.Cyclic

/-!
# Cyclic algebras and the norm

Let `L / K` be a finite cyclic Galois extension with generator `σ₀` of `Gal(L/K)`, and let `a` be
a unit of `K`.  The *cyclic algebra* `(L / K, σ₀, a)` is the crossed product of `L / K` with the
`2`-cocycle attached to `σ₀` and `a`; concretely it is the `K`-algebra generated by `L` and a
symbol `u` subject to `u x = σ₀ x u` for `x ∈ L` and `u ^ [L : K] = a`.

This file identifies exactly when that algebra is trivial: the cyclic algebra is a matrix algebra
over `K` precisely when `a` is a norm from `L`.  This is the concrete face of the isomorphism
`Br(L / K) ≅ Kˣ / N(Lˣ)` for a cyclic extension, and it is the only case of the theory in which
the Brauer group can be computed by bare hands.

## Main results

* `InverseGalois.CFT.cyclicAlgebra`: the cyclic algebra of a generator and a unit.
* `InverseGalois.CFT.nonempty_algEquivMatrix_cyclicAlgebra_iff`: the cyclic algebra is a matrix
  algebra over `K` exactly when `a` is a norm from `L`.
* `InverseGalois.CFT.mk_cyclicAlgebra_eq_one_of_norm`: consequently its Brauer class is trivial
  whenever `a` is a norm.
* `InverseGalois.CFT.mk_cyclicAlgebra_mem_relative`: the class of a cyclic algebra is split by `L`.
* `InverseGalois.CFT.exists_generator_of_isCyclic`: a finite cyclic Galois group has a generator in
  the form the cyclic algebra construction consumes.
-/

universe u

open Module

namespace InverseGalois.CFT

open groupCohomology

variable {K L : Type u} [Field K] [Field L] [Algebra K L] [FiniteDimensional K L]

/-! ### The algebra -/

/-- The **cyclic algebra** `(L / K, σ₀, a)` attached to a generator `σ₀` of `Gal(L/K)` and a unit
`a` of `K`: the crossed product of `L / K` with the cocycle of `σ₀` and `a`. -/
noncomputable abbrev cyclicAlgebra {σ₀ : Gal(L/K)} (hσ₀ : ∀ x : Gal(L/K), x ∈ Subgroup.zpowers σ₀)
    (a : Kˣ) : Type u :=
  CrossedProduct (isMulCocycle₂_cyclicUnitCocycle hσ₀ a)

variable [IsGalois K L]

/-! ### Splitting the cyclic algebra -/

/-- **A cyclic algebra is split exactly when its unit is a norm.**  The algebra `(L / K, σ₀, a)`
is isomorphic to a matrix algebra over `K` if and only if `a` is the norm of a unit of `L`. -/
theorem nonempty_algEquivMatrix_cyclicAlgebra_iff {σ₀ : Gal(L/K)}
    (hσ₀ : ∀ x : Gal(L/K), x ∈ Subgroup.zpowers σ₀) (a : Kˣ) :
    Nonempty (cyclicAlgebra hσ₀ a ≃ₐ[K]
        Matrix (Fin (finrank K L)) (Fin (finrank K L)) K) ↔
      ∃ b : Lˣ, Algebra.norm K (b : L) = (a : K) := by
  refine ⟨fun ⟨e⟩ => ?_, fun hb => ?_⟩
  · exact (isMulCoboundary₂_cyclicUnitCocycle_iff hσ₀ a).mp
      (CrossedProduct.isMulCoboundary₂_of_algEquivMatrix e)
  · exact CrossedProduct.nonempty_algEquivMatrix_of_isMulCoboundary₂ _
      ((isMulCoboundary₂_cyclicUnitCocycle_iff hσ₀ a).mpr hb)

/-- If `a` is a norm from `L`, the Brauer class of the cyclic algebra `(L / K, σ₀, a)` is
trivial. -/
theorem mk_cyclicAlgebra_eq_one_of_norm {σ₀ : Gal(L/K)}
    (hσ₀ : ∀ x : Gal(L/K), x ∈ Subgroup.zpowers σ₀) {a : Kˣ}
    (hb : ∃ b : Lˣ, Algebra.norm K (b : L) = (a : K)) :
    (⟦CrossedProduct.csa (isMulCocycle₂_cyclicUnitCocycle hσ₀ a)⟧ : BrauerGroup K) = 1 := by
  obtain ⟨e⟩ := (nonempty_algEquivMatrix_cyclicAlgebra_iff hσ₀ a).mpr hb
  refine BrauerGroup.mk_eq_one_of_algEquiv_matrix ?_ e
  exact Module.finrank_pos.ne'

/-- The Brauer class of a cyclic algebra is split by `L`. -/
theorem mk_cyclicAlgebra_mem_relative {σ₀ : Gal(L/K)}
    (hσ₀ : ∀ x : Gal(L/K), x ∈ Subgroup.zpowers σ₀) (a : Kˣ) :
    (⟦CrossedProduct.csa (isMulCocycle₂_cyclicUnitCocycle hσ₀ a)⟧ : BrauerGroup K) ∈
      BrauerGroup.relative K L :=
  CrossedProduct.mk_csa_mem_relative _

/-! ### Producing a generator -/

omit [FiniteDimensional K L] [IsGalois K L] in
/-- A finite cyclic Galois group has a generator, in the form the cyclic algebra construction
consumes. -/
theorem exists_generator_of_isCyclic [IsCyclic Gal(L/K)] :
    ∃ σ₀ : Gal(L/K), ∀ x : Gal(L/K), x ∈ Subgroup.zpowers σ₀ := by
  obtain ⟨σ₀, hσ₀⟩ := IsCyclic.exists_generator (α := Gal(L/K))
  exact ⟨σ₀, hσ₀⟩

/-- **Every unit that is not a norm gives a nontrivial cyclic algebra.**  For a cyclic extension
`L / K` and a unit `a` of `K` that is not a norm from `L`, there is a central simple `K`-algebra
split by `L` which is not isomorphic to a matrix algebra over `K`. -/
theorem exists_mk_ne_one_of_not_norm [IsCyclic Gal(L/K)] {a : Kˣ}
    (ha : ¬ ∃ b : Lˣ, Algebra.norm K (b : L) = (a : K)) :
    ∃ A : CSA.{u, u} K, (⟦A⟧ : BrauerGroup K) ∈ BrauerGroup.relative K L ∧
      ¬ Nonempty ((A : Type u) ≃ₐ[K] Matrix (Fin (finrank K L)) (Fin (finrank K L)) K) := by
  obtain ⟨σ₀, hσ₀⟩ := exists_generator_of_isCyclic (K := K) (L := L)
  exact ⟨CrossedProduct.csa (isMulCocycle₂_cyclicUnitCocycle hσ₀ a),
    mk_cyclicAlgebra_mem_relative hσ₀ a,
    fun he => ha ((nonempty_algEquivMatrix_cyclicAlgebra_iff hσ₀ a).mp he)⟩

end InverseGalois.CFT
