import Mathlib
import InverseGalois.CFT.Brauer.RelativeIndex

/-!
# From the cyclic case to the solvable case for a relative Brauer group

The order of a relative Brauer group is multiplicative along a tower up to an inequality, so a
bound `|Br(E / F)| ≤ [E : F]` for *cyclic* extensions propagates to every extension whose Galois
group is solvable.  The propagation is a dévissage in two stages.  For an abelian group one splits
off the cyclic subgroup generated by a single nontrivial automorphism: the top step of the
resulting tower is cyclic, and the bottom step is abelian of smaller degree.  For a solvable group
one splits off the last nontrivial term of the derived series, which is an abelian normal subgroup:
the top step is then abelian and the bottom step is solvable of smaller degree.

The bound for the cyclic case is carried as a hypothesis, together with a class `P` of base fields
on which it is assumed and which is closed under finite extension — for local fields it is the
statement that the norm index of a cyclic extension is the degree.  This is the counting half of
the computation of the Brauer group of a local field.

## Main results

* `BrauerGroup.HasCyclicBrauerBound`: the hypothesis, that a cyclic extension of a field of the
  class has relative Brauer group finite of order at most the degree.
* `BrauerGroup.card_relative_le_finrank_of_commute`: **the bound for an abelian extension.**
* `BrauerGroup.card_relative_le_finrank_of_isSolvable`: **the bound for a solvable extension.**

## Tags

Brauer group, relative Brauer group, solvable, dévissage, tower, local class field theory
-/

universe u

open Module

namespace BrauerGroup

/-- A class of fields closed under finite extension. -/
def IsFiniteExtensionClosed (P : Type u → Prop) : Prop :=
  ∀ (F E : Type u) [Field F] [Field E] [Algebra F E], FiniteDimensional F E → P F → P E

/-- The relative Brauer group of a cyclic extension of a field of the class `P` is finite of order
at most the degree. -/
def HasCyclicBrauerBound (P : Type u → Prop) : Prop :=
  ∀ (F E : Type u) [Field F] [Field E] [Algebra F E] [FiniteDimensional F E] [IsGalois F E],
    P F → IsCyclic (E ≃ₐ[F] E) →
      Finite ↥(relative F E) ∧ Nat.card ↥(relative F E) ≤ finrank F E

variable {P : Type u → Prop}

/-- A nontrivial group whose derived series reaches the trivial subgroup has a nontrivial abelian
normal subgroup, namely the last nontrivial term of that series. -/
private theorem exists_abelian_normal (G : Type*) [Group G] [Nontrivial G] (m : ℕ)
    (hm : derivedSeries G m = ⊥) :
    ∃ D : Subgroup G, D.Normal ∧ D ≠ ⊥ ∧ ∀ x y : ↥D, x * y = y * x := by
  induction m with
  | zero =>
    obtain ⟨x, hx⟩ := exists_ne (1 : G)
    rw [derivedSeries_zero] at hm
    exact absurd (Subgroup.mem_bot.mp (hm ▸ Subgroup.mem_top x)) hx
  | succ m ih =>
    by_cases h : derivedSeries G m = ⊥
    · exact ih h
    · refine ⟨derivedSeries G m, derivedSeries_normal G m, h, fun x y => ?_⟩
      have hcomm : ⁅derivedSeries G m, derivedSeries G m⁆ = ⊥ := by
        rw [← derivedSeries_succ]
        exact hm
      have hle := Subgroup.commutator_eq_bot_iff_le_centralizer.mp hcomm
      exact Subtype.ext (Subgroup.mem_centralizer_iff.mp (hle x.2) y.1 y.2).symm

/-- The Galois group of a finite Galois extension is finite. -/
private theorem finite_aut (K L : Type u) [Field K] [Field L] [Algebra K L]
    [FiniteDimensional K L] [IsGalois K L] : Finite (L ≃ₐ[K] L) := inferInstance

/-- The degree of a finite Galois extension is positive. -/
private theorem finrank_pos_of_isGalois (K L : Type u) [Field K] [Field L] [Algebra K L]
    [FiniteDimensional K L] [IsGalois K L] : 0 < finrank K L := by
  rw [← IsGalois.card_aut_eq_finrank K L]
  haveI := finite_aut K L
  exact Nat.card_pos

/-- The dévissage of an abelian extension, by induction on a bound for the degree. -/
private theorem aux_commute (hclosed : IsFiniteExtensionClosed P) (hcyc : HasCyclicBrauerBound P)
    (n : ℕ) :
    ∀ (K L : Type u) [Field K] [Field L] [Algebra K L] [FiniteDimensional K L] [IsGalois K L],
      P K → (∀ x y : L ≃ₐ[K] L, x * y = y * x) → finrank K L ≤ n →
      Finite ↥(relative K L) ∧ Nat.card ↥(relative K L) ≤ finrank K L := by
  induction n with
  | zero =>
    intro K L _ _ _ _ _ _ _ hle
    have := finrank_pos_of_isGalois K L
    omega
  | succ n ih =>
    intro K L _ _ _ _ _ hK hab hle
    rcases subsingleton_or_nontrivial (L ≃ₐ[K] L) with hs | hs
    · haveI := hs
      exact hcyc K L hK inferInstance
    · obtain ⟨σ, hσ⟩ := exists_ne (1 : L ≃ₐ[K] L)
      haveI hnormal : (Subgroup.zpowers σ).Normal :=
        ⟨fun m hm g => by rwa [hab g m, mul_assoc, mul_inv_cancel, mul_one]⟩
      haveI := finite_aut K L
      have hCne : Subgroup.zpowers σ ≠ ⊥ := fun h =>
        hσ (Subgroup.mem_bot.mp (h ▸ Subgroup.mem_zpowers σ))
      have hCcard : 1 < Nat.card ↥(Subgroup.zpowers σ) :=
        Finite.one_lt_card_iff_nontrivial.mpr ((Subgroup.nontrivial_iff_ne_bot _).mpr hCne)
      have hfr : finrank ↥(IntermediateField.fixedField (Subgroup.zpowers σ)) L
          = Nat.card ↥(Subgroup.zpowers σ) :=
        IntermediateField.finrank_fixedField_eq_card _
      have hmul : finrank K ↥(IntermediateField.fixedField (Subgroup.zpowers σ))
          * finrank ↥(IntermediateField.fixedField (Subgroup.zpowers σ)) L = finrank K L :=
        Module.finrank_mul_finrank (F := K)
          (K := ↥(IntermediateField.fixedField (Subgroup.zpowers σ))) (A := L)
      have hL := finrank_pos_of_isGalois K L
      have hb : 2 ≤ finrank ↥(IntermediateField.fixedField (Subgroup.zpowers σ)) L := by
        omega
      have ha : 0 < finrank K ↥(IntermediateField.fixedField (Subgroup.zpowers σ)) := by
        rcases Nat.eq_zero_or_pos
          (finrank K ↥(IntermediateField.fixedField (Subgroup.zpowers σ))) with h | h
        · rw [h, zero_mul] at hmul
          omega
        · exact h
      have hlt : finrank K ↥(IntermediateField.fixedField (Subgroup.zpowers σ)) < finrank K L := by
        rw [← hmul]
        calc finrank K ↥(IntermediateField.fixedField (Subgroup.zpowers σ))
            < finrank K ↥(IntermediateField.fixedField (Subgroup.zpowers σ)) * 2 := by omega
          _ ≤ finrank K ↥(IntermediateField.fixedField (Subgroup.zpowers σ))
              * finrank ↥(IntermediateField.fixedField (Subgroup.zpowers σ)) L :=
            Nat.mul_le_mul (le_refl _) hb
      haveI : IsCyclic (L ≃ₐ[↥(IntermediateField.fixedField (Subgroup.zpowers σ))] L) :=
        isCyclic_of_surjective _
          (IntermediateField.subgroupEquivAlgEquiv (Subgroup.zpowers σ)).surjective
      obtain ⟨htopfin, htop⟩ :=
        hcyc ↥(IntermediateField.fixedField (Subgroup.zpowers σ)) L
          (hclosed K ↥(IntermediateField.fixedField (Subgroup.zpowers σ)) inferInstance hK)
          inferInstance
      haveI := htopfin
      have habQ : ∀ a b : (L ≃ₐ[K] L) ⧸ Subgroup.zpowers σ, a * b = b * a := by
        intro a b
        induction a using QuotientGroup.induction_on with | _ a =>
        induction b using QuotientGroup.induction_on with | _ b =>
        exact congrArg (QuotientGroup.mk (s := Subgroup.zpowers σ)) (hab a b)
      have habK' : ∀ x y : ↥(IntermediateField.fixedField (Subgroup.zpowers σ)) ≃ₐ[K]
          ↥(IntermediateField.fixedField (Subgroup.zpowers σ)), x * y = y * x := by
        intro x y
        obtain ⟨a, rfl⟩ :=
          (IsGalois.normalAutEquivQuotient (Subgroup.zpowers σ)).surjective x
        obtain ⟨b, rfl⟩ :=
          (IsGalois.normalAutEquivQuotient (Subgroup.zpowers σ)).surjective y
        rw [← map_mul, ← map_mul, habQ]
      obtain ⟨hbotfin, hbot⟩ :=
        ih K ↥(IntermediateField.fixedField (Subgroup.zpowers σ)) hK habK' (by omega)
      haveI := hbotfin
      refine ⟨finite_relative_of_tower K ↥(IntermediateField.fixedField (Subgroup.zpowers σ)) L,
        ?_⟩
      calc Nat.card ↥(relative K L)
          ≤ Nat.card ↥(relative K ↥(IntermediateField.fixedField (Subgroup.zpowers σ)))
            * Nat.card ↥(relative ↥(IntermediateField.fixedField (Subgroup.zpowers σ)) L) :=
            card_relative_le_mul K ↥(IntermediateField.fixedField (Subgroup.zpowers σ)) L
        _ ≤ finrank K ↥(IntermediateField.fixedField (Subgroup.zpowers σ))
            * finrank ↥(IntermediateField.fixedField (Subgroup.zpowers σ)) L :=
            Nat.mul_le_mul hbot htop
        _ = finrank K L := hmul

/-- **The relative Brauer group of an abelian extension is bounded by the degree**, as soon as it
is for cyclic ones. -/
theorem card_relative_le_finrank_of_commute (hclosed : IsFiniteExtensionClosed P)
    (hcyc : HasCyclicBrauerBound P) (K L : Type u) [Field K] [Field L] [Algebra K L]
    [FiniteDimensional K L] [IsGalois K L] (hK : P K)
    (hab : ∀ x y : L ≃ₐ[K] L, x * y = y * x) :
    Finite ↥(relative K L) ∧ Nat.card ↥(relative K L) ≤ finrank K L :=
  aux_commute hclosed hcyc (finrank K L) K L hK hab le_rfl

/-- The dévissage of a solvable extension, by induction on a bound for the degree. -/
private theorem aux_solvable (hclosed : IsFiniteExtensionClosed P) (hcyc : HasCyclicBrauerBound P)
    (n : ℕ) :
    ∀ (K L : Type u) [Field K] [Field L] [Algebra K L] [FiniteDimensional K L] [IsGalois K L],
      P K → IsSolvable (L ≃ₐ[K] L) → finrank K L ≤ n →
      Finite ↥(relative K L) ∧ Nat.card ↥(relative K L) ≤ finrank K L := by
  induction n with
  | zero =>
    intro K L _ _ _ _ _ _ _ hle
    have := finrank_pos_of_isGalois K L
    omega
  | succ n ih =>
    intro K L _ _ _ _ _ hK hsolv hle
    haveI := hsolv
    rcases subsingleton_or_nontrivial (L ≃ₐ[K] L) with hs | hs
    · haveI := hs
      exact hcyc K L hK inferInstance
    · obtain ⟨m, hm⟩ := hsolv.solvable
      obtain ⟨D, hDnormal, hDne, hDab⟩ := exists_abelian_normal (L ≃ₐ[K] L) m hm
      haveI := hDnormal
      haveI := finite_aut K L
      have hDcard : 1 < Nat.card ↥D :=
        Finite.one_lt_card_iff_nontrivial.mpr ((Subgroup.nontrivial_iff_ne_bot _).mpr hDne)
      have hfr : finrank ↥(IntermediateField.fixedField D) L = Nat.card ↥D :=
        IntermediateField.finrank_fixedField_eq_card _
      have hmul : finrank K ↥(IntermediateField.fixedField D)
          * finrank ↥(IntermediateField.fixedField D) L = finrank K L :=
        Module.finrank_mul_finrank (F := K) (K := ↥(IntermediateField.fixedField D)) (A := L)
      have hL := finrank_pos_of_isGalois K L
      have hb : 2 ≤ finrank ↥(IntermediateField.fixedField D) L := by omega
      have ha : 0 < finrank K ↥(IntermediateField.fixedField D) := by
        rcases Nat.eq_zero_or_pos (finrank K ↥(IntermediateField.fixedField D)) with h | h
        · rw [h, zero_mul] at hmul
          omega
        · exact h
      have hlt : finrank K ↥(IntermediateField.fixedField D) < finrank K L := by
        rw [← hmul]
        calc finrank K ↥(IntermediateField.fixedField D)
            < finrank K ↥(IntermediateField.fixedField D) * 2 := by omega
          _ ≤ finrank K ↥(IntermediateField.fixedField D)
              * finrank ↥(IntermediateField.fixedField D) L := Nat.mul_le_mul (le_refl _) hb
      have habTop : ∀ x y : L ≃ₐ[↥(IntermediateField.fixedField D)] L, x * y = y * x := by
        intro x y
        obtain ⟨a, rfl⟩ := (IntermediateField.subgroupEquivAlgEquiv D).surjective x
        obtain ⟨b, rfl⟩ := (IntermediateField.subgroupEquivAlgEquiv D).surjective y
        rw [← map_mul, ← map_mul, hDab]
      obtain ⟨htopfin, htop⟩ :=
        card_relative_le_finrank_of_commute hclosed hcyc
          ↥(IntermediateField.fixedField D) L
          (hclosed K ↥(IntermediateField.fixedField D) inferInstance hK) habTop
      haveI := htopfin
      have hsolvK' : IsSolvable
          (↥(IntermediateField.fixedField D) ≃ₐ[K] ↥(IntermediateField.fixedField D)) :=
        solvable_of_surjective (f := (IsGalois.normalAutEquivQuotient D).toMonoidHom)
          (IsGalois.normalAutEquivQuotient D).surjective
      obtain ⟨hbotfin, hbot⟩ :=
        ih K ↥(IntermediateField.fixedField D) hK hsolvK' (by omega)
      haveI := hbotfin
      refine ⟨finite_relative_of_tower K ↥(IntermediateField.fixedField D) L, ?_⟩
      calc Nat.card ↥(relative K L)
          ≤ Nat.card ↥(relative K ↥(IntermediateField.fixedField D))
            * Nat.card ↥(relative ↥(IntermediateField.fixedField D) L) :=
            card_relative_le_mul K ↥(IntermediateField.fixedField D) L
        _ ≤ finrank K ↥(IntermediateField.fixedField D)
            * finrank ↥(IntermediateField.fixedField D) L := Nat.mul_le_mul hbot htop
        _ = finrank K L := hmul

/-- **The relative Brauer group of a solvable extension is bounded by the degree**, as soon as it
is for cyclic ones. -/
theorem card_relative_le_finrank_of_isSolvable (hclosed : IsFiniteExtensionClosed P)
    (hcyc : HasCyclicBrauerBound P) (K L : Type u) [Field K] [Field L] [Algebra K L]
    [FiniteDimensional K L] [IsGalois K L] (hK : P K) (hsolv : IsSolvable (L ≃ₐ[K] L)) :
    Finite ↥(relative K L) ∧ Nat.card ↥(relative K L) ≤ finrank K L :=
  aux_solvable hclosed hcyc (finrank K L) K L hK hsolv le_rfl

end BrauerGroup
