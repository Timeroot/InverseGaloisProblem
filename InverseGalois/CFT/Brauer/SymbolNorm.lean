import Mathlib
import InverseGalois.CFT.Brauer.SymbolCyclicAlgebra
import InverseGalois.CFT.Profinite.KummerLevelDegree

/-!
# The power symbol of a unit against itself

The level of a unit carries the Kummer character of that unit scaled by the index, so the power
symbol of two units is trivial exactly when the first is a norm from the level of the second, for
*every* pair of units.

The level of a unit is generated by the chosen `n`-th root of the unit, and the degree of the level
kills the character, so that power of the root already lies in the base.  The minimal polynomial of
the root over the base is therefore the difference of a power of the variable and that base
element, and its constant coefficient computes the norm: the norm of the root is the base element
up to the sign of the degree.  Raising to the index recovers the unit itself, again up to a sign
that a root of unity of the base corrects when it is wrong.

So a unit is, up to the sign `(-1)^(n+1)`, always a norm from its own level, and the power symbol of
that corrected unit against the unit is trivial.  Bilinearity applied to a product then gives the
skew symmetry of the symbol.

## Main results

* `InverseGalois.CFT.kummerSymbolUnits_eq_one_iff_norm_kummerLevel`: **the power symbol of two units
  is trivial exactly when the first is a norm from the level of the second.**
* `InverseGalois.CFT.norm_kummerLevelGen`: **the norm of the chosen root of a unit is the base
  element it powers to, up to the sign of the degree of the level.**
* `InverseGalois.CFT.exists_norm_eq_neg_one_pow`: **every unit is a norm from its own level after
  the sign correction `(-1)^(n+1)`.**
* `InverseGalois.CFT.kummerSymbolUnits_mul_swap`: **the power symbol is skew symmetric.**

## Tags

Hilbert symbol, norm residue symbol, norm, minimal polynomial, Kummer theory, class field theory
-/

universe u

namespace InverseGalois.CFT

open groupCohomology IntermediateField Polynomial

section SymbolNorm

variable {k Ω : Type u} [Field k] [Field Ω] [Algebra k Ω] [IsGalois k Ω] {n : ℕ} [NeZero n]
  {ζ : k} {hζ : IsPrimitiveRoot ζ n}

attribute [local instance] zmodTrivialAction isSmoothAction_zmod

variable (h : IsKummerData k Ω (Multiplicative (ZMod n)) (zmodRootHom hζ) n)

attribute [local instance] finiteDimensional_kummerLevel isGalois_kummerLevel

/-! ### The norm criterion for an arbitrary pair of units -/

/-- **The power symbol of two units of the base is trivial exactly when the first unit is a norm
from the level of the second**, with no hypothesis on either unit. -/
theorem kummerSymbolUnits_eq_one_iff_norm_kummerLevel (a b : kˣ) :
    kummerSymbolUnits h (mulZMod n) a b = 1 ↔
      ∃ c : (↥(kummerLevel h b))ˣ, Algebra.norm k ((c : ↥(kummerLevel h b))) = (a : k) := by
  obtain ⟨σ₀, t, hgen, htpos, hmt, hvals⟩ := exists_generator_kummerLevel_index h b
  exact kummerSymbolUnits_eq_one_iff_exists_norm h (kummerLevel h b) hgen a b
    (carry_iff_of_index h htpos hmt hvals)

/-! ### The chosen root inside the level -/

variable (b : kˣ)

/-- The chosen `n`-th root of a unit, read in the level that it generates. -/
noncomputable def kummerLevelGen : ↥(kummerLevel h b) :=
  AdjoinSimple.gen k ((h.root b : Ωˣ) : Ω)

variable {b}

omit [IsGalois k Ω] in
/-- The chosen root of a unit, read in the level, is the chosen root. -/
theorem coe_kummerLevelGen (b : kˣ) :
    ((kummerLevelGen h b : ↥(kummerLevel h b)) : Ω) = ((h.root b : Ωˣ) : Ω) := rfl

omit [IsGalois k Ω] in
/-- The chosen root of a unit is not zero in the level of the unit. -/
theorem kummerLevelGen_ne_zero (b : kˣ) : kummerLevelGen h b ≠ 0 := by
  intro hzero
  refine (h.root b).ne_zero ?_
  have hc : ((kummerLevelGen h b : ↥(kummerLevel h b)) : Ω)
      = ((0 : ↥(kummerLevel h b)) : Ω) := by rw [hzero]
  rwa [coe_kummerLevelGen, ZeroMemClass.coe_zero] at hc

/-! ### The degree-th power of the root lies in the base -/

/-- The degree of the level of a unit kills the Kummer character of that unit, so the corresponding
power of the chosen root is fixed by every automorphism of the extension. -/
theorem smul_root_pow_card (b : kˣ) (g : Gal(Ω/k)) :
    g • h.root b ^ Nat.card Gal(↥(kummerLevel h b)/k)
      = h.root b ^ Nat.card Gal(↥(kummerLevel h b)/k) := by
  have hR : (((kummerChar h b g).val : ℕ) : ZMod n) = kummerChar h b g :=
    ZMod.natCast_rightInverse _
  have hdvd : n ∣ (kummerChar h b g).val * Nat.card Gal(↥(kummerLevel h b)/k) := by
    refine (ZMod.natCast_eq_zero_iff _ _).mp ?_
    rw [Nat.cast_mul, hR, mul_comm, ← nsmul_eq_mul]
    exact card_nsmul_kummerChar h b g
  rw [smul_pow', smul_root_eq_kummerRootUnit_pow, mul_pow, ← pow_mul,
    ((isPrimitiveRoot_kummerRootUnit Ω hζ).pow_eq_one_iff_dvd _).mpr hdvd, one_mul]

/-- Every automorphism of the extension fixes the degree-th power of the chosen root of a unit. -/
theorem apply_root_pow_card (b : kˣ) (g : Gal(Ω/k)) :
    g (((h.root b : Ωˣ) : Ω) ^ Nat.card Gal(↥(kummerLevel h b)/k))
      = ((h.root b : Ωˣ) : Ω) ^ Nat.card Gal(↥(kummerLevel h b)/k) := by
  have hu := congrArg Units.val (smul_root_pow_card h b g)
  have hcoe : ((g • h.root b ^ Nat.card Gal(↥(kummerLevel h b)/k) : Ωˣ) : Ω)
      = g (((h.root b ^ Nat.card Gal(↥(kummerLevel h b)/k) : Ωˣ)) : Ω) := rfl
  rw [hcoe, Units.val_pow_eq_pow_val] at hu
  exact hu

/-- **The degree-th power of the chosen root of a unit lies in the base.** -/
theorem exists_algebraMap_eq_pow_card (b : kˣ) :
    ∃ c : k, algebraMap k ↥(kummerLevel h b) c
      = kummerLevelGen h b ^ Nat.card Gal(↥(kummerLevel h b)/k) := by
  have hfix : ∀ σ : Gal(↥(kummerLevel h b)/k),
      σ (kummerLevelGen h b ^ Nat.card Gal(↥(kummerLevel h b)/k))
        = kummerLevelGen h b ^ Nat.card Gal(↥(kummerLevel h b)/k) := by
    intro σ
    obtain ⟨g, rfl⟩ := restrictNormalHom_surjective_level (kummerLevel h b) σ
    refine Subtype.ext ?_
    rw [AlgEquiv.restrictNormalHom_apply, SubmonoidClass.coe_pow, coe_kummerLevelGen]
    exact apply_root_pow_card h b g
  exact (IsGalois.mem_range_algebraMap_iff_fixed _).mpr hfix

/-! ### The minimal polynomial and the norm of the root -/

/-- **The norm of the chosen root of a unit, from the level of that unit**, is the base element it
powers to, up to the sign of the degree of the level. -/
theorem norm_kummerLevelGen (b : kˣ) {c : k}
    (hc : algebraMap k ↥(kummerLevel h b) c
      = kummerLevelGen h b ^ Nat.card Gal(↥(kummerLevel h b)/k)) :
    Algebra.norm k (kummerLevelGen h b)
      = (-1) ^ (Nat.card Gal(↥(kummerLevel h b)/k) + 1) * c := by
  have hm0 : Nat.card Gal(↥(kummerLevel h b)/k) ≠ 0 := Nat.card_pos.ne'
  have hint : IsIntegral k ((h.root b : Ωˣ) : Ω) := isIntegral_kummerRoot h b
  have hgenint : IsIntegral k (kummerLevelGen h b) := IsIntegral.of_finite k _
  have hmg : minpoly k (kummerLevelGen h b) = minpoly k ((h.root b : Ωˣ) : Ω) :=
    IntermediateField.minpoly_gen k ((h.root b : Ωˣ) : Ω)
  have hdeg : (minpoly k (kummerLevelGen h b)).natDegree
      = Nat.card Gal(↥(kummerLevel h b)/k) := by
    rw [hmg, ← IntermediateField.adjoin.finrank hint]
    exact (IsGalois.card_aut_eq_finrank k ↥(kummerLevel h b)).symm
  have hmonic : (X ^ Nat.card Gal(↥(kummerLevel h b)/k) - C c : k[X]).Monic :=
    monic_X_pow_sub_C c hm0
  have hminpoly : minpoly k (kummerLevelGen h b)
      = X ^ Nat.card Gal(↥(kummerLevel h b)/k) - C c := by
    refine Polynomial.eq_of_dvd_of_natDegree_le_of_leadingCoeff (minpoly.dvd k _ ?_) ?_ ?_
    · rw [map_sub, map_pow, aeval_X, aeval_C, hc, sub_self]
    · exact le_of_eq (by rw [natDegree_X_pow_sub_C, hdeg])
    · rw [(minpoly.monic hgenint).leadingCoeff, hmonic.leadingCoeff]
  have hpb : (IntermediateField.adjoin.powerBasis hint).gen = kummerLevelGen h b :=
    IntermediateField.adjoin.powerBasis_gen hint
  have hpbdim : (IntermediateField.adjoin.powerBasis hint).dim
      = Nat.card Gal(↥(kummerLevel h b)/k) := by
    rw [IntermediateField.adjoin.powerBasis_dim, ← hmg, hdeg]
  have hnorm := Algebra.PowerBasis.norm_gen_eq_coeff_zero_minpoly
    (IntermediateField.adjoin.powerBasis hint)
  rw [hpb, hpbdim, hminpoly] at hnorm
  have hgoal : Algebra.norm k (kummerLevelGen h b)
      = (-1) ^ Nat.card Gal(↥(kummerLevel h b)/k)
        * (X ^ Nat.card Gal(↥(kummerLevel h b)/k) - C c : k[X]).coeff 0 := hnorm
  rw [hgoal, coeff_sub, coeff_X_pow, if_neg hm0.symm, coeff_C_zero, pow_succ]
  ring

/-! ### Every unit is a norm from its own level, up to sign -/

/-- **Every unit of the base is, after the sign correction `(-1)^(n+1)`, the norm of an element of
the level of that unit.** -/
theorem exists_norm_eq_neg_one_pow (b : kˣ) :
    ∃ w : ↥(kummerLevel h b), w ≠ 0 ∧ Algebra.norm k w = (-1) ^ (n + 1) * (b : k) := by
  obtain ⟨c, hc⟩ := exists_algebraMap_eq_pow_card h b
  obtain ⟨t, hmt⟩ := card_gal_kummerLevel_dvd h b
  have hn0 : n ≠ 0 := NeZero.ne n
  have htpos : 0 < t := Nat.pos_of_ne_zero fun ht0 => hn0 (by rw [hmt, ht0, Nat.mul_zero])
  have hct : c ^ t = (b : k) := by
    refine (algebraMap k ↥(kummerLevel h b)).injective ?_
    rw [map_pow, hc, ← pow_mul, ← hmt]
    refine (algebraMap ↥(kummerLevel h b) Ω).injective ?_
    rw [map_pow, ← IsScalarTower.algebraMap_apply]
    exact congrArg Units.val (h.root_pow b)
  have hnormt : Algebra.norm k (kummerLevelGen h b ^ t) = (-1) ^ (n + t) * (b : k) := by
    rw [map_pow, norm_kummerLevelGen h b hc, mul_pow, ← pow_mul, hct, Nat.add_mul, one_mul, ← hmt]
  have hne : kummerLevelGen h b ^ t ≠ 0 := pow_ne_zero _ (kummerLevelGen_ne_zero h b)
  rcases Nat.even_or_odd t with hte | hto
  · obtain ⟨s, hs⟩ := hte
    have hteven : Even t := ⟨s, hs⟩
    have hmpos : 0 < Nat.card Gal(↥(kummerLevel h b)/k) := Nat.card_pos
    have hspos : 0 < s := by omega
    have hdpos : 0 < s * Nat.card Gal(↥(kummerLevel h b)/k) := Nat.mul_pos hspos hmpos
    have hn2d : n = 2 * (s * Nat.card Gal(↥(kummerLevel h b)/k)) :=
      hmt.trans (by rw [hs]; ring)
    have hdvd : s * Nat.card Gal(↥(kummerLevel h b)/k) ∣ n :=
      ⟨2, hn2d.trans (Nat.mul_comm 2 _)⟩
    have hdivn : n / (s * Nat.card Gal(↥(kummerLevel h b)/k)) = 2 := by
      have h2 : 2 * (s * Nat.card Gal(↥(kummerLevel h b)/k))
          / (s * Nat.card Gal(↥(kummerLevel h b)/k)) = 2 := Nat.mul_div_cancel 2 hdpos
      rwa [← hn2d] at h2
    have hroot : IsPrimitiveRoot (ζ ^ (s * Nat.card Gal(↥(kummerLevel h b)/k))) 2 := by
      have hp := hζ.pow_of_dvd hdpos.ne' hdvd
      rwa [hdivn] at hp
    have hneg : ζ ^ (s * Nat.card Gal(↥(kummerLevel h b)/k)) = -1 :=
      hroot.eq_neg_one_of_two_right
    refine ⟨kummerLevelGen h b ^ t * algebraMap k ↥(kummerLevel h b) (ζ ^ s), ?_, ?_⟩
    · refine mul_ne_zero hne ?_
      simp only [ne_eq, map_eq_zero]
      exact pow_ne_zero s (hζ.ne_zero hn0)
    · rw [map_mul, hnormt, Algebra.norm_algebraMap,
        ← IsGalois.card_aut_eq_finrank k ↥(kummerLevel h b), ← pow_mul, hneg, pow_add, pow_add,
        hteven.neg_one_pow, pow_one]
      ring
  · refine ⟨kummerLevelGen h b ^ t, hne, ?_⟩
    rw [hnormt, pow_add, pow_add, hto.neg_one_pow, pow_one]

/-! ### The symbol of a unit against itself, and skew symmetry -/

/-- **The power symbol of a unit against itself is trivial after the sign correction.** -/
theorem kummerSymbolUnits_neg_one_pow_self (b : kˣ) :
    kummerSymbolUnits h (mulZMod n) ((-1) ^ (n + 1) * b) b = 1 := by
  obtain ⟨w, hw, hnw⟩ := exists_norm_eq_neg_one_pow h b
  refine (kummerSymbolUnits_eq_one_iff_norm_kummerLevel h _ b).mpr ⟨Units.mk0 w hw, ?_⟩
  have hval : ((((-1 : kˣ) ^ (n + 1) * b) : kˣ) : k) = (-1 : k) ^ (n + 1) * (b : k) := by
    simp only [Units.val_mul, Units.val_pow_eq_pow_val, Units.val_neg, Units.val_one]
  rw [hval]
  exact hnw

/-- A commutative group rearrangement: the two cross terms of a symmetric product cancel. -/
private theorem mul_swap_aux {G : Type*} [CommGroup G] {A B C D E F : G} (h1 : A * C = 1)
    (h2 : B * F = 1) (h3 : A * B * (C * E * (D * F)) = 1) : D * E = 1 := by
  have hrw : A * C * (B * F) * (D * E) = A * B * (C * E * (D * F)) := by
    simp only [mul_comm, mul_left_comm]
  rw [h1, h2, one_mul, one_mul] at hrw
  exact hrw.trans h3

/-- **The power symbol is skew symmetric**: the symbol of two units times the symbol of the same
two units in the other order is trivial. -/
theorem kummerSymbolUnits_mul_swap (a b : kˣ) :
    kummerSymbolUnits h (mulZMod n) a b * kummerSymbolUnits h (mulZMod n) b a = 1 := by
  have hleft : ∀ x y z : kˣ, kummerSymbolUnits h (mulZMod n) (x * y) z
      = kummerSymbolUnits h (mulZMod n) x z * kummerSymbolUnits h (mulZMod n) y z :=
    fun x y z => by rw [map_mul, MonoidHom.mul_apply]
  have hright : ∀ x y z : kˣ, kummerSymbolUnits h (mulZMod n) x (y * z)
      = kummerSymbolUnits h (mulZMod n) x y * kummerSymbolUnits h (mulZMod n) x z :=
    fun x y z => map_mul _ y z
  have ha := kummerSymbolUnits_neg_one_pow_self h a
  have hb := kummerSymbolUnits_neg_one_pow_self h b
  have hab := kummerSymbolUnits_neg_one_pow_self h (a * b)
  rw [hleft] at ha hb
  rw [hleft, hright, hright, hleft, hleft] at hab
  exact mul_swap_aux ha hb hab

end SymbolNorm

end InverseGalois.CFT
