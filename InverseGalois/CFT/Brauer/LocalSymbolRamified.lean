import Mathlib
import InverseGalois.CFT.Brauer.TameValue

/-!
# The norm residue symbol against a ramified level

The norm residue symbol of a local field is the invariant of the power symbol, and the power symbol
of two units is the inverse of the class of the cyclic algebra of the first unit over any cyclic
level carrying the Kummer character of the second.  Applying the invariant map of the whole Brauer
group therefore computes the symbol as the inverse of the invariant of that cyclic algebra, with no
hypothesis on the level beyond cyclicity: in particular the level may be ramified.

This complements the unramified statement, which routes through the normalised invariant of an
unramified extension and so cannot see a ramified level.  The level of a unit whose Kummer character
is onto is cyclic of degree the exponent and its discrete logarithm computes the character, so the
carry condition is automatic there.

## Main results

* `InverseGalois.CFT.localKummerSymbol_eq_inv_localInvariantHom`: **the norm residue symbol of two
  units is the inverse of the invariant of the cyclic algebra of the first over any cyclic level
  carrying the Kummer character of the second.**
* `InverseGalois.CFT.localInvariantHom_cyclicBrauerHom_eq_inv_localKummerSymbol`: the same relation
  read as a formula for the invariant of a cyclic algebra.
* `InverseGalois.CFT.localSymbol_eq_inv_localInvariantHom`: **the power residue symbol of two units
  is the inverse of the invariant of the cyclic algebra of the first over the level of the second**,
  for the level generated by an automorphism whose Kummer character is one.

## Tags

norm residue symbol, Hilbert symbol, power residue symbol, cyclic algebra, Brauer group,
ramified extension, Kummer theory, class field theory
-/

namespace InverseGalois.CFT

open scoped Valued WithZero

/-! ### An arbitrary cyclic level -/

section Level

variable {K : Type} [Field K] [Valued K ℤᵐ⁰]
  [Valuation.RankOne (Valued.v : Valuation K ℤᵐ⁰)] [CompleteSpace K] [ProperSpace K]
  [PerfectField K] {m : ℤ} {p e : ℕ} {n : ℕ} [NeZero n] {ζ : K} {hζ : IsPrimitiveRoot ζ n}

attribute [local instance] zmodTrivialAction isSmoothAction_zmod

variable (h : IsKummerData K (AlgebraicClosure K) (Multiplicative (ZMod n)) (zmodRootHom hζ) n)
  (E : IntermediateField K (AlgebraicClosure K)) [FiniteDimensional K ↥E] [IsGalois K ↥E]
  {σ₀ : Gal(↥E/K)}

/-- **The norm residue symbol of two units is the inverse of the invariant of the cyclic algebra of
the first unit over a cyclic level carrying the Kummer character of the second.**  Nothing is asked
of the level beyond cyclicity, so it may be ramified. -/
theorem localKummerSymbol_eq_inv_localInvariantHom (hres : HasResidueChar K p e)
    (hm : IsUnitValGen K m) (hσ₀ : ∀ x : Gal(↥E/K), x ∈ Subgroup.zpowers σ₀) (a b : Kˣ)
    (hcarry : ∀ g g' : Gal(AlgebraicClosure K/K),
      (dlog σ₀ (AlgEquiv.restrictNormalHom ↥E g)).val
          + (dlog σ₀ (AlgEquiv.restrictNormalHom ↥E g')).val < Nat.card Gal(↥E/K) ↔
        (kummerChar h b g).val + (kummerChar h b g').val < n) :
    localKummerSymbol hres hm h (mulZMod n) a b
      = (localInvariantHom K hm (cyclicBrauerHom hσ₀ a))⁻¹ := by
  have hbr : smoothBrauer (kummerSymbolUnits h (mulZMod n) a b) = (cyclicBrauerHom hσ₀ a)⁻¹ :=
    smoothBrauerHom_kummerSymbolUnits h E hσ₀ a b hcarry
  rw [localKummerSymbol_apply, smoothLocalInvariantEquiv_apply, hbr, map_inv]

/-- **The invariant of a cyclic algebra is the inverse of the norm residue symbol of its
coefficient against a unit whose Kummer character the level carries.** -/
theorem localInvariantHom_cyclicBrauerHom_eq_inv_localKummerSymbol (hres : HasResidueChar K p e)
    (hm : IsUnitValGen K m) (hσ₀ : ∀ x : Gal(↥E/K), x ∈ Subgroup.zpowers σ₀) (a b : Kˣ)
    (hcarry : ∀ g g' : Gal(AlgebraicClosure K/K),
      (dlog σ₀ (AlgEquiv.restrictNormalHom ↥E g)).val
          + (dlog σ₀ (AlgEquiv.restrictNormalHom ↥E g')).val < Nat.card Gal(↥E/K) ↔
        (kummerChar h b g).val + (kummerChar h b g').val < n) :
    localInvariantHom K hm (cyclicBrauerHom hσ₀ a)
      = (localKummerSymbol hres hm h (mulZMod n) a b)⁻¹ := by
  rw [localKummerSymbol_eq_inv_localInvariantHom h E hres hm hσ₀ a b hcarry, inv_inv]

end Level

/-! ### The level of a unit -/

section KummerLevel

variable {K : Type} [Field K] [Valued K ℤᵐ⁰]
  [Valuation.RankOne (Valued.v : Valuation K ℤᵐ⁰)] [CompleteSpace K] [ProperSpace K]
  [PerfectField K] {m : ℤ} {p e : ℕ} {n : ℕ} [NeZero n] {ζ : K} {hζ : IsPrimitiveRoot ζ n}

attribute [local instance] zmodTrivialAction isSmoothAction_zmod

variable (h : IsKummerData K (AlgebraicClosure K) (Multiplicative (ZMod n)) (zmodRootHom hζ) n)

attribute [local instance] finiteDimensional_kummerLevel isGalois_kummerLevel

/-- **The invariant of a cyclic algebra over the level of a unit is the inverse of the norm residue
symbol of its coefficient against that unit**, for a generator of the level whose discrete logarithm
computes the Kummer character. -/
theorem localInvariantHom_cyclicBrauerHom_kummerLevel (hres : HasResidueChar K p e)
    (hm : IsUnitValGen K m) {b : Kˣ} {σ₀ : Gal(↥(kummerLevel h b)/K)}
    (hσ₀ : ∀ x : Gal(↥(kummerLevel h b)/K), x ∈ Subgroup.zpowers σ₀)
    (hcard : Nat.card Gal(↥(kummerLevel h b)/K) = n)
    (hdlog : ∀ g : Gal(AlgebraicClosure K/K),
      (dlog σ₀ (AlgEquiv.restrictNormalHom ↥(kummerLevel h b) g)).val = (kummerChar h b g).val)
    (a : Kˣ) :
    localInvariantHom K hm (cyclicBrauerHom hσ₀ a)
      = (localKummerSymbol hres hm h (mulZMod n) a b)⁻¹ :=
  localInvariantHom_cyclicBrauerHom_eq_inv_localKummerSymbol h (kummerLevel h b) hres hm hσ₀ a b
    (carry_iff_of_dlog_eq h (kummerLevel h b) hcard hdlog)

end KummerLevel

/-! ### The level attached to a primitive root of unity -/

section Root

variable {K : Type} [Field K] [Valued K ℤᵐ⁰]
  [Valuation.RankOne (Valued.v : Valuation K ℤᵐ⁰)] [CompleteSpace K] [ProperSpace K]
  [PerfectField K] {m : ℤ} {p e : ℕ} {n : ℕ} [NeZero n] {ζ : K}

attribute [local instance] zmodTrivialAction isSmoothAction_zmod

attribute [local instance] finiteDimensional_kummerLevel isGalois_kummerLevel

/-- **The power residue symbol of two units is the inverse of the invariant of the cyclic algebra
of the first over the level of the second**, for a generator of the level whose discrete logarithm
computes the Kummer character. -/
theorem localSymbol_eq_inv_localInvariantHom (hres : HasResidueChar K p e) (hm : IsUnitValGen K m)
    (hζ : IsPrimitiveRoot ζ n) {b : Kˣ}
    {σ₀ : Gal(↥(kummerLevel (isKummerData_zmod (Ω := AlgebraicClosure K) hζ
      exists_units_pow_eq) b)/K)}
    (hσ₀ : ∀ x : Gal(↥(kummerLevel (isKummerData_zmod (Ω := AlgebraicClosure K) hζ
      exists_units_pow_eq) b)/K), x ∈ Subgroup.zpowers σ₀)
    (hcard : Nat.card Gal(↥(kummerLevel (isKummerData_zmod (Ω := AlgebraicClosure K) hζ
      exists_units_pow_eq) b)/K) = n)
    (hdlog : ∀ g : Gal(AlgebraicClosure K/K),
      (dlog σ₀ (AlgEquiv.restrictNormalHom ↥(kummerLevel
          (isKummerData_zmod (Ω := AlgebraicClosure K) hζ exists_units_pow_eq) b) g)).val
        = (kummerChar (isKummerData_zmod (Ω := AlgebraicClosure K) hζ exists_units_pow_eq)
            b g).val)
    (a : Kˣ) :
    localSymbol hres hm hζ a b = (localInvariantHom K hm (cyclicBrauerHom hσ₀ a))⁻¹ := by
  rw [localInvariantHom_cyclicBrauerHom_kummerLevel
    (isKummerData_zmod (Ω := AlgebraicClosure K) hζ exists_units_pow_eq) hres hm hσ₀ hcard hdlog a,
    inv_inv]
  rfl

end Root

end InverseGalois.CFT
