import Mathlib
import InverseGalois.CFT.Brauer.CyclicBaseChange
import InverseGalois.CFT.Brauer.CyclicCompositum
import InverseGalois.CFT.Brauer.InfiniteInvariant
import InverseGalois.CFT.Brauer.InfinitePlaceCrossedProduct
import InverseGalois.CFT.Brauer.PlaceCyclic

/-!
# Localising a cyclic algebra at an infinite place

Let `K / k` be a cyclic Galois extension of number fields with generator `σ₀`, and let `w` be an
infinite place of `K`.  Completing at the place of `k` below `w` turns the cyclic algebra
`(K / k, σ₀, a)` into a central simple algebra over the completion, and that algebra is again
cyclic, for the decomposition group at `w`, with the same coefficient `a`.

This is the archimedean mirror of the computation at a finite place, and it runs through the same
two steps.  Over the decomposition field the extension is cyclic with a generator inducing the
power of `σ₀` by the index of the decomposition group, and the cyclic cocycle restricts to the
cyclic cocycle with the same coefficient; from the decomposition field to the completion of the
base the identification of the automorphism group of the completions with the Galois group over the
decomposition field transports the cyclic cocycle again without touching the coefficient.

Reading the conclusion through the invariant gives the archimedean half of the local criterion: the
invariant at an infinite place of a cyclic algebra vanishes exactly when the coefficient is a norm
from the completion of the splitting field there.

## Main results

* `InverseGalois.CFT.exists_forall_mem_zpowers_restrictScalars_eq_infinite`: **the completion of a
  cyclic extension at an infinite place has a generator inducing the power of the global generator
  by the index of the decomposition group.**
* `InverseGalois.CFT.baseChangeHom_cyclicBrauerHom_infiniteCompletion`: **extending scalars to the
  completion at an infinite place sends a cyclic algebra to the cyclic algebra of the decomposition
  group with the same coefficient.**
* `InverseGalois.CFT.infinitePlaceInvariant_cyclicBrauerHom_eq_one_iff`: **the invariant at an
  infinite place of a cyclic algebra vanishes exactly when its coefficient is a local norm there.**

## Tags

Brauer group, cyclic algebra, infinite place, completion, decomposition group, local invariant,
local norm, class field theory
-/

set_option synthInstance.maxHeartbeats 1000000

namespace InverseGalois.CFT

open MulAction NumberField

section InfiniteCyclic

attribute [local instance] isGalois_infiniteCompletion

variable {k K : Type} [Field k] [NumberField k] [Field K] [NumberField K] [Algebra k K]
  [IsGalois k K] (w : InfinitePlace K)

variable (k) in
/-- **The completion of a cyclic extension at an infinite place has a generator inducing the power
of the global generator by the index of the decomposition group.**  The decomposition group is a
subgroup of a finite cyclic group, hence is generated by that power, and the automorphism group of
the completions is the decomposition group. -/
theorem exists_forall_mem_zpowers_restrictScalars_eq_infinite {σ₀ : Gal(K/k)}
    (hσ₀ : ∀ x : Gal(K/k), x ∈ Subgroup.zpowers σ₀) :
    ∃ σ : w.Completion ≃ₐ[(w.comap (algebraMap k K)).Completion] w.Completion,
      (∀ x : w.Completion ≃ₐ[(w.comap (algebraMap k K)).Completion] w.Completion,
          x ∈ Subgroup.zpowers σ) ∧
        (localInfiniteDecompositionEquiv k w σ).restrictScalars k
          = σ₀ ^ (stabilizer Gal(K/k) w).index := by
  have hcard : Nat.card Gal(K/k)
      = (stabilizer Gal(K/k) w).index * Nat.card ↥(stabilizer Gal(K/k) w) :=
    (Subgroup.index_mul_card _).symm
  have hstab : stabilizer Gal(K/k) w = Subgroup.zpowers (σ₀ ^ (stabilizer Gal(K/k) w).index) :=
    subgroup_eq_zpowers_pow hσ₀ _ hcard
  have hmem : σ₀ ^ (stabilizer Gal(K/k) w).index ∈ stabilizer Gal(K/k) w :=
    hstab.ge (Subgroup.mem_zpowers _)
  have hgH : ∀ y : ↥(stabilizer Gal(K/k) w),
      y ∈ Subgroup.zpowers (⟨σ₀ ^ (stabilizer Gal(K/k) w).index, hmem⟩ :
        ↥(stabilizer Gal(K/k) w)) := by
    intro y
    obtain ⟨j, hj⟩ := Subgroup.mem_zpowers_iff.mp (hstab.le y.2)
    exact Subgroup.mem_zpowers_iff.mpr
      ⟨j, Subtype.ext (by rw [SubgroupClass.coe_zpow]; exact hj)⟩
  refine ⟨(localInfiniteDecompositionEquiv k w).symm (infiniteDecompositionFieldEquiv k w
    ⟨σ₀ ^ (stabilizer Gal(K/k) w).index, hmem⟩), ?_, ?_⟩
  · exact forall_mem_zpowers_mulEquiv (localInfiniteDecompositionEquiv k w).symm
      (forall_mem_zpowers_mulEquiv (infiniteDecompositionFieldEquiv k w) hgH)
  · rw [MulEquiv.apply_symm_apply]
    exact AlgEquiv.ext fun x => infiniteDecompositionFieldEquiv_apply k w _ x

variable (k) in
/-- **Extending scalars to the completion at an infinite place sends a cyclic algebra to the cyclic
algebra of the decomposition group with the same coefficient.**  The base change factors through
the decomposition field, over which the extension is cyclic with a generator inducing a power of
the given one, and neither step changes the coefficient. -/
theorem baseChangeHom_cyclicBrauerHom_infiniteCompletion {σ₀ : Gal(K/k)}
    (hσ₀ : ∀ x : Gal(K/k), x ∈ Subgroup.zpowers σ₀)
    {σ : w.Completion ≃ₐ[(w.comap (algebraMap k K)).Completion] w.Completion}
    (hσ : ∀ x : w.Completion ≃ₐ[(w.comap (algebraMap k K)).Completion] w.Completion,
      x ∈ Subgroup.zpowers σ)
    (hres : (localInfiniteDecompositionEquiv k w σ).restrictScalars k
      = σ₀ ^ (stabilizer Gal(K/k) w).index) (a : kˣ) :
    BrauerGroup.baseChangeHom (w.comap (algebraMap k K)).Completion (cyclicBrauerHom hσ₀ a)
      = cyclicBrauerHom hσ
        (Units.map (algebraMap k (w.comap (algebraMap k K)).Completion).toMonoidHom a) := by
  have hσ₁ : ∀ x : Gal(K/↥(infiniteDecompositionField k w)),
      x ∈ Subgroup.zpowers (localInfiniteDecompositionEquiv k w σ) :=
    forall_mem_zpowers_mulEquiv (localInfiniteDecompositionEquiv k w) hσ
  have hcard : Nat.card Gal(K/k)
      = (stabilizer Gal(K/k) w).index
        * Nat.card Gal(K/↥(infiniteDecompositionField k w)) := by
    rw [← Nat.card_congr (infiniteDecompositionFieldEquiv k w).toEquiv]
    exact (Subgroup.index_mul_card _).symm
  have hmap : Units.map
        (algebraMap ↥(infiniteDecompositionField k w)
          (w.comap (algebraMap k K)).Completion).toMonoidHom
        (Units.map (algebraMap k ↥(infiniteDecompositionField k w)).toMonoidHom a)
      = Units.map (algebraMap k (w.comap (algebraMap k K)).Completion).toMonoidHom a := by
    ext
    exact (IsScalarTower.algebraMap_apply k ↥(infiniteDecompositionField k w)
      (w.comap (algebraMap k K)).Completion (a : k)).symm
  rw [← BrauerGroup.baseChangeHom_comp k ↥(infiniteDecompositionField k w)
      (w.comap (algebraMap k K)).Completion, MonoidHom.coe_comp, Function.comp_apply,
    baseChangeHom_cyclicBrauerHom ↥(infiniteDecompositionField k w) hσ₀ hσ₁ hres hcard a,
    baseChangeHom_cyclicBrauerHom_compositum hσ₁ hσ rfl
      (algebraMap_localInfiniteDecompositionEquiv k w), hmap]

variable (k) in
/-- **The invariant at an infinite place of a cyclic algebra vanishes exactly when its coefficient
is a norm from the completion of the splitting field there.**  Base change to the completion turns
the cyclic algebra into the cyclic algebra of the decomposition group with the same coefficient,
and the Brauer class of a cyclic algebra is trivial exactly when its coefficient is a norm. -/
theorem infinitePlaceInvariant_cyclicBrauerHom_eq_one_iff {σ₀ : Gal(K/k)}
    (hσ₀ : ∀ x : Gal(K/k), x ∈ Subgroup.zpowers σ₀) (a : kˣ) :
    infinitePlaceInvariant k (w.comap (algebraMap k K)) (cyclicBrauerHom hσ₀ a) = 1 ↔
      ∃ b : (w.Completion)ˣ,
        Algebra.norm (w.comap (algebraMap k K)).Completion (b : w.Completion)
          = algebraMap k (w.comap (algebraMap k K)).Completion (a : k) := by
  obtain ⟨σ, hσ, hres⟩ := exists_forall_mem_zpowers_restrictScalars_eq_infinite k w hσ₀
  rw [infinitePlaceInvariant_eq_one_iff, BrauerGroup.relative, MonoidHom.mem_ker,
    baseChangeHom_cyclicBrauerHom_infiniteCompletion k w hσ₀ hσ hres a, ← MonoidHom.mem_ker,
    mem_ker_cyclicBrauerHom_iff hσ]
  rfl

end InfiniteCyclic

end InverseGalois.CFT
