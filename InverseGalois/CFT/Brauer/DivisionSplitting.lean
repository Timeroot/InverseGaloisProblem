import Mathlib
import InverseGalois.CFT.Brauer.DivisionMaximal
import InverseGalois.CFT.Brauer.MaximalSubfield

/-!
# A division algebra over a local field is split by a subfield carrying no new absolute values

A finite-dimensional central division algebra over a field has a subalgebra equal to its own
centralizer, and such a subalgebra is a field whose degree squared is the dimension of the algebra.
So the dimension is a square, say `n * n`, and a subfield of degree `n` is again its own
centralizer, hence splits the algebra: extending scalars to it turns the algebra into a matrix
algebra.

Over a nonarchimedean local field the subfield produced by the residue argument has exactly the
degree `n`, and the absolute values it carries are already those of the base field.  Combining the
two gives a splitting field of the algebra which is inert for the absolute value.

## Main results

* `InverseGalois.CFT.exists_mul_self_eq_finrank`: **the dimension of a central division algebra is
  a square.**
* `InverseGalois.CFT.exists_splitting_of_finrank_eq`: a subfield of degree the square root of the
  dimension splits the algebra.
* `InverseGalois.CFT.exists_unramified_splitting`: **a division algebra over a nonarchimedean local
  field is split by a subfield of degree the square root of the dimension which carries only the
  absolute values of the base field.**

## Tags

division algebra, local field, splitting field, maximal subfield, centralizer, unramified
-/

set_option maxHeartbeats 1000000
set_option synthInstance.maxHeartbeats 1000000

universe u

open Module

open scoped TensorProduct

namespace InverseGalois.CFT

/-! ### The dimension of a central division algebra is a square -/

section Square

variable (K D : Type u) [Field K] [DivisionRing D] [Algebra K D] [FiniteDimensional K D]
variable [Algebra.IsCentral K D]

/-- **The dimension of a finite-dimensional central division algebra is a square.**  A subalgebra
equal to its own centralizer is a field, and the product of its degree with the degree of its
centralizer is the dimension of the algebra. -/
theorem exists_mul_self_eq_finrank : ∃ n : ℕ, n * n = finrank K D := by
  obtain ⟨F, hF⟩ := exists_centralizer_eq (K := K) D
  have hle : F ≤ Subalgebra.centralizer K (F : Set D) := by rw [hF]
  letI : Field ↥F := (isField_of_le_centralizer hle).toField
  refine ⟨finrank K ↥F, ?_⟩
  have h := Centralizer.finrank_mul_finrank_centralizer F
  rwa [hF] at h

end Square

/-! ### A subfield of half the degree splits the algebra -/

section Splitting

variable {K D : Type u} [Field K] [DivisionRing D] [Algebra K D] [FiniteDimensional K D]
variable [Algebra.IsCentral K D]

/-- A subfield of a finite-dimensional central division algebra whose degree squared is the
dimension of the algebra is its own centralizer, and therefore splits the algebra. -/
theorem exists_splitting_of_finrank_eq {L : Subalgebra K D} (hLfield : IsField ↥L) {n : ℕ}
    (hn : n * n = finrank K D) (hdim : finrank K ↥L = n)
    (hle : L ≤ Subalgebra.centralizer K (L : Set D)) :
    letI : Field ↥L := hLfield.toField
    ∃ m : ℕ, Nonempty ((↥L ⊗[K] D) ≃ₐ[↥L] Matrix (Fin m) (Fin m) ↥L) := by
  letI : Field ↥L := hLfield.toField
  have hsq : finrank K ↥L * finrank K ↥L = finrank K D := by rw [hdim, hn]
  have hcent : Subalgebra.centralizer K (L : Set D) = L :=
    (Centralizer.centralizer_eq_self_iff_finrank_sq L hle).2 hsq
  have hrange :
      Subalgebra.centralizer K ((L.val.range : Subalgebra K D) : Set D) = L.val.range := by
    rw [Subalgebra.range_val]
    exact hcent
  exact Centralizer.exists_algEquiv_matrix_of_centralizer_eq_range L.val hrange

end Splitting

/-! ### The splitting field of a division algebra over a local field -/

section Local

variable (K D : Type u) [NontriviallyNormedField K] [IsUltrametricDist K] [ProperSpace K]
variable [DivisionRing D] [Algebra K D] [FiniteDimensional K D] [Algebra.IsCentral K D]

/-- **A division algebra over a nonarchimedean local field is split by a subfield of degree the
square root of the dimension which carries only the absolute values of the base field.**  The
subfield generated by a lift of a generator of the residue ring has that degree, so it is its own
centralizer and splits the algebra, and its nonzero elements have the absolute values of the
nonzero scalars. -/
theorem exists_unramified_splitting {n : ℕ} (hn : n * n = finrank K D) :
    ∃ (L : Type u) (_ : Field L) (_ : Algebra K L) (f : L →ₐ[K] D),
      finrank K L = n ∧
        (∀ z : L, z ≠ 0 → ∃ c : K, c ≠ 0 ∧ divisionNorm K D (f z) = ‖c‖) ∧
        ∃ m : ℕ, Nonempty ((L ⊗[K] D) ≃ₐ[L] Matrix (Fin m) (Fin m) L) := by
  obtain ⟨y, hfield, hdim, hval⟩ := exists_unramified_generator K D hn
  have hle : Algebra.adjoin K ({y} : Set D) ≤
      Subalgebra.centralizer K ((Algebra.adjoin K ({y} : Set D) : Subalgebra K D) : Set D) :=
    adjoin_singleton_le_centralizer y
  have hsplit := exists_splitting_of_finrank_eq hfield hn hdim hle
  letI : Field ↥(Algebra.adjoin K ({y} : Set D)) := hfield.toField
  refine ⟨↥(Algebra.adjoin K ({y} : Set D)), inferInstance, inferInstance,
    (Algebra.adjoin K ({y} : Set D)).val, hdim, fun z hz => ?_, hsplit⟩
  exact hval (z : D) z.2 fun h => hz (Subtype.ext h)

end Local

end InverseGalois.CFT
