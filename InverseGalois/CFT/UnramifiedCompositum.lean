import Mathlib
import InverseGalois.CFT.Level
import InverseGalois.CFT.Disjoint

/-!
# Ramification in a compositum

A rational prime unramified in two number fields is unramified in their compositum, so the set of
ramified primes of a compositum is exactly the union of the two sets of ramified primes.  The proof
passes to a Galois extension `N` of `ℚ` containing both fields and compares inertia subgroups:
because the inertia subgroup of a prime `P` of `𝓞 N` is defined by a congruence that does not
mention the base ring, the inertia subgroup of `P` over an intermediate field `F` is the
intersection of the inertia subgroup over `ℚ` with the subgroup fixing `F`.  A prime below `P` is
unramified in `F` exactly when the inertia subgroup over `ℚ` fixes `F`, and the subgroup fixing a
compositum is the intersection of the two fixing subgroups.

## Main results

* `InverseGalois.CFT.notMem_ramifiedSet_sup`: a rational prime unramified in two intermediate
  fields is unramified in their compositum.
* `InverseGalois.CFT.ramifiedSet_sup`: the ramified primes of a compositum are the union of the
  ramified primes of the two factors.
* `InverseGalois.CFT.IsLevel.sup`: the level condition passes to a compositum.
* `InverseGalois.CFT.card_inertia_eq_mul`: the order of an inertia subgroup is the ramification
  index in an intermediate field times the order of the inertia subgroup over that field.
-/

open NumberField InverseGalois.NumberTheory

namespace InverseGalois.CFT

/-! ### Residue fields -/

/-- The residue field extension at a prime with finite residue fields is separable. -/
private theorem isSeparable_quotient {R S : Type*} [CommRing R] [CommRing S] [Algebra R S]
    (p : Ideal R) (P : Ideal S) [p.IsMaximal] [P.IsMaximal] [P.LiesOver p] [Finite (R ⧸ p)]
    [Finite (S ⧸ P)] : Algebra.IsSeparable (R ⧸ p) (S ⧸ P) := by
  letI : Field (R ⧸ p) := Ideal.Quotient.field _
  letI : Field (S ⧸ P) := Ideal.Quotient.field _
  haveI : PerfectField (R ⧸ p) := PerfectField.ofFinite
  haveI : Algebra.IsAlgebraic (R ⧸ p) (S ⧸ P) := Algebra.IsAlgebraic.of_finite _ _
  exact Algebra.IsAlgebraic.isSeparable_of_perfectField

/-- The ideal generated by a rational prime is maximal in `ℤ`. -/
private theorem isMaximal_span_intCast {p : ℕ} (hp : p.Prime) :
    (Ideal.span {(p : ℤ)}).IsMaximal := by
  have hspan : Ideal.span {(p : ℤ)} ≠ ⊥ := by
    simpa [Ideal.span_singleton_eq_bot] using hp.ne_zero
  haveI : (Ideal.span {(p : ℤ)}).IsPrime := by
    rw [Ideal.span_singleton_prime (by exact_mod_cast hp.ne_zero)]
    exact Nat.prime_iff_prime_int.mp hp
  exact Ideal.IsPrime.isMaximal inferInstance hspan

/-! ### Inertia subgroups in a Galois extension -/

section Galois

variable {N : Type*} [Field N] [NumberField N] [IsGalois ℚ N]

/-- The inertia subgroup of a prime of `𝓞 N` over `ℚ` has order the ramification index. -/
private theorem card_inertia_eq_ramificationIdx {p : ℕ} (hp : p.Prime) (P : Ideal (𝓞 N))
    [P.IsMaximal] [hover : P.LiesOver (Ideal.span {(p : ℤ)})] :
    Nat.card (P.inertia (N ≃ₐ[ℚ] N)) =
      Ideal.ramificationIdx (algebraMap ℤ (𝓞 N)) (Ideal.span {(p : ℤ)}) P := by
  have hspan : Ideal.span {(p : ℤ)} ≠ ⊥ := by
    simpa [Ideal.span_singleton_eq_bot] using hp.ne_zero
  haveI := isMaximal_span_intCast hp
  haveI : Finite (ℤ ⧸ Ideal.span {(p : ℤ)}) := Ideal.finiteQuotientOfFreeOfNeBot _ hspan
  haveI : Finite (𝓞 N ⧸ P) :=
    Ideal.finiteQuotientOfFreeOfNeBot _ (ne_bot_of_liesOver_natCast hp hover)
  haveI := isSeparable_quotient (Ideal.span {(p : ℤ)}) P
  rw [Ideal.card_inertia_eq_ramificationIdxIn (G := N ≃ₐ[ℚ] N) _ hspan P,
    Ideal.ramificationIdxIn_eq_ramificationIdx _ P (N ≃ₐ[ℚ] N)]

/-- The inertia subgroup of a prime of `𝓞 N` inside the subgroup fixing an intermediate field has
order the ramification index over that field. -/
private theorem card_inertia_fixingSubgroup_eq_ramificationIdx (F : IntermediateField ℚ N) {p : ℕ}
    (hp : p.Prime) (P : Ideal (𝓞 N)) [P.IsMaximal]
    [hover : P.LiesOver (Ideal.span {(p : ℤ)})] :
    Nat.card (P.inertia F.fixingSubgroup) =
      Ideal.ramificationIdx (algebraMap (𝓞 ↥F) (𝓞 N)) (P.under (𝓞 ↥F)) P := by
  haveI : IsGaloisGroup F.fixingSubgroup (𝓞 ↥F) (𝓞 N) := by
    unfold IntermediateField.fixingSubgroup; infer_instance
  have hPne := ne_bot_of_liesOver_natCast hp hover
  have hune : P.under (𝓞 ↥F) ≠ ⊥ := ne_bot_of_liesOver_natCast hp inferInstance
  haveI : Finite (𝓞 ↥F ⧸ P.under (𝓞 ↥F)) := Ideal.finiteQuotientOfFreeOfNeBot _ hune
  haveI : Finite (𝓞 N ⧸ P) := Ideal.finiteQuotientOfFreeOfNeBot _ hPne
  haveI := isSeparable_quotient (P.under (𝓞 ↥F)) P
  rw [Ideal.card_inertia_eq_ramificationIdxIn (G := F.fixingSubgroup) (P.under (𝓞 ↥F)) hune P,
    Ideal.ramificationIdxIn_eq_ramificationIdx (P.under (𝓞 ↥F)) P F.fixingSubgroup]

/-- The order of the inertia subgroup over `ℚ` is the ramification index in an intermediate field
times the order of the inertia subgroup inside the subgroup fixing that field. -/
theorem card_inertia_eq_mul (F : IntermediateField ℚ N) {p : ℕ} (hp : p.Prime)
    (P : Ideal (𝓞 N)) [P.IsMaximal] [hover : P.LiesOver (Ideal.span {(p : ℤ)})] :
    Nat.card (P.inertia (N ≃ₐ[ℚ] N)) =
      Ideal.ramificationIdx (algebraMap ℤ (𝓞 ↥F)) (Ideal.span {(p : ℤ)}) (P.under (𝓞 ↥F)) *
        Nat.card ((P.inertia (N ≃ₐ[ℚ] N)) ⊓ F.fixingSubgroup : Subgroup (N ≃ₐ[ℚ] N)) := by
  have hspan : Ideal.span {(p : ℤ)} ≠ ⊥ := by
    simpa [Ideal.span_singleton_eq_bot] using hp.ne_zero
  have hune : P.under (𝓞 ↥F) ≠ ⊥ := ne_bot_of_liesOver_natCast hp inferInstance
  have hmap : (P.under (𝓞 ↥F)).map (algebraMap (𝓞 ↥F) (𝓞 N)) ≠ ⊥ := by
    intro h
    refine hune (le_bot_iff.mp ?_)
    intro x hx
    have : algebraMap (𝓞 ↥F) (𝓞 N) x = 0 := by
      have := Ideal.mem_map_of_mem (algebraMap (𝓞 ↥F) (𝓞 N)) hx
      rw [h, Ideal.mem_bot] at this
      exact this
    simpa using (map_eq_zero_iff _ (FaithfulSMul.algebraMap_injective (𝓞 ↥F) (𝓞 N))).mp this
  have hfg : (Ideal.span {(p : ℤ)}).map (algebraMap ℤ (𝓞 N)) ≠ ⊥ := by
    intro h
    refine hspan (le_bot_iff.mp ?_)
    intro x hx
    have : algebraMap ℤ (𝓞 N) x = 0 := by
      have := Ideal.mem_map_of_mem (algebraMap ℤ (𝓞 N)) hx
      rw [h, Ideal.mem_bot] at this
      exact this
    simpa using (map_eq_zero_iff _ (FaithfulSMul.algebraMap_injective ℤ (𝓞 N))).mp this
  have hle : (P.under (𝓞 ↥F)).map (algebraMap (𝓞 ↥F) (𝓞 N)) ≤ P :=
    Ideal.map_le_iff_le_comap.mpr le_rfl
  have htower := Ideal.ramificationIdx_algebra_tower (R := ℤ) (S := 𝓞 ↥F) (T := 𝓞 N)
    (p := Ideal.span {(p : ℤ)}) (P := P.under (𝓞 ↥F)) (Q := P) hmap hfg hle
  have hsub : Nat.card ((P.inertia (N ≃ₐ[ℚ] N)) ⊓ F.fixingSubgroup : Subgroup (N ≃ₐ[ℚ] N)) =
      Nat.card (P.inertia F.fixingSubgroup) := by
    rw [← Nat.card_congr (Subgroup.subgroupOfEquivOfLe
      (H := (P.inertia (N ≃ₐ[ℚ] N)) ⊓ F.fixingSubgroup) (K := F.fixingSubgroup)
      inf_le_right).toEquiv, Subgroup.inf_subgroupOf_right]
    rfl
  rw [hsub, card_inertia_eq_ramificationIdx hp P,
    card_inertia_fixingSubgroup_eq_ramificationIdx F hp P, htower]

/-- **A prime is unramified in an intermediate field exactly when inertia fixes that field.** -/
private theorem ramificationIdx_under_eq_one_iff (F : IntermediateField ℚ N) {p : ℕ}
    (hp : p.Prime) (P : Ideal (𝓞 N)) [P.IsMaximal]
    [hover : P.LiesOver (Ideal.span {(p : ℤ)})] :
    Ideal.ramificationIdx (algebraMap ℤ (𝓞 ↥F)) (Ideal.span {(p : ℤ)}) (P.under (𝓞 ↥F)) = 1 ↔
      P.inertia (N ≃ₐ[ℚ] N) ≤ F.fixingSubgroup := by
  have hmul := card_inertia_eq_mul F hp P
  constructor
  · intro h
    rw [h, one_mul] at hmul
    exact inf_eq_left.mp (Subgroup.eq_of_le_of_card_ge inf_le_left hmul.le)
  · intro h
    rw [inf_eq_left.mpr h] at hmul
    have : 1 * Nat.card (P.inertia (N ≃ₐ[ℚ] N)) =
        Ideal.ramificationIdx (algebraMap ℤ (𝓞 ↥F)) (Ideal.span {(p : ℤ)}) (P.under (𝓞 ↥F)) *
          Nat.card (P.inertia (N ≃ₐ[ℚ] N)) := by simpa using hmul
    exact (Nat.eq_of_mul_eq_mul_right Nat.card_pos this).symm

/-- **A prime unramified in two intermediate fields of a Galois number field is unramified in
their compositum.** -/
theorem notMem_ramifiedSet_sup_of_isGalois (A B : IntermediateField ℚ N) {p : ℕ}
    (hA : p ∉ ramifiedSet ↥A) (hB : p ∉ ramifiedSet ↥B) : p ∉ ramifiedSet ↥(A ⊔ B) := by
  rintro ⟨hp, Q, ⟨hQprime, hQover⟩, hQe⟩
  haveI := hQprime
  haveI := hQover
  have hQ0 : Q ≠ ⊥ := ne_bot_of_liesOver_natCast hp hQover
  haveI : Q.IsMaximal := Ring.DimensionLEOne.maximalOfPrime hQ0 hQprime
  obtain ⟨P, hPmax, hPover⟩ :=
    Ideal.exists_maximal_ideal_liesOver_of_isIntegral (S := 𝓞 N) Q
  haveI := hPmax
  haveI := hPover
  haveI : P.IsPrime := hPmax.isPrime
  haveI : P.LiesOver (Ideal.span {(p : ℤ)}) := Ideal.LiesOver.trans P Q (Ideal.span {(p : ℤ)})
  have key : ∀ F : IntermediateField ℚ N, p ∉ ramifiedSet ↥F →
      P.inertia (N ≃ₐ[ℚ] N) ≤ F.fixingSubgroup := by
    intro F hF
    refine (ramificationIdx_under_eq_one_iff F hp P).mp ?_
    by_contra hne
    exact hF ⟨hp, P.under (𝓞 ↥F), ⟨inferInstance, inferInstance⟩, hne⟩
  have hAB : P.inertia (N ≃ₐ[ℚ] N) ≤ (A ⊔ B).fixingSubgroup := by
    rw [IntermediateField.fixingSubgroup_sup]
    exact le_inf (key A hA) (key B hB)
  have hone := (ramificationIdx_under_eq_one_iff (A ⊔ B) hp P).mpr hAB
  rw [← hPover.over] at hone
  exact hQe hone

end Galois

/-! ### The general case -/

/-- Isomorphic number fields have the same ramified rational primes. -/
theorem ramifiedSet_eq_of_ringEquiv {E F : Type*} [Field E] [NumberField E] [Field F]
    [NumberField F] (e : E ≃+* F) : ramifiedSet E = ramifiedSet F := by
  letI : Algebra E F := e.toRingHom.toAlgebra
  letI : Algebra F E := e.symm.toRingHom.toAlgebra
  exact Set.Subset.antisymm (ramifiedSet_subset E F) (ramifiedSet_subset F E)

variable {L : Type*} [Field L] [NumberField L]

set_option synthInstance.maxHeartbeats 400000 in
/-- **A rational prime unramified in two number fields is unramified in their compositum.** -/
theorem notMem_ramifiedSet_sup (A B : IntermediateField ℚ L) {p : ℕ}
    (hA : p ∉ ramifiedSet ↥A) (hB : p ∉ ramifiedSet ↥B) : p ∉ ramifiedSet ↥(A ⊔ B) := by
  haveI : NumberField ↥(IntermediateField.normalClosure ℚ L (AlgebraicClosure L)) := ⟨⟩
  haveI : IsGalois ℚ ↥(IntermediateField.normalClosure ℚ L (AlgebraicClosure L)) := ⟨⟩
  let f : L →ₐ[ℚ] ↥(IntermediateField.normalClosure ℚ L (AlgebraicClosure L)) :=
    IsScalarTower.toAlgHom ℚ L ↥(IntermediateField.normalClosure ℚ L (AlgebraicClosure L))
  have hsup : (A ⊔ B).map f = A.map f ⊔ B.map f := (IntermediateField.gc_map_comap f).l_sup
  have hA' : p ∉ ramifiedSet ↥(A.map f) := by
    rwa [← ramifiedSet_eq_of_ringEquiv (IntermediateField.equivMap A f).toRingEquiv]
  have hB' : p ∉ ramifiedSet ↥(B.map f) := by
    rwa [← ramifiedSet_eq_of_ringEquiv (IntermediateField.equivMap B f).toRingEquiv]
  have h := notMem_ramifiedSet_sup_of_isGalois (A.map f) (B.map f) hA' hB'
  rw [← hsup] at h
  rwa [ramifiedSet_eq_of_ringEquiv (IntermediateField.equivMap (A ⊔ B) f).toRingEquiv]

/-- **The ramified primes of a compositum are the union of the ramified primes of the two
factors.** -/
theorem ramifiedSet_sup (A B : IntermediateField ℚ L) :
    ramifiedSet ↥(A ⊔ B) = ramifiedSet ↥A ∪ ramifiedSet ↥B := by
  refine Set.Subset.antisymm (fun p hp => ?_) (Set.union_subset ?_ ?_)
  · by_contra hc
    simp only [Set.mem_union, not_or] at hc
    exact notMem_ramifiedSet_sup A B hc.1 hc.2 hp
  · letI : Algebra ↥A ↥(A ⊔ B) := (IntermediateField.inclusion le_sup_left).toAlgebra
    exact ramifiedSet_subset ↥A ↥(A ⊔ B)
  · letI : Algebra ↥B ↥(A ⊔ B) := (IntermediateField.inclusion le_sup_right).toAlgebra
    exact ramifiedSet_subset ↥B ↥(A ⊔ B)

/-- **The level condition passes to a compositum.** -/
theorem IsLevel.sup {ℓ n : ℕ} {A B : IntermediateField ℚ L} (hA : IsLevel ℓ n ↥A)
    (hB : IsLevel ℓ n ↥B) : IsLevel ℓ n ↥(A ⊔ B) := by
  intro q hq
  rw [ramifiedSet_sup A B] at hq
  exact hq.elim (hA q) (hB q)

end InverseGalois.CFT
