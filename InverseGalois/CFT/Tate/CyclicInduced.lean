import Mathlib
import InverseGalois.CFT.Tate.InducedLattice

/-!
# Functions on a cyclic group form an induced module

Let `Γ` be a finite cyclic group of order `d`, generated by an element `s`, and let `C` be an
abelian group.  The group `Γ` acts on the functions `Γ → C` by translation, and choosing the
parametrisation `i ↦ (s⁻¹) ^ i` of `Γ` by `ZMod d` identifies this translation action with the
action on the module induced from the trivial action of the trivial group on `C`.  Consequently a
module carrying an equivariant copy of such a translation module with finite cokernel has Herbrand
quotient one.

## Main definitions

* `InverseGalois.CFT.translateAut`: the translation action of a group on the functions on it.
* `InverseGalois.CFT.cyclicParam`: the parametrisation `i ↦ (s⁻¹) ^ i` of a cyclic group by
  `ZMod d`.
* `InverseGalois.CFT.cyclicIndEquiv`: **the identification of the functions on a finite cyclic
  group with an induced module.**
* `InverseGalois.CFT.translationLatticeHom`: an equivariant map from the functions on a finite
  cyclic group, restricted along that identification.

## Main results

* `InverseGalois.CFT.cyclicParam_bijective`: the parametrisation of a cyclic group of order `d` by
  `ZMod d` is a bijection.
* `InverseGalois.CFT.cyclicIndEquiv_equivariant`: **the identification carries the induced
  automorphism to translation by the chosen generator.**
* `InverseGalois.CFT.range_translationLatticeHom`: restricting along the identification does not
  change the image.
* `InverseGalois.CFT.finite_tate_of_translationLattice`: **both Tate groups of a module containing
  an equivariant copy of the functions on a finite cyclic group with finite cokernel are finite.**
* `InverseGalois.CFT.herbrand_eq_one_of_translationLattice`: **a module containing an equivariant
  copy of the functions on a finite cyclic group with finite cokernel has Herbrand quotient
  one.**

## Tags

Tate cohomology, Herbrand quotient, induced module, cyclic group, translation, lattice
-/

namespace InverseGalois.CFT

variable {Γ : Type*} [Group Γ] {C : Type*} [AddCommGroup C]

/-! ### Translation of functions on a group -/

/-- **The translation action of a group on the functions on it**: the element `s` sends a function
`f` to the function `h ↦ f (s⁻¹ * h)`. -/
def translateAut (s : Γ) : (Γ → C) ≃+ (Γ → C) where
  toFun f h := f (s⁻¹ * h)
  invFun f h := f (s * h)
  left_inv f := funext fun h => congrArg f (inv_mul_cancel_left s h)
  right_inv f := funext fun h => congrArg f (mul_inv_cancel_left s h)
  map_add' _ _ := rfl

@[simp]
theorem translateAut_apply (s : Γ) (f : Γ → C) (h : Γ) : translateAut s f h = f (s⁻¹ * h) := rfl

/-- Iterating translation by `s` translates by a power of `s`. -/
theorem translateAut_pow_apply (s : Γ) (n : ℕ) (f : Γ → C) (h : Γ) :
    ((translateAut (C := C) s) ^ n) f h = f ((s ^ n)⁻¹ * h) := by
  induction n generalizing f with
  | zero => rw [pow_zero, pow_zero, inv_one, one_mul]; rfl
  | succ n ih =>
    rw [pow_succ_apply', ih, translateAut_apply, pow_succ, mul_inv_rev, mul_assoc]

/-- Translation by an element of order dividing `d` has order dividing `d`. -/
theorem translateAut_pow_eq_one {s : Γ} {d : ℕ} (hs : s ^ d = 1) :
    (translateAut (C := C) s) ^ d = 1 := by
  refine AddEquiv.ext fun f => funext fun h => ?_
  rw [translateAut_pow_apply, hs, inv_one, one_mul]
  rfl

/-! ### Powers with an exponent taken modulo the order -/

variable {s : Γ} {d : ℕ}

/-- Reducing a natural exponent modulo `d` does not change the power of an element whose `d`-th
power is the identity. -/
theorem pow_natMod_of_pow_eq_one (hs : s ^ d = 1) (n : ℕ) : s ^ (n % d) = s ^ n := by
  conv_rhs => rw [← Nat.div_add_mod n d, pow_add, pow_mul, hs, one_pow, one_mul]

/-- An integral power of an element whose `d`-th power is the identity is the natural power given
by the exponent reduced modulo `d`. -/
theorem zpow_eq_pow_emod_of_pow_eq_one [NeZero d] (hs : s ^ d = 1) (k : ℤ) :
    s ^ k = s ^ (k % (d : ℤ)).toNat := by
  have hd : ((d : ℤ)) ≠ 0 := Nat.cast_ne_zero.mpr (NeZero.ne d)
  have hnn : ((k % (d : ℤ)).toNat : ℤ) = k % (d : ℤ) := Int.toNat_of_nonneg (Int.emod_nonneg k hd)
  rw [← zpow_natCast, hnn]
  conv_lhs => rw [← Int.mul_ediv_add_emod k (d : ℤ)]
  rw [zpow_add, zpow_mul, zpow_natCast, hs, one_zpow, one_mul]

/-! ### Parametrising a cyclic group by `ZMod d` -/

variable (s d) in
/-- **The parametrisation of a cyclic group by `ZMod d`** attached to a generator `s`: the class of
`i` is sent to `(s⁻¹) ^ i`.  The inverse generator is used so that adding one to the index is
translation by `s⁻¹`. -/
def cyclicParam : ZMod d → Γ := fun i => s⁻¹ ^ i.val

/-- The inverse of a generator whose `d`-th power is the identity again has `d`-th power the
identity. -/
theorem inv_pow_eq_one (hs : s ^ d = 1) : s⁻¹ ^ d = 1 := by rw [inv_pow, hs, inv_one]

/-- On the class of a natural number the parametrisation is the corresponding power of the inverse
generator. -/
theorem cyclicParam_natCast [NeZero d] (hs : s ^ d = 1) (n : ℕ) :
    cyclicParam s d (n : ZMod d) = s⁻¹ ^ n := by
  rw [cyclicParam, ZMod.val_natCast, pow_natMod_of_pow_eq_one (inv_pow_eq_one hs)]

/-- **Adding one to the index translates the parametrisation by the inverse generator.** -/
theorem cyclicParam_add_one [NeZero d] (hs : s ^ d = 1) (i : ZMod d) :
    cyclicParam s d (i + 1) = s⁻¹ * cyclicParam s d i := by
  have hval : (i + 1).val = (i.val + 1) % d := by
    rw [ZMod.val_add, ZMod.val_one_eq_one_mod, Nat.add_mod_mod]
  rw [cyclicParam, cyclicParam, hval, pow_natMod_of_pow_eq_one (inv_pow_eq_one hs), pow_succ']

/-- **The parametrisation of a cyclic group by `ZMod d` is surjective**, because every element is
an integral power of the generator and integral exponents may be reduced modulo `d`. -/
theorem cyclicParam_surjective [NeZero d] (hgen : ∀ g : Γ, g ∈ Subgroup.zpowers s)
    (hs : s ^ d = 1) : Function.Surjective (cyclicParam s d) := by
  intro g
  obtain ⟨k, hk⟩ := Subgroup.mem_zpowers_iff.mp (hgen g)
  refine ⟨(((-k) % (d : ℤ)).toNat : ZMod d), ?_⟩
  rw [cyclicParam_natCast hs, ← zpow_eq_pow_emod_of_pow_eq_one (inv_pow_eq_one hs), zpow_neg,
    inv_zpow, inv_inv, hk]

/-- **The parametrisation of a cyclic group of order `d` by `ZMod d` is bijective**: it is
surjective, and a surjection between finite types of the same cardinality is a bijection. -/
theorem cyclicParam_bijective [NeZero d] (hgen : ∀ g : Γ, g ∈ Subgroup.zpowers s) (hs : s ^ d = 1)
    (hcard : Nat.card Γ = d) : Function.Bijective (cyclicParam s d) := by
  haveI : Finite Γ := Nat.finite_of_card_ne_zero (by rw [hcard]; exact NeZero.ne d)
  exact (Nat.bijective_iff_surjective_and_card _).mpr
    ⟨cyclicParam_surjective hgen hs, by rw [Nat.card_zmod, hcard]⟩

/-- **The parametrisation of a cyclic group of order `d` by `ZMod d`, as an equivalence.** -/
noncomputable def cyclicParamEquiv [NeZero d] (hgen : ∀ g : Γ, g ∈ Subgroup.zpowers s)
    (hs : s ^ d = 1) (hcard : Nat.card Γ = d) : ZMod d ≃ Γ :=
  Equiv.ofBijective _ (cyclicParam_bijective hgen hs hcard)

@[simp]
theorem cyclicParamEquiv_apply [NeZero d] (hgen : ∀ g : Γ, g ∈ Subgroup.zpowers s) (hs : s ^ d = 1)
    (hcard : Nat.card Γ = d) (i : ZMod d) :
    cyclicParamEquiv hgen hs hcard i = cyclicParam s d i := rfl

/-- **Translating by the inverse generator adds one to the index.** -/
theorem cyclicParamEquiv_symm_mul [NeZero d] (hgen : ∀ g : Γ, g ∈ Subgroup.zpowers s)
    (hs : s ^ d = 1) (hcard : Nat.card Γ = d) (h : Γ) :
    (cyclicParamEquiv hgen hs hcard).symm (s⁻¹ * h)
      = (cyclicParamEquiv hgen hs hcard).symm h + 1 := by
  refine (cyclicParamEquiv hgen hs hcard).symm_apply_eq.mpr ?_
  rw [cyclicParamEquiv_apply, cyclicParam_add_one hs, ← cyclicParamEquiv_apply hgen hs hcard,
    Equiv.apply_symm_apply]

/-! ### Functions on a cyclic group as an induced module -/

/-- **The functions on a finite cyclic group are a module induced from the trivial action**: a
function on `ZMod d` is carried to its transport along the parametrisation of the group by
`ZMod d`. -/
noncomputable def cyclicIndEquiv [NeZero d] (hgen : ∀ g : Γ, g ∈ Subgroup.zpowers s)
    (hs : s ^ d = 1) (hcard : Nat.card Γ = d) : (ZMod d → C) ≃+ (Γ → C) where
  toFun f := fun h => f ((cyclicParamEquiv hgen hs hcard).symm h)
  invFun g := fun i => g (cyclicParamEquiv hgen hs hcard i)
  left_inv f := funext fun i => congrArg f ((cyclicParamEquiv hgen hs hcard).symm_apply_apply i)
  right_inv g := funext fun h => congrArg g ((cyclicParamEquiv hgen hs hcard).apply_symm_apply h)
  map_add' _ _ := rfl

@[simp]
theorem cyclicIndEquiv_apply [NeZero d] (hgen : ∀ g : Γ, g ∈ Subgroup.zpowers s) (hs : s ^ d = 1)
    (hcard : Nat.card Γ = d) (f : ZMod d → C) (h : Γ) :
    cyclicIndEquiv (C := C) hgen hs hcard f h = f ((cyclicParamEquiv hgen hs hcard).symm h) := rfl

/-- **The identification of the functions on a finite cyclic group with an induced module carries
the induced automorphism to translation by the chosen generator.** -/
theorem cyclicIndEquiv_equivariant [NeZero d] (hgen : ∀ g : Γ, g ∈ Subgroup.zpowers s)
    (hs : s ^ d = 1) (hcard : Nat.card Γ = d) (f : ZMod d → C) :
    cyclicIndEquiv hgen hs hcard (indAut (1 : C ≃+ C) d f)
      = translateAut s (cyclicIndEquiv hgen hs hcard f) := by
  refine funext fun h => ?_
  rw [cyclicIndEquiv_apply, translateAut_apply, cyclicIndEquiv_apply, indAut_apply,
    cyclicParamEquiv_symm_mul]
  rcases eq_or_ne ((cyclicParamEquiv hgen hs hcard).symm h) (-1 : ZMod d) with hi | hi
  · rw [hi, indTwist_neg_one]
    rfl
  · rw [indTwist_of_ne _ hi]
    rfl

/-! ### A module containing a translation lattice -/

section TranslationLattice

variable {B : Type*} [AddCommGroup B] {σB : B ≃+ B} [NeZero d]
  (hgen : ∀ g : Γ, g ∈ Subgroup.zpowers s) (hs : s ^ d = 1) (hcard : Nat.card Γ = d)
  (Φ : (Γ → C) →+ B)

/-- **The induced module inside a module containing a translation lattice**: a map from the
functions on a finite cyclic group is restricted along the identification of those functions with
a module induced from the trivial action. -/
noncomputable def translationLatticeHom : (ZMod d → C) →+ B :=
  Φ.comp (cyclicIndEquiv hgen hs hcard).toAddMonoidHom

theorem translationLatticeHom_apply (f : ZMod d → C) :
    translationLatticeHom hgen hs hcard Φ f = Φ (cyclicIndEquiv hgen hs hcard f) := rfl

/-- The restricted map is equivariant for the induced automorphism whenever the original map is
equivariant for translation. -/
theorem translationLatticeHom_equivariant (hΦ : ∀ f, Φ (translateAut s f) = σB (Φ f))
    (f : ZMod d → C) : translationLatticeHom hgen hs hcard Φ (indAut (1 : C ≃+ C) d f)
      = σB (translationLatticeHom hgen hs hcard Φ f) := by
  rw [translationLatticeHom_apply, translationLatticeHom_apply, cyclicIndEquiv_equivariant, hΦ]

/-- The restricted map is injective whenever the original map is. -/
theorem translationLatticeHom_injective (hinj : Function.Injective Φ) :
    Function.Injective (translationLatticeHom hgen hs hcard Φ) :=
  hinj.comp (cyclicIndEquiv hgen hs hcard).injective

/-- **Restricting along the identification does not change the image**, because the identification
is surjective. -/
theorem range_translationLatticeHom : (translationLatticeHom hgen hs hcard Φ).range = Φ.range := by
  refine le_antisymm (fun b hb => ?_) (fun b hb => ?_)
  · obtain ⟨f, rfl⟩ := hb
    exact ⟨cyclicIndEquiv hgen hs hcard f, (translationLatticeHom_apply hgen hs hcard Φ f).symm⟩
  · obtain ⟨g, rfl⟩ := hb
    exact ⟨(cyclicIndEquiv hgen hs hcard).symm g, by
      rw [translationLatticeHom_apply, AddEquiv.apply_symm_apply]⟩

/-- The cokernel of the restricted map is finite whenever the cokernel of the original map is. -/
theorem finite_quotient_range_translationLatticeHom [Finite (B ⧸ Φ.range)] :
    Finite (B ⧸ (translationLatticeHom hgen hs hcard Φ).range) := by
  rw [range_translationLatticeHom]
  infer_instance

end TranslationLattice

/-- **Both Tate groups of a module containing an equivariant copy of the functions on a finite
cyclic group with finite cokernel are finite.** -/
theorem finite_tate_of_translationLattice {B : Type*} [AddCommGroup B] {σB : B ≃+ B}
    {s : Γ} {d : ℕ} [NeZero d] (hgen : ∀ g : Γ, g ∈ Subgroup.zpowers s) (hs : s ^ d = 1)
    (hcard : Nat.card Γ = d) (hσB : σB ^ d = 1) (Φ : (Γ → C) →+ B)
    (hΦ : ∀ f, Φ (translateAut s f) = σB (Φ f)) (hinj : Function.Injective Φ)
    [Finite (B ⧸ Φ.range)] : Finite (tateH0 σB d) ∧ Finite (tateHm1 σB d) :=
  haveI := finite_quotient_range_translationLatticeHom hgen hs hcard Φ
  finite_tate_of_indAut hσB (translationLatticeHom hgen hs hcard Φ)
    (translationLatticeHom_equivariant hgen hs hcard Φ hΦ)
    (translationLatticeHom_injective hgen hs hcard Φ hinj)

/-- **A module containing an equivariant copy of the functions on a finite cyclic group with finite
cokernel has Herbrand quotient one.** -/
theorem herbrand_eq_one_of_translationLattice {B : Type*} [AddCommGroup B] {σB : B ≃+ B}
    {s : Γ} {d : ℕ} [NeZero d] (hgen : ∀ g : Γ, g ∈ Subgroup.zpowers s) (hs : s ^ d = 1)
    (hcard : Nat.card Γ = d) (hσB : σB ^ d = 1) (Φ : (Γ → C) →+ B)
    (hΦ : ∀ f, Φ (translateAut s f) = σB (Φ f)) (hinj : Function.Injective Φ)
    [Finite (B ⧸ Φ.range)] : herbrand σB d = 1 :=
  haveI := finite_quotient_range_translationLatticeHom hgen hs hcard Φ
  herbrand_eq_one_of_indAut hσB (translationLatticeHom hgen hs hcard Φ)
    (translationLatticeHom_equivariant hgen hs hcard Φ hΦ)
    (translationLatticeHom_injective hgen hs hcard Φ hinj)

end InverseGalois.CFT
