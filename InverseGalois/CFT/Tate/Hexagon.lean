import Mathlib
import InverseGalois.CFT.Tate.Basic
import InverseGalois.CFT.Tate.Exact

/-!
# The Tate hexagon of a short exact sequence

A short exact sequence `0 → A → B → C → 0` of modules over the cyclic group generated by a single
automorphism of order dividing `n` gives rise to a six-term exact sequence of Tate groups, closing
up into a hexagon because the Tate cohomology of a cyclic group is two-periodic:

`Ĥ⁰(A) → Ĥ⁰(B) → Ĥ⁰(C) → Ĥ⁻¹(A) → Ĥ⁻¹(B) → Ĥ⁻¹(C) → Ĥ⁰(A)`.

The four maps induced by the two homomorphisms of the sequence are already available; this file
builds the two connecting maps and proves exactness at each of the six corners.  Both connecting
maps are the usual diagram chase: to move from `Ĥ⁰(C)` to `Ĥ⁻¹(A)`, lift a fixed point of `C` to
`B`, apply `x ↦ σ x - x` — which lands in the kernel of the surjection, hence in the image of the
injection — and take the preimage in `A`; to move from `Ĥ⁻¹(C)` to `Ĥ⁰(A)`, lift and apply the
norm instead.  Neither lift is canonical, but changing it moves the answer by a boundary, so the
class is well defined.

When all six Tate groups are finite the hexagon yields the numerical identity that makes the
Herbrand quotient multiplicative in short exact sequences.

## Main definitions

* `InverseGalois.CFT.TateSES`: a short exact sequence of modules over a cyclic group, presented by
  a single automorphism on each term.
* `InverseGalois.CFT.TateSES.delta0`: the connecting map `Ĥ⁰(C) → Ĥ⁻¹(A)`.
* `InverseGalois.CFT.TateSES.delta1`: the connecting map `Ĥ⁻¹(C) → Ĥ⁰(A)`.

## Main results

* `InverseGalois.CFT.TateSES.range_alpha0_eq_ker_beta0` and its five companions: **exactness of the
  hexagon** at each of its six corners.
* `InverseGalois.CFT.TateSES.card_tateH0_mul_card_tateH0_mul_card_tateHm1`: the numerical form of
  the hexagon for finite Tate groups.

## Tags

Tate cohomology, hexagon, connecting homomorphism, Herbrand quotient
-/

namespace InverseGalois.CFT

/-- **A short exact sequence of modules over a cyclic group.**  Each of the three terms carries an
automorphism whose `n`-th power is the identity, and the two homomorphisms of the sequence are
equivariant for them. -/
structure TateSES (n : ℕ) (A B C : Type*) [AddCommGroup A] [AddCommGroup B]
    [AddCommGroup C] where
  /-- The automorphism of the subobject. -/
  σA : A ≃+ A
  /-- The automorphism of the total object. -/
  σB : B ≃+ B
  /-- The automorphism of the quotient object. -/
  σC : C ≃+ C
  /-- The automorphism of the subobject has order dividing `n`. -/
  hσA : σA ^ n = 1
  /-- The automorphism of the total object has order dividing `n`. -/
  hσB : σB ^ n = 1
  /-- The automorphism of the quotient object has order dividing `n`. -/
  hσC : σC ^ n = 1
  /-- The injection of the sequence. -/
  f : A →+ B
  /-- The surjection of the sequence. -/
  g : B →+ C
  /-- The injection is equivariant. -/
  hf : ∀ a, f (σA a) = σB (f a)
  /-- The surjection is equivariant. -/
  hg : ∀ b, g (σB b) = σC (g b)
  /-- The injection is injective. -/
  finj : Function.Injective f
  /-- The surjection is surjective. -/
  gsurj : Function.Surjective g
  /-- The sequence is exact in the middle. -/
  range_eq_ker : f.range = g.ker

namespace TateSES

variable {n : ℕ} {A B C : Type*} [AddCommGroup A] [AddCommGroup B] [AddCommGroup C]
  (S : TateSES n A B C)

/-! ### Elementary consequences of exactness -/

/-- The composite of the two homomorphisms of the sequence vanishes. -/
theorem g_comp_f (a : A) : S.g (S.f a) = 0 := by
  have h : S.f a ∈ S.f.range := ⟨a, rfl⟩
  rw [S.range_eq_ker] at h
  exact h

/-- An element killed by the surjection comes from the subobject. -/
theorem exists_f_eq_of_g_eq_zero {b : B} (hb : S.g b = 0) : ∃ a, S.f a = b := by
  have h : b ∈ S.g.ker := hb
  rw [← S.range_eq_ker] at h
  exact h

/-- Two elements with the same image differ by an element of the subobject. -/
theorem exists_f_eq_sub {b b' : B} (h : S.g b = S.g b') : ∃ a, S.f a = b - b' :=
  S.exists_f_eq_of_g_eq_zero (by rw [map_sub, h, sub_self])

/-- A set-theoretic section of the surjection. -/
noncomputable def sec (c : C) : B := Function.surjInv S.gsurj c

@[simp]
theorem g_sec (c : C) : S.g (S.sec c) = c := Function.surjInv_eq S.gsurj c

/-- The inverse of the injection, defined on all of the total object but only meaningful on the
image of the injection. -/
noncomputable def finv (b : B) : A := Function.invFun S.f b

@[simp]
theorem finv_f (a : A) : S.finv (S.f a) = a := Function.leftInverse_invFun S.finj a

/-- On the image of the injection the partial inverse is a genuine inverse. -/
theorem f_finv {b : B} (hb : ∃ a, S.f a = b) : S.f (S.finv b) = b := by
  obtain ⟨a, rfl⟩ := hb
  rw [S.finv_f]

/-! ### Equivariance -/

/-- The injection commutes with the operator `x ↦ σ x - x`. -/
theorem f_sigmaSubOne (a : A) : S.f (sigmaSubOne S.σA a) = sigmaSubOne S.σB (S.f a) :=
  map_sigmaSubOne S.f S.hf a

/-- The surjection commutes with the operator `x ↦ σ x - x`. -/
theorem g_sigmaSubOne (b : B) : S.g (sigmaSubOne S.σB b) = sigmaSubOne S.σC (S.g b) :=
  map_sigmaSubOne S.g S.hg b

/-- The injection commutes with the norm. -/
theorem f_normHom (a : A) : S.f (normHom S.σA n a) = normHom S.σB n (S.f a) :=
  map_normHom S.f S.hf n a

/-- The surjection commutes with the norm. -/
theorem g_normHom (b : B) : S.g (normHom S.σB n b) = normHom S.σC n (S.g b) :=
  map_normHom S.g S.hg n b

/-- A norm in the total object is fixed by the automorphism. -/
theorem sigmaSubOne_normHom (b : B) : sigmaSubOne S.σB (normHom S.σB n b) = 0 :=
  AddMonoidHom.mem_ker.mp (range_normHom_le_ker_sigmaSubOne S.σB S.hσB ⟨b, rfl⟩)

/-- A difference in the total object has norm zero. -/
theorem normHom_sigmaSubOne (b : B) : normHom S.σB n (sigmaSubOne S.σB b) = 0 :=
  AddMonoidHom.mem_ker.mp (range_sigmaSubOne_le_ker_normHom S.σB S.hσB ⟨b, rfl⟩)

/-! ### The four induced maps -/

/-- The map `Ĥ⁰(A) → Ĥ⁰(B)` induced by the injection. -/
noncomputable abbrev alpha0 : tateH0 S.σA n →+ tateH0 S.σB n := tateH0.map n S.f S.hf

/-- The map `Ĥ⁰(B) → Ĥ⁰(C)` induced by the surjection. -/
noncomputable abbrev beta0 : tateH0 S.σB n →+ tateH0 S.σC n := tateH0.map n S.g S.hg

/-- The map `Ĥ⁻¹(A) → Ĥ⁻¹(B)` induced by the injection. -/
noncomputable abbrev alpha1 : tateHm1 S.σA n →+ tateHm1 S.σB n := tateHm1.map n S.f S.hf

/-- The map `Ĥ⁻¹(B) → Ĥ⁻¹(C)` induced by the surjection. -/
noncomputable abbrev beta1 : tateHm1 S.σB n →+ tateHm1 S.σC n := tateHm1.map n S.g S.hg

/-! ### The connecting map on `Ĥ⁰` -/

/-- The element of `A` produced by the chase defining the connecting map `Ĥ⁰(C) → Ĥ⁻¹(A)`. -/
noncomputable def delta0Raw (c : C) : A := S.finv (sigmaSubOne S.σB (S.sec c))

/-- The defining property of the chase, for a fixed point of the quotient. -/
theorem f_delta0Raw {c : C} (hc : sigmaSubOne S.σC c = 0) :
    S.f (S.delta0Raw c) = sigmaSubOne S.σB (S.sec c) := by
  refine S.f_finv (S.exists_f_eq_of_g_eq_zero ?_)
  rw [S.g_sigmaSubOne, S.g_sec, hc]

/-- The chase lands in the elements of norm zero. -/
theorem normHom_delta0Raw {c : C} (hc : sigmaSubOne S.σC c = 0) :
    normHom S.σA n (S.delta0Raw c) = 0 := by
  apply S.finj
  rw [map_zero, S.f_normHom, S.f_delta0Raw hc]
  exact S.normHom_sigmaSubOne _

/-- The connecting map, before passing to the quotient by the norms. -/
noncomputable def delta0Fun (u : (sigmaSubOne S.σC).ker) : tateHm1 S.σA n :=
  tateHm1.mk S.σA n (S.delta0Raw (u : C)) (S.normHom_delta0Raw (AddMonoidHom.mem_ker.mp u.2))

/-- Unfolding the connecting map, with the proof obligation supplied by the caller. -/
theorem delta0Fun_eq_mk (u : (sigmaSubOne S.σC).ker)
    (h : normHom S.σA n (S.delta0Raw (u : C)) = 0) :
    S.delta0Fun u = tateHm1.mk S.σA n (S.delta0Raw (u : C)) h := rfl

/-- **The chase is independent of the lift.**  Any lift `b` of a fixed point `u` of the quotient,
together with any preimage `a` of `σ b - b`, computes the connecting map at `u`. -/
theorem delta0Fun_eq (u : (sigmaSubOne S.σC).ker) {b : B} (hb : S.g b = (u : C)) {a : A}
    (ha : S.f a = sigmaSubOne S.σB b) (hNa : normHom S.σA n a = 0) :
    S.delta0Fun u = tateHm1.mk S.σA n a hNa := by
  obtain ⟨a₀, ha₀⟩ := S.exists_f_eq_sub (b := S.sec (u : C)) (b' := b) (by rw [S.g_sec, hb])
  have hsec : b + S.f a₀ = S.sec (u : C) := by rw [ha₀]; abel
  have hkey : S.f (S.delta0Raw (u : C)) = S.f (a + sigmaSubOne S.σA a₀) :=
    calc S.f (S.delta0Raw (u : C))
        = sigmaSubOne S.σB (S.sec (u : C)) := S.f_delta0Raw (AddMonoidHom.mem_ker.mp u.2)
      _ = sigmaSubOne S.σB (b + S.f a₀) := by rw [hsec]
      _ = sigmaSubOne S.σB b + sigmaSubOne S.σB (S.f a₀) := map_add _ _ _
      _ = S.f a + S.f (sigmaSubOne S.σA a₀) := by rw [ha, S.f_sigmaSubOne]
      _ = S.f (a + sigmaSubOne S.σA a₀) := (map_add _ _ _).symm
  have hraw : S.delta0Raw (u : C) = a + sigmaSubOne S.σA a₀ := S.finj hkey
  rw [S.delta0Fun_eq_mk u (S.normHom_delta0Raw (AddMonoidHom.mem_ker.mp u.2)),
    tateHm1.mk_eq_mk_iff]
  refine ⟨a₀, ?_⟩
  rw [hraw, sigmaSubOne_apply]
  abel

/-- The connecting map is additive. -/
theorem delta0Fun_add (u v : (sigmaSubOne S.σC).ker) :
    S.delta0Fun (u + v) = S.delta0Fun u + S.delta0Fun v := by
  have hu := S.normHom_delta0Raw (AddMonoidHom.mem_ker.mp u.2)
  have hv := S.normHom_delta0Raw (AddMonoidHom.mem_ker.mp v.2)
  have hb : S.g (S.sec (u : C) + S.sec (v : C)) = ((u + v : (sigmaSubOne S.σC).ker) : C) := by
    rw [map_add, S.g_sec, S.g_sec]
    rfl
  have ha : S.f (S.delta0Raw (u : C) + S.delta0Raw (v : C))
      = sigmaSubOne S.σB (S.sec (u : C) + S.sec (v : C)) := by
    rw [map_add, S.f_delta0Raw (AddMonoidHom.mem_ker.mp u.2),
      S.f_delta0Raw (AddMonoidHom.mem_ker.mp v.2), map_add]
  rw [S.delta0Fun_eq (u + v) hb ha (by rw [map_add, hu, hv, add_zero]),
    S.delta0Fun_eq_mk u hu, S.delta0Fun_eq_mk v hv, ← tateHm1.mk_add]

/-- The connecting map on the fixed points of the quotient, as a homomorphism. -/
noncomputable def delta0Hom : (sigmaSubOne S.σC).ker →+ tateHm1 S.σA n :=
  AddMonoidHom.mk' S.delta0Fun S.delta0Fun_add

/-- The connecting map kills the norms, so it descends to `Ĥ⁰`. -/
theorem delta0Hom_eq_zero_of_mem_range (u : (sigmaSubOne S.σC).ker)
    (hu : (u : C) ∈ (normHom S.σC n).range) : S.delta0Hom u = 0 := by
  obtain ⟨c₀, hc₀⟩ := hu
  have hb : S.g (normHom S.σB n (S.sec c₀)) = (u : C) := by rw [S.g_normHom, S.g_sec, hc₀]
  have ha : S.f 0 = sigmaSubOne S.σB (normHom S.σB n (S.sec c₀)) := by
    rw [map_zero, S.sigmaSubOne_normHom]
  show S.delta0Fun u = 0
  rw [S.delta0Fun_eq u hb ha (by rw [map_zero])]
  exact (tateHm1.mk_eq_zero_iff _ _).mpr ⟨0, by rw [map_zero, sub_zero]⟩

/-- **The connecting map `Ĥ⁰(C) → Ĥ⁻¹(A)`.** -/
noncomputable def delta0 : tateH0 S.σC n →+ tateHm1 S.σA n :=
  QuotientAddGroup.lift _ S.delta0Hom fun u hu => S.delta0Hom_eq_zero_of_mem_range u hu

/-- **The value of the connecting map `Ĥ⁰(C) → Ĥ⁻¹(A)`**, computed from any lift. -/
theorem delta0_mk {c : C} (hc : S.σC c = c) {b : B} (hb : S.g b = c) {a : A}
    (ha : S.f a = sigmaSubOne S.σB b) (hNa : normHom S.σA n a = 0) :
    S.delta0 (tateH0.mk S.σC n c hc) = tateHm1.mk S.σA n a hNa :=
  S.delta0Fun_eq ⟨c, (mem_ker_sigmaSubOne_iff S.σC c).mpr hc⟩ hb ha hNa

/-! ### The connecting map on `Ĥ⁻¹` -/

/-- The element of `A` produced by the chase defining the connecting map `Ĥ⁻¹(C) → Ĥ⁰(A)`. -/
noncomputable def delta1Raw (c : C) : A := S.finv (normHom S.σB n (S.sec c))

/-- The defining property of the chase, for an element of norm zero in the quotient. -/
theorem f_delta1Raw {c : C} (hc : normHom S.σC n c = 0) :
    S.f (S.delta1Raw c) = normHom S.σB n (S.sec c) := by
  refine S.f_finv (S.exists_f_eq_of_g_eq_zero ?_)
  rw [S.g_normHom, S.g_sec, hc]

/-- The chase lands in the fixed points. -/
theorem sigmaSubOne_delta1Raw {c : C} (hc : normHom S.σC n c = 0) :
    S.σA (S.delta1Raw c) = S.delta1Raw c := by
  rw [← sub_eq_zero, ← sigmaSubOne_apply]
  apply S.finj
  rw [map_zero, S.f_sigmaSubOne, S.f_delta1Raw hc]
  exact S.sigmaSubOne_normHom _

/-- The connecting map, before passing to the quotient by the differences. -/
noncomputable def delta1Fun (u : (normHom S.σC n).ker) : tateH0 S.σA n :=
  tateH0.mk S.σA n (S.delta1Raw (u : C)) (S.sigmaSubOne_delta1Raw u.2)

/-- Unfolding the connecting map, with the proof obligation supplied by the caller. -/
theorem delta1Fun_eq_mk (u : (normHom S.σC n).ker) (h : S.σA (S.delta1Raw (u : C))
    = S.delta1Raw (u : C)) :
    S.delta1Fun u = tateH0.mk S.σA n (S.delta1Raw (u : C)) h := rfl

/-- **The chase is independent of the lift.**  Any lift `b` of an element `u` of norm zero in the
quotient, together with any preimage `a` of the norm of `b`, computes the connecting map at `u`. -/
theorem delta1Fun_eq (u : (normHom S.σC n).ker) {b : B} (hb : S.g b = (u : C)) {a : A}
    (ha : S.f a = normHom S.σB n b) (hDa : S.σA a = a) :
    S.delta1Fun u = tateH0.mk S.σA n a hDa := by
  obtain ⟨a₀, ha₀⟩ := S.exists_f_eq_sub (b := S.sec (u : C)) (b' := b) (by rw [S.g_sec, hb])
  have hsec : b + S.f a₀ = S.sec (u : C) := by rw [ha₀]; abel
  have hkey : S.f (S.delta1Raw (u : C)) = S.f (a + normHom S.σA n a₀) :=
    calc S.f (S.delta1Raw (u : C))
        = normHom S.σB n (S.sec (u : C)) := S.f_delta1Raw u.2
      _ = normHom S.σB n (b + S.f a₀) := by rw [hsec]
      _ = normHom S.σB n b + normHom S.σB n (S.f a₀) := map_add _ _ _
      _ = S.f a + S.f (normHom S.σA n a₀) := by rw [ha, S.f_normHom]
      _ = S.f (a + normHom S.σA n a₀) := (map_add _ _ _).symm
  have hraw : S.delta1Raw (u : C) = a + normHom S.σA n a₀ := S.finj hkey
  rw [S.delta1Fun_eq_mk u (S.sigmaSubOne_delta1Raw u.2), tateH0.mk_eq_mk_iff]
  exact ⟨a₀, by rw [hraw]; abel⟩

/-- The connecting map is additive. -/
theorem delta1Fun_add (u v : (normHom S.σC n).ker) :
    S.delta1Fun (u + v) = S.delta1Fun u + S.delta1Fun v := by
  have hb : S.g (S.sec (u : C) + S.sec (v : C)) = ((u + v : (normHom S.σC n).ker) : C) := by
    rw [map_add, S.g_sec, S.g_sec]
    rfl
  have ha : S.f (S.delta1Raw (u : C) + S.delta1Raw (v : C))
      = normHom S.σB n (S.sec (u : C) + S.sec (v : C)) := by
    rw [map_add, S.f_delta1Raw u.2, S.f_delta1Raw v.2, map_add]
  rw [S.delta1Fun_eq (u + v) hb ha
      (by rw [map_add, S.sigmaSubOne_delta1Raw u.2, S.sigmaSubOne_delta1Raw v.2]),
    S.delta1Fun_eq_mk u (S.sigmaSubOne_delta1Raw u.2),
    S.delta1Fun_eq_mk v (S.sigmaSubOne_delta1Raw v.2), ← tateH0.mk_add]

/-- The connecting map on the norm-zero elements of the quotient, as a homomorphism. -/
noncomputable def delta1Hom : (normHom S.σC n).ker →+ tateH0 S.σA n :=
  AddMonoidHom.mk' S.delta1Fun S.delta1Fun_add

/-- The connecting map kills the differences, so it descends to `Ĥ⁻¹`. -/
theorem delta1Hom_eq_zero_of_mem_range (u : (normHom S.σC n).ker)
    (hu : (u : C) ∈ (sigmaSubOne S.σC).range) : S.delta1Hom u = 0 := by
  obtain ⟨c₀, hc₀⟩ := hu
  have hb : S.g (sigmaSubOne S.σB (S.sec c₀)) = (u : C) := by rw [S.g_sigmaSubOne, S.g_sec, hc₀]
  have ha : S.f 0 = normHom S.σB n (sigmaSubOne S.σB (S.sec c₀)) := by
    rw [map_zero, S.normHom_sigmaSubOne]
  show S.delta1Fun u = 0
  rw [S.delta1Fun_eq u hb ha (by rw [map_zero])]
  exact (tateH0.mk_eq_zero_iff _ _).mpr ⟨0, by rw [map_zero]⟩

/-- **The connecting map `Ĥ⁻¹(C) → Ĥ⁰(A)`.** -/
noncomputable def delta1 : tateHm1 S.σC n →+ tateH0 S.σA n :=
  QuotientAddGroup.lift _ S.delta1Hom fun u hu => S.delta1Hom_eq_zero_of_mem_range u hu

/-- **The value of the connecting map `Ĥ⁻¹(C) → Ĥ⁰(A)`**, computed from any lift. -/
theorem delta1_mk {c : C} (hc : normHom S.σC n c = 0) {b : B} (hb : S.g b = c) {a : A}
    (ha : S.f a = normHom S.σB n b) (hDa : S.σA a = a) :
    S.delta1 (tateHm1.mk S.σC n c hc) = tateH0.mk S.σA n a hDa :=
  S.delta1Fun_eq ⟨c, hc⟩ hb ha hDa

/-! ### Exactness of the hexagon -/

/-- **Exactness at `Ĥ⁰(B)`.** -/
theorem range_alpha0_eq_ker_beta0 : (S.alpha0).range = (S.beta0).ker := by
  ext y
  constructor
  · rintro ⟨x, rfl⟩
    obtain ⟨a, ha, rfl⟩ := tateH0.mk_surjective x
    rw [AddMonoidHom.mem_ker]
    show tateH0.map n S.g S.hg (tateH0.map n S.f S.hf (tateH0.mk S.σA n a ha)) = 0
    rw [tateH0.map_mk, tateH0.map_mk, tateH0.mk_eq_zero_iff]
    exact ⟨0, by rw [map_zero, S.g_comp_f]⟩
  · intro hy
    obtain ⟨b, hb, rfl⟩ := tateH0.mk_surjective y
    rw [AddMonoidHom.mem_ker] at hy
    have hy' : tateH0.mk S.σC n (S.g b) (by rw [← S.hg, hb]) = 0 := hy
    obtain ⟨c₀, hc₀⟩ := (tateH0.mk_eq_zero_iff _ _).mp hy'
    obtain ⟨a, ha⟩ : ∃ a, S.f a = b - normHom S.σB n (S.sec c₀) :=
      S.exists_f_eq_of_g_eq_zero (by rw [map_sub, S.g_normHom, S.g_sec, hc₀, sub_self])
    have hfixa : S.σA a = a := by
      apply S.finj
      rw [S.hf a, ha, map_sub, hb]
      have hfix : S.σB (normHom S.σB n (S.sec c₀)) = normHom S.σB n (S.sec c₀) := by
        have := S.sigmaSubOne_normHom (S.sec c₀)
        rwa [sigmaSubOne_apply, sub_eq_zero] at this
      rw [hfix]
    refine ⟨tateH0.mk S.σA n a hfixa, ?_⟩
    show tateH0.map n S.f S.hf (tateH0.mk S.σA n a hfixa) = _
    rw [tateH0.map_mk, tateH0.mk_eq_mk_iff]
    exact ⟨-S.sec c₀, by rw [map_neg, ha]; abel⟩

/-- **Exactness at `Ĥ⁻¹(B)`.** -/
theorem range_alpha1_eq_ker_beta1 : (S.alpha1).range = (S.beta1).ker := by
  ext y
  constructor
  · rintro ⟨x, rfl⟩
    obtain ⟨a, ha, rfl⟩ := tateHm1.mk_surjective x
    rw [AddMonoidHom.mem_ker]
    show tateHm1.map n S.g S.hg (tateHm1.map n S.f S.hf (tateHm1.mk S.σA n a ha)) = 0
    rw [tateHm1.map_mk, tateHm1.map_mk, tateHm1.mk_eq_zero_iff]
    exact ⟨0, by rw [map_zero, S.g_comp_f, sub_zero]⟩
  · intro hy
    obtain ⟨b, hb, rfl⟩ := tateHm1.mk_surjective y
    rw [AddMonoidHom.mem_ker] at hy
    have hy' : tateHm1.mk S.σC n (S.g b) (by rw [← S.g_normHom, hb, map_zero]) = 0 := hy
    obtain ⟨c₀, hc₀⟩ := (tateHm1.mk_eq_zero_iff _ _).mp hy'
    obtain ⟨a, ha⟩ : ∃ a, S.f a = b - sigmaSubOne S.σB (S.sec c₀) :=
      S.exists_f_eq_of_g_eq_zero (by
        rw [map_sub, S.g_sigmaSubOne, S.g_sec, sigmaSubOne_apply, hc₀, sub_self])
    have hNa : normHom S.σA n a = 0 := by
      apply S.finj
      rw [map_zero, S.f_normHom, ha, map_sub, hb, S.normHom_sigmaSubOne, sub_zero]
    refine ⟨tateHm1.mk S.σA n a hNa, ?_⟩
    show tateHm1.map n S.f S.hf (tateHm1.mk S.σA n a hNa) = _
    rw [tateHm1.map_mk, tateHm1.mk_eq_mk_iff]
    exact ⟨-S.sec c₀, by rw [ha, map_neg, sigmaSubOne_apply]; abel⟩

/-- **Exactness at `Ĥ⁰(C)`.** -/
theorem range_beta0_eq_ker_delta0 : (S.beta0).range = (S.delta0).ker := by
  ext y
  constructor
  · rintro ⟨x, rfl⟩
    obtain ⟨b, hb, rfl⟩ := tateH0.mk_surjective x
    rw [AddMonoidHom.mem_ker]
    show S.delta0 (tateH0.map n S.g S.hg (tateH0.mk S.σB n b hb)) = 0
    rw [tateH0.map_mk]
    refine Eq.trans (S.delta0_mk (c := S.g b) (hc := by rw [← S.hg, hb]) (b := b) (hb := rfl)
      (a := 0) (ha := by rw [map_zero, sigmaSubOne_apply, hb, sub_self])
      (hNa := map_zero _)) ?_
    exact (tateHm1.mk_eq_zero_iff _ _).mpr ⟨0, by rw [map_zero, sub_zero]⟩
  · intro hy
    obtain ⟨c, hc, rfl⟩ := tateH0.mk_surjective y
    rw [AddMonoidHom.mem_ker] at hy
    have hdel := S.delta0_mk hc (b := S.sec c) (S.g_sec c)
      (S.f_delta0Raw ((mem_ker_sigmaSubOne_iff S.σC c).mpr hc))
      (S.normHom_delta0Raw ((mem_ker_sigmaSubOne_iff S.σC c).mpr hc))
    rw [hy] at hdel
    obtain ⟨a₀, ha₀⟩ := (tateHm1.mk_eq_zero_iff _ _).mp hdel.symm
    refine ⟨tateH0.mk S.σB n (S.sec c - S.f a₀) ?_, ?_⟩
    · rw [← sub_eq_zero, ← sigmaSubOne_apply, map_sub, ← S.f_delta0Raw
        ((mem_ker_sigmaSubOne_iff S.σC c).mpr hc), ← S.f_sigmaSubOne, ← map_sub,
        sigmaSubOne_apply, ha₀, sub_self, map_zero]
    · show tateH0.map n S.g S.hg _ = _
      rw [tateH0.map_mk, tateH0.mk_eq_mk_iff]
      exact ⟨0, by rw [map_zero, map_sub, S.g_sec, S.g_comp_f]; abel⟩

/-- **Exactness at `Ĥ⁻¹(C)`.** -/
theorem range_beta1_eq_ker_delta1 : (S.beta1).range = (S.delta1).ker := by
  ext y
  constructor
  · rintro ⟨x, rfl⟩
    obtain ⟨b, hb, rfl⟩ := tateHm1.mk_surjective x
    rw [AddMonoidHom.mem_ker]
    show S.delta1 (tateHm1.map n S.g S.hg (tateHm1.mk S.σB n b hb)) = 0
    rw [tateHm1.map_mk]
    refine Eq.trans (S.delta1_mk (c := S.g b) (hc := by rw [← S.g_normHom, hb, map_zero])
      (b := b) (hb := rfl) (a := 0) (ha := by rw [map_zero, hb])
      (hDa := map_zero _)) ?_
    exact (tateH0.mk_eq_zero_iff _ _).mpr ⟨0, by rw [map_zero]⟩
  · intro hy
    obtain ⟨c, hc, rfl⟩ := tateHm1.mk_surjective y
    rw [AddMonoidHom.mem_ker] at hy
    have hdel := S.delta1_mk hc (b := S.sec c) (S.g_sec c) (S.f_delta1Raw hc)
      (S.sigmaSubOne_delta1Raw hc)
    rw [hy] at hdel
    obtain ⟨a₀, ha₀⟩ := (tateH0.mk_eq_zero_iff _ _).mp hdel.symm
    refine ⟨tateHm1.mk S.σB n (S.sec c - S.f a₀) ?_, ?_⟩
    · rw [map_sub, ← S.f_delta1Raw hc, ← S.f_normHom, ← map_sub, ha₀, sub_self, map_zero]
    · show tateHm1.map n S.g S.hg _ = _
      rw [tateHm1.map_mk, tateHm1.mk_eq_mk_iff]
      exact ⟨0, by rw [map_zero, map_sub, S.g_sec, S.g_comp_f]; abel⟩

/-- **Exactness at `Ĥ⁻¹(A)`.** -/
theorem range_delta0_eq_ker_alpha1 : (S.delta0).range = (S.alpha1).ker := by
  ext y
  constructor
  · rintro ⟨x, rfl⟩
    obtain ⟨c, hc, rfl⟩ := tateH0.mk_surjective x
    rw [AddMonoidHom.mem_ker]
    have hmem := (mem_ker_sigmaSubOne_iff S.σC c).mpr hc
    rw [S.delta0_mk hc (b := S.sec c) (S.g_sec c) (S.f_delta0Raw hmem)
      (S.normHom_delta0Raw hmem)]
    show tateHm1.map n S.f S.hf _ = 0
    rw [tateHm1.map_mk, tateHm1.mk_eq_zero_iff]
    exact ⟨S.sec c, by rw [← sigmaSubOne_apply, ← S.f_delta0Raw hmem]⟩
  · intro hy
    obtain ⟨a, ha, rfl⟩ := tateHm1.mk_surjective y
    rw [AddMonoidHom.mem_ker] at hy
    have hy' : tateHm1.mk S.σB n (S.f a) (by rw [← S.f_normHom, ha, map_zero]) = 0 := hy
    obtain ⟨b, hb⟩ := (tateHm1.mk_eq_zero_iff _ _).mp hy'
    have hfixc : S.σC (S.g b) = S.g b := by
      rw [← sub_eq_zero, ← sigmaSubOne_apply, ← S.g_sigmaSubOne, sigmaSubOne_apply, hb,
        S.g_comp_f]
    exact ⟨tateH0.mk S.σC n (S.g b) hfixc,
      S.delta0_mk hfixc (b := b) rfl (by rw [sigmaSubOne_apply, hb]) ha⟩

/-- **Exactness at `Ĥ⁰(A)`.** -/
theorem range_delta1_eq_ker_alpha0 : (S.delta1).range = (S.alpha0).ker := by
  ext y
  constructor
  · rintro ⟨x, rfl⟩
    obtain ⟨c, hc, rfl⟩ := tateHm1.mk_surjective x
    rw [AddMonoidHom.mem_ker]
    rw [S.delta1_mk hc (b := S.sec c) (S.g_sec c) (S.f_delta1Raw hc)
      (S.sigmaSubOne_delta1Raw hc)]
    show tateH0.map n S.f S.hf _ = 0
    rw [tateH0.map_mk, tateH0.mk_eq_zero_iff]
    exact ⟨S.sec c, (S.f_delta1Raw hc).symm⟩
  · intro hy
    obtain ⟨a, ha, rfl⟩ := tateH0.mk_surjective y
    rw [AddMonoidHom.mem_ker] at hy
    have hy' : tateH0.mk S.σB n (S.f a) (by rw [← S.hf, ha]) = 0 := hy
    obtain ⟨b, hb⟩ := (tateH0.mk_eq_zero_iff _ _).mp hy'
    have hNc : normHom S.σC n (S.g b) = 0 := by rw [← S.g_normHom, hb, S.g_comp_f]
    exact ⟨tateHm1.mk S.σC n (S.g b) hNc, S.delta1_mk hNc (b := b) rfl hb.symm ha⟩

/-! ### The numerical form -/

/-- **The hexagon identity for finite Tate groups.**  The six Tate groups of a short exact
sequence sit in a cyclic exact sequence, so the product of the orders at the three odd positions
equals the product at the three even positions.  Dividing, this says that the Herbrand quotient is
multiplicative in short exact sequences. -/
theorem card_tateH0_mul_card_tateH0_mul_card_tateHm1
    [Finite (tateH0 S.σA n)] [Finite (tateH0 S.σB n)] [Finite (tateH0 S.σC n)]
    [Finite (tateHm1 S.σA n)] [Finite (tateHm1 S.σB n)] [Finite (tateHm1 S.σC n)] :
    Nat.card (tateH0 S.σA n) * Nat.card (tateH0 S.σC n) * Nat.card (tateHm1 S.σB n)
      = Nat.card (tateH0 S.σB n) * Nat.card (tateHm1 S.σA n) * Nat.card (tateHm1 S.σC n) :=
  card_mul_card_mul_card_eq_of_exactHexagon S.alpha0 S.beta0 S.delta0 S.alpha1 S.beta1 S.delta1
    S.range_delta1_eq_ker_alpha0 S.range_alpha0_eq_ker_beta0 S.range_beta0_eq_ker_delta0
    S.range_delta0_eq_ker_alpha1 S.range_alpha1_eq_ker_beta1 S.range_beta1_eq_ker_delta1

end TateSES

