import Mathlib

/-!
# Averaging a matrix over a cyclic group

Two automorphisms of a free module of finite rank, written in coordinates as invertible matrices
`SA` and `SB` with `SA ^ n = SB ^ n = 1`, make the matrices `M` with `M * SA = SB * M` into the
equivariant maps from the first module to the second.  Averaging over the cyclic group,

`avgMatrix SA TB n M = ∑ i < n, TB ^ i * M * SA ^ i`  where  `TB` is the inverse of `SB`,

carries every matrix to an equivariant one, and multiplies an already equivariant matrix by `n`.

The point of the construction is that it is written in the ring the two matrices live in.  A matrix
over a larger ring that happens to be equivariant is the average of itself divided by `n`, hence a
combination -- with its own entries as coefficients -- of the averages of the elementary matrices,
and those averages already live in the small ring.  So an equivariant matrix over an extension ring
is always a combination of equivariant matrices over the base ring, and this needs neither a base
change of modules nor a descent argument, only the telescoping sums below.

## Main definitions

* `InverseGalois.CFT.avgMatrix`: the average of a matrix over the cyclic group.

## Main results

* `InverseGalois.CFT.avgMatrix_intertwine`: **the average of any matrix is equivariant.**
* `InverseGalois.CFT.avgMatrix_eq_nsmul`: the average of an equivariant matrix is its multiple by
  the order of the group.
* `InverseGalois.CFT.nsmul_eq_sum_smul_avgMatrix`: **an equivariant matrix is, up to the factor
  `n`, the combination of the averages of the elementary matrices with its own entries as
  coefficients.**
* `InverseGalois.CFT.nsmul_eq_sum_smul_map_avgMatrix`: the same statement for a matrix over an
  extension ring equivariant for the images of the two matrices, the averages being taken over the
  base ring.

## Tags

matrix, cyclic group, averaging, equivariant
-/

namespace InverseGalois.CFT

open Matrix

variable {ι : Type*} [Fintype ι] [DecidableEq ι] {R : Type*} [CommRing R]

/-! ### Powers of a pair of inverse matrices -/

/-- Two matrices inverse to each other on both sides commute. -/
theorem commute_of_mul_eq_one {S T : Matrix ι ι R} (h : T * S = 1) (h' : S * T = 1) :
    Commute T S :=
  h.trans h'.symm

/-- Corresponding powers of two matrices inverse to each other on both sides are again inverse. -/
theorem pow_mul_pow_of_mul_eq_one {S T : Matrix ι ι R} (h : T * S = 1) (h' : S * T = 1) (i : ℕ) :
    T ^ i * S ^ i = 1 := by
  rw [← (commute_of_mul_eq_one h h').mul_pow, h, one_pow]

/-- An equivariant matrix intertwines the powers of the two automorphisms. -/
theorem mul_pow_eq_pow_mul {SA SB M : Matrix ι ι R} (hM : M * SA = SB * M) (i : ℕ) :
    M * SA ^ i = SB ^ i * M := by
  induction i with
  | zero => simp
  | succ i ih => rw [pow_succ, ← mul_assoc, ih, mul_assoc, hM, ← mul_assoc, pow_succ]

/-! ### The averaging operator -/

/-- **The average of a matrix over the cyclic group** generated by a pair of automorphisms, `TB`
playing the role of the inverse of the automorphism of the target. -/
def avgMatrix (SA TB : Matrix ι ι R) (n : ℕ) (M : Matrix ι ι R) : Matrix ι ι R :=
  ∑ i ∈ Finset.range n, TB ^ i * M * SA ^ i

variable (SA TB : Matrix ι ι R) (n : ℕ)

theorem avgMatrix_apply (M : Matrix ι ι R) :
    avgMatrix SA TB n M = ∑ i ∈ Finset.range n, TB ^ i * M * SA ^ i := rfl

theorem avgMatrix_smul (c : R) (M : Matrix ι ι R) :
    avgMatrix SA TB n (c • M) = c • avgMatrix SA TB n M := by
  rw [avgMatrix_apply, avgMatrix_apply, Finset.smul_sum]
  exact Finset.sum_congr rfl fun i _ => by rw [Matrix.mul_smul, Matrix.smul_mul]

theorem avgMatrix_sum {κ : Type*} (s : Finset κ) (f : κ → Matrix ι ι R) :
    avgMatrix SA TB n (∑ k ∈ s, f k) = ∑ k ∈ s, avgMatrix SA TB n (f k) := by
  simp only [avgMatrix_apply, Finset.mul_sum, Finset.sum_mul]
  exact Finset.sum_comm

/-- Averaging commutes with a homomorphism of the coefficient ring. -/
theorem avgMatrix_map {R' : Type*} [CommRing R'] (f : R →+* R') (M : Matrix ι ι R) :
    (avgMatrix SA TB n M).map f = avgMatrix (SA.map f) (TB.map f) n (M.map f) := by
  have h : ∀ X : Matrix ι ι R, X.map f = f.mapMatrix X := fun _ => rfl
  rw [avgMatrix_apply, avgMatrix_apply, h, map_sum]
  exact Finset.sum_congr rfl fun i _ => by
    rw [map_mul, map_mul, map_pow, map_pow, ← h, ← h, ← h]

/-! ### The two properties of the average -/

variable {SA TB n}

/-- **The average of any matrix is equivariant.** -/
theorem avgMatrix_intertwine {SB : Matrix ι ι R} (hSA : SA ^ n = 1) (hSB : SB ^ n = 1)
    (hTB : TB * SB = 1) (hBT : SB * TB = 1) (M : Matrix ι ι R) :
    avgMatrix SA TB n M * SA = SB * avgMatrix SA TB n M := by
  have hTBn : TB ^ n = 1 := by
    have h := pow_mul_pow_of_mul_eq_one hTB hBT n
    rwa [hSB, mul_one] at h
  have hstep : ∀ i : ℕ, TB ^ i * M * SA ^ i * SA = SB * (TB ^ (i + 1) * M * SA ^ (i + 1)) := by
    intro i
    have h1 : SB * TB ^ (i + 1) = TB ^ i := by rw [pow_succ', ← mul_assoc, hBT, one_mul]
    rw [← mul_assoc SB, ← mul_assoc SB, h1, mul_assoc (TB ^ i * M), ← pow_succ]
  have hshift : ∑ i ∈ Finset.range n, TB ^ (i + 1) * M * SA ^ (i + 1)
      = ∑ i ∈ Finset.range n, TB ^ i * M * SA ^ i := by
    have h1 := Finset.sum_range_succ' (fun i => TB ^ i * M * SA ^ i) n
    rw [Finset.sum_range_succ] at h1
    simp only [pow_zero, one_mul, mul_one, hSA, hTBn] at h1
    exact (add_right_cancel h1).symm
  calc avgMatrix SA TB n M * SA
      = ∑ i ∈ Finset.range n, TB ^ i * M * SA ^ i * SA := by
        rw [avgMatrix_apply, Finset.sum_mul]
    _ = ∑ i ∈ Finset.range n, SB * (TB ^ (i + 1) * M * SA ^ (i + 1)) :=
        Finset.sum_congr rfl fun i _ => hstep i
    _ = SB * ∑ i ∈ Finset.range n, TB ^ (i + 1) * M * SA ^ (i + 1) := (Finset.mul_sum _ _ _).symm
    _ = SB * avgMatrix SA TB n M := by rw [hshift, avgMatrix_apply]

/-- **The average of an equivariant matrix is its multiple by the order of the group.** -/
theorem avgMatrix_eq_nsmul {SB M : Matrix ι ι R} (hTB : TB * SB = 1) (hBT : SB * TB = 1)
    (hM : M * SA = SB * M) : avgMatrix SA TB n M = n • M := by
  have h : ∀ i ∈ Finset.range n, TB ^ i * M * SA ^ i = M := fun i _ => by
    rw [mul_assoc, mul_pow_eq_pow_mul hM i, ← mul_assoc, pow_mul_pow_of_mul_eq_one hTB hBT i,
      one_mul]
  rw [avgMatrix_apply, Finset.sum_congr rfl h, Finset.sum_const, Finset.card_range]

/-! ### An equivariant matrix as a combination of integral ones -/

/-- A matrix is the combination of the elementary matrices with its own entries as coefficients. -/
theorem eq_sum_smul_single (M : Matrix ι ι R) :
    M = ∑ p : ι × ι, M p.1 p.2 • single p.1 p.2 (1 : R) := by
  rw [Fintype.sum_prod_type]
  simpa using Matrix.matrix_eq_sum_single M

/-- **An equivariant matrix is, up to the factor `n`, the combination of the averages of the
elementary matrices with its own entries as coefficients.** -/
theorem nsmul_eq_sum_smul_avgMatrix {SB M : Matrix ι ι R} (hTB : TB * SB = 1) (hBT : SB * TB = 1)
    (hM : M * SA = SB * M) :
    n • M = ∑ p : ι × ι, M p.1 p.2 • avgMatrix SA TB n (single p.1 p.2 (1 : R)) :=
  calc n • M = avgMatrix SA TB n M := (avgMatrix_eq_nsmul hTB hBT hM).symm
    _ = avgMatrix SA TB n (∑ p : ι × ι, M p.1 p.2 • single p.1 p.2 (1 : R)) := by
        rw [← eq_sum_smul_single M]
    _ = ∑ p : ι × ι, avgMatrix SA TB n (M p.1 p.2 • single p.1 p.2 (1 : R)) :=
        avgMatrix_sum SA TB n _ _
    _ = ∑ p : ι × ι, M p.1 p.2 • avgMatrix SA TB n (single p.1 p.2 (1 : R)) :=
        Finset.sum_congr rfl fun p _ => avgMatrix_smul SA TB n _ _

/-! ### Extension of the coefficient ring -/

variable (SA TB n)

/-- The average of an elementary matrix over an extension ring is the image of the average over the
base ring. -/
theorem avgMatrix_single_map {R' : Type*} [CommRing R'] (f : R →+* R') (i j : ι) :
    avgMatrix (SA.map f) (TB.map f) n (single i j (1 : R'))
      = (avgMatrix SA TB n (single i j (1 : R))).map f := by
  rw [avgMatrix_map, Matrix.map_single, map_one]

variable {SA TB n}

/-- **A matrix over an extension ring, equivariant for the images of two automorphisms of the base
ring, is up to the factor `n` a combination of matrices coming from the base ring.**  Each of those
matrices is itself equivariant, by `InverseGalois.CFT.avgMatrix_intertwine`. -/
theorem nsmul_eq_sum_smul_map_avgMatrix {R' : Type*} [CommRing R'] (f : R →+* R')
    {SB : Matrix ι ι R} {Φ : Matrix ι ι R'} (hTB : TB * SB = 1) (hBT : SB * TB = 1)
    (hΦ : Φ * SA.map f = SB.map f * Φ) :
    n • Φ = ∑ p : ι × ι, Φ p.1 p.2 • (avgMatrix SA TB n (single p.1 p.2 (1 : R))).map f := by
  have hmap : ∀ X : Matrix ι ι R, X.map f = f.mapMatrix X := fun _ => rfl
  have hTB' : TB.map f * SB.map f = 1 := by
    rw [hmap, hmap, ← map_mul, hTB, map_one]
  have hBT' : SB.map f * TB.map f = 1 := by
    rw [hmap, hmap, ← map_mul, hBT, map_one]
  rw [nsmul_eq_sum_smul_avgMatrix hTB' hBT' hΦ]
  exact Finset.sum_congr rfl fun p _ => by rw [avgMatrix_single_map SA TB n f]

end InverseGalois.CFT
