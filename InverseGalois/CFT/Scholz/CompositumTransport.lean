import Mathlib
import InverseGalois.CFT.Compositum
import InverseGalois.CFT.CompositumBase
import InverseGalois.CFT.Scholz.LocalTransport
import InverseGalois.NumberTheory.SplitSubfield

/-!
# The local hypothesis of the central embedding criterion over a compositum

The Scholz-Reichardt construction builds a field `A` over the rationals and then enlarges the base
field to a cyclotomic field `B`, working over the compositum `A ⊔ B` viewed as an extension of `B`.
This module reads the local hypothesis of the central embedding criterion over that compositum off
the arithmetic of `A` and the splitting behaviour of `B`.

Both subfields of the ambient field reappear inside the compositum as `IntermediateField.restrict`,
and every invariant used by the criterion transports along the isomorphism
`IntermediateField.restrict_algEquiv` between a subfield and its copy.  The ambient field is taken
with its canonical rational algebra structure, which is what makes those copies interchangeable
with the originals.

## Main results

* `InverseGalois.CFT.baseSubfield_eq_restrict`: the subfield of the compositum generated by the
  enlarged base field is the copy of that base field.
* `InverseGalois.CFT.isCyclic_and_exists_hasResidueChar_sup`: **at a place of the compositum that
  ramifies over the enlarged base field, the decomposition group is cyclic and the residue
  characteristic is congruent to one modulo the product of the given prime with the order of that
  group.**

## Tags

compositum, base change, Scholz condition, decomposition group, residue characteristic
-/

namespace InverseGalois.CFT

open IsDedekindDomain IntermediateField MulAction NumberField InverseGalois.NumberTheory

set_option synthInstance.maxHeartbeats 400000

variable {L : Type*} [Field L] [CharZero L]

/-! ### The copy of a subfield inside a larger one -/

section Restrict

variable {E E' : IntermediateField ℚ L} (h : E ≤ E')

instance numberField_restrict [NumberField ↥E'] :
    NumberField ↥(IntermediateField.restrict h) := ⟨⟩

/-- A subfield that is normal over the rationals has a normal copy. -/
instance normal_restrict [Normal ℚ ↥E] : Normal ℚ ↥(IntermediateField.restrict h) :=
  Normal.of_algEquiv (restrict_algEquiv h)

/-- The Scholz condition passes to the copy of a subfield inside a larger one. -/
theorem isScholz_restrict [NumberField ↥E] [NumberField ↥E'] {ℓ n : ℕ} (hs : IsScholz ℓ n ↥E) :
    IsScholz ℓ n ↥(IntermediateField.restrict h) :=
  IsScholz.of_ringEquiv (restrict_algEquiv h).toRingEquiv hs

/-- Being a `p`-group passes to the Galois group of the copy of a subfield. -/
theorem isPGroup_restrict {ℓ : ℕ} (hG : IsPGroup ℓ Gal(↥E/ℚ)) :
    IsPGroup ℓ Gal(↥(IntermediateField.restrict h)/ℚ) :=
  hG.of_equiv (AlgEquiv.autCongr (restrict_algEquiv h))

/-- A subfield and its copy have Galois groups of the same order. -/
theorem card_gal_restrict :
    Nat.card Gal(↥(IntermediateField.restrict h)/ℚ) = Nat.card Gal(↥E/ℚ) :=
  Nat.card_congr (AlgEquiv.autCongr (restrict_algEquiv h)).symm.toEquiv

/-- A subfield and its copy ramify at the same rational primes. -/
theorem ramifiedSet_restrict [NumberField ↥E] [NumberField ↥E'] :
    ramifiedSet ↥(IntermediateField.restrict h) = ramifiedSet ↥E :=
  (ramifiedSet_eq_of_ringEquiv (restrict_algEquiv h).toRingEquiv).symm

/-- A rational prime splitting completely in a subfield splits completely in its copy. -/
theorem splitsCompletely_restrict [NumberField ↥E] [NumberField ↥E'] {p : ℕ} (hp : p.Prime)
    (hs : SplitsCompletely ↥E p) : SplitsCompletely ↥(IntermediateField.restrict h) p :=
  splitsCompletely_of_ringEquiv (restrict_algEquiv h).symm.toRingEquiv hp hs

end Restrict

/-! ### The enlarged base field inside the compositum -/

variable (A B : IntermediateField ℚ L) [NumberField ↥A] [NumberField ↥B] [IsGalois ℚ ↥A]
  [IsGalois ℚ ↥B]

instance numberField_sup : NumberField ↥(A ⊔ B) := ⟨⟩

instance numberField_supOver : NumberField ↥(supOver A B) := ⟨⟩

omit [NumberField ↥A] [NumberField ↥B] [IsGalois ℚ ↥A] [IsGalois ℚ ↥B] in
/-- **The subfield of the compositum generated by the enlarged base field is the copy of that
base field.** -/
theorem baseSubfield_eq_restrict :
    baseSubfield ↥B ↥(supOver A B) = IntermediateField.restrict (le_sup_right : B ≤ A ⊔ B) := by
  ext x
  rw [IntermediateField.mem_restrictScalars, IntermediateField.mem_bot, mem_restrict]
  constructor
  · rintro ⟨y, rfl⟩
    exact y.2
  · intro hx
    exact ⟨⟨(x : L), hx⟩, Subtype.ext rfl⟩

/-! ### The local hypothesis over the compositum -/

set_option maxHeartbeats 1000000 in
/-- **At a place of the compositum ramifying over the enlarged base field, the decomposition group
is cyclic and the residue characteristic is congruent to one modulo the product of the given prime
with the order of that group.**  This is the local hypothesis of the central embedding criterion,
read off the Scholz condition for the original field and the splitting behaviour of the enlarged
base field at the primes ramifying in it. -/
theorem isCyclic_and_exists_hasResidueChar_sup {ℓ M : ℕ} (hℓ : ℓ.Prime)
    (hG : IsPGroup ℓ Gal(↥A/ℚ)) (hs : IsScholz ℓ (M + 1) ↥A)
    (hdvd : Nat.card Gal(↥A/ℚ) ∣ ℓ ^ M)
    (hsplit : ∀ p ∈ ramifiedSet ↥A, SplitsCompletely ↥B p)
    (v : HeightOneSpectrum (𝓞 ↥(supOver A B)))
    (hnr : ¬ Algebra.IsUnramifiedAt (𝓞 ↥B) v.asIdeal) :
    IsCyclic ↥(stabilizer Gal(↥(supOver A B)/↥B) v) ∧ ∃ p e : ℕ,
      HasResidueChar (v.adicCompletion ↥(supOver A B)) p e ∧
        (∀ x : v.adicCompletion ↥(supOver A B), Valued.v x ≤ 1 →
          ∃ b : ℤ, Valued.v (x - (b : v.adicCompletion ↥(supOver A B))) < 1) ∧
        ℓ * Nat.card ↥(stabilizer Gal(↥(supOver A B)/↥B) v) ∣ p - 1 := by
  have hBnormal : Normal ℚ ↥(baseSubfield ↥B ↥(supOver A B)) := by
    rw [baseSubfield_eq_restrict]
    exact normal_restrict le_sup_right
  have hAB : IntermediateField.restrict (le_sup_left : A ≤ A ⊔ B) ⊔
      baseSubfield ↥B ↥(supOver A B) = ⊤ := by
    rw [baseSubfield_eq_restrict]
    exact restrict_sup_restrict A B
  have hdvd' : Nat.card Gal(↥(IntermediateField.restrict (le_sup_left : A ≤ A ⊔ B))/ℚ) ∣ ℓ ^ M := by
    rw [card_gal_restrict]
    exact hdvd
  have hsplit' : ∀ p ∈ ramifiedSet ↥(IntermediateField.restrict (le_sup_left : A ≤ A ⊔ B)),
      SplitsCompletely ↥(baseSubfield ↥B ↥(supOver A B)) p := by
    intro p hp
    rw [ramifiedSet_restrict le_sup_left] at hp
    rw [baseSubfield_eq_restrict]
    exact splitsCompletely_restrict le_sup_right hp.1 (hsplit p hp)
  exact isCyclic_and_exists_hasResidueChar_base (N := ↥(supOver A B)) (k := ↥B)
    (A := IntermediateField.restrict (le_sup_left : A ≤ A ⊔ B))
    (hAnormal := normal_restrict le_sup_left) (hBnormal := hBnormal) hAB hℓ
    (isPGroup_restrict le_sup_left hG) (isScholz_restrict le_sup_left hs) hdvd' hsplit' v hnr

end InverseGalois.CFT
