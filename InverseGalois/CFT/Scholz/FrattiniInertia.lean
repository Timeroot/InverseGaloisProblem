import Mathlib
import InverseGalois.CFT.Compositum
import InverseGalois.CFT.Scholz.AbelianInertia
import InverseGalois.CFT.Scholz.AbelianInertiaTransport
import InverseGalois.CFT.Scholz.CyclicSupplement
import InverseGalois.CFT.Scholz.InertSubfield

/-!
# Cyclic abelianized inertia from a small Frattini quotient

Let `ℓ` be a prime and let `M` be a Galois number field whose Galois group is an `ℓ`-group.  At a
prime `P` of `M` above `ℓ`, write `D` for the decomposition group and `I` for the inertia subgroup.
The image of `I` in the abelianization of `D` is generated by the elements it contributes to the
Frattini quotient `D^ab / (D^ab)^ℓ` together with `ℓ`-th powers, and the quotient `D / I` is cyclic.
So if the image of inertia in the Frattini quotient is as small as possible — of order at most `ℓ` —
and if the cyclic quotient `D / I` is *large*, namely of order divisible by the exponent of the
whole Galois group, then every element of `D` is a power of one fixed element times an element of
`I`, and the abelianized inertia subgroup turns out to be cyclic.

The largeness hypothesis is not automatic, but it can always be arranged by enlarging the field:
adjoining a cyclic extension of degree `ℓ ^ n` in which `ℓ` is inert forces the residue degree at
`ℓ`, and hence the order of the cyclic quotient `D / I`, to be divisible by `ℓ ^ n`.  Choosing `n`
past the exponent of the original group and using that cyclicity of the abelianized inertia
subgroup descends to a normal subextension gives the statement for the original field.

## Main definitions

* `InverseGalois.CFT.IsFrattiniInertiaSmallAt`: the assertion that, for every Galois number field
  inside a fixed algebraic closure of `ℚ` whose Galois group is an `ℓ`-group and every prime above
  `ℓ`, the image of the abelianized inertia subgroup in the Frattini quotient of the abelianized
  decomposition group has order at most `ℓ`.

## Main results

* `InverseGalois.CFT.isCyclic_abelianInertia_of_card_le`: a small image in the Frattini quotient
  together with a large cyclic quotient `D / I` makes the abelianized inertia subgroup cyclic.
* `InverseGalois.CFT.card_quotient_inertia_eq_inertiaDeg`: the quotient of the decomposition group
  by the inertia subgroup has order the residue degree.
* `InverseGalois.CFT.isAbelianInertiaCyclicAt_of_isFrattiniInertiaSmallAt`: **for an odd prime, a
  small image in the Frattini quotient implies that the abelianized inertia subgroup is cyclic in
  every `ℓ`-extension**.

## Tags

inertia subgroup, decomposition group, Frattini quotient, residue degree, Scholz–Reichardt
-/

open NumberField InverseGalois.NumberTheory Module

open scoped Pointwise

namespace InverseGalois.CFT

set_option synthInstance.maxHeartbeats 400000

variable {ℓ : ℕ}

section Core

variable {M : Type} [Field M] [NumberField M] [IsGalois ℚ M]

omit [IsGalois ℚ M] in
/-- Let `P` be a prime above `ℓ` in a number field whose Galois group over `ℚ` has exponent
dividing `ℓ ^ n`.  If the quotient of the decomposition group by the inertia subgroup has order
divisible by `ℓ ^ n`, and if the image of the abelianized inertia subgroup in the Frattini quotient
of the abelianized decomposition group has order at most `ℓ`, then the abelianized inertia subgroup
is cyclic. -/
theorem isCyclic_abelianInertia_of_card_le (hℓ : ℓ.Prime) {n : ℕ} (hn : n ≠ 0)
    (hexp : ∀ x : Gal(M/ℚ), x ^ ℓ ^ n = 1)
    (P : Ideal (𝓞 M)) [P.IsPrime] [P.LiesOver (Ideal.span {(ℓ : ℤ)})]
    (hdvd : ℓ ^ n ∣ Nat.card (↥(MulAction.stabilizer Gal(M/ℚ) P) ⧸
      (Ideal.inertia Gal(M/ℚ) P).subgroupOf (MulAction.stabilizer Gal(M/ℚ) P)))
    (hsmall : Nat.card ↥((abelianInertia P).map (QuotientGroup.mk'
      (MonoidHom.range (powMonoidHom ℓ :
        Abelianization ↥(MulAction.stabilizer Gal(M/ℚ) P) →*
          Abelianization ↥(MulAction.stabilizer Gal(M/ℚ) P))))) ≤ ℓ) :
    IsCyclic ↥(abelianInertia P) := by
  have hpg : IsPGroup ℓ Gal(M/ℚ) := fun g => ⟨n, hexp g⟩
  set D := MulAction.stabilizer Gal(M/ℚ) P with hD
  set N := (Ideal.inertia Gal(M/ℚ) P).subgroupOf D with hN
  haveI : IsCyclic (↥D ⧸ N) := isCyclic_stabilizer_quotient_inertia hℓ P
  have habs : abelianInertia P = N.map (Abelianization.of : ↥D →* Abelianization ↥D) := rfl
  have hpgAb : IsPGroup ℓ (Abelianization ↥D) := (hpg.to_subgroup D).to_quotient (commutator ↥D)
  obtain ⟨g, hg⟩ := IsCyclic.exists_generator (α := ↥D ⧸ N)
  obtain ⟨σ, rfl⟩ := QuotientGroup.mk_surjective g
  have hgen : ∀ s : ↥D, ∃ k : ℤ, s * (σ ^ k)⁻¹ ∈ N := by
    intro s
    obtain ⟨k, hk⟩ := Subgroup.mem_zpowers_iff.mp (hg (QuotientGroup.mk s))
    refine ⟨k, ?_⟩
    have h1 : (QuotientGroup.mk (σ ^ k) : ↥D ⧸ N) = QuotientGroup.mk s := by
      rw [QuotientGroup.mk_zpow]
      exact hk
    exact (inferInstanceAs N.Normal).mem_comm (QuotientGroup.eq.mp h1)
  have hord : ∀ k : ℤ, σ ^ k ∈ N → ((ℓ : ℤ) ^ n) ∣ k := by
    intro k hk
    have h1 : ((QuotientGroup.mk σ : ↥D ⧸ N)) ^ k = 1 := by
      rw [← QuotientGroup.mk_zpow]
      exact (QuotientGroup.eq_one_iff _).mpr hk
    have h2 : (orderOf (QuotientGroup.mk σ : ↥D ⧸ N) : ℤ) ∣ k :=
      orderOf_dvd_iff_zpow_eq_one.mpr h1
    refine dvd_trans ?_ h2
    rw [orderOf_eq_card_of_forall_mem_zpowers hg]
    exact_mod_cast Int.natCast_dvd_natCast.mpr hdvd
  have hcomm : commutator ↥D ≤ N :=
    (commutator_eq_commutator_top_of_isCyclic_quotient N).le.trans
      (Subgroup.commutator_le_left N ⊤)
  have hσpow : σ ^ ℓ ^ n = 1 := by
    refine Subtype.ext ?_
    rw [Subgroup.coe_pow, Subgroup.coe_one]
    exact hexp (σ : Gal(M/ℚ))
  have hpow : ∀ w : Abelianization ↥D, w ^ ℓ ∈ abelianInertia P →
      w ^ ℓ ∈ (abelianInertia P).map (powMonoidHom ℓ) := by
    intro w hw
    rw [habs] at hw ⊢
    exact pow_mem_map_powMonoidHom_abelianization hℓ (Nat.one_le_iff_ne_zero.mpr hn) hgen hord
      hcomm hσpow hw
  exact isCyclic_subgroup_of_card_map_le hℓ (hpgAb.to_subgroup _) hsmall hpow

/-- The quotient of the decomposition group at a prime above `ℓ` by the inertia subgroup has order
the residue degree of that prime. -/
theorem card_quotient_inertia_eq_inertiaDeg (hℓ : ℓ.Prime) (P : Ideal (𝓞 M)) [P.IsPrime]
    [P.LiesOver (Ideal.span {(ℓ : ℤ)})] :
    Nat.card (↥(MulAction.stabilizer Gal(M/ℚ) P) ⧸
        (Ideal.inertia Gal(M/ℚ) P).subgroupOf (MulAction.stabilizer Gal(M/ℚ) P))
      = (Ideal.span {(ℓ : ℤ)}).inertiaDeg P := by
  have hcardN : Nat.card
      ↥((Ideal.inertia Gal(M/ℚ) P).subgroupOf (MulAction.stabilizer Gal(M/ℚ) P))
      = Nat.card ↥(Ideal.inertia Gal(M/ℚ) P) :=
    Nat.card_congr (Subgroup.subgroupOfEquivOfLe (Ideal.inertia_le_stabilizer P)).toEquiv
  have hepos : 0 < Ideal.ramificationIdx (algebraMap ℤ (𝓞 M)) (Ideal.span {(ℓ : ℤ)}) P := by
    rw [← card_inertia_eq_ramificationIdx_span hℓ P]
    exact Nat.card_pos
  have hsplit := Subgroup.card_eq_card_quotient_mul_card_subgroup
    ((Ideal.inertia Gal(M/ℚ) P).subgroupOf (MulAction.stabilizer Gal(M/ℚ) P))
  rw [hcardN, card_inertia_eq_ramificationIdx_span hℓ P, card_stabilizer_eq_mul M hℓ P] at hsplit
  refine Nat.eq_of_mul_eq_mul_right hepos ?_
  rw [← hsplit]
  exact Nat.mul_comm _ _

/-- If a prime above `ℓ` is inert, that is, if its inertia subgroup is trivial and its
decomposition group is everything, then its residue degree is the degree of the field. -/
theorem inertiaDeg_eq_card_of_inert (hℓ : ℓ.Prime) (P : Ideal (𝓞 M)) [P.IsPrime]
    [P.LiesOver (Ideal.span {(ℓ : ℤ)})] (hI : Ideal.inertia Gal(M/ℚ) P = ⊥)
    (hD : MulAction.stabilizer Gal(M/ℚ) P = ⊤) :
    (Ideal.span {(ℓ : ℤ)}).inertiaDeg P = Nat.card Gal(M/ℚ) := by
  have h1 := card_stabilizer_eq_mul M hℓ P
  have he : Ideal.ramificationIdx (algebraMap ℤ (𝓞 M)) (Ideal.span {(ℓ : ℤ)}) P = 1 := by
    rw [← card_inertia_eq_ramificationIdx_span hℓ P, hI, Nat.card_eq_one_iff_unique]
    exact ⟨inferInstance, inferInstance⟩
  rw [he, one_mul, hD, Nat.card_congr Subgroup.topEquiv.toEquiv] at h1
  exact h1.symm

end Core

section Tower

variable {L : Type} [Field L] [NumberField L]

/-- Residue degrees are multiplicative in a tower, so the residue degree of a prime in a
subextension divides the residue degree of the prime above it. -/
theorem inertiaDeg_under_dvd (hℓ : ℓ.Prime) (V : IntermediateField ℚ L) (P : Ideal (𝓞 L))
    [P.IsPrime] [P.LiesOver (Ideal.span {(ℓ : ℤ)})] :
    (Ideal.span {(ℓ : ℤ)}).inertiaDeg (P.under (𝓞 ↥V)) ∣
      (Ideal.span {(ℓ : ℤ)}).inertiaDeg P := by
  haveI : NumberField ↥V := ⟨⟩
  haveI := liesOver_under_intermediateField (p := ℓ) V P
  haveI := isMaximal_span_prime hℓ
  haveI : P.IsMaximal := isMaximal_of_ne_bot P (ne_bot_of_liesOver_natCast hℓ inferInstance)
  haveI : (P.under (𝓞 ↥V)).IsMaximal :=
    Ideal.IsMaximal.of_isMaximal_liesOver P (P.under (𝓞 ↥V))
  exact ⟨Ideal.inertiaDeg (P.under (𝓞 ↥V)) P,
    Ideal.inertiaDeg_algebra_tower (Ideal.span {(ℓ : ℤ)}) (P.under (𝓞 ↥V)) P⟩

end Tower

section Compositum

variable {L : Type} [Field L] [NumberField L] [IsGalois ℚ L]

/-- If a Galois number field of exponent dividing `ℓ ^ n` contains a normal subextension of degree
`ℓ ^ n` in which the given prime above `ℓ` is inert, then the largeness hypothesis on the quotient
of the decomposition group by inertia is automatic; so a small image in the Frattini quotient makes
the abelianized inertia subgroup cyclic, and this descends to any normal subextension. -/
theorem isCyclic_abelianInertia_under_of_inert (hℓ : ℓ.Prime) {n : ℕ} (hn : n ≠ 0)
    (W V : IntermediateField ℚ L) [Normal ℚ ↥W] [NumberField ↥W] [Normal ℚ ↥V] [NumberField ↥V]
    (hexp : ∀ x : Gal(L/ℚ), x ^ ℓ ^ n = 1) (hVcard : Nat.card Gal(↥V/ℚ) = ℓ ^ n)
    (P : Ideal (𝓞 L)) [P.IsPrime] [P.LiesOver (Ideal.span {(ℓ : ℤ)})]
    (hVbot : Ideal.inertia Gal(↥V/ℚ) (P.under (𝓞 ↥V)) = ⊥)
    (hVtop : MulAction.stabilizer Gal(↥V/ℚ) (P.under (𝓞 ↥V)) = ⊤)
    (hsmall : Nat.card ↥((abelianInertia P).map (QuotientGroup.mk'
      (MonoidHom.range (powMonoidHom ℓ :
        Abelianization ↥(MulAction.stabilizer Gal(L/ℚ) P) →*
          Abelianization ↥(MulAction.stabilizer Gal(L/ℚ) P))))) ≤ ℓ) :
    IsCyclic ↥(abelianInertia (P.under (𝓞 ↥W))) := by
  haveI : IsGalois ℚ ↥V := ⟨⟩
  haveI := liesOver_under_intermediateField (p := ℓ) V P
  haveI : (P.under (𝓞 ↥V)).IsPrime := inferInstance
  have hdvd : ℓ ^ n ∣ Nat.card (↥(MulAction.stabilizer Gal(L/ℚ) P) ⧸
      (Ideal.inertia Gal(L/ℚ) P).subgroupOf (MulAction.stabilizer Gal(L/ℚ) P)) := by
    rw [card_quotient_inertia_eq_inertiaDeg hℓ P, ← hVcard,
      ← inertiaDeg_eq_card_of_inert hℓ (P.under (𝓞 ↥V)) hVbot hVtop]
    exact inertiaDeg_under_dvd hℓ V P
  exact isCyclic_abelianInertia_under W hℓ P
    (isCyclic_abelianInertia_of_card_le hℓ hn hexp P hdvd hsmall)

end Compositum

section Main

/-- The image of the abelianized inertia subgroup in the Frattini quotient of the abelianized
decomposition group has order at most `ℓ`, at every prime above `ℓ` of every Galois number field
inside a fixed algebraic closure of `ℚ` whose Galois group is an `ℓ`-group. -/
def IsFrattiniInertiaSmallAt (ℓ : ℕ) : Prop :=
  ∀ (A : IntermediateField ℚ (AlgebraicClosure ℚ)) [NumberField ↥A] [IsGalois ℚ ↥A],
    IsPGroup ℓ Gal(↥A/ℚ) →
    ∀ (P : Ideal (𝓞 ↥A)) [P.IsPrime] [P.LiesOver (Ideal.span {(ℓ : ℤ)})],
      Nat.card ↥((abelianInertia P).map (QuotientGroup.mk'
        (MonoidHom.range (powMonoidHom ℓ :
          Abelianization ↥(MulAction.stabilizer Gal(↥A/ℚ) P) →*
            Abelianization ↥(MulAction.stabilizer Gal(↥A/ℚ) P))))) ≤ ℓ

set_option maxHeartbeats 2000000 in
/-- For an odd prime `ℓ`, if the image of the abelianized inertia subgroup in the Frattini quotient
of the abelianized decomposition group is always of order at most `ℓ`, then the abelianized inertia
subgroup at a prime above `ℓ` is cyclic in every Galois number field whose Galois group is an
`ℓ`-group.

The passage from the Frattini bound to cyclicity needs the quotient of the decomposition group by
inertia to be large; this is arranged by adjoining a cyclic field of degree `ℓ ^ (m + 1)` in which
`ℓ` is inert, where `ℓ ^ m` is the degree of the given field. -/
theorem isAbelianInertiaCyclicAt_of_isFrattiniInertiaSmallAt (hℓ : ℓ.Prime) (hodd : Odd ℓ)
    (h : IsFrattiniInertiaSmallAt ℓ) : IsAbelianInertiaCyclicAt ℓ := by
  haveI := Fact.mk hℓ
  intro A _ _ hM P _ _
  obtain ⟨m, hm⟩ := (IsPGroup.iff_card (p := ℓ) (G := Gal(↥A/ℚ))).mp hM
  have hexpA : ∀ x : Gal(↥A/ℚ), x ^ ℓ ^ (m + 1) = 1 := by
    intro x
    rw [pow_succ, pow_mul, ← hm, pow_card_eq_one', one_pow]
  obtain ⟨U, hUnf, hUgal, -, hUrank, hUinert⟩ :=
    exists_intermediateField_cyclic_pow_inert (ℓ := ℓ) (n := m + 1) hodd (Nat.succ_ne_zero m)
  haveI : NumberField ↥U := hUnf
  haveI : IsGalois ℚ ↥U := hUgal
  haveI : NumberField ↥(A ⊔ U) := ⟨⟩
  haveI : IsGalois ℚ ↥(A ⊔ U) := inferInstance
  set A₀ : IntermediateField ℚ ↥(A ⊔ U) :=
    IntermediateField.restrict (le_sup_left : A ≤ A ⊔ U) with hA₀def
  set U₀ : IntermediateField ℚ ↥(A ⊔ U) :=
    IntermediateField.restrict (le_sup_right : U ≤ A ⊔ U) with hU₀def
  haveI : Normal ℚ ↥A₀ :=
    Normal.of_algEquiv (IntermediateField.restrict_algEquiv (le_sup_left : A ≤ A ⊔ U))
  haveI : Normal ℚ ↥U₀ :=
    Normal.of_algEquiv (IntermediateField.restrict_algEquiv (le_sup_right : U ≤ A ⊔ U))
  haveI : NumberField ↥A₀ := ⟨⟩
  haveI : NumberField ↥U₀ := ⟨⟩
  haveI : IsGalois ℚ ↥A₀ := ⟨⟩
  haveI : IsGalois ℚ ↥U₀ := ⟨⟩
  -- the compositum has exponent dividing `ℓ ^ (m + 1)`
  have hUcard : Nat.card Gal(↥U/ℚ) = ℓ ^ (m + 1) := by
    rw [IsGalois.card_aut_eq_finrank, hUrank]
  have hexpMM : ∀ x : Gal(↥(A ⊔ U)/ℚ), x ^ ℓ ^ (m + 1) = 1 := by
    intro x
    refine galRestrictProd_injective A U ?_
    rw [map_pow, map_one]
    refine Prod.ext ?_ ?_
    · show (galRestrictProd A U x).1 ^ ℓ ^ (m + 1) = 1
      exact hexpA _
    · show (galRestrictProd A U x).2 ^ ℓ ^ (m + 1) = 1
      rw [← hUcard]
      exact pow_card_eq_one'
  have hVcard : Nat.card Gal(↥U₀/ℚ) = ℓ ^ (m + 1) := by
    rw [← Nat.card_congr
        (AlgEquiv.autCongr
          (IntermediateField.restrict_algEquiv (le_sup_right : U ≤ A ⊔ U))).toEquiv, hUcard]
  -- a prime of the compositum above the given one
  set eA : ↥A₀ ≃ₐ[ℚ] ↥A :=
    (IntermediateField.restrict_algEquiv (le_sup_left : A ≤ A ⊔ U)).symm with heA
  set P₀ : Ideal (𝓞 ↥A₀) := Ideal.comap (mapAlgEquivInt (eA : ↥A₀ ≃+* ↥A)) P with hP₀def
  haveI : P₀.IsPrime := Ideal.comap_isPrime _ _
  haveI : P₀.LiesOver (Ideal.span {(ℓ : ℤ)}) := liesOver_comap_mapAlgEquivInt (p := ℓ) eA P
  obtain ⟨⟨P', hP'prime, hP'over⟩⟩ : Nonempty (Ideal.primesOver P₀ (𝓞 ↥(A ⊔ U))) := inferInstance
  haveI : P'.IsPrime := hP'prime
  haveI : P'.LiesOver P₀ := hP'over
  haveI : P'.LiesOver (Ideal.span {(ℓ : ℤ)}) :=
    Ideal.LiesOver.trans P' P₀ (Ideal.span {(ℓ : ℤ)})
  haveI := liesOver_under_intermediateField (p := ℓ) U₀ P'
  have hVbot : Ideal.inertia Gal(↥U₀/ℚ) (P'.under (𝓞 ↥U₀)) = ⊥ :=
    inertia_eq_bot_of_algEquiv (IntermediateField.restrict_algEquiv (le_sup_right : U ≤ A ⊔ U))
      hℓ (fun Q hQ hQo => (hUinert Q hQ hQo).1) _
  have hVtop : MulAction.stabilizer Gal(↥U₀/ℚ) (P'.under (𝓞 ↥U₀)) = ⊤ :=
    stabilizer_eq_top_of_algEquiv (IntermediateField.restrict_algEquiv (le_sup_right : U ≤ A ⊔ U))
      hℓ (fun Q hQ hQo => (hUinert Q hQ hQo).2) _
  have key := isCyclic_abelianInertia_under_of_inert hℓ (Nat.succ_ne_zero m) A₀ U₀ hexpMM
    hVcard P' hVbot hVtop (h (A ⊔ U) (fun g => ⟨m + 1, hexpMM g⟩) P')
  rw [← hP'over.over] at key
  exact isCyclic_abelianInertia_of_algEquiv eA P key

end Main

end InverseGalois.CFT
