import Mathlib

/-!
# One generator modulo `ℓ`-th powers

A finite commutative `ℓ`-group is cyclic as soon as a single element generates it modulo the
`ℓ`-th powers: repeating the substitution of that description into itself replaces the exponent
`ℓ` by `ℓ ^ j` for every `j`, and past the order of the group the `ℓ ^ j`-th powers are trivial.

The same bookkeeping identifies the `ℓ`-th powers of a subgroup inside the `ℓ`-th powers of the
ambient group, in the situation where the quotient by the subgroup is cyclic of order `ℓ ^ n`
generated by an element whose `ℓ ^ n`-th power is already an `ℓ`-th power of the subgroup: an
element whose `ℓ`-th power lands in the subgroup has its generator exponent divisible by
`ℓ ^ (n - 1)`, so that `ℓ`-th power is an `ℓ`-th power of the subgroup.

Putting the two together: a subgroup of a finite commutative `ℓ`-group whose image modulo the
`ℓ`-th powers of the ambient group has order at most `ℓ` is cyclic.

## Main results

* `InverseGalois.CFT.isCyclic_of_forall_exists_zpow_mul_pow`: **a finite commutative `ℓ`-group
  generated by one element modulo `ℓ`-th powers is cyclic.**
* `InverseGalois.CFT.pow_mem_map_powMonoidHom`: **the `ℓ`-th powers of the ambient group meeting a
  subgroup with cyclic quotient of order `ℓ ^ n` are `ℓ`-th powers of the subgroup.**
* `InverseGalois.CFT.isCyclic_subgroup_of_card_map_le`: **a subgroup with small image modulo the
  `ℓ`-th powers of the ambient group is cyclic**, provided the `ℓ`-th powers of the ambient group
  meeting it are `ℓ`-th powers of it.
* `InverseGalois.CFT.pow_mem_map_powMonoidHom_abelianization`: the same identification of `ℓ`-th
  powers, for the image of a subgroup in the abelianization of the ambient group.

## Tags

cyclic group, `p`-group, Frattini quotient, commutative group
-/

namespace InverseGalois.CFT

variable {A : Type*} [CommGroup A] {ℓ : ℕ}

/-! ### Raising the exponent -/

/-- An element generating a commutative group modulo `ℓ`-th powers generates it modulo
`ℓ ^ (j + 1)`-st powers as well, for every `j`. -/
theorem exists_zpow_mul_pow_pow {x : A} (h : ∀ a : A, ∃ k : ℤ, ∃ b : A, a = x ^ k * b ^ ℓ) :
    ∀ (j : ℕ) (a : A), ∃ k : ℤ, ∃ b : A, a = x ^ k * b ^ ℓ ^ (j + 1) := by
  intro j
  induction j with
  | zero => simpa using h
  | succ j ih =>
      intro a
      obtain ⟨k, b, rfl⟩ := ih a
      obtain ⟨k', c, rfl⟩ := h b
      refine ⟨k + k' * (ℓ ^ (j + 1) : ℕ), c, ?_⟩
      have hexp : ℓ ^ (j + 1 + 1) = ℓ * ℓ ^ (j + 1) := by ring
      rw [hexp, zpow_add, mul_assoc, mul_pow, ← pow_mul,
        ← zpow_natCast (x ^ k') (ℓ ^ (j + 1)), ← zpow_mul]

/-- **A finite commutative `ℓ`-group generated by one element modulo `ℓ`-th powers is cyclic.**
Substituting the description of a general element into itself raises the exponent to `ℓ ^ j` for
every `j`, and for `ℓ ^ j` the order of the group the second factor disappears. -/
theorem isCyclic_of_forall_exists_zpow_mul_pow [Finite A] [Fact ℓ.Prime] (hA : IsPGroup ℓ A)
    {x : A} (h : ∀ a : A, ∃ k : ℤ, ∃ b : A, a = x ^ k * b ^ ℓ) : IsCyclic A := by
  obtain ⟨j, hj⟩ := hA.exists_card_eq
  refine ⟨x, fun a => ?_⟩
  match j, hj with
  | 0, hj =>
      have : a = 1 := by
        have := Nat.card_eq_one_iff_unique.mp (by simpa using hj)
        exact this.1.elim a 1
      exact ⟨0, by simp [this]⟩
  | (j + 1), hj =>
      obtain ⟨k, b, rfl⟩ := exists_zpow_mul_pow_pow h j a
      exact ⟨k, by rw [← hj, pow_card_eq_one', mul_one]⟩

/-! ### `ℓ`-th powers of a subgroup -/

/-- **An `ℓ`-th power landing in a subgroup with cyclic quotient of order `ℓ ^ n` is an `ℓ`-th
power of that subgroup**, provided the `ℓ ^ n`-th power of the generator already is.  The exponent
of the generator in such an element is divisible by `ℓ ^ (n - 1)`, so its `ℓ`-th power is a power
of the `ℓ ^ n`-th power of the generator. -/
theorem pow_mem_map_powMonoidHom {E : Subgroup A} {y : A} {n : ℕ} (hℓ : ℓ.Prime) (hn : 1 ≤ n)
    (hgen : ∀ a : A, ∃ k : ℤ, a * (y ^ k)⁻¹ ∈ E)
    (hord : ∀ k : ℤ, y ^ k ∈ E → ((ℓ : ℤ) ^ n) ∣ k)
    (hpow : y ^ (ℓ ^ n) ∈ E.map (powMonoidHom ℓ)) {w : A} (hw : w ^ ℓ ∈ E) :
    w ^ ℓ ∈ E.map (powMonoidHom ℓ) := by
  obtain ⟨m, rfl⟩ : ∃ m, n = m + 1 := ⟨n - 1, by omega⟩
  obtain ⟨k, hk⟩ := hgen w
  set e : A := w * (y ^ k)⁻¹ with he
  have hwe : w = y ^ k * e := by simp [he]
  have hsplit : w ^ ℓ = y ^ (k * (ℓ : ℤ)) * e ^ ℓ := by
    rw [hwe, mul_pow, ← zpow_natCast (y ^ k) ℓ, ← zpow_mul]
  have hyE : y ^ (k * (ℓ : ℤ)) ∈ E := by
    have hrw : y ^ (k * (ℓ : ℤ)) = w ^ ℓ * (e ^ ℓ)⁻¹ := by rw [hsplit]; group
    exact hrw ▸ E.mul_mem hw (E.inv_mem (E.pow_mem hk ℓ))
  obtain ⟨t, ht⟩ := hord _ hyE
  have hℓ0 : (ℓ : ℤ) ≠ 0 := by exact_mod_cast hℓ.ne_zero
  have hkdvd : ((ℓ : ℤ) ^ m) ∣ k := by
    refine (mul_dvd_mul_iff_right hℓ0).mp ⟨t, ?_⟩
    rw [ht]; ring
  obtain ⟨k', hk'⟩ := hkdvd
  have hy : y ^ (k * (ℓ : ℤ)) = (y ^ (ℓ ^ (m + 1))) ^ (k' : ℤ) := by
    rw [← zpow_natCast y (ℓ ^ (m + 1)), ← zpow_mul]
    congr 1
    rw [hk']
    push_cast
    ring
  rw [hsplit, hy]
  exact (E.map (powMonoidHom ℓ)).mul_mem ((E.map (powMonoidHom ℓ)).zpow_mem hpow (k' : ℤ))
    ⟨e, hk, rfl⟩

/-! ### Cyclicity from a small image modulo `ℓ`-th powers -/

/-- A finite commutative group of exponent `ℓ` and order at most `ℓ` is cyclic: either it is
trivial, or one of its elements has order the prime `ℓ`, which is then the order of the group. -/
theorem isCyclic_of_card_le_of_forall_pow {C : Type*} [CommGroup C] [Finite C] (hℓ : ℓ.Prime)
    (hexp : ∀ c : C, c ^ ℓ = 1) (hcard : Nat.card C ≤ ℓ) : IsCyclic C := by
  haveI : Fact ℓ.Prime := ⟨hℓ⟩
  by_cases hC : ∀ c : C, c = 1
  · exact ⟨1, fun a => ⟨0, by simp [hC a]⟩⟩
  · push_neg at hC
    obtain ⟨c, hc⟩ := hC
    have hord : orderOf c = ℓ := by
      rcases (Nat.Prime.eq_one_or_self_of_dvd hℓ _ (orderOf_dvd_of_pow_eq_one (hexp c))) with h | h
      · exact absurd (orderOf_eq_one_iff.mp h) hc
      · exact h
    have hdvd : ℓ ∣ Nat.card C := hord ▸ orderOf_dvd_natCard c
    exact isCyclic_of_prime_card (Nat.le_antisymm hcard (Nat.le_of_dvd Nat.card_pos hdvd))

/-- **A subgroup with image of order at most `ℓ` modulo the `ℓ`-th powers of the ambient group is
cyclic**, provided the `ℓ`-th powers of the ambient group that land in the subgroup are already
`ℓ`-th powers of the subgroup.  The image is a commutative group of exponent `ℓ` and small order,
hence cyclic, and a generator of it lifts to an element of the subgroup which generates the
subgroup modulo its own `ℓ`-th powers. -/
theorem isCyclic_subgroup_of_card_map_le [Finite A] {E : Subgroup A} (hℓ : ℓ.Prime)
    (hE : IsPGroup ℓ ↥E)
    (hcard : Nat.card ↥(E.map (QuotientGroup.mk' (MonoidHom.range (powMonoidHom ℓ : A →* A))))
      ≤ ℓ)
    (hpow : ∀ w : A, w ^ ℓ ∈ E → w ^ ℓ ∈ E.map (powMonoidHom ℓ)) :
    IsCyclic ↥E := by
  haveI : Fact ℓ.Prime := ⟨hℓ⟩
  set R := MonoidHom.range (powMonoidHom ℓ : A →* A) with hR
  set π : A →* A ⧸ R := QuotientGroup.mk' R with hπ
  have hexpQ : ∀ c : A ⧸ R, c ^ ℓ = 1 := by
    intro c
    obtain ⟨a, rfl⟩ := QuotientGroup.mk_surjective c
    rw [← QuotientGroup.mk_pow, QuotientGroup.eq_one_iff]
    exact ⟨a, rfl⟩
  have hexpE : ∀ c : ↥(E.map π), c ^ ℓ = 1 := by
    intro c
    ext
    push_cast
    exact hexpQ (c : A ⧸ R)
  haveI : IsCyclic ↥(E.map π) := isCyclic_of_card_le_of_forall_pow hℓ hexpE hcard
  obtain ⟨g, hg⟩ := IsCyclic.exists_generator (α := ↥(E.map π))
  obtain ⟨x, hxE, hx⟩ := g.2
  refine isCyclic_of_forall_exists_zpow_mul_pow hE (x := ⟨x, hxE⟩) ?_
  intro a
  obtain ⟨k, hk⟩ := Subgroup.mem_zpowers_iff.mp (hg ⟨π (a : A), ⟨(a : A), a.2, rfl⟩⟩)
  have hval : π (x ^ k) = π (a : A) := by
    have := congrArg Subtype.val hk
    rw [map_zpow, hx]
    simpa using this
  have hmem : (a : A) * (x ^ k)⁻¹ ∈ R := by
    rw [← QuotientGroup.eq_one_iff]
    have : π ((a : A) * (x ^ k)⁻¹) = 1 := by
      rw [map_mul, map_inv, hval, mul_inv_cancel]
    simpa [hπ] using this
  obtain ⟨w, hw⟩ := hmem
  have hwE : w ^ ℓ ∈ E := by
    rw [show w ^ ℓ = (a : A) * (x ^ k)⁻¹ from hw]
    exact E.mul_mem a.2 (E.inv_mem (E.zpow_mem hxE k))
  obtain ⟨b, hbE, hb⟩ := hpow w hwE
  refine ⟨k, ⟨b, hbE⟩, ?_⟩
  rw [powMonoidHom_apply] at hb hw
  ext
  push_cast
  rw [hb, hw, mul_comm ((a : A)) ((x ^ k)⁻¹), mul_inv_cancel_left]

/-! ### The `ℓ`-th powers of an abelianized subgroup -/

section Abelianization

variable {S : Type*} [Group S] {N : Subgroup S} {σ : S} {n : ℕ}

/-- **The `ℓ`-th powers of the abelianization meeting the image of a normal subgroup with cyclic
quotient of order `ℓ ^ n` are `ℓ`-th powers of that image**, provided the generator of the quotient
lifts to an element of order dividing `ℓ ^ n`.  The commutators lie in the subgroup, so the order
of the class of the generator is not lowered by abelianizing. -/
theorem pow_mem_map_powMonoidHom_abelianization (hℓ : ℓ.Prime) (hn : 1 ≤ n)
    (hgen : ∀ s : S, ∃ k : ℤ, s * (σ ^ k)⁻¹ ∈ N)
    (hord : ∀ k : ℤ, σ ^ k ∈ N → ((ℓ : ℤ) ^ n) ∣ k)
    (hcomm : commutator S ≤ N) (hσ : σ ^ ℓ ^ n = 1)
    {w : Abelianization S}
    (hw : w ^ ℓ ∈ N.map (Abelianization.of : S →* Abelianization S)) :
    w ^ ℓ ∈ (N.map (Abelianization.of : S →* Abelianization S)).map (powMonoidHom ℓ) := by
  refine pow_mem_map_powMonoidHom (y := Abelianization.of σ) hℓ hn ?_ ?_ ?_ hw
  · intro a
    obtain ⟨s, rfl⟩ := (QuotientGroup.mk'_surjective (commutator S)) a
    obtain ⟨k, hk⟩ := hgen s
    exact ⟨k, ⟨s * (σ ^ k)⁻¹, hk, by rw [map_mul, map_inv, map_zpow]; rfl⟩⟩
  · rintro k ⟨t, htN, ht⟩
    refine hord k ?_
    have hker : σ ^ k * t⁻¹ ∈ commutator S := by
      rw [← Abelianization.ker_of, MonoidHom.mem_ker, map_mul, map_inv, map_zpow, ht,
        mul_inv_cancel]
    have := N.mul_mem (hcomm hker) htN
    simpa using this
  · have hone : Abelianization.of σ ^ ℓ ^ n = 1 := by
      rw [← map_pow, hσ, map_one]
    rw [hone]
    exact one_mem _

end Abelianization

end InverseGalois.CFT
