import Mathlib
import InverseGalois.CFT.FibreCompositum
import InverseGalois.CFT.Scholz.UnramifiedSolutionTwo
import InverseGalois.Solvable.CentralDual
import InverseGalois.Solvable.PCentralGenerators

/-!
# A solution at the prime two with elementary abelian kernel

A central Frattini embedding problem at the prime two whose kernel has order two is solved over a
field satisfying the level condition without any new ramification.  An elementary abelian kernel is
reduced to that case one line at a time.

A character of the kernel not vanishing at a chosen element of order two splits the kernel into the
kernel of the character and the line generated by that element.  The two embedding problems obtained
by dividing the kernel by those two subgroups are then solved separately over the *same* base field:
the one whose kernel is the line has kernel of order two, and the other one has a strictly smaller
kernel, so it is solved by induction.  The compositum of the two solutions has for Galois group the
fibre product of the two solving groups amalgamating the group below, and that fibre product is the
whole group, because the two kernels intersect trivially, generate the kernel, and consist of
non-generating elements.  Neither solution ramifies outside the base field, so neither does their
compositum.

## Main results

* `InverseGalois.CFT.exists_galEquiv_ramifiedSet_subset_elemAbTwo`: **a central Frattini embedding
  problem at the prime two with elementary abelian kernel over a field satisfying the level
  condition has a solution which ramifies nowhere outside the ramified set of that field.**

## Tags

embedding problem, Scholz condition, elementary abelian kernel, compositum, fibre product
-/

open NumberField InverseGalois.NumberTheory

namespace InverseGalois.CFT

open IntermediateField

/-! ### Passing the hypotheses of the problem to a quotient -/

section Group

variable {G H : Type*} [Group G] [Group H] {π : G →* H}

/-- The image of a central subgroup under a surjection is central. -/
theorem map_le_center_of_surjective (hπ : Function.Surjective π) {K : Subgroup G}
    (hK : K ≤ Subgroup.center G) : K.map π ≤ Subgroup.center H := by
  rintro _ ⟨w, hw, rfl⟩
  rw [Subgroup.mem_center_iff]
  intro y
  obtain ⟨g, rfl⟩ := hπ y
  rw [← map_mul, ← map_mul, Subgroup.mem_center_iff.mp (hK hw) g]

/-- The image of the Frattini subgroup under a surjection consists of non-generating elements. -/
theorem map_frattini_le_frattini (hπ : Function.Surjective π) :
    (frattini G).map π ≤ frattini H :=
  Subgroup.map_le_iff_le_comap.mpr (frattini_le_comap_frattini_of_surjective hπ)

end Group

/-! ### The ramified primes of a compositum of subfields -/

/-- **The ramified primes of a compositum of two number fields inside a common extension of the
rationals are the ramified primes of the two factors together.** -/
theorem ramifiedSet_sup_intermediateField {L : Type*} [Field L] [CharZero L]
    (A B : IntermediateField ℚ L) [NumberField ↥A] [NumberField ↥B] :
    ramifiedSet ↥(A ⊔ B) = ramifiedSet ↥A ∪ ramifiedSet ↥B := by
  haveI : NumberField ↥(A ⊔ B) := ⟨⟩
  have htop : IntermediateField.restrict (le_sup_left : A ≤ A ⊔ B) ⊔
      IntermediateField.restrict (le_sup_right : B ≤ A ⊔ B) =
      (⊤ : IntermediateField ℚ ↥(A ⊔ B)) := restrict_sup_restrict A B
  have h1 : ramifiedSet ↥(⊤ : IntermediateField ℚ ↥(A ⊔ B)) =
      ramifiedSet ↥A ∪ ramifiedSet ↥B := by
    rw [← htop, ramifiedSet_sup, ramifiedSet_restrict, ramifiedSet_restrict]
  rw [← h1]
  exact (ramifiedSet_eq_of_ringEquiv
    (IntermediateField.topEquiv (F := ℚ) (E := ↥(A ⊔ B))).toRingEquiv).symm

/-! ### The induction on the order of the group -/

set_option maxHeartbeats 1000000 in
private theorem exists_galEquiv_elemAbTwo_aux {N : ℕ} {H : Type} [Group H]
    (hHdvd : Nat.card H ∣ 2 ^ N) (A : IntermediateField ℚ (AlgebraicClosure ℚ)) [IsGalois ℚ ↥A]
    [NumberField ↥A] (hsch : IsScholz 2 (N + 1) ↥A) (e : Gal(↥A/ℚ) ≃* H) (k : ℕ) :
    ∀ (G : Type) [Group G] [Finite G] (f : G →* H), Nat.card G = k → Function.Surjective f →
      IsPGroup 2 G → f.ker ≤ Subgroup.center G → f.ker ≤ frattini G → (∀ z ∈ f.ker, z ^ 2 = 1) →
      ∃ (L : IntermediateField ℚ (AlgebraicClosure ℚ)) (hAL : A ≤ L), NumberField ↥L ∧
        IsGalois ℚ ↥L ∧ ramifiedSet ↥L ⊆ ramifiedSet ↥A ∧
        ∃ ψ : Gal(↥L/ℚ) ≃* G, ∀ τ, f (ψ τ) = e (galRestrictLE hAL τ) := by
  induction k using Nat.strong_induction_on with
  | _ k ih =>
  intro G _ _ f hcard hf hpg hZ hfr hexp
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  by_cases hker : f.ker = ⊥
  · -- the problem is already solved by the field below
    have hinj : Function.Injective f := (MonoidHom.ker_eq_bot_iff f).mp hker
    refine ⟨A, le_rfl, inferInstance, inferInstance, subset_rfl,
      e.trans (MulEquiv.ofBijective f ⟨hinj, hf⟩).symm, fun τ => ?_⟩
    rw [galRestrictLE_refl]
    exact (MulEquiv.ofBijective f ⟨hinj, hf⟩).apply_symm_apply (e τ)
  · -- split a line off the kernel
    obtain ⟨z, hzK, hz1⟩ : ∃ z ∈ f.ker, z ≠ 1 := by
      obtain ⟨⟨z, hz⟩, hz1⟩ := Subgroup.ne_bot_iff_exists_ne_one.mp hker
      exact ⟨z, hz, fun hc => hz1 (Subtype.ext hc)⟩
    have hz2 : z ^ 2 = 1 := hexp z hzK
    obtain ⟨φ, hφ⟩ := exists_char_apply_ne_zero Nat.prime_two hZ hexp
      (z := ⟨z, hzK⟩) fun hc => hz1 (congrArg Subtype.val hc)
    have hφz : charValue f.ker φ z ≠ 0 := by
      rw [charValue_of_mem φ hzK]
      exact hφ
    set Z₁ : Subgroup G := Subgroup.zpowers z with hZ₁def
    set Z₂ : Subgroup G := charKer f.ker φ with hZ₂def
    have hZ₁le : Z₁ ≤ f.ker := Subgroup.zpowers_le.mpr hzK
    have hZ₂le : Z₂ ≤ f.ker := charKer_le φ
    have hsupker : Z₂ ⊔ Z₁ = f.ker := sup_charKer_zpowers hzK hφz
    have hinfker : Z₂ ⊓ Z₁ = ⊥ := inf_charKer_zpowers hz2 hφz
    haveI : Z₁.Normal := normal_of_le_center (hZ₁le.trans hZ)
    haveI : Z₂.Normal := normal_of_le_center (hZ₂le.trans hZ)
    -- the two quotients of the problem
    set π₁ : G →* G ⧸ Z₁ := QuotientGroup.mk' Z₁ with hπ₁def
    set π₂ : G →* G ⧸ Z₂ := QuotientGroup.mk' Z₂ with hπ₂def
    set f₁ : (G ⧸ Z₁) →* H :=
      QuotientGroup.lift Z₁ f fun w hw => MonoidHom.mem_ker.mp (hZ₁le hw) with hf₁def
    set f₂ : (G ⧸ Z₂) →* H :=
      QuotientGroup.lift Z₂ f fun w hw => MonoidHom.mem_ker.mp (hZ₂le hw) with hf₂def
    have hπ₁ : Function.Surjective π₁ := QuotientGroup.mk'_surjective Z₁
    have hπ₂ : Function.Surjective π₂ := QuotientGroup.mk'_surjective Z₂
    have hval₁ : ∀ g, f₁ (π₁ g) = f g := fun g => rfl
    have hval₂ : ∀ g, f₂ (π₂ g) = f g := fun g => rfl
    have hcomp₁ : f₁.comp π₁ = f := MonoidHom.ext hval₁
    have hcomp₂ : f₂.comp π₂ = f := MonoidHom.ext hval₂
    have hcomm : f₁.comp π₁ = f₂.comp π₂ := by rw [hcomp₁, hcomp₂]
    have hk₁ : π₁.ker = Z₁ := QuotientGroup.ker_mk' Z₁
    have hk₂ : π₂.ker = Z₂ := QuotientGroup.ker_mk' Z₂
    have hsup₁ : (f₁.comp π₁).ker = π₁.ker ⊔ π₂.ker := by
      rw [hcomp₁, hk₁, hk₂, sup_comm]
      exact hsupker.symm
    have hsup₂ : (f₂.comp π₂).ker = π₂.ker ⊔ π₁.ker := by
      rw [hcomp₂, hk₁, hk₂]
      exact hsupker.symm
    have hker₂ : f₂.ker = Z₁.map π₂ := by
      have h := ker_eq_map_ker hπ₂ hcomm hsup₁
      rwa [hk₁] at h
    have hker₁ : f₁.ker = Z₂.map π₁ := by
      have h := ker_eq_map_ker hπ₁ hcomm.symm hsup₂
      rwa [hk₂] at h
    -- the hypotheses of the problem, read on the two quotients
    have hf₁surj : Function.Surjective f₁ := by
      intro h
      obtain ⟨g, rfl⟩ := hf h
      exact ⟨π₁ g, hval₁ g⟩
    have hf₂surj : Function.Surjective f₂ := by
      intro h
      obtain ⟨g, rfl⟩ := hf h
      exact ⟨π₂ g, hval₂ g⟩
    have hZc₁ : f₁.ker ≤ Subgroup.center (G ⧸ Z₁) := by
      rw [hker₁]
      exact map_le_center_of_surjective hπ₁ (hZ₂le.trans hZ)
    have hZc₂ : f₂.ker ≤ Subgroup.center (G ⧸ Z₂) := by
      rw [hker₂]
      exact map_le_center_of_surjective hπ₂ (hZ₁le.trans hZ)
    have hfr₁ : f₁.ker ≤ frattini (G ⧸ Z₁) := by
      rw [hker₁]
      exact (Subgroup.map_mono (hZ₂le.trans hfr)).trans (map_frattini_le_frattini hπ₁)
    have hfr₂ : f₂.ker ≤ frattini (G ⧸ Z₂) := by
      rw [hker₂]
      exact (Subgroup.map_mono (hZ₁le.trans hfr)).trans (map_frattini_le_frattini hπ₂)
    have hexp₁ : ∀ w ∈ f₁.ker, w ^ 2 = 1 := by
      intro w hw
      rw [hker₁] at hw
      obtain ⟨u, hu, rfl⟩ := hw
      rw [← map_pow, hexp u (hZ₂le hu), map_one]
    -- the quotient by the line has a kernel of order two
    have hzZ₂ : z ∉ Z₂ := fun hc => hφz hc.2
    have hcard₂ : Nat.card ↥f₂.ker = 2 := by
      have hmk : π₂ z ≠ 1 := by
        rw [ne_eq, ← MonoidHom.mem_ker, hk₂]
        exact hzZ₂
      have hmk2 : π₂ z ^ 2 = 1 := by rw [← map_pow, hz2, map_one]
      rw [hker₂, hZ₁def, MonoidHom.map_zpowers, Nat.card_zpowers, orderOf_eq_prime hmk2 hmk]
    -- the quotient by the kernel of the character is smaller
    have hcardZ₁ : Nat.card ↥Z₁ = 2 := by
      rw [hZ₁def, Nat.card_zpowers, orderOf_eq_prime hz2 hz1]
    have hlt : Nat.card (G ⧸ Z₁) < k := by
      have hlag := Subgroup.card_eq_card_quotient_mul_card_subgroup Z₁
      rw [hcardZ₁, hcard] at hlag
      have hpos : 0 < Nat.card (G ⧸ Z₁) := Nat.card_pos
      omega
    -- the two solutions over the same field
    obtain ⟨L₁, hAL₁, hNF₁, hGal₁, hram₁, ψ₁, hψ₁⟩ :=
      ih (Nat.card (G ⧸ Z₁)) hlt (G ⧸ Z₁) f₁ rfl hf₁surj (hpg.to_quotient Z₁) hZc₁ hfr₁ hexp₁
    obtain ⟨L₂, hAL₂, hNF₂, hGal₂, hram₂, ψ₂, hψ₂⟩ :=
      exists_galEquiv_ramifiedSet_subset_two hf₂surj (hpg.to_quotient Z₂) hZc₂ hfr₂ hcard₂ hHdvd
        A hsch e
    haveI := hNF₁
    haveI := hGal₁
    haveI := hNF₂
    haveI := hGal₂
    -- their compositum
    have hinf' : π₁.ker ⊓ π₂.ker = ⊥ := by
      rw [hk₁, hk₂, inf_comm]
      exact hinfker
    have hfrZ₁ : π₁.ker ≤ frattini G := by
      rw [hk₁]
      exact hZ₁le.trans hfr
    obtain ⟨ψ, hψa, -⟩ :=
      exists_galEquiv_sup hπ₁ hπ₂ hcomm hinf' hsup₁ hfrZ₁ hAL₁ hAL₂ e ψ₁ ψ₂ hψ₁ hψ₂
    haveI : NumberField ↥(L₁ ⊔ L₂) := ⟨⟩
    haveI : IsGalois ℚ ↥(L₁ ⊔ L₂) := ⟨⟩
    refine ⟨L₁ ⊔ L₂, hAL₁.trans le_sup_left, inferInstance, inferInstance, ?_, ψ, fun τ => ?_⟩
    · rw [ramifiedSet_sup_intermediateField]
      exact Set.union_subset hram₁ hram₂
    · rw [← hval₁ (ψ τ), hψa τ, hψ₁, galRestrictLE_galRestrictLE]

/-- **A central Frattini embedding problem at the prime two with elementary abelian kernel over a
field satisfying the level condition has a solution ramifying nowhere outside the ramified set of
that field.**  The kernel is divided one line at a time: the quotient of the problem by a
complementary hyperplane of the kernel has kernel of order two, the quotient by the line is solved
by induction, and the compositum of the two solutions realizes the fibre product of the two solving
groups, which is the whole group. -/
theorem exists_galEquiv_ramifiedSet_subset_elemAbTwo {N : ℕ} {G H : Type} [Group G] [Group H]
    [Finite G] {f : G →* H} (hf : Function.Surjective f) (hpg : IsPGroup 2 G)
    (hZ : f.ker ≤ Subgroup.center G) (hfr : f.ker ≤ frattini G) (hexp : ∀ z ∈ f.ker, z ^ 2 = 1)
    (hHdvd : Nat.card H ∣ 2 ^ N) (A : IntermediateField ℚ (AlgebraicClosure ℚ)) [IsGalois ℚ ↥A]
    [NumberField ↥A] (hsch : IsScholz 2 (N + 1) ↥A) (e : Gal(↥A/ℚ) ≃* H) :
    ∃ (L : IntermediateField ℚ (AlgebraicClosure ℚ)) (hAL : A ≤ L), NumberField ↥L ∧
      IsGalois ℚ ↥L ∧ ramifiedSet ↥L ⊆ ramifiedSet ↥A ∧
      ∃ ψ : Gal(↥L/ℚ) ≃* G, ∀ τ, f (ψ τ) = e (galRestrictLE hAL τ) :=
  exists_galEquiv_elemAbTwo_aux hHdvd A hsch e (Nat.card G) G f rfl hf hpg hZ hfr hexp

end InverseGalois.CFT
