import Mathlib
import InverseGalois.CFT.Scholz.CentralDefect
import InverseGalois.CFT.Scholz.CoverInertia
import InverseGalois.Solvable.CentralLineQuotient

/-!
# One stage of the dyadic climb, seen on the obstructions of the blocks

The dyadic climb cuts the kernel of the projection to the previous `2`-class down one hyperplane at
a time, and at each stage it has to know that the obstructions of the blocks of the field cut out by
a hyperplane of the current subgroup vanish.  Passing from one stage to the next means putting back
into a subgroup the element the stage was built on, which changes the field cut out; what is proven
here is that it does not change the obstruction of a block.

The reason is local, one prime of the block at a time.  Over a cover the obstruction of a prime in
the subfield cut out by a subgroup of the central subgroup is a membership statement about the
central part of an arithmetic Frobenius above it, and that central part lies in the current subgroup
because the field cut out by the current subgroup has residue degree one there.  The central part of
the inertia subgroup at a prime of the `i`-th block is generated by the distinguished central
element attached to the `i`-th generator, so the membership statement is decided by the position of
that distinguished element relative to the current subgroup — and in each of the three positions the
climb allows, adjoining the omitted element changes nothing.

## Main results

* `InverseGalois.CFT.cutField_eq_of_galEquiv_comp`: a field carrying an isomorphic copy of a
  quotient of the group of a larger field is the field that quotient cuts out.
* `InverseGalois.CFT.canonicalDefect_cutField_sup_zpowers_iff`: **adjoining the element a stage is
  built on to a subgroup does not change the obstruction of a prime of a block** in the subfield it
  cuts out of the cover.
* `InverseGalois.CFT.blockDefect_cutField_sup_zpowers`: **adjoining the element a stage is built on
  to a subgroup does not change the obstruction of a block.**

## Tags

Scholz–Reichardt, Scholz obstruction, block, cover, central subgroup, hyperplane, Shafarevich
-/

open NumberField InverseGalois.NumberTheory

namespace InverseGalois.CFT

/-! ### The field cut out by a solution presented on a cover -/

section CutField

variable {F L : Type*} [Field F] [Field L] [Algebra F L] {E E' : IntermediateField F L}
  [FiniteDimensional F ↥E] [IsGalois F ↥E] [FiniteDimensional F ↥E'] [IsGalois F ↥E']
  {G G' : Type*} [Group G] [Group G']

/-- A field carrying an isomorphic copy of a quotient of the group of a larger field is the field
that quotient cuts out. -/
theorem cutField_eq_of_galEquiv_comp (h : E ≤ E') (ψ : Gal(↥E/F) ≃* G) (Ψ : Gal(↥E'/F) ≃* G')
    (g : G' →* G) (hg : ∀ τ, ψ (galRestrictLE h τ) = g (Ψ τ)) :
    cutField (g.comp Ψ.toMonoidHom) = E := by
  have hcomp : g.comp Ψ.toMonoidHom = ψ.toMonoidHom.comp (galRestrictLE h) :=
    MonoidHom.ext fun τ => (hg τ).symm
  rw [hcomp, cutField_comp_galRestrictLE h ψ.toMonoidHom,
    cutField_eq_self_of_ker_eq_bot _ ((MonoidHom.ker_eq_bot_iff _).mpr ψ.injective)]

end CutField

/-! ### Adjoining the element a stage is built on -/

section Stage

variable {d n N : ℕ} {T : IntermediateField ℚ (AlgebraicClosure ℚ)} [NumberField ↥T]
  [IsGalois ℚ ↥T] {W V : Subgroup (FreePClass 2 d (n + 2))} [W.Normal] [V.Normal]
  {w : FreePClass 2 d (n + 2)} [(Subgroup.zpowers w).Normal] {i : Fin d} {q : ℕ}

set_option synthInstance.maxHeartbeats 400000 in
set_option maxHeartbeats 1000000 in
/-- **Adjoining the element a stage of the dyadic climb is built on to a subgroup does not change
the obstruction of a prime of a block** in the subfield it cuts out of the cover.  The obstruction
is decided by the central part of an arithmetic Frobenius above the prime, which lies in the
subgroup the stage is cutting down; the central part of the inertia subgroup is generated by the
distinguished central element attached to the block, and the element adjoined is invisible to that
membership question in each of the three positions the distinguished element can be in. -/
theorem canonicalDefect_cutField_sup_zpowers_iff (R : StrongScholzRealization d (n + 1) N)
    (hAT : R.carrier ≤ T) (Ψ : Gal(↥T/ℚ) ≃* FreePClass 2 d (n + 2))
    (hcomp : ∀ τ, FreePClass.proj 2 d (n + 1) (Ψ τ) = R.galEquiv (galRestrictLE hAT τ))
    (hWZ : W ≤ (FreePClass.proj 2 d (n + 1)).ker) (hVW : V ≤ W)
    (hwZ : w ∈ (FreePClass.proj 2 d (n + 1)).ker) (hwW : w ∉ W)
    (hcase : FreePClass.zGen 2 d (n + 1) i ∈ W ∨
      FreePClass.zGen 2 d (n + 1) i ∉ W ⊔ Subgroup.zpowers w ∨
      w ∈ Subgroup.zpowers (FreePClass.zGen 2 d (n + 1) i))
    (hq : q ∈ R.block i) (hq2 : q ≠ 2)
    (hsplit : IsSplitInertiaAt ↥(cutField ((QuotientGroup.mk' W).comp Ψ.toMonoidHom)) q) :
    canonicalDefect ↥(cutField ((QuotientGroup.mk' V).comp Ψ.toMonoidHom)) q = 0 ↔
      canonicalDefect
        ↥(cutField ((QuotientGroup.mk' (V ⊔ Subgroup.zpowers w)).comp Ψ.toMonoidHom)) q = 0 := by
  classical
  have hqp : q.Prime := R.blockPrime i q hq
  haveI : (Ideal.span {(q : ℤ)}).IsPrime := by
    rw [Ideal.span_singleton_prime (by exact_mod_cast hqp.ne_zero)]
    exact Nat.prime_iff_prime_int.mp hqp
  obtain ⟨⟨P, hPp, hPo⟩⟩ := (Ideal.span {(q : ℤ)}).nonempty_primesOver (S := 𝓞 ↥T)
  haveI := hPp
  haveI := hPo
  haveI : Finite (𝓞 ↥T ⧸ P) := finite_quotient_of_ne_bot P (ne_bot_of_liesOver_natCast hqp hPo)
  obtain ⟨σ, hσ⟩ : ∃ σ : Gal(↥T/ℚ), IsArithFrobAt ℤ σ P :=
    ⟨_, IsArithFrobAt.arithFrobAt ℤ Gal(↥T/ℚ) P⟩
  obtain ⟨j, hj, θ, hθW, hx⟩ := exists_mul_eq_of_isSplitInertiaAt Ψ W hqp P hσ hsplit
  have hVZ : V ≤ (FreePClass.proj 2 d (n + 1)).ker := hVW.trans hWZ
  have hVwZ : V ⊔ Subgroup.zpowers w ≤ (FreePClass.proj 2 d (n + 1)).ker :=
    sup_le hVZ (Subgroup.zpowers_le.mpr hwZ)
  rw [canonicalDefect_cutField_eq_zero_iff Ψ hVZ hqp P hσ hj (hWZ hθW) hx,
    canonicalDefect_cutField_eq_zero_iff Ψ hVwZ hqp P hσ hj (hWZ hθW) hx,
    R.map_inertia_inf_ker_proj_cover hAT Ψ hcomp hq hq2 P]
  exact mem_sup_zpowers_iff_mem_sup_sup (FreePClass.ker_proj_le_center 2 d (n + 1))
    (fun z hz => FreePClass.pow_eq_one_of_mem_ker_proj 2 d (n + 1) hz) hVW
    (FreePClass.zGen_mem_ker_proj 2 d (n + 1) i) hwZ hwW hcase hθW

set_option synthInstance.maxHeartbeats 400000 in
set_option maxHeartbeats 1000000 in
/-- **Adjoining the element a stage of the dyadic climb is built on to a subgroup does not change
the obstruction of a block** in the subfield it cuts out of the cover. -/
theorem blockDefect_cutField_sup_zpowers (R : StrongScholzRealization d (n + 1) N)
    (hAT : R.carrier ≤ T) (Ψ : Gal(↥T/ℚ) ≃* FreePClass 2 d (n + 2))
    (hcomp : ∀ τ, FreePClass.proj 2 d (n + 1) (Ψ τ) = R.galEquiv (galRestrictLE hAT τ))
    (hWZ : W ≤ (FreePClass.proj 2 d (n + 1)).ker) (hVW : V ≤ W)
    (hwZ : w ∈ (FreePClass.proj 2 d (n + 1)).ker) (hwW : w ∉ W)
    (hcase : FreePClass.zGen 2 d (n + 1) i ∈ W ∨
      FreePClass.zGen 2 d (n + 1) i ∉ W ⊔ Subgroup.zpowers w ∨
      w ∈ Subgroup.zpowers (FreePClass.zGen 2 d (n + 1) i))
    (hq2 : ∀ q ∈ R.block i, q ≠ 2)
    (hsplit : ∀ q ∈ R.block i,
      IsSplitInertiaAt ↥(cutField ((QuotientGroup.mk' W).comp Ψ.toMonoidHom)) q) :
    blockDefect ↥(cutField ((QuotientGroup.mk' V).comp Ψ.toMonoidHom)) (R.block i) =
      blockDefect
        ↥(cutField ((QuotientGroup.mk' (V ⊔ Subgroup.zpowers w)).comp Ψ.toMonoidHom))
        (R.block i) :=
  blockDefect_eq_of_forall_eq_zero_iff fun q hq =>
    canonicalDefect_cutField_sup_zpowers_iff R hAT Ψ hcomp hWZ hVW hwZ hwW hcase hq (hq2 q hq)
      (hsplit q hq)

end Stage

end InverseGalois.CFT
