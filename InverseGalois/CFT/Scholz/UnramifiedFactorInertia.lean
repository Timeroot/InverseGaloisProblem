import Mathlib
import InverseGalois.CFT.InertiaSubgroup
import InverseGalois.CFT.TameCyclic

/-!
# Inertia in a compositum with an unramified factor

An automorphism of a field generated by two normal subextensions is determined by its restrictions
to the two of them.  If a prime is unramified in one of them, the inertia subgroup above it acts
trivially there, so the restriction to the other subextension already determines it: inertia at
such a prime embeds into the Galois group of the subextension where the prime may ramify.

This is what lets the Scholz–Reichardt construction at the prime two enlarge its field by a
cyclotomic layer of odd conductor without losing the tameness of inertia at the odd primes it has
to correct.  The enlarged field is no longer of two-power degree, but at a prime unramified in the
cyclotomic layer its inertia subgroup still sits inside a two-group, hence is tame and therefore
cyclic.

## Main results

* `InverseGalois.CFT.eq_one_of_mem_inertia_of_restrictNormalHom_eq_one`: an element of inertia at a
  prime unramified in one of two generating normal subextensions is trivial as soon as it restricts
  trivially to the other.
* `InverseGalois.CFT.isPGroup_inertia_of_sup_eq_top`: **the inertia subgroup at a prime unramified
  in one of two generating normal subextensions is an `ℓ`-group when the other has `ℓ`-group Galois
  group.**
* `InverseGalois.CFT.isCyclic_inertia_of_sup_eq_top`: **that inertia subgroup is cyclic** at every
  prime other than `ℓ`.

## Tags

compositum, inertia subgroup, unramified prime, tame ramification, `p`-group
-/

open NumberField InverseGalois.NumberTheory

namespace InverseGalois.CFT

variable {N : Type*} [Field N] [NumberField N] [IsGalois ℚ N] {p : ℕ}
variable (A B : IntermediateField ℚ N) [Normal ℚ ↥A] [Normal ℚ ↥B]

/-- **An element of inertia at a prime unramified in one of two generating normal subextensions is
trivial as soon as it restricts trivially to the other.**  It fixes the first subextension pointwise
because it restricts trivially there, and the second because inertia at an unramified prime acts
trivially on it; together the two generate everything. -/
theorem eq_one_of_mem_inertia_of_restrictNormalHom_eq_one (hAB : A ⊔ B = ⊤) (hp : p.Prime)
    (hB : p ∉ ramifiedSet ↥B) (P : Ideal (𝓞 N)) [P.IsPrime] [P.LiesOver (Ideal.span {(p : ℤ)})]
    {σ : Gal(N/ℚ)} (hσ : σ ∈ Ideal.inertia Gal(N/ℚ) P)
    (h1 : AlgEquiv.restrictNormalHom ↥A σ = 1) : σ = 1 := by
  have hmemA : σ ∈ A.fixingSubgroup := by
    rw [IntermediateField.mem_fixingSubgroup_iff]
    intro x hx
    have h := AlgEquiv.restrictNormalHom_apply A σ ⟨x, hx⟩
    rw [h1] at h
    simpa using h.symm
  have hmemB : σ ∈ B.fixingSubgroup := inertia_le_fixingSubgroup B hp P hB hσ
  have hmem : σ ∈ (⊤ : IntermediateField ℚ N).fixingSubgroup := by
    rw [← hAB, IntermediateField.fixingSubgroup_sup]
    exact ⟨hmemA, hmemB⟩
  rw [IntermediateField.fixingSubgroup_top] at hmem
  simpa using hmem

/-- **The inertia subgroup at a prime unramified in one of two generating normal subextensions is
an `ℓ`-group when the other has `ℓ`-group Galois group.**  Restriction to that other subextension is
injective on inertia. -/
theorem isPGroup_inertia_of_sup_eq_top {ℓ : ℕ} (hAB : A ⊔ B = ⊤) (hp : p.Prime)
    (hB : p ∉ ramifiedSet ↥B) (hA : IsPGroup ℓ Gal(↥A/ℚ)) (P : Ideal (𝓞 N)) [P.IsPrime]
    [P.LiesOver (Ideal.span {(p : ℤ)})] :
    IsPGroup ℓ ↥(Ideal.inertia Gal(N/ℚ) P) := by
  refine hA.of_injective
    ((AlgEquiv.restrictNormalHom ↥A).comp (Ideal.inertia Gal(N/ℚ) P).subtype) ?_
  rw [injective_iff_map_eq_one]
  rintro ⟨σ, hσ⟩ h
  exact Subtype.ext (eq_one_of_mem_inertia_of_restrictNormalHom_eq_one A B hAB hp hB P hσ h)

/-- **Inertia at a prime unramified in one of two generating normal subextensions is cyclic** when
the other has Galois group an `ℓ`-group and the prime is different from `ℓ`.  Its order is then a
power of `ℓ`, so the prime does not divide it and the ramification is tame. -/
theorem isCyclic_inertia_of_sup_eq_top {ℓ : ℕ} (hℓ : ℓ.Prime) (hAB : A ⊔ B = ⊤) (hp : p.Prime)
    (hne : p ≠ ℓ) (hB : p ∉ ramifiedSet ↥B) (hA : IsPGroup ℓ Gal(↥A/ℚ)) (P : Ideal (𝓞 N))
    [P.IsPrime] [P.LiesOver (Ideal.span {(p : ℤ)})] :
    IsCyclic ↥(Ideal.inertia Gal(N/ℚ) P) := by
  haveI : Fact ℓ.Prime := ⟨hℓ⟩
  refine isCyclic_inertia_of_not_dvd hp P ?_
  obtain ⟨j, hj⟩ := IsPGroup.iff_card.mp (isPGroup_inertia_of_sup_eq_top A B hAB hp hB hA P)
  rw [hj]
  exact fun hdvd => hne ((Nat.prime_dvd_prime_iff_eq hp hℓ).mp (hp.dvd_of_dvd_pow hdvd))

end InverseGalois.CFT
