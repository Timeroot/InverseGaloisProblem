import Mathlib

/-!
# The selector field of the Scholz–Reichardt construction

The Scholz–Reichardt construction needs an auxiliary Galois number field which is designed so
that a rational prime splitting completely in it automatically enjoys several useful properties
at once. This file builds that field and reads off its defining properties.

Fix a number field `L`, natural numbers `m` and `k`, and a finite set `S` of natural numbers.
Let `θ` be a primitive element of `L` over `ℚ` and consider the polynomial

`selectorPoly L m k S = minpoly ℚ θ * (X ^ m - 1) * ∏ p ∈ S, (X ^ k - C p)`.

The *selector field* `selectorField L m k S` is the subfield of `AlgebraicClosure ℚ` generated
over `ℚ` by the roots of this polynomial. Being the splitting field of a polynomial over a field
of characteristic zero, it is a Galois number field, and by construction it contains a copy of
`L`, a primitive `m`-th root of unity, and a `k`-th root of every element of `S`.

## Main definitions

* `InverseGalois.CFT.selectorGen`: a chosen primitive element of `L` over `ℚ`.
* `InverseGalois.CFT.selectorPoly`: the polynomial displayed above.
* `InverseGalois.CFT.selectorField`: the subfield of `AlgebraicClosure ℚ` generated by its roots.

## Main results

* `InverseGalois.CFT.finiteDimensional_selectorField` and
  `InverseGalois.CFT.numberField_selectorField`: the selector field is a number field.
* `InverseGalois.CFT.isGalois_selectorField`: the selector field is Galois over `ℚ`.
* `InverseGalois.CFT.nonempty_algHom_selectorField`: the selector field contains a copy of `L`.
* `InverseGalois.CFT.exists_isPrimitiveRoot_selectorField`: the selector field contains a
  primitive `m`-th root of unity.
* `InverseGalois.CFT.exists_pow_eq_natCast_selectorField`: the selector field contains a `k`-th
  root of every element of `S`.

-/

namespace InverseGalois.CFT

open Polynomial IntermediateField

variable (L : Type*) [Field L] [NumberField L]

/-! ### The polynomial and the field -/

/-- A chosen primitive element of the number field `L` over `ℚ`. -/
noncomputable def selectorGen : L := (Field.exists_primitive_element ℚ L).choose

/-- The chosen primitive element generates `L` over `ℚ`. -/
theorem adjoin_selectorGen : ℚ⟮selectorGen L⟯ = ⊤ :=
  (Field.exists_primitive_element ℚ L).choose_spec

variable (m k : ℕ) (S : Finset ℕ)

/-- The polynomial `minpoly ℚ θ * (X ^ m - 1) * ∏ p ∈ S, (X ^ k - C p)`, where `θ` is the chosen
primitive element of `L`. Its roots generate the selector field. -/
noncomputable def selectorPoly : ℚ[X] :=
  minpoly ℚ (selectorGen L) * (X ^ m - 1) * ∏ p ∈ S, (X ^ k - C (p : ℚ))

/-- The selector field: the subfield of `AlgebraicClosure ℚ` generated over `ℚ` by the roots of
`selectorPoly L m k S`. -/
noncomputable def selectorField : IntermediateField ℚ (AlgebraicClosure ℚ) :=
  IntermediateField.adjoin ℚ ((selectorPoly L m k S).rootSet (AlgebraicClosure ℚ))

/-! ### Basic structure of the selector field -/

/-- The selector field is a splitting field of `selectorPoly L m k S` over `ℚ`. -/
instance isSplittingField_selectorField :
    Polynomial.IsSplittingField ℚ ↥(selectorField L m k S) (selectorPoly L m k S) := by
  unfold selectorField
  exact IntermediateField.adjoin_rootSet_isSplittingField (IsAlgClosed.splits _)

/-- The selector field is a finite extension of `ℚ`. -/
instance finiteDimensional_selectorField : FiniteDimensional ℚ ↥(selectorField L m k S) :=
  Polynomial.IsSplittingField.finiteDimensional _ (selectorPoly L m k S)

/-- The selector field is a number field. -/
instance numberField_selectorField : NumberField ↥(selectorField L m k S) := ⟨⟩

/-- The selector field is normal over `ℚ`, being a splitting field. -/
instance normal_selectorField : Normal ℚ ↥(selectorField L m k S) :=
  Normal.of_isSplittingField (selectorPoly L m k S)

/-- The selector field is a Galois extension of `ℚ`. -/
instance isGalois_selectorField : IsGalois ℚ ↥(selectorField L m k S) := ⟨⟩

/-! ### Membership criteria -/

/-- The minimal polynomial of the chosen primitive element divides the selector polynomial. -/
theorem minpoly_dvd_selectorPoly :
    minpoly ℚ (selectorGen L) ∣ selectorPoly L m k S :=
  ⟨(X ^ m - 1) * ∏ p ∈ S, (X ^ k - C (p : ℚ)), by unfold selectorPoly; ring⟩

/-- The polynomial `X ^ m - 1` divides the selector polynomial. -/
theorem X_pow_sub_one_dvd_selectorPoly :
    (X ^ m - 1 : ℚ[X]) ∣ selectorPoly L m k S :=
  ⟨minpoly ℚ (selectorGen L) * ∏ p ∈ S, (X ^ k - C (p : ℚ)), by unfold selectorPoly; ring⟩

/-- For every `p ∈ S` the polynomial `X ^ k - C p` divides the selector polynomial. -/
theorem X_pow_sub_C_dvd_selectorPoly {p : ℕ} (hp : p ∈ S) :
    (X ^ k - C (p : ℚ) : ℚ[X]) ∣ selectorPoly L m k S :=
  dvd_mul_of_dvd_right (Finset.dvd_prod_of_mem _ hp) _

/-- The selector polynomial is nonzero as soon as `m` and `k` are. -/
theorem selectorPoly_ne_zero (hm : m ≠ 0) (hk : k ≠ 0) : selectorPoly L m k S ≠ 0 := by
  unfold selectorPoly
  refine mul_ne_zero (mul_ne_zero (minpoly.ne_zero (IsIntegral.of_finite ℚ _)) ?_) ?_
  · simpa using X_pow_sub_C_ne_zero (R := ℚ) (Nat.pos_of_ne_zero hm) 1
  · exact Finset.prod_ne_zero_iff.mpr fun _ _ =>
      X_pow_sub_C_ne_zero (R := ℚ) (Nat.pos_of_ne_zero hk) _

/-- Any root, in `AlgebraicClosure ℚ`, of a divisor of the selector polynomial lies in the
selector field. -/
theorem mem_selectorField_of_dvd_of_aeval_eq_zero (hm : m ≠ 0) (hk : k ≠ 0) {g : ℚ[X]}
    (hg : g ∣ selectorPoly L m k S) {α : AlgebraicClosure ℚ} (hα : aeval α g = 0) :
    α ∈ selectorField L m k S := by
  obtain ⟨c, hc⟩ := hg
  refine IntermediateField.subset_adjoin ℚ _ (Polynomial.mem_rootSet.mpr
    ⟨selectorPoly_ne_zero L m k S hm hk, ?_⟩)
  rw [hc, map_mul, hα, zero_mul]

/-! ### The copy of `L` inside the selector field -/

/-- A chosen `ℚ`-algebra embedding of `L` into `AlgebraicClosure ℚ`. -/
noncomputable def selectorAlgHom : L →ₐ[ℚ] AlgebraicClosure ℚ := IsAlgClosed.lift

/-- The image of the chosen primitive element of `L` lies in the selector field. -/
theorem selectorAlgHom_selectorGen_mem (hm : m ≠ 0) (hk : k ≠ 0) :
    selectorAlgHom L (selectorGen L) ∈ selectorField L m k S := by
  refine mem_selectorField_of_dvd_of_aeval_eq_zero L m k S hm hk
    (minpoly_dvd_selectorPoly L m k S) ?_
  rw [Polynomial.aeval_algHom_apply, minpoly.aeval, map_zero]

/-- The whole image of `L` in `AlgebraicClosure ℚ` lies in the selector field. -/
theorem fieldRange_selectorAlgHom_le (hm : m ≠ 0) (hk : k ≠ 0) :
    (selectorAlgHom L).fieldRange ≤ selectorField L m k S := by
  have hθ : selectorGen L ∈ (selectorField L m k S).comap (selectorAlgHom L) :=
    selectorAlgHom_selectorGen_mem L m k S hm hk
  have htop : (⊤ : IntermediateField ℚ L) ≤ (selectorField L m k S).comap (selectorAlgHom L) := by
    rw [← adjoin_selectorGen L]
    exact IntermediateField.adjoin_simple_le_iff.mpr hθ
  rintro y ⟨x, rfl⟩
  exact htop (show x ∈ (⊤ : IntermediateField ℚ L) from trivial)

/-- The chosen embedding identifies `L` with its image inside `AlgebraicClosure ℚ`. -/
noncomputable def selectorRangeEquiv : L ≃ₐ[ℚ] ↥((selectorAlgHom L).fieldRange) :=
  AlgEquiv.ofInjectiveField (selectorAlgHom L)

/-- The selector field contains a copy of `L`. -/
theorem nonempty_algHom_selectorField (hm : m ≠ 0) (hk : k ≠ 0) :
    Nonempty (L →ₐ[ℚ] ↥(selectorField L m k S)) :=
  ⟨(IntermediateField.inclusion (fieldRange_selectorAlgHom_le L m k S hm hk)).comp
    (selectorRangeEquiv L).toAlgHom⟩

/-! ### Roots of unity and radicals in the selector field -/

/-- The selector field contains a primitive `m`-th root of unity. -/
theorem exists_isPrimitiveRoot_selectorField (hm : m ≠ 0) (hk : k ≠ 0) :
    ∃ ζ : ↥(selectorField L m k S), IsPrimitiveRoot ζ m := by
  haveI : NeZero m := ⟨hm⟩
  haveI : NeZero ((m : ℕ) : ℚ) := ⟨Nat.cast_ne_zero.2 hm⟩
  obtain ⟨ζ₀, hζ₀⟩ :=
    HasEnoughRootsOfUnity.exists_primitiveRoot (AlgebraicClosure ℚ) m
  have hmem : ζ₀ ∈ selectorField L m k S := by
    refine mem_selectorField_of_dvd_of_aeval_eq_zero L m k S hm hk
      (X_pow_sub_one_dvd_selectorPoly L m k S) ?_
    simp [hζ₀.pow_eq_one]
  exact ⟨⟨ζ₀, hmem⟩, IsPrimitiveRoot.of_map_of_injective
    (f := algebraMap ↥(selectorField L m k S) (AlgebraicClosure ℚ)) (by exact hζ₀)
    (algebraMap ↥(selectorField L m k S) (AlgebraicClosure ℚ)).injective⟩

/-- The selector field contains a `k`-th root of every element of `S`. -/
theorem exists_pow_eq_natCast_selectorField (hm : m ≠ 0) (hk : k ≠ 0) {p : ℕ} (hp : p ∈ S) :
    ∃ x : ↥(selectorField L m k S), x ^ k = (p : ↥(selectorField L m k S)) := by
  obtain ⟨α, hα⟩ :=
    IsAlgClosed.exists_pow_nat_eq ((p : ℕ) : AlgebraicClosure ℚ) (Nat.pos_of_ne_zero hk)
  have hmem : α ∈ selectorField L m k S := by
    refine mem_selectorField_of_dvd_of_aeval_eq_zero L m k S hm hk
      (X_pow_sub_C_dvd_selectorPoly L m k S hp) ?_
    simp [hα]
  refine ⟨⟨α, hmem⟩, ?_⟩
  apply Subtype.ext
  push_cast
  exact hα

end InverseGalois.CFT
