import Mathlib
import InverseGalois.CFT.Scholz.RadicalDegree

/-!
# Radicals of two-power exponent

For an odd prime `ℓ` the polynomial `X ^ ℓ ^ M` minus a constant is irreducible as soon as the
constant has no `ℓ`-th root, whatever the exponent `M`.  At the prime two the corresponding
statement is false — a fourth power of a square root of minus one is a fourth power of a square
root of the constant only after a twist — and the honest criterion involves the constant modulo
fourth powers of minus four.  Over a field already containing a square root of minus one that
correction disappears: minus four is then the fourth power of one plus that square root, so a
constant which is not a square has no representation obstructing irreducibility, and `X ^ 2 ^ M`
minus the constant is irreducible.

The proof runs the same induction as the quartic case.  Splitting off one square root of the
constant, a square root of that square root would have a norm whose square is minus the constant,
and multiplying that norm by the square root of minus one produces a square root of the constant
itself.  What is new is that the induction proceeds over the field generated by the first square
root, so the statement has to be carried over all fields at once.

Two consequences for radical fields follow.  A rational number without a square root in a field
containing the roots of unity of order `2 ^ M` is enlarged by the full factor `2 ^ M`; and a
rational number which does have a square root there, but no fourth root, is still enlarged by the
factor `2 ^ (M - 1)`, because the `2 ^ M`-th root is a `2 ^ (M - 1)`-st root of an element of the
field.

## Main results

* `InverseGalois.CFT.X_pow_two_pow_sub_C_irreducible`: **over a field containing a square root of
  minus one, `X` raised to a power of two, minus a non-square, is irreducible.**
* `InverseGalois.CFT.le_finrank_sup_radicalField_two_pow`: **a radical of two-power exponent
  multiplies the degree of a field of matching roots of unity by that exponent**, as soon as the
  radicand has no square root there.
* `InverseGalois.CFT.le_finrank_sup_radicalField_two_pow_of_sq`: a radical of two-power exponent
  of a radicand which is a square but not a fourth power multiplies the degree by half that
  exponent.

## Tags

Kummer theory, irreducibility, two-power radical, cyclotomic field, radical field
-/

open Module Polynomial IntermediateField

namespace InverseGalois.CFT

/-! ### Irreducibility of `X ^ 2 ^ M - C a` -/

section Irreducible

universe u

/-- **Over a field containing a square root of minus one, `X` raised to a power of two, minus a
non-square, is irreducible.**  Adjoining a square root `x` of the constant, a square root of `x`
would have a norm whose square is minus the constant, so multiplying that norm by the square root
of minus one would produce a square root of the constant; the induction on the exponent therefore
runs over all fields containing a square root of minus one at once. -/
theorem X_pow_two_pow_sub_C_irreducible (M : ℕ) :
    ∀ (K : Type u) [Field K] (i : K), i ^ 2 = -1 → ∀ a : K, (∀ b : K, b ^ 2 ≠ a) →
      Irreducible ((X : K[X]) ^ 2 ^ M - C a) := by
  induction M with
  | zero =>
    intro K _ _ _ a _
    simpa using irreducible_X_sub_C a
  | succ M ih =>
    intro K _ i hi a ha
    rw [pow_succ]
    refine X_pow_mul_sub_C_irreducible (X_pow_sub_C_irreducible_of_prime Nat.prime_two ha) ?_
    intro E _ _ x hx
    have hint : IsIntegral K x := not_not.mp fun h ↦ by
      simpa only [degree_zero, degree_X_pow_sub_C Nat.prime_two.pos,
        WithBot.natCast_ne_bot] using congr_arg degree (hx.symm.trans (dif_neg h))
    refine ih ↥K⟮x⟯ (algebraMap K ↥K⟮x⟯ i) (by rw [← map_pow, hi, map_neg, map_one]) _ ?_
    intro b hb
    refine ha (i * Algebra.norm K b) ?_
    have hnorm : Algebra.norm K b ^ 2 = -a := by
      rw [← map_pow, hb, ← adjoin.powerBasis_gen hint,
        Algebra.PowerBasis.norm_gen_eq_coeff_zero_minpoly]
      simp [minpoly_gen, hx]
    rw [mul_pow, hi, hnorm]
    ring

end Irreducible

/-! ### The degree of a radical of two-power exponent -/

section Degree

variable {A : IntermediateField ℚ (AlgebraicClosure ℚ)} {M : ℕ} {m : ℚ}
variable {α η i s : AlgebraicClosure ℚ}

/-- The degree over a field of a root of an element of that field is the exponent as soon as the
corresponding radical polynomial is irreducible, that polynomial then being the minimal polynomial
of the root. -/
theorem finrank_adjoin_of_irreducible_coeff {c : ↥A} {n : ℕ} (hn : n ≠ 0)
    (hirr : Irreducible ((X : (↥A)[X]) ^ n - C c))
    (hα : α ^ n = algebraMap ↥A (AlgebraicClosure ℚ) c) :
    finrank ↥A ↥(IntermediateField.adjoin ↥A ({α} : Set (AlgebraicClosure ℚ))) = n := by
  have haeval : Polynomial.aeval α ((X : (↥A)[X]) ^ n - C c) = 0 := by
    rw [map_sub, map_pow, aeval_X, aeval_C, hα, sub_self]
  have hmonic : ((X : (↥A)[X]) ^ n - C c).Monic := Polynomial.monic_X_pow_sub_C _ hn
  rw [IntermediateField.adjoin.finrank ⟨_, hmonic, haeval⟩,
    ← minpoly.eq_of_irreducible_of_monic hirr haeval hmonic, natDegree_X_pow_sub_C]

/-- A square root of minus one lying in an intermediate field of the algebraic closure, read as an
element of that field. -/
theorem sq_coe_eq_neg_one (hiA : i ∈ A) (hi : i ^ 2 = -1) : (⟨i, hiA⟩ : ↥A) ^ 2 = -1 := by
  apply Subtype.ext
  push_cast
  exact hi

/-- **Over an intermediate field of the algebraic closure containing a square root of minus one,
`X` raised to a power of two, minus a rational number having no square root there, is
irreducible.** -/
theorem irreducible_X_pow_two_pow_sub_C_of_forall_sq_ne (hiA : i ∈ A) (hi : i ^ 2 = -1)
    (hm : ∀ u ∈ A, u ^ 2 ≠ algebraMap ℚ (AlgebraicClosure ℚ) m) :
    Irreducible ((X : (↥A)[X]) ^ 2 ^ M - C (algebraMap ℚ ↥A m)) := by
  refine X_pow_two_pow_sub_C_irreducible M ↥A ⟨i, hiA⟩ (sq_coe_eq_neg_one hiA hi) _ ?_
  intro b hb
  refine hm (b : AlgebraicClosure ℚ) b.2 ?_
  rw [← algebraMap_intermediateField_eq A m, ← hb, map_pow]
  rfl

/-- **The compositum of a field containing the roots of unity of two-power order with the radical
field of that order of a rational number having no square root there has degree the full multiple
of the degree of the field.**  The corresponding radical polynomial is irreducible, so one root of
it already generates an extension of that degree. -/
theorem le_finrank_sup_radicalField_two_pow (hη : IsPrimitiveRoot η (2 ^ M)) (hηA : η ∈ A)
    (hiA : i ∈ A) (hi : i ^ 2 = -1) (hm0 : m ≠ 0)
    (hm : ∀ u ∈ A, u ^ 2 ≠ algebraMap ℚ (AlgebraicClosure ℚ) m) :
    2 ^ M * finrank ℚ ↥A ≤ finrank ℚ ↥(A ⊔ radicalField (2 ^ M) ({m} : Finset ℚ)) := by
  obtain ⟨α, hα⟩ := IsAlgClosed.exists_pow_nat_eq (algebraMap ℚ (AlgebraicClosure ℚ) m)
    (pow_pos (by norm_num : (0 : ℕ) < 2) M)
  refine le_finrank_sup_radicalField_singleton (pow_ne_zero M (by norm_num)) hη hηA hm0 hα ?_
  exact (finrank_adjoin_of_irreducible (pow_ne_zero M (by norm_num))
    (irreducible_X_pow_two_pow_sub_C_of_forall_sq_ne hiA hi hm) hα).ge

/-- **The compositum of a field containing the roots of unity of two-power order with the radical
field of that order of a rational number having a square root but no fourth root there has degree
at least half that multiple of the degree of the field.**  A root of the order in question is a
root of half the order of one of the two square roots of the number, both of which lie in the
field, and that square root is not itself a square there. -/
theorem le_finrank_sup_radicalField_two_pow_of_sq (hM : M ≠ 0) (hη : IsPrimitiveRoot η (2 ^ M))
    (hηA : η ∈ A) (hiA : i ∈ A) (hi : i ^ 2 = -1) (hm0 : m ≠ 0) (hsA : s ∈ A)
    (hs : s ^ 2 = algebraMap ℚ (AlgebraicClosure ℚ) m)
    (hm4 : ∀ u ∈ A, u ^ 4 ≠ algebraMap ℚ (AlgebraicClosure ℚ) m) :
    2 ^ (M - 1) * finrank ℚ ↥A ≤ finrank ℚ ↥(A ⊔ radicalField (2 ^ M) ({m} : Finset ℚ)) := by
  obtain ⟨α, hα⟩ := IsAlgClosed.exists_pow_nat_eq (algebraMap ℚ (AlgebraicClosure ℚ) m)
    (pow_pos (by norm_num : (0 : ℕ) < 2) M)
  refine le_finrank_sup_radicalField_singleton (pow_ne_zero M (by norm_num)) hη hηA hm0 hα ?_
  have hsplit : 2 ^ (M - 1) * 2 = 2 ^ M := by
    rw [← pow_succ]
    congr 1
    omega
  have hβ2 : (α ^ 2 ^ (M - 1)) ^ 2 = algebraMap ℚ (AlgebraicClosure ℚ) m := by
    rw [← pow_mul, hsplit, hα]
  have hβA : α ^ 2 ^ (M - 1) ∈ A := by
    have hzero : (α ^ 2 ^ (M - 1) - s) * (α ^ 2 ^ (M - 1) + s) = 0 := by
      have : (α ^ 2 ^ (M - 1) - s) * (α ^ 2 ^ (M - 1) + s) = (α ^ 2 ^ (M - 1)) ^ 2 - s ^ 2 := by
        ring
      rw [this, hβ2, hs, sub_self]
    rcases mul_eq_zero.mp hzero with h | h
    · rw [sub_eq_zero] at h
      exact h ▸ hsA
    · have hneg : α ^ 2 ^ (M - 1) = -s := by
        rw [← neg_eq_of_add_eq_zero_left h]
      exact hneg ▸ neg_mem hsA
  have hirr : Irreducible ((X : (↥A)[X]) ^ 2 ^ (M - 1) - C (⟨_, hβA⟩ : ↥A)) := by
    refine X_pow_two_pow_sub_C_irreducible (M - 1) ↥A ⟨i, hiA⟩ (sq_coe_eq_neg_one hiA hi) _ ?_
    intro b hb
    refine hm4 (b : AlgebraicClosure ℚ) b.2 ?_
    have hb' : (b : AlgebraicClosure ℚ) ^ 2 = α ^ 2 ^ (M - 1) := congrArg Subtype.val hb
    rw [show (4 : ℕ) = 2 * 2 by norm_num, pow_mul, hb', hβ2]
  exact (finrank_adjoin_of_irreducible_coeff (pow_ne_zero _ (by norm_num)) hirr rfl).ge

end Degree

end InverseGalois.CFT
