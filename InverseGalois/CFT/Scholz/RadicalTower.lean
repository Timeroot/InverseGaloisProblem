import Mathlib
import InverseGalois.CFT.Scholz.RadicalDisjoint

/-!
# The radical field attached to a finite set of rationals

Fix an odd prime `ℓ` and a finite set `S` of rational numbers.  Inside a fixed algebraic closure of
`ℚ` we build the field `ℚ(μ_ℓ, c^{1/ℓ} : c ∈ S)`, the field generated by the `ℓ`-th roots of unity
together with all the `ℓ`-th roots of the elements of `S`.  It is the splitting field of the
polynomial `∏_{c ∈ {1} ∪ S} (X ^ ℓ - c)`, and putting the constant `1` into the product is what
supplies the roots of unity, so that a single product describes the whole field and its whole set
of radical generators at once.

The resulting field is a number field and is Galois over `ℚ`, and it is generated over `ℚ` by
elements whose `ℓ`-th powers are rational.  Feeding this to the analysis of such fields yields the
disjointness statement that the Scholz–Reichardt induction needs: no Galois extension of `ℚ` of
degree `ℓ` is contained in a radical field, so a degree-`ℓ` Galois field meets `ℚ(μ_ℓ, c^{1/ℓ})` in
`ℚ` only, no matter which finitely many rationals `c` one throws in.

## Main definitions

* `radicalPoly`: the polynomial `∏_{c ∈ {1} ∪ S} (X ^ ℓ - c)` over `ℚ`.
* `radicalField`: its splitting field inside `AlgebraicClosure ℚ`.
* `radicalGens`: the roots of `radicalPoly` viewed inside `radicalField`.

## Main results

* `isSplittingField_radicalField`: `radicalField ℓ S` splits `radicalPoly ℓ S`, whence the
  `NumberField` and `IsGalois` instances.
* `adjoin_radicalGens`: the radical generators generate the field.
* `exists_isPrimitiveRoot_radicalGens`: a primitive `ℓ`-th root of unity is among them.
* `exists_pow_eq_radicalField`: every element of `S` has an `ℓ`-th root in the field.
* `finrank_ne_of_radicalField`: no subextension of `radicalField ℓ S` is Galois of degree `ℓ`.
* `not_exists_normal_quotient_card_radicalField`: its Galois group has no quotient of order `ℓ`.
* `inf_radicalField_eq_bot`: **a degree-`ℓ` Galois field meets `radicalField ℓ S` in `ℚ` only.**
-/

open Module Polynomial IntermediateField

namespace InverseGalois.CFT

variable (ℓ : ℕ) (S : Finset ℚ)

/-- The polynomial whose roots are the `ℓ`-th roots of unity together with the `ℓ`-th roots of the
elements of `S`.  Adjoining the constant `1` to the index set is what contributes the roots of
unity. -/
noncomputable def radicalPoly : ℚ[X] := ∏ c ∈ insert 1 S, (X ^ ℓ - C c)

/-- The field `ℚ(μ_ℓ, c^{1/ℓ} : c ∈ S)`, realised inside a fixed algebraic closure of `ℚ` as the
subfield generated by all roots of `radicalPoly ℓ S`. -/
noncomputable def radicalField : IntermediateField ℚ (AlgebraicClosure ℚ) :=
  adjoin ℚ ((radicalPoly ℓ S).rootSet (AlgebraicClosure ℚ))

/-- For `ℓ ≠ 0` each factor `X ^ ℓ - c` is a nonzero polynomial, hence so is their product. -/
theorem radicalPoly_ne_zero (hℓ : ℓ ≠ 0) : radicalPoly ℓ S ≠ 0 :=
  Finset.prod_ne_zero_iff.mpr fun c _ => X_pow_sub_C_ne_zero (Nat.pos_of_ne_zero hℓ) c

/-- **The radical field is a splitting field.**  Every polynomial splits in an algebraic closure,
and a subfield generated by the roots of a polynomial that splits is a splitting field for it. -/
theorem isSplittingField_radicalField :
    IsSplittingField ℚ ↥(radicalField ℓ S) (radicalPoly ℓ S) :=
  IntermediateField.adjoin_rootSet_isSplittingField (IsAlgClosed.splits _)

/-- A splitting field of a single polynomial is finite over the base field. -/
instance finiteDimensional_radicalField : FiniteDimensional ℚ ↥(radicalField ℓ S) :=
  haveI := isSplittingField_radicalField ℓ S
  IsSplittingField.finiteDimensional _ (radicalPoly ℓ S)

/-- Being a finite extension of `ℚ`, the radical field is a number field. -/
instance numberField_radicalField : NumberField ↥(radicalField ℓ S) := ⟨⟩

/-- A splitting field is normal over the base field. -/
instance normal_radicalField : Normal ℚ ↥(radicalField ℓ S) :=
  haveI := isSplittingField_radicalField ℓ S
  Normal.of_isSplittingField (radicalPoly ℓ S)

/-- Normal plus separable, the latter for free in characteristic zero. -/
instance isGalois_radicalField : IsGalois ℚ ↥(radicalField ℓ S) := ⟨⟩

variable {ℓ S}

/-- Every root of `radicalPoly ℓ S` has rational `ℓ`-th power: it is a root of one of the factors
`X ^ ℓ - c`. -/
theorem exists_pow_eq_of_mem_rootSet {α : AlgebraicClosure ℚ}
    (hα : α ∈ (radicalPoly ℓ S).rootSet (AlgebraicClosure ℚ)) :
    ∃ c : ℚ, α ^ ℓ = algebraMap ℚ (AlgebraicClosure ℚ) c := by
  rw [mem_rootSet] at hα
  obtain ⟨-, h⟩ := hα
  rw [radicalPoly, map_prod] at h
  obtain ⟨c, -, hc⟩ := Finset.prod_eq_zero_iff.mp h
  refine ⟨c, ?_⟩
  simp only [map_sub, map_pow, aeval_X, aeval_C, sub_eq_zero] at hc
  exact hc

/-- Every `ℓ`-th root of unity is a root of `radicalPoly ℓ S`, via the factor indexed by `1`. -/
theorem mem_rootSet_radicalPoly_of_pow_eq_one (hℓ : ℓ ≠ 0) {α : AlgebraicClosure ℚ}
    (hα : α ^ ℓ = 1) : α ∈ (radicalPoly ℓ S).rootSet (AlgebraicClosure ℚ) := by
  rw [mem_rootSet]
  refine ⟨radicalPoly_ne_zero ℓ S hℓ, ?_⟩
  rw [radicalPoly, map_prod]
  refine Finset.prod_eq_zero (Finset.mem_insert_self 1 S) ?_
  simp [hα]

variable (ℓ S)

/-- The roots of `radicalPoly ℓ S`, read as a set of elements of `radicalField ℓ S` rather than of
the ambient algebraic closure. -/
noncomputable def radicalGens : Set ↥(radicalField ℓ S) :=
  Subtype.val ⁻¹' (radicalPoly ℓ S).rootSet (AlgebraicClosure ℚ)

/-- Pushing the radical generators back into the algebraic closure recovers the whole root set,
because every root lies in the field they generate. -/
theorem image_radicalGens :
    (Subtype.val '' radicalGens ℓ S : Set (AlgebraicClosure ℚ))
      = (radicalPoly ℓ S).rootSet (AlgebraicClosure ℚ) :=
  Set.image_preimage_eq_of_subset fun α hα => ⟨⟨α, subset_adjoin ℚ _ hα⟩, rfl⟩

/-- **The radical generators generate the radical field**, by definition of the latter as the
subfield of the algebraic closure generated by the root set. -/
theorem adjoin_radicalGens : adjoin ℚ (radicalGens ℓ S) = ⊤ := by
  refine IntermediateField.lift_injective (radicalField ℓ S) ?_
  rw [IntermediateField.lift_adjoin, IntermediateField.lift_top, image_radicalGens]
  rfl

variable {ℓ S}

/-- Each radical generator has rational `ℓ`-th power, computed in the radical field itself. -/
theorem exists_pow_eq_of_mem_radicalGens {α : ↥(radicalField ℓ S)} (hα : α ∈ radicalGens ℓ S) :
    ∃ c : ℚ, α ^ ℓ = algebraMap ℚ ↥(radicalField ℓ S) c := by
  obtain ⟨c, hc⟩ := exists_pow_eq_of_mem_rootSet hα
  refine ⟨c, Subtype.ext ?_⟩
  rw [IntermediateField.coe_pow, hc, IsScalarTower.algebraMap_apply ℚ ↥(radicalField ℓ S)]
  rfl

/-- **A primitive `ℓ`-th root of unity lies among the radical generators.**  The algebraic closure
of `ℚ` contains one, and it is a root of the factor of `radicalPoly ℓ S` indexed by `1`. -/
theorem exists_isPrimitiveRoot_radicalGens (hℓ : ℓ ≠ 0) :
    ∃ ζ : ↥(radicalField ℓ S), IsPrimitiveRoot ζ ℓ ∧ ζ ∈ radicalGens ℓ S := by
  haveI : NeZero ((ℓ : ℕ) : ℚ) := ⟨Nat.cast_ne_zero.mpr hℓ⟩
  obtain ⟨ζ, hζ⟩ := HasEnoughRootsOfUnity.exists_primitiveRoot (AlgebraicClosure ℚ) ℓ
  have hmem : ζ ∈ (radicalPoly ℓ S).rootSet (AlgebraicClosure ℚ) :=
    mem_rootSet_radicalPoly_of_pow_eq_one hℓ hζ.pow_eq_one
  refine ⟨⟨ζ, subset_adjoin ℚ _ hmem⟩, ?_, hmem⟩
  exact IsPrimitiveRoot.of_map_of_injective
    (f := algebraMap ↥(radicalField ℓ S) (AlgebraicClosure ℚ)) hζ
    (algebraMap ↥(radicalField ℓ S) (AlgebraicClosure ℚ)).injective

/-- **Every element of `S` acquires an `ℓ`-th root.**  A root exists in the algebraic closure and
is a root of the factor of `radicalPoly ℓ S` indexed by that element. -/
theorem exists_pow_eq_radicalField (hℓ : ℓ ≠ 0) {c : ℚ} (hc : c ∈ S) :
    ∃ α : ↥(radicalField ℓ S), α ^ ℓ = algebraMap ℚ ↥(radicalField ℓ S) c := by
  obtain ⟨α, hα⟩ := IsAlgClosed.exists_pow_nat_eq
    (algebraMap ℚ (AlgebraicClosure ℚ) c) (Nat.pos_of_ne_zero hℓ)
  have hmem : α ∈ (radicalPoly ℓ S).rootSet (AlgebraicClosure ℚ) := by
    rw [mem_rootSet]
    refine ⟨radicalPoly_ne_zero ℓ S hℓ, ?_⟩
    rw [radicalPoly, map_prod]
    exact Finset.prod_eq_zero (Finset.mem_insert_of_mem hc) (by simp [hα])
  refine ⟨⟨α, subset_adjoin ℚ _ hmem⟩, Subtype.ext ?_⟩
  rw [IntermediateField.coe_pow, hα, IsScalarTower.algebraMap_apply ℚ ↥(radicalField ℓ S)]
  rfl

/-- **No subextension of a radical field is Galois of degree `ℓ`**, for `ℓ` an odd prime.  The
field is generated by a primitive `ℓ`-th root of unity together with elements of rational `ℓ`-th
power, and such a field has no quotient of order `ℓ`. -/
theorem finrank_ne_of_radicalField [Fact ℓ.Prime] (hodd : Odd ℓ)
    (E : IntermediateField ℚ ↥(radicalField ℓ S)) [IsGalois ℚ ↥E] : finrank ℚ ↥E ≠ ℓ := by
  obtain ⟨ζ, hζ, hmem⟩ := exists_isPrimitiveRoot_radicalGens (S := S) (Fact.out : ℓ.Prime).ne_zero
  refine finrank_ne_of_radical hodd hζ (fun α hα => exists_pow_eq_of_mem_radicalGens hα) ?_ E
  rw [Set.insert_eq_self.mpr hmem]
  exact adjoin_radicalGens ℓ S

/-- **The Galois group of a radical field has no normal subgroup of index `ℓ`**, for `ℓ` an odd
prime. -/
theorem not_exists_normal_quotient_card_radicalField [Fact ℓ.Prime] (hodd : Odd ℓ) :
    ¬ ∃ N : Subgroup (↥(radicalField ℓ S) ≃ₐ[ℚ] ↥(radicalField ℓ S)), ∃ _ : N.Normal,
      Nat.card ((↥(radicalField ℓ S) ≃ₐ[ℚ] ↥(radicalField ℓ S)) ⧸ N) = ℓ := by
  obtain ⟨ζ, hζ, hmem⟩ := exists_isPrimitiveRoot_radicalGens (S := S) (Fact.out : ℓ.Prime).ne_zero
  refine not_exists_normal_quotient_card_of_radical hodd hζ
    (fun α hα => exists_pow_eq_of_mem_radicalGens hα) ?_
  rw [Set.insert_eq_self.mpr hmem]
  exact adjoin_radicalGens ℓ S

/-- **A degree-`ℓ` Galois field meets a radical field in `ℚ` only**, for `ℓ` an odd prime and any
finite set `S` of rationals.  The intersection has degree dividing the prime `ℓ`, and degree `ℓ`
would place the whole Galois field inside the radical field. -/
theorem inf_radicalField_eq_bot [Fact ℓ.Prime] (hodd : Odd ℓ)
    (E : IntermediateField ℚ (AlgebraicClosure ℚ)) [IsGalois ℚ ↥E] (hE : finrank ℚ ↥E = ℓ) :
    E ⊓ radicalField ℓ S = ⊥ := by
  haveI : FiniteDimensional ℚ ↥E :=
    Module.finite_of_finrank_pos (by rw [hE]; exact (Fact.out : ℓ.Prime).pos)
  have hdvd : finrank ℚ ↥(E ⊓ radicalField ℓ S) ∣ ℓ := by
    rw [← hE]; exact IntermediateField.finrank_dvd_of_le_right inf_le_left
  rcases (Fact.out : ℓ.Prime).eq_one_or_self_of_dvd _ hdvd with h1 | hl
  · exact IntermediateField.finrank_eq_one_iff.mp h1
  exfalso
  have hER : E ≤ radicalField ℓ S :=
    inf_eq_left.mp (IntermediateField.eq_of_le_of_finrank_eq inf_le_left (by rw [hl, hE]))
  haveI : IsGalois ℚ ↥(IntermediateField.restrict hER) :=
    IsGalois.of_algEquiv (IntermediateField.restrict_algEquiv hER)
  refine finrank_ne_of_radicalField hodd (IntermediateField.restrict hER) ?_
  rw [← (IntermediateField.restrict_algEquiv hER).toLinearEquiv.finrank_eq, hE]

end InverseGalois.CFT
