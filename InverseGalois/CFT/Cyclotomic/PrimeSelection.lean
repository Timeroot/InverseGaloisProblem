import Mathlib
import InverseGalois.NumberTheory.SplitCompletely
import InverseGalois.CFT.Cyclotomic.Splitting

/-!
# Selecting primes that split completely and satisfy a congruence

Two conditions on a rational prime `q` are needed simultaneously by the rigidity method: that `q`
split completely in a prescribed Galois number field `E`, and that `q ≡ 1` modulo a prescribed
modulus `m`.  Both are splitting conditions: the second says that `q` splits completely in the
`m`-th cyclotomic field.  Splitting completely in a compositum is the conjunction of splitting
completely in the two factors, so it suffices to know that infinitely many primes split completely
in a single number field, namely one containing both `E` and a primitive `m`-th root of unity.

## Main results

* `InverseGalois.CFT.splitsCompletely_of_tower` — splitting completely passes from a number field
  to any subfield.
* `InverseGalois.CFT.exists_prime_splitsCompletely_and_modEq` — beyond any bound there is a prime
  which is `1` modulo `m` and which splits completely in `E`.
* `InverseGalois.CFT.infinite_setOf_prime_splitsCompletely_and_modEq` — the set of such primes is
  infinite.
-/

open NumberField Polynomial

open scoped IntermediateField

namespace InverseGalois.CFT

/-- **Splitting completely descends to subfields.**  Ramification indices and residue degrees are
multiplicative in towers, so if a prime of the bottom field carries both invariants equal to one
after being pushed all the way to the top, the intermediate contributions are already one. -/
theorem splitsCompletely_of_tower {E M : Type*} [Field E] [NumberField E] [Field M]
    [NumberField M] [Algebra E M] [IsScalarTower ℚ E M] {p : ℕ} [Fact p.Prime]
    (h : NumberTheory.SplitsCompletely M p) : NumberTheory.SplitsCompletely E p := by
  have hp : p.Prime := Fact.out
  have hpz : Prime (p : ℤ) := Nat.prime_iff_prime_int.mp hp
  have hspan_ne : Ideal.span {(p : ℤ)} ≠ ⊥ := by
    simp [Ideal.span_singleton_eq_bot, hp.ne_zero]
  haveI hspanP : (Ideal.span {(p : ℤ)}).IsPrime :=
    (Ideal.span_singleton_prime (by exact_mod_cast hp.ne_zero)).mpr hpz
  haveI : (Ideal.span {(p : ℤ)}).IsMaximal := hspanP.isMaximal hspan_ne
  intro P hP
  obtain ⟨hP1, hP2⟩ := hP
  haveI : P.IsPrime := hP1
  haveI : P.LiesOver (Ideal.span {(p : ℤ)}) := hP2
  haveI : P.IsMaximal := Ideal.IsMaximal.of_liesOver_isMaximal P (Ideal.span {(p : ℤ)})
  have hPne : P ≠ ⊥ := Ideal.ne_bot_of_mem_primesOver hspan_ne (P := P) ⟨hP1, hP2⟩
  obtain ⟨Q, hQmax, hQlo⟩ := Ideal.exists_maximal_ideal_liesOver_of_isIntegral (S := 𝓞 M) P
  haveI : Q.IsMaximal := hQmax
  haveI : Q.LiesOver P := hQlo
  haveI : Q.IsPrime := hQmax.isPrime
  haveI : Q.LiesOver (Ideal.span {(p : ℤ)}) := Ideal.LiesOver.trans Q P (Ideal.span {(p : ℤ)})
  obtain ⟨he, hf⟩ := h Q ⟨inferInstance, inferInstance⟩
  have hmapP : Ideal.map (algebraMap (𝓞 E) (𝓞 M)) P ≠ ⊥ := by
    rw [Ne, Ideal.map_eq_bot_iff_of_injective (RingOfIntegers.algebraMap.injective E M)]
    exact hPne
  have hmapp : Ideal.map (algebraMap ℤ (𝓞 M)) (Ideal.span {(p : ℤ)}) ≠ ⊥ := by
    rw [Ne, Ideal.map_eq_bot_iff_of_injective (FaithfulSMul.algebraMap_injective ℤ (𝓞 M))]
    exact hspan_ne
  have hle : Ideal.map (algebraMap (𝓞 E) (𝓞 M)) P ≤ Q :=
    Ideal.map_le_iff_le_comap.mpr (Q.over_def P).le
  have hram := Ideal.ramificationIdx_algebra_tower (R := ℤ) (S := 𝓞 E) (T := 𝓞 M)
    (p := Ideal.span {(p : ℤ)}) (P := P) (Q := Q) hmapP hmapp hle
  have hdeg := Ideal.inertiaDeg_algebra_tower (R := ℤ) (S := 𝓞 E) (T := 𝓞 M)
    (Ideal.span {(p : ℤ)}) P Q
  exact ⟨Nat.dvd_one.mp ⟨_, (hram.symm.trans he).symm⟩,
    Nat.dvd_one.mp ⟨_, (hdeg.symm.trans hf).symm⟩⟩

/-- **Beyond any bound there is a prime congruent to `1` modulo `m` that splits completely in a
Galois number field containing a primitive `m`-th root of unity.**  Infinitely many primes split
completely in such a field, and splitting completely descends both to the subfield in question and
to the cyclotomic subfield generated by the root of unity, where it becomes the congruence. -/
theorem exists_prime_splitsCompletely_and_modEq_of_isPrimitiveRoot (E M : Type*) [Field E]
    [NumberField E] [Field M] [NumberField M] [IsGalois ℚ M] [Algebra E M] [IsScalarTower ℚ E M]
    (m : ℕ) (hm : m ≠ 0) {ζ : M} (hζ : IsPrimitiveRoot ζ m) (B : ℕ) :
    ∃ q : ℕ, B < q ∧ q.Prime ∧ q ≡ 1 [MOD m] ∧ NumberTheory.SplitsCompletely E q := by
  haveI : NeZero m := ⟨hm⟩
  haveI : IsCyclotomicExtension {m} ℚ ℚ⟮ζ⟯ := hζ.intermediateField_adjoin_isCyclotomicExtension ℚ
  haveI : NumberField ℚ⟮ζ⟯ := ⟨⟩
  obtain ⟨q, hqmem, hqgt⟩ :=
    (NumberTheory.infinite_setOf_prime_splitsCompletely M).exists_gt (max B m)
  obtain ⟨hqprime, hqM⟩ := hqmem
  haveI : Fact q.Prime := ⟨hqprime⟩
  have hqm : m < q := lt_of_le_of_lt (le_max_right B m) hqgt
  have hnd : ¬ q ∣ m := fun hd =>
    absurd (Nat.le_of_dvd (Nat.pos_of_ne_zero hm) hd) (not_le.mpr hqm)
  refine ⟨q, lt_of_le_of_lt (le_max_left B m) hqgt, hqprime, ?_,
    splitsCompletely_of_tower (M := M) hqM⟩
  exact modEq_of_splitsCompletely m ℚ⟮ζ⟯ q hnd (splitsCompletely_of_tower (M := M) hqM)

/-- **Beyond any bound there is a prime congruent to `1` modulo `m` that splits completely in a
given Galois number field.**  The splitting field of the product of a defining polynomial of the
field with `Xᵐ - 1` is a Galois number field containing both a copy of the given field and a
primitive `m`-th root of unity, and the previous result applies to it. -/
theorem exists_prime_splitsCompletely_and_modEq (E : Type*) [Field E] [NumberField E]
    [IsGalois ℚ E] (m : ℕ) (hm : m ≠ 0) (B : ℕ) :
    ∃ q : ℕ, B < q ∧ q.Prime ∧ q ≡ 1 [MOD m] ∧ NumberTheory.SplitsCompletely E q := by
  haveI : NeZero m := ⟨hm⟩
  obtain ⟨f, hfsep, hfsplit⟩ := IsGalois.is_separable_splitting_field ℚ E
  haveI : f.IsSplittingField ℚ E := hfsplit
  have hcm : ((X : ℚ[X]) ^ m - 1).Monic := by
    simpa using monic_X_pow_sub_C (1 : ℚ) hm
  have hg0 : f * ((X : ℚ[X]) ^ m - 1) ≠ 0 := mul_ne_zero hfsep.ne_zero hcm.ne_zero
  let M := (f * ((X : ℚ[X]) ^ m - 1)).SplittingField
  haveI : NumberField M := ⟨⟩
  haveI : Normal ℚ M := Normal.of_isSplittingField (f * ((X : ℚ[X]) ^ m - 1))
  haveI : IsGalois ℚ M := ⟨⟩
  have hgsplit : Splits ((f * ((X : ℚ[X]) ^ m - 1)).map (algebraMap ℚ M)) :=
    IsSplittingField.splits M _
  have hgm0 : (f * ((X : ℚ[X]) ^ m - 1)).map (algebraMap ℚ M) ≠ 0 :=
    (Polynomial.map_ne_zero_iff (algebraMap ℚ M).injective).mpr hg0
  have hfM : Splits (f.map (algebraMap ℚ M)) :=
    hgsplit.of_dvd hgm0 (Polynomial.map_dvd _ (dvd_mul_right f _))
  have hXM : Splits ((X : M[X]) ^ m - 1) := by
    have h2 := hgsplit.of_dvd hgm0 (Polynomial.map_dvd (algebraMap ℚ M) (dvd_mul_left _ f))
    simpa using h2
  -- the copy of `E` inside `M`
  let φ : E →ₐ[ℚ] M := IsSplittingField.lift E f hfM
  letI : Algebra E M := φ.toRingHom.toAlgebra
  haveI : IsScalarTower ℚ E M := IsScalarTower.of_algebraMap_eq fun x => (φ.commutes x).symm
  -- a primitive `m`-th root of unity inside `M`
  haveI : NeZero (m : M) := ⟨Nat.cast_ne_zero.mpr hm⟩
  have hXne : ((X : M[X]) ^ m - 1) ≠ 0 := by
    simpa using (Polynomial.monic_X_pow_sub_C (1 : M) hm).ne_zero
  have hcyc : Splits (cyclotomic m M) :=
    hXM.of_dvd hXne (cyclotomic.dvd_X_pow_sub_one m M)
  obtain ⟨ζ, hζ⟩ := hcyc.exists_eval_eq_zero (by
    rw [degree_cyclotomic m M]
    exact_mod_cast (Nat.totient_pos.mpr (Nat.pos_of_ne_zero hm)).ne')
  exact exists_prime_splitsCompletely_and_modEq_of_isPrimitiveRoot E M m hm
    (isRoot_cyclotomic_iff.mp hζ) B

/-- **Infinitely many primes are congruent to `1` modulo `m` and split completely in a given
Galois number field.** -/
theorem infinite_setOf_prime_splitsCompletely_and_modEq (E : Type*) [Field E] [NumberField E]
    [IsGalois ℚ E] (m : ℕ) (hm : m ≠ 0) :
    {q : ℕ | q.Prime ∧ q ≡ 1 [MOD m] ∧ NumberTheory.SplitsCompletely E q}.Infinite := by
  refine Set.infinite_of_forall_exists_gt fun B => ?_
  obtain ⟨q, hqB, hq⟩ := exists_prime_splitsCompletely_and_modEq E m hm B
  exact ⟨q, hq, hqB⟩

end InverseGalois.CFT
