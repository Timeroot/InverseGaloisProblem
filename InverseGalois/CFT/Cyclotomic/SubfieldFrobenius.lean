import Mathlib
import InverseGalois.CFT.Cyclotomic.FrobeniusSplitting

/-!
# The decomposition group of an intermediate field, read upstairs

A normal intermediate field of a Galois number field inherits its arithmetic Frobenius from the
field above: the restriction of the Frobenius at a prime is a Frobenius at the prime underneath,
and at an unramified prime the Frobenius is unique, so the two agree.  The decomposition group of
the intermediate field is generated by its Frobenius, so its order is the order of the restricted
Frobenius, and that order divides a number exactly when the corresponding power of the Frobenius
upstairs fixes the intermediate field pointwise.

That last form is what turns a congruence upstairs into the local degree of a subfield: splitting
completely is the case of the exponent one, and the general exponent measures how far the local
degree is from the whole degree.

## Main results

* `InverseGalois.CFT.arithFrobAt_under_eq_restrictNormalHom`: **the arithmetic Frobenius of a
  normal intermediate field is the restriction of the arithmetic Frobenius above it.**
* `InverseGalois.CFT.card_stabilizer_under_dvd_iff_mem_fixingSubgroup`: **the order of the
  decomposition group of a normal intermediate field divides a number exactly when that power of
  the Frobenius above it fixes the intermediate field pointwise.**

## Tags

Frobenius, decomposition group, intermediate field, local degree, number field
-/

set_option synthInstance.maxHeartbeats 1000000

open NumberField IsCyclotomicExtension InverseGalois.NumberTheory MulAction

open scoped Pointwise

namespace InverseGalois.CFT

section Subfield

variable {K : Type*} [Field K] [NumberField K] [IsGalois ℚ K]

omit [IsGalois ℚ K] in
/-- The residue field at the prime underneath an intermediate field embeds in the residue field
above it, so it is finite as soon as that one is. -/
instance finite_quotient_under (F : IntermediateField ℚ K) (P : Ideal (𝓞 K))
    [Finite (𝓞 K ⧸ P)] : Finite (𝓞 ↥F ⧸ P.under (𝓞 ↥F)) :=
  .of_injective _ Ideal.algebraMap_quotient_injective

/-- **The arithmetic Frobenius of a normal intermediate field is the restriction of the arithmetic
Frobenius above it.**  The restriction is a Frobenius at the prime underneath, and at an
unramified prime there is only one. -/
theorem arithFrobAt_under_eq_restrictNormalHom (F : IntermediateField ℚ K) [IsGalois ℚ ↥F]
    (p : ℕ) [Fact p.Prime] (P : Ideal (𝓞 K)) [P.IsPrime] [Finite (𝓞 K ⧸ P)]
    [P.LiesOver (Ideal.span {(p : ℤ)})] (hunr : Algebra.IsUnramifiedAt ℤ P) :
    arithFrobAt ℤ Gal(↥F/ℚ) (P.under (𝓞 ↥F))
      = AlgEquiv.restrictNormalHom F (arithFrobAt ℤ Gal(K/ℚ) P) := by
  haveI : Algebra.IsUnramifiedAt ℤ P := hunr
  haveI : (P.under (𝓞 ↥F)).LiesOver (Ideal.span {(p : ℤ)}) :=
    ⟨by rw [Ideal.under_under]; exact Ideal.over_def P _⟩
  haveI : Algebra.IsUnramifiedAt ℤ (P.under (𝓞 ↥F)) :=
    Algebra.IsUnramifiedAt.of_liesOver ℤ (P.under (𝓞 ↥F)) P
  exact (eq_arithFrobAt_of_isArithFrobAt (K := ↥F) (P.under (𝓞 ↥F))
    (ne_bot_of_liesOver (K := ↥F) p _) ‹_›
    (isArithFrobAt_restrictNormal F _ P (IsArithFrobAt.arithFrobAt ℤ Gal(K/ℚ) P))).symm

/-- **The order of the decomposition group of a normal intermediate field is the order of the
restricted Frobenius**, the decomposition group at an unramified prime being generated by the
Frobenius there. -/
theorem card_stabilizer_under_eq_orderOf_restrictNormalHom (F : IntermediateField ℚ K)
    [IsGalois ℚ ↥F] (p : ℕ) [Fact p.Prime] (P : Ideal (𝓞 K)) [P.IsPrime] [Finite (𝓞 K ⧸ P)]
    [P.LiesOver (Ideal.span {(p : ℤ)})] (hunr : Algebra.IsUnramifiedAt ℤ P) :
    Nat.card ↥(stabilizer Gal(↥F/ℚ) (P.under (𝓞 ↥F)))
      = orderOf (AlgEquiv.restrictNormalHom F (arithFrobAt ℤ Gal(K/ℚ) P)) := by
  haveI : Algebra.IsUnramifiedAt ℤ P := hunr
  haveI : (P.under (𝓞 ↥F)).LiesOver (Ideal.span {(p : ℤ)}) :=
    ⟨by rw [Ideal.under_under]; exact Ideal.over_def P _⟩
  haveI : Algebra.IsUnramifiedAt ℤ (P.under (𝓞 ↥F)) :=
    Algebra.IsUnramifiedAt.of_liesOver ℤ (P.under (𝓞 ↥F)) P
  rw [stabilizer_eq_zpowers_arithFrobAt (K := ↥F) (P.under (𝓞 ↥F))
      (ne_bot_of_liesOver (K := ↥F) p _) ‹_›, Nat.card_zpowers,
    arithFrobAt_under_eq_restrictNormalHom F p P hunr]

/-- **The order of the decomposition group of a normal intermediate field divides a number exactly
when that power of the Frobenius above it fixes the intermediate field pointwise.**  For the
exponent one this is the criterion for splitting completely. -/
theorem card_stabilizer_under_dvd_iff_mem_fixingSubgroup (F : IntermediateField ℚ K)
    [IsGalois ℚ ↥F] (p : ℕ) [Fact p.Prime] (P : Ideal (𝓞 K)) [P.IsPrime] [Finite (𝓞 K ⧸ P)]
    [P.LiesOver (Ideal.span {(p : ℤ)})] (hunr : Algebra.IsUnramifiedAt ℤ P) (m : ℕ) :
    Nat.card ↥(stabilizer Gal(↥F/ℚ) (P.under (𝓞 ↥F))) ∣ m
      ↔ arithFrobAt ℤ Gal(K/ℚ) P ^ m ∈ F.fixingSubgroup := by
  rw [card_stabilizer_under_eq_orderOf_restrictNormalHom F p P hunr, orderOf_dvd_iff_pow_eq_one,
    ← map_pow, ← MonoidHom.mem_ker, IntermediateField.restrictNormalHom_ker]

end Subfield

end InverseGalois.CFT
