import Mathlib
import InverseGalois.CFT.GroupCohomology.IndexTwo

/-!
# The subgroup fixing a square root of minus one

A square root `j` of minus one in a field acted on by a group is moved inside the two element set
`{j, -j}`, because its image is again a square root of minus one and a field has no more than two
of them.  The elements fixing `j` therefore form a subgroup with at most two cosets, which is
consequently normal, and one element outside it is enough to cover the group by the subgroup and
one translate.

The point of this configuration is the norm form of the quadratic extension generated by `j`.  If
`f` is fixed by the subgroup and `σ` is outside it, then `σ • f * f` is the sum of the squares of
the two invariant elements `(f + σ • f) / 2` and `(f - σ • f) / (2 j)`; and if the whole group
fixes `j` then every invariant element is such a sum, for the trivial reason that `-1` is then a
square.  Together these say that an element which is a norm locally is locally a sum of two
squares, in whatever field the configuration is realised.

For a Galois extension of number fields, the fixed field of the subgroup contains `j` and is
therefore totally complex, no ring homomorphism to the real numbers being able to accommodate a
square root of minus one.

## Main results

* `InverseGalois.CFT.smul_eq_or_eq_neg_of_sq_eq_neg_one`: an element of the group either fixes a
  square root of minus one or negates it.
* `InverseGalois.CFT.stabilizer_normal_of_sq_eq_neg_one`: **the subgroup fixing a square root of
  minus one is normal.**
* `InverseGalois.CFT.mem_stabilizer_or_mul_inv_mem`: the subgroup and one translate of it cover
  the group.
* `InverseGalois.CFT.exists_sq_add_sq_of_smul_mul_eq`: **a norm from the subgroup fixing a square
  root of minus one is a sum of two squares of invariant elements.**
* `InverseGalois.CFT.exists_sq_add_sq_of_forall_smul_eq`: when the whole group fixes the square
  root, every invariant element is a sum of two squares of invariant elements.
* `InverseGalois.CFT.exists_not_mem_stabilizer_of_sq_eq_neg_one`: over a base with no square root
  of minus one the subgroup is proper.
* `InverseGalois.CFT.isTotallyComplex_of_sq_eq_neg_one`: a number field with a square root of minus
  one is totally complex.
* `InverseGalois.CFT.isTotallyComplex_fixedField_stabilizer`: **the fixed field of the subgroup
  fixing a square root of minus one is totally complex.**

## Tags

Galois group, square root of minus one, index two, sum of two squares, norm form, totally complex
-/

namespace InverseGalois.CFT

open MulAction NumberField

section Stabilizer

variable {Γ L : Type*} [Group Γ] [Field L] [MulSemiringAction Γ L] {j : L}

/-- **An element of the group either fixes a square root of minus one or negates it**, a field
having no more than two square roots of a given element. -/
theorem smul_eq_or_eq_neg_of_sq_eq_neg_one (hj : j ^ 2 = -1) (σ : Γ) :
    σ • j = j ∨ σ • j = -j := by
  have hsq : (σ • j) ^ 2 = j ^ 2 := by
    rw [← smul_pow', hj, smul_neg, smul_one]
  have h : (σ • j - j) * (σ • j + j) = 0 := by linear_combination hsq
  rcases mul_eq_zero.mp h with h1 | h1
  · exact Or.inl (sub_eq_zero.mp h1)
  · exact Or.inr (eq_neg_of_add_eq_zero_left h1)

variable {σ : Γ}

/-- The inverse of an element fixing a square root of minus one fixes it. -/
theorem smul_inv_eq_self (h : σ • j = j) : σ⁻¹ • j = j := by
  rw [inv_smul_eq_iff, h]

/-- The inverse of an element negating a square root of minus one negates it. -/
theorem smul_inv_eq_neg (h : σ • j = -j) : σ⁻¹ • j = -j := by
  rw [inv_smul_eq_iff, smul_neg, h, neg_neg]

/-- An element of the group not fixing a square root of minus one negates it. -/
theorem smul_eq_neg_of_not_mem_stabilizer (hj : j ^ 2 = -1) (hσ : σ ∉ stabilizer Γ j) :
    σ • j = -j :=
  (smul_eq_or_eq_neg_of_sq_eq_neg_one hj σ).resolve_left fun h => hσ (mem_stabilizer_iff.mpr h)

/-- **The subgroup fixing a square root of minus one is normal**: conjugating by an element which
negates the square root negates it twice, and so changes nothing. -/
theorem stabilizer_normal_of_sq_eq_neg_one (hj : j ^ 2 = -1) : (stabilizer Γ j).Normal where
  conj_mem n hn g := by
    rw [mem_stabilizer_iff] at hn ⊢
    rw [mul_smul, mul_smul]
    rcases smul_eq_or_eq_neg_of_sq_eq_neg_one hj g with h | h
    · rw [smul_inv_eq_self h, hn, h]
    · rw [smul_inv_eq_neg h, smul_neg, hn, smul_neg, h, neg_neg]

/-- **The subgroup fixing a square root of minus one together with one translate of it covers the
whole group**, once a single element outside the subgroup is given. -/
theorem mem_stabilizer_or_mul_inv_mem (hj : j ^ 2 = -1) (hσ : σ ∉ stabilizer Γ j) (g : Γ) :
    g ∈ stabilizer Γ j ∨ g * σ⁻¹ ∈ stabilizer Γ j := by
  rcases smul_eq_or_eq_neg_of_sq_eq_neg_one hj g with h | h
  · exact Or.inl (mem_stabilizer_iff.mpr h)
  · refine Or.inr (mem_stabilizer_iff.mpr ?_)
    rw [mul_smul, smul_inv_eq_neg (smul_eq_neg_of_not_mem_stabilizer hj hσ), smul_neg, h, neg_neg]

end Stabilizer

section SumTwoSquares

variable {Γ L : Type*} [Group Γ] [Field L] [MulSemiringAction Γ L] {j : L}

/-- A group acting by ring automorphisms fixes the numeral two. -/
theorem smul_two (g : Γ) : g • (2 : L) = 2 := by
  rw [show (2 : L) = 1 + 1 by norm_num, smul_add, smul_one]

/-- A square root of minus one is nonzero. -/
theorem ne_zero_of_sq_eq_neg_one (hj : j ^ 2 = -1) : j ≠ 0 := by
  intro h
  rw [h] at hj
  norm_num at hj

/-- An element fixed by the subgroup fixing a square root of minus one has its translate by an
element outside also fixed by the subgroup. -/
theorem smul_smul_eq_of_mem_stabilizer (hj : j ^ 2 = -1) {σ : Γ} {f : L}
    (hf : ∀ n ∈ stabilizer Γ j, n • f = f) {g : Γ} (hg : g ∈ stabilizer Γ j) :
    g • (σ • f) = σ • f := by
  have hN := stabilizer_normal_of_sq_eq_neg_one (Γ := Γ) hj
  have hconj : σ⁻¹ * g * σ ∈ stabilizer Γ j := by
    simpa using hN.conj_mem g hg σ⁻¹
  rw [smul_smul, show g * σ = σ * (σ⁻¹ * g * σ) by group, mul_smul, hf _ hconj]

/-- **A norm from the subgroup fixing a square root of minus one is a sum of two squares of
invariant elements.**  The two squares are those of the trace and of the quotient by the square
root of the difference, halved. -/
theorem exists_sq_add_sq_of_smul_mul_eq (h2 : (2 : L) ≠ 0) (hj : j ^ 2 = -1) {σ : Γ}
    (hσ : σ ∉ stabilizer Γ j) {f : L} (hf : ∀ n ∈ stabilizer Γ j, n • f = f) :
    ∃ x y : L, (∀ g : Γ, g • x = x) ∧ (∀ g : Γ, g • y = y) ∧ σ • f * f = x ^ 2 + y ^ 2 := by
  have hj0 : j ≠ 0 := ne_zero_of_sq_eq_neg_one hj
  have hσj : σ • j = -j := smul_eq_neg_of_not_mem_stabilizer hj hσ
  have hcov : ∀ g : Γ, g ∈ stabilizer Γ j ∨ g * σ⁻¹ ∈ stabilizer Γ j :=
    mem_stabilizer_or_mul_inv_mem hj hσ
  have hσσ : σ * σ ∈ stabilizer Γ j := mul_self_mem_of_two_cosets hcov hσ
  have hσf : σ • (σ • f) = f := by rw [smul_smul, hf _ hσσ]
  refine ⟨(f + σ • f) / 2, (f - σ • f) / (2 * j), ?_, ?_, ?_⟩
  · intro g
    have hstab : ∀ n ∈ stabilizer Γ j, n • ((f + σ • f) / 2) = (f + σ • f) / 2 := by
      intro n hn
      rw [smul_div₀', smul_add, hf n hn, smul_smul_eq_of_mem_stabilizer hj hf hn, smul_two]
    have hσfix : σ • ((f + σ • f) / 2) = (f + σ • f) / 2 := by
      rw [smul_div₀', smul_add, hσf, smul_two, add_comm]
    rcases hcov g with hg | hg
    · exact hstab g hg
    · rw [show g = g * σ⁻¹ * σ by group, mul_smul, hσfix, hstab _ hg]
  · intro g
    have hstab : ∀ n ∈ stabilizer Γ j, n • ((f - σ • f) / (2 * j)) = (f - σ • f) / (2 * j) := by
      intro n hn
      rw [smul_div₀', smul_sub, hf n hn, smul_smul_eq_of_mem_stabilizer hj hf hn, smul_mul',
        smul_two, mem_stabilizer_iff.mp hn]
    have hσfix : σ • ((f - σ • f) / (2 * j)) = (f - σ • f) / (2 * j) := by
      rw [smul_div₀', smul_sub, hσf, smul_mul', smul_two, hσj]
      rw [mul_neg, div_neg, neg_div', neg_sub]
    rcases hcov g with hg | hg
    · exact hstab g hg
    · rw [show g = g * σ⁻¹ * σ by group, mul_smul, hσfix, hstab _ hg]
  · rw [div_pow, div_pow, mul_pow, hj]
    rw [div_add_div _ _ (pow_ne_zero 2 h2) (by simpa using pow_ne_zero 2 h2),
      eq_div_iff (by simp [pow_ne_zero 2 h2])]
    ring

/-- **When the whole group fixes a square root of minus one, every invariant element is a sum of
two squares of invariant elements**, minus one being a square. -/
theorem exists_sq_add_sq_of_forall_smul_eq (h2 : (2 : L) ≠ 0) (hj : j ^ 2 = -1)
    (hjfix : ∀ g : Γ, g • j = j) {c : L} (hc : ∀ g : Γ, g • c = c) :
    ∃ x y : L, (∀ g : Γ, g • x = x) ∧ (∀ g : Γ, g • y = y) ∧ c = x ^ 2 + y ^ 2 := by
  refine ⟨(c + 1) / 2, (c - 1) / (2 * j), fun g => ?_, fun g => ?_, ?_⟩
  · rw [smul_div₀', smul_add, hc g, smul_one, smul_two]
  · rw [smul_div₀', smul_sub, hc g, smul_one, smul_mul', smul_two, hjfix g]
  · rw [div_pow, div_pow, mul_pow, hj]
    rw [div_add_div _ _ (pow_ne_zero 2 h2) (by simpa using pow_ne_zero 2 h2),
      eq_div_iff (by simp [pow_ne_zero 2 h2])]
    ring

end SumTwoSquares

section NumberFields

variable {F K : Type*} [Field F] [Field K] [Algebra F K] {j : K}

/-- A square root of minus one lies in the fixed field of the subgroup fixing it. -/
theorem mem_fixedField_stabilizer (j : K) :
    j ∈ IntermediateField.fixedField (stabilizer (K ≃ₐ[F] K) j) := by
  rw [IntermediateField.mem_fixedField_iff]
  exact fun f hf => mem_stabilizer_iff.mp hf

/-- **Over a base with no square root of minus one the subgroup fixing one is proper.**  Were it
the whole Galois group the square root would be fixed by every automorphism, hence rational. -/
theorem exists_not_mem_stabilizer_of_sq_eq_neg_one [FiniteDimensional F K] [IsGalois F K]
    (hj : j ^ 2 = -1) (hF : ∀ x : F, x ^ 2 ≠ -1) :
    ∃ σ : K ≃ₐ[F] K, σ ∉ stabilizer (K ≃ₐ[F] K) j := by
  by_contra hcon
  push_neg at hcon
  obtain ⟨x, hx⟩ := (IsGalois.mem_range_algebraMap_iff_fixed j).mpr
    fun f => mem_stabilizer_iff.mp (hcon f)
  refine hF x ?_
  have h : algebraMap F K (x ^ 2) = algebraMap F K (-1) := by
    rw [map_pow, hx, hj, map_neg, map_one]
  exact (algebraMap F K).injective h

/-- **A number field with a square root of minus one is totally complex**, no ring homomorphism to
the real numbers being able to accommodate a square root of minus one. -/
theorem isTotallyComplex_of_sq_eq_neg_one {L : Type*} [Field L] [NumberField L] {x : L}
    (hx : x ^ 2 = -1) : IsTotallyComplex L where
  isComplex w := by
    rw [← InfinitePlace.not_isReal_iff_isComplex]
    rintro ⟨φ, hφ, -⟩
    have h : hφ.embedding x ^ 2 = -1 := by rw [← map_pow, hx, map_neg, map_one]
    nlinarith [sq_nonneg (hφ.embedding x)]

/-- No rational number is a square root of minus one. -/
theorem rat_sq_ne_neg_one (x : ℚ) : x ^ 2 ≠ -1 := by
  intro h
  nlinarith [sq_nonneg x]

/-- **The fixed field of the subgroup fixing a square root of minus one is totally complex**, since
the square root lies in it. -/
theorem isTotallyComplex_fixedField_stabilizer {K : Type*} [Field K] [NumberField K]
    [Algebra ℚ K] {j : K} (hj : j ^ 2 = -1) :
    IsTotallyComplex ↥(IntermediateField.fixedField (stabilizer (K ≃ₐ[ℚ] K) j)) :=
  isTotallyComplex_of_sq_eq_neg_one (x := ⟨j, mem_fixedField_stabilizer j⟩)
    (Subtype.ext (by push_cast; exact hj))

end NumberFields

end InverseGalois.CFT
