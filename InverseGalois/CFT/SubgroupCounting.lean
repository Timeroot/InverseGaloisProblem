import Mathlib

/-!
# Counting a group generated by normal subgroups

A group generated by a finite family of normal subgroups is a product of those subgroups as a set,
so its order is at most the product of their orders.  This is the counting step of the classical
proof of the Kronecker–Weber theorem: the Galois group of an abelian number field is generated by
the inertia subgroups of the ramified primes, so its degree is bounded by the product of the
ramification indices.

## Main results

* `InverseGalois.CFT.card_sup_le_mul`: the order of `H ⊔ N` is at most the product of the orders
  of `H` and `N`, for `N` normal.
* `InverseGalois.CFT.card_iSup_le_prod`: the order of the subgroup generated by a finite family of
  normal subgroups is at most the product of their orders.
* `InverseGalois.CFT.card_le_prod_of_iSup_eq_top`: **if a finite family of normal subgroups
  generates the whole group, its order is at most the product of their orders.**
* `InverseGalois.CFT.iSup_eq_biSup_of_eq_bot`: a supremum over an arbitrary index type collapses to
  a supremum over a finite subset outside of which the subgroups are trivial.
* `InverseGalois.CFT.iSup_fiber`, `InverseGalois.CFT.biSup_fiber`: grouping a supremum of subgroups
  by the fibres of a map on the index type.
* `InverseGalois.CFT.biSup_eq_closure`: a supremum over a subset of the index type is the subgroup
  generated by the union.
* `InverseGalois.CFT.card_sup_of_disjoint`: the order of `H ⊔ D` is exactly the product of the
  orders when `H` is normal and the two subgroups are disjoint.
* `InverseGalois.CFT.exists_finset_iSup_eq`: **a commutative group generated by subgroups of prime
  order `p` is generated by an independent finite subfamily**, whose cardinality is the exponent of
  `p` in the order of the group.
-/

namespace InverseGalois.CFT

open scoped Pointwise

variable {G : Type*} [Group G]

/-- **The order of a product of two subgroups.**  If `N` is normal then `H ⊔ N` is the set-theoretic
product of `H` and `N`, hence the image of `H × N`, so its order is at most `|H| * |N|`. -/
theorem card_sup_le_mul [Finite G] (H N : Subgroup G) [N.Normal] :
    Nat.card ↥(H ⊔ N) ≤ Nat.card H * Nat.card N := by
  have hsurj : Function.Surjective
      (fun x : H × N => (⟨(x.1 : G) * (x.2 : G), by
        exact Subgroup.mul_mem _ (le_sup_left (b := N) x.1.2) (le_sup_right (a := H) x.2.2)⟩ :
        ↥(H ⊔ N))) := by
    rintro ⟨y, hy⟩
    have : y ∈ (H : Set G) * (N : Set G) := by
      rw [← Subgroup.mul_normal H N]
      exact hy
    obtain ⟨h, hh, n, hn, rfl⟩ := this
    exact ⟨(⟨h, hh⟩, ⟨n, hn⟩), rfl⟩
  calc Nat.card ↥(H ⊔ N) ≤ Nat.card (H × N) := Nat.card_le_card_of_surjective _ hsurj
    _ = Nat.card H * Nat.card N := Nat.card_prod _ _

/-- **The order of a subgroup generated by finitely many normal subgroups.**  It is at most the
product of their orders. -/
theorem card_iSup_le_prod [Finite G] {ι : Type*} (H : ι → Subgroup G) (hH : ∀ i, (H i).Normal)
    (s : Finset ι) : Nat.card ↥(⨆ i ∈ s, H i) ≤ ∏ i ∈ s, Nat.card (H i) := by
  classical
  induction s using Finset.induction_on with
  | empty => simp
  | insert a s ha ih =>
      haveI : (H a).Normal := hH a
      have hins : (⨆ i ∈ insert a s, H i) = (⨆ i ∈ s, H i) ⊔ H a := by
        rw [Finset.iSup_insert]
        exact sup_comm _ _
      calc Nat.card ↥(⨆ i ∈ insert a s, H i)
          = Nat.card ↥((⨆ i ∈ s, H i) ⊔ H a) := by rw [hins]
        _ ≤ Nat.card ↥(⨆ i ∈ s, H i) * Nat.card (H a) := card_sup_le_mul _ _
        _ ≤ (∏ i ∈ s, Nat.card (H i)) * Nat.card (H a) := Nat.mul_le_mul_right _ ih
        _ = ∏ i ∈ insert a s, Nat.card (H i) := by
              rw [Finset.prod_insert ha]
              exact Nat.mul_comm _ _

/-- **A group generated by finitely many normal subgroups is no bigger than their product.** -/
theorem card_le_prod_of_iSup_eq_top [Finite G] {ι : Type*} (H : ι → Subgroup G)
    (hH : ∀ i, (H i).Normal) (s : Finset ι) (hs : (⨆ i ∈ s, H i) = ⊤) :
    Nat.card G ≤ ∏ i ∈ s, Nat.card (H i) := by
  have h := card_iSup_le_prod H hH s
  rwa [hs, Subgroup.card_top] at h

/-- **Collapsing a supremum to its support.**  A supremum of subgroups indexed by an arbitrary type
equals the supremum over a finite subset carrying all the nontrivial members. -/
theorem iSup_eq_biSup_of_eq_bot {ι : Type*} (H : ι → Subgroup G) (s : Finset ι)
    (h : ∀ i, i ∉ s → H i = ⊥) : (⨆ i, H i) = ⨆ i ∈ s, H i := by
  refine le_antisymm (iSup_le fun i => ?_) (iSup_le fun i => iSup_le fun _ => le_iSup H i)
  by_cases hi : i ∈ s
  · exact le_trans (le_iSup (fun _ : i ∈ s => H i) hi) (le_iSup (fun j => ⨆ _ : j ∈ s, H j) i)
  · rw [h i hi]
    exact bot_le

/-- Grouping a supremum by the fibres of a map on the index type. -/
theorem iSup_fiber {ι κ : Type*} (f : ι → Subgroup G) (q : ι → κ) (s : ι → Prop) :
    (⨆ v : κ, ⨆ w, ⨆ _ : s w ∧ q w = v, f w) = ⨆ w, ⨆ _ : s w, f w := by
  refine le_antisymm (iSup_le fun v => iSup₂_le fun w hw => ?_) (iSup₂_le fun w hw => ?_)
  · exact le_iSup₂ (f := fun w (_ : s w) => f w) w hw.1
  · exact le_trans (le_iSup₂ (f := fun w' (_ : s w' ∧ q w' = q w) => f w') w ⟨hw, rfl⟩)
      (le_iSup (fun v => ⨆ w, ⨆ _ : s w ∧ q w = v, f w) (q w))

/-- Grouping a supremum over a subset of the index type by the fibres of a map. -/
theorem biSup_fiber {ι κ : Type*} (f : ι → Subgroup G) (q : ι → κ) (s : ι → Prop)
    (t : κ → Prop) :
    (⨆ v, ⨆ _ : t v, ⨆ w, ⨆ _ : s w ∧ q w = v, f w) = ⨆ w, ⨆ _ : s w ∧ t (q w), f w := by
  refine le_antisymm (iSup₂_le fun v hv => iSup₂_le fun w hw => ?_) (iSup₂_le fun w hw => ?_)
  · exact le_iSup₂ (f := fun w (_ : s w ∧ t (q w)) => f w) w ⟨hw.1, hw.2 ▸ hv⟩
  · exact le_trans (le_iSup₂ (f := fun w' (_ : s w' ∧ q w' = q w) => f w') w ⟨hw.1, rfl⟩)
      (le_iSup₂ (f := fun v (_ : t v) => ⨆ w, ⨆ _ : s w ∧ q w = v, f w) (q w) hw.2)

/-- A supremum over a subset of the index type is the subgroup generated by the union. -/
theorem biSup_eq_closure {ι : Type*} (f : ι → Subgroup G) (s : ι → Prop) :
    (⨆ i, ⨆ _ : s i, f i) = Subgroup.closure (⋃ i, ⋃ _ : s i, (f i : Set G)) := by
  refine le_antisymm (iSup₂_le fun i hi x hx => Subgroup.subset_closure ?_)
    (Subgroup.closure_le _ |>.mpr ?_)
  · exact Set.mem_iUnion.mpr ⟨i, Set.mem_iUnion.mpr ⟨hi, hx⟩⟩
  · rintro x hx
    simp only [Set.mem_iUnion, SetLike.mem_coe, exists_prop] at hx
    obtain ⟨i, hi, hxi⟩ := hx
    exact le_iSup₂ (f := fun i (_ : s i) => f i) i hi hxi

/-- **The order of a product of two disjoint subgroups.**  For `H` normal and disjoint from `D`,
the relative index of `H` in `H ⊔ D` is the order of `D`. -/
theorem card_sup_of_disjoint [Finite G] {H D : Subgroup G} [H.Normal] (h : Disjoint H D) :
    Nat.card ↥(H ⊔ D) = Nat.card H * Nat.card D := by
  have hrel : H.relIndex D = Nat.card D := by
    rw [Subgroup.relIndex, Subgroup.subgroupOf_eq_bot.mpr h, Subgroup.index_bot]
  have hsup : H.relIndex (H ⊔ D) = Nat.card D := by
    rw [Subgroup.relIndex_sup_left, hrel]
  have h1 : H.relIndex (H ⊔ D) * (H ⊔ D).index = H.index :=
    Subgroup.relIndex_mul_index le_sup_left
  have h2 : Nat.card H * H.index = Nat.card G := Subgroup.card_mul_index H
  have h3 : Nat.card ↥(H ⊔ D) * (H ⊔ D).index = Nat.card G := Subgroup.card_mul_index _
  have hne : (H ⊔ D).index ≠ 0 := Subgroup.index_ne_zero_of_finite
  refine Nat.eq_of_mul_eq_mul_right (Nat.pos_of_ne_zero hne) ?_
  rw [h3, ← h2, ← h1, hsup]
  ring

/-- **Extracting an independent generating subfamily.**  Let a finite commutative group `N` be
generated by a family of subgroups each of order dividing a prime `p`.  Greedily adjoining a
member not yet contained in the subgroup generated so far multiplies the order by exactly `p`, by
`card_sup_of_disjoint`, so the process stops after `t` steps where `p ^ t` is the order of `N`. -/
theorem exists_finset_iSup_eq [Finite G] (hcomm : ∀ a b : G, a * b = b * a) {p : ℕ} (hp : p.Prime)
    {ι : Type*} (D : ι → Subgroup G) (hD : ∀ i, Nat.card (D i) ∣ p) {N : Subgroup G}
    (hgen : (⨆ i, D i) = N) :
    ∃ J : Finset ι, (⨆ i ∈ J, D i) = N ∧ Nat.card N = p ^ J.card ∧
      ∀ i ∈ J, Nat.card (D i) = p := by
  classical
  haveI hnorm : ∀ K : Subgroup G, K.Normal := fun K => ⟨fun n hn g => by
    rw [hcomm g n, mul_assoc, mul_inv_cancel, mul_one]; exact hn⟩
  have hJle : ∀ J : Finset ι, (⨆ i ∈ J, D i) ≤ N := fun J =>
    iSup_le fun i => iSup_le fun _ => hgen ▸ le_iSup D i
  have key : ∀ n : ℕ, ∀ J : Finset ι, Nat.card ↥(⨆ i ∈ J, D i) = p ^ J.card →
      (∀ i ∈ J, Nat.card (D i) = p) →
      Nat.card N ≤ p ^ n * Nat.card ↥(⨆ i ∈ J, D i) →
      ∃ J' : Finset ι, (⨆ i ∈ J', D i) = N ∧ Nat.card N = p ^ J'.card ∧
        ∀ i ∈ J', Nat.card (D i) = p := by
    intro n
    induction n with
    | zero =>
      intro J hcard hord hle
      have heq : (⨆ i ∈ J, D i) = N :=
        Subgroup.eq_of_le_of_card_ge (hJle J) (by simpa using hle)
      exact ⟨J, heq, by rw [← heq, hcard], hord⟩
    | succ n ih =>
      intro J hcard hord hle
      set H := ⨆ i ∈ J, D i with hH
      by_cases hHN : H = N
      · exact ⟨J, hHN, by rw [← hHN, hcard], hord⟩
      have hex : ∃ i, ¬ (D i ≤ H) := by
        by_contra hc
        push_neg at hc
        exact hHN (le_antisymm (hJle J) (hgen ▸ iSup_le hc))
      obtain ⟨i, hi⟩ := hex
      have hiJ : i ∉ J := fun hmem =>
        hi (le_trans (le_iSup (fun _ : i ∈ J => D i) hmem) (le_iSup (fun j => ⨆ _ : j ∈ J, D j) i))
      have hdisj : Disjoint H (D i) := by
        rw [disjoint_iff]
        by_contra hc
        have hdvd : Nat.card ↥(H ⊓ D i) ∣ p :=
          dvd_trans (Subgroup.card_dvd_of_le inf_le_right) (hD i)
        rcases hp.eq_one_or_self_of_dvd _ hdvd with h1 | h1
        · exact hc (Subgroup.card_eq_one.mp h1)
        · have hinf : H ⊓ D i = D i :=
            Subgroup.eq_of_le_of_card_ge inf_le_right
              (by rw [h1]; exact Nat.le_of_dvd hp.pos (hD i))
          exact hi (hinf ▸ inf_le_left)
      have hDi : Nat.card (D i) = p := by
        rcases hp.eq_one_or_self_of_dvd _ (hD i) with h1 | h1
        · exact absurd (Subgroup.card_eq_one.mp h1 ▸ bot_le) hi
        · exact h1
      have hins : (⨆ j ∈ insert i J, D j) = H ⊔ D i := by
        rw [hH, Finset.iSup_insert]
        exact sup_comm _ _
      refine ih (insert i J) ?_ ?_ ?_
      · rw [hins, card_sup_of_disjoint hdisj, hcard, hDi, Finset.card_insert_of_notMem hiJ]
        ring
      · intro j hj
        rcases Finset.mem_insert.mp hj with rfl | hj
        · exact hDi
        · exact hord j hj
      · rw [hins, card_sup_of_disjoint hdisj, hDi]
        calc Nat.card N ≤ p ^ (n + 1) * Nat.card H := hle
          _ = p ^ n * (Nat.card H * p) := by ring
  obtain ⟨n, hn⟩ : ∃ n : ℕ, Nat.card N ≤ p ^ n :=
    ⟨Nat.card N, le_of_lt (Nat.lt_pow_self hp.one_lt)⟩
  refine key n ∅ (by simp) (by simp) ?_
  simpa using hn

end InverseGalois.CFT
