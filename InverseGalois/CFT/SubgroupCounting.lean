import Mathlib

/-!
# Counting a group generated by normal subgroups

A group generated by a finite family of normal subgroups is a product of those subgroups as a set,
so its order is at most the product of their orders.  This is the counting step of the classical
proof of the Kronecker–Weber theorem: the Galois group of an abelian number field is generated by
the inertia subgroups of the ramified primes, so its degree is bounded by the product of the
ramification indices.

## Main results

* `InverseGalois.CFT.card_sup_le_mul`: the order of `H ⊔ N` is at most the product of the orders
  of `H` and `N`, for `N` normal.
* `InverseGalois.CFT.card_iSup_le_prod`: the order of the subgroup generated by a finite family of
  normal subgroups is at most the product of their orders.
* `InverseGalois.CFT.card_le_prod_of_iSup_eq_top`: **if a finite family of normal subgroups
  generates the whole group, its order is at most the product of their orders.**
* `InverseGalois.CFT.iSup_eq_biSup_of_eq_bot`: a supremum over an arbitrary index type collapses to
  a supremum over a finite subset outside of which the subgroups are trivial.
-/

namespace InverseGalois.CFT

open scoped Pointwise

variable {G : Type*} [Group G]

/-- **The order of a product of two subgroups.**  If `N` is normal then `H ⊔ N` is the set-theoretic
product of `H` and `N`, hence the image of `H × N`, so its order is at most `|H| * |N|`. -/
theorem card_sup_le_mul [Finite G] (H N : Subgroup G) [N.Normal] :
    Nat.card ↥(H ⊔ N) ≤ Nat.card H * Nat.card N := by
  have hsurj : Function.Surjective
      (fun x : H × N => (⟨(x.1 : G) * (x.2 : G), by
        exact Subgroup.mul_mem _ (le_sup_left (b := N) x.1.2) (le_sup_right (a := H) x.2.2)⟩ :
        ↥(H ⊔ N))) := by
    rintro ⟨y, hy⟩
    have : y ∈ (H : Set G) * (N : Set G) := by
      rw [← Subgroup.mul_normal H N]
      exact hy
    obtain ⟨h, hh, n, hn, rfl⟩ := this
    exact ⟨(⟨h, hh⟩, ⟨n, hn⟩), rfl⟩
  calc Nat.card ↥(H ⊔ N) ≤ Nat.card (H × N) := Nat.card_le_card_of_surjective _ hsurj
    _ = Nat.card H * Nat.card N := Nat.card_prod _ _

/-- **The order of a subgroup generated by finitely many normal subgroups.**  It is at most the
product of their orders. -/
theorem card_iSup_le_prod [Finite G] {ι : Type*} (H : ι → Subgroup G) (hH : ∀ i, (H i).Normal)
    (s : Finset ι) : Nat.card ↥(⨆ i ∈ s, H i) ≤ ∏ i ∈ s, Nat.card (H i) := by
  classical
  induction s using Finset.induction_on with
  | empty => simp
  | insert a s ha ih =>
      haveI : (H a).Normal := hH a
      have hins : (⨆ i ∈ insert a s, H i) = (⨆ i ∈ s, H i) ⊔ H a := by
        rw [Finset.iSup_insert]
        exact sup_comm _ _
      calc Nat.card ↥(⨆ i ∈ insert a s, H i)
          = Nat.card ↥((⨆ i ∈ s, H i) ⊔ H a) := by rw [hins]
        _ ≤ Nat.card ↥(⨆ i ∈ s, H i) * Nat.card (H a) := card_sup_le_mul _ _
        _ ≤ (∏ i ∈ s, Nat.card (H i)) * Nat.card (H a) := Nat.mul_le_mul_right _ ih
        _ = ∏ i ∈ insert a s, Nat.card (H i) := by
              rw [Finset.prod_insert ha]
              exact Nat.mul_comm _ _

/-- **A group generated by finitely many normal subgroups is no bigger than their product.** -/
theorem card_le_prod_of_iSup_eq_top [Finite G] {ι : Type*} (H : ι → Subgroup G)
    (hH : ∀ i, (H i).Normal) (s : Finset ι) (hs : (⨆ i ∈ s, H i) = ⊤) :
    Nat.card G ≤ ∏ i ∈ s, Nat.card (H i) := by
  have h := card_iSup_le_prod H hH s
  rwa [hs, Subgroup.card_top] at h

/-- **Collapsing a supremum to its support.**  A supremum of subgroups indexed by an arbitrary type
equals the supremum over a finite subset carrying all the nontrivial members. -/
theorem iSup_eq_biSup_of_eq_bot {ι : Type*} (H : ι → Subgroup G) (s : Finset ι)
    (h : ∀ i, i ∉ s → H i = ⊥) : (⨆ i, H i) = ⨆ i ∈ s, H i := by
  refine le_antisymm (iSup_le fun i => ?_) (iSup_le fun i => iSup_le fun _ => le_iSup H i)
  by_cases hi : i ∈ s
  · exact le_trans (le_iSup (fun _ : i ∈ s => H i) hi) (le_iSup (fun j => ⨆ _ : j ∈ s, H j) i)
  · rw [h i hi]
    exact bot_le

end InverseGalois.CFT
