import Mathlib
import InverseGalois.CFT.Compositum
import InverseGalois.CFT.FrobeniusInvolution

/-!
# Automorphisms of a compositum that are trivial on one factor

Let `A` and `B` be two Galois subextensions of `L / F` and suppose that `A` is abelian over `F`.
An automorphism of the compositum `A ⊔ B` that restricts trivially to `B` is then central: its
commutator with any other automorphism restricts trivially to `A`, because the Galois group of `A`
is commutative, and trivially to `B`, because one of the two factors already does; and restriction
to the two subextensions is injective on the Galois group of the compositum.

Consequently the subgroup generated by such an automorphism is normal, which is exactly the
hypothesis under which an involution of a Galois number field is known here to be an arithmetic
Frobenius.  Combining the two gives a usable form of the Chebotarev step: for an involution of the
abelian factor there are infinitely many primes whose Frobenius in the compositum induces it on `A`
and the identity on `B`.

## Main results

* `InverseGalois.CFT.normal_of_le_center`: a subgroup contained in the centre is normal.
* `InverseGalois.CFT.mem_center_of_galRestrictProd_snd_eq_one`: an automorphism of `A ⊔ B` that is
  trivial on `B` is central when the Galois group of `A` is commutative.
* `InverseGalois.CFT.exists_prime_isArithFrobAt_sup`: such an automorphism, if its square is one,
  is the arithmetic Frobenius at a prime outside any prescribed finite set.
* `InverseGalois.CFT.exists_prime_isArithFrobAt_prod`: for `A ⊓ B = ⊥` the automorphism may be
  prescribed by an involution of the Galois group of `A` together with the identity on `B`.
-/

open NumberField InverseGalois.NumberTheory

set_option synthInstance.maxHeartbeats 400000

namespace InverseGalois.CFT

/-- A subgroup contained in the centre is normal. -/
theorem normal_of_le_center {G : Type*} [Group G] {H : Subgroup G}
    (h : H ≤ Subgroup.center G) : H.Normal :=
  ⟨fun n hn g => by
    have hc : g * n = n * g := Subgroup.mem_center_iff.mp (h hn) g
    simpa [hc, mul_assoc] using hn⟩

section Compositum

variable {F L : Type*} [Field F] [Field L] [Algebra F L] (A B : IntermediateField F L)
  [Normal F A] [Normal F B]

/-- If the Galois group of `A` over `F` is commutative, an automorphism of the compositum `A ⊔ B`
restricting trivially to `B` commutes with every automorphism of the compositum. -/
theorem commute_of_galRestrictProd_snd_eq_one (hcomm : ∀ x y : Gal(A/F), x * y = y * x)
    {σ : Gal(↥(A ⊔ B)/F)} (hσ : (galRestrictProd A B σ).2 = 1) (τ : Gal(↥(A ⊔ B)/F)) :
    Commute σ τ := by
  have key : galRestrictProd A B (σ * τ) = galRestrictProd A B (τ * σ) := by
    rw [map_mul, map_mul]
    refine Prod.ext ?_ ?_
    · simpa using hcomm (galRestrictProd A B σ).1 (galRestrictProd A B τ).1
    · simp [hσ]
  exact galRestrictProd_injective A B key

/-- If the Galois group of `A` over `F` is commutative, the automorphisms of the compositum
`A ⊔ B` restricting trivially to `B` are central. -/
theorem mem_center_of_galRestrictProd_snd_eq_one (hcomm : ∀ x y : Gal(A/F), x * y = y * x)
    {σ : Gal(↥(A ⊔ B)/F)} (hσ : (galRestrictProd A B σ).2 = 1) :
    σ ∈ Subgroup.center Gal(↥(A ⊔ B)/F) :=
  Subgroup.mem_center_iff.mpr fun g =>
    (commute_of_galRestrictProd_snd_eq_one A B hcomm hσ g).symm.eq

/-- The subgroup generated by an automorphism of `A ⊔ B` that is trivial on `B` is normal, when
the Galois group of `A` over `F` is commutative. -/
theorem normal_zpowers_of_galRestrictProd_snd_eq_one (hcomm : ∀ x y : Gal(A/F), x * y = y * x)
    {σ : Gal(↥(A ⊔ B)/F)} (hσ : (galRestrictProd A B σ).2 = 1) :
    (Subgroup.zpowers σ).Normal :=
  normal_of_le_center
    (Subgroup.zpowers_le.mpr (mem_center_of_galRestrictProd_snd_eq_one A B hcomm hσ))

end Compositum

section NumberField

variable {N : Type*} [Field N] [NumberField N] (A B : IntermediateField ℚ N) [IsGalois ℚ ↥A]
  [IsGalois ℚ ↥B]

/-- **An involution of a compositum that is trivial on one factor is a Frobenius.**  Let `A` and
`B` be Galois subextensions of a number field with `A` abelian over `ℚ`.  An automorphism of
`A ⊔ B` whose square is the identity and whose restriction to `B` is the identity is the
arithmetic Frobenius at a prime avoiding any prescribed finite set. -/
theorem exists_prime_isArithFrobAt_sup (hcomm : ∀ x y : Gal(↥A/ℚ), x * y = y * x)
    {σ : Gal(↥(A ⊔ B)/ℚ)} (hsnd : (galRestrictProd A B σ).2 = 1) (hσ2 : σ ^ 2 = 1)
    (T : Finset ℕ) :
    ∃ p : ℕ, p.Prime ∧ p ∉ T ∧ p ∉ ramifiedSet ↥(A ⊔ B) ∧ ∃ P : Ideal (𝓞 ↥(A ⊔ B)),
      P.IsPrime ∧ P.LiesOver (Ideal.span {(p : ℤ)}) ∧ IsArithFrobAt ℤ σ P :=
  exists_prime_isArithFrobAt_of_sq_eq_one
    (normal_zpowers_of_galRestrictProd_snd_eq_one A B hcomm hsnd) hσ2 T

set_option maxHeartbeats 1000000 in
/-- **Chebotarev for a prescribed abelian symbol.**  Let `A` and `B` be Galois subextensions of a
number field meeting in `ℚ`, with `A` abelian over `ℚ`, and let `a` be an involution of the Galois
group of `A`.  There are infinitely many primes whose arithmetic Frobenius in the compositum
restricts to `a` on `A` and to the identity on `B`. -/
theorem exists_prime_isArithFrobAt_prod (hcomm : ∀ x y : Gal(↥A/ℚ), x * y = y * x)
    (hinf : A ⊓ B = ⊥) {a : Gal(↥A/ℚ)} (ha : a ^ 2 = 1) (T : Finset ℕ) :
    ∃ p : ℕ, p.Prime ∧ p ∉ T ∧ p ∉ ramifiedSet ↥(A ⊔ B) ∧ ∃ P : Ideal (𝓞 ↥(A ⊔ B)),
      P.IsPrime ∧ P.LiesOver (Ideal.span {(p : ℤ)}) ∧
        IsArithFrobAt ℤ ((galEquivProd A B hinf).symm (a, 1)) P := by
  set σ := (galEquivProd A B hinf).symm (a, 1) with hσdef
  have hgr : galRestrictProd A B σ = (a, 1) := by
    rw [hσdef, ← galEquivProd_apply A B hinf, MulEquiv.apply_symm_apply]
  have hσ2 : σ ^ 2 = 1 := by
    refine galRestrictProd_injective A B ?_
    rw [map_pow, map_one, hgr]
    simp [Prod.ext_iff, ha]
  exact exists_prime_isArithFrobAt_sup A B hcomm (by rw [hgr]) hσ2 T

end NumberField

end InverseGalois.CFT
