import Mathlib
import InverseGalois.CFT.InertiaRestrict
import InverseGalois.CFT.UnramifiedCompositum
import InverseGalois.NumberTheory.SplitCompletely

/-!
# Decomposition groups in a compositum, and residue degrees

Let `N` be a Galois number field and let `A` and `B` be two normal subextensions whose compositum
is all of `N`.  Restricting an automorphism to a subextension carries the decomposition group of a
prime `P` of `𝓞 N` into the decomposition group of the prime below it, exactly as it carries
inertia into inertia.  If the rational prime below `P` splits completely in `B`, the decomposition
group of `B` is trivial, and an automorphism in the decomposition group of `P` restricting
trivially to `A` therefore restricts trivially to both factors and is the identity.  So the
decomposition group of `P` embeds into that of `P ∩ 𝓞 A`.

Comparing orders gives the bookkeeping needed to propagate the condition "the residue degree is
one at every ramified prime" along a compositum with a totally split factor: the order of a
decomposition group is the ramification index times the residue degree, and the ramification index
of a subextension divides the one upstairs, so the inequality `e f ≤ e' f' = e' ≤ e` forces the
residue degree upstairs to be one.

## Main results

* `InverseGalois.CFT.card_stabilizer_eq_mul`: the order of the decomposition group of a prime of a
  Galois number field is the ramification index times the residue degree.
* `InverseGalois.CFT.restrictNormal_mem_stabilizer`: restriction to a normal subextension maps the
  decomposition group of `P` into the decomposition group of the prime below `P`.
* `InverseGalois.CFT.stabilizer_eq_bot_of_splitsCompletely`: a prime splitting completely has
  trivial decomposition group.
* `InverseGalois.CFT.card_stabilizer_le_of_splitsCompletely`: with a totally split second factor,
  the decomposition group of the compositum is no larger than that of the first factor.
* `InverseGalois.CFT.inertiaDeg_eq_one_of_sup`: **residue degree one propagates to a compositum
  with a totally split factor.**
-/

open NumberField InverseGalois.NumberTheory Pointwise

set_option synthInstance.maxHeartbeats 400000

namespace InverseGalois.CFT

/-! ### The order of a decomposition group -/

/-- The residue field extension at a prime with finite residue fields is separable. -/
private theorem isSeparable_residue {R S : Type*} [CommRing R] [CommRing S] [Algebra R S]
    (p : Ideal R) (P : Ideal S) [p.IsMaximal] [P.IsMaximal] [P.LiesOver p] [Finite (R ⧸ p)]
    [Finite (S ⧸ P)] : Algebra.IsSeparable (R ⧸ p) (S ⧸ P) := by
  letI : Field (R ⧸ p) := Ideal.Quotient.field _
  letI : Field (S ⧸ P) := Ideal.Quotient.field _
  haveI : PerfectField (R ⧸ p) := PerfectField.ofFinite
  haveI : Algebra.IsAlgebraic (R ⧸ p) (S ⧸ P) := Algebra.IsAlgebraic.of_finite _ _
  exact Algebra.IsAlgebraic.isSeparable_of_perfectField

/-- The extension of a nonzero ideal along an injective map is nonzero. -/
private theorem map_ne_bot {R S : Type*} [CommRing R] [CommRing S] [Algebra R S]
    (h : Function.Injective (algebraMap R S)) {I : Ideal R} (hI : I ≠ ⊥) :
    I.map (algebraMap R S) ≠ ⊥ := by
  obtain ⟨x, hxI, hx⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hI
  intro hmap
  refine hx (h ?_)
  have hmem : algebraMap R S x ∈ I.map (algebraMap R S) := Ideal.mem_map_of_mem _ hxI
  rw [hmap, Ideal.mem_bot] at hmem
  rw [hmem, map_zero]

/-- The ideal generated by a rational prime is maximal in `ℤ`. -/
theorem isMaximal_span_prime {p : ℕ} (hp : p.Prime) :
    (Ideal.span {(p : ℤ)}).IsMaximal := by
  have hspan : Ideal.span {(p : ℤ)} ≠ ⊥ := by
    simpa [Ideal.span_singleton_eq_bot] using hp.ne_zero
  haveI : (Ideal.span {(p : ℤ)}).IsPrime := by
    rw [Ideal.span_singleton_prime (by exact_mod_cast hp.ne_zero)]
    exact Nat.prime_iff_prime_int.mp hp
  exact Ideal.IsPrime.isMaximal inferInstance hspan

/-- **The order of the decomposition group** of a prime `P` of a Galois number field is the
ramification index of `P` times its residue degree. -/
theorem card_stabilizer_eq_mul (K : Type*) [Field K] [NumberField K] [IsGalois ℚ K] {p : ℕ}
    (hp : p.Prime) (P : Ideal (𝓞 K)) [P.IsPrime] [hover : P.LiesOver (Ideal.span {(p : ℤ)})] :
    Nat.card (MulAction.stabilizer Gal(K/ℚ) P) =
      Ideal.ramificationIdx (algebraMap ℤ (𝓞 K)) (Ideal.span {(p : ℤ)}) P *
        (Ideal.span {(p : ℤ)}).inertiaDeg P := by
  have hspan : Ideal.span {(p : ℤ)} ≠ ⊥ := by
    simpa [Ideal.span_singleton_eq_bot] using hp.ne_zero
  haveI := isMaximal_span_prime hp
  have hP0 : P ≠ ⊥ := ne_bot_of_liesOver_natCast hp hover
  haveI : P.IsMaximal := Ring.DimensionLEOne.maximalOfPrime hP0 inferInstance
  haveI : Finite (ℤ ⧸ Ideal.span {(p : ℤ)}) := Ideal.finiteQuotientOfFreeOfNeBot _ hspan
  haveI : Finite (𝓞 K ⧸ P) := Ideal.finiteQuotientOfFreeOfNeBot _ hP0
  haveI := isSeparable_residue (Ideal.span {(p : ℤ)}) P
  rw [Ideal.card_stabilizer_eq (G := Gal(K/ℚ)) _ hspan P,
    Ideal.ramificationIdxIn_eq_ramificationIdx _ P Gal(K/ℚ),
    Ideal.inertiaDegIn_eq_inertiaDeg _ P Gal(K/ℚ)]

/-! ### Restriction of decomposition groups -/

variable {N : Type*} [Field N] [NumberField N]

/-- **Restriction sends decomposition into decomposition.**  If `σ` stabilises a prime `P` of
`𝓞 N`, then its restriction to a normal subextension `A` stabilises the prime of `𝓞 A` lying
under `P`. -/
theorem restrictNormal_mem_stabilizer (A : IntermediateField ℚ N) [Normal ℚ ↥A]
    (P : Ideal (𝓞 N)) {σ : Gal(N/ℚ)} (hσ : σ ∈ MulAction.stabilizer Gal(N/ℚ) P) :
    σ.restrictNormal ↥A ∈ MulAction.stabilizer Gal(↥A/ℚ) (P.under (𝓞 ↥A)) := by
  rw [MulAction.mem_stabilizer_iff] at hσ ⊢
  have hinv : (σ.restrictNormal ↥A)⁻¹ = (σ⁻¹).restrictNormal ↥A :=
    (map_inv (AlgEquiv.restrictNormalHom ↥A : Gal(N/ℚ) →* Gal(↥A/ℚ)) σ).symm
  refine SetLike.ext fun x => ?_
  rw [Ideal.mem_pointwise_smul_iff_inv_smul_mem, hinv]
  show algebraMap (𝓞 ↥A) (𝓞 N) ((σ⁻¹).restrictNormal ↥A • x) ∈ P ↔
    algebraMap (𝓞 ↥A) (𝓞 N) x ∈ P
  rw [algebraMap_smul_restrictNormal A σ⁻¹ x, ← Ideal.mem_pointwise_smul_iff_inv_smul_mem, hσ]

/-- The restriction homomorphism from the decomposition group of `P` to the decomposition group of
the prime below `P` in a normal subextension. -/
noncomputable def stabilizerRestrict (A : IntermediateField ℚ N) [Normal ℚ ↥A]
    (P : Ideal (𝓞 N)) :
    MulAction.stabilizer Gal(N/ℚ) P →* MulAction.stabilizer Gal(↥A/ℚ) (P.under (𝓞 ↥A)) where
  toFun σ := ⟨(σ : Gal(N/ℚ)).restrictNormal ↥A, restrictNormal_mem_stabilizer A P σ.2⟩
  map_one' :=
    Subtype.ext (map_one (AlgEquiv.restrictNormalHom ↥A : Gal(N/ℚ) →* Gal(↥A/ℚ)))
  map_mul' _ _ :=
    Subtype.ext (map_mul (AlgEquiv.restrictNormalHom ↥A : Gal(N/ℚ) →* Gal(↥A/ℚ)) _ _)

/-- **Restriction to one factor of a compositum is injective on decomposition groups**, provided
the decomposition group of the other factor is trivial. -/
theorem stabilizerRestrict_injective (A B : IntermediateField ℚ N) [Normal ℚ ↥A] [Normal ℚ ↥B]
    (hAB : A ⊔ B = ⊤) (P : Ideal (𝓞 N))
    (hB : MulAction.stabilizer Gal(↥B/ℚ) (P.under (𝓞 ↥B)) = ⊥) :
    Function.Injective (stabilizerRestrict A P) := by
  rw [injective_iff_map_eq_one]
  intro σ hσ
  have hA : (σ : Gal(N/ℚ)).restrictNormal ↥A = 1 := congrArg Subtype.val hσ
  have hmem : (σ : Gal(N/ℚ)).restrictNormal ↥B ∈
      MulAction.stabilizer Gal(↥B/ℚ) (P.under (𝓞 ↥B)) :=
    restrictNormal_mem_stabilizer B P σ.2
  rw [hB, Subgroup.mem_bot] at hmem
  exact Subtype.ext (eq_one_of_restrictNormal_eq_one hAB hA hmem)

/-! ### Totally split factors -/

/-- **A prime that splits completely has trivial decomposition group.** -/
theorem stabilizer_eq_bot_of_splitsCompletely (K : Type*) [Field K] [NumberField K] [IsGalois ℚ K]
    {p : ℕ} (hp : p.Prime) (P : Ideal (𝓞 K)) [P.IsPrime]
    [hover : P.LiesOver (Ideal.span {(p : ℤ)})] (h : SplitsCompletely K p) :
    MulAction.stabilizer Gal(K/ℚ) P = ⊥ := by
  obtain ⟨he, hf⟩ := h P ⟨inferInstance, hover⟩
  have hcard : Nat.card (MulAction.stabilizer Gal(K/ℚ) P) = 1 := by
    rw [card_stabilizer_eq_mul K hp P, he, hf]
  exact Subgroup.eq_bot_of_card_eq _ hcard

/-- **The decomposition group of a compositum with a totally split factor** is no larger than the
decomposition group of the other factor. -/
theorem card_stabilizer_le_of_splitsCompletely (A B : IntermediateField ℚ N) [Normal ℚ ↥A]
    [Normal ℚ ↥B] (hAB : A ⊔ B = ⊤) {p : ℕ} (hp : p.Prime) (P : Ideal (𝓞 N)) [P.IsPrime]
    [hover : P.LiesOver (Ideal.span {(p : ℤ)})] (hB : SplitsCompletely ↥B p) :
    Nat.card (MulAction.stabilizer Gal(N/ℚ) P) ≤
      Nat.card (MulAction.stabilizer Gal(↥A/ℚ) (P.under (𝓞 ↥A))) := by
  haveI : NumberField ↥B := ⟨⟩
  haveI : IsGalois ℚ ↥B := ⟨⟩
  haveI : (P.under (𝓞 ↥B)).LiesOver (Ideal.span {(p : ℤ)}) := by
    refine ⟨?_⟩
    rw [Ideal.under_under]
    exact hover.over
  exact Nat.card_le_card_of_injective _
    (stabilizerRestrict_injective A B hAB P
      (stabilizer_eq_bot_of_splitsCompletely ↥B hp _ hB))

/-! ### Residue degree in a compositum -/

/-- **Residue degree one propagates to a compositum with a totally split factor.**  If `A` and `B`
generate `N`, if the rational prime `p` splits completely in `B`, and if the prime of `𝓞 A` below
`P` has residue degree one, then so does `P`. -/
theorem inertiaDeg_eq_one_of_sup [IsGalois ℚ N] (A B : IntermediateField ℚ N) [Normal ℚ ↥A]
    [Normal ℚ ↥B] (hAB : A ⊔ B = ⊤) {p : ℕ} (hp : p.Prime) (P : Ideal (𝓞 N)) [P.IsPrime]
    [hover : P.LiesOver (Ideal.span {(p : ℤ)})] (hB : SplitsCompletely ↥B p)
    (hA : (Ideal.span {(p : ℤ)}).inertiaDeg (P.under (𝓞 ↥A)) = 1) :
    (Ideal.span {(p : ℤ)}).inertiaDeg P = 1 := by
  haveI : NumberField ↥A := ⟨⟩
  haveI : IsGalois ℚ ↥A := ⟨⟩
  haveI : (P.under (𝓞 ↥A)).LiesOver (Ideal.span {(p : ℤ)}) := by
    refine ⟨?_⟩
    rw [Ideal.under_under]
    exact hover.over
  have hP0 : P ≠ ⊥ := ne_bot_of_liesOver_natCast hp hover
  haveI : P.IsMaximal := Ring.DimensionLEOne.maximalOfPrime hP0 inferInstance
  set e := Ideal.ramificationIdx (algebraMap ℤ (𝓞 N)) (Ideal.span {(p : ℤ)}) P with he
  set f := (Ideal.span {(p : ℤ)}).inertiaDeg P with hf
  set e' := Ideal.ramificationIdx (algebraMap ℤ (𝓞 ↥A)) (Ideal.span {(p : ℤ)})
    (P.under (𝓞 ↥A)) with he'
  -- the decomposition group upstairs is no larger than the one over `A`
  have hle : e * f ≤ e' := by
    have h1 := card_stabilizer_le_of_splitsCompletely A B hAB hp P hB
    rwa [card_stabilizer_eq_mul N hp P, card_stabilizer_eq_mul ↥A hp _, hA, mul_one] at h1
  -- the ramification index over `A` divides the one upstairs
  have hspan : Ideal.span {(p : ℤ)} ≠ ⊥ := by
    simpa [Ideal.span_singleton_eq_bot] using hp.ne_zero
  have hune : P.under (𝓞 ↥A) ≠ ⊥ :=
    ne_bot_of_liesOver_natCast hp (P := P.under (𝓞 ↥A)) inferInstance
  have hdvd : e' ∣ e := by
    have hmap := map_ne_bot (FaithfulSMul.algebraMap_injective (𝓞 ↥A) (𝓞 N)) hune
    have hfg := map_ne_bot (FaithfulSMul.algebraMap_injective ℤ (𝓞 N)) hspan
    have hle' : (P.under (𝓞 ↥A)).map (algebraMap (𝓞 ↥A) (𝓞 N)) ≤ P :=
      Ideal.map_le_iff_le_comap.mpr le_rfl
    exact ⟨_, Ideal.ramificationIdx_algebra_tower (R := ℤ) (S := 𝓞 ↥A) (T := 𝓞 N) hmap hfg hle'⟩
  -- decomposition groups are nonempty, so both factors are positive
  have hpos : 0 < e * f := by
    rw [← card_stabilizer_eq_mul N hp P]
    exact Nat.card_pos
  have hepos : 0 < e := Nat.pos_of_ne_zero fun h => by simp [h] at hpos
  have hfpos : 0 < f := Nat.pos_of_ne_zero fun h => by simp [h] at hpos
  have hlee : e' ≤ e := Nat.le_of_dvd hepos hdvd
  have hfle : f ≤ 1 := by
    refine Nat.le_of_mul_le_mul_left ?_ hepos
    calc e * f ≤ e' := hle
      _ ≤ e := hlee
      _ = e * 1 := (mul_one e).symm
  omega

end InverseGalois.CFT
