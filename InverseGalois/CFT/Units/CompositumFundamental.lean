import Mathlib
import InverseGalois.CFT.GroupCohomology.DisjointFundamental
import InverseGalois.CFT.Units.IdeleClassH1Full
import InverseGalois.CFT.Units.IdeleClassH2Full
import InverseGalois.CFT.Units.IdeleClassH2Tower
import InverseGalois.CFT.Units.IdeleQuotCyclic

/-!
# A class of the right order from an auxiliary extension

Two Galois extensions of a number field of the same degree meet in the base field and together
generate a common extension.  The automorphisms fixing one of them pointwise then form a complement
to the automorphisms fixing the other, and the idele class group of each of the two is the part of
the idele class group of the compositum fixed by the corresponding subgroup.

If the second of the two is cyclic and carries an idele of the base field generating the quotient
by the principal ideles and the norms, then the zeroth Tate group of the invariants of the first is
generated by a class of order the degree.  When that idele is moreover a norm from the first
extension, the norm of the second subgroup is surjective on Tate groups, and the counting argument
turns the class of the second extension into a class of the same order for the first.

That is the mechanism which produces the fundamental class of an arbitrary Galois extension out of
the fundamental class of a cyclic one: only the cyclic case supports the direct computation, and
the compositum transports the outcome.

## Main definitions

* `InverseGalois.CFT.ideleClassDevissage`: the idele class group of an intermediate field,
  identified with the invariants of the group of automorphisms fixing that field pointwise.

## Main results

* `InverseGalois.CFT.exists_zsmul_eq_zero_imp_dvd_H2_ideleClassRep_of_compositum`: **a class of the
  second cohomology of the idele class group of one of two disjoint extensions whose compositum
  they generate, annihilated by exactly the multiples of the common degree.**

## Tags

number field, idele class group, fundamental class, compositum, Tate cohomology
-/

set_option synthInstance.maxHeartbeats 800000
set_option maxHeartbeats 4000000

open CategoryTheory groupCohomology IsDedekindDomain NumberField

namespace InverseGalois.CFT

noncomputable section

section Compositum

variable {k K L M : Type} [Field k] [NumberField k] [Field K] [NumberField K]
  [Field L] [NumberField L] [Field M] [NumberField M]
  [Algebra k K] [Algebra k L] [Algebra k M] [Algebra K M] [Algebra L M]
  [IsScalarTower k K M] [IsScalarTower k L M]
  [IsGalois k K] [IsGalois k L] [IsGalois k M] [IsGalois K M] [IsGalois L M]

variable (k L M) in
/-- The idele class group of an intermediate field, identified with the invariants of the group of
automorphisms fixing that field pointwise. -/
def ideleClassDevissage :
    IdeleClass L ≃+ ↥((ideleClassRep k M).quotientToInvariants
      (AlgEquiv.restrictNormalHom L : Gal(M/k) →* Gal(L/k)).ker) :=
  devissageEquiv (A := ideleClassRep k M) (B := ideleClassRep k L)
    (AlgEquiv.restrictNormalHom L : Gal(M/k) →* Gal(L/k)) (ideleClassComapLin L M)
    (fun _ _ h => ideleClassComap_injective L M h)
    (fun g b => (ideleClassAut_ideleClassComap L g b).symm)
    (fun a ha => (mem_range_ideleClassComap_iff L M a).mpr
      fun σ => ha (σ.restrictScalars k) (restrictNormalHom_restrictScalars k L σ))

variable (k L M) in
omit [NumberField k] [IsGalois k M] in
@[simp]
theorem coe_ideleClassDevissage (x : IdeleClass L) :
    ((ideleClassDevissage k L M x : ↥((ideleClassRep k M).quotientToInvariants
      (AlgEquiv.restrictNormalHom L : Gal(M/k) →* Gal(L/k)).ker)) : ↥(ideleClassRep k M).V)
      = ideleClassComap L M x := rfl

variable (k L M) in
omit [NumberField k] in
/-- The identification of the idele class group of an intermediate field with the invariants
carries the induced action of a coset to the action of the restricted automorphism. -/
theorem ideleClassDevissage_symm_rho (γ : Gal(M/k))
    (x : ↥((ideleClassRep k M).quotientToInvariants
      (AlgEquiv.restrictNormalHom L : Gal(M/k) →* Gal(L/k)).ker)) :
    (ideleClassDevissage k L M).symm
        (((ideleClassRep k M).quotientToInvariants
          (AlgEquiv.restrictNormalHom L : Gal(M/k) →* Gal(L/k)).ker).ρ
            (QuotientGroup.mk γ) x)
      = ideleClassAut (k := k) ((AlgEquiv.restrictNormalHom L : Gal(M/k) →* Gal(L/k)) γ)
          ((ideleClassDevissage k L M).symm x) :=
  devissage_intertwines (A := ideleClassRep k M) (B := ideleClassRep k L)
    (AlgEquiv.restrictNormalHom L : Gal(M/k) →* Gal(L/k))
    (ideleClassComapLin L M)
    (fun _ _ h => ideleClassComap_injective L M h)
    (fun g b => (ideleClassAut_ideleClassComap L g b).symm)
    (fun a ha => (mem_range_ideleClassComap_iff L M a).mpr
      fun σ => ha (σ.restrictScalars k) (restrictNormalHom_restrictScalars k L σ))
    (AlgEquiv.restrictNormalHom_surjective (F := k) (K₁ := L) (E := M)) (QuotientGroup.mk γ) x

variable (k K L M) in
/-- **A class of the second cohomology of the idele class group of one of two disjoint extensions
whose compositum they generate, annihilated by exactly the multiples of the common degree.** -/
theorem exists_zsmul_eq_zero_imp_dvd_H2_ideleClassRep_of_compositum
    (hdisj : (AlgEquiv.restrictNormalHom L : Gal(M/k) →* Gal(L/k)).ker
        ⊓ (AlgEquiv.restrictNormalHom K : Gal(M/k) →* Gal(K/k)).ker = ⊥)
    (hsup : (AlgEquiv.restrictNormalHom L : Gal(M/k) →* Gal(L/k)).ker
        ⊔ (AlgEquiv.restrictNormalHom K : Gal(M/k) →* Gal(K/k)).ker = ⊤)
    {n : ℕ} (hnK : Nat.card Gal(K/k) = n) (hnL : Nat.card Gal(L/k) = n)
    {σL : Gal(L/k)} (hgenσ : ∀ g : Gal(L/k), g ∈ Subgroup.zpowers σL) (d : ↥(idele k))
    (hgend : ∀ z : ↥(idele k) ⧸ ((ideleDiag k).range ⊔ (ideleNorm k L).range),
      z ∈ AddSubmonoid.multiples (QuotientAddGroup.mk d))
    (hordd : addOrderOf (QuotientAddGroup.mk d :
      ↥(idele k) ⧸ ((ideleDiag k).range ⊔ (ideleNorm k L).range)) = n)
    (hdnorm : d ∈ (ideleNorm k K).range) :
    ∃ α : ↥(H2 (ideleClassRep k K)), ∀ m : ℤ, m • α = 0 → (n : ℤ) ∣ m := by
  letI : Fintype ↥(AlgEquiv.restrictNormalHom L : Gal(M/k) →* Gal(L/k)).ker :=
    Fintype.ofFinite _
  letI : Fintype ↥(AlgEquiv.restrictNormalHom K : Gal(M/k) →* Gal(K/k)).ker :=
    Fintype.ofFinite _
  have hπK : Function.Surjective (AlgEquiv.restrictNormalHom K : Gal(M/k) →* Gal(K/k)) :=
    AlgEquiv.restrictNormalHom_surjective (F := k) (K₁ := K) (E := M)
  have hπL : Function.Surjective (AlgEquiv.restrictNormalHom L : Gal(M/k) →* Gal(L/k)) :=
    AlgEquiv.restrictNormalHom_surjective (F := k) (K₁ := L) (E := M)
  have hbijS := bijective_mk'_comp_subtype
    (H := (AlgEquiv.restrictNormalHom L : Gal(M/k) →* Gal(L/k)).ker)
    (S := (AlgEquiv.restrictNormalHom K : Gal(M/k) →* Gal(K/k)).ker) hdisj hsup
  have hbijH := bijective_mk'_comp_subtype
    (H := (AlgEquiv.restrictNormalHom K : Gal(M/k) →* Gal(K/k)).ker)
    (S := (AlgEquiv.restrictNormalHom L : Gal(M/k) →* Gal(L/k)).ker)
    (by rw [inf_comm]; exact hdisj) (by rw [sup_comm]; exact hsup)
  -- the two subgroups have the common degree as order
  have hnS : Nat.card ↥(AlgEquiv.restrictNormalHom K : Gal(M/k) →* Gal(K/k)).ker = n := by
    rw [Nat.card_congr (Equiv.ofBijective _ hbijS), ← hnL]
    exact Nat.card_congr (QuotientGroup.quotientKerEquivOfSurjective _ hπL).toEquiv
  have hnH : Nat.card ↥(AlgEquiv.restrictNormalHom L : Gal(M/k) →* Gal(L/k)).ker = n := by
    rw [Nat.card_congr (Equiv.ofBijective _ hbijH), ← hnK]
    exact Nat.card_congr (QuotientGroup.quotientKerEquivOfSurjective _ hπK).toEquiv
  -- a generator of the second subgroup lying over the given generator
  obtain ⟨s₀, hs₀, hs₀L⟩ :
      ∃ s₀ : ↥(AlgEquiv.restrictNormalHom K : Gal(M/k) →* Gal(K/k)).ker,
        (∀ x : ↥(AlgEquiv.restrictNormalHom K : Gal(M/k) →* Gal(K/k)).ker,
          x ∈ Subgroup.zpowers s₀) ∧
        (AlgEquiv.restrictNormalHom L : Gal(M/k) →* Gal(L/k)) (s₀ : Gal(M/k)) = σL := by
    set eS := (MulEquiv.ofBijective _ hbijS).trans
      (QuotientGroup.quotientKerEquivOfSurjective
        (AlgEquiv.restrictNormalHom L : Gal(M/k) →* Gal(L/k)) hπL) with heSdef
    have heS : ∀ s : ↥(AlgEquiv.restrictNormalHom K : Gal(M/k) →* Gal(K/k)).ker,
        eS s = (AlgEquiv.restrictNormalHom L : Gal(M/k) →* Gal(L/k)) (s : Gal(M/k)) :=
      fun _ => rfl
    refine ⟨eS.symm σL, fun x => ?_, ?_⟩
    · obtain ⟨j, hj⟩ := Subgroup.mem_zpowers_iff.1 (hgenσ (eS x))
      refine Subgroup.mem_zpowers_iff.2 ⟨j, eS.injective ?_⟩
      rw [map_zpow, eS.apply_symm_apply, hj]
    · rw [← heS, eS.apply_symm_apply]
  have hs₀K : (AlgEquiv.restrictNormalHom K : Gal(M/k) →* Gal(K/k)) (s₀ : Gal(M/k)) = 1 := s₀.2
  -- the two automorphisms
  set σS := rhoAddEquiv (ideleClassRep k M) (s₀ : Gal(M/k)) with hσSdef
  set σH := rhoAddEquiv ((ideleClassRep k M).quotientToInvariants
    (AlgEquiv.restrictNormalHom L : Gal(M/k) →* Gal(L/k)).ker)
    (QuotientGroup.mk (s₀ : Gal(M/k))) with hσHdef
  have hσS : ∀ x, σS x = (ideleClassRep k M).ρ (s₀ : Gal(M/k)) x := fun _ => rfl
  have hσH : ∀ x, σH x = ((ideleClassRep k M).quotientToInvariants
      (AlgEquiv.restrictNormalHom L : Gal(M/k) →* Gal(L/k)).ker).ρ
      (QuotientGroup.mk (s₀ : Gal(M/k))) x := fun _ => rfl
  -- the class of the given idele upstairs
  set aH := ideleClassDevissage k L M (QuotientAddGroup.mk (ideleComap k L d)) with haHdef
  have hψ : ∀ x, (ideleClassDevissage k L M).symm (σH x)
      = ideleClassAut (k := k) σL ((ideleClassDevissage k L M).symm x) := by
    intro x
    rw [hσH, ← hs₀L]
    exact ideleClassDevissage_symm_rho k L M (s₀ : Gal(M/k)) x
  have haH : σH aH = aH := by
    refine (ideleClassDevissage k L M).symm.injective ?_
    rw [hψ, haHdef, AddEquiv.symm_apply_apply, ideleClassAut_mk, ideleAut_ideleComap]
  -- the identification of the class with the class of the idele downstairs
  have hTC : tateH0Congr (σA := σH) (σB := ideleClassAut (k := k) σL)
      (ideleClassDevissage k L M).symm hψ n (tateH0.mk σH n aH haH)
      = toTateH0 (K := L) σL n d := by
    rw [tateH0Congr_mk, toTateH0_apply]
    exact tateH0.mk_congr n _ _ ((ideleClassDevissage k L M).symm_apply_apply _)
  -- the finiteness and the bound for the Tate group of the first subgroup
  have hcard := card_H2_eq_card_tateH0
    (A := ideleClassRepRes k M (AlgEquiv.restrictNormalHom K : Gal(M/k) →* Gal(K/k)).ker)
    (g := s₀) (σ := σS) hs₀ (fun _ => rfl)
  obtain ⟨hfin2, hle2⟩ := finite_and_card_H2_res_subgroup
    (k := k) (K := M) (AlgEquiv.restrictNormalHom K : Gal(M/k) →* Gal(K/k)).ker
  haveI := hfin2
  haveI : Finite (tateH0 σS n) := by
    rw [← hnS]
    exact Finite.of_equiv _ (tateH0AddEquivH2
      (A := ideleClassRepRes k M (AlgEquiv.restrictNormalHom K : Gal(M/k) →* Gal(K/k)).ker)
      (g := s₀) (σ := σS) hs₀ (fun _ => rfl)).toEquiv.symm
  have hle : Nat.card (tateH0 σS n) ≤ n := by
    have h1 : Nat.card (tateH0 σS n)
        = Nat.card ↥(H2 (ideleClassRepRes k M
            (AlgEquiv.restrictNormalHom K : Gal(M/k) →* Gal(K/k)).ker)) := by
      rw [← hnS]
      exact hcard.symm
    rw [h1, ← hnS]
    exact hle2
  -- the generation of the Tate group
  have hgenH : ∀ z : tateH0 σH n, z ∈ AddSubmonoid.multiples (tateH0.mk σH n aH haH) := by
    intro z
    have h1 : ∀ w : tateH0 (ideleClassAut (k := k) σL) n,
        w ∈ AddSubmonoid.multiples (toTateH0 (K := L) σL n d) := by
      intro w
      rw [← ideleQuotEquivTateH0_mk (K := L) hgenσ hnL d]
      exact forall_mem_multiples_of_addEquiv (ideleQuotEquivTateH0 hgenσ hnL) hgend w
    have h2 := forall_mem_multiples_of_addEquiv
      (tateH0Congr (σA := σH) (σB := ideleClassAut (k := k) σL)
        (ideleClassDevissage k L M).symm hψ n).symm h1 z
    rwa [← hTC, AddEquiv.symm_apply_apply] at h2
  -- the order of the class
  have hordH : addOrderOf (tateH0.mk σH n aH haH) = n := by
    have e1 : addOrderOf (tateH0Congr (σA := σH) (σB := ideleClassAut (k := k) σL)
          (ideleClassDevissage k L M).symm hψ n (tateH0.mk σH n aH haH))
        = addOrderOf (tateH0.mk σH n aH haH) :=
      AddEquiv.addOrderOf_eq _ _
    have e2 : addOrderOf (ideleQuotEquivTateH0 (K := L) hgenσ hnL (QuotientAddGroup.mk d))
        = addOrderOf (QuotientAddGroup.mk d :
          ↥(idele k) ⧸ ((ideleDiag k).range ⊔ (ideleNorm k L).range)) :=
      AddEquiv.addOrderOf_eq _ _
    rw [← e1, hTC, ← ideleQuotEquivTateH0_mk (K := L) hgenσ hnL d, e2]
    exact hordd
  have hord : ∀ m : ℤ, m • tateH0.mk σH n aH haH = 0 → (n : ℤ) ∣ m :=
    fun m hm => hordH ▸ addOrderOf_dvd_iff_zsmul_eq_zero.mpr hm
  -- the norm of the first subgroup is surjective on Tate groups
  have hnorm : Function.Surjective (tateH0.map n
      (subgroupNorm (ideleClassRep k M)
        (AlgEquiv.restrictNormalHom L : Gal(M/k) →* Gal(L/k)).ker)
      (subgroupNorm_comm hσS hσH)) := by
    refine surjective_of_mem_range_of_forall_mem_multiples ?_ hgenH
    obtain ⟨y, hy⟩ := hdnorm
    have hafix : σS (ideleClassComap K M (QuotientAddGroup.mk y))
        = ideleClassComap K M (QuotientAddGroup.mk y) := by
      rw [hσS]
      have hstep : (ideleClassRep k M).ρ (s₀ : Gal(M/k))
            (ideleClassComap K M (QuotientAddGroup.mk y))
          = ideleClassComap K M ((ideleClassRep k K).ρ
              ((AlgEquiv.restrictNormalHom K : Gal(M/k) →* Gal(K/k)) (s₀ : Gal(M/k)))
              (QuotientAddGroup.mk y)) :=
        ideleClassAut_ideleClassComap K (s₀ : Gal(M/k)) _
      rw [hstep, hs₀K, map_one, Module.End.one_apply]
    refine ⟨tateH0.mk σS n _ hafix, ?_⟩
    rw [tateH0.map_mk]
    refine tateH0.mk_congr n _ _ (Subtype.ext ?_)
    have hkey : ∑ h : ↥(AlgEquiv.restrictNormalHom L : Gal(M/k) →* Gal(L/k)).ker,
          ideleClassAut (k := k) (h : Gal(M/k))
            (ideleClassComap K M (QuotientAddGroup.mk y))
        = ideleClassComap L M (QuotientAddGroup.mk (ideleComap k L d)) := by
      have h1 : ∑ h : ↥(AlgEquiv.restrictNormalHom L : Gal(M/k) →* Gal(L/k)).ker,
            ideleClassAut (k := k) (h : Gal(M/k))
              (ideleClassComap K M (QuotientAddGroup.mk y))
          = ∑ h : ↥(AlgEquiv.restrictNormalHom L : Gal(M/k) →* Gal(L/k)).ker,
              ideleClassComap K M (ideleClassAut (k := k)
                ((AlgEquiv.restrictNormalHom K : Gal(M/k) →* Gal(K/k)) (h : Gal(M/k)))
                (QuotientAddGroup.mk y)) :=
        Finset.sum_congr rfl fun h _ => ideleClassAut_ideleClassComap K (h : Gal(M/k)) _
      have h2 : ∑ h : ↥(AlgEquiv.restrictNormalHom L : Gal(M/k) →* Gal(L/k)).ker,
            ideleClassAut (k := k)
              ((AlgEquiv.restrictNormalHom K : Gal(M/k) →* Gal(K/k)) (h : Gal(M/k)))
              (QuotientAddGroup.mk y)
          = ∑ g : Gal(K/k), ideleClassAut (k := k) g (QuotientAddGroup.mk y) :=
        Fintype.sum_equiv ((Equiv.ofBijective _ hbijH).trans
          (QuotientGroup.quotientKerEquivOfSurjective _ hπK).toEquiv) _ _ fun _ => rfl
      have h3 : ∑ g : Gal(K/k), ideleClassAut (k := k) g (QuotientAddGroup.mk y)
          = QuotientAddGroup.mk (ideleComap k K d) := by
        have h3a : ∑ g : Gal(K/k), ideleClassAut (k := k) g (QuotientAddGroup.mk y)
            = ∑ g : Gal(K/k), (QuotientAddGroup.mk' ((ideleDiag K).range))
                (ideleAut (k := k) g y) :=
          Finset.sum_congr rfl fun g _ => ideleClassAut_mk g y
        rw [h3a, ← map_sum, ← galSum_apply, ← ideleComap_ideleNorm k K y, hy]
        rfl
      rw [h1, ← map_sum, h2, h3, ideleClassComap_mk, ideleComap_trans k K M d,
        ideleClassComap_mk, ideleComap_trans k L M d]
    rw [coe_subgroupNorm, coe_ideleClassDevissage]
    exact hkey
  -- assemble
  refine exists_zsmul_eq_zero_imp_dvd_H2_ideleClassRep_of_tower k K M ?_
  exact exists_zsmul_eq_zero_imp_dvd_H2_quotientToInvariants (A := ideleClassRep k M)
    (H := (AlgEquiv.restrictNormalHom L : Gal(M/k) →* Gal(L/k)).ker)
    (S := (AlgEquiv.restrictNormalHom K : Gal(M/k) →* Gal(K/k)).ker)
    hdisj hsup hnH hnS hs₀ hσS hσH
    (fun z => eq_zero_H1_res_subgroup _ (fun y => eq_zero_H1_ideleClassRep_general y) z)
    (fun z => eq_zero_H1_res_subgroup _ (fun y => eq_zero_H1_ideleClassRep_general y) z)
    hle hnorm haH hord

end Compositum

end

end InverseGalois.CFT
