import Mathlib
import InverseGalois.CFT.Brauer.LocalReciprocityAll
import InverseGalois.CFT.Units.DecompositionInvariant

/-!
# The fundamental class of a decomposition group at a finite place

The invariant of a class of the decomposition group at a finite place is injective and killed by
the degree of the extension of the completions.  Local reciprocity says the relative Brauer group
of that extension has exactly as many elements as the degree, and the crossed product construction
identifies it with the complete cohomology in degree two of the decomposition group, so **the
invariant is a bijection onto the rationals modulo the integers killed by the degree**.

In particular the reciprocal of the degree is the invariant of exactly one class.  That class is
**the fundamental class of the decomposition group**: its order is the degree, which is the order
of the whole group, so **the complete cohomology in degree two of a decomposition group at a finite
place is cyclic, generated by the fundamental class**.  Everything about the local theory at that
place is thereby reduced to a single canonical element, which is what a comparison with a global
class needs.

## Main definitions

* `InverseGalois.CFT.reciprocalQModZ`: the reciprocal of a natural number, in the rationals modulo
  the integers written multiplicatively.
* `InverseGalois.CFT.decompositionBrauerEquiv`: the complete cohomology in degree two of a
  decomposition group at a finite place, as the relative Brauer group of the completions.
* `InverseGalois.CFT.localFundamentalClass`: **the fundamental class of a decomposition group at a
  finite place**, the class whose invariant is the reciprocal of the local degree.

## Main results

* `InverseGalois.CFT.natCard_tateModule_decompositionUnits`: **the complete cohomology in degree
  two of a decomposition group at a finite place has as many elements as the local degree.**
* `InverseGalois.CFT.exists_decompositionInvariant_eq`: **every rational modulo the integers killed
  by the local degree is the invariant of a class of the decomposition group.**
* `InverseGalois.CFT.existsUnique_decompositionInvariant_eq_reciprocal`: **exactly one class of the
  decomposition group has the reciprocal of the local degree as its invariant.**
* `InverseGalois.CFT.orderOf_localFundamentalClass`: the fundamental class has order the local
  degree.
* `InverseGalois.CFT.zpowers_localFundamentalClass_eq_top`,
  `InverseGalois.CFT.isCyclic_tateModule_decompositionUnits`: **the fundamental class generates.**

## Tags

number field, decomposition group, fundamental class, local invariant, Brauer group,
Tate cohomology, local reciprocity
-/

namespace InverseGalois.CFT

open CategoryTheory IsDedekindDomain Module MulAction NumberField Tate

attribute [local instance] isGalois_adicCompletion

noncomputable section

/-! ### The reciprocal of a natural number modulo the integers -/

section Reciprocal

/-- A fraction with denominator `n` vanishes modulo the integers exactly when `n` divides its
numerator. -/
theorem intQModZ_eq_zero_iff {n : ℕ} (hn : n ≠ 0) (m : ℤ) :
    intQModZ n m = 0 ↔ (n : ℤ) ∣ m := by
  have hne : ((n : ℚ)) ≠ 0 := Nat.cast_ne_zero.2 hn
  rw [intQModZ_apply, QModZ.mk_eq_zero_iff]
  constructor
  · rintro ⟨j, hj⟩
    have hmq : (m : ℚ) = (j : ℚ) * (n : ℚ) := (div_eq_iff hne).1 hj.symm
    have hmz : m = j * (n : ℤ) := by exact_mod_cast hmq
    exact ⟨j, by rw [hmz, mul_comm]⟩
  · rintro ⟨j, rfl⟩
    refine ⟨j, ?_⟩
    push_cast
    rw [mul_comm ((n : ℚ)) ((j : ℚ)), mul_div_assoc, div_self hne, mul_one]

/-- A multiple of the reciprocal of `n` is the corresponding fraction with denominator `n`. -/
theorem nsmul_intQModZ_one (n m : ℕ) : m • intQModZ n 1 = intQModZ n (m : ℤ) := by
  have h : ((m : ℤ)) = m • (1 : ℤ) := by simp
  rw [h, map_nsmul]

/-- **The reciprocal of a nonzero natural number has that number as its order** in the rationals
modulo the integers. -/
theorem addOrderOf_intQModZ_one {n : ℕ} (hn : n ≠ 0) : addOrderOf (intQModZ n 1) = n := by
  refine Nat.dvd_antisymm (addOrderOf_dvd_iff_nsmul_eq_zero.2 ?_) ?_
  · rw [nsmul_intQModZ_one]
    exact intQModZ_natCast_self n
  · have h : addOrderOf (intQModZ n 1) • intQModZ n 1 = 0 :=
      addOrderOf_dvd_iff_nsmul_eq_zero.1 dvd_rfl
    rw [nsmul_intQModZ_one, intQModZ_eq_zero_iff hn] at h
    exact_mod_cast h

/-- **The reciprocal of a natural number**, in the rationals modulo the integers written
multiplicatively.  It is the value the invariant map takes on a fundamental class. -/
def reciprocalQModZ (n : ℕ) : Multiplicative QModZ := Multiplicative.ofAdd (intQModZ n 1)

/-- **A power of the reciprocal of a nonzero natural number is trivial exactly when that number
divides the exponent.** -/
theorem reciprocalQModZ_pow_eq_one_iff {n : ℕ} (hn : n ≠ 0) (m : ℕ) :
    reciprocalQModZ n ^ m = 1 ↔ n ∣ m := by
  rw [pow_eq_one_iff_nsmul_toAdd]
  show m • intQModZ n 1 = 0 ↔ n ∣ m
  rw [← addOrderOf_dvd_iff_nsmul_eq_zero, addOrderOf_intQModZ_one hn]

/-- The reciprocal of a natural number is killed by that number. -/
theorem reciprocalQModZ_pow_self (n : ℕ) : reciprocalQModZ n ^ n = 1 := by
  rcases eq_or_ne n 0 with rfl | hn
  · exact pow_zero _
  · exact (reciprocalQModZ_pow_eq_one_iff hn n).2 dvd_rfl

end Reciprocal

/-! ### The complete cohomology of a decomposition group -/

section Decomposition

variable {k K : Type} [Field k] [NumberField k] [Field K] [NumberField K] [Algebra k K]
  [IsGalois k K] (w : HeightOneSpectrum (𝓞 K))

variable (k) in
/-- **The complete cohomology in degree two of a decomposition group at a finite place is the
relative Brauer group of the completions there.**  It is the second cohomology of the Galois group
of the completions, and the crossed product construction identifies that with the relative Brauer
group. -/
def decompositionBrauerEquiv :
    Multiplicative ↥(tateModule (decompositionUnitsRep k w) 2) ≃*
      ↥(BrauerGroup.relative ((primeUnder (𝓞 k) w).adicCompletion k) (w.adicCompletion K)) :=
  (AddEquiv.toMultiplicative
    (decompositionTwoIso k w).symm.toLinearEquiv.toAddEquiv).trans brauerRelativeEquiv

variable (k) in
/-- The Brauer class attached to a class of the decomposition group is the one named by the
identification with the relative Brauer group. -/
theorem decompositionBrauer_eq
    (z : Multiplicative ↥(tateModule (decompositionUnitsRep k w) 2)) :
    decompositionBrauer k w z
      = ((decompositionBrauerEquiv k w z : ↥(BrauerGroup.relative
          ((primeUnder (𝓞 k) w).adicCompletion k) (w.adicCompletion K))) :
            BrauerGroup.{0, 0} ((primeUnder (𝓞 k) w).adicCompletion k)) := rfl

variable (k) in
/-- The complete cohomology in degree two of a decomposition group at a finite place is finite. -/
theorem finite_tateModule_decompositionUnits :
    Finite (Multiplicative ↥(tateModule (decompositionUnitsRep k w) 2)) := by
  obtain ⟨p, e, hres⟩ := exists_hasResidueChar_adicCompletion (primeUnder (𝓞 k) w)
  haveI := finite_relative_local (w.adicCompletion K) hres
    (isUnitValGen_one (valued_adicCompletion_surjective (primeUnder (𝓞 k) w)))
  exact Finite.of_equiv _ (decompositionBrauerEquiv k w).symm.toEquiv

variable (k) in
/-- **The complete cohomology in degree two of a decomposition group at a finite place has exactly
as many elements as the degree of the extension of the completions.**  It is the relative Brauer
group of that extension, and local reciprocity counts the relative Brauer group of an arbitrary
finite Galois extension of local fields. -/
theorem natCard_tateModule_decompositionUnits :
    Nat.card (Multiplicative ↥(tateModule (decompositionUnitsRep k w) 2))
      = finrank ((primeUnder (𝓞 k) w).adicCompletion k) (w.adicCompletion K) := by
  obtain ⟨p, e, hres⟩ := exists_hasResidueChar_adicCompletion (primeUnder (𝓞 k) w)
  rw [Nat.card_congr (decompositionBrauerEquiv k w).toEquiv]
  exact card_relative_eq_finrank (w.adicCompletion K) hres
    (isUnitValGen_one (valued_adicCompletion_surjective (primeUnder (𝓞 k) w)))

variable (k) in
/-- **Every rational modulo the integers killed by the degree of the extension of the completions
is the invariant of a class of the decomposition group.**  The classes of the Brauer group killed
by the degree are exactly the ones split by the extension, and those are the image of the complete
cohomology under the crossed product construction. -/
theorem exists_decompositionInvariant_eq (y : Multiplicative QModZ)
    (hy : y ^ finrank ((primeUnder (𝓞 k) w).adicCompletion k) (w.adicCompletion K) = 1) :
    ∃ z, decompositionInvariant k w z = y := by
  obtain ⟨p, e, hres⟩ := exists_hasResidueChar_adicCompletion (primeUnder (𝓞 k) w)
  obtain ⟨x, hxmem, hxinv⟩ := exists_mem_relative_localInvariantHom_eq (w.adicCompletion K) hres
    (isUnitValGen_one (valued_adicCompletion_surjective (primeUnder (𝓞 k) w))) y hy
  obtain ⟨z, hz⟩ := (decompositionBrauerEquiv k w).surjective ⟨x, hxmem⟩
  refine ⟨z, ?_⟩
  rw [decompositionInvariant_apply, ← hxinv, decompositionBrauer_eq]
  exact congrArg _ (congrArg Subtype.val hz)

/-! ### The fundamental class -/

variable (k) in
/-- **The fundamental class of a decomposition group at a finite place**: the unique class whose
invariant is the reciprocal of the degree of the extension of the completions. -/
def localFundamentalClass : Multiplicative ↥(tateModule (decompositionUnitsRep k w) 2) :=
  (exists_decompositionInvariant_eq k w
    (reciprocalQModZ (finrank ((primeUnder (𝓞 k) w).adicCompletion k) (w.adicCompletion K)))
    (reciprocalQModZ_pow_self _)).choose

variable (k) in
/-- **The invariant of the fundamental class is the reciprocal of the local degree.** -/
theorem decompositionInvariant_localFundamentalClass :
    decompositionInvariant k w (localFundamentalClass k w)
      = reciprocalQModZ
          (finrank ((primeUnder (𝓞 k) w).adicCompletion k) (w.adicCompletion K)) :=
  (exists_decompositionInvariant_eq k w _ (reciprocalQModZ_pow_self _)).choose_spec

variable (k) in
/-- **Exactly one class of the decomposition group at a finite place has the reciprocal of the
local degree as its invariant.**  One does because the invariant reaches every rational modulo the
integers killed by the degree, and only one does because the invariant is injective. -/
theorem existsUnique_decompositionInvariant_eq_reciprocal :
    ∃! z, decompositionInvariant k w z
      = reciprocalQModZ
          (finrank ((primeUnder (𝓞 k) w).adicCompletion k) (w.adicCompletion K)) :=
  ⟨localFundamentalClass k w, decompositionInvariant_localFundamentalClass k w, fun _ hz =>
    decompositionInvariant_injective k w
      (hz.trans (decompositionInvariant_localFundamentalClass k w).symm)⟩

variable (k) in
/-- A class of the decomposition group is trivial exactly when a power of it is named by a trivial
power of its invariant. -/
theorem pow_eq_one_iff_decompositionInvariant_pow_eq_one
    (z : Multiplicative ↥(tateModule (decompositionUnitsRep k w) 2)) (m : ℕ) :
    z ^ m = 1 ↔ decompositionInvariant k w z ^ m = 1 := by
  rw [← map_pow]
  refine ⟨fun h => by rw [h, map_one], fun h =>
    decompositionInvariant_injective k w (h.trans (map_one _).symm)⟩

variable (k) in
/-- **The fundamental class of a decomposition group at a finite place has the degree of the
extension of the completions as its order.**  Its invariant is the reciprocal of the degree, whose
order is the degree, and the invariant is injective. -/
theorem orderOf_localFundamentalClass :
    orderOf (localFundamentalClass k w)
      = finrank ((primeUnder (𝓞 k) w).adicCompletion k) (w.adicCompletion K) := by
  have hn : finrank ((primeUnder (𝓞 k) w).adicCompletion k) (w.adicCompletion K) ≠ 0 :=
    Module.finrank_pos.ne'
  refine Nat.dvd_antisymm (orderOf_dvd_of_pow_eq_one ?_) ?_
  · rw [pow_eq_one_iff_decompositionInvariant_pow_eq_one,
      decompositionInvariant_localFundamentalClass]
    exact reciprocalQModZ_pow_self _
  · have h : (localFundamentalClass k w) ^ orderOf (localFundamentalClass k w) = 1 :=
      pow_orderOf_eq_one _
    rw [pow_eq_one_iff_decompositionInvariant_pow_eq_one,
      decompositionInvariant_localFundamentalClass,
      reciprocalQModZ_pow_eq_one_iff hn] at h
    exact h

variable (k) in
/-- **The fundamental class generates the complete cohomology in degree two of a decomposition
group at a finite place.**  Its order is the local degree, and so is the number of elements of the
whole group. -/
theorem zpowers_localFundamentalClass_eq_top :
    Subgroup.zpowers (localFundamentalClass k w) = ⊤ := by
  haveI := finite_tateModule_decompositionUnits k w
  refine Subgroup.eq_top_of_card_eq _ ?_
  rw [Nat.card_zpowers, orderOf_localFundamentalClass,
    natCard_tateModule_decompositionUnits k w]

variable (k) in
/-- **The complete cohomology in degree two of a decomposition group at a finite place is
cyclic.** -/
theorem isCyclic_tateModule_decompositionUnits :
    IsCyclic (Multiplicative ↥(tateModule (decompositionUnitsRep k w) 2)) := by
  haveI := finite_tateModule_decompositionUnits k w
  exact isCyclic_of_orderOf_eq_card (localFundamentalClass k w)
    ((orderOf_localFundamentalClass k w).trans
      (natCard_tateModule_decompositionUnits k w).symm)

end Decomposition

end

end InverseGalois.CFT
