import Mathlib
import InverseGalois.CFT.Units.BaseChangeIndex
import InverseGalois.CFT.Units.IdeleClassH2
import InverseGalois.CFT.Units.IdeleClassIndex
import InverseGalois.CFT.Units.IdeleGen

/-!
# The norm quotient of a cyclic extension ramified at a single place

Let `K / k` be a cyclic extension of number fields, and suppose that away from one finite place `q`
every local unit of the base field is a norm.  The quotient of the ideles of the base field by the
principal ideles together with the norms is then generated by the local units at `q`, and if one
unit of the completion at `q` generates its units modulo `n`-th powers, where `n` is the degree,
that quotient is generated by a single element.

The degree annihilates the quotient, because the norm of an idele of the base field is the degree
times that idele.  So the order of the generator divides the degree, and the quotient has at most as
many elements as the degree.  The first inequality says it has at least as many, so the two agree
and the generator has order exactly the degree.  That is the computation which produces a class of
the right order for a cyclic cyclotomic extension.

## Main results

* `InverseGalois.CFT.nsmul_mem_ideleDiag_sup_ideleNorm`: the degree annihilates the quotient of the
  ideles by the principal ideles and the norms.
* `InverseGalois.CFT.forall_mem_multiples_ideleQuot`: **the quotient is generated by the class of
  the idele supported at the distinguished place.**
* `InverseGalois.CFT.addOrderOf_ideleQuot_eq`: **the generator has order the degree of the
  extension**, and the quotient has exactly as many elements as the Galois group.
* `InverseGalois.CFT.exists_zsmul_eq_zero_imp_dvd_H2_ideleClassRep`: **the second cohomology of the
  idele class group contains a class annihilated by exactly the multiples of the degree.**

## Tags

number field, idele, norm index, cyclic extension, first inequality
-/

set_option synthInstance.maxHeartbeats 800000
set_option maxHeartbeats 1000000

namespace InverseGalois.CFT

open IsDedekindDomain MulAction NumberField

section IdeleQuotCyclic

variable {k K : Type*} [Field k] [NumberField k] [Field K] [NumberField K] [Algebra k K]
  [IsGalois k K]

variable (k K) in
/-- The degree annihilates the quotient of the ideles of the base field by the principal ideles
together with the norms: the norm of an idele of the base field is the degree times that idele. -/
theorem nsmul_mem_ideleDiag_sup_ideleNorm (x : ↥(idele k)) :
    Nat.card Gal(K/k) • x ∈ (ideleDiag k).range ⊔ (ideleNorm k K).range :=
  AddSubgroup.mem_sup_right
    (AddMonoidHom.mem_range.mpr ⟨ideleComap k K x, ideleNorm_ideleComap k K x⟩)

variable (K) in
/-- **The quotient of the ideles by the principal ideles and the norms is generated by the class of
the idele supported at the distinguished place.**  Every idele agrees, modulo the principal ideles
and the norms, with one supported at that place whose component there is a unit of the valuation
ring; that unit is a power of the distinguished unit times a `n`-th power, and `n`-th powers die in
the quotient. -/
theorem forall_mem_multiples_ideleQuot [IsPrincipalIdealRing (𝓞 k)] {σ : Gal(K/k)}
    (hgen : ∀ g : Gal(K/k), g ∈ Subgroup.zpowers σ) (q : HeightOneSpectrum (𝓞 k))
    (hinf : ∀ (w : InfinitePlace K) (b : ((w.comap (algebraMap k K)).Completion)ˣ),
      b ∈ normSubgroup ((w.comap (algebraMap k K)).Completion) w.Completion)
    (hfin : ∀ w : HeightOneSpectrum (𝓞 K), primeUnder (𝓞 k) w ≠ q →
      ∀ b : ((primeUnder (𝓞 k) w).adicCompletion k)ˣ, unitVal (Additive.ofMul b) = 0 →
        b ∈ normSubgroup ((primeUnder (𝓞 k) w).adicCompletion k) (w.adicCompletion K))
    {g : (q.adicCompletion k)ˣ}
    (hg : ∀ u : (q.adicCompletion k)ˣ, unitVal (Additive.ofMul u) = 0 →
      ∃ (m : ℕ) (y : (q.adicCompletion k)ˣ), u = g ^ m * y ^ Nat.card Gal(K/k))
    (c : ↥(idele k) ⧸ ((ideleDiag k).range ⊔ (ideleNorm k K).range)) :
    c ∈ AddSubmonoid.multiples
      ((adicPlaceIdele k q (Additive.ofMul g) : ↥(idele k)) :
        ↥(idele k) ⧸ ((ideleDiag k).range ⊔ (ideleNorm k K).range)) := by
  obtain ⟨d, rfl⟩ := QuotientAddGroup.mk_surjective c
  obtain ⟨u, hu0, husub⟩ := exists_sub_adicPlaceIdele_mem_sup K hgen q hinf hfin d
  obtain ⟨m, y, hmy⟩ := hg (Additive.toMul u) hu0
  refine ⟨m, ?_⟩
  dsimp only
  -- the component at the distinguished place splits off an `n`-th power
  have hu : u = Additive.ofMul (g ^ m * y ^ Nat.card Gal(K/k)) := congrArg Additive.ofMul hmy
  rw [ofMul_mul, ofMul_pow, ofMul_pow] at hu
  have hsplit : adicPlaceIdele k q u
      = m • adicPlaceIdele k q (Additive.ofMul g)
        + Nat.card Gal(K/k) • adicPlaceIdele k q (Additive.ofMul y) := by
    rw [hu, map_add, map_nsmul, map_nsmul]
  -- the `n`-th power dies in the quotient
  have hmem : m • adicPlaceIdele k q (Additive.ofMul g) - d
      ∈ (ideleDiag k).range ⊔ (ideleNorm k K).range := by
    have hrw : m • adicPlaceIdele k q (Additive.ofMul g) - d
        = -(d - adicPlaceIdele k q u)
          - Nat.card Gal(K/k) • adicPlaceIdele k q (Additive.ofMul y) := by
      rw [hsplit]
      abel
    rw [hrw]
    exact AddSubgroup.sub_mem _ (AddSubgroup.neg_mem _ husub)
      (nsmul_mem_ideleDiag_sup_ideleNorm k K _)
  have hgoal : ((m • adicPlaceIdele k q (Additive.ofMul g) : ↥(idele k)) :
      ↥(idele k) ⧸ ((ideleDiag k).range ⊔ (ideleNorm k K).range))
      = ((d : ↥(idele k)) : ↥(idele k) ⧸ ((ideleDiag k).range ⊔ (ideleNorm k K).range)) :=
    QuotientAddGroup.eq_iff_sub_mem.mpr hmem
  have hns : ((m • adicPlaceIdele k q (Additive.ofMul g) : ↥(idele k)) :
      ↥(idele k) ⧸ ((ideleDiag k).range ⊔ (ideleNorm k K).range))
      = m • ((adicPlaceIdele k q (Additive.ofMul g) : ↥(idele k)) :
        ↥(idele k) ⧸ ((ideleDiag k).range ⊔ (ideleNorm k K).range)) := rfl
  exact hns.symm.trans hgoal

variable (K) in
/-- **The generator of the quotient has order the degree of the extension.**  Its order is the
number of elements of the quotient because it generates, that number divides the degree because the
degree annihilates the quotient, and it is at least the degree by the first inequality. -/
theorem addOrderOf_ideleQuot_eq [IsPrincipalIdealRing (𝓞 k)] {σ : Gal(K/k)}
    (hgen : ∀ g : Gal(K/k), g ∈ Subgroup.zpowers σ) (q : HeightOneSpectrum (𝓞 k))
    (hinf : ∀ (w : InfinitePlace K) (b : ((w.comap (algebraMap k K)).Completion)ˣ),
      b ∈ normSubgroup ((w.comap (algebraMap k K)).Completion) w.Completion)
    (hfin : ∀ w : HeightOneSpectrum (𝓞 K), primeUnder (𝓞 k) w ≠ q →
      ∀ b : ((primeUnder (𝓞 k) w).adicCompletion k)ˣ, unitVal (Additive.ofMul b) = 0 →
        b ∈ normSubgroup ((primeUnder (𝓞 k) w).adicCompletion k) (w.adicCompletion K))
    {g : (q.adicCompletion k)ˣ}
    (hg : ∀ u : (q.adicCompletion k)ˣ, unitVal (Additive.ofMul u) = 0 →
      ∃ (m : ℕ) (y : (q.adicCompletion k)ˣ), u = g ^ m * y ^ Nat.card Gal(K/k)) :
    addOrderOf ((adicPlaceIdele k q (Additive.ofMul g) : ↥(idele k)) :
      ↥(idele k) ⧸ ((ideleDiag k).range ⊔ (ideleNorm k K).range)) = Nat.card Gal(K/k) := by
  haveI : NeZero (Nat.card Gal(K/k)) := ⟨Nat.card_pos.ne'⟩
  have hcard := addOrderOf_eq_card_of_forall_mem_multiples
    (forall_mem_multiples_ideleQuot K hgen q hinf hfin hg)
  -- the order divides the degree, so the quotient is at most as big as the Galois group
  have hzero : Nat.card Gal(K/k) • ((adicPlaceIdele k q (Additive.ofMul g) : ↥(idele k)) :
      ↥(idele k) ⧸ ((ideleDiag k).range ⊔ (ideleNorm k K).range)) = 0 := by
    rw [← QuotientAddGroup.mk_nsmul]
    exact (QuotientAddGroup.eq_zero_iff _).mpr (nsmul_mem_ideleDiag_sup_ideleNorm k K _)
  have hdvd := addOrderOf_dvd_of_nsmul_eq_zero hzero
  rw [hcard] at hdvd
  -- the first inequality says it is at least as big
  have hle : Nat.card Gal(K/k)
      ≤ Nat.card (↥(idele k) ⧸ ((ideleDiag k).range ⊔ (ideleNorm k K).range)) := by
    rw [← AddSubgroup.index_eq_card]
    exact first_inequality_index hgen rfl
  rw [hcard]
  exact le_antisymm (Nat.le_of_dvd Nat.card_pos hdvd) hle

end IdeleQuotCyclic

/-! ### The class in the second cohomology -/

section IdeleQuotCyclicRep

open groupCohomology

variable {k K : Type} [Field k] [NumberField k] [Field K] [NumberField K] [Algebra k K]
  [IsGalois k K]

variable (K) in
/-- **The second cohomology of the idele class group of a cyclic extension ramified at a single
place contains a class of order the degree.**  The quotient of the ideles by the principal ideles
and the norms is the zeroth Tate group of a generator, which in turn is the second cohomology, and
the class of the idele supported at the distinguished place has order the degree. -/
theorem exists_addOrderOf_H2_ideleClassRep_eq [IsPrincipalIdealRing (𝓞 k)] {σ : Gal(K/k)}
    (hgen : ∀ g : Gal(K/k), g ∈ Subgroup.zpowers σ) (q : HeightOneSpectrum (𝓞 k))
    (hinf : ∀ (w : InfinitePlace K) (b : ((w.comap (algebraMap k K)).Completion)ˣ),
      b ∈ normSubgroup ((w.comap (algebraMap k K)).Completion) w.Completion)
    (hfin : ∀ w : HeightOneSpectrum (𝓞 K), primeUnder (𝓞 k) w ≠ q →
      ∀ b : ((primeUnder (𝓞 k) w).adicCompletion k)ˣ, unitVal (Additive.ofMul b) = 0 →
        b ∈ normSubgroup ((primeUnder (𝓞 k) w).adicCompletion k) (w.adicCompletion K))
    {g : (q.adicCompletion k)ˣ}
    (hg : ∀ u : (q.adicCompletion k)ˣ, unitVal (Additive.ofMul u) = 0 →
      ∃ (m : ℕ) (y : (q.adicCompletion k)ˣ), u = g ^ m * y ^ Nat.card Gal(K/k)) :
    ∃ α : ↥(H2 (ideleClassRep k K)), addOrderOf α = Nat.card Gal(K/k) := by
  haveI : Fintype Gal(K/k) := Fintype.ofFinite _
  refine ⟨tateH0AddEquivH2 (A := ideleClassRep k K) (g := σ) (σ := ideleClassAut (k := k) σ)
    hgen (fun _ => rfl) (ideleQuotEquivTateH0 hgen rfl
      (QuotientAddGroup.mk (s := (ideleDiag k).range ⊔ (ideleNorm k K).range)
        (adicPlaceIdele k q (Additive.ofMul g)))), ?_⟩
  rw [AddEquiv.addOrderOf_eq]
  exact (AddEquiv.addOrderOf_eq (ideleQuotEquivTateH0 hgen rfl) _).trans
    (addOrderOf_ideleQuot_eq K hgen q hinf hfin hg)

variable (K) in
/-- **The second cohomology of the idele class group of a cyclic extension ramified at a single
place contains a class annihilated by exactly the multiples of the degree**, namely a class whose
order is the degree. -/
theorem exists_zsmul_eq_zero_imp_dvd_H2_ideleClassRep [IsPrincipalIdealRing (𝓞 k)] {σ : Gal(K/k)}
    (hgen : ∀ g : Gal(K/k), g ∈ Subgroup.zpowers σ) (q : HeightOneSpectrum (𝓞 k))
    (hinf : ∀ (w : InfinitePlace K) (b : ((w.comap (algebraMap k K)).Completion)ˣ),
      b ∈ normSubgroup ((w.comap (algebraMap k K)).Completion) w.Completion)
    (hfin : ∀ w : HeightOneSpectrum (𝓞 K), primeUnder (𝓞 k) w ≠ q →
      ∀ b : ((primeUnder (𝓞 k) w).adicCompletion k)ˣ, unitVal (Additive.ofMul b) = 0 →
        b ∈ normSubgroup ((primeUnder (𝓞 k) w).adicCompletion k) (w.adicCompletion K))
    {g : (q.adicCompletion k)ˣ}
    (hg : ∀ u : (q.adicCompletion k)ˣ, unitVal (Additive.ofMul u) = 0 →
      ∃ (m : ℕ) (y : (q.adicCompletion k)ˣ), u = g ^ m * y ^ Nat.card Gal(K/k)) :
    ∃ α : ↥(H2 (ideleClassRep k K)),
      ∀ m : ℤ, m • α = 0 → (Nat.card Gal(K/k) : ℤ) ∣ m := by
  obtain ⟨α, hα⟩ := exists_addOrderOf_H2_ideleClassRep_eq K hgen q hinf hfin hg
  exact ⟨α, fun m hm => hα ▸ addOrderOf_dvd_iff_zsmul_eq_zero.mpr hm⟩

end IdeleQuotCyclicRep

end InverseGalois.CFT
