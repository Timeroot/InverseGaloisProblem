import Mathlib
import InverseGalois.CFT.SubgroupCounting
import InverseGalois.CFT.Units.SplitPlaces

/-!
# A basis of primes for an intermediate field

Let `M / K` be an abelian extension of number fields of prime exponent `p`, let `L` be an
intermediate field, and let `S` be a finite set of finite places of `K` outside which `M / K` is
unramified.  The decomposition groups at the places of `M` splitting completely in `L` generate the
subgroup of the Galois group fixing `L`; the point of this file is to cut that generating family
down to an independent one indexed by finitely many places of the base.

Because the Galois group is commutative, the decomposition groups at two places of `M` above the
same place of `K` coincide, so the family is really indexed by places of `K`.  Each member has
order `1` or `p`, the decomposition group at an unramified place being cyclic, and a greedy
selection therefore produces a finite set `T` of places of the base, disjoint from `S` and split
completely in `L`, whose number of elements is the exponent `t` with `p ^ t = [M : L]`.

## Main definitions

* `InverseGalois.CFT.splitDecomposition`: the subgroup generated by the decomposition groups at the
  places above a given place of the base which split completely in the intermediate field.

## Main results

* `InverseGalois.CFT.stabilizer_eq_of_primeUnder_eq`: for a commutative Galois group, the
  decomposition groups at two places above the same place of the base agree.
* `InverseGalois.CFT.card_stabilizer_dvd_of_isUnramifiedAt`: the decomposition group at an
  unramified place has order dividing the exponent of the Galois group.
* `InverseGalois.CFT.exists_finset_primes_splitPlaces`: **there is a finite set of places of the
  base, disjoint from the prescribed set and split completely in the intermediate field, whose
  decomposition groups generate the subgroup fixing that field independently**, so that the order
  of the latter is `p` raised to the number of chosen places.

## Tags

number field, place, decomposition group, splitting, basis, second inequality
-/

namespace InverseGalois.CFT

open IsDedekindDomain MulAction NumberField

section Relative

variable {K M : Type*} [Field K] [NumberField K] [Field M] [NumberField M] [Algebra K M]
  [IsGalois K M] {p : ℕ}

set_option synthInstance.maxHeartbeats 400000
set_option maxHeartbeats 1000000

/-- **For a commutative Galois group the decomposition groups at two places above the same place of
the base agree.**  The two places lie in the same orbit, and conjugation is trivial. -/
theorem stabilizer_eq_of_primeUnder_eq (hcomm : ∀ σ τ : Gal(M/K), σ * τ = τ * σ)
    {w w' : HeightOneSpectrum (𝓞 M)} (h : primeUnder (𝓞 K) w = primeUnder (𝓞 K) w') :
    stabilizer Gal(M/K) w = stabilizer Gal(M/K) w' := by
  obtain ⟨σ, rfl⟩ := exists_smul_eq_of_primeUnder_eq (A := 𝓞 K) (G := Gal(M/K)) h
  ext τ
  simp only [mem_stabilizer_iff]
  constructor
  · intro hτ
    rw [smul_smul, hcomm τ σ, ← smul_smul, hτ]
  · intro hτ
    refine smul_left_cancel σ ?_
    rw [smul_smul, hcomm σ τ, ← smul_smul, hτ]

/-- **The decomposition group at an unramified place has order dividing the exponent.**  That group
is cyclic, so its order is the order of a generator. -/
theorem card_stabilizer_dvd_of_isUnramifiedAt (hexp : ∀ σ : Gal(M/K), σ ^ p = 1)
    (w : HeightOneSpectrum (𝓞 M)) (hw : Algebra.IsUnramifiedAt (𝓞 K) w.asIdeal) :
    Nat.card ↥(stabilizer Gal(M/K) w) ∣ p := by
  haveI hcyc : IsCyclic ↥(stabilizer Gal(M/K) w) := isCyclic_stabilizer_of_isUnramifiedAt w hw
  obtain ⟨g, hg⟩ := hcyc.exists_generator
  rw [← orderOf_eq_card_of_forall_mem_zpowers hg]
  refine orderOf_dvd_of_pow_eq_one (Subtype.ext ?_)
  push_cast
  exact hexp _

variable (L : IntermediateField K M)

/-- **The subgroup generated by the decomposition groups at the places above a given place of the
base which split completely in an intermediate field.** -/
def splitDecomposition (S : Set (HeightOneSpectrum (𝓞 K))) (v : HeightOneSpectrum (𝓞 K)) :
    Subgroup Gal(M/K) :=
  ⨆ w, ⨆ _ : w ∈ splitPlaces L S ∧ primeUnder (𝓞 K) w = v, stabilizer Gal(M/K) w

variable {L} in
omit [NumberField K] [IsGalois K M] in
/-- A place of the base carrying no place splitting completely in the intermediate field
contributes nothing. -/
theorem splitDecomposition_eq_bot {S : Set (HeightOneSpectrum (𝓞 K))}
    {v : HeightOneSpectrum (𝓞 K)}
    (h : ∀ w : HeightOneSpectrum (𝓞 M), w ∈ splitPlaces L S → primeUnder (𝓞 K) w ≠ v) :
    splitDecomposition L S v = ⊥ := by
  refine iSup_eq_bot.mpr fun w => iSup_eq_bot.mpr fun hw => ?_
  exact absurd hw.2 (h w hw.1)

variable {L} in
/-- At a place of the base carrying a place splitting completely in the intermediate field, the
contribution is the decomposition group there. -/
theorem splitDecomposition_eq_stabilizer (hcomm : ∀ σ τ : Gal(M/K), σ * τ = τ * σ)
    {S : Set (HeightOneSpectrum (𝓞 K))} {w : HeightOneSpectrum (𝓞 M)}
    (hw : w ∈ splitPlaces L S) :
    splitDecomposition L S (primeUnder (𝓞 K) w) = stabilizer Gal(M/K) w := by
  refine le_antisymm (iSup₂_le fun w' hw' => ?_) ?_
  · exact le_of_eq (stabilizer_eq_of_primeUnder_eq hcomm hw'.2)
  · exact le_iSup₂ (f := fun w' (_ : w' ∈ splitPlaces L S ∧ primeUnder (𝓞 K) w' = primeUnder _ w) =>
      stabilizer Gal(M/K) w') w ⟨hw, rfl⟩

variable {L} in
/-- The order of the contribution of a place of the base divides the exponent. -/
theorem card_splitDecomposition_dvd (hcomm : ∀ σ τ : Gal(M/K), σ * τ = τ * σ)
    (hexp : ∀ σ : Gal(M/K), σ ^ p = 1) {S : Set (HeightOneSpectrum (𝓞 K))}
    (hunr : ∀ w : HeightOneSpectrum (𝓞 M), primeUnder (𝓞 K) w ∉ S →
      Algebra.IsUnramifiedAt (𝓞 K) w.asIdeal) (v : HeightOneSpectrum (𝓞 K)) :
    Nat.card ↥(splitDecomposition L S v) ∣ p := by
  by_cases h : ∃ w : HeightOneSpectrum (𝓞 M), w ∈ splitPlaces L S ∧ primeUnder (𝓞 K) w = v
  · obtain ⟨w, hw, rfl⟩ := h
    rw [splitDecomposition_eq_stabilizer hcomm hw]
    exact card_stabilizer_dvd_of_isUnramifiedAt hexp w (hunr w hw.1)
  · push_neg at h
    rw [splitDecomposition_eq_bot h, Subgroup.card_bot]
    exact one_dvd p

variable {L} in
/-- **A basis of primes of the base for an intermediate field.**  Finitely many places of the base,
disjoint from the prescribed set and splitting completely in the intermediate field, carry
decomposition groups generating the subgroup that fixes it, and independently so: the order of that
subgroup is the exponent raised to the number of chosen places. -/
theorem exists_finset_primes_splitPlaces [IsSolvable Gal(M/↥L)] (hp : p.Prime)
    (hcomm : ∀ σ τ : Gal(M/K), σ * τ = τ * σ) (hexp : ∀ σ : Gal(M/K), σ ^ p = 1)
    {S : Set (HeightOneSpectrum (𝓞 K))} (hS : S.Finite)
    (hunr : ∀ w : HeightOneSpectrum (𝓞 M), primeUnder (𝓞 K) w ∉ S →
      Algebra.IsUnramifiedAt (𝓞 K) w.asIdeal) :
    ∃ T : Finset (HeightOneSpectrum (𝓞 K)),
      (∀ v ∈ T, v ∉ S) ∧
      (∀ v ∈ T, ∃ w : HeightOneSpectrum (𝓞 M), w ∈ splitPlaces L S ∧ primeUnder (𝓞 K) w = v) ∧
      Nat.card ↥L.fixingSubgroup = p ^ T.card ∧
      Subgroup.closure (⋃ w, ⋃ _ : w ∈ splitPlaces L S ∧ primeUnder (𝓞 K) w ∈ T,
        (stabilizer Gal(M/K) w : Set Gal(M/K))) = L.fixingSubgroup := by
  classical
  have hgen : (⨆ v, splitDecomposition L S v) = L.fixingSubgroup := by
    have h1 : (⨆ v, splitDecomposition L S v)
        = ⨆ w, ⨆ _ : w ∈ splitPlaces L S, stabilizer Gal(M/K) w :=
      iSup_fiber (stabilizer Gal(M/K)) (primeUnder (𝓞 K)) (· ∈ splitPlaces L S)
    rw [h1, biSup_eq_closure]
    exact closure_stabilizer_splitPlaces hp hexp hS hunr
  obtain ⟨T, hTgen, hTcard, hTord⟩ :=
    exists_finset_iSup_eq hcomm hp (splitDecomposition L S)
      (card_splitDecomposition_dvd hcomm hexp hunr) hgen
  have hTex : ∀ v ∈ T,
      ∃ w : HeightOneSpectrum (𝓞 M), w ∈ splitPlaces L S ∧ primeUnder (𝓞 K) w = v := by
    intro v hv
    by_contra h
    push_neg at h
    have := hTord v hv
    rw [splitDecomposition_eq_bot h, Subgroup.card_bot] at this
    exact hp.one_lt.ne this
  refine ⟨T, fun v hv => ?_, hTex, hTcard, ?_⟩
  · obtain ⟨w, hw, rfl⟩ := hTex v hv
    exact hw.1
  · have h2 : (⨆ v, ⨆ _ : v ∈ T, splitDecomposition L S v)
        = ⨆ w, ⨆ _ : w ∈ splitPlaces L S ∧ primeUnder (𝓞 K) w ∈ T, stabilizer Gal(M/K) w :=
      biSup_fiber (stabilizer Gal(M/K)) (primeUnder (𝓞 K)) (· ∈ splitPlaces L S) (· ∈ T)
    rw [← biSup_eq_closure, ← h2]
    exact hTgen

end Relative

end InverseGalois.CFT
