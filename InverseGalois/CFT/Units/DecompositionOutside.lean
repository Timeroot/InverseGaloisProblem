import Mathlib
import InverseGalois.CFT.Units.Decomposition
import InverseGalois.CFT.Units.SplitOutside

/-!
# The decomposition groups away from finitely many places generate the Galois group

Throwing away finitely many places of the base field, and all the infinite places, costs nothing:
the decomposition groups at the finite places of a solvable Galois extension of number fields whose
place below avoids a prescribed finite set already generate the whole Galois group.

The argument is the one for the decomposition groups of all the places, run against the sharper
input.  The subgroup generated is normal, because a conjugate of an automorphism fixing a place
fixes the moved place, which lies above the same place of the base field.  In the fixed field every
place of the base field outside the prescribed set splits completely, because an automorphism of
that subextension fixing a place is the restriction of an automorphism of the top field fixing a
place above that very place, and such a place of the top field lies above the same place of the base
field, so the automorphism lies in the subgroup and restricts to the identity.  A solvable extension
in which every place outside a finite set splits completely is trivial, so the fixed field is the
base field.

This is the form of the statement that the norm-limitation argument needs, where the exceptional set
absorbs the ramified places, the places dividing the exponent, and any other finite nuisance.

## Main definitions

* `InverseGalois.CFT.decompositionSetOutside`: the automorphisms fixing a finite place whose place
  below avoids the prescribed set.
* `InverseGalois.CFT.decompositionSubgroupOutside`: **the subgroup generated by those decomposition
  groups.**

## Main results

* `InverseGalois.CFT.decompositionSubgroupOutside_eq_top`: **the decomposition groups at the finite
  places away from a finite set of places of the base field generate a solvable Galois group.**

## Tags

number field, place, decomposition group, splitting, solvable, exceptional set
-/

namespace InverseGalois.CFT

open IsDedekindDomain MulAction NumberField

section Definition

variable (k K : Type*) [Field k] [NumberField k] [Field K] [NumberField K] [Algebra k K]
  [IsGalois k K] (S : Set (HeightOneSpectrum (𝓞 k)))

/-- **The automorphisms fixing a finite place whose place below avoids the prescribed set.** -/
def decompositionSetOutside : Set Gal(K/k) :=
  {σ | ∃ v : HeightOneSpectrum (𝓞 K), primeUnder (𝓞 k) v ∉ S ∧ σ • v = v}

/-- **The subgroup generated by the decomposition groups at the finite places away from the
prescribed set.** -/
def decompositionSubgroupOutside : Subgroup Gal(K/k) :=
  Subgroup.closure (decompositionSetOutside k K S)

omit [NumberField k] [IsGalois k K] in
theorem subset_decompositionSubgroupOutside :
    decompositionSetOutside k K S ⊆ decompositionSubgroupOutside k K S :=
  Subgroup.subset_closure

omit [NumberField k] [IsGalois k K] in
/-- The decomposition group at a finite place away from the prescribed set lies in the subgroup they
generate. -/
theorem stabilizer_le_decompositionSubgroupOutside {v : HeightOneSpectrum (𝓞 K)}
    (hv : primeUnder (𝓞 k) v ∉ S) :
    stabilizer Gal(K/k) v ≤ decompositionSubgroupOutside k K S :=
  fun _ hσ => subset_decompositionSubgroupOutside k K S ⟨v, hv, hσ⟩

variable {k K S} in
/-- **The set of automorphisms fixing a finite place away from the prescribed set is stable under
conjugation**, a conjugate fixing the moved place, which lies above the same place of the base
field. -/
theorem conj_mem_decompositionSetOutside (g : Gal(K/k)) {σ : Gal(K/k)}
    (hσ : σ ∈ decompositionSetOutside k K S) :
    g * σ * g⁻¹ ∈ decompositionSetOutside k K S := by
  obtain ⟨v, hvS, hv⟩ := hσ
  exact ⟨g • v, by rwa [primeUnder_smul_eq], by rw [mul_smul, inv_smul_smul, mul_smul, hv]⟩

instance decompositionSubgroupOutside_normal : (decompositionSubgroupOutside k K S).Normal := by
  refine ⟨fun n hn g => ?_⟩
  induction hn using Subgroup.closure_induction with
  | mem x hx =>
    exact subset_decompositionSubgroupOutside k K S (conj_mem_decompositionSetOutside g hx)
  | one => simp
  | mul x y _ _ hx hy =>
    rw [show g * (x * y) * g⁻¹ = g * x * g⁻¹ * (g * y * g⁻¹) by group]
    exact mul_mem hx hy
  | inv x _ hx =>
    rw [show g * x⁻¹ * g⁻¹ = (g * x * g⁻¹)⁻¹ by group]
    exact inv_mem hx

end Definition

section Generate

variable (k K : Type*) [Field k] [NumberField k] [Field K] [NumberField K] [Algebra k K]
  [IsGalois k K] {S : Set (HeightOneSpectrum (𝓞 k))}

set_option synthInstance.maxHeartbeats 400000
set_option maxHeartbeats 1000000

/-- **The decomposition groups at the finite places away from a finite set of places of the base
field generate a solvable Galois group.**  In the fixed field of the subgroup they generate every
place of the base field outside that set splits completely, because an automorphism of that
subextension fixing such a place lifts to an automorphism fixing a place above it, which lies in the
subgroup and so restricts to the identity; a solvable extension in which every place outside a
finite set splits completely is trivial. -/
theorem decompositionSubgroupOutside_eq_top [IsSolvable Gal(K/k)] (hS : S.Finite) :
    decompositionSubgroupOutside k K S = ⊤ := by
  refine eq_top_of_subsingleton_gal_fixedField _ ?_
  set F := IntermediateField.fixedField (decompositionSubgroupOutside k K S) with hF
  haveI : IsSolvable Gal(↥F/k) :=
    solvable_of_surjective (AlgEquiv.restrictNormalHom_surjective (F := k) (K₁ := ↥F) (E := K))
  have key : ∀ σ : Gal(K/k), σ ∈ decompositionSetOutside k K S →
      AlgEquiv.restrictNormalHom ↥F σ = 1 := by
    intro σ hσ
    refine MonoidHom.mem_ker.mp ?_
    rw [ker_restrictNormalHom_fixedField]
    exact subset_decompositionSubgroupOutside k K S hσ
  refine subsingleton_gal_of_isSolvable_of_splits_outside hS fun u hu => ?_
  refine (Subgroup.eq_bot_iff_forall _).mpr fun τ hτ => ?_
  obtain ⟨σ, ⟨v, hvu, hv⟩, hres⟩ := exists_restrictNormalHom_eq_of_prime_above K τ hτ
  have hvS : primeUnder (𝓞 k) v ∉ S := by
    rwa [← primeUnder_primeUnder k ↥F v, hvu]
  rw [← hres]
  exact key σ ⟨v, hvS, hv⟩

end Generate

end InverseGalois.CFT
