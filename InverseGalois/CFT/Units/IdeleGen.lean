import Mathlib
import InverseGalois.CFT.Units.ClassSet
import InverseGalois.CFT.Units.LocalNorm
import InverseGalois.CFT.Units.PlaceIdele

/-!
# One place generates the norm quotient of the ideles

Let `K / k` be a cyclic extension of number fields and let `q` be a finite place of `k`.  Suppose
that at every infinite place every local unit of the base is a norm, and that at every finite place
other than `q` every unit of the valuation ring of the base is a norm.  If moreover the ring of
integers of `k` is principal, then the quotient of the ideles by the principal ideles and the norms
is generated by the local units of the valuation ring at the single place `q`.

The argument has three steps.  A prescribed system of orders is realised by an element of the field
because the class group is trivial, so subtracting a principal idele makes every finite component a
unit of the valuation ring.  Subtracting the component at `q`, carried by the idele supported at
that one place, makes the component there trivial.  What remains is a local norm at every place, so
the norm theorem in local form exhibits it as the norm of an idele.

## Main results

* `InverseGalois.CFT.exists_sub_adicPlaceIdele_mem_sup`: **every idele differs from one supported
  at a single place, with unit component there, by a principal idele and a norm.**

## Tags

number field, idele, norm, class group, local norm
-/

set_option synthInstance.maxHeartbeats 800000
set_option maxHeartbeats 1000000

namespace InverseGalois.CFT

open IsDedekindDomain MulAction NumberField Rigidity.RET

section IdeleGen

variable {k K : Type*} [Field k] [NumberField k] [Field K] [NumberField K] [Algebra k K]
  [IsGalois k K]

variable (K) in
/-- **Every idele differs from one supported at a single place, with unit component there, by a
principal idele and a norm.**  Removing a principal idele makes every finite component a unit of
the valuation ring, removing the component at the distinguished place makes that one trivial, and
what is left is a local norm at every place, hence a norm of an idele. -/
theorem exists_sub_adicPlaceIdele_mem_sup [IsPrincipalIdealRing (𝓞 k)] {σ : Gal(K/k)}
    (hgen : ∀ g : Gal(K/k), g ∈ Subgroup.zpowers σ) (q : HeightOneSpectrum (𝓞 k))
    (hinf : ∀ (w : InfinitePlace K) (b : ((w.comap (algebraMap k K)).Completion)ˣ),
      b ∈ normSubgroup ((w.comap (algebraMap k K)).Completion) w.Completion)
    (hfin : ∀ w : HeightOneSpectrum (𝓞 K), primeUnder (𝓞 k) w ≠ q →
      ∀ b : ((primeUnder (𝓞 k) w).adicCompletion k)ˣ, unitVal (Additive.ofMul b) = 0 →
        b ∈ normSubgroup ((primeUnder (𝓞 k) w).adicCompletion k) (w.adicCompletion K))
    (d : ↥(idele k)) :
    ∃ u : Additive (q.adicCompletion k)ˣ, unitVal u = 0 ∧
      d - adicPlaceIdele k q u ∈ (ideleDiag k).range ⊔ (ideleNorm k K).range := by
  -- a principal idele with the prescribed orders exists because the class group is trivial
  have hm : ∀ᶠ v : HeightOneSpectrum (𝓞 k) in Filter.cofinite,
      -unitVal ((d : FullIdele k).2 v) = 0 := by
    filter_upwards [(mem_idele k).mp d.2] with v hv
    rw [hv, neg_zero]
  obtain ⟨a, ha⟩ := exists_ord_repr_of_isPrincipalIdealRing k
    (fun v => -unitVal ((d : FullIdele k).2 v)) hm
  -- after removing it every finite component is a unit of the valuation ring
  have hd' : ∀ v : HeightOneSpectrum (𝓞 k),
      unitVal (((d - ideleDiag k (Additive.ofMul a) : ↥(idele k)) : FullIdele k).2 v) = 0 := by
    intro v
    have h1 : ((d - ideleDiag k (Additive.ofMul a) : ↥(idele k)) : FullIdele k).2 v
        = (d : FullIdele k).2 v - (fullDiag k (Additive.ofMul a)).2 v := rfl
    have h2 : unitVal ((fullDiag k (Additive.ofMul a)).2 v) = -ord k v (a : k) :=
      unitVal_adicUnitHom v a
    rw [h1, map_sub, h2, ha v]
    ring
  refine ⟨((d - ideleDiag k (Additive.ofMul a) : ↥(idele k)) : FullIdele k).2 q, hd' q, ?_⟩
  -- the component at the distinguished place is removed by the idele supported there
  have hzero : ((d - ideleDiag k (Additive.ofMul a)
      - adicPlaceIdele k q (((d - ideleDiag k (Additive.ofMul a) : ↥(idele k)) :
        FullIdele k).2 q) : ↥(idele k)) : FullIdele k).2 q = 0 := by
    show ((d - ideleDiag k (Additive.ofMul a) : ↥(idele k)) : FullIdele k).2 q
      - (fullPlaceIdele k q (((d - ideleDiag k (Additive.ofMul a) : ↥(idele k)) :
        FullIdele k).2 q)).2 q = 0
    rw [fullPlaceIdele_snd_self]
    exact sub_self _
  -- what remains is a local norm at every place
  have hnorm : (d - ideleDiag k (Additive.ofMul a)
      - adicPlaceIdele k q (((d - ideleDiag k (Additive.ofMul a) : ↥(idele k)) :
        FullIdele k).2 q) : ↥(idele k)) ∈ (ideleNorm k K).range := by
    refine mem_range_ideleNorm_of_forall_mem_normSubgroup hgen rfl _ (fun w => hinf w _) ?_
    intro w
    by_cases hw : primeUnder (𝓞 k) w = q
    · subst hw
      rw [show Additive.toMul (((d - ideleDiag k (Additive.ofMul a)
          - adicPlaceIdele k (primeUnder (𝓞 k) w) (((d - ideleDiag k (Additive.ofMul a) :
            ↥(idele k)) : FullIdele k).2 (primeUnder (𝓞 k) w)) : ↥(idele k)) :
          FullIdele k).2 (primeUnder (𝓞 k) w)) = Additive.toMul 0 from congrArg _ hzero]
      exact one_mem _
    · have h1 : ((d - ideleDiag k (Additive.ofMul a)
          - adicPlaceIdele k q (((d - ideleDiag k (Additive.ofMul a) : ↥(idele k)) :
            FullIdele k).2 q) : ↥(idele k)) : FullIdele k).2 (primeUnder (𝓞 k) w)
          = ((d - ideleDiag k (Additive.ofMul a) : ↥(idele k)) :
            FullIdele k).2 (primeUnder (𝓞 k) w) := by
        show ((d - ideleDiag k (Additive.ofMul a) : ↥(idele k)) :
            FullIdele k).2 (primeUnder (𝓞 k) w)
          - (fullPlaceIdele k q (((d - ideleDiag k (Additive.ofMul a) : ↥(idele k)) :
            FullIdele k).2 q)).2 (primeUnder (𝓞 k) w) = _
        rw [fullPlaceIdele_snd_of_ne hw, sub_zero]
      refine hfin w hw _ ?_
      show unitVal (((d - ideleDiag k (Additive.ofMul a)
        - adicPlaceIdele k q (((d - ideleDiag k (Additive.ofMul a) : ↥(idele k)) :
          FullIdele k).2 q) : ↥(idele k)) : FullIdele k).2 (primeUnder (𝓞 k) w)) = 0
      rw [h1]
      exact hd' _
  have hsplit : d - adicPlaceIdele k q (((d - ideleDiag k (Additive.ofMul a) : ↥(idele k)) :
      FullIdele k).2 q)
      = ideleDiag k (Additive.ofMul a) + (d - ideleDiag k (Additive.ofMul a)
        - adicPlaceIdele k q (((d - ideleDiag k (Additive.ofMul a) : ↥(idele k)) :
          FullIdele k).2 q)) := by
    abel
  rw [hsplit]
  exact AddSubgroup.add_mem_sup ⟨Additive.ofMul a, rfl⟩ hnorm

end IdeleGen

end InverseGalois.CFT
