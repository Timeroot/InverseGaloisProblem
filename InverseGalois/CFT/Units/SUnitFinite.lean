import Mathlib
import InverseGalois.CFT.Tate.Restrict
import InverseGalois.CFT.Units.SUnit

/-!
# The units for a finite set of primes are finitely generated

Dirichlet's theorem says the units of the ring of integers of a number field form a finitely
generated group.  Enlarging them to the units for a finite set of primes adds only the orders at
those primes, a subgroup of a free abelian group of finite rank, so the enlarged group is again
finitely generated: it is an extension of a finitely generated group by a finitely generated one.

The statement is phrased for a set rather than for an indexing of the primes, because that is the
form in which the vector of orders at the remaining primes presents its kernel.

## Main results

* `InverseGalois.CFT.module_finite_sUnits`: **the units for a finite set of primes of a number
  field are a finitely generated abelian group.**

## Tags

number field, S-unit, finitely generated, Dirichlet unit theorem
-/

namespace InverseGalois.CFT

open IsDedekindDomain NumberField

/-- **The units for a finite set of primes of a number field are finitely generated.**  They sit in
an extension whose subobject is the units of the ring of integers, finitely generated by Dirichlet,
and whose quotient is a subgroup of the free abelian group on the chosen primes. -/
theorem module_finite_sUnits {K : Type*} [Field K] [NumberField K]
    (T : Set (HeightOneSpectrum (𝓞 K))) (hT : T.Finite) :
    Module.Finite ℤ (Additive ↥(sUnits K T)) := by
  classical
  haveI : Finite ↥T := hT.to_subtype
  haveI : Fintype ↥T := Fintype.ofFinite ↥T
  have hrange : Set.range (Subtype.val : ↥T → HeightOneSpectrum (𝓞 K)) = T := Subtype.range_coe
  haveI : Module.Finite ℤ
      ↥((sUnitsVal K (Subtype.val : ↥T → HeightOneSpectrum (𝓞 K))).range) :=
    module_finite_addSubgroup _
  have key : Module.Finite ℤ
      (Additive ↥(sUnits K (Set.range (Subtype.val : ↥T → HeightOneSpectrum (𝓞 K))))) :=
    module_finite_of_range_eq_ker
      (unitsToSUnits K (Set.range (Subtype.val : ↥T → HeightOneSpectrum (𝓞 K))))
      (sUnitsVal K (Subtype.val : ↥T → HeightOneSpectrum (𝓞 K)))
      (range_unitsToSUnits (Subtype.val : ↥T → HeightOneSpectrum (𝓞 K)))
  rwa [hrange] at key

end InverseGalois.CFT
