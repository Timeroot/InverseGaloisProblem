/-!
# The fundamental class of a Galois extension of the rationals

The direct computation of a class of the right order in the second cohomology of the idele class
group works for a cyclic extension ramified at a single prime, and the transport across a
compositum carries such a class from one of two disjoint extensions of the same degree to the
other.  Both ingredients are now available for an arbitrary Galois extension of the rationals.

Given the extension, Dirichlet's theorem supplies a prime `q` larger than the degree, congruent to
one modulo twice the degree, and splitting completely in the extension.  The cyclotomic field of
conductor `q` then contains a cyclic, totally real subfield of exactly that degree, totally
ramified at `q` and unramified elsewhere, which is the auxiliary extension: its idele class group
carries the class of the right order, generated by an idele supported at `q`.

The two extensions are disjoint because the auxiliary one is ramified only at `q` while `q` splits
completely in the given one, and the same splitting makes the auxiliary idele a norm from the given
extension, the Galois group permuting the places above `q` freely.  Embedding both extensions in an
algebraic closure of the rationals puts them inside a common extension with complementary groups of
automorphisms, and the transport applies.

That supplies the last of the three conditions defining a class formation, so the idele class group
of any Galois extension of the rationals is one, and Tate's theorem together with the theorem of
Tate and Nakayama applies to it.

## Main results

* `InverseGalois.CFT.exists_zsmul_eq_zero_imp_dvd_H2_ideleClassRep_global`: **the second cohomology
  of the idele class group of a Galois extension of the rationals contains a class annihilated by
  exactly the multiples of the degree.**
* `InverseGalois.CFT.exists_forall_isTateClassTwo_ideleClassRep`: **the idele class group of a
  Galois extension of the rationals, with that class, satisfies the classical hypotheses of Tate's
  theorem on every subgroup of the Galois group.**

## Tags

number field, idele class group, fundamental class, class formation, Tate cohomology
-/

set_option synthInstance.maxHeartbeats 800000
set_option maxHeartbeats 1000000

open CategoryTheory groupCohomology IsDedekindDomain NumberField
  InverseGalois.NumberTheory Pointwise

namespace InverseGalois.CFT

noncomputable section

open Tate

variable (K : Type) [Field K] [NumberField K] [IsGalois ℚ K]

/-- **The second cohomology of the idele class group of a Galois extension of the rationals
contains a class annihilated by exactly the multiples of the degree.** -/
theorem exists_zsmul_eq_zero_imp_dvd_H2_ideleClassRep_global :
    ∃ α : ↥(H2 (ideleClassRep ℚ K)), ∀ m : ℤ, m • α = 0 → (Nat.card Gal(K/ℚ) : ℤ) ∣ m := by
  set n := Nat.card Gal(K/ℚ) with hndef
  have hn0 : n ≠ 0 := (Nat.card_pos (α := Gal(K/ℚ))).ne'
  obtain ⟨q, hnq, hqp, hqmod, hsplit⟩ :=
    exists_prime_splitsCompletely_and_modEq K (2 * n) (Nat.mul_ne_zero two_ne_zero hn0) n
  have hdvd : 2 * n ∣ q - 1 := (Nat.modEq_iff_dvd' hqp.one_lt.le).1 hqmod.symm
  obtain ⟨-, F, hNF, hgal, hcyc, hreal, hFrank, hram, -⟩ :=
    exists_cyclic_totallyRamified_totallyReal_of_dvd hn0 hqp hdvd
  haveI : NumberField ↥F := hNF
  haveI : IsGalois ℚ ↥F := hgal
  haveI : IsCyclic Gal(↥F/ℚ) := hcyc
  haveI : IsTotallyReal ↥F := hreal
  have hnL : Nat.card Gal(↥F/ℚ) = n := (IsGalois.card_aut_eq_finrank ℚ ↥F).trans hFrank
  have hqn : ¬ q ∣ Nat.card Gal(↥F/ℚ) := by
    rw [hnL]
    exact fun hd => absurd (Nat.le_of_dvd (Nat.pos_of_ne_zero hn0) hd) (not_le.mpr hnq)
  obtain ⟨u, hgend, hordd⟩ :=
    exists_adicPlaceIdele_forall_mem_multiples_rat ↥F hqp hqn hram
  obtain ⟨σL, hgenσ⟩ := IsCyclic.exists_generator (α := Gal(↥F/ℚ))
  -- the idele is a norm from `K`, the auxiliary prime splitting completely there
  have hfree : ∀ (σ : Gal(K/ℚ)) (v : HeightOneSpectrum (𝓞 K)),
      primeUnder (𝓞 ℚ) v = ratPlace q hqp → σ • v = v → σ = 1 := by
    intro σ v hv hσ
    haveI : v.asIdeal.IsPrime := v.isPrime
    have hqmem : ((q : ℕ) : 𝓞 K) ∈ v.asIdeal := by
      have h1 : ((q : ℕ) : 𝓞 ℚ) ∈ (primeUnder (𝓞 ℚ) v).asIdeal := by
        rw [hv]
        exact natCast_mem_ratPlace q hqp
      rw [primeUnder_asIdeal, Ideal.under_def, Ideal.mem_comap, map_natCast] at h1
      exact h1
    have hle : Ideal.span {(q : ℤ)} ≤ Ideal.under ℤ v.asIdeal := by
      rw [Ideal.span_singleton_le_iff_mem, Ideal.under_def, Ideal.mem_comap, map_natCast]
      exact hqmem
    have hne : Ideal.under ℤ v.asIdeal ≠ ⊤ := Ideal.IsPrime.ne_top inferInstance
    haveI : v.asIdeal.LiesOver (Ideal.span {(q : ℤ)}) :=
      ⟨(isMaximal_span_prime hqp).eq_of_le hne hle⟩
    have hstab := stabilizer_eq_bot_of_splitsCompletely K hqp v.asIdeal hsplit
    have hmem : σ ∈ MulAction.stabilizer Gal(K/ℚ) v.asIdeal := by
      show σ • v.asIdeal = v.asIdeal
      rw [← asIdeal_smul, hσ]
    rw [hstab, Subgroup.mem_bot] at hmem
    exact hmem
  have hdnorm : adicPlaceIdele ℚ (ratPlace q hqp) u ∈ (ideleNorm ℚ K).range :=
    adicPlaceIdele_mem_range_ideleNorm ℚ K (ratPlace q hqp) hfree u
  -- the two fields, embedded disjointly in a common algebraic closure
  let φ : K →ₐ[ℚ] AlgebraicClosure ℚ := IsAlgClosed.lift
  let ψ : ↥F →ₐ[ℚ] AlgebraicClosure ℚ := IsAlgClosed.lift
  haveI : FiniteDimensional ℚ ↥φ.fieldRange :=
    FiniteDimensional.of_injective (AlgEquiv.ofInjectiveField φ).symm.toLinearMap
      (AlgEquiv.ofInjectiveField φ).symm.injective
  haveI : NumberField ↥φ.fieldRange := ⟨⟩
  haveI : FiniteDimensional ℚ ↥ψ.fieldRange :=
    FiniteDimensional.of_injective (AlgEquiv.ofInjectiveField ψ).symm.toLinearMap
      (AlgEquiv.ofInjectiveField ψ).symm.injective
  haveI : NumberField ↥ψ.fieldRange := ⟨⟩
  have hA : SplitsCompletely ↥φ.fieldRange q :=
    splitsCompletely_of_ringEquiv (AlgEquiv.ofInjectiveField φ).symm.toRingEquiv hqp hsplit
  have hB : ramifiedSet ↥ψ.fieldRange ⊆ {q} := by
    rw [← ramifiedSet_eq_of_ringEquiv (AlgEquiv.ofInjectiveField ψ).toRingEquiv]
    exact hram
  have hinf : φ.fieldRange ⊓ ψ.fieldRange = ⊥ := inf_eq_bot_of_splitsCompletely' _ _ hA hB
  exact exists_zsmul_eq_zero_imp_dvd_H2_ideleClassRep_of_embed K ↥F φ ψ hinf hndef.symm hnL hgenσ
    (adicPlaceIdele ℚ (ratPlace q hqp) u) hgend (hordd.trans hnL) hdnorm

/-- **The classical hypotheses of Tate's theorem hold for the idele class group of a Galois
extension of the rationals.** -/
theorem exists_forall_isTateClassTwo_ideleClassRep :
    ∃ α : tateModule (ideleClassRep ℚ K) 2,
      ∀ S : Subgroup Gal(K/ℚ), IsTateClassTwo S (ideleClassRep ℚ K) α := by
  obtain ⟨α, hα⟩ := exists_zsmul_eq_zero_imp_dvd_H2_ideleClassRep_global K
  exact ⟨α, fun S => isTateClassTwo_ideleClassRep S hα⟩

end

end InverseGalois.CFT
