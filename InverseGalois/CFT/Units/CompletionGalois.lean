import Mathlib
import InverseGalois.CFT.Units.CompletionFinite
import InverseGalois.CFT.Local.AdicAction

/-!
# The completion at a prime as a Galois extension of the completion below

Let `K / k` be a Galois extension of number fields and let `w` be a prime of `K`, lying over the
prime `v` of `k`.  This file shows that the completion of `K` at `w` is a Galois extension of the
completion of `k` at `v`, and that its Galois group is the decomposition group at `w`.  The
elements of the completion of `K` at `w` fixed by the decomposition group are therefore exactly
those coming from the completion of `k` at `v`.

The extension is a splitting field: `K` is the splitting field of a separable polynomial over `k`,
and the same polynomial splits in the completion, whose subalgebra generated by the roots is
closed and contains a dense set, hence is everything.  The decomposition group exhausts the Galois
group because an automorphism of the completion over the completion of the base is continuous, so
it preserves the open unit ball and therefore restricts to an automorphism of `K` fixing `w`.

## Main definitions

* `InverseGalois.CFT.restrictToBase`: the automorphism of the extension underlying an automorphism
  of the completion.

## Main results

* `InverseGalois.CFT.tendsto_pow_atTop_zero_iff`: an element of a valued field has valuation less
  than one exactly when its powers tend to zero.
* `InverseGalois.CFT.isGalois_adicCompletion`: **the completion at a prime is a Galois extension of
  the completion at the prime below.**
* `InverseGalois.CFT.adicCompletionAut_restrictToBase`: every automorphism of the completion comes
  from the decomposition group.
* `InverseGalois.CFT.mem_range_algebraMap_iff_forall_stabilizer_smul_eq`: **the elements of the
  completion fixed by the decomposition group are those coming from the completion of the base.**

## Tags

number field, completion, decomposition group, Galois extension, local field
-/

namespace InverseGalois.CFT

open Filter IsDedekindDomain Module MulAction NumberField Polynomial

/-! ### The open unit ball of a valued field is a topological invariant -/

section Topological

open scoped WithZero

/-- **The powers of an element of a valued field tend to zero exactly when its valuation is less
than one.** -/
theorem tendsto_pow_atTop_zero_iff {L : Type*} [Field L] [Valued L ℤᵐ⁰] (y : L) :
    Tendsto (fun n : ℕ => y ^ n) atTop (nhds 0) ↔ Valued.v y < 1 := by
  constructor
  · intro h
    by_contra hy
    push_neg at hy
    have hmem : {x : L | Valued.v x < ((1 : ℤᵐ⁰ˣ) : ℤᵐ⁰)} ∈ nhds (0 : L) :=
      (Valued.hasBasis_nhds_zero L ℤᵐ⁰).mem_of_mem (i := 1) trivial
    obtain ⟨N, hN⟩ := eventually_atTop.mp (h hmem)
    have h2 : Valued.v (y ^ N) < ((1 : ℤᵐ⁰ˣ) : ℤᵐ⁰) := hN N le_rfl
    rw [map_pow, Units.val_one] at h2
    exact absurd h2 (not_lt.mpr (one_le_pow_of_one_le' hy N))
  · intro h
    rw [(Valued.hasBasis_nhds_zero L ℤᵐ⁰).tendsto_right_iff]
    intro γ _
    rw [eventually_atTop]
    rcases eq_or_ne (Valued.v y) 0 with h0 | h0
    · refine ⟨1, fun n hn => ?_⟩
      show Valued.v (y ^ n) < ((γ : ℤᵐ⁰))
      simp only [map_pow, h0, zero_pow (by omega : n ≠ 0)]
      exact zero_lt_iff.mpr γ.ne_zero
    · set p : ℤ := WithZero.log (Valued.v y) with hp
      set q : ℤ := WithZero.log ((γ : ℤᵐ⁰)) with hq
      have hpa : WithZero.exp p = Valued.v y := WithZero.exp_log h0
      have hqa : WithZero.exp q = (γ : ℤᵐ⁰) := WithZero.exp_log γ.ne_zero
      have hplt : p < 0 := by
        have : WithZero.exp p < WithZero.exp 0 := by rw [hpa, WithZero.exp_zero]; exact h
        exact WithZero.exp_lt_exp.mp this
      refine ⟨q.natAbs + 1, fun n hn => ?_⟩
      show Valued.v (y ^ n) < ((γ : ℤᵐ⁰))
      rw [map_pow, ← hpa, ← hqa, ← WithZero.exp_nsmul, WithZero.exp_lt_exp, nsmul_eq_mul]
      have h1 : (n : ℤ) * p ≤ -(n : ℤ) := by
        nlinarith [hplt, (by exact_mod_cast Nat.zero_le n : (0 : ℤ) ≤ (n : ℤ))]
      have h2 : -(n : ℤ) < q := by
        have : (q.natAbs : ℤ) + 1 ≤ (n : ℤ) := by exact_mod_cast hn
        omega
      omega

/-- **A topological automorphism of a valued field preserves the open unit ball.** -/
theorem valued_lt_one_iff_of_continuous {L : Type*} [Field L] [Valued L ℤᵐ⁰] (τ : L ≃+* L)
    (hτ : Continuous τ) (hτ' : Continuous τ.symm) (y : L) :
    Valued.v (τ y) < 1 ↔ Valued.v y < 1 := by
  rw [← tendsto_pow_atTop_zero_iff, ← tendsto_pow_atTop_zero_iff]
  constructor
  · intro h
    have h2 := (hτ'.tendsto 0).comp h
    simpa only [Function.comp_def, map_pow, map_zero, τ.symm_apply_apply] using h2
  · intro h
    have h2 := (hτ.tendsto 0).comp h
    simpa only [Function.comp_def, map_pow, map_zero] using h2

end Topological

/-! ### Recognising the stabiliser of a prime -/

section Stabiliser

variable {k K : Type*} [Field k] [Field K] [Algebra k K] [NumberField K]

/-- **An automorphism preserving the small elements at a prime fixes that prime.** -/
theorem smul_eq_self_of_valuation_lt_one_iff (w : HeightOneSpectrum (𝓞 K)) {σ : Gal(K/k)}
    (h : ∀ x : K, w.valuation K (σ x) < 1 ↔ w.valuation K x < 1) : σ • w = w := by
  have mem : ∀ c : 𝓞 K, (σ • c ∈ w.asIdeal ↔ c ∈ w.asIdeal) := fun c => by
    rw [← HeightOneSpectrum.intValuation_lt_one_iff_mem,
      ← HeightOneSpectrum.intValuation_lt_one_iff_mem,
      ← HeightOneSpectrum.valuation_of_algebraMap (K := K),
      ← HeightOneSpectrum.valuation_of_algebraMap (K := K)]
    exact h (algebraMap (𝓞 K) K c)
  refine HeightOneSpectrum.ext (Ideal.ext fun b => ?_)
  rw [asIdeal_smul, Ideal.mem_pointwise_smul_iff_inv_smul_mem]
  have hb := mem (σ⁻¹ • b)
  rw [smul_inv_smul] at hb
  exact hb.symm

end Stabiliser

/-! ### The completion of the extension is generated by the extension -/

section Adjoin

variable {k K : Type*} [Field k] [NumberField k] [Field K] [NumberField K] [Algebra k K]

/-- The tower of the base field, the completion of the base and the completion of the
extension. -/
instance instIsScalarTowerBaseAdicCompletion (w : HeightOneSpectrum (𝓞 K)) :
    IsScalarTower k ((primeUnder (𝓞 k) w).adicCompletion k) (w.adicCompletion K) :=
  IsScalarTower.of_algebraMap_eq fun c => (adicCompletionComap_coe (𝓞 k) w c).symm

/-- The tower of the base field, the extension and the completion of the extension. -/
instance instIsScalarTowerFieldAdicCompletion (w : HeightOneSpectrum (𝓞 K)) :
    IsScalarTower k K (w.adicCompletion K) :=
  IsScalarTower.of_algebraMap_eq fun _ => rfl

@[simp]
theorem algebraMap_adicCompletion_eq (w : HeightOneSpectrum (𝓞 K)) (x : K) :
    algebraMap K (w.adicCompletion K) x = toAdicCompletion w x := rfl

variable (k) in
/-- **A subalgebra of the completion containing the extension is everything**: it is finite
dimensional over the completion of the base, hence closed, and the extension is dense. -/
theorem subalgebra_eq_top_of_forall_mem (w : HeightOneSpectrum (𝓞 K))
    (S : Subalgebra ((primeUnder (𝓞 k) w).adicCompletion k) (w.adicCompletion K))
    (h : ∀ x : K, toAdicCompletion w x ∈ S) : S = ⊤ := by
  have hclosed : IsClosed (S : Set (w.adicCompletion K)) := by
    have := (Subalgebra.toSubmodule S).closed_of_finiteDimensional
    rwa [Subalgebra.coe_toSubmodule] at this
  have huniv : (S : Set (w.adicCompletion K)) = Set.univ := by
    rw [← hclosed.closure_eq]
    refine (Dense.mono ?_ (denseRange_toAdicCompletion w)).closure_eq
    rintro _ ⟨x, rfl⟩
    exact h x
  refine eq_top_iff.mpr fun x _ => ?_
  have hx : x ∈ (S : Set (w.adicCompletion K)) := huniv ▸ Set.mem_univ x
  exact hx

variable (k) in
/-- **A generating set of the extension generates the completion** over the completion of the
base. -/
theorem adjoin_image_eq_top (w : HeightOneSpectrum (𝓞 K)) {s : Set K}
    (hs : Algebra.adjoin k s = ⊤) :
    Algebra.adjoin ((primeUnder (𝓞 k) w).adicCompletion k) (toAdicCompletion w '' s) = ⊤ := by
  refine subalgebra_eq_top_of_forall_mem k w _ fun x => ?_
  have hx : x ∈ Algebra.adjoin k s := hs ▸ Algebra.mem_top
  induction hx using Algebra.adjoin_induction with
  | mem y hy => exact Algebra.subset_adjoin ⟨y, hy, rfl⟩
  | algebraMap c =>
    have hc : toAdicCompletion w (algebraMap k K c)
        = algebraMap ((primeUnder (𝓞 k) w).adicCompletion k) (w.adicCompletion K)
          (algebraMap k ((primeUnder (𝓞 k) w).adicCompletion k) c) := by
      rw [← IsScalarTower.algebraMap_apply]
      rfl
    rw [hc]
    exact Subalgebra.algebraMap_mem _ _
  | add a b _ _ ha hb => simpa only [map_add] using Subalgebra.add_mem _ ha hb
  | mul a b _ _ ha hb => simpa only [map_mul] using Subalgebra.mul_mem _ ha hb

end Adjoin

/-! ### The completion is a Galois extension of the completion below -/

section Galois

variable {k K : Type*} [Field k] [NumberField k] [Field K] [NumberField K] [Algebra k K]

variable (k) in
/-- **A polynomial splitting the extension splits the completion** over the completion of the
base. -/
theorem isSplittingField_map_adicCompletion (w : HeightOneSpectrum (𝓞 K)) {p : k[X]}
    (hp : p.IsSplittingField k K) :
    (p.map (algebraMap k ((primeUnder (𝓞 k) w).adicCompletion k))).IsSplittingField
      ((primeUnder (𝓞 k) w).adicCompletion k) (w.adicCompletion K) := by
  constructor
  · rw [Polynomial.map_map, ← IsScalarTower.algebraMap_eq]
    exact hp.splits'.of_isScalarTower (w.adicCompletion K)
  · refine top_le_iff.mp ?_
    rw [← adjoin_image_eq_top k w hp.adjoin_rootSet']
    refine Algebra.adjoin_mono ?_
    rintro _ ⟨r, hr, rfl⟩
    rw [Polynomial.mem_rootSet'] at hr ⊢
    have hp0 : p ≠ 0 := fun h => hr.1 (by rw [h, Polynomial.map_zero])
    refine ⟨?_, ?_⟩
    · rw [Polynomial.map_map, ← IsScalarTower.algebraMap_eq]
      exact (Polynomial.map_ne_zero_iff
        (FaithfulSMul.algebraMap_injective k (w.adicCompletion K))).mpr hp0
    · rw [Polynomial.aeval_map_algebraMap,
        show toAdicCompletion w r = IsScalarTower.toAlgHom k K (w.adicCompletion K) r from rfl,
        Polynomial.aeval_algHom_apply, hr.2, map_zero]

variable (k) in
/-- **The completion at a prime is a Galois extension of the completion at the prime below.** -/
theorem isGalois_adicCompletion [IsGalois k K] (w : HeightOneSpectrum (𝓞 K)) :
    IsGalois ((primeUnder (𝓞 k) w).adicCompletion k) (w.adicCompletion K) := by
  obtain ⟨p, hsep, hsplit⟩ := IsGalois.is_separable_splitting_field k K
  haveI := isSplittingField_map_adicCompletion k w hsplit
  have hsep' : (p.map (algebraMap k ((primeUnder (𝓞 k) w).adicCompletion k))).Separable :=
    hsep.map
  exact IsGalois.of_separable_splitting_field hsep'

end Galois

/-! ### The Galois group is the decomposition group -/

section Decomposition

variable {k K : Type*} [Field k] [NumberField k] [Field K] [NumberField K] [Algebra k K]
  [IsGalois k K] (w : HeightOneSpectrum (𝓞 K))

variable (k) in
/-- **The automorphism of the extension underlying an automorphism of the completion**: the
extension is normal, so it is carried into itself. -/
noncomputable def restrictToBase
    (τ : w.adicCompletion K ≃ₐ[(primeUnder (𝓞 k) w).adicCompletion k] w.adicCompletion K) :
    Gal(K/k) :=
  AlgEquiv.restrictNormal (τ.restrictScalars k) K

variable (k) in
@[simp]
theorem toAdicCompletion_restrictToBase
    (τ : w.adicCompletion K ≃ₐ[(primeUnder (𝓞 k) w).adicCompletion k] w.adicCompletion K)
    (x : K) : toAdicCompletion w (restrictToBase k w τ x) = τ (toAdicCompletion w x) :=
  AlgEquiv.restrictNormal_commutes (τ.restrictScalars k) K x

variable (k) in
omit [IsGalois k K] in
/-- An automorphism of the completion over the completion of the base is continuous, the
completion being a finite extension. -/
theorem continuous_algEquiv
    (τ : w.adicCompletion K ≃ₐ[(primeUnder (𝓞 k) w).adicCompletion k] w.adicCompletion K) :
    Continuous τ :=
  τ.toLinearMap.continuous_of_finiteDimensional

variable (k) in
/-- **An automorphism of the completion fixes the prime**, so its restriction lies in the
decomposition group. -/
theorem restrictToBase_mem_stabilizer
    (τ : w.adicCompletion K ≃ₐ[(primeUnder (𝓞 k) w).adicCompletion k] w.adicCompletion K) :
    restrictToBase k w τ ∈ stabilizer Gal(K/k) w := by
  refine mem_stabilizer_iff.mpr (smul_eq_self_of_valuation_lt_one_iff w fun x => ?_)
  rw [← HeightOneSpectrum.valuedAdicCompletion_eq_valuation' w x,
    ← HeightOneSpectrum.valuedAdicCompletion_eq_valuation' w (restrictToBase k w τ x)]
  have hx : ((restrictToBase k w τ x : WithVal (w.valuation K)) : w.adicCompletion K)
      = τ ((x : WithVal (w.valuation K)) : w.adicCompletion K) :=
    toAdicCompletion_restrictToBase k w τ x
  rw [hx]
  exact valued_lt_one_iff_of_continuous τ.toRingEquiv (continuous_algEquiv k w τ)
    (continuous_algEquiv k w τ.symm) _

variable (k) in
/-- **Every automorphism of the completion comes from the decomposition group.** -/
theorem adicCompletionAut_restrictToBase
    (τ : w.adicCompletion K ≃ₐ[(primeUnder (𝓞 k) w).adicCompletion k] w.adicCompletion K)
    (z : w.adicCompletion K) :
    adicCompletionAut w (restrictToBase k w τ) (restrictToBase_mem_stabilizer k w τ) z = τ z := by
  refine UniformSpace.Completion.induction_on z ?_ ?_
  · exact isClosed_eq (continuous_adicCompletionAut w _ _) (continuous_algEquiv k w τ)
  · intro x
    rw [adicCompletionAut_coe]
    exact toAdicCompletion_restrictToBase k w τ x

variable (k) in
omit [IsGalois k K] in
/-- The decomposition group fixes the image of the completion of the base. -/
theorem stabilizer_smul_algebraMap (σ : ↥(stabilizer Gal(K/k) w))
    (c : (primeUnder (𝓞 k) w).adicCompletion k) :
    σ • (algebraMap ((primeUnder (𝓞 k) w).adicCompletion k) (w.adicCompletion K) c)
      = algebraMap ((primeUnder (𝓞 k) w).adicCompletion k) (w.adicCompletion K) c := by
  rw [algebraMap_adicCompletion k w]
  refine UniformSpace.Completion.induction_on c ?_ ?_
  · exact isClosed_eq (((continuous_adicCompletionAut w σ.1 (mem_stabilizer_iff.mp σ.2))).comp
      (continuous_adicCompletionComap (𝓞 k) w)) (continuous_adicCompletionComap (𝓞 k) w)
  · intro x
    rw [adicCompletionComap_coe, stabilizer_smul_adicCompletion_def, adicCompletionAut_coe]
    have hx : (withValAut w σ.1 (mem_stabilizer_iff.mp σ.2)
        ((algebraMap k K x : WithVal (w.valuation K)))) = algebraMap k K x :=
      σ.1.commutes x
    rw [hx]

variable (k) in
/-- **The elements of the completion fixed by the decomposition group are exactly those coming
from the completion of the base.** -/
theorem mem_range_algebraMap_iff_forall_stabilizer_smul_eq (z : w.adicCompletion K) :
    (∀ σ : ↥(stabilizer Gal(K/k) w), σ • z = z) ↔
      z ∈ Set.range (algebraMap ((primeUnder (𝓞 k) w).adicCompletion k)
        (w.adicCompletion K)) := by
  haveI := isGalois_adicCompletion k w
  refine ⟨fun h => ?_, ?_⟩
  · rw [← IntermediateField.mem_bot]
    refine (IsGalois.mem_bot_iff_fixed z).mpr fun τ => ?_
    have hτ := adicCompletionAut_restrictToBase k w τ z
    rw [← hτ]
    simpa using h ⟨restrictToBase k w τ, restrictToBase_mem_stabilizer k w τ⟩
  · rintro ⟨c, rfl⟩ σ
    exact stabilizer_smul_algebraMap k w σ c

end Decomposition

end InverseGalois.CFT
