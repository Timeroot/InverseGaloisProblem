import Mathlib
import InverseGalois.CFT.Global.HilbertPlaces
import InverseGalois.CFT.Local.HilbertMul

/-!
# Tools for the descent on binary quadratic forms

The values of `b` for which the form `⟨a, b⟩` is isotropic are exactly the nonzero norms from the
extension generated by a square root of `a`, and these form a group.  Consequently a trivial
symbol may be cancelled from a product: knowing the symbol of `a` against `b` and against
`b * b'`, one knows it against `b'`, and conversely.  Together with the observation that
`t ^ 2 - a` is visibly a value of the form, this is the whole mechanism of the descent on the size
of the coefficients.

## Main results

* `InverseGalois.CFT.Local.hilbertSymbol_sub_sq`: the symbol of `a` against `t ^ 2 - a` is one.
* `InverseGalois.CFT.Local.hilbertSymbol_of_mul`,
  `InverseGalois.CFT.Local.hilbertSymbol_of_mul'`: cancelling a trivial symbol from a product.
* `InverseGalois.CFT.hilbertSymbolAt_of_mul`: the same cancellation at a finite place.
-/

namespace InverseGalois.CFT.Local

variable {K : Type*} [Field K]

/-- **The form `⟨a, t ^ 2 - a⟩` is isotropic**, as the point `(1, 1, t)` shows. -/
theorem hilbertSymbol_sub_sq (a t : K) : hilbertSymbol a (t ^ 2 - a) = 1 :=
  hilbertSymbol_eq_one_iff.2 ⟨1, 1, t, by norm_num, by ring⟩

/-- **A trivial symbol may be cancelled from the left of a product.** -/
theorem hilbertSymbol_of_mul {a b b' : K} (hb : b ≠ 0) (h : hilbertSymbol a b = 1)
    (hmul : hilbertSymbol a (b * b') = 1) : hilbertSymbol a b' = 1 := by
  rwa [hilbertSymbol_mul_right_of_eq_one hb h] at hmul

/-- **A trivial symbol may be cancelled from the right of a product.** -/
theorem hilbertSymbol_of_mul' {a b b' : K} (hb' : b' ≠ 0) (h : hilbertSymbol a b' = 1)
    (hmul : hilbertSymbol a (b * b') = 1) : hilbertSymbol a b = 1 := by
  rw [mul_comm] at hmul
  rwa [hilbertSymbol_mul_right_of_eq_one hb' h] at hmul

end InverseGalois.CFT.Local

namespace InverseGalois.CFT

open Local

/-- **At a finite place a trivial symbol may be cancelled from the left of a product.** -/
theorem hilbertSymbolAt_of_mul {p : Nat.Primes} {a b b' : ℚ} (hb : b ≠ 0)
    (h : hilbertSymbolAt p a b = 1) (hmul : hilbertSymbolAt p a (b * b') = 1) :
    hilbertSymbolAt p a b' = 1 := by
  have hb0 : ((b : ℚ_[(p : ℕ)])) ≠ 0 := by simpa using hb
  unfold hilbertSymbolAt at h hmul ⊢
  rw [show (((b * b' : ℚ)) : ℚ_[(p : ℕ)])
      = ((b : ℚ_[(p : ℕ)])) * ((b' : ℚ_[(p : ℕ)])) by push_cast; ring] at hmul
  exact hilbertSymbol_of_mul hb0 h hmul

/-- **At a finite place the symbol of a rational against `t ^ 2` minus itself is one.** -/
theorem hilbertSymbolAt_sub_sq (p : Nat.Primes) (a t : ℚ) :
    hilbertSymbolAt p a ((t ^ 2 - a : ℚ)) = 1 := by
  unfold hilbertSymbolAt
  rw [show (((t ^ 2 - a : ℚ)) : ℚ_[(p : ℕ)])
      = ((t : ℚ_[(p : ℕ)])) ^ 2 - ((a : ℚ_[(p : ℕ)])) by push_cast; ring]
  exact hilbertSymbol_sub_sq _ _

end InverseGalois.CFT
