import Mathlib
import InverseGalois.CFT.Global.HilbertProduct
import InverseGalois.CFT.Local.DyadicHilbert

/-!
# Hilbert reciprocity for minus one and the odd primes

The square classes of the rationals are generated by `-1` and the primes, so the product formula
for the Hilbert symbol is determined by its values on pairs of generators.  This file settles the
pairs in which the prime `2` does not occur as an argument: the pair `(-1, -1)`, a pair
`(-1, q)` with `q` an odd prime, and a pair `(q, q')` of odd primes, equal or not.

In each case only three places can contribute.  At an odd prime dividing neither argument both
arguments are units, so the local symbol is trivial; what is left is the real place, the dyadic
place, and the places at the odd primes occurring among the arguments.  The real symbol is
trivial unless both arguments are negative, the dyadic symbol of two odd integers is read off
their residues modulo `4`, and the symbol at an odd prime `q` of `q` against an integer prime to
`q` is a Legendre symbol.

With that dictionary the three computations become classical facts of elementary number theory.
The pair `(-1, -1)` contributes `-1` at the real place and `-1` at the dyadic place.  The pair
`(-1, q)` contributes the value of the quartic character `χ₄` at `q` twice, once at `2` and once
at `q`.  The pair `(q, q')` of distinct odd primes contributes the two Legendre symbols
`legendreSym q q'` and `legendreSym q' q` together with the dyadic sign, and the fact that the
three multiply to one is exactly the law of quadratic reciprocity.

## Main results

* `InverseGalois.CFT.hilbertSymbolAt_two_intCast`: the symbol at the dyadic place of two odd
  integers, in terms of their residues modulo `4`.
* `InverseGalois.CFT.hilbertSymbolAt_coe_intCast`: the symbol at an odd prime `q` of `q` against
  an integer prime to `q`, as a Legendre symbol.
* `InverseGalois.CFT.hilbertProduct_neg_one_neg_one`: the product formula for `(-1, -1)`.
* `InverseGalois.CFT.hilbertProduct_neg_one_prime`: the product formula for `(-1, q)`.
* `InverseGalois.CFT.hilbertProduct_prime_prime`: the product formula for two distinct odd
  primes, equivalent to quadratic reciprocity.
* `InverseGalois.CFT.hilbertProduct_prime_self`: the product formula for an odd prime against
  itself.
-/

namespace InverseGalois.CFT

open Local

/-- The prime `2`, as an element of the subtype of primes. -/
def primeTwo : Nat.Primes := ⟨2, Nat.prime_two⟩

/-- The underlying natural number of `primeTwo` is `2`. -/
@[simp] theorem coe_primeTwo : ((primeTwo : Nat.Primes) : ℕ) = 2 := rfl

/-- A prime never divides `-1`. -/
theorem not_dvd_neg_one {p : ℕ} (hp : p.Prime) : ¬ ((p : ℕ) : ℤ) ∣ (-1 : ℤ) := by
  intro hd
  have h1 : ((p : ℕ) : ℤ) ≤ 1 := Int.le_of_dvd one_pos ((dvd_neg).mp hd)
  have h2 : 2 ≤ ((p : ℕ) : ℤ) := by exact_mod_cast hp.two_le
  omega

/-- Distinct primes do not divide one another. -/
theorem not_dvd_of_prime_ne {p q : ℕ} (hp : p.Prime) (hq : q.Prime) (h : p ≠ q) :
    ¬ ((p : ℕ) : ℤ) ∣ ((q : ℕ) : ℤ) := by
  intro hd
  exact h ((Nat.prime_dvd_prime_iff_eq hp hq).mp (Int.natCast_dvd_natCast.mp hd))

/-- The residue of a natural number modulo `4` is one exactly when the number is one modulo
`4`. -/
theorem natCast_zmod_four_eq_one_iff (n : ℕ) : ((n : ℕ) : ZMod 4) = 1 ↔ n % 4 = 1 := by
  rw [show (1 : ZMod 4) = ((1 : ℕ) : ZMod 4) by norm_num, ZMod.natCast_eq_natCast_iff']

/-- An odd prime is congruent to `1` or to `3` modulo `4`. -/
theorem mod_four_eq_one_or_three_of_prime {q : ℕ} (hq : q.Prime) (hq2 : q ≠ 2) :
    q % 4 = 1 ∨ q % 4 = 3 := by
  have h := (hq.eq_two_or_odd).resolve_left hq2
  omega

/-- **The symbol at the dyadic place of two odd integers** is trivial exactly when one of them is
congruent to `1` modulo `4`. -/
theorem hilbertSymbolAt_two_intCast {m n : ℤ} (hm : ¬ (2 : ℤ) ∣ m) (hn : ¬ (2 : ℤ) ∣ n) :
    hilbertSymbolAt primeTwo ((m : ℚ)) ((n : ℚ)) =
      if (m : ZMod 4) = 1 ∨ (n : ZMod 4) = 1 then 1 else -1 := by
  have hu : IsUnit ((m : ℤ_[2])) :=
    isUnit_intCast_of_not_dvd (p := 2) (by exact_mod_cast hm)
  have hv : IsUnit ((n : ℤ_[2])) :=
    isUnit_intCast_of_not_dvd (p := 2) (by exact_mod_cast hn)
  have key : hilbertSymbolAt primeTwo ((m : ℚ)) ((n : ℚ)) = 1 ↔
      ((m : ZMod 4) = 1 ∨ (n : ZMod 4) = 1) := by
    show hilbertSymbol (((m : ℚ)) : ℚ_[2]) (((n : ℚ)) : ℚ_[2]) = 1 ↔ _
    rw [show (((m : ℚ)) : ℚ_[2]) = ((m : ℤ_[2]) : ℚ_[2]) by push_cast; ring,
      show (((n : ℚ)) : ℚ_[2]) = ((n : ℤ_[2]) : ℚ_[2]) by push_cast; ring,
      hilbertSymbol_units_two hu hv, map_intCast, map_intCast]
  split_ifs with h
  · exact key.mpr h
  · rcases hilbertSymbolAt_eq_one_or primeTwo ((m : ℚ)) ((n : ℚ)) with h1 | h1
    · exact absurd (key.mp h1) h
    · exact h1

/-- **The symbol at an odd prime `q` of `q` against an integer prime to `q`** is the Legendre
symbol of that integer. -/
theorem hilbertSymbolAt_coe_intCast {q : Nat.Primes} (hq2 : (q : ℕ) ≠ 2) {n : ℤ}
    (hn : ¬ ((q : ℕ) : ℤ) ∣ n) :
    hilbertSymbolAt q (((q : ℕ) : ℚ)) ((n : ℚ)) = legendreSym (q : ℕ) n := by
  unfold hilbertSymbolAt
  rw [show ((((q : ℕ) : ℚ)) : ℚ_[(q : ℕ)]) = (((q : ℕ)) : ℚ_[(q : ℕ)]) by push_cast; ring,
    show (((n : ℚ)) : ℚ_[(q : ℕ)]) = ((n : ℤ) : ℚ_[(q : ℕ)]) by push_cast; ring]
  exact hilbertSymbol_p_intCast hq2 hn

/-- The symbol at the real place is trivial as soon as the second argument is positive. -/
theorem hilbertSymbol_real_of_pos_right {a b : ℝ} (ha : a ≠ 0) (hb : 0 < b) :
    hilbertSymbol a b = 1 := by
  rw [hilbertSymbol_real a b ha (ne_of_gt hb), if_neg]
  rintro ⟨-, h⟩
  exact absurd hb (not_lt.mpr h.le)

/-- **Hilbert reciprocity for the pair `(-1, -1)`**: the Hamilton quaternions are ramified
exactly at the real place and at the dyadic place. -/
theorem hilbertProduct_neg_one_neg_one : hilbertProduct (-1) (-1) = 1 := by
  have hside : ∀ p : Nat.Primes, p ∉ ({primeTwo} : Finset Nat.Primes) →
      hilbertSymbolAt p (-1) (-1) = 1 := by
    intro p hp
    have hp2 : ((p : ℕ)) ≠ 2 := by
      intro h
      exact hp (Finset.mem_singleton.mpr (Subtype.ext h))
    simpa using hilbertSymbolAt_intCast_eq_one (p := p) hp2 (m := -1) (n := -1)
      (not_dvd_neg_one p.2) (not_dvd_neg_one p.2)
  rw [hilbertProduct_eq_prod_of_subset (-1) (-1) {primeTwo} hside, Finset.prod_singleton]
  have hreal : hilbertSymbol (((-1 : ℚ)) : ℝ) (((-1 : ℚ)) : ℝ) = -1 := by
    rw [show (((-1 : ℚ)) : ℝ) = (-1 : ℝ) by norm_num,
      hilbertSymbol_real (-1 : ℝ) (-1 : ℝ) (by norm_num) (by norm_num), if_pos]
    exact ⟨by norm_num, by norm_num⟩
  have htwo : hilbertSymbolAt primeTwo (-1) (-1) = -1 := by
    have h := hilbertSymbolAt_two_intCast (m := -1) (n := -1) (by decide) (by decide)
    rw [if_neg (by decide : ¬ (((-1 : ℤ) : ZMod 4) = 1 ∨ ((-1 : ℤ) : ZMod 4) = 1))] at h
    simpa using h
  rw [hreal, htwo]
  norm_num

/-- **Hilbert reciprocity for the pair `(-1, q)`** with `q` an odd prime: the dyadic symbol and
the symbol at `q` both compute the value of the quartic character at `q`, so they cancel. -/
theorem hilbertProduct_neg_one_prime {q : ℕ} (hq : q.Prime) (hq2 : q ≠ 2) :
    hilbertProduct (-1) ((q : ℚ)) = 1 := by
  haveI : Fact q.Prime := ⟨hq⟩
  set Q : Nat.Primes := ⟨q, hq⟩ with hQdef
  have hQ2 : Q ≠ primeTwo := fun h => hq2 (congrArg Subtype.val h)
  have hside : ∀ p : Nat.Primes, p ∉ ({primeTwo, Q} : Finset Nat.Primes) →
      hilbertSymbolAt p (-1) ((q : ℚ)) = 1 := by
    intro p hp
    simp only [Finset.mem_insert, Finset.mem_singleton, not_or] at hp
    have hp2 : ((p : ℕ)) ≠ 2 := fun h => hp.1 (Subtype.ext h)
    have hpq : ((p : ℕ)) ≠ q := fun h => hp.2 (Subtype.ext h)
    simpa using hilbertSymbolAt_intCast_eq_one (p := p) hp2 (m := -1) (n := (q : ℤ))
      (not_dvd_neg_one p.2) (not_dvd_of_prime_ne p.2 hq hpq)
  rw [hilbertProduct_eq_prod_of_subset (-1) ((q : ℚ)) {primeTwo, Q} hside,
    Finset.prod_pair (Ne.symm hQ2)]
  have hqpos : (0 : ℝ) < ((q : ℚ) : ℝ) := by
    have : (0 : ℚ) < (q : ℚ) := by exact_mod_cast hq.pos
    exact_mod_cast this
  have hreal : hilbertSymbol (((-1 : ℚ)) : ℝ) (((q : ℚ)) : ℝ) = 1 := by
    refine hilbertSymbol_real_of_pos_right ?_ hqpos
    rw [show (((-1 : ℚ)) : ℝ) = (-1 : ℝ) by norm_num]
    norm_num
  have hodd : ¬ (2 : ℤ) ∣ ((q : ℕ) : ℤ) := by
    intro hd
    have : (2 : ℕ) ∣ q := by exact_mod_cast hd
    exact hq2 (((Nat.prime_dvd_prime_iff_eq Nat.prime_two hq).mp this).symm)
  have htwo : hilbertSymbolAt primeTwo (-1) ((q : ℚ)) =
      if ((q : ℕ) : ZMod 4) = 1 then 1 else -1 := by
    have h := hilbertSymbolAt_two_intCast (m := -1) (n := ((q : ℕ) : ℤ)) (by decide) hodd
    rw [show ((((q : ℕ) : ℤ)) : ZMod 4) = (((q : ℕ)) : ZMod 4) by push_cast; ring] at h
    rw [show (((-1 : ℤ)) : ℚ) = (-1 : ℚ) by norm_num,
      show ((((q : ℕ) : ℤ)) : ℚ) = ((q : ℚ)) by push_cast; ring] at h
    rw [h]
    congr 1
    simp only [eq_iff_iff, or_iff_right_iff_imp]
    intro hcon
    exact absurd hcon (by decide)
  have hatq : hilbertSymbolAt Q (-1) ((q : ℚ)) = ZMod.χ₄ (q : ℕ) := by
    rw [hilbertSymbolAt_comm]
    have h := hilbertSymbolAt_coe_intCast (q := Q) (by exact hq2) (n := -1)
      (not_dvd_neg_one hq)
    rw [show (((-1 : ℤ)) : ℚ) = (-1 : ℚ) by norm_num] at h
    rw [show (((Q : ℕ)) : ℚ) = ((q : ℚ)) from rfl] at h
    rw [h, legendreSym.at_neg_one (by exact hq2)]
  rw [hreal, htwo, hatq, one_mul]
  rcases mod_four_eq_one_or_three_of_prime hq hq2 with h4 | h4
  · rw [if_pos ((natCast_zmod_four_eq_one_iff q).mpr h4), ZMod.χ₄_nat_one_mod_four h4]
    norm_num
  · rw [if_neg (fun hc => by simp [(natCast_zmod_four_eq_one_iff q).mp hc] at h4),
      ZMod.χ₄_nat_three_mod_four h4]
    norm_num

/-- **Hilbert reciprocity for a pair of distinct odd primes**: the dyadic sign and the two
Legendre symbols multiply to one, which is the law of quadratic reciprocity. -/
theorem hilbertProduct_prime_prime {q q' : ℕ} (hq : q.Prime) (hq' : q'.Prime)
    (hq2 : q ≠ 2) (hq2' : q' ≠ 2) (hne : q ≠ q') :
    hilbertProduct ((q : ℚ)) ((q' : ℚ)) = 1 := by
  haveI : Fact q.Prime := ⟨hq⟩
  haveI : Fact q'.Prime := ⟨hq'⟩
  set Q : Nat.Primes := ⟨q, hq⟩ with hQdef
  set Q' : Nat.Primes := ⟨q', hq'⟩ with hQ'def
  have hQ2 : Q ≠ primeTwo := fun h => hq2 (congrArg Subtype.val h)
  have hQ2' : Q' ≠ primeTwo := fun h => hq2' (congrArg Subtype.val h)
  have hQQ' : Q ≠ Q' := fun h => hne (congrArg Subtype.val h)
  have hside : ∀ p : Nat.Primes, p ∉ ({primeTwo, Q, Q'} : Finset Nat.Primes) →
      hilbertSymbolAt p ((q : ℚ)) ((q' : ℚ)) = 1 := by
    intro p hp
    simp only [Finset.mem_insert, Finset.mem_singleton, not_or] at hp
    have hp2 : ((p : ℕ)) ≠ 2 := fun h => hp.1 (Subtype.ext h)
    have hpq : ((p : ℕ)) ≠ q := fun h => hp.2.1 (Subtype.ext h)
    have hpq' : ((p : ℕ)) ≠ q' := fun h => hp.2.2 (Subtype.ext h)
    simpa using hilbertSymbolAt_intCast_eq_one (p := p) hp2 (m := (q : ℤ)) (n := (q' : ℤ))
      (not_dvd_of_prime_ne p.2 hq hpq) (not_dvd_of_prime_ne p.2 hq' hpq')
  have hprod : ∏ p ∈ ({primeTwo, Q, Q'} : Finset Nat.Primes),
      hilbertSymbolAt p ((q : ℚ)) ((q' : ℚ)) = hilbertSymbolAt primeTwo ((q : ℚ)) ((q' : ℚ)) *
        (hilbertSymbolAt Q ((q : ℚ)) ((q' : ℚ)) * hilbertSymbolAt Q' ((q : ℚ)) ((q' : ℚ))) := by
    rw [Finset.prod_insert (by simp [Ne.symm hQ2, Ne.symm hQ2']), Finset.prod_pair hQQ']
  rw [hilbertProduct_eq_prod_of_subset ((q : ℚ)) ((q' : ℚ)) {primeTwo, Q, Q'} hside, hprod]
  have hqpos : (0 : ℝ) < ((q' : ℚ) : ℝ) := by
    have : (0 : ℚ) < (q' : ℚ) := by exact_mod_cast hq'.pos
    exact_mod_cast this
  have hreal : hilbertSymbol (((q : ℚ)) : ℝ) (((q' : ℚ)) : ℝ) = 1 := by
    refine hilbertSymbol_real_of_pos_right ?_ hqpos
    have : (0 : ℚ) < (q : ℚ) := by exact_mod_cast hq.pos
    have h0 : (0 : ℝ) < ((q : ℚ) : ℝ) := by exact_mod_cast this
    exact ne_of_gt h0
  have hodd : ¬ (2 : ℤ) ∣ ((q : ℕ) : ℤ) := by
    intro hd
    have h2 : (2 : ℕ) ∣ q := by exact_mod_cast hd
    exact hq2 (((Nat.prime_dvd_prime_iff_eq Nat.prime_two hq).mp h2).symm)
  have hodd' : ¬ (2 : ℤ) ∣ ((q' : ℕ) : ℤ) := by
    intro hd
    have h2 : (2 : ℕ) ∣ q' := by exact_mod_cast hd
    exact hq2' (((Nat.prime_dvd_prime_iff_eq Nat.prime_two hq').mp h2).symm)
  have htwo : hilbertSymbolAt primeTwo ((q : ℚ)) ((q' : ℚ)) =
      if ((q : ℕ) : ZMod 4) = 1 ∨ ((q' : ℕ) : ZMod 4) = 1 then 1 else -1 := by
    have h := hilbertSymbolAt_two_intCast (m := ((q : ℕ) : ℤ)) (n := ((q' : ℕ) : ℤ)) hodd hodd'
    rw [show ((((q : ℕ) : ℤ)) : ZMod 4) = (((q : ℕ)) : ZMod 4) by push_cast; ring,
      show ((((q' : ℕ) : ℤ)) : ZMod 4) = (((q' : ℕ)) : ZMod 4) by push_cast; ring,
      show ((((q : ℕ) : ℤ)) : ℚ) = ((q : ℚ)) by push_cast; ring,
      show ((((q' : ℕ) : ℤ)) : ℚ) = ((q' : ℚ)) by push_cast; ring] at h
    exact h
  have hatq : hilbertSymbolAt Q ((q : ℚ)) ((q' : ℚ)) = legendreSym q ((q' : ℕ) : ℤ) := by
    have h := hilbertSymbolAt_coe_intCast (q := Q) (by exact hq2) (n := ((q' : ℕ) : ℤ))
      (not_dvd_of_prime_ne hq hq' hne)
    rw [show ((((q' : ℕ) : ℤ)) : ℚ) = ((q' : ℚ)) by push_cast; ring] at h
    exact h
  have hatq' : hilbertSymbolAt Q' ((q : ℚ)) ((q' : ℚ)) = legendreSym q' ((q : ℕ) : ℤ) := by
    rw [hilbertSymbolAt_comm]
    have h := hilbertSymbolAt_coe_intCast (q := Q') (by exact hq2') (n := ((q : ℕ) : ℤ))
      (not_dvd_of_prime_ne hq' hq (Ne.symm hne))
    rw [show ((((q : ℕ) : ℤ)) : ℚ) = ((q : ℚ)) by push_cast; ring] at h
    exact h
  have hsq : legendreSym q ((q' : ℕ) : ℤ) ^ 2 = 1 :=
    legendreSym_sq (not_dvd_of_prime_ne hq hq' hne)
  have hsq' : legendreSym q' ((q : ℕ) : ℤ) ^ 2 = 1 :=
    legendreSym_sq (not_dvd_of_prime_ne hq' hq (Ne.symm hne))
  rw [hreal, htwo, hatq, hatq', one_mul]
  rcases mod_four_eq_one_or_three_of_prime hq hq2 with h4 | h4
  · rw [if_pos (Or.inl ((natCast_zmod_four_eq_one_iff q).mpr h4)),
      legendreSym.quadratic_reciprocity_one_mod_four h4 hq2', one_mul, ← sq]
    exact hsq
  · rcases mod_four_eq_one_or_three_of_prime hq' hq2' with h4' | h4'
    · rw [if_pos (Or.inr ((natCast_zmod_four_eq_one_iff q').mpr h4')),
        legendreSym.quadratic_reciprocity_one_mod_four h4' hq2, one_mul, ← sq]
      exact hsq'
    · rw [if_neg, legendreSym.quadratic_reciprocity_three_mod_four h4 h4']
      · rw [mul_neg, ← sq, hsq]
        norm_num
      · rintro (hc | hc)
        · simp [(natCast_zmod_four_eq_one_iff q).mp hc] at h4
        · simp [(natCast_zmod_four_eq_one_iff q').mp hc] at h4'

/-- **Hilbert reciprocity for an odd prime against itself**: the symbol of an element against
itself is its symbol against `-1`. -/
theorem hilbertProduct_prime_self {q : ℕ} (hq : q.Prime) (hq2 : q ≠ 2) :
    hilbertProduct ((q : ℚ)) ((q : ℚ)) = 1 := by
  have hq0 : ((q : ℚ)) ≠ 0 := by
    have : (0 : ℚ) < (q : ℚ) := by exact_mod_cast hq.pos
    exact ne_of_gt this
  rw [hilbertProduct_self hq0, hilbertProduct_comm]
  exact hilbertProduct_neg_one_prime hq hq2

end InverseGalois.CFT
