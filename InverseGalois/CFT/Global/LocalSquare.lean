import Mathlib
import InverseGalois.CFT.Global.HilbertPlaces

/-!
# A trivial symbol at a ramified odd place forces a square residue

Let `p` be an odd prime, let `a` be an integer prime to `p`, and let `b` be an integer divisible
by `p` exactly once.  The quadratic extension of the field of `p`-adic numbers generated by a
square root of `b` is ramified, and its norm form detects the quadratic character of the unit
part of `a`.  So the local Hilbert symbol of the pair at `p` is the Legendre symbol of `a`, and it
is trivial exactly when `a` is a square modulo `p`.

## Main results

* `InverseGalois.CFT.hilbertSymbolAt_ramified_eq_legendreSym`: the symbol at `p` of an integer
  prime to `p` against an integer exactly divisible by `p` is the Legendre symbol.
* `InverseGalois.CFT.isSquare_zmod_of_hilbertSymbolAt`: a trivial symbol at such a place makes the
  first argument a square modulo `p`.
-/

namespace InverseGalois.CFT

open Local

/-- **The symbol at an odd place of an integer prime to `p` against an integer exactly divisible
by `p` is the Legendre symbol of the first argument.** -/
theorem hilbertSymbolAt_ramified_eq_legendreSym {p : Nat.Primes} (hp : (p : ℕ) ≠ 2) {a w : ℤ}
    (ha : ¬ ((p : ℕ) : ℤ) ∣ a) (hw : ¬ ((p : ℕ) : ℤ) ∣ w) :
    hilbertSymbolAt p (a : ℚ) ((((p : ℕ) : ℤ) * w : ℤ) : ℚ) = legendreSym (p : ℕ) a := by
  have hu : IsUnit ((a : ℤ_[(p : ℕ)])) := isUnit_intCast_of_not_dvd ha
  have hwu : IsUnit ((w : ℤ_[(p : ℕ)])) := isUnit_intCast_of_not_dvd hw
  have h := hilbertSymbol_ramified_eq (p := (p : ℕ)) hp hwu (n := 0) hu
  rw [zpow_zero, one_mul] at h
  have hev : Even (0 : ℤ) := ⟨0, (add_zero 0).symm⟩
  rw [if_pos hev, mul_one] at h
  unfold hilbertSymbolAt
  rw [show ((a : ℚ) : ℚ_[(p : ℕ)]) = ((a : ℤ_[(p : ℕ)]) : ℚ_[(p : ℕ)]) by
        rw [PadicInt.coe_intCast]; push_cast; ring,
    show (((((p : ℕ) : ℤ) * w : ℤ) : ℚ) : ℚ_[(p : ℕ)])
        = (((p : ℕ) : ℚ_[(p : ℕ)])) * ((w : ℤ_[(p : ℕ)]) : ℚ_[(p : ℕ)]) by
        rw [PadicInt.coe_intCast]; push_cast; ring,
    h, legendreSym, toZMod_intCast]

/-- **A trivial symbol at a ramified odd place makes the first argument a square modulo `p`.** -/
theorem isSquare_zmod_of_hilbertSymbolAt {p : Nat.Primes} (hp : (p : ℕ) ≠ 2) {a w : ℤ}
    (ha : ¬ ((p : ℕ) : ℤ) ∣ a) (hw : ¬ ((p : ℕ) : ℤ) ∣ w)
    (h : hilbertSymbolAt p (a : ℚ) ((((p : ℕ) : ℤ) * w : ℤ) : ℚ) = 1) :
    IsSquare ((a : ZMod (p : ℕ))) := by
  have hleg : legendreSym (p : ℕ) a = 1 := by
    rw [← hilbertSymbolAt_ramified_eq_legendreSym hp ha hw]
    exact h
  have hne : ((a : ZMod (p : ℕ))) ≠ 0 := by
    rw [Ne, ZMod.intCast_zmod_eq_zero_iff_dvd]
    exact ha
  rw [legendreSym] at hleg
  exact (quadraticChar_one_iff_isSquare hne).1 hleg

end InverseGalois.CFT
