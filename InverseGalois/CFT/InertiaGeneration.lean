import Mathlib
import InverseGalois.CFT.Decomposition
import InverseGalois.CFT.Unramified

/-!
# Inertia subgroups generate the Galois group of a number field

Let `K` be a number field which is Galois over `ℚ`.  Attached to every maximal ideal `P` of the
ring of integers `𝓞 K` is the inertia subgroup `Ideal.inertia Gal(K/ℚ) P`, whose order is the
ramification index of `P` over `ℤ`.  This file proves the group-theoretic form of Minkowski's
theorem: those subgroups generate the whole Galois group.

The argument is the classical one.  Let `H` be a subgroup containing every inertia subgroup and
let `E` be its fixed field.  For a maximal ideal `P` of `𝓞 K` lying over the maximal ideal `Q` of
`𝓞 E`, the inertia subgroup of `P` for the extension `K/E` is the inertia subgroup for `K/ℚ`
intersected with `H`, hence is the full inertia subgroup of `P`; comparing orders through the
multiplicativity of ramification indices in the tower `ℤ ⊆ 𝓞 E ⊆ 𝓞 K` forces `Q` to be
unramified over `ℤ`.  Thus `E` is unramified at every finite prime, so `E = ℚ` by Minkowski's
theorem, and `H` is everything.

## Main results

* `InverseGalois.CFT.isUnramifiedAt_bot`: the zero ideal of `𝓞 L` is unramified over `ℤ`.
* `InverseGalois.CFT.finrank_eq_one_of_isUnramifiedAt_isMaximal`: Minkowski's theorem, in the form
  where only the maximal ideals have to be checked.
* `InverseGalois.CFT.inertia_subgroupOf`: the inertia subgroup of `P` inside a subgroup `H` of
  `Gal(K/ℚ)` is the inertia subgroup of `P` intersected with `H`.
* `InverseGalois.CFT.inertia_smul`: conjugation permutes the inertia subgroups.
* `InverseGalois.CFT.iSup_inertia_normal`: the subgroup generated by all inertia subgroups is
  normal.
* `InverseGalois.CFT.eq_top_of_inertia_le`: a subgroup of `Gal(K/ℚ)` containing every inertia
  subgroup is the whole group.
* `InverseGalois.CFT.iSup_inertia_eq_top`: the inertia subgroups generate `Gal(K/ℚ)`.
-/

open NumberField

open scoped Pointwise

namespace InverseGalois.CFT

attribute [local instance] Ideal.Quotient.field

section Minkowski

variable (L : Type*) [Field L] [NumberField L]

/-- The zero ideal of the ring of integers of a number field is unramified over `ℤ`. -/
theorem isUnramifiedAt_bot : Algebra.IsUnramifiedAt ℤ (⊥ : Ideal (𝓞 L)) := by
  have hcompl : (⊥ : Ideal (𝓞 L)).primeCompl = nonZeroDivisors (𝓞 L) := by
    ext x
    simp [Ideal.primeCompl, mem_nonZeroDivisors_iff_ne_zero]
  have h1 : Algebra.FormallyUnramified ℤ ℚ :=
    Algebra.FormallyUnramified.of_isLocalization (M := nonZeroDivisors ℤ)
  have h2 : Algebra.FormallyUnramified ℚ L := Algebra.FormallyUnramified.of_isSeparable ℚ L
  have h3 : Algebra.FormallyUnramified ℤ L := Algebra.FormallyUnramified.comp ℤ ℚ L
  haveI : IsLocalization (⊥ : Ideal (𝓞 L)).primeCompl L := by
    rw [hcompl]; infer_instance
  have e : L ≃ₐ[𝓞 L] Localization.AtPrime (⊥ : Ideal (𝓞 L)) :=
    IsLocalization.algEquiv (⊥ : Ideal (𝓞 L)).primeCompl L _
  exact Algebra.FormallyUnramified.of_equiv (e.restrictScalars ℤ)

/-- **Minkowski's theorem**, in the form only involving maximal ideals: a number field unramified
at every maximal ideal of its ring of integers is `ℚ`. -/
theorem finrank_eq_one_of_isUnramifiedAt_isMaximal
    (h : ∀ P : Ideal (𝓞 L), ∀ _ : P.IsMaximal, Algebra.IsUnramifiedAt ℤ P) :
    Module.finrank ℚ L = 1 := by
  refine NumberField.finrank_eq_one_of_isUnramifiedAt L fun P hP ↦ ?_
  by_cases hbot : P = ⊥
  · subst hbot
    exact isUnramifiedAt_bot L
  · exact h P (Ideal.IsPrime.isMaximal hP hbot)

end Minkowski

variable {K : Type*} [Field K] [NumberField K] [IsGalois ℚ K]

section Conjugation

omit [NumberField K] [IsGalois ℚ K] in
/-- Membership in the inertia subgroup of `P` is the condition of acting trivially modulo `P`. -/
theorem mem_inertia_iff {G : Type*} [Group G] [MulSemiringAction G (𝓞 K)] {σ : G}
    {P : Ideal (𝓞 K)} : σ ∈ Ideal.inertia G P ↔ ∀ x, σ • x - x ∈ P :=
  Iff.rfl

omit [IsGalois ℚ K] in
/-- Conjugation by `σ` carries the inertia subgroup of `P` to the inertia subgroup of `σ • P`. -/
theorem inertia_smul (σ : Gal(K/ℚ)) (P : Ideal (𝓞 K)) :
    Ideal.inertia Gal(K/ℚ) (σ • P) = (Ideal.inertia Gal(K/ℚ) P).map (MulAut.conj σ) := by
  ext τ
  simp only [Subgroup.mem_map, mem_inertia_iff]
  constructor
  · intro hτ
    refine ⟨σ⁻¹ * τ * σ, fun x ↦ ?_, by simp [MulAut.conj_apply, mul_assoc]⟩
    have := hτ (σ • x)
    rw [Ideal.mem_pointwise_smul_iff_inv_smul_mem, smul_sub, inv_smul_smul] at this
    simpa [mul_smul] using this
  · rintro ⟨ρ, hρ, rfl⟩ x
    rw [Ideal.mem_pointwise_smul_iff_inv_smul_mem, smul_sub]
    simpa [mul_smul] using hρ (σ⁻¹ • x)

omit [IsGalois ℚ K] in
/-- The Galois action permutes the maximal ideals of `𝓞 K`. -/
theorem isMaximal_smul (σ : Gal(K/ℚ)) (P : Ideal (𝓞 K)) (hP : P.IsMaximal) : (σ • P).IsMaximal := by
  haveI := hP.isPrime
  have hne : σ • P ≠ ⊥ := by
    intro hbot
    refine Ring.ne_bot_of_isMaximal_of_not_isField hP (RingOfIntegers.not_isField K) ?_
    rw [← inv_smul_smul σ P, hbot, Ideal.smul_bot]
  exact Ideal.IsPrime.isMaximal inferInstance hne

omit [IsGalois ℚ K] in
/-- The subgroup generated by the inertia subgroups of all maximal ideals of `𝓞 K` is normal. -/
theorem iSup_inertia_normal :
    (⨆ P : {P : Ideal (𝓞 K) // P.IsMaximal},
      Ideal.inertia Gal(K/ℚ) (P : Ideal (𝓞 K))).Normal := by
  have hmap : ∀ σ : Gal(K/ℚ),
      (⨆ P : {P : Ideal (𝓞 K) // P.IsMaximal},
        Ideal.inertia Gal(K/ℚ) (P : Ideal (𝓞 K))).map (MulAut.conj σ) ≤
      ⨆ P : {P : Ideal (𝓞 K) // P.IsMaximal}, Ideal.inertia Gal(K/ℚ) (P : Ideal (𝓞 K)) := by
    intro σ
    rw [Subgroup.map_iSup]
    refine iSup_le fun P ↦ ?_
    rw [← inertia_smul σ (P : Ideal (𝓞 K))]
    exact le_iSup (fun P : {P : Ideal (𝓞 K) // P.IsMaximal} ↦
      Ideal.inertia Gal(K/ℚ) (P : Ideal (𝓞 K))) ⟨σ • (P : Ideal (𝓞 K)), isMaximal_smul σ _ P.2⟩
  exact ⟨fun n hn σ ↦ hmap σ ⟨n, hn, rfl⟩⟩

end Conjugation

section Subgroup

omit [IsGalois ℚ K] in
/-- The inertia subgroup of `P` computed inside a subgroup `H` of `Gal(K/ℚ)` is the inertia
subgroup of `P` intersected with `H`. -/
theorem inertia_subgroupOf (H : Subgroup Gal(K/ℚ)) (P : Ideal (𝓞 K)) :
    Ideal.inertia H P = (Ideal.inertia Gal(K/ℚ) P).subgroupOf H :=
  (AddSubgroup.subgroupOf_inertia _ _).symm

omit [IsGalois ℚ K] in
/-- If a subgroup `H` of `Gal(K/ℚ)` contains the inertia subgroup of `P`, then the inertia
subgroup of `P` computed inside `H` has the same order. -/
theorem card_inertia_subgroup (H : Subgroup Gal(K/ℚ)) (P : Ideal (𝓞 K))
    (hle : Ideal.inertia Gal(K/ℚ) P ≤ H) :
    Nat.card (Ideal.inertia H P) = Nat.card (Ideal.inertia Gal(K/ℚ) P) := by
  rw [inertia_subgroupOf]
  exact Nat.card_congr (Subgroup.subgroupOfEquivOfLe hle).toEquiv

end Subgroup

section Generation

/-- A subgroup of `Gal(K/ℚ)` containing the inertia subgroup of every maximal ideal of `𝓞 K` is
the whole Galois group. -/
theorem eq_top_of_inertia_le (H : Subgroup Gal(K/ℚ))
    (h : ∀ P : Ideal (𝓞 K), P.IsMaximal → Ideal.inertia Gal(K/ℚ) P ≤ H) : H = ⊤ := by
  set E : IntermediateField ℚ K := FixedPoints.intermediateField H
  have key : ∀ Q : Ideal (𝓞 E), ∀ _ : Q.IsMaximal, Algebra.IsUnramifiedAt ℤ Q := by
    intro Q hQ
    haveI : Q.IsPrime := hQ.isPrime
    have hQbot : Q ≠ ⊥ :=
      Ring.ne_bot_of_isMaximal_of_not_isField hQ (RingOfIntegers.not_isField E)
    obtain ⟨⟨P, hPp, hPo⟩⟩ := Q.nonempty_primesOver (S := 𝓞 K)
    haveI := hPp
    haveI := hPo
    have hQeq : Q = P.under (𝓞 E) := hPo.over
    subst hQeq
    have hPbot : P ≠ ⊥ := Ideal.ne_bot_of_liesOver_of_ne_bot hQbot P
    haveI hPmax : P.IsMaximal := Ideal.IsPrime.isMaximal hPp hPbot
    haveI : Finite (𝓞 K ⧸ P) := finite_quotient_of_ne_bot P hPbot
    haveI : Finite (𝓞 E ⧸ P.under (𝓞 E)) :=
      .of_injective _ (Ideal.algebraMap_quotient_injective (R := 𝓞 E) (A := 𝓞 K) (I := P))
    haveI : Algebra.IsSeparable (𝓞 E ⧸ P.under (𝓞 E)) (𝓞 K ⧸ P) := inferInstance
    haveI := isSeparable_residue_of_ne_bot P hPbot
    haveI := isMaximal_under_of_ne_bot P hPbot
    have hpbot : P.under ℤ ≠ ⊥ := under_ne_bot P hPbot
    have hcardG : Nat.card (Ideal.inertia Gal(K/ℚ) P) =
        Ideal.ramificationIdx (algebraMap ℤ (𝓞 K)) (P.under ℤ) P := by
      rw [Ideal.card_inertia_eq_ramificationIdxIn (G := Gal(K/ℚ)) (P.under ℤ) hpbot P,
        Ideal.ramificationIdxIn_eq_ramificationIdx (P.under ℤ) P Gal(K/ℚ)]
    have hcardH : Nat.card (Ideal.inertia H P) =
        Ideal.ramificationIdx (algebraMap (𝓞 E) (𝓞 K)) (P.under (𝓞 E)) P := by
      rw [Ideal.card_inertia_eq_ramificationIdxIn (G := H) (P.under (𝓞 E)) hQbot P,
        Ideal.ramificationIdxIn_eq_ramificationIdx (P.under (𝓞 E)) P H]
    have heq := card_inertia_subgroup H P (h P hPmax)
    rw [hcardG, hcardH] at heq
    have htower : Ideal.ramificationIdx (algebraMap ℤ (𝓞 K)) (P.under ℤ) P =
        Ideal.ramificationIdx (algebraMap ℤ (𝓞 E)) (P.under ℤ) (P.under (𝓞 E)) *
          Ideal.ramificationIdx (algebraMap (𝓞 E) (𝓞 K)) (P.under (𝓞 E)) P :=
      Ideal.ramificationIdx_algebra_tower (Ideal.map_ne_bot_of_ne_bot hQbot)
        (Ideal.map_ne_bot_of_ne_bot hpbot) Ideal.map_comap_le
    have hpos : 0 < Ideal.ramificationIdx (algebraMap (𝓞 E) (𝓞 K)) (P.under (𝓞 E)) P := by
      rw [← hcardH]
      exact Nat.card_pos
    rw [Algebra.isUnramifiedAt_iff_of_isDedekindDomain (R := ℤ) hQbot, Ideal.under_under]
    refine Nat.eq_of_mul_eq_mul_right hpos ?_
    rw [one_mul, ← htower, heq]
  have hrank : Module.finrank ℚ E = 1 := finrank_eq_one_of_isUnramifiedAt_isMaximal E key
  have h1 : Module.finrank (E : IntermediateField ℚ K) K = Nat.card H :=
    IntermediateField.finrank_fixedField_eq_card H
  have h2 : Module.finrank ℚ E * Module.finrank E K = Module.finrank ℚ K :=
    Module.finrank_mul_finrank ℚ E K
  rw [hrank, one_mul] at h2
  refine Subgroup.eq_top_of_card_eq H ?_
  rw [← h1, h2, IsGalois.card_aut_eq_finrank]

/-- **Minkowski's theorem in group-theoretic form**: the inertia subgroups of the maximal ideals
of `𝓞 K` generate the Galois group of a number field `K` over `ℚ`. -/
theorem iSup_inertia_eq_top :
    ⨆ P : {P : Ideal (𝓞 K) // P.IsMaximal}, Ideal.inertia Gal(K/ℚ) (P : Ideal (𝓞 K)) = ⊤ :=
  eq_top_of_inertia_le _ fun P hP ↦ le_iSup (fun P : {P : Ideal (𝓞 K) // P.IsMaximal} ↦
    Ideal.inertia Gal(K/ℚ) (P : Ideal (𝓞 K))) ⟨P, hP⟩

end Generation

end InverseGalois.CFT
