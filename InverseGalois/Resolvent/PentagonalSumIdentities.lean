    (v0*v1+v1*v2+v2*v3+v3*v4+v4*v0)^2 + (v0*v1+v1*v2+v2*v4+v4*v3+v3*v0)^2 + (v0*v1+v1*v3+v3*v2+v2*v4+v4*v0)^2 + (v0*v1+v1*v3+v3*v4+v4*v2+v2*v0)^2 + (v0*v1+v1*v4+v4*v2+v2*v3+v3*v0)^2 + (v0*v1+v1*v4+v4*v3+v3*v2+v2*v0)^2 = 10*(v0*v1*v2*v3+v0*v1*v2*v4+v0*v1*v3*v4+v0*v2*v3*v4+v1*v2*v3*v4) := by
  linear_combination (-8*v0*v1*v2 - 8*v0*v1*v3 - 8*v0*v1*v4 - 4*v0*v2^2 - 12*v0*v2*v3 - 12*v0*v2*v4 - 4*v0*v3^2 - 12*v0*v3*v4 - 4*v0*v4^2 - 4*v1*v2^2 - 12*v1*v2*v3 - 12*v1*v2*v4 - 4*v1*v3^2 - 12*v1*v3*v4 - 4*v1*v4^2 - 4*v2^2*v3 - 4*v2^2*v4 - 4*v2*v3^2 - 16*v2*v3*v4 - 4*v2*v4^2 - 4*v3^2*v4 - 4*v3*v4^2)*he1 + (6*v0*v1 + 6*v0*v2 + 6*v0*v3 + 6*v0*v4 + 6*v1*v2 + 6*v1*v3 + 6*v1*v4 + 4*v2^2 + 12*v2*v3 + 12*v2*v4 + 4*v3^2 + 12*v3*v4 + 4*v4^2)*he2 + (0)*he3

