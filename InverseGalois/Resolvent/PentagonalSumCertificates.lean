lemma ps_prod {L : Type*} [CommRing L] (v0 v1 v2 v3 v4 : L)
    (he1 : v0 + v1 + v2 + v3 + v4 = 0)
    (he2 : v0*v1+v0*v2+v0*v3+v0*v4+v1*v2+v1*v3+v1*v4+v2*v3+v2*v4+v3*v4 = 0)
    (he3 : v0*v1*v2+v0*v1*v3+v0*v1*v4+v0*v2*v3+v0*v2*v4+v0*v3*v4+v1*v2*v3+v1*v2*v4+v1*v3*v4+v2*v3*v4 = 0) :
    (v0*v1+v1*v2+v2*v3+v3*v4+v4*v0) * (v0*v1+v1*v2+v2*v4+v4*v3+v3*v0) * (v0*v1+v1*v3+v3*v2+v2*v4+v4*v0) * (v0*v1+v1*v3+v3*v4+v4*v2+v2*v0) * (v0*v1+v1*v4+v4*v2+v2*v3+v3*v0) * (v0*v1+v1*v4+v4*v3+v3*v2+v2*v0) = -5*(v0*v1*v2*v3+v0*v1*v2*v4+v0*v1*v3*v4+v0*v2*v3*v4+v1*v2*v3*v4)^3 := by
  have hv4 : v4 = -(v0 + v1 + v2 + v3) := by linear_combination he1
  subst hv4
  set ρ : ℕ → L := (fun i => [v0,v1,v2,v3].getD i 0) with hρ
  have hE2 : reE2_P.eval ρ = 0 := by
    simp only [reE2_P, RE.eval, hρ, List.getD_cons_zero, List.getD_cons_succ]
    linear_combination he2
  have hE3 : reE3_P.eval ρ = 0 := by
    simp only [reE3_P, RE.eval, hρ, List.getD_cons_zero, List.getD_cons_succ]
    linear_combination he3
  have hev := eval_eq_of_two_generator_certificate ρ reLHSP reRHSP reE2_P reE3_P
    (parseNF cofC2_P) (parseNF cofC3_P) cNFP_zero hE2 hE3
  simp only [reLHSP, reRHSP, RE.eval, hρ, List.getD_cons_zero, List.getD_cons_succ,
    Int.cast_ofNat] at hev
  exact hev

