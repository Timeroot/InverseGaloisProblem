-- `LHS' - RHS' - c2*e2' - c3*e3'` as a reflected expression.
def cNF5 : NF :=
  nfAdd (toNF (.sub reLHS5 reRHS5))
    (nfNeg (nfAdd (nfMul (parseNF cofC2_5) (toNF reE2_5))
                  (nfMul (parseNF cofC3_5) (toNF reE3_5))))



theorem cNF5_zero : cNF5 = ([] : NF) := by native_decide

set_option maxRecDepth 8000 in
lemma psSq_esymm5 {L : Type*} [CommRing L] (v0 v1 v2 v3 v4 : L)
    (he1 : v0 + v1 + v2 + v3 + v4 = 0)
    (he2 : v0*v1+v0*v2+v0*v3+v0*v4+v1*v2+v1*v3+v1*v4+v2*v3+v2*v4+v3*v4 = 0)
    (he3 : v0*v1*v2+v0*v1*v3+v0*v1*v4+v0*v2*v3+v0*v2*v4+v0*v3*v4+v1*v2*v3+v1*v2*v4+v1*v3*v4+v2*v3*v4 = 0) :
    (v0*v1+v1*v2+v2*v3+v3*v4+v4*v0)^2*(v0*v1+v1*v2+v2*v4+v4*v3+v3*v0)^2*(v0*v1+v1*v3+v3*v2+v2*v4+v4*v0)^2*(v0*v1+v1*v3+v3*v4+v4*v2+v2*v0)^2*(v0*v1+v1*v4+v4*v2+v2*v3+v3*v0)^2 + (v0*v1+v1*v2+v2*v3+v3*v4+v4*v0)^2*(v0*v1+v1*v2+v2*v4+v4*v3+v3*v0)^2*(v0*v1+v1*v3+v3*v2+v2*v4+v4*v0)^2*(v0*v1+v1*v3+v3*v4+v4*v2+v2*v0)^2*(v0*v1+v1*v4+v4*v3+v3*v2+v2*v0)^2 + (v0*v1+v1*v2+v2*v3+v3*v4+v4*v0)^2*(v0*v1+v1*v2+v2*v4+v4*v3+v3*v0)^2*(v0*v1+v1*v3+v3*v2+v2*v4+v4*v0)^2*(v0*v1+v1*v4+v4*v2+v2*v3+v3*v0)^2*(v0*v1+v1*v4+v4*v3+v3*v2+v2*v0)^2 + (v0*v1+v1*v2+v2*v3+v3*v4+v4*v0)^2*(v0*v1+v1*v2+v2*v4+v4*v3+v3*v0)^2*(v0*v1+v1*v3+v3*v4+v4*v2+v2*v0)^2*(v0*v1+v1*v4+v4*v2+v2*v3+v3*v0)^2*(v0*v1+v1*v4+v4*v3+v3*v2+v2*v0)^2 + (v0*v1+v1*v2+v2*v3+v3*v4+v4*v0)^2*(v0*v1+v1*v3+v3*v2+v2*v4+v4*v0)^2*(v0*v1+v1*v3+v3*v4+v4*v2+v2*v0)^2*(v0*v1+v1*v4+v4*v2+v2*v3+v3*v0)^2*(v0*v1+v1*v4+v4*v3+v3*v2+v2*v0)^2 + (v0*v1+v1*v2+v2*v4+v4*v3+v3*v0)^2*(v0*v1+v1*v3+v3*v2+v2*v4+v4*v0)^2*(v0*v1+v1*v3+v3*v4+v4*v2+v2*v0)^2*(v0*v1+v1*v4+v4*v2+v2*v3+v3*v0)^2*(v0*v1+v1*v4+v4*v3+v3*v2+v2*v0)^2 = 106*(v0*v1*v2*v3+v0*v1*v2*v4+v0*v1*v3*v4+v0*v2*v3*v4+v1*v2*v3*v4)^5 + 3125*(v0*v1*v2*v3*v4)^4 := by
  have hv4 : v4 = -(v0+v1+v2+v3) := by linear_combination he1
  subst hv4
  set ρ : ℕ → L := (fun i => [v0,v1,v2,v3].getD i 0) with hρ
  have he2' : (-v0^2 - v0*v1 - v0*v2 - v0*v3 - v1^2 - v1*v2 - v1*v3 - v2^2 - v2*v3 - v3^2) = 0 := by linear_combination he2
  have he3' : (-v0^2*v1 - v0^2*v2 - v0^2*v3 - v0*v1^2 - 2*v0*v1*v2 - 2*v0*v1*v3 - v0*v2^2 - 2*v0*v2*v3 - v0*v3^2 - v1^2*v2 - v1^2*v3 - v1*v2^2 - 2*v1*v2*v3 - v1*v3^2 - v2^2*v3 - v2*v3^2) = 0 := by linear_combination he3
  have hE2 : reE2_5.eval ρ = 0 := by
    simp only [reE2_5, RE.eval, hρ, List.getD_cons_zero, List.getD_cons_succ]
    linear_combination he2
  have hE3 : reE3_5.eval ρ = 0 := by
    simp only [reE3_5, RE.eval, hρ, List.getD_cons_zero, List.getD_cons_succ, Int.cast_ofNat]
    linear_combination he3
  have hev := eval_eq_of_two_generator_certificate ρ reLHS5 reRHS5 reE2_5 reE3_5
    (parseNF cofC2_5) (parseNF cofC3_5) cNF5_zero hE2 hE3
  simp only [reLHS5, reRHS5, RE.eval, hρ, List.getD_cons_zero, List.getD_cons_succ,
    Int.cast_ofNat] at hev
  exact hev

end PentagonalSumIdentities
